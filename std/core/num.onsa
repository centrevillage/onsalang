//! The associated constants and functions of the scalar types (spec §6.6,
//! §3.3, §6.3): std defines the builtin types, so it declares their members.
//! `ZERO` and `ONE` come with the number traits (W5-05); the methods with
//! the conversions.

impl I8 {
  pub const MIN: I8 = -128
  pub const MAX: I8 = 127
  pub const BITS: U32 = 8
}

impl I16 {
  pub const MIN: I16 = -32768
  pub const MAX: I16 = 32767
  pub const BITS: U32 = 16
}

impl I32 {
  pub const MIN: I32 = -2147483648
  pub const MAX: I32 = 2147483647
  pub const BITS: U32 = 32
}

impl I64 {
  pub const MIN: I64 = -9223372036854775808
  pub const MAX: I64 = 9223372036854775807
  pub const BITS: U32 = 64
}

impl U8 {
  pub const MIN: U8 = 0
  pub const MAX: U8 = 255
  pub const BITS: U32 = 8
}

impl U16 {
  pub const MIN: U16 = 0
  pub const MAX: U16 = 65535
  pub const BITS: U32 = 16
}

impl U32 {
  pub const MIN: U32 = 0
  pub const MAX: U32 = 4294967295
  pub const BITS: U32 = 32
}

impl U64 {
  pub const MIN: U64 = 0
  pub const MAX: U64 = 18446744073709551615
  pub const BITS: U32 = 64
}

/// The values are the mathematical ones rounded to the type, as a literal
/// is (§6.6, §2.4); there is no `MIN` (`-F32.MAX`, §6.6).
impl F32 {
  pub const PI: F32 = 3.14159265358979323846264338327950288
  pub const MAX: F32 = 3.40282346638528859811704183484516925440e38
  pub const EPSILON: F32 = 1.1920928955078125e-7
  pub const INFINITY: F32 = 1.0 / 0.0
  pub const NAN: F32 = 0.0 / 0.0
  /// The float of the bits `u` (§3.3), the inverse of `to_bits()`.
  pub target rt fn from_bits(u: U32) -> F32
}

/// As of `F32` (§6.6).
impl F64 {
  pub const PI: F64 = 3.14159265358979323846264338327950288
  pub const MAX: F64 = 1.7976931348623157081452742373170435679807056752584e308
  pub const EPSILON: F64 = 2.220446049250313080847263336181640625e-16
  pub const INFINITY: F64 = 1.0 / 0.0
  pub const NAN: F64 = 0.0 / 0.0
  /// The float of the bits `u` (§3.3), the inverse of `to_bits()`.
  pub target rt fn from_bits(u: U64) -> F64
}
