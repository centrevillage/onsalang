//! The associated constants, functions and methods of the scalar types
//! (spec §6.6, §3.3, §3.4, §6.3): std defines the builtin types, so it
//! declares their members, those of the spec's lists and no other. The
//! associated functions `round_from`, `trunc_from`, `trunc_sat_from` and
//! `narrow_from` convert to their `Self`, only between the types `as` does
//! not, or from a type parameter (§3.3); `abs`, `min`, `sqrt` and the like
//! are the functions of `std.math`, not methods (§3.4). `ZERO` and `ONE` come
//! with the number traits (W5-05).
//!
//! The functions that return an `Option` are Onsa (S-71): a `target`
//! declaration returns no `Option` (D-07), so their primitives return
//! whether the result is defined, and the result when it is.

/// Whether `x` is a value of `B`, and that value (§3.3). For `narrow_from`.
target rt fn narrow_parts[A: Int, B: Int](x: A) -> (Bool, B)
/// Whether `a + b` is a value of `T` (no overflow, §3.4), and the sum.
target rt fn add_parts[T: Int](a: T, b: T) -> (Bool, T)
/// As `add_parts`, of `a - b`.
target rt fn sub_parts[T: Int](a: T, b: T) -> (Bool, T)
/// As `add_parts`, of `a * b`.
target rt fn mul_parts[T: Int](a: T, b: T) -> (Bool, T)
/// As `add_parts`, of `a / b`: neither a zero `b` nor `MIN / -1`.
target rt fn div_parts[T: Int](a: T, b: T) -> (Bool, T)

/// `Some` of the value when it is defined.
rt fn some_if[T](parts: (Bool, T)) -> Option[T] {
  let (defined, v) = parts
  if defined { Some(v) } else { None }
}

/// Whether the value is defined. `checked_div_euclid` is `None` where
/// `checked_div` is: `div_euclid` panics where `/` does (§3.4).
rt fn is_defined[T](parts: (Bool, T)) -> Bool {
  let (defined, _) = parts
  defined
}

impl I8 {
  pub const MIN: I8 = -128
  pub const MAX: I8 = 127
  pub const BITS: U32 = 8
  pub target rt fn div_euclid(self, other: Self) -> Self
  pub target rt fn rem_euclid(self, other: Self) -> Self
  pub rt fn narrow_from[S: Int](x: S) -> Option[Self] { some_if(narrow_parts(x)) }
  pub target rt fn trunc_from[S: Float](x: S) -> Self
  pub target rt fn trunc_sat_from[S: Float](x: S) -> Self
  pub rt fn checked_add(self, other: Self) -> Option[Self] { some_if(add_parts(self, other)) }
  pub rt fn checked_sub(self, other: Self) -> Option[Self] { some_if(sub_parts(self, other)) }
  pub rt fn checked_mul(self, other: Self) -> Option[Self] { some_if(mul_parts(self, other)) }
  pub rt fn checked_div(self, other: Self) -> Option[Self] { some_if(div_parts(self, other)) }
  pub rt fn checked_rem(self, other: Self) -> Option[Self] { if other == 0 { None } else { Some(self % other) } }
  pub rt fn checked_neg(self) -> Option[Self] { some_if(sub_parts(0, self)) }
  pub rt fn checked_shl(self, n: U32) -> Option[Self] { if n < Self.BITS { Some(self << n) } else { None } }
  pub rt fn checked_shr(self, n: U32) -> Option[Self] { if n < Self.BITS { Some(self >> n) } else { None } }
  pub rt fn checked_div_euclid(self, other: Self) -> Option[Self] {
    if is_defined(div_parts(self, other)) { Some(self.div_euclid(other)) } else { None }
  }
  pub rt fn checked_rem_euclid(self, other: Self) -> Option[Self] {
    if other == 0 { None } else { Some(self.rem_euclid(other)) }
  }
}

