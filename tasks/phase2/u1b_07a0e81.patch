+// onsa.toml
+// [test]
+// mode = "parse"
+// canonical = false
+// spec = ["§6.1", "§8.1", "§11.4", "§18.2"]
+
+// The line breaks and the comments next to the `-> ()`, the empty `uses {}` and the `init` that `onsa fmt`
+// takes off (W3-12, unit U1b; docs/onsa-tools.md §3.3 and §3.4; the provisional reading of S-536 and S-538).
+// The line breaks next to them go with them (`fn a()` newline `uses {} {}` is `fn a() {}`), but a line
+// break with a comment in its gap, a line end and the edge of a list. A form that would not read as the same
+// tree stays whole (`fn c() // c` newline `{}` would be E0003), and so do a form whose line break only a
+// comment would keep (`fn h() // h` newline `uses {Alloc} {}`), an enclosure that holds only a comment and
+// `-> () at sample` (the clock alone is E0002). The `init` of the value 0 goes with the `,`
+// after it, else the one before it, and a comment on its line stays. The file is not canonical on purpose
+// (`canonical = false`): fmt takes it, changes it and keeps what it writes.
+
+fn a()
+  uses {} {}
+
+fn b() ->
+  () {}
+
+fn c() // c
+  uses {} {}
+
+fn d() -> // d
+  () {}
+
+fn e() -> I32 uses {
+  // e
+} {
+  1
+}
+
+type T = fn(I32) -> I32 uses {
+  // t
+}
+
+fn f() -> ( // f
+) {}
+
+fn g() -> ()
+  uses {Alloc} {}
+
+fn h() -> () // h
+  uses {Alloc} {}
+
+fn i() -> (()) {}
+
+fn m() -> (
+) uses {
+} {}
+
+fn n() -> () at sample {}
+
+struct S {
+  a: fn(F32) -> ()
+}
+
+trait Sink {
+  fn put(inout self, x: F32) -> ()
+
+  fn clear(inout self) -> () uses {}
+  fn size(self) -> U32
+}
+
+fn k() -> I32 { 1 }
+
+fn j() -> () {
+  k()
+  return
+}
+
+pub flow init_a(x: F32 at sample) -> F32 at sample {
+  prev~(x, 0.0,)
+}
+
+pub flow init_b(x: F32 at sample) -> F32 at sample {
+  let y = prev~(x, // the signal
+    0.0) // silence
+  y
+}
+
+pub flow init_c(x: F32 at sample) -> F32 at sample {
+  delay~(x,
+    4, (0e0))
+}
+
+pub flow init_d(x: F32 at sample) -> F32 at sample {
+  delay~(
+    x,
+    4,
+    0x0_0
+  )
+}
+
+pub flow init_e(n: I32 at sample, b: Bool at sample) -> I32 at sample {
+  let f = prev~(b, false)
+  prev~(n, -0) + a.prev~(n, 0)
+}
