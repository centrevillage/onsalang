+def left_out(code):
+    """The indices in `code` (the code tokens) of the tokens of `-> ()` (`-> (())` too), of `uses {}` and
+    of the `init` of the value 0 of a built-in delay (`zero_inits`), read from the text alone: the
+    rewrites of `docs/onsa-tools.md` §3.3 may drop them (W3-12; not with a comment or a clock next to
+    them), and [`gap_places`] leaves them out of a text and of its fmt output alike."""
+    texts = [t.text for t in code]
+    out = zero_inits(code)
+    for j in range(len(code) - 2):
+        k = j + 1
+        while k < len(code) and texts[k] == "(":
+            k += 1
+        n = k - j - 1
+        if texts[j] == "->" and n and texts[k:k + n] == [")"] * n:
+            out.update(range(j, k + n))
+        if texts[j:j + 3] == ["uses", "{", "}"]:
+            out.update((j, j + 1, j + 2))
