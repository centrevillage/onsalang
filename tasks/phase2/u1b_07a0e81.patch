+//! The built-in delays `prev~` / `delay~` / `vdelay~` (§11.4): the one table
+//! of their names and of the place of their `init` (plan D-15). The names
+//! stage, the flow checks, the gate of the flow syntax outside a flow,
+//! `onsa graph` and `onsa interface` read it through `onsa_sema::flow_names`;
+//! `onsa fmt` reads it here (the `init` that is the default value, §11.4).
+
+/// A built-in delay (§11.4).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Delay {
+    /// `prev~`
+    Prev,
+    /// `delay~`
+    Fixed,
+    /// `vdelay~`
+    Variable,
+}
+
+impl Delay {
+    const ALL: [Delay; 3] = [Delay::Prev, Delay::Fixed, Delay::Variable];
+
+    /// The name (`prev`); a call writes `~` after it (`prev~(…)`).
+    pub fn name(self) -> &'static str {
+        match self {
+            Delay::Prev => "prev",
+            Delay::Fixed => "delay",
+            Delay::Variable => "vdelay",
+        }
+    }
+
