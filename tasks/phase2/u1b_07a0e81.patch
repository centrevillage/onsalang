+        NodeKind::ClosureExpr => match &mut ast.exprs[*ix.exprs.get(&n)?].kind {
+            ExprKind::Closure { ret, effects, .. } => Some((ret, effects)),
+            _ => None,
+        },
+        NodeKind::FnType => match &mut ast.types[*ix.types.get(&n)?].kind {
+            TypeKind::Fn { ret, effects, .. } => Some((ret, effects)),
+            _ => None,
+        },
+        _ => None,
+    }
+}
