+//! The line breaks that go with the tokens a rewrite of §3.3 drops
+//! (`docs/onsa-tools.md` §3.2, §3.4): the one judgement of the form after a
+//! rewrite, which `fmt/rewrites.rs` asks for the tokens it drops from a node
+//! (`fn f()` newline `uses {} {}` is `fn f() {}`).
+//!
+//! A line break next to a dropped token goes with it, but a line end
+//! (between two statements or items, §2.5), a line break at the edge of a
+//! list (after its opening bracket or a `,`, before its closing bracket or a
+//! `,`: it makes the form of the list, §3.2) and a line break in a gap that
+//! holds a comment (after a comment at the end of a line, before a line of a
+//! comment: no code and no comment moves over a comment). The form so
+//! written must read as the same tree: a line break left between two written
+//! code tokens ends a line where a line break it stands for ended one, and
+//! only there (`fn f() // c` newline `{}` would be E0003). Nor may a line
+//! break stay there only because a comment holds one that would go: without
+//! the comment the form would be another (`fn f() // c` newline `uses {A}
+//! {}` would keep its line break when the comment goes). Else nothing is
+//! dropped.
+//!
+//! The judgement reads the gaps between the written code token before the
+//! first dropped one and the one after the last: what is between them (the
+//! inside of a pair of brackets that goes, U2) is read again too.
+// SPEC-GAP(S-536): §3.4 does not say what becomes of the line breaks and the
+// comments next to the tokens a rewrite drops. The reading (2') of the draft:
+// the line breaks next to them go but those above, no code or comment moves
+// over a comment, and a form that would not read as the same tree is not
+// written (an enclosure that holds only a comment stays: `rewrites.rs`). One
+// more: a line break that stays only because a comment holds it keeps the
+// tokens too (else the form after the comment goes is not that of the file
+// without it, the property `comments` of `tools/fmt_props.py`).
+
+use super::rewrites::Ctx;
+use super::shape::{self, Shape};
+use crate::cst::{Cst, NodeId, TokenIdx};
+use crate::layout::continues;
+use crate::token::TokenKind;
+
+/// The line breaks that go with `code`, the code tokens in their order that
+/// a rewrite drops from a node, or `None` when the form after it does not
+/// read as the same tree (the module documentation).
+pub(super) fn with_breaks(cx: &Ctx, code: &[TokenIdx]) -> Option<Vec<TokenIdx>> {
+    let cst = cx.cst;
+    let ours = |t: TokenIdx| code.binary_search(&t).is_ok();
+    let gone = |t: TokenIdx| cx.is_dropped(t) || ours(t);
+    let source = |_: TokenIdx| false;
+    let first = code_before(cst, *code.first()?, &gone)?;
+    let last = code_after(cst, *code.last()?, &gone);
+    let mut breaks = Vec::new();
+    // The written code token before the gap of the output; whether a line
+    // break stays in it for itself (`own`) or only because a comment holds
+    // one that would go (`held`); whether one of those ended a line.
+    let (mut written, mut own, mut held, mut ends) = (first, false, false, false);
+    let mut a = first;
+    for i in first.index() + 1..=last.index() {
+        let b = TokenIdx(i as u32);
+        if !cst.token(b).kind.is_code() {
+            continue;
+        }
+        let gap = a.index() + 1..i;
+        let newline = |k: &usize| cst.tokens()[*k].kind == TokenKind::Newline && !cx.is_dropped(TokenIdx(*k as u32));
+        let newlines = || gap.clone().filter(newline);
+        if newlines().next().is_some() {
+            let end = line_end(cst, code_before(cst, a, &source), a, b, &source);
+            let comment = cst.tokens()[gap.clone()].iter().any(|t| t.kind.is_comment());
+            if end || !(ours(a) || ours(b)) || list_edge(cst, a, b, &gone) {
+                (own, ends) = (true, ends || end);
+            } else if comment {
+                held = true;
+            } else {
+                breaks.extend(newlines().map(|k| TokenIdx(k as u32)));
+            }
+        }
+        if !gone(b) {
+            let stays = own || held;
+            // A line break only a comment keeps would stay when the comment goes (`fn f() -> () // c` newline
+            // `uses {A} {}`): the form would hang on the comment, so the tokens stay.
+            if (held && !own) || (stays && line_end(cst, code_before(cst, written, &gone), written, b, &gone) != ends) {
+                return None;
+            }
+            (written, own, held, ends) = (b, false, false, false);
+        }
+        a = b;
+    }
+    Some(breaks)
+}
+
+/// The code token before `t` that `skip` does not take.
+fn code_before(cst: &Cst, t: TokenIdx, skip: &dyn Fn(TokenIdx) -> bool) -> Option<TokenIdx> {
+    (0..t.index()).rev().map(|i| TokenIdx(i as u32)).find(|&c| cst.token(c).kind.is_code() && !skip(c))
+}
+
+/// The code token after `t` that `skip` does not take (the `Eof` at the end).
+fn code_after(cst: &Cst, t: TokenIdx, skip: &dyn Fn(TokenIdx) -> bool) -> TokenIdx {
+    let mut after = (t.index() + 1..cst.tokens().len()).map(|i| TokenIdx(i as u32));
+    after.find(|&c| cst.token(c).kind.is_code() && !skip(c)).expect("a file ends with its Eof token")
+}
+
+/// The innermost pair of brackets round the gap between the code tokens `a`
+/// and `b` whose opening bracket is not `gone`, with its node; `None` at the
+/// top of the file. It walks up from `a` through the nesting (§2.5).
+fn round(cst: &Cst, a: TokenIdx, b: TokenIdx, gone: &dyn Fn(TokenIdx) -> bool) -> Option<(NodeId, TokenIdx, TokenIdx)> {
+    let mut n = Some(cst.token_parent(a));
+    while let Some(x) = n {
+        let pairs = shape::pairs(cst, x);
+        if let Some(&(open, close)) = pairs.iter().rev().find(|&&(o, c)| o <= a && b <= c && !gone(o)) {
+            return Some((x, open, close));
+        }
+        n = cst.parent(x);
+    }
+    None
+}
+
+/// Whether a line break between the code tokens `a` and `b` (`before` the
+/// one before `a`) ends a line (§2.5): in a block, a body of items or the
+/// file, unless the line goes on ([`continues`]); the pairs whose opening
+/// bracket is `gone` are not round it.
+fn line_end(cst: &Cst, before: Option<TokenIdx>, a: TokenIdx, b: TokenIdx, gone: &dyn Fn(TokenIdx) -> bool) -> bool {
+    let holds = round(cst, a, b, gone).is_none_or(|(n, _, _)| shape::holds_statements(cst.kind(n)));
+    let kind = |t: TokenIdx| cst.token(t).kind;
+    holds && !continues(before.map(kind), kind(a), kind(b))
+}
+
+/// Whether a line break between the code tokens `a` and `b` is at the edge
+/// of a list whose brackets stay: after its opening bracket or a `,`, before its closing
+/// bracket or a `,` (the form of the list, §3.2).
+fn list_edge(cst: &Cst, a: TokenIdx, b: TokenIdx, gone: &dyn Fn(TokenIdx) -> bool) -> bool {
+    let Some((n, open, close)) = round(cst, a, b, gone) else { return false };
+    let list = shape::shape(cst.kind(n)).is_some_and(|row| row.shape == Shape::List);
+    let comma = |t: TokenIdx| cst.token(t).kind == TokenKind::Comma;
+    list && (a == open || b == close || comma(a) || comma(b))
+}
