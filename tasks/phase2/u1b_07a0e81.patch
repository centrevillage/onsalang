+def is_zero(text):
+    """The number `text` is 0 in any spelling (`0x0_0`, `0.00`, `0e5`; not `1e-400`)."""
+    if text[:2] in ("0x", "0X", "0b", "0B"):
+        return set(text[2:]) <= set("0_")
+    return set(re.split("[eE]", text)[0]) <= set("0._")
