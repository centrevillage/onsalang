+/// delay and a local name that hides the delay are not seen. `-0` is a
+/// prefix `-` and stays, as `-0.0` does. `false` stays too: `check` does not
+/// take the `init` of a delay of a `Bool` left out yet (W7-07).
+fn init(cx: &Ctx, n: NodeId, out: &mut Vec<TokenIdx>) -> bool {
+    let cst = cx.cst;
+    let text = |t: TokenIdx| &cx.src[cst.token(t).span.start as usize..cst.token(t).span.end as usize];
+    if cst.kind(n) != NodeKind::CallExpr || keyword(cst, n, TokenKind::Tilde).is_none() {
+        return false;
+    }
+    let mut parts = cst.child_nodes(n);
+    let (Some(callee), Some(list)) = (parts.next(), parts.next()) else { return false };
+    let name = cst.significant_tokens(callee).filter(|(a, b)| a == b && cst.kind(callee) == NodeKind::PathExpr);
+    let Some(delay) = name.and_then(|(t, _)| Delay::named(text(t))) else { return false };
+    let args: Vec<NodeId> = cst.child_nodes(list).collect();
+    let Some(&arg) = args.get(delay.init_index()).filter(|_| args.len() == delay.init_index() + 1) else {
+        return false;
+    };
+    // The argument is its expression alone (no mode before it).
+    let (Some(mut value), Some((first, last))) = (cst.child_nodes(arg).next(), cst.significant_tokens(arg)) else {
+        return false;
+    };
+    if cst.significant_tokens(value).map(|(f, _)| f) != Some(first) {
+        return false;
+    }
+    while cst.kind(value) == NodeKind::ParenExpr {
+        let Some(inner) = cst.child_nodes(value).next() else { return false };
+        value = inner;
+    }
+    let literal = cst.significant_tokens(value).filter(|(a, b)| a == b && cst.kind(value) == NodeKind::Literal);
+    if !literal.is_some_and(|(t, _)| crate::literal::is_zero(cst.token(t).kind, text(t))) {
+        return false;
+    }
+    let comma = |t: Option<TokenIdx>| t.filter(|&t| cst.token(t).kind == TokenKind::Comma);
+    let next =
+        (last.index() + 1..cst.tokens().len()).map(|i| TokenIdx(i as u32)).find(|&t| cst.token(t).kind.is_code());
+    let before = (0..first.index()).rev().map(|i| TokenIdx(i as u32)).find(|&t| cst.token(t).kind.is_code());
+    let code = (first.index()..=last.index()).map(|i| TokenIdx(i as u32)).filter(|&t| cst.token(t).kind.is_code());
+    out.extend(code.chain(comma(next).or(comma(before))));
+    true
