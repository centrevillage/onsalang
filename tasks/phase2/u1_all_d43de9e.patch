diff --git a/crates/onsa_syntax/src/fmt/breaks.rs b/crates/onsa_syntax/src/fmt/breaks.rs
new file mode 100644
index 0000000..84c599c
--- /dev/null
+++ b/crates/onsa_syntax/src/fmt/breaks.rs
@@ -0,0 +1,124 @@
+//! The line breaks that go with the tokens a rewrite of §3.3 drops
+//! (`docs/onsa-tools.md` §3.2, §3.4, S-536): the one judgement of the form
+//! after a rewrite, which `fmt/rewrites.rs` asks for the tokens it drops from
+//! a node (`fn f()` newline `uses {} {}` is `fn f() {}`).
+//!
+//! A line break next to a dropped token goes with it, but a line end
+//! (between two statements or items, §2.5) and a line break at the edge of a
+//! list whose brackets stay (after its opening bracket or a `,`, before its
+//! closing bracket or a `,`: it makes the form of the list, §3.2). With a
+//! comment in the range, from the first dropped token to the last and the
+//! gaps of the line breaks that go with them, nothing is dropped
+//! (`fn f() -> () // c` newline `uses {A} {}` and `uses {` newline `// c`
+//! newline `}` stay); a comment outside it stays on its line (`fn a(self) ->
+//! () // c` is `fn a(self) // c`).
+//!
+//! The judgement reads the gaps between the written code token before the
+//! first dropped one and the one after the last: what is between them (the
+//! inside of a pair of brackets that goes, U2) is read again too.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+
+use super::rewrites::Ctx;
+use super::shape::{self, Shape};
+use crate::cst::{Cst, NodeId, TokenIdx};
+use crate::layout::continues;
+use crate::token::TokenKind;
+
+/// The pairs of brackets of the nodes ([`shape::pairs`]), each read once:
+/// [`round`] asks for those of every node above a gap, and a body of many
+/// members would be read again for each.
+#[derive(Default)]
+pub(super) struct Pairs(RefCell<HashMap<NodeId, Vec<(TokenIdx, TokenIdx)>>>);
+
+impl Pairs {
+    fn of(&self, cst: &Cst, n: NodeId) -> Vec<(TokenIdx, TokenIdx)> {
+        self.0.borrow_mut().entry(n).or_insert_with(|| shape::pairs(cst, n)).clone()
+    }
+}
+
+/// The line breaks that go with `code`, the code tokens in their order that
+/// a rewrite drops from a node, or `None` when a comment is in the range of
+/// the rewrite (the module documentation).
+pub(super) fn with_breaks(cx: &Ctx, code: &[TokenIdx]) -> Option<Vec<TokenIdx>> {
+    let cst = cx.cst;
+    let ours = |t: TokenIdx| code.binary_search(&t).is_ok();
+    let gone = |t: TokenIdx| cx.is_dropped(t) || ours(t);
+    let source = |_: TokenIdx| false;
+    let (start, end) = (*code.first()?, *code.last()?);
+    let first = code_before(cst, start, &gone)?;
+    let last = code_after(cst, end, &gone);
+    let mut breaks = Vec::new();
+    let mut a = first;
+    for i in first.index() + 1..=last.index() {
+        let b = TokenIdx(i as u32);
+        if !cst.token(b).kind.is_code() {
+            continue;
+        }
+        let gap = a.index() + 1..i;
+        let comment = cst.tokens()[gap.clone()].iter().any(|t| t.kind.is_comment());
+        let newline = |k: &usize| cst.tokens()[*k].kind == TokenKind::Newline && !cx.is_dropped(TokenIdx(*k as u32));
+        let goes = (ours(a) || ours(b))
+            && gap.clone().any(|k| newline(&k))
+            && !line_end(cx, code_before(cst, a, &source), a, b, &source)
+            && !list_edge(cx, a, b, &gone);
+        if comment && (goes || (start <= a && b <= end)) {
+            return None;
+        }
+        if goes {
+            breaks.extend(gap.filter(newline).map(|k| TokenIdx(k as u32)));
+        }
+        a = b;
+    }
+    Some(breaks)
+}
+
+/// The code token before `t` that `skip` does not take.
+fn code_before(cst: &Cst, t: TokenIdx, skip: &dyn Fn(TokenIdx) -> bool) -> Option<TokenIdx> {
+    (0..t.index()).rev().map(|i| TokenIdx(i as u32)).find(|&c| cst.token(c).kind.is_code() && !skip(c))
+}
+
+/// The code token after `t` that `skip` does not take (the `Eof` at the end).
+fn code_after(cst: &Cst, t: TokenIdx, skip: &dyn Fn(TokenIdx) -> bool) -> TokenIdx {
+    let mut after = (t.index() + 1..cst.tokens().len()).map(|i| TokenIdx(i as u32));
+    after.find(|&c| cst.token(c).kind.is_code() && !skip(c)).expect("a file ends with its Eof token")
+}
+
+/// The innermost pair of brackets round the gap between the code tokens `a`
+/// and `b` whose opening bracket is not `gone`, with its node; `None` at the
+/// top of the file. It walks up from `a` through the nesting (§2.5).
+fn round(cx: &Ctx, a: TokenIdx, b: TokenIdx, gone: &dyn Fn(TokenIdx) -> bool) -> Option<(NodeId, TokenIdx, TokenIdx)> {
+    let cst = cx.cst;
