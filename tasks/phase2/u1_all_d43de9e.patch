+            ("  if c { return } else if c { return }\n  return\n", "  if c {} else if c {}\n"),
+            ("  var x = 1\n  x = 2\n  return\n", "  var x = 1\n  x = 2\n"),
+            ("  for i in 0 ..< 3 {}\n  return\n", "  for i in 0 ..< 3 {}\n"),
+            ("  while c {}\n  return\n  return\n", "  while c {}\n"),
+            ("  let y = 1\n  return\n", "  let y = 1\n"),
+        ];
+        for (body, want) in cases {
+            assert_eq!(formatted(&f(body)), f(want), "{body}");
+        }
+    }
+
+    /// W3-12: the AST side takes the value of the block as the lowering does
+    /// ([`crate::ast::Block::take_value`]): the statement before a `return`
+    /// that goes is what the output reads, and the check before writing
+    /// lets it through. A `move` in a block that is not in the returned
+    /// position (a loop, `unsafe`, a `let`) stays.
+    #[test]
+    fn the_block_after_the_rewrite_is_the_block_of_the_output() {
+        assert_eq!(formatted("fn f() {\n  let x = 1\n  return\n}\n"), "fn f() {\n  let x = 1\n}\n");
+        for kept in [
+            "fn f(move a: B) -> B {\n  unsafe { move a }\n}\n",
+            "fn f(move a: B) -> B {\n  let b = { move a }\n  b\n}\n",
+            "fn f(c: Bool) {\n  while c {\n    return\n  }\n}\n",
+            "flow f(x: Sig[F32]) -> Sig[F32] { x }\n",
+        ] {
+            assert_eq!(formatted(kept), kept);
+        }
+    }
+
+    /// S-536 (`fmt/breaks.rs`): the line breaks next to a `-> ()` or a
+    /// `uses {}` that goes go with it, but the line ends and the edges of a
+    /// list. With a comment in the range of the rewrite (between its tokens,
+    /// or in the gap of a line break that would go: `fn c() // c` newline
+    /// `uses {} {}`, `fn h() -> () // h` newline `uses {Alloc} {}`, an
+    /// enclosure that holds only a comment) the tokens stay; so does `-> ()
+    /// at sample`.
+    #[test]
+    fn line_breaks_next_to_a_head_that_goes_go_with_it_unless_a_comment_is_in_the_range() {
+        let cases = [
+            ("fn a()\n  uses {} {}\n", "fn a() {}\n"),
+            ("fn b() ->\n  () {}\n", "fn b() {}\n"),
+            ("fn g() -> ()\n  uses {Alloc} {}\n", "fn g() uses {Alloc} {}\n"),
+            ("fn i() -> (()) {}\n", "fn i() {}\n"),
+            ("fn m() -> (\n) uses {\n} {}\n", "fn m() {}\n"),
+            ("struct S {\n  a: fn(F32) -> ()\n}\n", "struct S {\n  a: fn(F32),\n}\n"),
+            (
+                "trait T {\n  fn a(self) -> ()\n\n  fn b(self) -> () uses {}\n  fn c(self)\n}\n",
+                "trait T {\n  fn a(self)\n\n  fn b(self)\n  fn c(self)\n}\n",
+            ),
+            ("type F = fn(\n  I32,\n) -> ()\n", "type F = fn(\n  I32,\n)\n"),
+        ];
+        for (src, want) in cases {
+            assert_eq!(formatted(src), want, "{src}");
+        }
+        assert_eq!(formatted("fn f() -> () at sample {}\n"), "fn f() -> () at sample {}\n");
+        // The tokens stay, and the comparison of §3.5 still rewrites the node: the same program as the
+        // file without them (`diff --ast` does not change with a comment or a line break).
+        for (kept, plain) in [
+            ("fn c() // c\n  uses {} {}\n", "fn c() {}\n"),
+            ("fn d() -> // c\n  () {}\n", "fn d() {}\n"),
+            ("fn e() -> I32 uses {\n  // c\n} {\n  1\n}\n", "fn e() -> I32 {\n  1\n}\n"),
+            ("type T = fn(I32) -> I32 uses {\n  // c\n}\n", "type T = fn(I32) -> I32\n"),
+            ("fn f() -> ( // c\n) {}\n", "fn f() {}\n"),
+            ("fn h() -> () // c\n  uses {Alloc} {}\n", "fn h() uses {Alloc} {}\n"),
+        ] {
+            assert_eq!(formatted(kept), kept);
+            let (a, b) = (crate::parse(FileId(0), kept), crate::parse(FileId(0), plain));
+            assert!(crate::diff::diff(&a, kept, &b, plain).is_empty(), "{kept}");
+        }
+    }
+
+    /// S-536 (1): a comment outside the range of the rewrite stays on its
+    /// line, after a line end or at the edge of a list (`fn a(self) -> () //
+    /// c` is `fn a(self) // c`); one in it keeps the tokens of that rewrite,
+    /// and the `-> ()` and the `uses {}` of a head that share the gap of a
+    /// comment both stay (W3-12/b 2: one pass reaches the fixed point, in a
+    /// head, a function type, a type alias, a field and the members of a
+    /// trait, an `extern` block and an effect).
+    #[test]
+    fn a_comment_out_of_the_range_stays_on_its_line_and_one_in_it_keeps_the_tokens() {
+        let cases = [
+            (
+                "trait T {\n  fn a(self) -> () // c\n  fn b(self)\n}\n",
+                "trait T {\n  fn a(self) // c\n  fn b(self)\n}\n",
+            ),
+            ("struct S {\n  a: fn(F32) -> () // c\n}\n", "struct S {\n  a: fn(F32), // c\n}\n"),
+            ("fn f() -> () uses {} { // c\n}\n", "fn f() { // c\n}\n"),
+            ("type T = fn(F32) -> () uses {} // c\nfn g() {}\n", "type T = fn(F32) // c\nfn g() {}\n"),
+            ("type T = fn(F32) -> // c\n  () uses {}\n", "type T = fn(F32) -> // c\n  ()\n"),
+            ("type T = fn(F32) -> () uses { // c\n}\n", "type T = fn(F32) uses { // c\n}\n"),
+        ];
+        for (src, want) in cases {
+            assert_eq!(formatted(src), want, "{src}");
+        }
+        for kept in [
+            "type T = fn(F32) -> () // c\n  uses {}\n",
+            "type T = fn(F32) -> ()\n  // c\n  uses {}\n",
+            "fn h() -> () // c\n  uses {} {}\n",
+            "fn p(f: fn(F32) -> () // c\n  uses {}) {}\n",
+            "struct S {\n  a: fn(F32) -> () // c\n    uses {},\n}\n",
+            "trait T {\n  fn a(self) -> () // c\n    uses {}\n}\n",
+            "extern \"C\" lib \"m\" {\n  fn e(x: F64) -> () // c\n    uses {}\n}\n",
+            "effect E {\n  fn op(x: F32) -> () // c\n    uses {}\n}\n",
+            "fn g() -> I32 uses { // c\n} {\n  1\n}\n",
+        ] {
+            assert_eq!(formatted(kept), kept);
+        }
+    }
+
+    /// W3-12/b 1: an empty `uses {}` before another `uses` or an `at` stays:
+    /// without it they would be the function type's (§8.1, §11.4), another
+    /// program. Of two empty ones the outer goes first, so the inner one goes
+    /// too in the same pass. The comparison of §3.5 tells the two apart.
+    #[test]
+    fn an_empty_uses_before_another_uses_stays() {
+        for kept in [
+            "fn make() -> fn() -> I32 uses {} uses {Alloc} {\n  fn() -> I32 { 1 }\n}\n",
+            "type Maker = fn() -> fn() -> I32 uses {} uses {Alloc}\n",
+            "fn go() uses {Alloc} {\n  let m = fn() -> fn() -> I32 uses {} uses {Alloc} { g }\n}\n",
+            "fn f() -> fn() uses {} uses {Alloc} {}\n",
+            "flow f(g: fn() -> I32 uses {} at sample) -> F32 at sample {\n  0.0\n}\n",
+        ] {
+            assert_eq!(formatted(kept), kept);
+        }
+        assert_eq!(formatted("type M = fn() -> fn() -> I32 uses {} uses {}\n"), "type M = fn() -> fn() -> I32\n");
+        assert_eq!(formatted("type M = fn() -> fn() -> () uses {Alloc}\n"), "type M = fn() -> fn() uses {Alloc}\n");
+        let differ = |a: &str, b: &str| {
+            let (pa, pb) = (crate::parse(FileId(0), a), crate::parse(FileId(0), b));
+            !crate::diff::diff(&pa, a, &pb, b).is_empty()
+        };
+        assert!(differ("fn f() -> fn() uses {} uses {Alloc} {}\n", "fn f() -> fn() uses {Alloc} {}\n"));
+        assert!(differ("type M = fn() -> fn() -> I32 uses {Alloc}\n", "type M = fn() -> (fn() -> I32) uses {Alloc}\n"));
+        assert!(differ("fn f() -> fn() -> I32 uses {} uses {A} {}\n", "fn f() -> fn() -> I32 uses {A} {}\n"));
+    }
+
+    /// S-546: the `-> ()` and the `uses {}` of an anonymous function stay
+    /// (there, leaving them out leaves the result and the effects to the
+    /// expected type or the body); those of a function type in it go. The
+    /// `move` of a value that is not a place stays (E0711); that of a place
+    /// goes.
+    #[test]
+    fn the_head_of_an_anonymous_function_and_the_move_of_a_value_stay() {
+        for kept in [
+            "fn f() {\n  take(fn(x: I32) -> () uses {} { x })\n}\n",
+            "fn f() -> B {\n  move g()\n}\n",
+            "fn f() -> B {\n  move g().b\n}\n",
+        ] {
+            assert_eq!(formatted(kept), kept);
+        }
+        assert_eq!(
+            formatted("fn f() {\n  let g = fn(h: fn() -> () uses {}) -> () { h() }\n}\n"),
+            "fn f() {\n  let g = fn(h: fn()) -> () { h() }\n}\n"
+        );
+        assert_eq!(
+            formatted("fn f(move a: B) -> B {\n  move a.b[0].0\n}\n"),
+            "fn f(move a: B) -> B {\n  a.b[0].0\n}\n"
+        );
+    }
+
+    /// S-545 with `-> ()`: the `return` after a call stays (the call would be
+    /// the value) and `-> ()` goes; after an assignment both go.
+    #[test]
+    fn a_unit_return_type_goes_and_the_return_after_a_call_stays() {
+        assert_eq!(formatted("fn f() -> () {\n  g()\n  return\n}\n"), "fn f() {\n  g()\n  return\n}\n");
+        assert_eq!(
+            formatted("fn f(inout x: I32) -> () uses {} {\n  x = 1\n  return\n}\n"),
+            "fn f(inout x: I32) {\n  x = 1\n}\n"
+        );
+    }
+
+    /// S-539: the `init` that equals the default value stays, in any spelling,
+    /// with a comment, in the block and the continuation forms (the syntax
+    /// alone does not show that it can go: `let y = prev~(^y, 0)` takes its
+    /// type from it). Only the layout of §3.2 changes.
+    #[test]
+    fn the_init_of_the_value_zero_stays() {
+        let f = |body: &str| {
+            format!("pub flow f(x: F32 at sample, n: I32 at sample, b: Bool at sample) -> F32 at sample {{\n{body}}}\n")
+        };
+        let cases = [
+            ("  prev~(x, 00.00,)\n", "  prev~(x, 0.00)\n"),
+            ("  delay~(\n    x,\n    4,\n    0.0\n  )\n", "  delay~(\n    x,\n    4,\n    0.0,\n  )\n"),
+            (
+                "  let y = prev~(x, // c\n    0.0) // d\n  y\n",
+                "  let y = prev~(x,   // c\n                0.0) // d\n  y\n",
+            ),
+        ];
+        for (body, want) in cases {
+            assert_eq!(formatted(&f(body)), f(want), "{body}");
+        }
+        for body in ["  vdelay~(x, x, 8, 0x0_0) + prev~(x, (0.0e5))\n", "  prev~(n, 0)\n", "  prev~(b, false)\n"] {
+            assert_eq!(formatted(&f(body)), f(body));
+        }
+    }
+
+    /// The AST side does not decide again: a chosen node whose AST is not of
+    /// the form the CST side saw is an internal error.
+    #[test]
+    fn a_chosen_node_of_another_form_is_an_internal_error() {
+        let src = "fn f(move a: B) -> I32 {\n  return 1\n  2\n}\n";
+        let parsed = crate::parse(FileId(0), src);
+        let of =
+            |kind: NodeKind| super::all_nodes(&parsed.cst).into_iter().find(|&n| parsed.cst.kind(n) == kind).unwrap();
+        let (ret, head) = (of(NodeKind::ReturnStmt), of(NodeKind::Fn));
+        for (rewrite, chosen, what) in [
+            (super::tail_return_ast as fn(&mut Ast, &Parsed, &[NodeId]), ret, "not the last of their block"),
+            (super::ret_move_ast, ret, "not a `move`"),
+            (super::unit_ret_ast, head, "no return type `()`"),
+            (super::empty_uses_ast, head, "no empty `uses`"),
+            (super::unit_ret_ast, ret, "no return type `()`"),
+        ] {
+            let mut ast = parsed.ast.clone();
+            let caught =
+                std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| rewrite(&mut ast, &parsed, &[chosen])));
+            let payload = caught.expect_err("an internal error");
+            let bug = payload.downcast_ref::<onsa_diag::internal::InternalBug>().expect("a bug of the compiler");
+            assert!(bug.message.contains(what), "{}", bug.message);
+        }
+    }
+
+    /// Every node of `tests/spec` (the files without a syntax error) that a
+    /// rewrite here can choose, and the block of a `return`, is made into one
+    /// AST node of the kind the AST side reads (W3-11/b2 `mapcheck`:
+    /// `Parsed::map` is not injective for every kind), and [`super::normalize`]
+    /// takes the chosen ones.
+    #[test]
+    fn the_nodes_a_rewrite_can_choose_have_their_ast_node_in_every_case_file() {
+        onsa_diag::stack::run(|| {
+            let (mut nodes, mut chosen) = (0, 0);
+            let files = crate::cst_tests::repo_files();
+            let files: Vec<_> = files.iter().filter(|(name, _)| name.starts_with("tests/spec/")).collect();
+            assert!(files.len() > 400, "only {} files", files.len());
+            for (name, text) in files {
+                let parsed = crate::parse(FileId(0), text);
+                if parsed.syntax_errors() {
+                    continue;
+                }
+                let counts = |map: &[NodeId]| {
+                    let mut c = std::collections::HashMap::new();
+                    map.iter().for_each(|&n| *c.entry(n).or_insert(0) += 1);
+                    c
+                };
+                let (stmts, exprs) = (counts(&parsed.map.stmts), counts(&parsed.map.exprs));
+                let (items, types) = (counts(&parsed.map.items), counts(&parsed.map.types));
+                for n in super::all_nodes(&parsed.cst) {
+                    let cst = &parsed.cst;
+                    let (map, n) = match cst.kind(n) {
+                        NodeKind::ReturnStmt => (&stmts, n),
+                        NodeKind::MoveExpr | NodeKind::Block => (&exprs, n),
+                        NodeKind::FnType => (&types, n),
+                        // The item of a function, after `target` too (`super::head_of`).
+                        NodeKind::Fn => {
+                            let p = cst.parent(n).unwrap();
+                            (&items, if cst.kind(p) == NodeKind::Target { cst.parent(p).unwrap() } else { p })
+                        }
+                        _ => continue,
+                    };
+                    assert_eq!(
+                        map.get(&n),
+                        Some(&1),
+                        "{name}: {} at {:?}",
+                        parsed.cst.kind(n).name(),
+                        parsed.cst.span(n)
+                    );
+                    nodes += 1;
+                }
+                let choices = super::choose(&parsed, &super::all_nodes(&parsed.cst));
+                chosen += choices.chosen.iter().flatten().count();
+                super::normalize(&parsed);
+            }
+            assert!(nodes > 1000 && chosen > 0, "{nodes} nodes, {chosen} chosen");
+        });
+    }
 }
