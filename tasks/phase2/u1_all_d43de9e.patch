+// onsa.toml
+// [test]
+// mode = "parse"
+// spec = ["§6.1", "§8.1", "§11.4", "§18.2"]
+
+// The `-> ()` and the empty `uses {}` that `onsa fmt` keeps (W3-12, unit U1; docs/onsa-tools.md §3.3 and
+// §3.4, S-536, S-540): with a comment in the range of the rewrite (between its tokens, or in the gap of a
+// line break that would go with them), and an empty `uses {}` before another `uses` or an `at` (without it
+// they would be the function type's, spec §8.1 and §11.4). They stand in a function, a parameter, a type
+// alias, a field, and the members of a trait, an `extern` block and an effect, with the line break after
+// the `-> ()`. The file is canonical, so `onsa fmt` leaves it unchanged; the gaps round these tokens are
+// where the comments and the line breaks that the property `fmt-props` of the gate puts in meet the rule.
+// This version does not run a `trait`, an `effect` and an `extern` block (E0200 of `onsa check`), so the
+// file is read by the syntax stage only (`mode = "parse"`).
+
+fn a() -> () // a
+  uses {} {}
+
+fn b() -> ()
+  // b
+  uses {} {}
+
+fn c() -> // c
+  () {}
+
+fn d() -> I32 uses {
+  // d
+} {
+  1
+}
+
+fn e(f: fn(F32) -> () // e
+  uses {}) {}
+
+type T = fn(F32) -> () // t
+  uses {}
+
+type U = fn(F32) -> ( // u
+)
+
+type Maker = fn() -> fn() -> I32 uses {} uses {Alloc}
+
+fn make() -> fn() -> I32 uses {} uses {Alloc} {
+  fn() -> I32 { 1 }
+}
+
+pub flow g(h: fn() -> I32 uses {} at sample) -> F32 at sample {
+  0.0
+}
+
+struct S {
+  a: fn(F32) -> () // s
+    uses {},
+  b: fn(F32) -> ()
+    // s2
+    uses {},
+}
+
+trait Sink {
+  fn put(inout self, x: F32) -> () // put
+    uses {}
+  fn size(self) -> U32
+}
+
+extern "C" lib "m" {
+  fn log_value(x: F64) -> () // log
+    uses {}
+  fn sin(x: F64) -> F64
+}
+
+effect Out {
+  fn emit(x: F32) -> () // emit
+    uses {}
+  fn flush()
+}
