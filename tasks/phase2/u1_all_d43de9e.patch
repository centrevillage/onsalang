diff --git a/crates/onsa_syntax/src/fmt/tail.rs b/crates/onsa_syntax/src/fmt/tail.rs
new file mode 100644
index 0000000..88849f5
--- /dev/null
+++ b/crates/onsa_syntax/src/fmt/tail.rs
@@ -0,0 +1,149 @@
+//! The places of the rewrites of `fmt/rewrites.rs` that a returned value
+//! decides: the tail position of spec §6.1 (the `return`s that go) and the
+//! returned position of §5.2 (the `move`s that go). Each judgement walks up
+//! from a node to its parents, through the nesting of §2.5 (at most 256
+//! levels), so the whole choice stays linear in the tree.
+
+use super::rewrites::Ctx;
+use crate::cst::{Cst, Elem, NodeId, NodeKind};
+
+/// Whether `n` is a `return` without a value.
+pub(super) fn valueless_return(cst: &Cst, n: NodeId) -> bool {
+    cst.kind(n) == NodeKind::ReturnStmt && cst.child_nodes(n).next().is_none()
+}
+
+/// The last statement of the block `b` once the `return`s without a value
+/// at its end that can go are gone (the attributes the lowering skips are
+/// skipped too): the one judgement of which of them go, which
+/// `rewrites::tail_return`, [`last_of_tail_block`] and [`is_ret_expr`] read.
+/// They go unless the statement before them is an expression statement
+/// whose value the syntax does not show to be `()`: without them, its
+/// expression would be the value of the block and the program another
+/// (S-545). Then the first of them stays (it is the last statement) and the
+/// others go.
+pub(super) fn effective_last(cst: &Cst, b: NodeId) -> Option<NodeId> {
+    let mut first_return = None;
+    for e in cst.children(b).iter().rev() {
+        let Elem::Node(x) = *e else { continue };
+        if cst.kind(x) == NodeKind::Attr {
+            continue;
+        }
+        if !valueless_return(cst, x) {
+            let kept = cst.kind(x) == NodeKind::ExprStmt && !cst.child_nodes(x).next().is_some_and(|e| unit(cst, e));
+            return if kept { first_return.or(Some(x)) } else { Some(x) };
+        }
+        first_return = Some(x);
+    }
+    None
+}
+
+/// Whether the syntax shows the value of the expression `e` to be `()`: an
+/// `if` whose chain of `else if` has no last `else`. Any other expression
+/// (a call, a `match`, a block) may have a value.
+fn unit(cst: &Cst, e: NodeId) -> bool {
+    if cst.kind(e) != NodeKind::IfExpr {
+        return false;
+    }
+    let has_else = cst.child_tokens(e).any(|t| cst.token(t).kind == crate::token::TokenKind::KwElse);
+    !has_else || last_node(cst, e).is_some_and(|x| unit(cst, x))
+}
+
+/// The last child node of `n`, looked for from the end.
+pub(super) fn last_node(cst: &Cst, n: NodeId) -> Option<NodeId> {
+    cst.children(n).iter().rev().find_map(|e| match *e {
+        Elem::Node(c) => Some(c),
+        Elem::Token(_) => None,
+    })
+}
+
+/// The parent of the expression `e` out of its parentheses, and the
+/// outermost parenthesis (or `e`): a parenthesis does not change where an
+/// expression is, whether fmt takes it off or not.
+fn climb(cst: &Cst, mut e: NodeId) -> Option<(NodeId, NodeId)> {
+    loop {
+        let p = cst.parent(e)?;
+        if cst.kind(p) != NodeKind::ParenExpr {
+            return Some((p, e));
+        }
+        e = p;
+    }
+}
+
+/// The `match` of the arm `arm` (in its `MatchArms`).
+fn match_of(cst: &Cst, arm: NodeId) -> Option<NodeId> {
+    cst.parent(arm).and_then(|arms| cst.parent(arms))
+}
+
+/// Whether `child` of the `if` or the arm `p` is a branch (not the
+/// condition) or the value of the arm (not the pattern or the guard), and
+/// the `if` or the `match` is where `place` says.
+fn branch_of(cst: &Cst, p: NodeId, child: NodeId, place: impl Fn(NodeId) -> bool) -> bool {
+    match cst.kind(p) {
+        NodeKind::IfExpr => cst.child_nodes(p).next() != Some(child) && place(p),
+        NodeKind::MatchArm => last_node(cst, p) == Some(child) && match_of(cst, p).is_some_and(place),
+        _ => false,
+    }
+}
+
+/// Whether the block `b` is in the tail position (§6.1): the body of a
+/// function (a method, a default body of a trait and a function of a
+/// handler too) or of an anonymous function, or a branch of an `if` or an
+/// arm of a `match` in the tail position. Not the body of a loop, of a
+/// `flow`, of a `test`, nor an `unsafe`, `handle` or block expression.
+pub(super) fn is_tail_block(cx: &Ctx, b: NodeId) -> bool {
+    let cst = cx.cst;
+    let Some(p) = cst.parent(b) else { return false };
+    matches!(cst.kind(p), NodeKind::Fn | NodeKind::ClosureExpr) || branch_of(cst, p, b, |e| is_tail_expr(cx, e))
+}
+
+/// Whether the expression `e` is in the tail position: the last statement
+/// of a block in the tail position (a `return` without a value after it
+/// goes too) or the value of the `return` there, or a branch of such an
+/// `if` or `match`.
+fn is_tail_expr(cx: &Ctx, e: NodeId) -> bool {
+    let cst = cx.cst;
+    let Some((p, child)) = climb(cst, e) else { return false };
+    match cst.kind(p) {
+        NodeKind::ExprStmt | NodeKind::ReturnStmt => last_of_tail_block(cx, p),
+        _ => branch_of(cst, p, child, |e| is_tail_expr(cx, e)),
+    }
+}
+
+/// Whether the statement `s` is the last of a block in the tail position,
+/// the `return`s without a value after it left out.
+pub(super) fn last_of_tail_block(cx: &Ctx, s: NodeId) -> bool {
+    let Some(b) = cx.cst.parent(s).filter(|&b| cx.cst.kind(b) == NodeKind::Block) else { return false };
+    cx.effective_last(b) == Some(s) && is_tail_block(cx, b)
+}
+
+/// Whether the expression `e` is in the returned position (§5.2): the value
+/// of any `return` (an early one too), the last expression of a block in the
+/// returned position (or the last before the `return`s without a value that
+/// go from a block in the tail position), or a branch of an `if`, an arm of
+/// a `match` or a block expression there. Not inside an `unsafe` or a
+/// `handle` block.
+pub(super) fn is_ret_expr(cx: &Ctx, e: NodeId) -> bool {
+    let cst = cx.cst;
+    let Some((p, child)) = climb(cst, e) else { return false };
+    match cst.kind(p) {
+        NodeKind::ReturnStmt => true,
+        NodeKind::ExprStmt => {
+            let Some(b) = cst.parent(p).filter(|&b| cst.kind(b) == NodeKind::Block) else { return false };
+            (last_node(cst, b) == Some(p) && is_ret_block(cx, b)) || last_of_tail_block(cx, p)
+        }
+        _ => branch_of(cst, p, child, |e| is_ret_expr(cx, e)),
+    }
+}
+
+/// Whether the block `b` is in the returned position: the body of a
+/// function or an anonymous function, a branch or an arm in the returned
+/// position, or a block expression there.
+fn is_ret_block(cx: &Ctx, b: NodeId) -> bool {
+    let cst = cx.cst;
+    let Some(p) = cst.parent(b) else { return false };
+    match cst.kind(p) {
+        NodeKind::Fn | NodeKind::ClosureExpr => true,
+        NodeKind::IfExpr => branch_of(cst, p, b, |e| is_ret_expr(cx, e)),
+        _ => is_ret_expr(cx, b),
+    }
+}
