+// onsa.toml
+// [test]
+// mode = "check"
+// spec = ["§11.4", "§18.2"]
+
+// The `init` that `onsa fmt` keeps (W3-12, unit U1; docs/onsa-tools.md §3.3, spec §11.4): every one (S-539:
+// the syntax alone does not show that an `init` equal to the default value can go, so `prev~(x)` and
+// `prev~(x, 0.0)` are both taken as they are written). Here: a value that is not the default (`1.0`, `0.5`,
+// `1`), `-0.0`, a name (an input of the clock `init`, a constant that happens to be `0.0`), the argument of
+// a flow of the user, and the default value itself (`0.0`, `0`). The file is canonical, so `onsa fmt`
+// leaves it unchanged.
+
+const ZERO: F32 = 0.0
+
+pub flow k1(x: F32 at sample) -> F32 at sample {
+  prev~(x, 1.0)
+}
+
+pub flow k2(x: F32 at sample, start: F32 at init) -> F32 at sample {
+  prev~(x, start)
+}
+
+pub flow k3(x: F32 at sample) -> F32 at sample {
+  prev~(x, -0.0)
+}
+
+pub flow k4(x: F32 at sample) -> F32 at sample {
+  prev~(x, ZERO)
+}
+
+pub flow k5(x: F32 at sample) -> F32 at sample {
+  delay~(x, 4, 0.5)
+}
+
+pub flow k6(x: F32 at sample, d: F32 at sample) -> F32 at sample {
+  vdelay~(x, d, 8, -0.0)
+}
+
+pub flow k7(n: I32 at sample) -> I32 at sample {
+  prev~(n, 1)
+}
+
+pub flow k8(b: Bool at sample) -> Bool at sample {
+  prev~(b, true)
+}
+
+pub flow k9(x: F32 at sample, start: F32 at init) -> F32 at sample {
+  delay~(x, 4, start)
+}
+
+pub flow lag(x: F32 at sample, start: F32 at init) -> F32 at sample {
+  prev~(x, start)
+}
+
+pub flow use_lag(x: F32 at sample) -> F32 at sample {
+  lag~(x, 0.0)
+}
+
+pub flow zero(x: F32 at sample, n: I32 at sample) -> F32 at sample {
+  let m = delay~(n, 4, 0)
+  prev~(x, 0.0)
+}
diff --git a/tests/spec/fmt/rewrite_move_kept.onsa b/tests/spec/fmt/rewrite_move_kept.onsa
new file mode 100644
index 0000000..a012936
--- /dev/null
+++ b/tests/spec/fmt/rewrite_move_kept.onsa
@@ -0,0 +1,64 @@
+// onsa.toml
+// [test]
+// mode = "parse"
+// spec = ["§5.2", "§18.2"]
+
+// The `move` that `onsa fmt` keeps (W3-12, unit U1; docs/onsa-tools.md §3.3, spec §5.2). Only a `move` in the
+// returned position (`return move a`, `move a` at the end of a function, in the arms of a block there) is
+// taken off. A `move` where a value is consumed is the mark that E0711 asks for, so it stays: the
+// initializer of a `let` and of a `var` (also in the arms of an `if` and a `match` that are there), an
+// assignment, an argument, an element of a struct literal, the subject of a `match`, the source of a
+// `for`. A function that returns `Holder { buf: move a }` has the `move` in the element of the literal,
+// which is a consuming position, not the returned one. The file is canonical, so `onsa fmt` leaves it
+// unchanged; the same functions with a returned `move` are in crates/onsa_cli/tests/fmt_rewrites.rs.
+// Only the syntax is checked here (`mode = "parse"`): the modes of the values are the check of W4-09.
+
+pub struct Holder {
+  buf: Buf[F32],
+}
+
+fn take(move t: Buf[F32]) -> U32 uses {Alloc} {
+  t.len()
+}
+
+fn let_if(c: Bool, move a: Buf[F32], move b: Buf[F32]) -> Buf[F32] uses {Alloc} {
+  let y = if c { move a } else { move b }
+  y
+}
+
+fn let_match(k: I32, move a: Buf[F32], move b: Buf[F32]) -> Buf[F32] uses {Alloc} {
+  let y = match k {
+    0 => move a,
+    _ => move b,
+  }
+  y
+}
+
+fn argument(move a: Buf[F32]) -> U32 uses {Alloc} {
+  take(move a)
+}
+
+fn assigned(move a: Buf[F32], move b: Buf[F32]) -> Buf[F32] uses {Alloc} {
+  var y = move a
+  y = move b
+  y
+}
+
+fn wrapped(move a: Buf[F32]) -> Holder uses {Alloc} {
+  Holder { buf: move a }
+}
+
+fn scrutinee(move o: Option[Buf[F32]]) -> U32 uses {Alloc} {
+  match move o {
+    Some(b) => { b.len() },
+    None => 0,
+  }
+}
+
+fn consumed_loop(move xs: [Buf[F32]; 2]) -> U32 uses {Alloc} {
+  var n = 0
+  for s in move xs {
+    n = n + s.len()
+  }
+  n
+}
diff --git a/tests/spec/fmt/rewrite_tail_return_kept.onsa b/tests/spec/fmt/rewrite_tail_return_kept.onsa
new file mode 100644
index 0000000..2de1ca9
--- /dev/null
+++ b/tests/spec/fmt/rewrite_tail_return_kept.onsa
@@ -0,0 +1,83 @@
+// onsa.toml
+// [test]
+// mode = "check"
+// spec = ["§6.1", "§18.2"]
+
+// The `return`s that `onsa fmt` keeps (W3-12, unit U1; docs/onsa-tools.md §3.3, spec §6.1). Only a `return`
+// in the tail position is taken off: the end of the body of a function or of an anonymous function, and the
+// end of every branch of an `if` and every arm of a `match` that is there, down to the end. The `return`s
+// below are early exits, and none of them is in the tail position: one in a loop (also when it is the
+// last statement of the loop), one before the end of the body, one in the value of a `let`, one in the
+// condition of an `if`. The file is canonical, so `onsa fmt` leaves it unchanged; the same functions with
+// a `return` in the tail position are in crates/onsa_cli/tests/fmt_rewrites.rs.
+
+fn first_big(xs: [I32; 4]) -> I32 {
