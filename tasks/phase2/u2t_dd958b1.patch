+// onsa.toml
+// [test]
+// mode = "parse"
+// spec = ["§3.1", "§4.1", "§11.3", "§18.2"]
+
+// The parentheses that `onsa fmt` does not take off round an `at` expression in a binary operator, and
+// round a function type that is followed by `at` (docs/onsa-tools.md §3.3, S-339; spec §3.1 and §11.3:
+// `at` is as strong as `as`, and the clock of a function type goes to the return type without the pair).
+// The clocks are not lowered with the arguments in this version, so the file is read by the syntax stage
+// only (`mode = "parse"`). The file is canonical, so `onsa fmt` leaves it unchanged.
+
+pub flow clocks(p: F32 at block) -> F32 at sample {
+  let q = (p at sample) * 2.0
+  q
+}
+
+pub flow gate(p: F32 at block, g: (fn(F32) -> F32) at block) -> F32 at sample {
+  let q = p at sample
+  q
+}
diff --git a/tests/spec/fmt/parens_kept_casts.onsa b/tests/spec/fmt/parens_kept_casts.onsa
new file mode 100644
index 0000000..68702a8
--- /dev/null
+++ b/tests/spec/fmt/parens_kept_casts.onsa
@@ -0,0 +1,94 @@
+// onsa.toml
+// [test]
+// mode = "test"
+// spec = ["§3.1", "§7", "§18.2"]
+
+// The parentheses that `onsa fmt` does not take off round the expressions of `as`, in a binary operator
+// and as the end of a range, and round a stack of prefix operators (docs/onsa-tools.md §3.3, S-339,
+// S-340): without them the expression is an error of the syntax stage (E0011 for `acc + x as F64`,
+// `(x as I32) as I64` and `0 ..< n as U32`, E0012 for `-(-x)` and `!(!c)`), or another tree
+// (`-(x as F64)` is not `-x as F64`). The pair round the end of a range that holds an operator without a
+// strength against the range's end operand (`(n + 1) % hi`) stays too: only the pair of the whole end
+// goes. The file is canonical, so `onsa fmt` leaves it unchanged. Every value below is worked out by hand
+// from the spec text.
+
+fn add_cast(acc: F64, x: I32) -> F64 {
+  acc + (x as F64)
+}
+
+fn double_cast(x: I32) -> F64 {
+  (x as F64) * 2.0
+}
+
+fn compare_cast(x: I32, y: F64) -> Bool {
+  (x as F64) < y
+}
+
+fn widen_twice(x: I16) -> I64 {
+  (x as I32) as I64
+}
+
+fn negate_cast(x: I32) -> F64 {
+  -(x as F64)
+}
+
+fn cast_of_sum(x: I32) -> F64 {
+  (x + 1) as F64
+}
+
+fn stacked_minus(x: I32) -> I32 {
+  -(-x)
+}
+
+fn stacked_not(c: Bool) -> Bool {
+  !(!c)
+}
+
+fn cast_end(n: U8) -> U32 {
+  var total: U32 = 0
+  for i in 0 ..< (n as U32) {
+    total = total + i
+  }
+  total
+}
+
+fn cast_start(m: U16) -> U32 {
+  var total: U32 = 0
+  for i in (m as U32) ..< 9 {
+    total = total + i
+  }
+  total
+}
+
+fn remainder_end(n: U32, hi: U32) -> U32 {
+  var total: U32 = 0
+  for i in 0 ..< (n + 1) % hi {
+    total = total + i
+  }
+  total
+}
+
+test "the pair round an as expression" {
+  // 1.5 + 2.0 = 3.5; 3.0 * 2.0 = 6.0; 2.0 < 2.5.
+  assert add_cast(1.5, 2) == 3.5
+  assert double_cast(3) == 6.0
+  assert compare_cast(2, 2.5)
+  assert widen_twice(7) == 7
+  // -(3 as F64) = -3.0; (2 + 1) as F64 = 3.0.
+  assert negate_cast(3) == -3.0
+  assert cast_of_sum(2) == 3.0
+}
+
+test "the pair of a stack of prefix operators" {
+  assert stacked_minus(5) == 5
+  assert stacked_minus(-5) == -5
+  assert stacked_not(true)
+  assert !stacked_not(false)
+}
+
+test "the pair round an end of a range" {
+  // 0 + 1 + 2 + 3 = 6; 7 + 8 = 15; (4 + 1) % 3 = 2, so 0 + 1 = 1.
+  assert cast_end(4) == 6
+  assert cast_start(7) == 15
+  assert remainder_end(4, 3) == 1
+}
diff --git a/tests/spec/fmt/parens_kept_comments.onsa b/tests/spec/fmt/parens_kept_comments.onsa
new file mode 100644
index 0000000..aeebfc5
--- /dev/null
+++ b/tests/spec/fmt/parens_kept_comments.onsa
@@ -0,0 +1,21 @@
+// onsa.toml
+// [test]
+// spec = ["§2.5", "§3.1", "§18.2"]
+
+// A pair that has a comment before `as` stays (docs/onsa-tools.md §3.2, §3.3, §3.4, S-339, S-497). Inside a
+// pair `as` and `at` take no rule of place, so `fmt` takes the line break round them off; but the line break
+// after a comment at the end of a line stays in every place (a comment ends its line). Without the pair the
+// line after the comment would start with `as`, and that is a new statement and an error of the syntax
+// stage, so the pair is not redundant. The file is canonical, so `onsa fmt` leaves it unchanged.
+
+fn comment_before_as(x: I32) -> F64 {
+  let y = (x // the value
+    as F64)
+  y
+}
+
+fn comment_before_as_in_a_product(x: I32) -> F64 {
+  let y = (x // the value
+    as F64) * 2.0
+  y
+}
diff --git a/tests/spec/fmt/parens_kept_groups.onsa b/tests/spec/fmt/parens_kept_groups.onsa
new file mode 100644
index 0000000..55ae366
--- /dev/null
+++ b/tests/spec/fmt/parens_kept_groups.onsa
@@ -0,0 +1,158 @@
+// onsa.toml
+// [test]
+// mode = "test"
+// spec = ["§3.1", "§18.2"]
+
+// The parentheses that `onsa fmt` does not take off when the groups of the binary operators are in them
+// (docs/onsa-tools.md §3.3, S-115, S-339). A pair inside the same group stays as the writer's grouping, a
+// pair that the tree needs stays (`(a + b) * c` is not `a + b * c`), and a pair between two groups without
+// a strength stays (without it the expression is an E0010: remainder against addition and multiplication,
+// `&&` against `||`, the bit operators against every other group). Each function has the pair on one side;
+// the value that a test checks is the one the pair gives, which differs from the value without it or the
+// expression is an error. The file is canonical, so `onsa fmt` leaves it unchanged. Every value below is
+// worked out by hand from the spec text.
+
+// ---- the same group ---------------------------------------------------------------------------------
+
+fn sum_left(a: I32, b: I32, c: I32) -> I32 {
+  (a + b) + c
+}
+
+fn sum_right(a: I32, b: I32, c: I32) -> I32 {
+  a + (b + c)
+}
+
+fn diff_left(a: I32, b: I32, c: I32) -> I32 {
+  (a - b) - c
+}
+
+fn diff_right(a: I32, b: I32, c: I32) -> I32 {
+  a - (b - c)
+}
+
+fn quotient_left(a: I32, b: I32, c: I32) -> I32 {
+  (a / b) / c
+}
+
+fn quotient_right(a: I32, b: I32, c: I32) -> I32 {
+  a / (b / c)
+}
+
+fn and_left(p: Bool, q: Bool, r: Bool) -> Bool {
+  (p && q) && r
+}
+
+fn or_right(p: Bool, q: Bool, r: Bool) -> Bool {
+  p || (q || r)
+}
+
+fn bits_left(m: U32) -> U32 {
+  (m | 1) | 4
+}
+
+fn shift_right(m: U32) -> U32 {
+  m << (1 << 2)
+}
+
+// ---- the tree needs the pair --------------------------------------------------------------------------
+
+fn product_of_sum(a: I32, b: I32, c: I32) -> I32 {
+  (a + b) * c
+}
+
+fn sum_in_product(a: I32, b: I32, c: I32) -> I32 {
+  a * (b + c)
+}
+
+fn negated_sum(a: I32, b: I32) -> I32 {
+  -(a + b)
+}
+
+fn denied_conjunction(p: Bool, q: Bool) -> Bool {
+  !(p && q)
+}
+
+// ---- no strength between the groups -------------------------------------------------------------------
+
+fn sum_then_remainder(a: U32, b: U32, n: U32) -> U32 {
+  (a + b) % n
+}
+
+fn remainder_in_sum(a: U32, b: U32, n: U32) -> U32 {
+  a + (b % n)
+}
+
+fn product_then_remainder(a: U32, b: U32, n: U32) -> U32 {
+  (a * b) % n
+}
+
+fn remainder_of_product(a: U32, b: U32, n: U32) -> U32 {
+  a % (b * n)
+}
+
+fn and_under_or(p: Bool, q: Bool, r: Bool) -> Bool {
+  (p && q) || r
+}
+
+fn or_under_and(p: Bool, q: Bool, r: Bool) -> Bool {
+  p && (q || r)
+}
+
+fn masked(a: U32, m: U32) -> Bool {
+  (a & m) == 0
+}
+
+fn summed_mask(a: U32, b: U32, m: U32) -> U32 {
+  (a + b) & m
+}
+
+fn compared_comparisons(a: I32, b: I32, c: I32, d: I32) -> Bool {
+  (a < b) == (c < d)
+}
+
+test "the same group: the pair is the writer's grouping and the value is the same, or the tree differs" {
+  // (1 + 2) + 3 = 1 + (2 + 3) = 6; the chain leans to the left, so `a - (b - c)` is another tree.
+  assert sum_left(1, 2, 3) == 6
+  assert sum_right(1, 2, 3) == 6
+  // (10 - 3) - 2 = 5, 10 - (3 - 2) = 9.
+  assert diff_left(10, 3, 2) == 5
+  assert diff_right(10, 3, 2) == 9
+  // (100 / 10) / 5 = 2, 100 / (10 / 5) = 50.
+  assert quotient_left(100, 10, 5) == 2
+  assert quotient_right(100, 10, 5) == 50
+  assert and_left(true, true, true)
+  assert !and_left(true, false, true)
+  assert or_right(false, false, true)
+  assert !or_right(false, false, false)
+  // (1 | 1) | 4 = 5; 1 << (1 << 2) = 1 << 4 = 16 (the left chain would give 1 << 1 << 2 = 4).
+  assert bits_left(1) == 5
+  assert shift_right(1) == 16
+}
+
+test "the pair that the tree needs" {
+  // (1 + 2) * 3 = 9 (without the pair 1 + 6 = 7); 2 * (1 + 3) = 8 (without it 2 + 3 = 5).
+  assert product_of_sum(1, 2, 3) == 9
+  assert sum_in_product(2, 1, 3) == 8
+  // -(1 + 2) = -3 (without the pair -1 + 2 = 1).
+  assert negated_sum(1, 2) == -3
+  // !(true && false) is true; !true && false would be false.
+  assert denied_conjunction(true, false)
+}
+
+test "the pair between groups without a strength" {
+  // (5 + 4) % 3 = 0, 5 + (4 % 3) = 6.
+  assert sum_then_remainder(5, 4, 3) == 0
+  assert remainder_in_sum(5, 4, 3) == 6
+  // (3 * 4) % 5 = 2, 17 % (3 * 2) = 5.
+  assert product_then_remainder(3, 4, 5) == 2
+  assert remainder_of_product(17, 3, 2) == 5
+  // (false && false) || true is true; false && (false || true) is false.
+  assert and_under_or(false, false, true)
+  assert !or_under_and(false, false, true)
+  // (0xF0 & 0x0F) == 0; (1 + 2) & 2 = 3 & 2 = 2.
+  assert masked(0xF0, 0x0F)
+  assert summed_mask(1, 2, 2) == 2
+  // (1 < 2) == (3 < 4) is true == true.
+  assert compared_comparisons(1, 2, 3, 4)
+  assert !compared_comparisons(1, 2, 4, 3)
+}
diff --git a/tests/spec/fmt/parens_kept_heads.onsa b/tests/spec/fmt/parens_kept_heads.onsa
new file mode 100644
index 0000000..1a0b205
--- /dev/null
+++ b/tests/spec/fmt/parens_kept_heads.onsa
@@ -0,0 +1,68 @@
+// onsa.toml
+// [test]
+// mode = "test"
+// spec = ["§4.4", "§7", "§18.2"]
+
+// The parentheses that `onsa fmt` does not take off in the head of `if`, `while`, `match` and `for` when
+// the expression holds a struct literal or a block outside any other bracket (docs/onsa-tools.md §3.3,
+// S-339; spec §4.4: the head takes neither without a pair, as `{` would start the body). The pair round a
+// call that holds a struct literal inside its own brackets goes (it is in another file), because the
+// literal is then inside a bracket. The file is canonical, so `onsa fmt` leaves it unchanged. Every value
+// below is worked out by hand from the spec text.
+
+pub struct Pt {
+  x: I32,
+  y: I32,
+}
+
+pub enum Kind {
+  Low,
+  High,
+}
+
+pub struct Item {
+  kind: Kind,
+  n: I32,
+}
+
+fn struct_in_if(n: I32) -> I32 {
+  if (Pt { x: n, y: n }.x == 1) {
+    return 10
+  }
+  20
+}
+
+fn struct_in_match(n: I32) -> I32 {
+  match (Item { kind: Kind.Low, n: n }).kind {
+    Kind.Low => 10,
+    Kind.High => 20,
+  }
+}
+
+fn struct_in_while(n: I32) -> I32 {
+  var count = 0
+  while (Pt { x: count, y: n }.x < n) {
+    count = count + 1
+  }
+  count
+}
+
+fn block_in_if(n: I32) -> I32 {
+  if ({ n } > 1) {
+    return 10
+  }
+  20
+}
+
+test "the head with a struct literal" {
+  assert struct_in_if(1) == 10
+  assert struct_in_if(2) == 20
+  assert struct_in_match(1) == 10
+  // count goes 0, 1, 2 and stops at 3.
+  assert struct_in_while(3) == 3
+}
+
+test "the head with a block" {
+  assert block_in_if(2) == 10
+  assert block_in_if(1) == 20
+}
diff --git a/tests/spec/fmt/parens_kept_mixed.onsa b/tests/spec/fmt/parens_kept_mixed.onsa
new file mode 100644
index 0000000..cdee89c
--- /dev/null
+++ b/tests/spec/fmt/parens_kept_mixed.onsa
@@ -0,0 +1,68 @@
+// onsa.toml
+// [test]
+// mode = "test"
+// spec = ["§3.1", "§18.2"]
+
+// The shapes that `onsa fmt` makes of an expression that has pairs to take off and pairs to keep side by
+// side (docs/onsa-tools.md §3.3, S-115, S-339): `(a * b) + (c % d)` is `a * b + (c % d)` (the product goes
+// under the sum, the remainder has no strength against the sum), `((a * b) + c) + b` is `(a * b + c) + b`
+// (the pair of the same group stays, the pair inside it goes), `-(-(a))` is `-(-a)`. This file is the
+// output: each expression is canonical, so `onsa fmt` leaves it unchanged. The inputs are in the CLI test
+// `fmt_parens.rs`. Every value below is worked out by hand from the spec text.
+
+fn product_and_remainder(a: I32, b: I32, c: I32, d: I32) -> I32 {
+  a * b + (c % d)
+}
+
+fn remainders_compared(a: I32, b: I32, c: I32, d: I32) -> Bool {
+  a % b == c % d
+}
+
+fn sums_in_products(a: I32, b: I32, c: I32, d: I32) -> I32 {
+  (a + b) * c + (d - a) * b
+}
+
+fn remainder_of_sum(a: I32, b: I32, n: I32) -> Bool {
+  (a + b) % n == 0
+}
+
+fn kept_group_pair(a: I32, b: I32, c: I32) -> I32 {
+  (a * b + c) + b
+}
+
+fn stacked_after_name(a: I32) -> I32 {
+  -(-a)
+}
+
+fn logic_pairs(a: I32, b: I32, p: Bool, q: Bool, r: Bool) -> Bool {
+  ((p && q) || r) || a < b
+}
+
+fn logic_in_pairs(a: I32, b: I32, p: Bool, q: Bool) -> Bool {
+  (p || a == b) && (q || a != b)
+}
+
+test "pairs that go and pairs that stay" {
+  // 2 * 3 + (7 % 4) = 6 + 3 = 9.
+  assert product_and_remainder(2, 3, 7, 4) == 9
+  // 7 % 3 = 1 and 9 % 4 = 1.
+  assert remainders_compared(7, 3, 9, 4)
+  assert !remainders_compared(7, 3, 8, 4)
+  // (1 + 2) * 3 + (4 - 1) * 2 = 9 + 6 = 15.
+  assert sums_in_products(1, 2, 3, 4) == 15
+  // (5 + 4) % 3 = 0; (5 + 5) % 3 = 1.
+  assert remainder_of_sum(5, 4, 3)
+  assert !remainder_of_sum(5, 5, 3)
+  // (2 * 3 + 1) + 3 = 10.
+  assert kept_group_pair(2, 3, 1) == 10
+  assert stacked_after_name(5) == 5
+}
+
+test "the pairs of the logic" {
+  // ((false && false) || false) || 1 < 2 is true; with 2 < 1 it is false.
+  assert logic_pairs(1, 2, false, false, false)
+  assert !logic_pairs(2, 1, false, false, false)
+  // (false || 1 == 1) && (true || 1 != 1) is true; (false || 1 == 1) && (false || 1 != 1) is false.
+  assert logic_in_pairs(1, 1, false, true)
+  assert !logic_in_pairs(1, 1, false, false)
+}
