+// ===================================================================================================
+// J. Line breaks and comments inside a pair
+// ===================================================================================================
+//
+// Inside a pair, `fmt` takes off the line breaks round `as` and `at` (docs/onsa-tools.md §3.2), and keeps the
+// line breaks of a place of continuation (after a binary operator, spec §2.5) and the line break after a
+// comment at the end of a line, in every place. The pair is taken off when the result is the same tree and
+// has no error of the syntax stage (S-339); the line breaks that are taken off first decide that. `fmt` is
+// to be a fixed point, so a pair that goes only after another run is no answer (spec §18.2).
+
+fn c_pair_lines() -> Vec<Case> {
+    vec![
+        case(
+            "a line break before or after as is taken off first, and then the pair goes",
+            &[
+                "pub fn before(x: I32) -> F64 {",
+                "  let y = (x",
+                "    as F64)",
+                "  y",
+                "}",
+                "",
+                "pub fn after(x: I32) -> F64 {",
+                "  let y = (x as",
+                "    F64)",
+                "  y",
+                "}",
+            ],
+            &[
+                "pub fn before(x: I32) -> F64 {",
+                "  let y = x as F64",
+                "  y",
+                "}",
+                "",
+                "pub fn after(x: I32) -> F64 {",
+                "  let y = x as F64",
+                "  y",
+                "}",
+            ],
+        ),
+        case(
+            "a line break after as is taken off, and the pair of the operand of * stays",
+            &["pub fn product(x: I32) -> F64 {", "  let y = (x as", "    F64) * 2.0", "  y", "}"],
+            &["pub fn product(x: I32) -> F64 {", "  let y = (x as F64) * 2.0", "  y", "}"],
+        ),
+        case(
+            "a continuation after a binary operator and a comment: the line break stays, the pair goes",
+            &["pub fn continued(a: I32, b: I32) -> I32 {", "  let y = (a + // c", "    b)", "  y", "}"],
+            &["pub fn continued(a: I32, b: I32) -> I32 {", "  let y = a + // c", "    b", "  y", "}"],
+        ),
+        case(
+            "a comment at the end of the line before the closing parenthesis: the pair goes, the comment stays",
+            &["pub fn closing(a: I32, b: I32) -> I32 {", "  let y = (a + b // c", "  )", "  y", "}"],
+            &["pub fn closing(a: I32, b: I32) -> I32 {", "  let y = a + b // c", "  y", "}"],
+        ),
+        case(
+            "the closing parenthesis on a line of its own, without a comment: the line break goes with it",
+            &["pub fn alone(a: I32, b: I32) -> I32 {", "  let y = (a + b", "  )", "  y", "}"],
+            &["pub fn alone(a: I32, b: I32) -> I32 {", "  let y = a + b", "  y", "}"],
+        ),
+        case(
+            "the head that goes on after && inside the pair keeps its line break and loses the pair",
+            &["pub fn head(a: Bool, b: Bool) -> I32 {", "  if (a &&", "    b) {", "    return 1", "  }", "  0", "}"],
+            &["pub fn head(a: Bool, b: Bool) -> I32 {", "  if a &&", "    b {", "    return 1", "  }", "  0", "}"],
+        ),
+    ]
+}
