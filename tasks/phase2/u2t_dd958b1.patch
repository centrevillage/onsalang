+// onsa.toml
+// [test]
+// spec = ["§4.1", "§6.1", "§8.1", "§18.2"]
+
+// The parentheses that `onsa fmt` does not take off round a function type that is followed by `uses`
+// (docs/onsa-tools.md §3.3, S-339, W3-20): without the pair the `uses` belongs to the function type in
+// it, and the type is another type (`fn a() -> (fn()) uses {Alloc}` is a function that allocates and
+// returns a function; without the pair, `fn a() -> fn() uses {Alloc}` returns a function that allocates). The same for a
+// function type that is the return type of another function type. The pair round a name (`(I32)`) goes
+// even before `uses`, because the `uses` is on the same type either way (it is in another file). The file
+// is canonical, so `onsa fmt` leaves it unchanged.
+
+fn noop() {}
+
+fn id(a: I32) -> I32 {
+  a
+}
+
+fn a() -> (fn()) uses {Alloc} {
+  noop
+}
+
+type Later = fn() -> (fn(I32) -> I32) uses {Alloc}
+
+type Lazy = fn() -> fn(I32) -> I32 uses {Alloc}
