+/// The tables are written by hand: the input and the expected text of a case may differ in the
+/// parentheses and in white space only (no other change is hidden in a case).
+#[test]
+fn the_expected_text_of_a_case_differs_from_the_input_in_parentheses_and_white_space_only() {
+    let groups: Vec<(&str, Vec<Case>)> = vec![
+        ("strong", c_strong_groups()),
+        ("prefix", c_prefix_operands()),
+        ("atoms", c_atoms()),
+        ("whole", c_whole()),
+        ("headings", c_headings()),
+        ("ranges", c_ranges()),
+        ("types", c_types()),
+        ("patterns", c_patterns()),
+        ("mixed", c_mixed()),
+        ("combinations", c_combinations()),
+        ("lines", c_pair_lines()),
+    ];
+    let strip = |t: &str| -> String { t.chars().filter(|c| !c.is_whitespace() && *c != '(' && *c != ')').collect() };
+    for (g, cases) in &groups {
+        for c in cases {
+            assert_eq!(
+                strip(&c.input),
+                strip(&c.expected),
+                "{g}: {}: the cases differ in more than parentheses",
+                c.what
+            );
+            assert_ne!(c.input, c.expected, "{g}: {}: nothing to take off", c.what);
+        }
+    }
+}
