+// ===================================================================================================
+// L. The files `fmt` does not write
+// ===================================================================================================
+//
+// A pair that is an error of the syntax stage (`(s.f)(x)`, spec §6.1; the whole range of a head in a pair,
+// spec §7) stops `fmt` with 2 (§18.2): the file is not written, and the redundant pairs elsewhere in the file
+// are not taken off either. (The same for `--check`.)
+
+const BAD_CALLEE: &str = "\
+pub struct S {
+  f: fn(U8) -> U8,
+}
+
+pub fn first(a: I32, b: I32) -> I32 {
+  (a * b) + a
+}
+
+pub fn second(s: S) -> U8 {
+  (s.f)(1)
+}
+";
+
+const BAD_CALLEE_NAME: &str = "\
+fn id(a: I32) -> I32 {
+  a
+}
+
+pub fn first(a: I32, b: I32) -> I32 {
+  (a * b) + a
+}
+
+pub fn second(n: I32) -> I32 {
+  (id)(n)
+}
+";
+
+const BAD_RANGE_HEAD: &str = "\
+pub fn first(a: U32, b: U32) -> U32 {
+  (a * b) + a
+}
+
+pub fn second(n: U32) -> U32 {
+  var t: U32 = 0
+  for i in (0 ..< n) {
+    t = t + i
+  }
+  t
+}
+";
+
+#[test]
+fn a_file_with_a_callee_in_a_pair_or_a_range_head_in_a_pair_is_not_written_and_ends_with_2() {
+    for (what, text) in [
+        ("a field in a pair as the callee", BAD_CALLEE),
+        ("a name in a pair as the callee", BAD_CALLEE_NAME),
+        ("the whole range of a head in a pair", BAD_RANGE_HEAD),
+    ] {
+        let d = Dir::new("not_written");
+        let path = d.file("a.onsa", text);
+        for args in [vec!["fmt"], vec!["fmt", "--check"]] {
+            let mut a = args.clone();
+            a.push(&path);
+            let out = onsa(&a);
+            assert_eq!(code(&out), 2, "{what}: {args:?}: {out:?}");
+            assert_eq!(read(&path), text, "{what}: {args:?} wrote the file");
+        }
+        // `diff --ast` does not compare the file either (spec §18.2), and the code is 2.
+        let other = d.file("b.onsa", text);
+        let out = onsa(&["diff", "--ast", &path, &other]);
+        assert_eq!(code(&out), 2, "{what}: diff --ast: {out:?}");
+    }
+}
+
+#[test]
+#[ignore = "W3-12 U2: the other file of the call gets its redundant pairs taken off (S-115, S-339); the file with the error is not written"]
+fn with_two_files_the_one_with_the_error_stays_and_the_other_loses_its_pairs() {
+    let d = Dir::new("two_files");
+    let bad = d.file("bad.onsa", BAD_CALLEE);
+    let good = d.file("good.onsa", "pub fn f(a: I32, b: I32) -> I32 {\n  (a * b) + a\n}\n");
+    let out = onsa(&["fmt", &bad, &good]);
+    assert_eq!(code(&out), 2, "{out:?}");
+    assert_eq!(read(&bad), BAD_CALLEE, "the file with the error is not written");
+    assert_eq!(read(&good), "pub fn f(a: I32, b: I32) -> I32 {\n  a * b + a\n}\n", "the other file is written");
+}
+
+// ===================================================================================================
+// `fmt --check`
+// ===================================================================================================
+
+#[test]
+#[ignore = "W3-12 U2: fmt --check calls a file with a redundant pair formatted today (S-115, S-339)"]
+fn fmt_check_reports_a_file_with_a_redundant_pair_and_writes_nothing() {
+    let d = Dir::new("check");
+    let text = "pub fn f(a: I32, b: I32, c: I32) -> I32 {\n  (a * b) + c\n}\n";
+    let path = d.file("a.onsa", text);
+    let out = onsa(&["fmt", "--check", &path]);
+    assert_eq!(code(&out), 1, "a redundant pair is a difference of fmt --check: {out:?}");
+    assert_eq!(read(&path), text, "--check must not write");
+    let out = onsa(&["fmt", &path]);
+    assert_eq!(code(&out), 0, "{out:?}");
+    assert_eq!(read(&path), "pub fn f(a: I32, b: I32, c: I32) -> I32 {\n  a * b + c\n}\n");
+    let out = onsa(&["fmt", "--check", &path]);
+    assert_eq!(code(&out), 0, "{out:?}");
+}
+
+// ===================================================================================================
+// M. `onsa diff --ast`
+// ===================================================================================================
+
+fn in_fn(body: &str) -> String {
+    format!("pub fn f(a: I32, b: I32, c: I32, n: I32) -> I32 {{\n  {body}\n}}\n")
+}
+
+#[test]
+#[ignore = "W3-12 U2: diff --ast sees a redundant pair as a difference today (S-115, S-339, docs/onsa-tools.md 3.5)"]
+fn diff_ast_does_not_report_a_redundant_pair() {
+    let d = Dir::new("diff_same");
+    for (i, (a, b)) in [
+        ("(a * b) + c", "a * b + c"),
+        ("c + (a * b)", "c + a * b"),
+        ("(a)", "a"),
+        ("((a + b))", "(a + b)"),
+        ("(-a) + b", "-a + b"),
+        ("(a + b) * (c)", "(a + b) * c"),
+        ("-(a)", "-a"),
+        ("(a) as I32", "a as I32"),
+    ]
+    .iter()
+    .enumerate()
+    {
+        let (k, text) = diff_of(&d, &format!("p{i}"), &in_fn(a), &in_fn(b));
+        assert_eq!(k, 0, "`{a}` and `{b}` differ only in a redundant pair: {text}");
+        let (k, text) = diff_of(&d, &format!("q{i}"), &in_fn(b), &in_fn(a));
+        assert_eq!(k, 0, "(reversed) `{b}` and `{a}` differ only in a redundant pair: {text}");
+    }
+}
+
+#[test]
+#[ignore = "W3-12 U2: diff --ast sees the pair of a head, an end of a range and a type as a difference today (S-336, S-339)"]
+fn diff_ast_does_not_report_a_redundant_pair_in_a_head_a_range_a_type_or_a_pattern() {
+    let d = Dir::new("diff_places");
+    let pairs: [(&str, &str); 5] = [
+        (
+            "pub fn f(c: Bool) -> I32 {\n  if (c) {\n    return 1\n  }\n  0\n}\n",
+            "pub fn f(c: Bool) -> I32 {\n  if c {\n    return 1\n  }\n  0\n}\n",
+        ),
+        (
+            "pub fn f(n: U32) -> U32 {\n  var t: U32 = 0\n  for i in 0 ..< (n + 1) {\n    t = t + i\n  }\n  t\n}\n",
+            "pub fn f(n: U32) -> U32 {\n  var t: U32 = 0\n  for i in 0 ..< n + 1 {\n    t = t + i\n  }\n  t\n}\n",
+        ),
+        ("pub fn f(a: (I32)) -> (I32) {\n  a\n}\n", "pub fn f(a: I32) -> I32 {\n  a\n}\n"),
+        (
+            "pub fn f(n: I32) -> I32 {\n  match n {\n    (1) => 2,\n    _ => 0,\n  }\n}\n",
+            "pub fn f(n: I32) -> I32 {\n  match n {\n    1 => 2,\n    _ => 0,\n  }\n}\n",
+        ),
+        ("pub fn f(a: I32) -> I32 {\n  let (b) = a\n  b\n}\n", "pub fn f(a: I32) -> I32 {\n  let b = a\n  b\n}\n"),
+    ];
+    for (i, (a, b)) in pairs.iter().enumerate() {
+        let (k, text) = diff_of(&d, &format!("p{i}"), a, b);
+        assert_eq!(k, 0, "pair {i} differs only in a redundant pair: {text}\n{a}\n{b}");
+    }
+}
+
+#[test]
+fn diff_ast_reports_a_pair_that_the_tree_needs() {
+    let d = Dir::new("diff_needed");
+    for (i, (a, b)) in [
+        ("(a + b) * c", "a + b * c"),
+        ("a - (b - c)", "a - b - c"),
+        ("-(a + b)", "-a + b"),
+        ("(-a).max(b)", "-a.max(b)"),
+        ("a * (b + c)", "a * b + c"),
+    ]
+    .iter()
+    .enumerate()
+    {
+        let (k, text) = diff_of(&d, &format!("n{i}"), &in_fn(a), &in_fn(b));
+        assert_eq!(k, 1, "`{a}` and `{b}` are different programs (pair {i}): {text}");
+    }
+}
+
+#[test]
+fn diff_ast_reports_a_tree_that_moved_to_the_other_side_of_the_same_group() {
+    // `a + (b + c)` and `a + b + c` are different trees (the chain leans to the left), so the pair is
+    // not redundant, and that is not the exception of S-115 (which is about `(a + b) + c`).
+    let d = Dir::new("diff_side");
+    let (k, text) = diff_of(&d, "side", &in_fn("a + (b + c)"), &in_fn("a + b + c"));
+    assert_eq!(k, 1, "{text}");
+}
diff --git a/tests/spec/fmt/parens_kept_at.onsa b/tests/spec/fmt/parens_kept_at.onsa
