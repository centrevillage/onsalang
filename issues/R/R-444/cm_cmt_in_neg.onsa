pub struct P {
  x: I32,
}

impl P {
  pub fn m(self) -> I32 {
    self.x
  }
  pub fn me(self) -> P {
    self
  }
}

pub fn id(x: I32) -> I32 {
  x
}

pub fn h(x: Bool) -> I32 {
  1
}

pub fn ro(x: Bool) -> Result[I32, I32] {
  Ok(1)
}

pub fn f(a: I32, b: I32, c: Bool, p: P, o: Option[I32]) -> I32 {
  a
  - /* c */ b
}
