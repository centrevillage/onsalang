use std.math

pub flow lp(x: F32 at sample) -> F32 at sample {
  x
}

pub rt fn g(x: F32) -> F32 {
  x
}

pub const K: F32 = 1.0

pub struct P {
  a: F32,
}

impl P {
  pub rt fn new(a: F32) -> P {
    P { a: a }
  }

  pub rt fn get(self) -> F32 {
    self.a
  }

  pub rt fn put(inout self, a: F32) {
    self.a = a
  }
}

pub enum E {
  A,
  B(F32),
}

pub flow u(x: F32 at sample) -> F32 at sample {
  let _ = Some!(x)
  x
}
