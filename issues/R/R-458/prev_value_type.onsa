pub rt fn has(o: Option[Buf[F32]]) -> F32 { 1.0 }
pub rt fn mk(x: F32) -> Str { "x" }

pub flow lit_affine(x: F32 at sample) -> F32 at sample {
  x * has(None)
}

pub rt fn rt_lit_affine(x: F32) -> F32 { x * has(None) }

pub flow prev_str(x: F32 at sample) -> F32 at sample {
  x * F32.round_from(prev~(if x > 0.0 { "a" } else { "bb" }, "z").len())
}

pub flow prev_owned(x: F32 at sample) -> F32 at sample {
  x * F32.round_from(prev~(mk(x), "z").len())
}

pub flow prev_let(x: F32 at sample) -> F32 at sample {
  let s = prev~(if x > 0.0 { "a" } else { "bb" }, "z")
  x * F32.round_from(s.len())
}
