pub struct P { x: I32 }
pub enum Shape { Circle(F32), Dot }
const KP: P = P { x: 1 }
fn g(x: I32) -> I32 { x }
pub fn local(p: P) -> Str uses {Alloc} { "{p}" }
pub fn konst() -> Str uses {Alloc} { "{KP}" }
pub fn func() -> Str uses {Alloc} { "{g}" }
pub fn variant() -> Str uses {Alloc} { "{Shape.Circle} {Shape.Dot}" }
