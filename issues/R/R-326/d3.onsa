pub fn k6(x: O2[(F32, I32)]) -> U32 { 0 }
pub fn k7(x: H2[(I32, Str)]) -> U32 { 0 }
pub fn k8(x: Df[(F32, I32)]) -> U32 { 0 }
pub fn k9(x: S2[(I32, Str)]) -> U32 { 0 }
pub fn k10(x: S2[Option[(I32, Str)]]) -> U32 { 0 }
pub fn k11(x: S2[[Str; 2]]) -> U32 { 0 }
pub fn k12(x: E2[[F32; 2]], y: Df[Str], z: Df[[F32; 2]]) -> U32 { 0 }
pub fn main() {}
fn need_show[T: Show](x: T) -> U32 { 0 }
pub fn b1() -> U32 { need_show((1.0, 2)) }
pub fn b2() -> U32 { need_show((1, 2)) }
