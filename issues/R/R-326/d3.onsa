pub struct S2[T: Show] { a: T }
pub struct E2[T: PartialEq] { a: T }
pub struct O2[T: PartialOrd] { a: T }
pub struct H2[T: Hash] { a: T }
pub struct Df[T: Default] { a: T }
pub fn k1(x: S2[(I32, I32)]) -> U32 { 0 }
pub fn k2(x: S2[(F32, I32)]) -> U32 { 0 }
pub fn k3(x: S2[[F32; 2]]) -> U32 { 0 }
pub fn k4(x: S2[F32]) -> U32 { 0 }
