{
  "hooks": {
    "WorktreeCreate": [{"hooks": [{"type": "command", "command": "python3 -B \"$CLAUDE_PROJECT_DIR\"/tools/hooks/claude_hook.py WorktreeCreate"}]}],
    "WorktreeRemove": [{"hooks": [{"type": "command", "command": "python3 -B \"$CLAUDE_PROJECT_DIR\"/tools/hooks/claude_hook.py WorktreeRemove"}]}],
    "PreToolUse": [{"matcher": "Bash|Agent|Read|Grep|Glob",
      "hooks": [{"type": "command", "command": "python3 -B \"$CLAUDE_PROJECT_DIR\"/tools/hooks/claude_hook.py PreToolUse"}]}],
    "PostToolUse": [{"matcher": "Bash|SendMessage",
      "hooks": [{"type": "command", "command": "python3 -B \"$CLAUDE_PROJECT_DIR\"/tools/hooks/claude_hook.py PostToolUse"}]}],
    "SessionStart": [{"matcher": "startup|resume|compact",
      "hooks": [{"type": "command", "command": "python3 -B \"$CLAUDE_PROJECT_DIR\"/tools/hooks/claude_hook.py SessionStart"}]}],
    "SubagentStop": [{
      "hooks": [{"type": "command", "command": "python3 -B \"$CLAUDE_PROJECT_DIR\"/tools/hooks/claude_hook.py SubagentStop"}]}]
  },
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(sudo *)",
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/CLAUDE.md)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git stash)",
      "Bash(git stash *)",
      "Bash(git -C * stash)",
      "Bash(git -C * stash *)",
      "Bash(swift test)",
      "Bash(swift test *)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "language": "japanese",
  "env": { "PYTHONDONTWRITEBYTECODE": "1" }
}
