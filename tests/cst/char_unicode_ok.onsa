// ￾ ￿ ﷐ 🿾 􏿿 noncharacters
//  󰀀 private use
// ️ ︎ variation selectors ❤️
//   NBSP inside a comment is allowed
let a = "שלום"
let b = "😀👨‍👩"
let c = "￾￿﷐􏿿"
let c2 = "  NBSP inside a string is allowed"
let d = "󰀀"
let e = "é́"
let f = "️"
