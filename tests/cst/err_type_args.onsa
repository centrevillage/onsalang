// onsa.toml
// [test]
// mode = "none"
// spec = ["§2.5", "§4.5", "§18.1"]

// Syntax errors in and around the mark of a type argument `::[` (§4.5): a list that does not close, a
// list cut by the end of the line or the end of the function, an empty list, a heading with a list, a
// pattern with a list. Whatever the recovery does with the text after an error (§18.1), the round
// trip of the CST gives the file back byte for byte (R-86). An input of the CST round trip; fmt
// refuses it (several syntax diagnostics), as it must.

pub fn unclosed_list() -> I32 {
  id::[I32(1)
}

pub fn list_cut_by_the_line() -> I32 {
  let a = id::[I32,
  a
}

pub fn list_cut_by_the_brace() -> I32 {
  id::[I32
}

pub fn empty_list() -> I32 {
  id::[](1)
}

pub fn on_a_heading::[T](x: T) -> T {
  x
}

pub fn in_a_pattern(o: Option[I32]) -> I32 {
  match o {
    None::[I32] => 0,
    Some::[I32](n) => n,
  }
}

pub fn at_the_start_of_a_line(x: I32) -> I32 {
  let f = id
  ::[I32](x)
}

pub fn after_an_expression(x: I32) -> I32 {
  id(x)::[I32](x)
}

pub fn bang_before_the_list(inout v: V, x: I32) {
  v.conv!::[I32](x)
}

pub fn fine(x: I32) -> I32 {
  x
}
