// mode = "none"
// spec = ["§2.5", "§2.6", "§4.5"]

// The tokens around the mark of a type argument `::[` (§4.5), with and without spaces, next to the
// other runs of the same characters (`::`, `:::`, `<`, `>>`, `[[`, `]]`, `]::[`). An input of the
// CST round trip and of the fmt properties; it holds many errors (E0020, E0002) on purpose, so fmt
// refuses it and the round trip is what is checked.

