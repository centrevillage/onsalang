// onsa.toml
// [test]
// mode = "none"
// spec = ["§2.4", "§2.5"]

// String literals: the closed escape list, bad escapes, interpolation (valid paths and the
// forms E0001 rejects), nested interpolation with strings and braces inside, `{{` `}}`.

let a = "plain"
let b = ""
let c = "tab\there\nnewline\rcr\0nul\\backslash\"quote\'apos"
let d = "unicode \u{41} \u{1F600} \u{10FFFF} \u{0} \u{000041} \u{a}"
let e = "{n}"
let f = "{p.x} {self.gain} {t.0} {MAX_VOICES} {cfg.N} {F32.PI}"
let g = "{{literal}} {{{n}}} }} {{ }}{{"
let h = "{a}{b}{c}"
let i = "{a} and {b}!"
let j = "// not a comment"
let k = "'not a char' and `ticks` and /* */"
let l = "日本語 émoji 😀 \u{65E5}"
let m = "a" "b" "c"
let n = "a""b"
let o = "x"+"y"
"a" // a comment after a string
"a // not a comment" // a comment
// bad escapes
let b1 = "\q"
let b2 = "\x41"
let b3 = "\u41"
let b4 = "\u{}"
let b5 = "\u{110000}"
let b6 = "\u{D800}"
let b7 = "\u{1F600"
let b8 = "\u{G}"
let b9 = "\U0001F600"
let b10 = "\ "
let b11 = "\\\"
let b12 = "abc\
let b13 = "\'" "\"\""
// interpolation: forms E0001 rejects, and odd braces
let n1 = "{f(x)}"
let n2 = "{a[0]}"
let n3 = "{a + b}"
let n4 = "{1}"
let n5 = "{x:.2}"
let n6 = "{f("x")}"
let n7 = "{"{a}"}"
let n8 = "{ "}" }"
let n9 = "{ {a: 1} }"
let n10 = "{{{{}}}}"
let n11 = "{a{b}c}"
let n12 = "{"
let n13 = "}"
let n14 = "{}"
let n15 = "{ }"
let n16 = "{a} }"
let n17 = "{{a}"
let n18 = "{a}}"
let n19 = "{a.}"
let n20 = "{.a}"
let n21 = "{a..b}"
let n22 = "{a b}"
let n23 = "{a//b}"
let n24 = "{a}//c"
let n25 = "{"//"}"
let n26 = "{'}'}"
let n27 = "{"\""}"
let n28 = "{"{"{"{x}"}"}"}"
let n29 = "{{{"
let n30 = "{a}{"
