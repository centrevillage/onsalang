// onsa.toml
// [test]
// mode = "none"
// spec = ["§2.4"]

// Escapes in strings and character literals followed by multi-byte characters (R-01): an unknown
// escape (`\é`, E0001) has to leave the lexer on a character boundary; `\u{…}` with a multi-byte
// character inside; escapes of the closed list next to multi-byte text; the escape at the end of
// the line. The diagnostics are in tests/spec/negative/lex_utf8_escapes.onsa.

let e0 = "\é"
let e1 = "\音"
let e2 = "\😀"
let e3 = "\é\é"
let e4 = "a\éb"
let e5 = "\é{x}"
let e6 = "{x}\é"
let e7 = "\u{é}"
let e8 = "\u{日}"
let e9 = "\u{😀}"
let e10 = "\u{1é}"
let e11 = "\u{é1}"
let e12 = "\u{1F600é}"
let e13 = "\é\u{41}"
