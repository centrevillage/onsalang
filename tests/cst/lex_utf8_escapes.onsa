let e15 = '\音'
let e16 = '\😀'
let e17 = '\u{é}'
let e18 = "\﻿"
let e19 = "\"
let e20 = "\ "
let e21 = "\ "
let e22 = "\́"
let e23 = "\‍"
let e24 = "\‮"
let e25 = "\"
let e26 = "\\é"
let e27 = "\\\é"
let e28 = "\"é"
let e29 = "\'é"
let e30 = "é\n日\t本\r"
let e31 = "\n\é\n"
let e32 = "\é
let e33 = '\é
