let f = 'a'..'z' 'a'..='z'
let g = 'ab' 'abc' '' ''' '''' '\q' '\u{}' '\u{110000}' '\u41'
let h = 'a
let i = '
let j = '\
let k = '\'
let l = '\u{41
let m = 'a'b'c'
let n = x'a' 'a'x 'a''b'
