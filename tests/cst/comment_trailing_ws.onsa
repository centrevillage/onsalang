// Comments that end in a tab, in spaces, or in both, of every comment form (fmt-props compares the
// texts of the comments without their trailing blanks). The `//!` stands at the head of the file (S-434).

//!	
// c	
// c 	
// c	 
//	
///	
////	
const A: U32 = 1 // end	
const B: U32 = 2 // end 	 	
fn f(
  a: I32, // arg	
  // alone	
) {}
// last, ends in a tab	