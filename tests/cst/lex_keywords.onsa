lib = 1
blocking fn rt fn pub rt fn unsafe fn pub priv
fnfn fn_ _fn fn1 fn2x Fn FN fN iff elsee letx forin in_ i n
if~(x) if~ x {} match~ x {} if ~(x) if~(
reset_if when clock
prev~(x) delay~(x, 1) vdelay~(x, d) sample_rate()
r#fn r#let 'fn 'static fn' fn'a
