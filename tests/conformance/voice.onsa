// onsa.toml
// [package]
// name = "voice"
// edition = "2026"
//
// [export]
// prefix = "onsa_"
// flows = ["voice.resonator", "voice.saw", "voice.smooth", "voice.voice"]
//
// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [targets.host.memory]
// bulk_threshold = 4096
//
// [test]
// spec = ["§17.4"]
// conformance = true

// Conformance (T4-7): spec §17.4 voice (saw + two resonators + smooth).
use std.math.{exp, cos, floor}

pub flow resonator(
  x: F32 at sample,
  @param(min: 0.0, max: 24000.0, default: 0.0)
  fc: F32 at block,
  @param(min: 0.0, max: 24000.0, default: 0.0)
  bw: F32 at block,
) -> F32 at sample {
  let r  = exp(-(F32.PI * bw) / sample_rate())
  let w  = (2.0 * F32.PI * fc) / sample_rate()
  let b1 = 2.0 * r * cos(w)
  let b2 = r * r
  let y1 = prev~(^y)
  let y2 = prev~(y1)
  let y  = ((1.0 - r) * x) + (b1 * y1) - (b2 * y2)
  y
}

pub flow saw(
  @param(min: 0.0, max: 24000.0, default: 0.0)
  f0: F32 at block,
) -> F32 at sample {
  let phase = wrap01(prev~(^phase) + (f0 / sample_rate()))
  (2.0 * phase) - 1.0
}

pub rt fn wrap01(x: F32) -> F32 {
  x - floor(x)
}

pub flow smooth(
  @param(min: 0.0, max: 1.0, default: 0.0)
  x: F32 at block,
  time: F32 at init,
) -> F32 at sample {
  let a = exp(-1.0 / (time * sample_rate()))
  let y = x + (a * (prev~(^y) - x))
  y
}

pub flow voice(
  @param(min: 20.0, max: 2000.0, default: 110.0, unit: "Hz", scale: "log")
  f0: F32 at block,
  @param(min: 200.0, max: 1200.0, default: 700.0, unit: "Hz")
  vowel_f1: F32 at block,
  @param(min: 600.0, max: 3000.0, default: 1220.0, unit: "Hz")
  vowel_f2: F32 at block,
  @param(min: 0.0, max: 1.0, default: 0.5)
  gain: F32 at block,
) -> F32 at sample {
  let src = saw~(f0)
  let f1  = resonator~(src, vowel_f1, 80.0)
  let f2  = resonator~(src, vowel_f2, 120.0)
  (f1 + f2) * smooth~(gain, 0.01)
}
