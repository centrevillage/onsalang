// onsa.toml
// [package]
// name = "arm_storage_index_base"
// edition = "2026"
//
// [export]
// prefix = "as769_"
//
// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [test]
// spec = ["§5.2", "§5.3", "§13.4"]
// conformance = true

rt fn ramp(v: F32, s: F32) -> [F32; 16] {
  var a: [F32; 16] = [v; 16]
  for i in 0 ..< 16 {
    a[i] = v + s * F32.round_from(i)
  }
  a
}

rt fn take(s: Span[F32], k: U32) -> F32 {
  s[k % s.len()]
}

rt fn pick(c: Bool, v: F32, k: U32, y: [F32; 16]) -> F32 {
  (if c { ramp(v, 1.0).slice(0, 8) } else { y.slice(0, 8) })[k % 8]
}

@export
pub flow arm_storage_index_base(x: F32 at sample) -> F32 at sample {
  let k = U32.trunc_sat_from((x * x) * 1000.0)
  pick(x > 0.0, x, k, ramp(x, 0.5))
}
