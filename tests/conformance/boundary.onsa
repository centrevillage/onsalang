// onsa.toml
// [package]
// name = "boundary"
// edition = "2026"
//
// [export]
// prefix = "onsa_"
// flows = ["boundary.ints", "boundary.mixed", "boundary.wrap", "boundary.side", "boundary.chars", "boundary.wide"]
//
// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [test]
// spec = ["§11.6", "§13.4"]
// conformance = true

// Conformance of the scalar types at the boundary (§11.6; R-113 3, W1-06): `init`
// inputs (`I32`, `F64`, `Bool`, `Char`, `U64`), integer, `Char` and `Bool` signals, an
// `F64` output and a planar input. `wrap` overflows on the noise stimulus only: the
// interpreter and the C must both panic there, with the same check in the same block
// (§13.4, the integer checks are the same everywhere). The outputs of mixed types
// that the overlap check of `process` measures wrongly are in `boundary_overlap.onsa`.

pub flow ints(
  x: I32 at sample,
  n: I32 at init,
  @param(min: 0, max: 10, default: 2)
  k: I32 at block,
) -> I32 at sample {
  (x * n) + k + prev~(x)
}

pub flow mixed(x: F32 at sample, g: F64 at init, on: Bool at init) -> F64 at sample {
  let y = (x as F64) * g
  if on { y } else { 0.0 }
}

pub flow wrap(x: I8 at sample) -> I8 at sample {
  x * 2
}

pub flow side(x: [F32; 2] at sample) -> F32 at sample {
  x[0] - x[1]
}

// The comparisons are bound by `let` first: an `if` on a comparison is in
// `tests/pipeline/if_compare.onsa`.
pub flow chars(c: Char at sample, d: Char at init) -> Char at sample {
  let same = c == d
  if same { 'z' } else { c }
}

pub flow wide(x: U16 at sample, a: Char at init, b: U64 at init) -> U64 at sample {
  let on = a == 'a'
  if on { (x as U64) + b } else { 0 }
}
