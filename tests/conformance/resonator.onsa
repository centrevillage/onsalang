// onsa.toml
// [package]
// name = "resonator"
// edition = "2026"
//
// [export]
// prefix = "onsa_"
// flows = ["resonator.resonator"]
//
// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [targets.host.memory]
// bulk_threshold = 4096
//
// [test]
// spec = ["§17.3"]
// conformance = true

// Conformance (T4-7): spec §17.3 resonator. `exp` / `cos` run at the `block` clock, so
// the flow is compared within the precision target (S-14).
use std.math.{exp, cos}

pub flow resonator(
  x: F32 at sample,
  @param(min: 20.0, max: 20000.0, default: 500.0, unit: "Hz")
  fc: F32 at block,
  @param(min: 1.0, max: 2000.0, default: 100.0, unit: "Hz")
  bw: F32 at block,
) -> F32 at sample {
  let r  = exp(-(F32.PI * bw) / sample_rate())
  let w  = (2.0 * F32.PI * fc) / sample_rate()
  let b1 = 2.0 * r * cos(w)
  let b2 = r * r
  let y1 = prev~(^y)
  let y2 = prev~(y1)
  let y  = ((1.0 - r) * x) + (b1 * y1) - (b2 * y2)
  y
}
