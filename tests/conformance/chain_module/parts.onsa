// The flows of a module that the chains of main.onsa run (W7-16 U7b/t; §11.9, §15.1): a head that gathers 4 samples through a private
// function of the module, one that deals 4, a state, and a slow stage.

flow sum4(x: F32 at (sample * 4)) -> F32 at sample {
  half(x[0] + x[1]) + half(x[2] + x[3])
}

rt fn half(v: F32) -> F32 {
  v * 0.5
}

flow count4(p: F32 at block) -> F32 at (sample * 4) {
  [p, p * 2.0, p * 3.0, p * 4.0]
}

flow lp(x: F32 at sample) -> F32 at sample {
  let y = prev~(^y) * 0.5 + x
  y
}

flow tick(p: F32 at block) -> F32 at sample {
  let c = prev~((^c + p) at (sample / 2))
  c at sample
}
