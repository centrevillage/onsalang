// onsa.toml
// [package]
// name = "scalar_methods"
// edition = "2026"
//
// [export]
// prefix = "scm_"
//
// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [test]
// spec = ["§3.3", "§3.4", "§13.4"]
// conformance = true

// Conformance (W5-02 U4b): the methods of the scalar types in the body of a flow (spec §3.3, §3.4): a
// saturating conversion from a float to an integer, the floor division and its remainder, the conversion back
// to a float, the rounding of an F64 to an F32 and the bits of the result. Every step is exact or rounded the
// one way that the spec fixes (§3.4), so the interpreter and the C program agree bit by bit (§13.4).

@export
pub flow scalar_methods(
  x: F32 at sample,
  @param(min: -100.0, max: 100.0, default: 3.5)
  gain: F32 at block,
) -> F32 at sample {
  let scaled = x * gain
  let q = I32.trunc_sat_from(scaled)
  let r = F32.round_from(q.rem_euclid(7))
  let s = F32.round_from(q.div_euclid(7))
  let wide = scaled as F64
  let back = F32.round_from(wide * 1.0000001)
  let kept = F32.from_bits(back.to_bits())
  (r + (s * 0.5)) + kept
}
