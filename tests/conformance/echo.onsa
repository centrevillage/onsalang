// onsa.toml
// [package]
// name = "echo"
// edition = "2026"
//
// [export]
// prefix = "onsa_"
// flows = ["echo.echo"]
//
// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [targets.host.memory]
// bulk_threshold = 4096
//
// [test]
// spec = ["§17.4"]
// conformance = true

// Conformance (T4-7): spec §17.4 echo (vdelay, bulk region). Pure IEEE: bit-exact.
const MAX_ECHO: U32 = 96000

pub flow echo(
  x: F32 at sample,
  @param(min: 0.01, max: 1.0, default: 0.3, unit: "s")
  time: F32 at block,
  @param(min: 0.0, max: 0.95, default: 0.5)
  feedback: F32 at block,
) -> F32 at sample {
  let d = time * sample_rate()
  let y = x + (feedback * vdelay~(^y, d, MAX_ECHO))
  y
}
