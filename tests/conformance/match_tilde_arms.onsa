// onsa.toml
// [package]
// name = "match_tilde_arms"
// edition = "2026"
//
// [export]
// prefix = "match_tilde_arms_"
//
// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "poison"
// provides = []
//
// [test]
// spec = ["§11.5", "§11.3", "§6.4", "§13.4"]
// conformance = true

// Conformance (W7-06 U3b/t, S-110, S-1094 (1), S-1131, R-14; §11.5, §11.3, §6.4, §13.4): a `match~` evaluates every arm, so the state of each arm moves on
// every sample, and takes the first arm that the pattern and the guard choose. The interpreter and C give the same values for a counter in each arm, for the
// binding of an arm that is not taken (the default of a number, of an `Option` payload, of a struct whose field has a declared value, of a struct with a
// `Default` written by hand, and of the payloads of an enum), for an arm whose guard fails, for a binding that a `block` and an `init` input read (evaluated at
// its stage whatever the arm is), for a `match~` in an arm of another and in a `par~` (a delay saves the binding of its own replica).

pub rt fn make_w(n: U32) -> F32 {
  F32.round_from(n) * 0.5
}

flow acc(x: F32 at sample) -> F32 at sample {
  let y = x + prev~(^y)
  y
}

flow gsum(x: F32 at sample, g: F32 at block) -> F32 at sample {
  let y = x * g + prev~(^y)
  y
}

flow shift(x: F32 at sample, n: U32 at init) -> F32 at sample {
  x + F32.round_from(n)
}

struct Gate: Default {
  open: Bool,
  level: F32 = 0.5,
  tag: U32,
}

struct Pt {
  x: F32,
  y: F32,
}

impl Default for Pt {
  rt fn default() -> Pt {
    Pt { x: 1.0, y: -1.0 }
  }
}

enum Mode {
  Off,
  Gain(F32),
  Mix(F32, F32),
}

@export
pub flow counters_by_value(x: F32 at sample) -> F32 at sample {
  let k: U32 = if x > 0.5 { 2 } else if x > 0.0 { 1 } else { 0 }
  match~ k {
    0 => acc~(1.0),
    1 => acc~(10.0),
    _ => acc~(100.0),
  }
}

@export
pub flow guards_from_the_top(x: F32 at sample) -> F32 at sample {
  let k: I32 = if x > 0.5 { 3 } else if x > 0.0 { 1 } else { -1 }
  match~ k {
    n if n < 0 => acc~(1.0),
    n if 100 / n > 5 => acc~(10.0),
    _ => 3.0,
  }
}

@export
pub flow option_payload_default(x: F32 at sample) -> F32 at sample {
  let o: Option[F32] = if x > 0.0 { Some(x) } else { None }
  match~ o {
    Some(v) => acc~(v + 1.0),
    None => 0.0,
  }
}

@export
pub flow a_binding_whose_guard_fails(x: F32 at sample) -> F32 at sample {
  let k: I32 = if x > 0.5 { 5 } else { 1 }
  match~ k {
    n if n > 2 => acc~(F32.round_from(n)),
    _ => 0.0,
  }
}

@export
pub flow derived_struct_default(x: F32 at sample) -> F32 at sample {
  let t = Gate { open: x > 0.0, level: x, tag: 2 }
  match~ t {
    g if g.open => acc~(g.level + F32.round_from(g.tag)),
    _ => 0.0,
  }
}

@export
pub flow hand_written_default(x: F32 at sample) -> F32 at sample {
  let t = Pt { x: x, y: x }
  match~ t {
    p if p.x > 0.5 => acc~(p.x * 10.0 + p.y),
    _ => 0.0,
  }
}

@export
pub flow enum_payload_defaults(x: F32 at sample) -> F32 at sample {
  let m = if x > 0.5 { Mode.Gain(x) } else if x > 0.0 { Mode.Mix(x, 1.0) } else { Mode.Off }
  match~ m {
    Mode.Gain(g) => acc~(g + 1.0),
    Mode.Mix(a, b) => acc~(a * 10.0 + b),
    Mode.Off => 0.0,
  }
}

@export
pub flow block_binding_in_an_arm(x: F32 at sample, @param(min: 0, max: 7, default: 2) k: U32 at block) -> F32 at sample {
  let o: Option[U32] = if k > 0 { Some(k) } else { None }
  match~ o {
    Some(n) => gsum~(x, make_w(n)),
    None => acc~(x),
  }
}

@export
pub flow block_binding_after_a_guard(x: F32 at sample, @param(min: 0, max: 7, default: 3) k: U32 at block) -> F32 at sample {
  match~ k {
    n if n > 2 => gsum~(x, make_w(n)),
    m => gsum~(x, make_w(m) * 4.0),
  }
}

@export
pub flow init_binding_in_an_arm(x: F32 at sample, n: U32 at init) -> F32 at sample {
  match~ n {
    m => shift~(x, m + 1),
  }
}

@export
pub flow a_match_tilde_in_an_arm(x: F32 at sample) -> F32 at sample {
  let a: U32 = if x > 0.0 { 0 } else { 1 }
  let b: U32 = if x > 0.5 { 0 } else { 1 }
  match~ a {
    0 => match~ b {
      0 => acc~(1.0),
      _ => acc~(10.0),
    },
    _ => if~ x < -0.5 { acc~(100.0) } else { acc~(1000.0) },
  }
}

@export
pub flow binding_saved_in_each_replica(x: F32 at sample) -> [F32; 3] at sample {
  let k: U32 = if x > 0.0 { 3 } else { 5 }
  par~ i in 0 ..< 3 {
    match~ k + i {
      0 => 0.0,
      n => prev~(F32.round_from(n)),
    }
  }
}
