// onsa.toml
// [package]
// name = "arm_storage_gen_copy"
// edition = "2026"
//
// [export]
// prefix = "as979_"
//
// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [test]
// spec = ["§11.6", "§5.2", "§5.4", "§13.4"]
// conformance = true

rt fn ramp(v: F32, s: F32) -> [F32; 16] {
  var a: [F32; 16] = [v; 16]
  for i in 0 ..< 16 {
    a[i] = v + s * F32.round_from(i)
  }
  a
}

rt fn take(s: Span[F32], k: U32) -> F32 {
  s[k % s.len()]
}

pub struct Stereo { l: F32, r: F32 }

flow pair(l: F32 at sample, r: F32 at sample) -> Stereo at sample {
  Stereo { l: l, r: r }
}

rt fn take_in(i: pair.In, k: U32) -> F32 {
  i.l[k % i.l.len()] - i.r[k % i.r.len()]
}

rt fn pick(c: Bool, v: F32, k: U32, y: [F32; 16]) -> F32 {
  take_in(if c {
    var t: [F32; 16] = [v; 16]
    t[1] = v + 1.0
    t[9] = v + 2.0
    pair.In { l: t, r: y }
  } else { pair.In { l: y, r: y } }, k)
}

@export
pub flow arm_storage_gen_copy(x: F32 at sample) -> F32 at sample {
  let k = U32.trunc_sat_from((x * x) * 1000.0)
  pick(x > 0.0, x, k, ramp(x, 0.5))
}
