flow f255(a: Bool at sample) -> I8 at sample { { if a == (a || true) { { 2 } } else if -10 != (if a { 2147483647 } else if a { 0 } else { 7 }) { -10 - 2 + 100 } else { 63 } } }
flow f256(a: Bool at sample) -> U8 at sample { (if a == false { 0 -| 0 } else { 127 +| 10 }) -| 0 }
flow f257(a: U32 at sample) -> F32 at sample { if 255 * 2 >= 2 { -1.0 } else { -1.00000017881393432617187499999 - (16777216.0 + 1.0) } }

