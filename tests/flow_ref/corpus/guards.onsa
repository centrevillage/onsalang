test "g1 0 frames d=0" {
  let xs: [F32; 3] = [2.0, -1.0, 0.5]
  var out: [F32; 3] = [7.0; 3]
  var st = g1.init(8.0)
  g1.process(inout st, g1.Params { d: 0 }, xs.slice(0, 0), inout out.slice(0, 0))
}

