// onsa.toml
// [test]
// mode = "test"
// spec = ["§11.3", "§11.6"]

// W7-05 U2/t, S-1157 (D'): the fixed input of the guarded parts of `init` and `block` in a position of a condition (hoist_cond_values.onsa has the same forms by hand, with their values worked out). Made by a script
// of the test (no seed): eight flows (the `if`, `else if`, `&&`, `||`, the arm of a `match` that binds, nested conditions of `block`, two `let`s that are guarded, a condition of `sample` outside a condition of
// `block`) over a grid of `block` values that holds the guard and does not hold it, with three frames each; the tests have no assert (the value of the evaluator is the one the interpreter has to give,
// `tests/flow_ref/FORMAT.md`), and the calls whose guard holds and whose division is by zero are the tests marked PANIC. The calls of 0 frames panic at `block` when the guard holds and divides by
// zero (the guarded part is made at `block`, W7-05 U2). The flows have no input of `init` (a panic of `init` is a constant-clock panic here, E0419).


pub flow g1(x: F32 at sample, d: I32 at block) -> F32 at sample {
  if d != 0 { x * F32.round_from(100 / d) } else { x }
}

pub flow g2(x: F32 at sample, d: I32 at block, e: I32 at block) -> F32 at sample {
  if d == 0 { x } else if e != 0 { x * F32.round_from(100 / e) } else { x + 1.0 }
}

pub flow g3(x: F32 at sample, d: I32 at block) -> F32 at sample {
  if d != 0 && F32.round_from(100 / d) > x { 1.0 } else { 0.0 }
}

pub flow g4(x: F32 at sample, d: I32 at block) -> F32 at sample {
  if d == 0 || F32.round_from(100 / d) > x { 1.0 } else { 0.0 }
}

pub flow g5(x: F32 at sample, o: Option[I32] at block) -> F32 at sample {
  match o { Some(v) => x * F32.round_from(100 / v), None => x }
}

pub flow g6(x: F32 at sample, d: I32 at block, e: I32 at block) -> F32 at sample {
  if d != 0 { if F32.round_from(100 / d) > F32.round_from(e) { x * F32.round_from(100 / e) } else { x } } else { x }
}

pub flow g7(x: F32 at sample, d: I32 at block, e: I32 at block) -> F32 at sample {
  let u = if d != 0 { x * F32.round_from(100 / d) } else { x }
  let v = if e != 0 { u * F32.round_from(100 / e) } else { u }
  v
}

pub flow g8(x: F32 at sample, d: I32 at block) -> F32 at sample {
  if x > 0.0 { if d != 0 { x * F32.round_from(100 / d) } else { x } } else { 0.0 }
}

test "g1 d=0" {
  let xs: [F32; 3] = [2.0, -1.0, 0.5]
  let _ = g1.render(g1.Params { d: 0 }, xs, 8.0)
}

test "g1 d=1" {
  let xs: [F32; 3] = [2.0, -1.0, 0.5]
  let _ = g1.render(g1.Params { d: 1 }, xs, 8.0)
}

