test "t0" {
  var a = f0.init(f0.Config { n: 4 }, 8.0)
  var b = g0.init(g0.Config { n: 4 }, 8.0)
  var xs: [I32; 4] = [13, 33, 30, 14]
  var oa0: [I32; 4] = [-1; 4]
  var ob0: [I32; 4] = [-1; 4]
  f0.process(inout a, f0.Params { p: 5 }, xs.slice(0, 4), inout oa0.slice(0, 4))
  g0.process(inout b, g0.Params { p: 5 }, xs.slice(0, 4), inout ob0.slice(0, 4))
  assert oa0[0] == ob0[0]
  assert oa0[1] == ob0[1]
  assert oa0[2] == ob0[2]
  assert oa0[3] == ob0[3]
  var oa1: [I32; 4] = [-1; 4]
  var ob1: [I32; 4] = [-1; 4]
  f0.process(inout a, f0.Params { p: 1 }, xs.slice(0, 0), inout oa1.slice(0, 0))
  g0.process(inout b, g0.Params { p: 1 }, xs.slice(0, 0), inout ob1.slice(0, 0))
  assert oa1[0] == ob1[0]
  assert oa1[1] == ob1[1]
  assert oa1[2] == ob1[2]
  assert oa1[3] == ob1[3]
  f0.reset(inout a)
  g0.reset(inout b)
}
test "t1" {
  var a = f1.init(8.0)
  var b = g1.init(8.0)
  var xs: [I32; 4] = [3, 3, 13, 11]
  var oa0: [I32; 4] = [-1; 4]
  var ob0: [I32; 4] = [-1; 4]
  f1.process(inout a, f1.Params { p: 0 }, xs.slice(0, 4), inout oa0.slice(0, 4))
  g1.process(inout b, g1.Params { p: 0 }, xs.slice(0, 4), inout ob0.slice(0, 4))
  assert oa0[0] == ob0[0]
  assert oa0[1] == ob0[1]
  assert oa0[2] == ob0[2]
  assert oa0[3] == ob0[3]
  var oa1: [I32; 4] = [-1; 4]
  var ob1: [I32; 4] = [-1; 4]
  f1.process(inout a, f1.Params { p: 4 }, xs.slice(0, 2), inout oa1.slice(0, 2))
  g1.process(inout b, g1.Params { p: 4 }, xs.slice(0, 2), inout ob1.slice(0, 2))
  assert oa1[0] == ob1[0]
  assert oa1[1] == ob1[1]
  assert oa1[2] == ob1[2]
  assert oa1[3] == ob1[3]
  var oa2: [I32; 4] = [-1; 4]
  var ob2: [I32; 4] = [-1; 4]
  f1.process(inout a, f1.Params { p: 3 }, xs.slice(0, 3), inout oa2.slice(0, 3))
  g1.process(inout b, g1.Params { p: 3 }, xs.slice(0, 3), inout ob2.slice(0, 3))
  assert oa2[0] == ob2[0]
  assert oa2[1] == ob2[1]
  assert oa2[2] == ob2[2]
  assert oa2[3] == ob2[3]
  var oa3: [I32; 4] = [-1; 4]
  var ob3: [I32; 4] = [-1; 4]
  f1.process(inout a, f1.Params { p: 9 }, xs.slice(0, 2), inout oa3.slice(0, 2))
  g1.process(inout b, g1.Params { p: 9 }, xs.slice(0, 2), inout ob3.slice(0, 2))
  assert oa3[0] == ob3[0]
  assert oa3[1] == ob3[1]
  assert oa3[2] == ob3[2]
  assert oa3[3] == ob3[3]
}
test "t2" {
  var a = f2.init(f2.Config { n: 4 }, 8.0)
  var b = g2.init(g2.Config { n: 4 }, 8.0)
  var xs: [I32; 4] = [11, 40, 21, 26]
  var oa0: [I32; 4] = [-1; 4]
  var ob0: [I32; 4] = [-1; 4]
  f2.process(inout a, f2.Params { p: 3 }, xs.slice(0, 0), inout oa0.slice(0, 0))
  g2.process(inout b, g2.Params { p: 3 }, xs.slice(0, 0), inout ob0.slice(0, 0))
  assert oa0[0] == ob0[0]
  assert oa0[1] == ob0[1]
  assert oa0[2] == ob0[2]
  assert oa0[3] == ob0[3]
  var oa1: [I32; 4] = [-1; 4]
  var ob1: [I32; 4] = [-1; 4]
  f2.process(inout a, f2.Params { p: 6 }, xs.slice(0, 0), inout oa1.slice(0, 0))
  g2.process(inout b, g2.Params { p: 6 }, xs.slice(0, 0), inout ob1.slice(0, 0))
  assert oa1[0] == ob1[0]
  assert oa1[1] == ob1[1]
  assert oa1[2] == ob1[2]
  assert oa1[3] == ob1[3]
  f2.reset(inout a)
  g2.reset(inout b)
  var oa2: [I32; 4] = [-1; 4]
  var ob2: [I32; 4] = [-1; 4]
  f2.process(inout a, f2.Params { p: 2 }, xs.slice(0, 4), inout oa2.slice(0, 4))
  g2.process(inout b, g2.Params { p: 2 }, xs.slice(0, 4), inout ob2.slice(0, 4))
  assert oa2[0] == ob2[0]
  assert oa2[1] == ob2[1]
