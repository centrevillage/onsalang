pub rt fn fill2(inout xs: [Span[F32]; 2]) {
  xs[0].fill!(1.0)
}

pub rt fn read2(xs: [Span[F32]; 2]) -> U32 { xs[0].len() }

pub fn planar_inout() {
  var a: [F32; 4] = [0.0; 4]
  var b: [F32; 4] = [0.0; 4]
  fill2(inout [a, b])
}

pub fn planar_alias() {
  var a: [F32; 4] = [0.0; 4]
  fill2(inout [a, a])
}

pub fn planar_read() -> U32 {
  let a: [F32; 4] = [0.0; 4]
  let b: [F32; 4] = [0.0; 4]
  read2([a, b])
}
