// R-55: 合成型の比較。期待: a〜c と q1〜q3 は通る（a は false、b と c は true）、d は E0405。今の実装は E0401（`?0` や `[I32; 2]`）
pub fn a() -> Bool { Some(1) == Some(2) }
pub fn b() -> Bool { [1, 2] == [1, 2] }
pub fn c() -> Bool { (1, 2) == (1, 2) }
pub fn d() -> Bool { [1.0, 2.0] == [1.0, 2.0] }
pub fn q1() -> Bool {
  let a: [I32; 2] = [1, 2]
  a == [1, 2]
}
pub fn q2(a: [I32; 2]) {
  assert a == [1, 2]
}
pub fn q3() {
  let a: [I32; 2] = [1, 2]
  let r = a == [1, 2]
  assert r
}
pub fn p5(a: [I32; 2]) -> Bool { [1, 2] == a }
