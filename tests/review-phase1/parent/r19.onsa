test "trunc_i64 of 2^63 (out of range)" {
  let x: F64 = 9223372036854775808.0
  let v = x.trunc_i64()
  assert v == 0
}
test "trunc_u64 of 2^64 (out of range)" {
  let x: F64 = 18446744073709551616.0
  let v = x.trunc_u64()
  assert v == 1
}
test "I32.MIN rem_euclid -1" {
  let a: I32 = I32.MIN
  let v = a.rem_euclid(-1)
  assert v == 1
}
test "I32.MIN % -1" {
  let a: I32 = I32.MIN
  let v = a % -1
  assert v == 1
}
