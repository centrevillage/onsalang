// T-8（impl-review-0.3.md から持ち越し）と R-105 の残り: 診断コードの流用の整理。
// `onsa check tests/review-phase1/parent/t8.onsa` で確かめる。期待値（S-103）と今（2026-10-05）の出力は各項目の上のコメント。

pub struct P { x: F32 }

pub fn helper(x: F32) -> F32 { x }

// 名前が、その位置に要る種類でない。
// 期待: E0308（名前の種類の誤り）。
// 今: E0308「`P` is a type, not a value (§15.1)」（W4-04 U8a から）。
fn type_as_value() -> F32 { let a = P
  1.0 }

// 期待: E0308。
// 今: E0308「`helper` is a function, not a type (§15.1)」（W4-04 U8a から）。
fn value_as_type(x: helper) -> F32 { 1.0 }

// 期待: E0020（値を `x(...)` で呼ぶと型によらず E0020、候補は `x.(1.0)`。§15.1、S-191）。
// 今: 名前の段の E0020（W4-12 U1 から）で、修正候補は `x.(1.0)`。
fn call_non_function(x: F32) -> F32 { x(1.0) }

// 期待: E0412（引数の数のコードを型引数にも使う）。
// 今: E0412「`F32` takes 0 type argument(s), 1 given」（W4-05 U4c から）。
fn type_arity(x: F32[I32]) -> F32 { 1.0 }

// 期待: E0308。
// 今: E0308「`N` is a constant, not a type (§15.1)」（W4-04 U8a から）。
const N: U32 = 4
fn const_as_type(x: Option[N]) -> F32 { 1.0 }

// 定数式の規則（§4.5）。仕様は「関数の呼び出しは書けない」とだけ書き、コードを定めていない。
// 期待: E0417（定数式の規則の違反）。
// 今: E0417「`len()` is a call, not a constant: a constant expression names constants (§4.5)」。
fn len_from_call(x: [F32; len()]) -> F32 { 1.0 }
fn len() -> U32 { 4 }

// 未知の属性。仕様（§6.5）は属性の閉じた一覧を定めるが、コードを定めていない。
// 期待: E0005。
// 今: E0005「there is no attribute `@inline`」。
@inline
fn attr() -> F32 { 1.0 }

// `impl` の対象が型でない。
// 期待: E0308。
// 今: E0308「`helper` is a function, not a type (§15.1)」（W4-04 U8a から。名前でない型の形の対象（タプルなど）は W4-05 U3b から E0307、R-320）。
impl helper {
  fn m(self) -> F32 { 1.0 }
}
