// R-72 / R-123: E0010 の修正候補（S-60）と、ビットの群の同じ演算子の連鎖（S-61）。
// 各関数は別の診断の単位（S-59）。期待値と今の出力は各関数の上のコメントに書いた。
// 今の実装は S-45 も未実装なので、`mul_rem` は通る。

// 期待: E0010。候補は `(a && b) || c`、`a && (b || c)` の順。今は `a && (b || c)` だけ。
fn and_or(a: Bool, b: Bool, c: Bool) -> Bool {
  a && b || c
}

// 期待: E0010。候補は `(a || b) && c`、`a || (b && c)` の順。今は `a || (b && c)` だけ。
fn or_and(a: Bool, b: Bool, c: Bool) -> Bool {
  a || b && c
}

// 期待: E0010。候補は `(a && b) || (c && d)`、`a && (b || c) && d` の順（式が長くても 2 つ）。今は後者だけ。
fn and_or_long(a: Bool, b: Bool, c: Bool, d: Bool) -> Bool {
  a && b || c && d
}

// 期待: E0010。候補は `(x & 1) == 0`、`x & (1 == 0)` の順。今は `x & (1 == 0)` だけ（C の誤読）。
fn mask_cmp(x: U32) -> Bool {
  x & 1 == 0
}

// 期待: E0010。候補は `(x << 1) + y`、`x << (1 + y)` の順。今は `x << (1 + y)` だけ。
fn shift_add(x: U32, y: U32) -> U32 {
  x << 1 + y
}

// 期待: E0010。候補は `(w + 1) % n`、`w + (1 % n)` の順。今は `w + (1 % n)` だけ（S-45 が防ぐ誤り）。
fn ring_index(w: U32, n: U32) -> U32 {
  w + 1 % n
}

// 期待: E0010（S-45）。候補は `(w * 2) % n`、`w * (2 % n)` の順。今は通る。
fn mul_rem(w: U32, n: U32) -> U32 {
  w * 2 % n
}

// 期待: E0010。候補は 3 つ: `(x & 1) == 0 && ok`、`(x & (1 == 0)) && ok`、`x & (1 == 0 && ok)`。今は `x & (1 == 0) && ok` だけ。
fn three_groups(x: U32, ok: Bool) -> Bool {
  x & 1 == 0 && ok
}

// 期待: E0010。違う形の読みが 7 つあるので候補を出さず、note で書き方を示す。今は `x & (1 == 0) && a || b`。
fn four_groups(x: U32, a: Bool, b: Bool) -> Bool {
  x & 1 == 0 && a || b
}

// 期待: E0010。候補は `x < y && y < w` の一つ。今は候補なし。
fn cmp_chain(x: U32, y: U32, w: U32) -> Bool {
  x < y < w
}

fn g(y: U32) -> U32 { y }

// 期待: E0010。中央が呼び出しなので候補を出さず、`let` に取る書き方を note で示す。今は候補なし。
fn cmp_chain_call(x: U32, y: U32, w: U32) -> Bool {
  x < g(y) < w
}

// 期待: E0010。候補は `(x & y) | 1`、`x & (y | 1)` の順。今は候補なし。
fn bit_mixed(x: U32, y: U32) -> U32 {
  x & y | 1
}

// 期待: 全て通る（S-61）。今はどれも E0010。
fn bit_or(x: U32, y: U32) -> U32 {
  x | y | 1
}

fn bit_and(x: U32, y: U32) -> U32 {
  x & y & 1
}

fn bit_xor(x: U32, y: U32) -> U32 {
  x ^ y ^ 1
}

fn bit_shift(x: U32) -> U32 {
  x << 1 << 2
}
