// T-5（impl-review-0.3.md から持ち越し）: flow だけの構文を flow の外に書いたときの診断。
// `onsa check tests/review-phase1/parent/t5.onsa` で確かめる。期待値（S-101）と移した先は各関数の上のコメント（`par`・`lp~(x)`・`prev~(x)`・`lp(x)`・`prev~(^z)` は W4-12 U3/t で期待値付きの事例へ移した。レート型の部分は S-102 の作業が残る）。
// 逆向き（fn だけの構文を flow の本体に書いた）は E0806（§11.2）。

pub flow lp(x: Sig[F32]) -> Sig[F32] { x }

// 期待: E0821（修正候補なし。note で `array.from_fn` / `[e; N]`）。
// 移した先: `tests/spec/negative/e0821_flow_syntax_in_fn.onsa` の `with_par`（R-139）。W4-12 U3 で E0821 になる。
fn with_par(x: F32) -> F32 {
  let y = par i in 0..<4 { 1.0 }
  x
}

// 期待: E0821（修正候補なし。note で `lp.init` / `lp.process` を使うか、この関数を flow にする）。
// 移した先: `tests/spec/negative/e0821_flow_syntax_in_fn.onsa` の `with_instance`（S-267、S-815）。W4-12 U3 で E0821 になる。
fn with_instance(x: F32) -> F32 {
  let y = lp~(x)
  x
}

// 期待: E0821（修正候補なし。note で、状態を `inout` 引数で持つ）。
// 移した先: `tests/spec/negative/e0821_flow_syntax_in_fn.onsa` の `with_prev`（`prev~(x)`）。W4-12 U3 で E0821 になる。
fn with_prev(x: F32) -> F32 {
  let y = prev~(x)
  x
}

// 期待: E0821（`~` の有無によらない）。
// 移した先: `tests/spec/negative/e0821_plain_flow_call.onsa` の `with_plain_call`（R-269）。W4-12 U3 で E0821 になる。flow の中なら E0811（`~` の挿入）。
fn with_plain_call(x: F32) -> F32 {
  let y = lp(x)
  x
}

// 期待（S-102）: レートは型ではなくなった。`Sig[F32]` / `Ctl[F32]` の形は E0020 で、flow の外なので修正候補はレートを外した `F32`。
//   `at` を flow の外に書けば（`fn g(x: F32 at sample)`）E0821（`tests/spec/negative/names_clock_in_fn_head.onsa`）。この部分は W4-12 U3 の範囲の外。
// 今: レート型は flow の外の宣言にも書けてしまい、宣言では何も出ない。使う所で分かりにくい E0401 になる
//   （`g` の本体の `1.0` は「a float literal cannot have type `Ctl[F32]`」、flow から `g(x)` を呼ぶと「expected `Sig[F32]`, found `F32`」）。
struct WithRate { v: Sig[F32] }

fn g(x: Sig[F32]) -> Ctl[F32] { 1.0 }

pub flow use_g(x: Sig[F32]) -> Sig[F32] {
  let a = g(x)
  x
}

// 期待: E0821。
// 移した先: `tests/spec/negative/e0821_flow_syntax_in_fn.onsa` の `with_feedback`（`prev~(^z)`）。W4-12 U3 で E0821 になる。flow の中なら、遅延の第 1 引数の外の `^名前` は E0801。
fn with_feedback(x: F32) -> F32 {
  let y = prev~(^z)
  x
}
