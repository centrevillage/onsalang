// R-73 / R-124: 数値リテラル（S-62、S-63）。
// 各関数は別の診断の単位（S-59）。期待値と今の出力は各関数の上のコメントに書いた。
// 「fmt」と書いたものは、`check` を通り、`onsa fmt` が右の形に揃えるのが期待値。

// 期待: 通る（浮動小数の 1000.0）。今も通る。
fn exp_no_point() -> F32 {
  1e3
}

// 期待: E0020、候補 `1.0e3`。今は E0420（`1` のフィールド `e3` と読む）。
fn point_then_exp() -> F32 {
  1.e3
}

// 期待: E0020、候補 `15`。今は E0020 で候補 `0`。
fn octal_prefix() -> U32 {
  0o17
}

// 期待: E0020、候補 `17` と `15`（R-124）。今は通る（17）。
fn leading_zero() -> U32 {
  017
}

// 期待: E0020、候補 `0`（R-124）。今は通る。
fn double_zero() -> U32 {
  00
}

// 期待: E0020、候補 `0x1F`。今は候補 `0x1F_`。
fn hex_suffix() -> U32 {
  0x1F_u8
}

// 期待: E0020、候補 `1_000`。今は候補 `1_000_`。
fn dec_suffix() -> U32 {
  1_000_i32
}

// 期待: E0020、候補 `100`。今も同じ。
fn c_suffix() -> U32 {
  100ul
}

// 期待: E0020、候補 `1.0`（浮動小数のまま）。今は候補 `1`。
fn float_suffix_on_int() -> F32 {
  1f32
}

// 期待: E0020、候補 `2.5`。今も同じ。
fn c_float_suffix() -> F32 {
  2.5f
}

// 期待: E0001、候補なし（接尾辞の一覧に無い）。今は E0020 で候補 `123`。
fn not_a_suffix() -> U32 {
  123abc
}

// 期待: E0001（接頭辞の後に数字が無い）。今は E0408「どの整数型にも入らない」。
fn prefix_only() -> U32 {
  0x_
}

// 期待: 通る。fmt で `0x1F`。今は E0020 で候補 `0`。
fn upper_hex_prefix() -> U32 {
  0X1F
}

// 期待: 通る。fmt で `0b101`。今は E0020 で候補 `0`。
fn upper_bin_prefix() -> U32 {
  0B101
}

// 期待: 通る。fmt で `1e3`。今は通るが fmt は変えない。
fn upper_exp() -> F32 {
  1E3
}

// 期待: 通る。fmt で `0xFF`。今は通るが fmt は変えない。
fn lower_hex_digits() -> U32 {
  0xff
}

// 期待: 通る。fmt で `1_000`、`1`、`0x1F`。今は通るが fmt は変えない。
fn underscores() -> U32 {
  1__000 + 1_ + 0x_1F
}

// 期待: 通る。fmt で `1.5`。今は通るが fmt は変えない。
fn float_leading_zero() -> F32 {
  01.5
}
