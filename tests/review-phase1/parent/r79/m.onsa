// R-79: std の `target` 宣言を、変換先が与えないとき（S-69）。
// `m.onsa` の 29 行の `let g` は E0309（`_` に直すと `check` を通る）。`check` は変換先によらない。

use std.test.{Gen}
use std.test.gen
use std.dsp.test.{assert_near}

// 期待: `onsa build --target host` が、生成を始める前に E0200（`std.dsp.test.assert_near`、C は与えない）。
// 今も同じ: m.onsa:13:3: error[E0200]: the C backend does not support the `std` function
// `std.dsp.test.assert_near` (no C implementation) in this version。
@export
pub fn near(x: F64) -> F64 {
  assert_near(x, 1.0, 0.1)
  x
}

// 期待: `onsa test` が、テストを走らせる前に E0200（`std.test.gen.u32`、インタプリタは M5 まで与えない）。
// 今: 実行の前に E0200「this version does not support the `std` function `std.test.gen.u32` in `onsa test` (the interpreter)」（21:3）。他のテストは走らない。
fn digits() -> Gen[U32] {
  gen.u32(0, 9)
}

test "near" {
  assert_near(near(1.0), 1.0, 0.1)
}

test "gen" {
  let g = digits()
}
