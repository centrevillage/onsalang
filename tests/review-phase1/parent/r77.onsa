// R-77: 同じ診断の繰り返し、降下の内部の失敗の E0200、入力名の予約名（S-67）。
// 期待値と今の出力は各項目の上のコメントに書いた。`onsa check` と `onsa test` で確かめる。

// 期待: `onsa check` で E0304（`sample_rate` は flow の組込みの名前、§2.2。入力名にも使えない）。`tests/spec/negative/names_reserved_inputs.onsa` で確かめる。
// 今: `check` が E0304（`sample_rate` は flow の組込みの名前）。
pub flow f3(sample_rate: Sig[F32]) -> Sig[F32] {
  sample_rate
}

// 期待（S-1138 で改めた）: 診断は無い。状態の固定の欄は `_poisoned` で利用者の書けない名前なので、入力 `poisoned` は通り、値は `tests/spec/flow/state_names_free_run.onsa` で確かめる。
// （改める前の期待は、`poisoned` を状態の固定の欄の名前として予約して E0304 にするものだった。）
pub flow f4(x: Sig[F32], poisoned: Ctl[F32]) -> Sig[F32] {
  x * poisoned
}

// 期待: 降下の E0200 が 2 件（位置が違い、互いに連鎖しない本物の誤りなので、単位で絞らない）。
// 今: 2 件（19 行の `a < b` と `p < q`、E0200）。W1-04 の事例 `tests/spec/negative/lower_unsupported.onsa` が守る。
// E0200 は、この版の降下が配列とタプルの大小の比較を未対応としていること（R-119）による。
pub fn two_features(a: [I32; 2], b: [I32; 2], p: (I32, I32), q: (I32, I32)) -> Bool {
  (a < b) && (p < q) // 括弧は今の実装（S-45 が未実装）のため
}
