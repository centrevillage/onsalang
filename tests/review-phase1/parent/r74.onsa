// R-74: modes の失敗の後に走る rt と効果の検査が、本当のエラーを隠す（S-64）。
// 期待値は各関数の上のコメントに書いた。W4-06 で直し、期待値付きの事例は
// tests/spec/negative/unit_stage_modes_stops_rt.onsa・unit_stage_modes_stops_rt_alloc.onsa。

pub struct Holder {
  buf: Buf[F32],
  gain: F32,
}

// 期待: E0711（部分移動）。今: 通る（S-85 から、取り出すと全体を消費し残りを破棄する。W4-09 U2）。降下は E0200「this version does not support taking a field out of a value (the rest is dropped)」（W8-04 まで）。
pub fn take_field(move s: Holder) -> Buf[F32] { s.buf }

// 期待: E0711。今: 通る（S-85 から、取り出すと全体を消費し残りを破棄する。W4-09 U2）。降下は E0200「this version does not support taking a field out of a value (the rest is dropped)」（W8-04 まで）。
pub rt fn take_field_rt(move s: Holder) -> Buf[F32] { s.buf }
