// R-62: 改行を空白として扱う場所での else と { の位置。期待: p1〜p4 は E0003（p5 はブロックの中で、今も E0003）。今の実装は p1〜p4 を通す
use std.array
pub fn id(x: I32) -> I32 { x }
pub fn p1(c: Bool) -> I32 {
  id(if c { 1 }
     else { 2 })
}
pub fn p2(c: Bool, x: I32) -> I32 {
  match x {
    0 => if c { 1 }
         else { 2 },
    _ => 3,
  }
}
pub fn p3(c: Bool) -> I32 {
  id(if c
     { 1 } else { 2 })
}
pub fn p4() -> [U32; 3] {
  array.from_fn(fn(i)
    { i })
}
pub fn p5(c: Bool) -> I32 {
  if c { 1 }
  else { 2 }
}
