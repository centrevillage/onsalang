// R-100（S-88）: 型の大きさと flow の状態の各領域は `U32` で表せること（2^32 - 1 バイト以下）。超えたら E0409（点検 C-30、S-142 で E0313 から移した）。
// 検査は配置を計算するとき（ターゲットの pass）に行う。`onsa interface` で確かめる。コンパイラ自体は panic しない。
// 今（2026-10-05）: 全て `onsa check` を通る。`onsa interface` はコンパイラ自体が panic する（このファイルでは最初の `one` で止まる）。
//   `one`: layout.rs:41:14 の掛け算の溢れ。`two` だけのファイル: layout.rs:111:9 の足し算の溢れ。`wide` だけのファイル: lower/flow.rs:431:61（`MAX + 1` の溢れ）。
//   `Huge`: `onsa interface` は struct の大きさを出さないので、何も起きない。

// 期待: E0409（状態が 2^32 バイト）。診断は flow の宣言に置き、note で最も大きいフィールドを示す。
pub flow one(x: Sig[F32]) -> Sig[F32] {
  delay(x, 1073741824, 0.0)
}

// 期待: E0409（2 GiB の遅延線が 2 つで、状態が 2^32 バイトを超える）。
pub flow two(x: Sig[F32]) -> Sig[F32] {
  let a = delay(x, 536870912, 0.0)
  let b = delay(a, 536870912, 0.0)
  b
}

// 期待: E0409（`MAX + 1` は溢れる前に、大きさの検査で止まる）。
pub flow wide(x: Sig[F64]) -> Sig[F64] {
  vdelay(x, 10.0, 4294967295, 0.0)
}

// 期待: E0409（flow の状態でない型にも同じ上限を掛ける）。
pub struct Huge {
  a: [F32; 1073741824],
}

pub fn first(h: Huge) -> F32 { h.a[0] }
