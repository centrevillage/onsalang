@export
pub flow boom(
  x: Sig[F32],
  @param(min: 0.0, max: 10000000000.0, default: 1.0)
  k: Ctl[F32],
) -> Sig[F32] {
  let n = U32.trunc_from(k)
  x * F32.round_from(n)
}

@export
pub flow gainq(
  x: Sig[F32],
  @param(min: 0, max: 4, default: 1)
  q: Ctl[I32],
) -> Sig[F32] {
  x * (F32.round_from(q))
}
