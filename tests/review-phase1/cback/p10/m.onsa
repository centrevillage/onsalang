use std.dsp.test.{assert_near}

fn narrow_any(x: I64) -> I32 {
  match x.narrow_i32() {
    Some(v) => v,
    None => -7,
  }
}

fn u64_to_i64(x: U64) -> I32 {
  match x.narrow_i64() {
    Some(_) => 1,
    None => 0,
  }
}

fn u32_to_i8(x: U32) -> I32 {
  match x.narrow_i8() {
    Some(v) => v as I32,
    None => -7,
  }
}

fn i8ops(a: I8, b: I8) -> I32 {
  let w = (a *% b) as I32
  let s = (a *| b) as I32
  let d = a.div_euclid(b) as I32
  let r = a.rem_euclid(b) as I32
  (((w * 1000000) + (s * 10000)) + (d * 100)) + r
}

fn u8ops(a: U8, b: U8) -> I32 {
  let w = (a -% b) as I32
  let s = (a -| b) as I32
  let m = (a *| b) as I32
  ((w * 100000) + (s * 1000)) + m
}

pub fn k(i: U32) -> I32 {
  if i == 0 { return narrow_any(-5) }
  if i == 1 { return u64_to_i64(5) }
  if i == 2 { return u32_to_i8(5) }
  if i == 3 { return i8ops(-128, 3) }
  if i == 4 { return i8ops(-7, -2) }
  if i == 5 { return u8ops(3, 200) }
  if i == 6 { return u8ops(200, 3) }
  0
}

test "values" {
  assert_near(k(0) as F64, 1.0e9, 0.0)
}
test "v1" {
  assert_near(k(1) as F64, 1.0e9, 0.0)
}
test "v2" {
  assert_near(k(2) as F64, 1.0e9, 0.0)
}
test "v3" {
  assert_near(k(3) as F64, 1.0e9, 0.0)
}
test "v4" {
  assert_near(k(4) as F64, 1.0e9, 0.0)
}
test "v5" {
  assert_near(k(5) as F64, 1.0e9, 0.0)
}
test "v6" {
  assert_near(k(6) as F64, 1.0e9, 0.0)
}
