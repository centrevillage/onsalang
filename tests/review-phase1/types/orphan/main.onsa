// R-104（S-70）: 固有 impl は型を定義したモジュールにだけ書ける。組込み型は std で定義されたものとして扱う。
// 期待: 3 つの `impl`（`impl Point`、`impl F32`、`impl Option[F32]`）の見出しがそれぞれ E0307。
//   見出しの誤りは impl 全体が一つの診断の単位（S-59）で、`run` / `run2` には連鎖させない。
// 今（2026-10-04）: 3 つとも通り、`x.double()` だけが E0413（組込み型の受け手のメソッドを impl から引く経路が無い）。
//   `F32.HALF` と `F32.make()` は使える。

use util.{Point}

impl Point {
  pub fn twice(self) -> F32 { self.x * 2.0 }
}

impl F32 {
  pub const HALF: F32 = 0.5
  pub fn double(self) -> F32 { self * 2.0 }
  pub fn make() -> F32 { 1.0 }
}

impl Option[F32] {
  pub fn zero() -> F32 { 0.0 }
}

pub fn run(p: Point) -> F32 { p.twice() + F32.HALF + F32.make() }
pub fn run2(x: F32) -> F32 { x.double() }
