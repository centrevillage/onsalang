use std.dsp.test.{impulse}
pub flow acc(x: Sig[F32], k: Init[F32]) -> Sig[F32] {
  let y = prev(y, 0.0) + (x * k)
  y
}
pub flow nest(x: Sig[F32]) -> Sig[F32] {
  let m = par i in 1..3 { par j in 0..2 { acc~(x, ((i * 10) + j).round_f32()) } }
  m[0][0] + m[0][1] + m[1][0] + m[1][1]
}
test "nested par" {
  let o = nest.render(nest.Config {}, nest.Params {}, impulse(3), 48000.0)
  assert o.out[0] == 62.0
  assert o.out[2] == 62.0
}
