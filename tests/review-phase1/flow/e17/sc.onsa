// 2026-10-06、点検 C-33（S-110）で規則を改めた。期待（S-110 の後）: `c && (counter~(x) > 2.0)` は E0806（`&&` の右辺に状態を持つもの。修正候補は前の `let` に出す形）。
// 0.3 の草案の flow の書き方（`Sig[F32]`、`Ctl[Bool]`、`prev(…, 0.0)`）のまま残す。今の実装は受け付けない。
pub flow counter(x: Sig[F32]) -> Sig[F32] {
  let n = prev(n, 0.0) + 1.0
  n
}
pub flow sc(x: Sig[F32], c: Ctl[Bool]) -> Sig[F32] {
  let b = c && (counter~(x) > 2.0)
  if b { 1.0 } else { 0.0 }
}
