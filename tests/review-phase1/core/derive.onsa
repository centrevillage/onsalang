@derive(PartialEq, Default)
struct P { x: I32, y: F32 }

@derive(PartialEq, PartialOrd)
struct Q { a: I32 }

test "default" {
  let p: P = P { x: 0, y: 0.0 }
  assert p.x == 0
}

test "eq with nan" {
  let a = P { x: 1, y: F32.NAN }
  assert a != a
}

test "ord" {
  let a = Q { a: 1 }
  let b = Q { a: 2 }
  assert a < b
}
