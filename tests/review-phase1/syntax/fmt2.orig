}

fn args(a: I32, // first
        b: I32) -> I32 {
  a
}

fn chain(x: F32) -> F32 {
  let y = x // start
    .abs() // magnitude
    .sqrt()
  y
}

fn cond(c: Bool) -> I32 {
  if c { // yes
    1
  } else { // no
    2
  }
}

fn one(c: Bool) -> I32 { if c { 1 } else { 2 } } // trailing
