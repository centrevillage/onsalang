// onsa.toml
// [test]
// spec = ["§3.3", "§3.4", "§6.6", "§11.4"]

// Package `predicates` of the scalar test vectors (tests/vectors/OPS.tsv, W2-01): one function per operation,
// called with the boundary values of tests/vectors/*.tsv. Generated by tools/vectors/gen.py.
// These operations are not accepted yet (the rule in tools/vectors/ops.py, PENDING_PACKAGES): the package
// is a test case that waits in tests/pending.toml.

use std.math.{is_finite, is_nan}

pub fn f32_is_nan(a: F32) -> Bool { is_nan(a) }

pub fn f32_is_finite(a: F32) -> Bool { is_finite(a) }

pub fn f64_is_nan(a: F64) -> Bool { is_nan(a) }

pub fn f64_is_finite(a: F64) -> Bool { is_finite(a) }
