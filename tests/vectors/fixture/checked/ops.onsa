// onsa.toml
// [test]
// spec = ["§3.3", "§3.4", "§6.6", "§11.4"]

// Package `checked` of the scalar test vectors (tests/vectors/OPS.tsv, W2-01): one function per operation,
// called with the boundary values of tests/vectors/*.tsv. Generated by tools/vectors/gen.py.
// These operations are not accepted yet (the rule in tools/vectors/ops.py, PENDING_PACKAGES): the package
// is a test case that waits in tests/pending.toml.

pub fn i8_checked_rem_some(a: I8, b: I8) -> Bool {
  match a.checked_rem(b) {
    Some(_) => true,
    None => false,
  }
}

pub fn i8_checked_rem_val(a: I8, b: I8) -> I8 {
  match a.checked_rem(b) {
    Some(v) => v,
    None => 0,
  }
}

