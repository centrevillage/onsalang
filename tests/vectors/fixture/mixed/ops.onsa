// onsa.toml
// [test]
// spec = ["§3.3", "§3.4", "§6.6", "§11.4"]

// Package `mixed` of the scalar test vectors (tests/vectors/OPS.tsv, W2-01): one function per operation,
// called with the boundary values of tests/vectors/*.tsv. Generated by tools/vectors/gen.py.
// These operations are not accepted yet (the rule in tools/vectors/ops.py, PENDING_PACKAGES): the package
// is a test case that waits in tests/pending.toml.

pub fn f32_expr_muladd(a: F32, b: F32, c: F32) -> F32 { a * b + c }

pub fn f32_expr_mulsub(a: F32, b: F32, c: F32) -> F32 { a * b - c }

pub fn f32_expr_interp(a: F32, b: F32, c: F32) -> F32 { (1.0 - c) * a + c * b }

pub fn f64_expr_muladd(a: F64, b: F64, c: F64) -> F64 { a * b + c }

pub fn f64_expr_mulsub(a: F64, b: F64, c: F64) -> F64 { a * b - c }

pub fn f64_expr_interp(a: F64, b: F64, c: F64) -> F64 { (1.0 - c) * a + c * b }
