  match a.checked_div(b) {
    Some(_) => true,
    None => false,
  }
}

@export
pub fn i64_checked_div_val(a: I64, b: I64) -> I64 {
  match a.checked_div(b) {
    Some(v) => v,
    None => 0,
  }
}

