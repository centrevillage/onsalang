rt fn voice.Poly.note_on(inout self: voice.Poly, note: U8, velocity: F32) -> () {
  let i: U32 = self.3
  self.2[i] = Option__U8.Some(note)
  self.1[i].0 = voice.midi_to_hz(note)
  self.1[i].3 = velocity
