rt fn voice.Poly.note_off(inout self: voice.Poly, note: U8) -> () {
  for i in 0:U32..const voice.MAX_VOICES {
    if __eq.Option__U8(self.2[i], Option__U8.Some(note)) {
      self.2[i] = Option__U8.None
      self.1[i].3 = 0.0:F32
    }
  }
