rt fn voice.voice.tick(inout s: voice.voice.State) -> F32 {
  let src@4: F32 = {
    let src@8: F32 = voice.saw.tick(inout s.0)
    src@8
  }
  let f1@5: F32 = {
    let f1@9: F32 = voice.resonator.tick(inout s.1, src@4)
    f1@9
  }
  let f2@6: F32 = {
    let f2@10: F32 = voice.resonator.tick(inout s.2, src@4)
    f2@10
  }
  let __out: F32 = ((f1@5 + f2@6) * {
    let smooth_0: F32 = voice.smooth.tick(inout s.3)
    smooth_0
  })
