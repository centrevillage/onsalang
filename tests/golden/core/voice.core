rt fn voice.midi_to_hz(note: U8) -> F32 {
  (440.0:F32 * math.exp2.F32((((note as F32) - 69.0:F32) / 12.0:F32)))
}
fn voice.Poly.new(sample_rate: F32) -> voice.Poly sret {
