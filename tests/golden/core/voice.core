fn test.resonator decays() -> () {
  let o: voice.resonator.Out = voice.resonator.render(voice.resonator.Config {}, voice.resonator.Params { fc: 500.0:F32, bw: 100.0:F32 }, {
    let __arr: Buf[F32] = std.dsp.test.impulse(48000:U32)
    span(__arr)
  }, 48000.0:F32)
  if (!(std.dsp.test.energy(span(o.0), 47000:U32, 48000:U32) < 1e-12:F64)) {
    panic("assertion failed: energy(o.out, 47000, 48000) < 1.0e-12")
  }
}
