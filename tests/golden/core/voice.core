rt fn voice.Poly.process(inout self: voice.Poly, inout out: Span[F32], inout scratch: Span[F32]) -> () {
  fill(inout out, 0.0:F32)
  for i in 0:U32..const voice.MAX_VOICES {
    voice.voice.process(inout self.0[i], self.1[i], inout scratch)
    add_from(inout out, scratch)
  }
}
rt fn __eq.Option__U8(a: Option__U8, b: Option__U8) -> Bool {
  if (tag(a) != tag(b)) {
    return false
  }
  switch a {
    None => {
      true
    }
    Some => {
      (payload(a, Some, 0) == payload(b, Some, 0))
    }
  }
}
