rt fn voice.resonator.ctl(inout s: voice.resonator.State, p: voice.resonator.Params) -> () {
  let r: F32 = math.exp.F32(((-(3.1415927:F32 * p.1)) / s.0))
  s.1 = r
  let w: F32 = (((2.0:F32 * 3.1415927:F32) * p.0) / s.0)
  let b1: F32 = ((2.0:F32 * r) * math.cos.F32(w))
  s.2 = b1
  let b2: F32 = (r * r)
  s.3 = b2
}
rt fn voice.resonator.tick(inout s: voice.resonator.State, x: F32) -> F32 {
  let y1@7: F32 = {
    let y1@11: F32 = s.4
    y1@11
  }
  let y2@8: F32 = {
    let y2@12: F32 = s.5
    y2@12
  }
  let y: F32 = ((((1.0:F32 - s.1) * x) + (s.2 * y1@7)) - (s.3 * y2@8))
  let __out: F32 = y
  s.4 = y
  s.5 = y1@7
  __out
}
