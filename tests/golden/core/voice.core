rt fn voice.voice.ctl(inout s: voice.voice.State, p: voice.voice.Params) -> () {
  voice.saw.ctl(inout s.0, voice.saw.Params { f0: p.0 })
  voice.resonator.ctl(inout s.1, voice.resonator.Params { fc: p.1, bw: 80.0:F32 })
  voice.resonator.ctl(inout s.2, voice.resonator.Params { fc: p.2, bw: 120.0:F32 })
  voice.smooth.ctl(inout s.3, voice.smooth.Params { x: p.3 })
