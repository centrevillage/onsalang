// onsa.toml
// [package]
// name = "echo"
// edition = "2026"
//
// [export]
// prefix = "onsa_"
// flows = ["echo.echo"]
//
// [targets.trap]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [targets.trap.memory]
// bulk_threshold = 4096
//
// [targets.poison]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "poison"
// provides = ["Alloc"]
//
// [targets.poison.memory]
// bulk_threshold = 4096
//
// [test]
// spec = ["§17.4"]
// golden = ["core", "c"]

// Golden source for the flow lowering (T3-5): spec §17.4 `echo` alone (vdelay).
const MAX_ECHO: U32 = 96000

pub flow echo(
  x: Sig[F32],
  @param(min: 0.01, max: 1.0, default: 0.3, unit: "s")
  time: Ctl[F32],
  @param(min: 0.0, max: 0.95, default: 0.5)
  feedback: Ctl[F32],
) -> Sig[F32] {
  let d = time * sample_rate()
  let y = x + (feedback * vdelay(y, d, MAX_ECHO, 0.0))
  y
}
