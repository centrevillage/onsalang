digraph "nested" {
  rankdir=LR
  node [shape=box fontname="monospace"]
  "x" [label="x: F32 at sample" shape=ellipse color="black" fontcolor="black"]
  "m" [label="m = par~ 0..<2: [F32; 2] at sample" color="black" fontcolor="black"]
  "_out" [label="out: F32 at sample" shape=doubleoctagon color="black" fontcolor="black"]
  "m.par_0" [label="par_0 = par~ 0..<2: [F32; 2] at sample" style=rounded color="black" fontcolor="black"]
  "m.par_0.lp_0" [label="lp_0 = lp~: F32 at sample" style=rounded color="black" fontcolor="black"]
  "m.par_0" -> "m"
  "m.par_0.lp_0" -> "m.par_0"
  "x" -> "m.par_0.lp_0"
  "m" -> "m.par_0.lp_0"
  "m.par_0" -> "m.par_0.lp_0"
  "m" -> "_out"
}
