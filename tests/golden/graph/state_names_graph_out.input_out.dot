digraph "input_out" {
  rankdir=LR
  node [shape=box fontname="monospace"]
  "out" [label="out: F32 at sample" shape=ellipse color="black" fontcolor="black"]
  "_out" [label="out: F32 at sample" shape=doubleoctagon color="black" fontcolor="black"]
  "_out.prev_0" [label="prev_0 = prev~: F32 at sample" style=rounded color="black" fontcolor="black"]
  "_out.prev_0" -> "_out"
  "out" -> "_out.prev_0" [style=dashed]
  "out" -> "_out"
}
