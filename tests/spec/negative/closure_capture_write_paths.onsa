// onsa.toml
// [test]
// spec = ["§5.3", "§5.2", "§5.1"]
// fixes = 0

// R-25 (§5.3, the row of a capturing closure): "外側の値をコピーで捕捉する無名関数。捕捉した値は読み取り専用で、
// 代入すると E0701". The forms that negative/closure_capture_write.onsa does not have: a captured `let`, and the
// field and element paths of a captured value, written by an assignment, passed as `inout` and used as the
// receiver of a `!` method, and a write in a closure nested in another one. A `let` written in a closure has no
// repair candidate (`fixes = 0`): declaring it with `var` leaves the E0701 of the capture, so the candidate
// would not make the program right (§18.1). One error per item (P-01).

pub fn apply(f: fn(I32) -> I32) -> I32 {
  f.(1)
}

pub fn bump(inout z: I32) {
  z = z + 1
}

pub struct C {
  n: I32,
}

impl C {
  pub fn inc(inout self) {
    self.n = self.n + 1
  }
}

pub struct Outer {
  c: C,
  k: I32,
}

// ------------------------------------------------------------------------ a captured `let`

pub fn assign_let(x: I32) -> I32 {
  let y = x + 1
  apply(fn(n) {
    y = 3 //~ E0701
    n + y
  })
}

pub fn inout_of_let(x: I32) -> I32 {
  let y = x + 1
  apply(fn(n) {
    bump(inout y) //~ E0701
    n
  })
}

pub fn bang_on_let(x: I32) -> I32 {
  let c = C { n: x }
  apply(fn(n) {
    c.inc!() //~ E0701
    n + c.n
  })
}

pub fn assign_field_of_let(x: I32) -> I32 {
  let c = C { n: x }
  apply(fn(n) {
    c.n = 3 //~ E0701
    n + c.n
  })
}

// ---------------------------------------------------------- the paths of a captured `var`

pub fn assign_field_of_var(x: I32) -> I32 {
  var c = C { n: x }
  c.n = c.n + 1
  apply(fn(n) {
    c.n = 3 //~ E0701
    n + c.n
  })
}

pub fn assign_element_of_var(x: I32) -> I32 {
  var xs = [x, x + 1]
  xs[0] = 5
  apply(fn(n) {
    xs[1] = 3 //~ E0701
    n + xs[0]
  })
}

pub fn inout_of_a_field(x: I32) -> I32 {
  var c = C { n: x }
  c.n = c.n + 1
  apply(fn(n) {
    bump(inout c.n) //~ E0701
    n
  })
}

pub fn inout_of_an_element(x: I32) -> I32 {
  var xs = [x, x + 1]
  xs[0] = 5
  apply(fn(n) {
    bump(inout xs[1]) //~ E0701
    n
  })
}

pub fn bang_on_a_field(x: I32) -> I32 {
  var o = Outer { c: C { n: x }, k: 1 }
  o.k = 2
  apply(fn(n) {
    o.c.inc!() //~ E0701
    n + o.k
  })
}

pub fn assign_a_nested_field(x: I32) -> I32 {
  var o = Outer { c: C { n: x }, k: 1 }
  o.k = 2
  apply(fn(n) {
    o.c.n = 3 //~ E0701
    n + o.k
  })
}

// ------------------------------------------------------------ a closure in a closure

pub fn captured_through_two_closures(x: I32) -> I32 {
  var y = x
  y = y + 1
  apply(fn(n) {
    apply(fn(m) {
      y = m //~ E0701
      m
    }) + n
  })
}

pub fn let_captured_through_two_closures(x: I32) -> I32 {
  let y = x + 1
  apply(fn(n) {
    apply(fn(m) {
      bump(inout y) //~ E0701
      m
    }) + n
  })
}

// The controls: what the function's own bindings may do, next to the captured values read.

pub fn own_bindings_and_reads(x: I32) -> I32 {
  let y = x + 1
  var c = C { n: x }
  c.n = c.n + 1
  apply(fn(n) {
    var k = n + y + c.n
    k = k + 1
    bump(inout k)
    var d = C { n: k }
    d.inc!()
    d.n
  })
}
