// onsa.toml
// [test]
// spec = ["§5.4", "§7", "§9.2", "§10", "§12.2"]

// W6-02 U6/t, S-1036, S-873, S-1039 (§9.2: "panic で抜ける道では、生きている値の破棄は起きない（巻き戻しは無い）。その破棄は `Alloc` に数えず（§12.2）、`Drop` も呼ばれない"; §5.4: "所有の見出し … が消費した値のうち、パターンが束縛しなかった部分（`_`、最後の
// `_` が残すフィールド、束縛の無い腕の対象）は、`let` … では文の終わりに、`match` の腕と `for` の本体ではその腕・反復の終わり … に破棄される。腕が panic で抜ければ、その破棄は起きない"): an arm whose body only panics never reaches the end of
// the arm, so what its pattern leaves unbound is not dropped, and the guard that is false lets the next arm see the value. Every function is legal and stays legal after the
// drop of a part that a pattern leaves unbound is counted: the payload of `Err(_)` of the arm that panics (the shape of the body of `unwrap`, S-873), a `_` and a literal of
// an owned head, the last `_` of a struct pattern, an or-pattern, the body of a `for` that panics, and an arm after a guard that is false (`Some(_) if c => panic("x")`,
// where the next arm moves the value on). They are the other side of the boundary of S-1036: a `let` drops at the end of the statement, so the same value is an error when
// the path goes on to a `panic` after a `let` (negative/drop_wild_let.onsa). This version reports none of them. The functions are one-liners, so that the line does not
// depend on where the drop is reported (S-783). One error per function (P-01).

pub struct K {
  b: Buf[F32],
  n: U32,
}

pub rt fn mk(n: U32) -> Str { "x" }

// ------------------------------------------------------------------ the arm panics

pub fn panic_err_buf(move r: Result[U32, Buf[F32]]) -> U32 { match move r { Ok(k) => k, Err(_) => panic("x") } }

pub rt fn rt_panic_err_buf(move r: Result[U32, Buf[F32]]) -> U32 { match move r { Ok(k) => k, Err(_) => panic("x") } }

pub fn panic_some_buf(move o: Option[Buf[F32]]) -> U32 { match move o { Some(_) => panic("x"), None => 0 } }

pub rt fn rt_panic_some_buf(move o: Option[Buf[F32]]) -> U32 { match move o { Some(_) => panic("x"), None => 0 } }

pub fn panic_wild(move o: Option[Buf[F32]]) -> U32 { match move o { _ => panic("x") } }

pub rt fn rt_panic_wild(move o: Option[Buf[F32]]) -> U32 { match move o { _ => panic("x") } }

pub fn panic_rest(move k: K) -> U32 { match move k { K { n: _, _ } => panic("x") } }

pub rt fn rt_panic_rest(move k: K) -> U32 { match move k { K { n: _, _ } => panic("x") } }

pub fn panic_or_pattern(move o: Option[Buf[F32]]) -> U32 { match move o { Some(_) | None => panic("x") } }

pub rt fn rt_panic_or_pattern(move o: Option[Buf[F32]]) -> U32 { match move o { Some(_) | None => panic("x") } }

pub fn panic_literal(n: U32) -> Str { match mk(n) { "a" => panic("x"), s => s } }

pub rt fn rt_panic_literal(n: U32) -> Str { match mk(n) { "a" => panic("x"), s => s } }

pub fn panic_tuple(move p: (Str, U32)) -> U32 { match move p { (_, _) => panic("x") } }

pub rt fn rt_panic_tuple(move p: (Str, U32)) -> U32 { match move p { (_, _) => panic("x") } }

pub fn panic_nested(move o: Option[Option[Buf[F32]]]) -> Option[Option[Buf[F32]]] { match move o { Some(Some(_)) => panic("x"), rest => rest } }

pub rt fn rt_panic_nested(move o: Option[Option[Buf[F32]]]) -> Option[Option[Buf[F32]]] { match move o { Some(Some(_)) => panic("x"), rest => rest } }

// ------------------------------------------------------------------ the body of a `for` panics

pub fn panic_for_wild(move xs: [Buf[F32]; 2]) { for _ in move xs { panic("x") } }

pub rt fn rt_panic_for_wild(move xs: [Buf[F32]; 2]) { for _ in move xs { panic("x") } }

pub fn panic_for_tuple(move ps: [(Buf[F32], U32); 2]) { for (_, _) in move ps { panic("x") } }

pub rt fn rt_panic_for_tuple(move ps: [(Buf[F32], U32); 2]) { for (_, _) in move ps { panic("x") } }

// ------------------------------------------------------------------ the guard that is false lets the next arm see the value

pub fn panic_guard_false_panics(c: Bool, move o: Option[Buf[F32]]) -> Option[Buf[F32]] { match move o { Some(_) if c => panic("x"), rest => rest } }

pub rt fn rt_panic_guard_false_panics(c: Bool, move o: Option[Buf[F32]]) -> Option[Buf[F32]] { match move o { Some(_) if c => panic("x"), rest => rest } }

pub fn panic_guard_false_moves(c: Bool, move o: Option[Buf[F32]]) -> Option[Buf[F32]] { match move o { Some(_) if c => panic("x"), Some(b) => Some(move b), None => None } }

pub rt fn rt_panic_guard_false_moves(c: Bool, move o: Option[Buf[F32]]) -> Option[Buf[F32]] { match move o { Some(_) if c => panic("x"), Some(b) => Some(move b), None => None } }

pub fn panic_guard_false_wild(c: Bool, move o: Option[Buf[F32]]) -> Option[Buf[F32]] { match move o { _ if c => panic("x"), rest => rest } }

pub rt fn rt_panic_guard_false_wild(c: Bool, move o: Option[Buf[F32]]) -> Option[Buf[F32]] { match move o { _ if c => panic("x"), rest => rest } }
