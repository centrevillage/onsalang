// onsa.toml
// [test]
// spec = ["§6.5", "§18.1"]
// fixes = 0

// W5-24 U3a/i2, S-600 and S-484 (spec §18.1: an `@` attribute after the visibility or `rt` is one E0002, whose candidate
// moves it before them; §6.5: `@fp(strict)` names what no `@fp` means and its E0005 takes it out): an attribute whose
// check after the move would take it out has no candidate to move it (moving it and then taking it out undoes the move).
// The E0002 of its place stays. One error in each unit (P-01).

pub @fp(strict) fn pub_strict() -> I32 { 1 }        //~ E0002
rt @fp(strict) fn rt_strict() -> I32 { 1 }          //~ E0002
pub rt @fp(strict) fn pub_rt_strict() -> I32 { 1 }  //~ E0002
pub @fp(strict-ftz) fn pub_ftz() -> I32 { 1 }       //~ E0002

struct P {
  x: I32,
}

impl P {
  pub @fp(strict) fn member(self) -> I32 { 1 }      //~ E0002
}
