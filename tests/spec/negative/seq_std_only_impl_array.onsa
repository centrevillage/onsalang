// onsa.toml
// [test]
// spec = ["§15.2", "§6.3", "§4.4", "§18.1"]
// fixes = 0

// S-861: the methods of the arrays are declared in std by an `impl` whose target has no name
// (`impl[T, const N: U32] [T; N]`), which §15.2 lists in the forms that only std may write. In a user's package
// the same `impl` is the E0307 of the heading: "`[T; N]` is not the name of a type declaration" (§6.3, §4.4: the
// target of an `impl` is written by the name of a type's declaration). The members are not checked (§18.1), so
// each `impl` is one unit and has one error. No candidate (`fixes = 0`).

impl[T, const N: U32] [T; N] { //~ E0307
  pub fn first_or(self, d: T) -> T {
    match self.get(0) {
      Some(v) => v,
      None => d,
    }
  }
}

impl[T: Copy, const N: U32] [T; N] { //~ E0307
  pub fn head(self) -> U32 {
    self.slice(0, 1).len()
  }
}

impl[T: ?Dup, const N: U32] [T; N] { //~ E0307
  pub fn size(self) -> U32 {
    self.len()
  }
}

impl[const N: U32] [F32; N] { //~ E0307
  pub fn total(self) -> F32 {
    0.0
  }
}
