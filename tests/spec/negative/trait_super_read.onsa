// onsa.toml
// [test]
// spec = ["§6.3", "§15.1", "§18.1"]
// fixes = 0

// The supertraits in the head of a `trait` (W5-11 U5, spec §6.3 "a trait is declared with
// `: trait + trait` after its name"; R-373): the list is read, so the unit reports the one
// error of this version, E0200 "trait definitions", and no E0002 for the colon (the colon used
// to be "expected `{`"). The list is `: trait + trait` after the name, and after the
// type parameters of a generic trait; the body may be empty. The visibility is written before
// `trait` (`pub trait`) as for a trait without a supertrait. One error in each unit.

trait Tr1: Show {                                   //~ E0200
  fn m(self) -> I32
}

pub trait Tr2: Show + Dup {                         //~ E0200
  fn m(self) -> I32
}

trait Tr3[T]: Show {                                //~ E0200
  fn m(self) -> I32
}

trait Tr4: Dup {}                                   //~ E0200

priv trait Tr5: Show + Dup + Eq {                   //~ E0200
  fn m(self) -> I32
  fn n(self) -> I32
}

pub trait Tr6[T, U]: Show {                         //~ E0200
  fn m(self) -> I32
}

// The places of the file that follow are read as usual.
fn after(x: I32) -> I32 {
  x + 1
}

fn own_error() -> I32 {
  after(1) + zz                                     //~ E0302
}
