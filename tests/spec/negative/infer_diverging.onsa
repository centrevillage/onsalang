// onsa.toml
// [test]
// spec = ["§4.7", "§7"]

// E0503: a `let` whose value diverges as a whole (S-268, §7: "初期化式の全体が上の発散する形である `let` と `var` も、発散する文である。
// ... 到達しない最初の部分は束縛で、後の文の有無によらず、パターンに E0503 を出す"). The block that returns, the `if` whose branches
// all return and the `match` whose arms all return, with a statement after the `let` and without one, with an annotation and
// in a test: the `x` is bound to a value that is never made, so the pattern is the first unreachable part, and the type that
// nothing decides (E0406, §4.7: "初期化式の全体が発散する `let` は、先に §7 の E0503 になる") is not reported.
// This file was the E0406 of S-262 (the draft of the parent, "確認だけ"): the check passed and the lowering failed inside the
// compiler (W2-06/b); S-268 made the E0503 the error of these. The forms with the candidate are in
// fixes/e0503_let_diverging_initializer.onsa, and the order against the end of the function in
// negative/e0503_before_the_end_of_function.onsa. One error per function (P-01).

pub fn a_block_that_returns() {
  let x = {   //~ E0503
    return
  }
}

pub fn both_branches_return(c: Bool) {
  let x = if c { return } else { return }   //~ E0503
}

pub fn both_branches_return_a_value(c: Bool) -> I32 {
  let x = if c { return 1 } else { return 2 }   //~ E0503
  let y = x
  3
}

pub fn every_arm_returns(o: Option[I32]) -> I32 {
  let x = match o {   //~ E0503
    Some(v) => { return v },
    None => { return 0 },
  }
  let y = x
  0
}

test "in a test" {
  let x = {   //~ E0503
    return
  }
}

// An expected type does not make the `let` reachable: the value still diverges as a whole.
pub fn annotated(c: Bool) -> I32 {
  let x: I32 = if c { return 1 } else { return 2 }   //~ E0503
  x
}

// A branch that returns takes the type of the other branch: the `let` is reached.
pub fn one_branch_returns(c: Bool) -> I32 {
  let x = if c { return 1 } else { 2 }
  x
}
