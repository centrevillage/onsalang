// onsa.toml
// [test]
// spec = ["§7", "§18.1"]

// E0002, with no candidate, for an `@` binding that has a comment in what the guard form would copy (spec §7,
// §18.1; S-251; the row `at_binding` of spec/foreign-forms.toml). The candidate writes the name on the left
// and the comparison of the right side in a guard, so a comment in the right side (after the `@`, or between the
// alternatives of its choice) would be lost; there is no candidate. The code is E0002 and the main message says
// that this `@` binding is no comparison a guard can write; the note is to say that the comment is the reason (its
// text is the implementation's, and the runner of the cases does not compare it). The comment is the marker
// itself. The main position is the `@`. One error in each declaration unit (P-01).

pub fn a_comment_after_the_at(x: I32) -> I32 {
  match x {
    k @ //~ E0002
    1 => k,
    _ => 0,
  }
}

pub fn a_comment_in_a_choice(x: I32) -> I32 {
  match x {
    k @ (1 | //~ E0002
      2) => k,
    _ => 0,
  }
}

pub fn a_comment_in_a_choice_of_ranges(x: I32) -> I32 {
  match x {
    k @ (1..<3 | //~ E0002
      7) => k,
    _ => 0,
  }
}

pub fn not_a_comparison_at_all(o: Option[I32]) -> I32 {
  match o {
    s @ Some(_) => 1,                               //~ E0002
    _ => 0,
  }
}

// A block comment (E0020 by itself, §2.1) in the right side: the `@` is the first error of the unit, and the
// error of the comment is after it, in the same unit, so it is not reported.
pub fn a_block_comment_after_the_at(x: I32) -> I32 {
  match x {
    k @ /* c */ 1 => k,                             //~ E0002
    _ => 0,
  }
}
