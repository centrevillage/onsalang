// onsa.toml
// [package]
// name = "lower_vdelay_ring_past_u32"
// edition = "2026"
//
// [targets.c]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [test]
// spec = ["§11.4", "§18.1"]

// R-501 (W7-14 U3b), E0200 from lowering: the ring of a `vdelay~` holds `MAX + 1` elements (§11.4), so an `F64` `vdelay~` whose `MAX` is the largest `U32` has a
// state of more elements than `U32` counts; this version does not support it (until the check of the size of a state, E0409, W9-04). `check` passes it: it is an error
// of the build of a target. One less (`MAX = 4294967294`, a ring of 2^32 - 1 elements) and a `delay~` of `N = 4294967295` (a ring of `N`) fit and are accepted.

pub flow too_long(x: F64 at sample) -> F64 at sample {
  vdelay~(x, 2.0, 4294967295) //~ E0200
}

pub flow one_less(x: F64 at sample) -> F64 at sample {
  vdelay~(x, 2.0, 4294967294)
}

pub flow delay_of_max(x: F64 at sample) -> F64 at sample {
  delay~(x, 4294967295)
}
