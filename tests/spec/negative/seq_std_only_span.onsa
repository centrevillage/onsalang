// onsa.toml
// [test]
// spec = ["§15.2", "§5.3", "§18.1"]
// fixes = 0

// S-861: std declares `slice` as a `target fn` that returns `Span[T]` and gives the methods of `Span[T]` by an
// `impl` whose target is `Span[T]`: forms that only std may write (§15.2). In a user's package a `Span` is
// second class (§5.3), which is not a type of a return value or a target of an `impl`: both are the E0710
// (the `impl` on its heading, the function on the return type). No candidate (`fixes = 0`). One error per
// unit (P-01).

impl[T: Copy] Span[T] { //~ E0710
  pub fn first(self) -> U32 {
    0
  }
}

impl[T: Copy] Span[T] { //~ E0710
  pub fn second(self) -> U32 {
    1
  }
}

pub fn returns_a_generic_view[T: Copy](xs: Span[T], a: U32, b: U32) -> Span[T] { //~ E0710
  xs.slice(a, b)
}

pub fn returns_a_view_of_floats(xs: Span[F32]) -> Span[F32] { //~ E0710
  xs.slice(0, 1)
}

pub fn returns_a_view_of_an_array(xs: [F32; 4]) -> Span[F32] { //~ E0710
  xs.slice(0, 2)
}
