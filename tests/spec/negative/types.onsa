// onsa.toml
// [test]
// spec = ["§3.3", "§4.4", "§4.7", "§7", "§9.1"]

// E04xx / E05xx: body type checking (§4.7, §3.3, §4.4, §7, §9.1). One error per item (P-01).
use std.array

pub fn float_literal_undecided() -> U32 {
  let a = 1.0                   //~ E0405
  2
}

pub fn integer_literal_defaults_to_i32() -> U32 {
  let a = 1
  for i in 0..<4 {
  }
  assert 1 == 1
  2
}

pub fn integer_default_out_of_range() -> U32 {
  let big = 3_000_000_000      //~ E0408
  2
}

pub fn parse[T](s: Str) -> T {
  loop_forever()
}

pub fn loop_forever[T]() -> T {
  loop_forever()
}

pub fn return_only_generic() -> I32 {
  let n = parse("3")            //~ E0406
  let _ = n
  2
}

pub fn return_only_annotated() -> I32 {
  let n: I32 = parse("3")
  n
}

pub fn out_of_range() -> U8 {
  let x: U8 = 300               //~ E0408
  x
}

pub struct P {
  x: F32,
  y: F32,
}

pub fn missing_field() -> P {
  P { x: 1.0 }                  //~ E0410
}

pub fn narrowing_cast(x: I64) -> I32 {
  x as I32                      //~ E0411
}

pub fn wrong_arity(p: P) -> F32 {
  len2(p, p)                    //~ E0412
}

pub fn len2(p: P) -> F32 {
  p.x
}

pub fn no_such_field(p: P) -> F32 {
  p.z                           //~ E0413
}

pub fn question_mismatch(o: Option[U8]) -> U8 {
  let n = o?                    //~ E0414
  n
}

pub fn not_a_place(p: P) {
  len2(p) = 1.0                 //~ E0415
}

pub fn largest[T: Ord](a: T, b: T) -> T {
  if a < b { b } else { a }
}

pub fn unsatisfied_bound() -> F32 {
  largest(1.0, 2.0)             //~ E0416
}

pub fn method_before_known(x: F32) -> F32 {
  var acc = 0.0
  let r = acc.round_f32()       //~ E0420
  acc = x
  r
}

pub fn typed_hole(x: F32, n: U32) -> F32 {
  _                             //~ E0421
}

pub enum Shape {
  Circle(F32),
  Rect(F32, F32),
}

pub fn not_exhaustive(s: Shape) -> F32 {
  match s {                     //~ E0501
    Shape.Circle(r) => r,
  }
}

pub fn refutable_let(o: Option[U8]) -> U8 {
  let Some(n) = o               //~ E0502
  n
}

pub fn shadowing(xs: [F32; 4]) -> F32 {
  for i in 0..<4 {
    let i = 1                   //~ E0304
  }
  1.0
}

pub fn mismatch() -> F32 {
  let x: F32 = true             //~ E0401
  x
}

pub fn inferred_later(xs: [F32; 4]) -> F32 {
  var acc = 0.0
  for i in 0..<4 {
    acc = acc + xs[i]
  }
  acc
}

pub fn siblings_may_reuse(xs: [F32; 4]) -> F32 {
  var s: F32 = 0.0
  for i in 0..<4 { s = s + xs[i] }
  for i in 0..<4 { s = s + xs[i] }
  s
}

pub fn closure_param_from_expected() -> [U32; 3] {
  array.from_fn(fn(i) { i + 1 })
}

pub fn exhaustive(s: Shape, o: Option[U8], b: Bool, t: (Bool, Bool)) -> U8 {
  let a = match s {
    Shape.Circle(_) => 1,
    Shape.Rect(_, _) => 2,
  }
  let c = match o {
    Some(n) => n,
    None => 0,
  }
  let d = match b {
    true => 1,
    false => 0,
  }
  let e = match t {
    (true, _) => 1,
    (false, true) | (false, false) => 0,
  }
  a + c + d + e
}
