// onsa.toml
// [test]
// spec = ["§7", "§2.4", "§18.1"]

// E0020: a string pattern with an interpolation is not a pattern. An interpolated string makes
// a new `Str` (§2.4), a value computed from a variable, and a pattern only compares a value
// with a literal, so the comparison is written as a guard: the fix candidate is `v if v ==
// "a{x}b"` (spec §7, §18.1; S-225). The diagnostic is made in the syntax stage, so it does not
// depend on the interpolated name: a name that does not exist and a field path are the same
// E0020 (a name is not resolved yet; the names with upper-case letters, a constant, a
// qualified name and a tuple index are in pattern_str_paths.onsa, which needs the
// interpolation of a name path of W3-04 as well). `{{` and `}}` are the
// escapes and make no interpolation: the strings below that hold only escapes are fine. One
// error per function (P-01).
//
// The fix candidate (`v if v == "a{x}b"`) and the note are not part of the marker, and the
// text does not say how the name of the binding is chosen, so no `fixes` case is written here.

use std.array

pub struct Tag {
  name: Str,
  id: U32,
}

// ---------------------------------------------------------------- E0020

pub fn interpolated(s: Str, x: U32) -> U32 {
  match s {
    "a{x}b" => 1,               //~ E0020
    _ => 0,
  }
}

pub fn only_the_interpolation(s: Str, x: U32) -> U32 {
  match s {
    "{x}" => 1,                 //~ E0020
    _ => 0,
  }
}

pub fn name_that_does_not_exist(s: Str) -> U32 {
  match s {
    "a{missing}b" => 1,         //~ E0020
    _ => 0,
  }
}

pub fn field_path(s: Str, t: Tag) -> U32 {
  match s {
    "a{t.id}b" => 1,            //~ E0020
    _ => 0,
  }
}

pub fn two_interpolations(s: Str, x: U32, y: U32) -> U32 {
  match s {
    "{x}-{y}" => 1,             //~ E0020
    _ => 0,
  }
}

pub fn interpolation_after_an_escape(s: Str, x: U32) -> U32 {
  match s {
    "{{a}}{x}" => 1,            //~ E0020
    _ => 0,
  }
}

pub fn second_arm(s: Str, x: U32) -> U32 {
  match s {
    "a" => 1,
    "b{x}" => 2,                //~ E0020
    _ => 0,
  }
}

pub fn inside_some(o: Option[Str], x: U32) -> U32 {
  match o {
    Some("a{x}b") => 1,         //~ E0020
    _ => 0,
  }
}

pub fn inside_a_tuple(s: Str, n: U32, x: U32) -> U32 {
  match (s, n) {
    ("a{x}", 1) => 1,           //~ E0020
    _ => 0,
  }
}

pub fn inside_a_struct(t: Tag, x: U32) -> U32 {
  match t {
    Tag { name: "a{x}", id: _ } => 1,   //~ E0020
    _ => 0,
  }
}

pub fn inside_an_alternative(s: Str, x: U32) -> U32 {
  match s {
    "a" | "b{x}" => 1,          //~ E0020
    _ => 0,
  }
}

pub fn with_a_guard(s: Str, x: U32) -> U32 {
  match s {
    "a{x}b" if x > 0 => 1,      //~ E0020
    _ => 0,
  }
}

pub fn match_as_a_statement(s: Str, x: U32) -> U32 {
  var r = 0
  match s {
    "a{x}b" => { r = 1 },       //~ E0020
    _ => { r = 0 },
  }
  r
}

pub fn match_on_a_literal(x: U32) -> U32 {
  match "abc" {
    "a{x}c" => 1,               //~ E0020
    _ => 0,
  }
}

impl Tag {
  pub fn matches(self, x: U32) -> U32 {
    match self.name {
      "n{x}" => 1,              //~ E0020
      _ => 0,
    }
  }
}

test "an interpolated string pattern in a test" {
  let x = 1
  let r = match "a1" {
    "a{x}" => 1,                //~ E0020
    _ => 0,
  }
  assert r == 1
}

pub fn in_a_closure(x: U32) -> [U32; 2] {
  array.from_fn(fn(i) {
    match "k" {
      "k{x}" => i,              //~ E0020
      _ => 0,
    }
  })
}

// ---------------------------------------------------------------- escapes only: fine

pub fn escaped_open(s: Str) -> U32 {
  match s {
    "a{{b" => 1,
    _ => 0,
  }
}

pub fn escaped_close(s: Str) -> U32 {
  match s {
    "a}}b" => 1,
    _ => 0,
  }
}

pub fn escaped_both(s: Str) -> U32 {
  match s {
    "{{x}}" => 1,
    "}}{{" => 2,
    _ => 0,
  }
}

pub fn escaped_alone(s: Str) -> U32 {
  match s {
    "{{" | "}}" => 1,
    _ => 0,
  }
}

pub fn escaped_in_some(o: Option[Str]) -> U32 {
  match o {
    Some("{{") => 1,
    _ => 0,
  }
}

pub fn plain(s: Str) -> U32 {
  match s {
    "" => 0,
    "abc" => 1,
    _ => 2,
  }
}

// The way to compare with an interpolated string is a guard. The interpolated string makes a
// `Str`, so the function needs `Alloc`.
pub fn guard_form(s: Str, x: U32) -> U32 uses {Alloc} {
  match s {
    v if v == "a{x}b" => 1,
    _ => 0,
  }
}
