// onsa.toml
// [test]
// spec = ["§7", "§4.4", "§18.1"]
// fixes = 0

// S-903 (§7, §4.4): the `_` that ignores the rest of the fields is written only as the last element of the list of a struct
// pattern, with nothing after it. The other places a `_` or a `..` could go are a pattern that cannot be read (E0002, with
// no candidate: `fixes = 0` checks that none is offered): a `_` with a `..` before or after it, and `_: a` as a field. The
// `..` that is not last is E0002 in the same way (the `..` that is last is E0020, fixes/e0020_patterns_rest*.onsa). A `_`
// that is not last and a `,` after the last `_` or `..` have a candidate (S-512, fixes/pattern_rest_comma_*.onsa). The `_` is not the `...` of the struct
// literal (§4.4; filling with the defaults and ignoring are different meanings with different marks): `...` in a pattern is
// E0002, and the `_` and the `..` in a struct literal are E0002 too. One error per function (P-01); the marker is on the
// line of the pattern or the literal, and no column is written.

pub struct Item {
  x: I32,
  y: I32,
  z: I32,
}

// ---- the `_` where it is not the last element

pub fn the_rest_is_followed_by_dots(it: Item) -> I32 {
  let Item { x: a, _, .. } = it                     //~ E0002
  a
}

pub fn the_rest_is_after_dots(it: Item) -> I32 {
  let Item { x: a, .., _ } = it                     //~ E0002
  a
}

pub fn the_rest_is_given_a_pattern(it: Item) -> I32 {
  let Item { _: a } = it                            //~ E0002
  a
}

pub fn the_rest_is_given_a_pattern_after_a_field(it: Item) -> I32 {
  let Item { x: a, _: b } = it                      //~ E0002
  a + b
}

// ---- the dots in a pattern

pub fn three_dots_in_a_pattern(it: Item) -> I32 {
  let Item { x: a, ... } = it                       //~ E0002
  a
}

pub fn three_dots_alone_in_a_pattern(it: Item) -> I32 {
  match it {
    Item { ... } => 1,                              //~ E0002
  }
}

pub fn two_dots_that_are_not_last(it: Item) -> I32 {
  let Item { .., x: a } = it                        //~ E0002
  a
}

// ---- the marks of a pattern in a struct literal

pub fn the_rest_in_a_literal(a: I32) -> Item {
  Item { x: a, _ }                                  //~ E0002
}

pub fn the_rest_alone_in_a_literal() -> Item {
  Item { _ }                                        //~ E0002
}

pub fn two_dots_in_a_literal(a: I32) -> Item {
  Item { x: a, .. }                                 //~ E0002
}

// ---- the right forms

pub fn fine(it: Item) -> I32 {
  let Item { x: a, _ } = it
  a
}
