// onsa.toml
// [test]
// spec = ["§11.5", "§18.1"]

// E0200 while the flow syntax is written in the terms of this version's checks (W3-10, K-08): the
// argument of `unwrap_or` is evaluated only when the `Option` is `None` (the lowering of the
// method), so a flow instance, a delay or a `par` there would advance on those samples only. This
// version says E0200 rather than read the program in another meaning. One error per flow (P-01).
//
// W5-03 removes this file: `unwrap_or` is no method of the spec (§4.1, R-96), and after W5-03 it is
// E0413.

pub flow acc(x: F32 at sample) -> F32 at sample {
  let y = x + prev~(^y)
  y
}

pub flow instance_in_unwrap_or(x: F32 at sample) -> F32 at sample {
  let o: Option[F32] = if x > 2.0 { Some(x) } else { None }
  o.unwrap_or(acc~(1.0)) //~ E0200
}

pub flow delay_in_unwrap_or(x: F32 at sample) -> F32 at sample {
  let o: Option[F32] = if x > 2.0 { Some(x) } else { None }
  o.unwrap_or(prev~(x)) //~ E0200
}

pub flow par_in_unwrap_or(x: F32 at sample) -> F32 at sample {
  let o: Option[F32] = if x > 2.0 { Some(x) } else { None }
  o.unwrap_or((par i in 0..<2 { x })[0]) //~ E0200
}

// A stateful node bound before the call is fine: it advances every sample.
pub flow fine(x: F32 at sample) -> F32 at sample {
  let o: Option[F32] = if x > 2.0 { Some(x) } else { None }
  let a = acc~(1.0)
  o.unwrap_or(a)
}
