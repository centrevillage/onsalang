// onsa.toml
// [test]
// spec = ["§18.1"]

// A declaration with a syntax error is still seen by the name resolution when its name could
// be read, and what could not be read is an error type that raises no diagnostic where it is
// used (§18.1, R-71). No `E0302` appears in the functions that use a failed declaration.

// A function with a syntax error in its signature.
pub fn sig_broken(a: ) -> I32 {         //~ E0002
  1
}

pub fn calls_sig_broken() -> I32 {
  sig_broken(1) + 1
}

// A function with a syntax error in its body.
pub fn body_broken() -> I32 {
  let = 2                       //~ E0002
  1
}

pub fn calls_body_broken() -> I32 {
  body_broken() + 1
}

// A call chain through failed functions: the nearest user is not reported either.
pub fn calls_both() -> I32 {
  calls_sig_broken() + calls_body_broken() + body_broken()
}

// A struct with a syntax error in a field. The fields that could be read stay usable, and
// the type can be named. (What a use of the field that could not be read gives is not written
// here: the spec says it is an error type, but not whether the field still exists by name.)
pub struct BrokenFields {
  x: I32,
  y: ,                          //~ E0002
}

pub fn takes_broken_struct(p: BrokenFields) -> I32 {
  p.x
}

// An enum with a syntax error in a variant.
pub enum BrokenMode {
  On,
  Off(,),                       //~ E0002
}

pub fn mode_on() -> BrokenMode {
  BrokenMode.On
}

pub fn takes_broken_enum(m: BrokenMode) -> I32 {
  1
}

// A constant with a syntax error in its initializer.
const BROKEN_CONST: I32 = )     //~ E0002

pub fn uses_broken_const() -> I32 {
  BROKEN_CONST + 1
}

// An impl: a member with a syntax error is a unit of its own, and the other members and the
// callers of it are not affected.
pub struct Holder {
  v: I32,
}

impl Holder {
  pub fn good(self) -> I32 {
    self.v
  }

  pub fn broken(self) -> I32 {
    let = 1                     //~ E0002
    self.v
  }

  pub fn broken_sig(self, a: ) -> I32 {   //~ E0002
    self.v
  }
}

pub fn calls_good(h: Holder) -> I32 {
  h.good()
}

pub fn calls_broken_member(h: Holder) -> I32 {
  h.broken()
}

pub fn calls_broken_sig_member(h: Holder) -> I32 {
  h.broken_sig(1)
}

// A failed generic function is still a name.
pub fn generic_broken[T](x: T) -> T {
  let = x                       //~ E0002
  x
}

pub fn calls_generic_broken() -> I32 {
  generic_broken(1)
}

// A failed function used from inside a closure and a branch.
pub fn nested_use(c: Bool) -> I32 {
  let f = fn(x: I32) -> I32 { body_broken() + x }
  if c { body_broken() } else { sig_broken(2) }
}
