// onsa.toml
// [test]
// spec = ["§7", "§3.1", "§18.1"]
// fixes = 0

// E0002, with no candidate, for a range pattern whose end cannot be read as an expression (S-428, spec §7, §18.1): a token of the end that
// is an error of the lexical stage (E0001: `3abc`, a number that runs into a word), and an open `(`. The guard form copies
// the end, and what does not read as an expression cannot be copied. These are not the forms of range_pattern_foreign_end_forms.onsa
// (`3u8`, `+3`, `017`), which read. The nothing, `if`, `{` and operator ends are in range_pattern_unreadable_end.onsa. `fixes = 0` checks
// that no candidate is offered. One error per function (P-01); the open `(` is the last, because it takes the lines after it.

pub fn a_word_after_the_digits(x: I32) -> I32 {
  match x {
    1..<3abc => 1,                                  //~ E0002
    _ => 0,
  }
}

pub fn a_word_after_the_digits_closed(x: I32) -> I32 {
  match x {
    1..=3abc => 1,                                  //~ E0002
    _ => 0,
  }
}

pub fn a_word_after_the_digits_one_sided(x: I32) -> I32 {
  match x {
    ..<3abc => 1,                                   //~ E0002
    _ => 0,
  }
}

pub fn a_word_after_the_digits_in_some(o: Option[I32]) -> I32 {
  match o {
    Some(1..<3abc) => 1,                            //~ E0002
    _ => 0,
  }
}

pub fn an_open_parenthesis(x: I32) -> I32 {
  match x {
    1..<(3 => 1,                                    //~ E0002
    _ => 0,
  }
}
