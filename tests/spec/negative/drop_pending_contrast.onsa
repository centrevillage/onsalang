// onsa.toml
// [test]
// spec = ["§3.5", "§5.2", "§8.1", "§9.1", "§10", "§12.2"]

// W6-02 U3/t, R-32 (§3.5, §5.2, §9.1, §12.2): the contrasts of negative/drop_pending.onsa. Every function is legal and stays legal after the value that waits
// for the operands after it is dropped where a `?` returns: a waiting value that is Copy (`Some((n, r?))`) or that is only borrowed (a borrowed argument consumes
// nothing, so nothing waits), a call or a literal with no `?` (nothing can leave), a `?` after the owned value is consumed by a statement before (`sink(move b)`),
// and a function with `uses {Alloc}` (the drop is allowed). This version already accepts all of these. The helper `sink` is an `rt` function that drops its argument,
// so its own E0901 is reported (the same as negative/drop_for_one_path.onsa). The functions with two statements are on several lines (no error is expected, so
// the line does not matter, S-783).

pub struct Holder {
  buf: Buf[F32],
  gain: F32,
}

pub rt fn sink(move b: Buf[F32]) {}   //~ E0901

pub rt fn wrap(move b: Buf[F32], n: U32) -> Option[Buf[F32]] { Some(move b) }

pub rt fn len_of(b: Buf[F32], n: U32) -> U32 { n }

pub fn wrap_alloc(move b: Buf[F32], n: U32) -> Option[Buf[F32]] uses {Alloc} { Some(move b) }

impl Holder {
  pub rt fn absorb(move self, n: U32) -> Option[Holder] { Some(move self) }
}

// ------------------------------------------------------------------ the value that waits is Copy or borrowed

pub rt fn copy_in_tuple(n: U32, r: Option[U32]) -> Option[(U32, U32)] { Some((n, r?)) }

pub rt fn copy_in_struct(g: F32, r: Option[F32]) -> Option[(F32, F32)] { Some((g, r?)) }

pub rt fn copy_in_call(n: U32, r: Option[U32]) -> Option[U32] { Some(len_of_pair(n, r?)) }

pub rt fn len_of_pair(a: U32, b: U32) -> U32 { a }

pub rt fn borrowed_in_call(r: Option[U32], b: Buf[F32]) -> Option[U32] { Some(len_of(b, r?)) }

pub rt fn borrowed_in_tuple(r: Option[U32], b: Buf[F32]) -> Option[(U32, U32)] { Some((b.len(), r?)) }

pub rt fn borrowed_receiver(r: Option[U32], h: Holder) -> Option[U32] { Some(len_of(h.buf, r?)) }

// ------------------------------------------------------------------ nothing leaves, or nothing is owned any more

pub rt fn no_try(move b: Buf[F32]) -> Option[Option[Buf[F32]]] { Some(wrap(move b, 1)) }

pub rt fn no_try_tuple(move b: Buf[F32]) -> Option[(Buf[F32], U32)] { Some((move b, 1)) }

pub rt fn no_try_receiver(move h: Holder) -> Option[Option[Holder]] { Some(h.absorb(1)) }

pub rt fn consumed_before(r: Option[U32], move b: Buf[F32]) -> Option[U32] {
  sink(move b)
  Some(len_of_pair(1, r?))
}

// ------------------------------------------------------------------ `uses {Alloc}`: the drop of the value that waits is allowed

pub fn alloc_call(r: Option[U32], move b: Buf[F32]) -> Option[Option[Buf[F32]]] uses {Alloc} { Some(wrap_alloc(move b, r?)) }

pub fn alloc_tuple(r: Option[U32], move b: Buf[F32]) -> Option[(Buf[F32], U32)] uses {Alloc} { Some((move b, r?)) }

pub fn alloc_array(move r: Option[Buf[F32]], move b: Buf[F32]) -> Option[[Buf[F32]; 2]] uses {Alloc} { Some([move b, r?]) }

pub fn alloc_struct(r: Option[F32], move b: Buf[F32]) -> Option[Holder] uses {Alloc} { Some(Holder { buf: move b, gain: r? }) }

pub fn alloc_receiver(r: Option[U32], move h: Holder) -> Option[Option[Holder]] uses {Alloc} { Some(h.absorb(r?)) }

pub fn alloc_result(r: Result[U32, U32], move b: Buf[F32]) -> Result[Option[Buf[F32]], U32] uses {Alloc} { Ok(wrap_alloc(move b, r?)) }
