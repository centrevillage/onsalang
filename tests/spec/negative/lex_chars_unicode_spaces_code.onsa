// onsa.toml
// [test]
// spec = ["§2.5", "§2.3", "§18.1"]

// (S-201, S-89.) E0001: outside a comment and a string, the Unicode spaces (no-break space and the others) are E0001 (§2.5: "コメントと文字列の外では、その他の Unicode の
// 空白（NBSP など）と BOM も E0001"; §2.3: a name is ASCII letters, digits and `_`, anything else is
// E0001). The same characters inside a comment or a string are fine (lex/chars_allowed.onsa). One
// error per function (P-01); each function is named by the code point, the character is written
// raw in the file.
// The diagnostic of such a character has no `found` text in the check of the case runner today (the span is a space, §18.1: `found` is not written when the range is only white space): see the report of W3-04/t.

pub fn u00a0_no_break_space() -> I32 {
  1  + 2  //~ E0001
}

pub fn u00a0_no_break_space_in_a_name(a: I32) -> I32 {
  a   //~ E0001
}

