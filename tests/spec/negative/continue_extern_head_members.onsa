// onsa.toml
// [test]
// spec = ["§18.1", "§14.1", "§15.1"]
// fixes = 0

// The members of an `extern` block whose head cannot be read (W5-11 U4; `extern "C" {`). The
// head is one E0002 (§18.1, S-477) and the members are read on in the block, which is one unit:
// a member whose own text is wrong (`fn c_abs(x: ) -> I32`) raises no error of its own (the
// unit reports its first error only), and the members after it are still read, so their names
// are names of the module. One error in each block.

extern "C" {                                        //~ E0002 @1
  fn c_abs(x: ) -> I32
  fn c_after_error(x: I32) -> I32
  type RawAfterError
}

extern "C" {                                        //~ E0002 @1
  type RawFirst
  fn c_with_type(r: RawFirst) -> I32
  fn c_last(x: I32) -> I32
}

extern "C" {                                        //~ E0002 @1
  /// Documents the function.
  fn c_documented(x: I32) -> I32
}

fn calls() -> I32 {
  c_after_error(1) + c_last(2) + c_documented(3)
}

fn takes(a: RawAfterError, b: RawFirst) -> I32 {
  c_with_type(b) + 1
}

fn nested(c: Bool) -> I32 {
  let f = fn(x: I32) -> I32 { c_after_error(x) + c_last(x) }
  if c { f.(1) } else { c_documented(c_last(2)) }
}

// A real error of the module is still reported.
fn own_error() -> I32 {
  c_last(1) + zz                                    //~ E0302 @15
}

fn too_many_arguments(a: RawAfterError) -> I32 {
  takes(a, a, a)                                    //~ E0412
}
