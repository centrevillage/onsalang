// onsa.toml
// [test]
// spec = ["§5.2", "§5.3", "§5.4"]
// fixes = 0

// S-1115 (§5.2) and its supplement B2, the readings of the places that the first tests found open (W7-12 U2c1, the parent's readings): the judgment is "末尾に書いた式が Copy でない値で、その場所の根が、
// その腕・ブロックの中で宣言した束縛 … なら、置けない（E0716）" and "束縛の型は見ない". (1) A binding that is a `Dup` value and not `Copy` (`Str`) is not `Copy`, so the binding itself at a
// borrowed argument is an E0716 as a `Buf` is (the arm binding of `match move o` too). (2) The binding of an arm of a `match` on a place whose value is `Copy` (`o: Option[[F32; 4]]`) is the value taken when it
// is bound ("Copy の借用束縛は、束縛した時点の値を持つ", §5.4), so it is not derived from the place and its part view is a view of the storage of the arm: E0716 at the tail that is the view, at an argument and
// at the heading of a `for` and a `match`. A binding derived from it (`let s = b.slice(0, 2)` of the arm, then `s` at the tail) is rooted at the binding of the arm ("派生した借用束縛は派生元を根とする"): E0716 at
// the tail `s`. (3) The receiver is an argument ("受け手は `self` の引数", §5.3), so the tails of a receiver that is not a view count as the places of the call (the E0702 with an `inout` of the same call). The
// error is at the tail expression (the line of the view or of the binding), no repair candidate (`fixes = 0`). One error per function (P-01). The tails that stay (the binding of an arm of a
// `match` on a place whose value is not `Copy`, a `Copy` binding itself, a binding that needs no drop) are in values/tail_binding_scope_ok.onsa, values/tail_binding_scope_reads_ok.onsa and
// values/tail_binding_scope_nodrop_ok.onsa.

pub struct W {
  a: [F32; 4],
}

impl W {
  pub fn m(self, inout o: W) {}
}

pub fn take(s: Span[F32]) -> F32 {
  s[0]
}

pub fn hs(a: Str) -> U32 {
  a.len()
}

pub fn mks() -> Str {
  "a"
}

// ---------------------------------------------------------- (1) a `Dup` value that is not `Copy`

pub fn a_str_of_the_block() -> U32 uses {Alloc} {
  hs({
    let t = mks()
    t //~ E0716
  })
}

pub fn a_str_of_an_if(c: Bool, s: Str) -> U32 uses {Alloc} {
  hs(if c {
    var t: Str = mks()
    t //~ E0716
  } else {
    s
  })
}

pub fn a_str_of_the_arm_that_owns_it(move o: Option[Str], s: Str) -> U32 uses {Alloc} {
  hs(match move o { Some(b) => b, None => s }) //~ E0716
}

pub fn a_str_of_a_call_result(s: Str) -> U32 uses {Alloc} {
  hs(match Some(mks()) { Some(b) => b, None => s }) //~ E0716
}

// --------------------------------------------- (2) the binding of an arm of a `Copy` value, at an argument

pub fn copy_arm_some(o: Option[[F32; 4]], y: [F32; 4]) -> F32 {
  take(match o { Some(b) => b.slice(0, 2), None => y.slice(0, 2) }) //~ E0716
}

pub fn copy_arm_some_when_it_is_the_last(o: Option[[F32; 4]], y: [F32; 4]) -> F32 {
  take(match o { None => y.slice(0, 2), Some(b) => b.slice(1, 3) }) //~ E0716
}

pub fn copy_arm_ok(o: Result[[F32; 4], U32], y: [F32; 4]) -> F32 {
  take(match o { Ok(b) => b.slice(0, 2), Err(_) => y.slice(0, 2) }) //~ E0716
}

pub fn copy_arm_a_part_of_a_tuple(o: ([F32; 4], U32), y: [F32; 4]) -> F32 {
  take(match o { (a, _) => a.slice(0, 2) }) //~ E0716
}

pub fn copy_arm_a_view_of_a_view(o: Option[[F32; 4]], y: [F32; 4]) -> F32 {
  take(match o { Some(b) => b.slice(0, 3).slice(0, 2), None => y.slice(0, 2) }) //~ E0716
}

pub fn copy_arm_of_a_variable(c: Bool, y: [F32; 4]) -> F32 {
  var o: Option[[F32; 4]] = Some(y)
  if c {
    o = None
  }
  take(match o { Some(b) => b.slice(0, 2), None => y.slice(0, 2) }) //~ E0716
}

pub fn copy_arm_in_a_nested_if(o: Option[[F32; 4]], c: Bool, y: [F32; 4]) -> F32 {
  take(match o {
    Some(b) => if c { b.slice(0, 2) } else { y.slice(0, 2) }, //~ E0716
    None => y.slice(0, 2),
  })
}

// ------------------------------------------- (2) the same at the heading of a `for` and of a `match`

pub fn for_copy_arm(o: Option[[F32; 4]], y: [F32; 4]) -> F32 {
  var r: F32 = 0.0
  for v in (match o { Some(b) => b.slice(0, 2), None => y.slice(0, 2) }) { //~ E0716
    r = r + v
  }
  r
}

pub fn match_copy_arm(o: Option[[F32; 4]], y: [F32; 4]) -> F32 {
  match (match o { Some(b) => b.slice(0, 2), None => y.slice(0, 2) }) { //~ E0716
    s => take(s),
  }
}

// ---------------------------- (2) a binding derived from the binding of an arm, at the tail of the arm

pub fn derived_view_of_a_copy_arm_binding(o: Option[[F32; 4]], y: [F32; 4]) -> F32 {
  take(match o {
    Some(b) => {
      let s = b.slice(0, 2)
      s //~ E0716
    },
    None => y.slice(0, 2),
  })
}

pub fn derived_view_of_a_derived_view(o: Option[[F32; 4]], y: [F32; 4]) -> F32 {
  take(match o {
    Some(b) => {
      let s = b.slice(0, 3)
      let u = s.slice(0, 2)
      u //~ E0716
    },
    None => y.slice(0, 2),
  })
}

pub fn derived_view_at_the_heading(o: Option[[F32; 4]], y: [F32; 4]) -> F32 {
  var r: F32 = 0.0
  for v in (match o {
    Some(b) => {
      let s = b.slice(0, 2)
      s //~ E0716
    },
    None => y.slice(0, 2),
  }) {
    r = r + v
  }
  r
}

// ------------------------------------------------------ (3) the receiver that is not a view

pub fn receiver_places_overlap(c: Bool, inout w: W, u: W) {
  (if c { w } else { u }).m(inout w) //~ E0702
}

pub fn receiver_block_places_overlap(inout w: W) {
  ({ w }).m(inout w) //~ E0702
}

// ------------------- (4) an element of a planar literal and a field of a generated literal, the parent's readings
// The element of a planar array literal and the field of a literal of a generated `In` are each an argument of their own (S-196, §5.3, §11.6), so the tail of an `if` put
// there is at a borrowed argument: the view of the binding of its arm is an E0716.

pub fn take2(xs: [Span[F32]; 2]) -> F32 {
  xs[0][0]
}

pub struct Stereo {
  l: F32,
  r: F32,
}

pub flow pair(l: F32 at sample, r: F32 at sample) -> Stereo at sample {
  Stereo { l: l, r: r }
}

pub fn useit(i: pair.In) {}

pub fn planar_element_if_view(c: Bool, y: [F32; 4]) -> F32 {
  take2([if c {
    var t: [F32; 4] = [1.0; 4]
    t.slice(0, 2) //~ E0716
  } else {
    y.slice(0, 2)
  }, y.slice(0, 2)])
}

pub fn generated_field_if_view(c: Bool, y: [F32; 4]) {
  useit(pair.In { l: if c {
    var t: [F32; 4] = [1.0; 4]
    t.slice(0, 2) //~ E0716
  } else {
    y.slice(0, 2)
  }, r: y.slice(0, 2) })
}

// ------------- (5) a `Copy` binding of a borrowed `Copy` array, the parent's reading
// `let b = x` of a `Copy` array holds the value taken when it is bound (§5.4, §5.2), not derived from `x`: its view at the tail of the block is an E0716, as
// the binding of an arm is in (2).

pub fn copy_binding_of_an_argument_view_at_an_argument(x: [F32; 4]) -> F32 {
  take({
    let b = x
    b.slice(0, 2) //~ E0716
  })
}

pub fn copy_binding_of_an_argument_view_at_a_let(x: [F32; 4]) -> F32 {
  let s = {
    let b = x
    b.slice(0, 2) //~ E0716
  }
  take(s)
}
