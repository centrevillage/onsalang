// onsa.toml
// [package]
// name = "flow_gen_bind_planar_inout_index"
// edition = "2026"
//
// [targets.c]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [test]
// spec = ["§3.5", "§5.3", "§11.6", "§18.1"]

// R-433, S-218 (b) (§3.5, §5.3, §11.6), E0200 from lowering: the field of an `inout` literal of a generated `Out` is an
// argument of its own (§11.6: "引数の位置に struct リテラルを書いて作り、排他性はフィールドの場所ごとに検査する（`inout [a, b]` と
// 同じ）"), so a planar field `aux: [Span[F32]; 2]` given an array of arrays whose index has an effect (a call) is the
// E0200 of the planar `inout` argument written directly (negative/lower_planar_inout_index.onsa): the index is evaluated
// once (§3.5), so it would be bound before the argument, and an `inout` argument is a place. In parentheses and next to
// a borrowed literal it is the same. An index without an effect (`i + 1`, `min(j, 1)`) stays in the place and is
// accepted, and a borrowed literal of a generated `In` takes an index with an effect (the last two functions, with no
// error). The last three of the errors are forms that the grid of the fix (W7-12 U2b fix 1, seed 20261117) drew.

use std.math.min

pub struct Bus {
  main: F32,
  aux: [F32; 2],
}

pub flow bus(m: F32 at sample, n: F32 at sample) -> Bus at sample {
  Bus { main: m, aux: [n + 1.0, m + 2.0] }
}

pub struct Wide {
  a: F32,
  b: F32,
}

pub flow spread(x: [F32; 2] at sample, m: F32 at sample) -> Wide at sample {
  Wide { a: x[0] + m, b: x[1] + m }
}

fn next(inout n: U32) -> U32 {
  n = n + 1
  n - 1
}

fn pure_next(i: U32) -> U32 {
  i
}

fn write_bus(inout o: bus.Out) {
  o.main[0] = 1.0
  o.aux[1][0] = 2.0
}

fn read_write(i: spread.In, inout o: bus.Out) {
  o.main[0] = i.x[0][0]
}

fn read_spread(i: spread.In) -> F32 {
  i.x[1][0] + i.m[0]
}

pub fn by_call(inout m: [F32; 3], inout g: [[[F32; 3]; 2]; 2]) {
  var i: U32 = 0
  write_bus(inout bus.Out { main: m, aux: g[next(inout i)] }) //~ E0200
}

pub fn by_nested_call(inout m: [F32; 3], inout h: [[[[F32; 3]; 2]; 2]; 2]) {
  var i: U32 = 0
  write_bus(inout bus.Out { main: m, aux: h[0][next(inout i)] }) //~ E0200
}

pub fn by_call_in_sum(inout m: [F32; 3], inout g: [[[F32; 3]; 2]; 2]) {
  var i: U32 = 0
  write_bus(inout (bus.Out { main: m, aux: g[next(inout i) + 0] })) //~ E0200
}

pub fn by_a_pure_call(inout m: [F32; 3], inout g: [[[F32; 3]; 2]; 2], i: U32) {
  write_bus(inout bus.Out { main: m, aux: g[pure_next(i)] }) //~ E0200
}

pub fn drawn_slice_and_nested(inout z: [F32; 4], inout h: [[[[F32; 3]; 2]; 2]; 2], i: U32) {
  var j: U32 = 0
  write_bus(inout bus.Out { main: z.slice(0, next(inout j)), aux: h[0][pure_next(i)] }) //~ E0200
}

pub fn drawn_in_parentheses(inout g: [[[F32; 3]; 2]; 2], inout h: [[[[F32; 3]; 2]; 2]; 2], i: U32) {
  write_bus(inout (bus.Out { main: g[0][pure_next(i)], aux: h[pure_next(i)][0] })) //~ E0200
}

pub fn drawn_next_to_a_borrowed_literal(
  g: [[[F32; 3]; 2]; 2],
  m2: [[F32; 3]; 2],
  inout w: [F32; 4],
  inout h: [[[[F32; 3]; 2]; 2]; 2],
  i: U32,
) {
  read_write(spread.In { x: g[i], m: m2[i] }, inout bus.Out { main: w, aux: h[pure_next(i)][0] }) //~ E0200
}

pub fn without_effect(
  inout m: [F32; 3],
  inout g: [[[F32; 3]; 2]; 2],
  inout h: [[[[F32; 3]; 2]; 2]; 2],
  i: U32,
  j: U32,
) {
  write_bus(inout bus.Out { main: m, aux: g[i + 1] })
  write_bus(inout bus.Out { main: m, aux: h[i][min(j, 1)] })
}

pub fn a_borrowed_literal_takes_an_index_with_an_effect(m: [F32; 3], g: [[[F32; 3]; 2]; 2]) -> F32 {
  var i: U32 = 0
  read_spread(spread.In { x: g[next(inout i)], m: m })
}
