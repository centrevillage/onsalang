use kp.{a, b, when, c}  //~ E0200 @15

use kp.{a, b, reset_if, c}  //~ E0200 @15

use kp.{a, b, ser, c}  //~ E0200 @15

// ---- after a `.` the word is a name: no field of that name (E0413), not the E0200 of the syntax stage

pub fn after_dot_clock(h: Holder) -> I32 {
  h.clock  //~ E0413
}

pub fn after_dot_when(h: Holder) -> I32 {
  h.when  //~ E0413
}

pub fn after_dot_reset_if(h: Holder) -> I32 {
  h.reset_if  //~ E0413
}

pub fn after_dot_ser(h: Holder) -> I32 {
  h.ser  //~ E0413
}

pub fn after_dot_chain_clock(h: Holder) -> I32 {
  h.a.clock  //~ E0413
}

pub fn after_dot_chain_when(h: Holder) -> I32 {
  h.a.when  //~ E0413
}

pub fn after_dot_chain_reset_if(h: Holder) -> I32 {
  h.a.reset_if  //~ E0413
}

pub fn after_dot_chain_ser(h: Holder) -> I32 {
  h.a.ser  //~ E0413
}
