// onsa.toml
// [test]
// spec = ["§2.2", "§2.3", "§11.3", "§18.1"]

// (S-169, S-279, S-371.) E0200: `clock`, `when`, `reset_if` and `ser` are reserved words (§2.2). They
// cannot be the name of a declaration, and this version does not read them as syntax either: the
// error is E0200 at the place the word stands (the marker has the column of the word), in the
// syntax stage (so `onsa fmt` stops at it, §18.2) and not the E0302 of an unknown name. After a `.`
// and at the head of a `use` path the word is read as a name like the other keywords (a later stage
// says E0413 for `s.clock`; the module `clock.onsa` is in packages/reserved_word_modules). The
// words are tried one by one in each place (the four groups below), one error per function or
// declaration (P-01). A name that only starts with a reserved word (`clock_rate`, `serial`) is an
// ordinary name (lex/ident_ascii_ok.onsa).

pub struct Holder {
  a: I32,
}

