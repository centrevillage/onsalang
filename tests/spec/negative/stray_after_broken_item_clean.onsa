// onsa.toml
// [test]
// spec = ["§18.1", "§2.4"]

// The boundary of R-421 (§18.1): the extra token after a function that is right is reported, as it was before (the function
// has no error, the `0o19` is its own unit with E0001).

pub fn g(x: I32) -> I32 {
  x
}

0o19                                                //~ E0001

pub fn f() -> I32 {
  1
}
