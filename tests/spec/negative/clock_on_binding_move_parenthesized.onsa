// onsa.toml
// [test]
// spec = ["§5.2", "§11.3", "§18.1"]
// fixes = 0

// E0002, with no candidate, for a `move` in parentheses (spec §5.2, §11.3, §18.1; S-381): the operand of a `move` is
// a postfix expression, and a marked expression is written as it stands (§5.2: it can be in parentheses only as an
// element of a tuple of two or more), so `(move a)` cannot be written. This is why the binding
// `let y: F32 at sample = move a` of a flow has no candidate that moves the clock after the value
// (clock_on_binding_move_flow.onsa), where `(move a) at sample` is the form the candidate would have to write.
// One error in each declaration unit (P-01).

pub flow parenthesized_move(a: F32 at sample) -> F32 at sample {
  let y: F32 = (move a) at sample                   //~ E0002
  y
}

pub flow parenthesized_move_alone(a: F32 at sample) -> F32 at sample {
  let y = (move a)                                  //~ E0002
  y
}

pub fn parenthesized_move_in_a_fn(x: I32) -> I32 {
  let y = (move x)                                  //~ E0002
  y
}
