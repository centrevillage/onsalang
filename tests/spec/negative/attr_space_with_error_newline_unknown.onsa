// onsa.toml
// [test]
// spec = ["§2.5", "§6.5", "§18.1"]
// fixes = 0

// S-959 and S-957 (W5-11 U10d2, §2.5, §6.5, §18.1): a line break after the `@` of an attribute (S-957) whose name is not in
// the list of §6.5 reports the E0005 of the name, with no candidate (the name of the attribute meant is not one), as the
// space on one line does (attr_space_with_error_no_candidate.onsa). The line break is not reported (S-959). The main
// position is the attribute, from the `@`; the text does not say more of the line, and this is the reading of the parent.
// One error per declaration unit (P-01).

@   //~ E0005 @1
  foo
pub fn an_unknown_name(x: F32) -> F32 {
  x
}

@   //~ E0005 @1
// the name of the attribute
  inline
pub fn a_comment_line_between(x: F32) -> F32 {
  x
}
