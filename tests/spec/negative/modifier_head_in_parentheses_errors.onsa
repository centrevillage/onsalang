// onsa.toml
// [test]
// spec = ["§11.10", "§11.4", "§2.6", "§18.1"]

// S-1181 (§11.10): a head in parentheses is read through them, so its errors are those of the form without them
// (the values are in flow_semantics/modifier_head_in_parentheses.onsa): a value in parentheses is no instance and takes
// no modifier (E0812, no candidate), a built-in delay takes no `.down~` (E0812), a name out of the list is E0812, and a
// modifier with no `~` is the E0811 of §11.10 with the candidate that adds it. One error in each unit.

flow lp(x: F32 at sample) -> F32 at sample {
  prev~(x)
}

pub flow a_value(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  (lp~(x) + 1.0).when~(c)                           //~ E0812
}

pub flow a_delay(x: F32 at sample) -> F32 at sample {
  (prev~(x)).down~(2) at sample                     //~ E0812
}

pub flow not_listed(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  ((lp~(x))).stop~(c)                               //~ E0812
}

pub flow no_tilde(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  (lp~(x)).when(c)                                  //~ E0811
}
