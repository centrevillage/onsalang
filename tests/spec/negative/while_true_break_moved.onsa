// onsa.toml
// [test]
// spec = ["§5.2", "§7", "§8.1", "§10", "§12.2"]

// W6-02 U3/t, S-1042, R-32 (§7: "`break` を含む `while true` を抜けるのは `break` だけで、条件が偽になって抜ける道は無い。ループの後の値の状態（移した値、破棄、§5.2・§12.2）は `break` の
// 時点の状態から決まる（ループの中で移してから `break` した値は、ループの後では移した後である）"): after a `while true` whose body moves a local and then leaves by a `break`, the
// local is moved, so the function drops nothing at its end and a moved `var` that the body gives a new value before the `break` is alive after the loop (no E0704). The
// loops are on several lines (a `break` after a statement), and no error is expected there, so the line of a drop does not matter (S-783). This version counts the path on
// which the condition is false after such a loop, so it reports an E0601 or an E0901 for the local that the body moved (the local looks alive there) and an E0704 for the `var`
// that the body gave a new value (the `var` looks moved there). The loops that stay the same (a condition that is not the literal `true`, the read after the move) are in
// negative/while_true_break_contrast.onsa. The helper `sink` is an `rt` function that drops its argument, so its own E0901 is reported (the same as
// negative/drop_for_one_path.onsa).

pub struct Holder {
  buf: Buf[F32],
  gain: F32,
}

pub rt fn sink(move b: Buf[F32]) {}   //~ E0901

// ------------------------------------------------------------------ the body moves the local and breaks

pub fn move_then_break(move a: Buf[F32]) {
  while true {
    sink(move a)
    break
  }
}

pub rt fn rt_move_then_break(move a: Buf[F32]) {
  while true {
    sink(move a)
    break
  }
}

pub rt fn rt_parenthesized(move a: Buf[F32]) {
  while (true) {
    sink(move a)
    break
  }
}

pub fn move_in_the_branch_that_breaks(c: Bool, move a: Buf[F32]) {
  while true {
    if c {
      sink(move a)
      break
    }
  }
}

pub rt fn rt_move_in_the_branch_that_breaks(c: Bool, move a: Buf[F32]) {
  while true {
    if c {
      sink(move a)
      break
    }
  }
}

pub rt fn rt_continue_or_break(c: Bool, move a: Buf[F32]) {
  while true {
    if c {
      sink(move a)
      break
    } else {
      continue
    }
  }
}

pub rt fn rt_break_in_an_arm(n: U32, move a: Buf[F32]) {
  while true {
    match n {
      0 => {
        sink(move a)
        break
      },
      _ => {}
    }
  }
}

pub fn two_locals(move a: Buf[F32], move b: Buf[F32]) {
  while true {
    sink(move a)
    sink(move b)
    break
  }
}

pub rt fn rt_a_struct(move h: Holder) {
  while true {
    let Holder { buf: b, gain: _ } = move h
    sink(move b)
    break
  }
}

// ------------------------------------------------------------------ the moved `var` gets a new value before the `break` and is read after the loop

pub fn new_value_then_break(move a: Buf[F32]) -> Buf[F32] uses {Alloc} {
  var b = move a
  sink(move b)
  while true {
    b = Buf.zeroed(1)
    break
  }
  b
}

pub fn new_value_in_the_branch(c: Bool, move a: Buf[F32]) -> Buf[F32] uses {Alloc} {
  var b = move a
  sink(move b)
  while true {
    if c {
      b = Buf.zeroed(1)
      break
    }
  }
  b
}

pub fn new_value_in_an_arm(n: U32, move a: Buf[F32]) -> Buf[F32] uses {Alloc} {
  var b = move a
  sink(move b)
  while (true) {
    match n {
      0 => {
        b = Buf.zeroed(1)
        break
      },
      _ => {}
    }
  }
  b
}
