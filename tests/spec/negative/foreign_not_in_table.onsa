// onsa.toml
// [test]
// spec = ["§4.1", "§18.1"]

// Other-language type names that are not in the closed list of foreign forms (docs/foreign-
// forms.toml, S-250) are not E0020: the general rule reports them. A name that does not exist is
// E0302. (`usize`, `isize`, `bool`, `char` and `str` are in the list: fixes/e0020_lowercase_*.)

pub fn string_type(x: String) -> I32 {              //~ E0302
  1
}

pub fn vec_type(x: Vec[I32]) -> I32 {               //~ E0302
  1
}

pub fn wide_signed(x: i128) -> I32 {                //~ E0302
  1
}

pub fn wide_unsigned(x: u128) -> I32 {              //~ E0302
  1
}

pub fn fine(x: Str) -> I32 {
  1
}
