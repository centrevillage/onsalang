// onsa.toml
// [test]
// spec = ["§18.1", "§2.5"]

// A `{` that is never closed ends at the next start of an item on a line with the same or a
// shallower indentation than the line that opened the `{`, and the E0002 points at the `{`
// (§18.1). The start of an item is the keyword of an item, whatever the head before it holds
// (a visibility, `rt`), so each unit below ends at the line after its body. One error in each
// unit; the item that stopped the unit is read and checked (the E0401 in its body is reported),
// and its name is seen by the users at the end of the file (no E0302 there).

fn open_before_fn() -> I32 {                        //~ E0002
  1
fn after_fn() -> I32 {
  let x: Bool = 1                                   //~ E0401
  1
}

fn open_before_pub_fn() -> I32 {                    //~ E0002
  1
pub fn after_pub_fn() -> I32 {
  let x: Bool = 1                                   //~ E0401
  1
}

fn open_before_rt_fn() -> I32 {                     //~ E0002
  1
rt fn after_rt_fn() -> I32 {
  let x: Bool = 1                                   //~ E0401
  1
}

fn open_before_priv_fn() -> I32 {                   //~ E0002
  1
priv fn after_priv_fn() -> I32 {
  let x: Bool = 1                                   //~ E0401
  1
}

fn open_before_pub_rt_fn() -> I32 {                 //~ E0002
  1
pub rt fn after_pub_rt_fn() -> I32 {
  let x: Bool = 1                                   //~ E0401
  1
}

fn open_before_struct() -> I32 {                    //~ E0002
  1
struct AfterStruct {
  v: I32,
}

fn open_before_enum() -> I32 {                      //~ E0002
  1
enum AfterEnum {
  A,
  B(I32),
}

fn open_before_pub_enum() -> I32 {                  //~ E0002
  1
pub enum AfterPubEnum { C, D }

fn open_before_impl() -> I32 {                      //~ E0002
  1
impl AfterStruct {
  fn after_method(self) -> I32 {
    let x: Bool = 1                                 //~ E0401
    1
  }
}

fn open_before_const() -> I32 {                     //~ E0002
  1
const AFTER_CONST: Bool = 1                         //~ E0401

fn open_before_pub_const() -> I32 {                 //~ E0002
  1
pub const AFTER_PUB_CONST: I32 = 2

fn open_before_use() -> I32 {                       //~ E0002
  1
use std.math

fn open_before_test() -> I32 {                      //~ E0002
  1
test "after the unit" {
  let x: Bool = 1                                   //~ E0401
  assert true
}

fn open_before_flow() -> I32 {                      //~ E0002
  1
flow after_flow(x: F32 at sample) -> F32 at sample {
  x
}

fn open_before_pub_flow() -> I32 {                  //~ E0002
  1
pub flow after_pub_flow(x: F32 at sample) -> F32 at sample {
  x
}

fn open_before_type() -> I32 {                      //~ E0002
  1
type AfterType = F32

// An empty body, a body with a statement on the line of the `{`, and the body of a function
// that returns a unit: the same.
fn open_empty() {                                   //~ E0002
fn after_empty() -> I32 { 2 }

fn open_with_statement() -> I32 { 1                 //~ E0002
fn after_statement() -> I32 { 3 }

// The users: every name above is a name of the module, whatever stopped the unit.
fn users(e: AfterEnum, s: AfterStruct, t: AfterType) -> I32 {
  let a = after_fn() + after_pub_fn() + after_rt_fn() + after_priv_fn() + after_pub_rt_fn()
  let b = after_statement() + AFTER_PUB_CONST + s.after_method() + open_before_fn()
  let c = open_with_statement() + open_before_pub_enum_user(e)
  a + b + c
}

fn open_before_pub_enum_user(e: AfterEnum) -> I32 {
  match e {
    AfterEnum.A => 0,
    AfterEnum.B(n) => n,
  }
}

fn users_of_types(p: AfterPubEnum, t: AfterType, x: F32) -> F32 {
  x
}
