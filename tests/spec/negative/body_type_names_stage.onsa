// onsa.toml
// [test]
// spec = ["§18.1", "§15.1", "§4.4", "§6.1"]

// A type name that is not found in the body is E0302 of the names stage (§15.1), and the names
// stage comes before the types: a unit with a name error is not type-checked (§18.1), so the
// type error that comes earlier in the text (`let c: Bool = a`, E0401; `a.nope`, E0413) is not
// reported (S-713, step U3a: the names of a body are all resolved before its types). The three
// places of a type in a body: the annotation of a `let`, the type after `as`, and the type of a
// parameter of an anonymous function. One error per unit (§18.1), so each form is in its own
// function; the places (a branch, a loop, a match arm, a closure, a generic function, a method,
// a `test`) give the same code.

pub struct P {
  x: I32,
}

pub fn annotation(a: I32) -> I32 {
  let c: Bool = a
  let b: Nope = 1                                   //~ E0302
  0
}

pub fn annotation_after_a_missing_field(a: I32) -> I32 {
  let c = a.nope
  let b: Nope = 1                                   //~ E0302
  0
}

pub fn annotation_in_a_branch(a: I32, flag: Bool) -> I32 {
  let c: Bool = a
  if flag {
    let b: Nope = 1                                 //~ E0302
  }
  0
}

pub fn annotation_in_a_loop(a: I32) -> I32 {
  let c: Bool = a
  for i in 0..<3 {
    let b: Nope = i                                 //~ E0302
  }
  0
}

pub fn annotation_in_a_match_arm(a: I32) -> I32 {
  let c: Bool = a
  match a {
    0 => {
      let b: Nope = 1                               //~ E0302
      0
    },
    _ => 1,
  }
}

pub fn annotation_in_a_closure(a: I32) -> I32 {
  let c: Bool = a
  let f = fn(y: I32) -> I32 {
    let b: Nope = y                                 //~ E0302
    0
  }
  f.(1)
}

pub fn annotation_in_a_generic_function[T: Num](a: I32, x: T) -> T {
  let c: Bool = a
  let b: Nope = 1                                   //~ E0302
  x
}

impl P {
  pub fn annotation_in_a_method(self) -> I32 {
    let c: Bool = self.x
    let b: Nope = 1                                 //~ E0302
    0
  }
}

test "an annotation in a test" {
  let c: Bool = 1
  let b: Nope = 1                                   //~ E0302
  assert true
}

pub fn cast(a: I32) -> I32 {
  let c: Bool = a
  let d = a as Nope                                 //~ E0302
  0
}

pub fn cast_inside_an_operand(a: I32) -> I32 {
  let c: Bool = a
  (a as Nope) + 1                                   //~ E0302
}

pub fn cast_in_a_branch(a: I32, flag: Bool) -> I32 {
  let c: Bool = a
  if flag {
    a as Nope                                       //~ E0302
  } else {
    0
  }
}

pub fn cast_after_a_missing_field(a: I32) -> I32 {
  let c = a.nope
  let d = a as Nope                                 //~ E0302
  0
}

pub fn cast_in_a_generic_function[T: Num](a: I32, x: T) -> T {
  let c: Bool = a
  let d = a as Nope                                 //~ E0302
  x
}

impl P {
  pub fn cast_in_a_method(self) -> I32 {
    let c: Bool = self.x
    let d = self.x as Nope                          //~ E0302
    0
  }
}

test "a cast in a test" {
  let c: Bool = 1
  let d = 1 as Nope                                 //~ E0302
  assert true
}

pub fn closure_parameter(a: I32) -> I32 {
  let c: Bool = a
  let f = fn(y: Nope) -> I32 { 0 }                  //~ E0302
  0
}

pub fn closure_second_parameter(a: I32) -> I32 {
  let c: Bool = a
  let f = fn(x: I32, y: Nope) -> I32 { x }          //~ E0302
  0
}

pub fn closure_in_a_closure(a: I32) -> I32 {
  let c: Bool = a
  let f = fn(x: I32) -> I32 {
    let g = fn(y: Nope) -> I32 { 0 }                //~ E0302
    x
  }
  0
}

pub fn closure_in_a_branch(a: I32, flag: Bool) -> I32 {
  let c: Bool = a
  if flag {
    let f = fn(y: Nope) -> I32 { 0 }                //~ E0302
  }
  0
}

pub fn closure_after_a_missing_field(a: I32) -> I32 {
  let c = a.nope
  let f = fn(y: Nope) -> I32 { 0 }                  //~ E0302
  0
}

pub fn closure_in_a_generic_function[T: Num](a: I32, x: T) -> T {
  let c: Bool = a
  let f = fn(y: Nope) -> I32 { 0 }                  //~ E0302
  x
}

impl P {
  pub fn closure_in_a_method(self) -> I32 {
    let c: Bool = self.x
    let f = fn(y: Nope) -> I32 { 0 }                //~ E0302
    0
  }
}

test "a closure parameter in a test" {
  let c: Bool = 1
  let f = fn(y: Nope) -> I32 { 0 }                  //~ E0302
  assert true
}
