// onsa.toml
// [test]
// spec = ["§5.1", "§18.1"]

// The place of E0309 in the order of the stages (spec 18.1; S-726): the E0309 of an unused binding is
// the last stage and is reported only for a unit with no other error, since an unused binding may be
// the symptom of another error (`n` is not read because the name meant was written otherwise). So in a
// unit that has an unused binding and a type error (E0401), a name error (E0302), a mode error (E0701)
// or an effect error (E0601), only that error is reported and there is no E0309, whatever the order
// in the file. What was read is still counted, but that does not matter here. The units are
// independent (P1): an E0309 in one unit is reported with an E0401 in another, and the members of an
// `impl`, a `test` and a `const` are units of their own. An anonymous function is not a unit: its body
// is part of the unit around it.

pub struct Point {
  x: I32,
  y: I32,
}

fn apply(f: fn(I32) -> I32, x: I32) -> I32 {
  f.(x)
}

pub fn type_error_hides_before_it() -> I32 {
  let a = 1
  let b: Bool = 2 //~ E0401
  3
}

pub fn type_error_hides_after_it() -> I32 {
  let b: Bool = 2 //~ E0401
  let a = 1
  3
}

pub fn type_error_is_the_cause(xs: [I32; 3]) -> U32 {
  let n: U32 = true //~ E0401
  var count = 0
  for i in 0 ..< 3 {
    count = count + 1
  }
  count
}

pub fn type_error_of_the_result(c: Bool) -> I32 {
  let a = 1
  c //~ E0401
}

pub fn type_error_in_a_closure() -> I32 {
  let a = 1
  apply(fn(x: I32) -> I32 {
    let t: Bool = x //~ E0401
    x
  }, 3)
}

pub fn type_error_in_a_match(o: Option[I32]) -> I32 {
  match o {
    Some(v) => true, //~ E0401
    None => 0,
  }
}

pub fn name_error_hides() -> I32 {
  let a = 1
  missing //~ E0302
}

pub fn name_error_is_the_cause() -> I32 {
  let count = 1
  let total = cuont + 1 //~ E0302
  total
}

pub fn mode_error_hides() -> I32 {
  let unused = 1
  let x = 1
  x = 2 //~ E0701
  x
}

fn make() -> Str uses {Alloc} {
  "made"
}

pub fn effect_error_hides(o: Option[I32]) -> Str { match o { Some(v) => make(), None => make() } } //~ E0601

fn slow() -> I32 {
  1
}

pub rt fn rt_error_hides(o: Option[I32]) -> I32 { match o { Some(v) => slow(), None => slow() } } //~ E0901

pub fn unused_binding_alone() -> I32 {
  let a = 1 //~ E0309
  2
}

pub fn unused_binding_beside_a_unit_with_an_error() -> I32 {
  let k = 1 //~ E0309
  2
}

impl Point {
  pub fn bad(self) -> I32 {
    let unused = 1
    let b: Bool = 2 //~ E0401
    self.x
  }

  pub fn lazy(self) -> I32 {
    let unused = 1 //~ E0309
    self.y
  }
}

const BAD: I32 = {
  let unused = 1
  let b: Bool = 2 //~ E0401
  3
}

const LAZY: I32 = {
  let unused = 1 //~ E0309
  3
}

test "a type error in a test" {
  let unused = 1
  let b: Bool = 2 //~ E0401
  assert true
}

test "an unused binding in a test" {
  let unused = 1 //~ E0309
  assert true
}
