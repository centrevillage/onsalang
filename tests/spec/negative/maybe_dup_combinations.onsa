// onsa.toml
// [test]
// spec = ["§4.5", "§4.6", "§4.7", "§7", "§6.1"]

// R-176 (W5-20; §4.5: "型パラメータの要求（境界と暗黙の `Dup`）は、型パラメータが決まった文で検査し、関数の終わりにはリテラルの既定を当てた後で検査する。満たさなければ、
// 要求を生んだ式…の位置に E0416"): the requirement of the implicit `Dup` or of `Copy` that a type holding a `?Dup` parameter does
// not meet is E0416 wherever the call is: in a branch of an `if`, an arm of a `match`, the body of a loop, a block, the body of an
// anonymous function (its argument is written with the type), a call whose argument is the result of another call (the type is
// the one the inner call returns), a value whose type is decided by a later statement (`var o = None` that gets its content
// after the call: the position is the call that made the requirement, §4.5). One error per function (P-01).
// A callee that asks nothing of the kind (`keep`, `peek`) takes the type: types/maybe_dup_wrapped_fine.onsa.

pub struct W[T: ?Dup] {
  x: T,
}

pub fn need_dup[T](x: T) -> U32 {
  0
}

pub fn need_copy[T: Copy](x: T) -> U32 {
  0
}

pub fn keep[T: ?Dup](move x: T) -> T {
  x
}

pub fn make[T: ?Dup](move x: T) -> W[T] {
  W { x: move x }
}

pub fn peek[T: ?Dup](x: T) -> U32 {
  0
}

pub fn in_an_if_branch[U: ?Dup](c: Bool, w: W[U]) -> U32 {
  if c {
    need_dup(w)   //~ E0416
  } else {
    0
  }
}

pub fn in_the_else_branch[U: ?Dup](c: Bool, w: W[U]) -> U32 {
  if c {
    peek(w)
  } else {
    need_copy(w)   //~ E0416
  }
}

pub fn in_a_match_arm[U: ?Dup](o: Option[U32], w: W[U]) -> U32 {
  match o {
    Some(n) => n,
    None => need_dup(w),   //~ E0416
  }
}

pub fn in_a_loop[U: ?Dup](w: W[U]) -> U32 {
  var n: U32 = 0
  for _ in 0..<3 {
    n = n + need_dup(w)   //~ E0416
  }
  n
}

pub fn in_a_block[U: ?Dup](w: W[U]) -> U32 {
  let n = {
    need_dup(w)   //~ E0416
  }
  n
}

pub fn in_an_anonymous_function[U: ?Dup](w: W[U]) -> U32 {
  let f = fn(x: W[U]) -> U32 {
    need_dup(x)   //~ E0416
  }
  f.(w)
}

pub fn the_result_of_another_call[U: ?Dup](move u: U) -> U32 {
  need_dup(make(move u))   //~ E0416
}

pub fn the_result_of_a_keep[U: ?Dup](move w: W[U]) -> U32 {
  let kept = keep(move w)
  need_copy(kept)   //~ E0416
}

pub fn decided_by_a_later_statement[U: ?Dup](move u: U) {
  var o = None
  let _ = need_dup(o)   //~ E0416
  o = Some(move u)
}

pub fn after_a_clean_call[U: ?Dup](w: W[U]) -> U32 {
  let n = peek(w)
  n + need_dup(w)   //~ E0416
}
