// onsa.toml
// [test]
// spec = ["§2.6", "§11.5", "§18.1"]
//
// [[test.fix]]
// at = "42:3"
// code = "E0811"
// candidate = 1
// leaves = ["43:14 E0811"]

// W4-20 U1/t, S-745; W7-06 U0/t, S-1177: whether a `par` has state is judged for each `par` on its own, by
// the content of its body (an instance, a delay, or a `par~` that holds state; §11.5), and a nest of `par~`
// with one `par` in it is E0811 at that `par` when the `par` holds state (§11.5: "状態を持つものを本体に含む
// `par` は E0811"; the body of a `par~` is in the body of the flow). The inner one, the outer one and the
// middle one of three are each the error when only that one is written without the `~`. When two are written
// without, the unit reports its first one by position (§18.1: the flow check stage reports "最初のもの"), the
// outer. One error per flow (P-01). A nest of `par` without state is no error (the section "Not errors"); the
// `par~` that holds only a `par` without state is the E0812 of e0812_par_tilde_without_state.onsa. The forms
// with the `~` on every `par` are in flow/par_tilde_nested.onsa.

pub flow lp(x: F32 at sample) -> F32 at sample {
  x * 0.5 + prev~(x) * 0.5
}

pub rt fn pair_sum(xs: [F32; 2]) -> F32 {
  xs[0] + xs[1]
}

pub flow only_the_inner_without_the_tilde(x: F32 at sample) -> [F32; 3] at sample {
  par~ i in 0 ..< 3 {
    pair_sum(par j in 0 ..< 2 { lp~(x * F32.round_from(i + j)) })  //~ E0811
  }
}

pub flow only_the_outer_without_the_tilde(x: F32 at sample) -> [F32; 3] at sample {
  par i in 0 ..< 3 {                                //~ E0811
    pair_sum(par~ j in 0 ..< 2 { lp~(x * F32.round_from(i + j)) })
  }
}

pub flow both_without_the_tilde(x: F32 at sample) -> [F32; 3] at sample {
  par i in 0 ..< 3 {                                //~ E0811
    pair_sum(par j in 0 ..< 2 { lp~(x * F32.round_from(i + j)) })
  }
}

pub flow only_the_middle_of_three_without_the_tilde(x: F32 at sample) -> [F32; 2] at sample {
  par~ i in 0 ..< 2 {
    pair_sum(par j in 0 ..< 2 {                     //~ E0811
      pair_sum(par~ k in 0 ..< 2 { lp~(x * F32.round_from(i + j + k)) })
    })
  }
}

pub flow the_inner_in_a_let_of_the_flow(x: F32 at sample) -> F32 at sample {
  let rows = par~ i in 0 ..< 3 {
    pair_sum(par j in 0 ..< 2 { lp~(x * F32.round_from(i + j)) })  //~ E0811
  }
  rows[0] + rows[1] + rows[2]
}

// ---- Not errors ----

pub flow fine(x: F32 at sample) -> [F32; 3] at sample {
  par~ i in 0 ..< 3 {
    pair_sum(par~ j in 0 ..< 2 { lp~(x * F32.round_from(i + j)) })
  }
}

pub flow a_nest_of_par_without_state(x: F32 at sample) -> [F32; 3] at sample {
  par i in 0 ..< 3 {
    pair_sum(par j in 0 ..< 2 { x * F32.round_from(i + j) })
  }
}
