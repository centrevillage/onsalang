// onsa.toml
// [test]
// spec = ["§7", "§18.1"]
// fixes = 0

// E0002, with no candidate, for a range pattern that has a comment after its end (S-428, spec §7, §18.1, S-845): the guard form is
// written in place of the range, and a comment in the part that it rewrites would be lost, so there is no candidate and the
// error is the general one of the form (the range's, because the arm has no choice, S-845). NEW: the spec does not say which comments
// are in that part (a comment after the end, before the `=>`, is the case of the decision of S-428); the cases are the ones of the decision.
// `fixes = 0` checks that no candidate is offered. One error per function (P-01).

pub fn a_block_comment_after_the_end(x: I32) -> I32 {
  match x {
    1..<3 /* c */ => 1,                             //~ E0002
    _ => 0,
  }
}

pub fn a_block_comment_after_a_closed_end(x: I32) -> I32 {
  match x {
    1..=3 /* c */ => 1,                             //~ E0002
    _ => 0,
  }
}

pub fn a_block_comment_after_a_one_sided_end(x: I32) -> I32 {
  match x {
    ..<3 /* c */ => 1,                              //~ E0002
    _ => 0,
  }
}

pub fn a_block_comment_after_the_end_in_some(o: Option[I32]) -> I32 {
  match o {
    Some(1..<3 /* c */) => 1,                       //~ E0002
    _ => 0,
  }
}
