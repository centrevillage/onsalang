// onsa.toml
// [test]
// spec = ["§5.2", "§5.3", "§11.6", "§15.1"]
// fixes = 0

// W7-12 U2c2b, S-1113 across modules: the callees and the flow of this module are used from app.onsa. The overlap of the
// channels of a literal at the tail of a planar argument and an `inout` is found at the call, where both places are written,
// whatever module declares the callee or the generated `In` (§11.6, §15.1).

pub fn planes_inout(xs: [Span[F32]; 2], inout t: Span[F32]) {}

pub fn planes_write(xs: [Span[F32]; 2], inout ys: [Span[F32]; 2]) {}

pub struct Wide {
  a: F32,
  b: F32,
}

pub flow spread(x: [F32; 2] at sample, m: F32 at sample) -> Wide at sample {
  Wide { a: x[0] + m, b: x[1] + m }
}

pub fn spread_in(i: spread.In, inout s: Span[F32]) {}
