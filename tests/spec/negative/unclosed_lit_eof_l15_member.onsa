// onsa.toml
// [test]
// spec = ["§18.1", "§2.4"]
// fixes = 0

// L15: a string never closed in the last member of an `impl`: only the literal is reported, not the `{` of the member or of the `impl`.
// A literal that is not closed reads to the end of the line (§2.4), so a closing bracket on that line may be inside it: the unit is not counted for
// brackets, and the E0002 for a bracket never closed is not given (§18.1, S-859). The report is the literal.

struct S { v: I32 }
impl S {
  fn a(self) -> Str { "x }                      //~ E0001
