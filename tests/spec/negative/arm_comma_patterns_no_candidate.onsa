// onsa.toml
// [test]
// spec = ["§7", "§18.1"]
// fixes = 0

// E0002, with no candidate, for the `,` of an arm that no pattern follows (spec §7, S-402): `0, => 1` is not the form that §7 names
// (`0, 1 =>`), so it is the general E0002 of the syntax (§18.1: a form that is not on the list). The `,` after a pattern that is
// followed by nothing, by the `if` of the guard, by another `,`, and a `,` at the start of an arm. `fixes = 0` checks that no
// candidate is offered. One error per function (P-01).

pub fn nothing_after_the_comma(n: I32) -> I32 {
  match n {
    0, => 1,                                        //~ E0002
    _ => 0,
  }
}

pub fn nothing_after_the_second_comma(n: I32) -> I32 {
  match n {
    0, 1, => 1,                                     //~ E0002
    _ => 0,
  }
}

pub fn a_guard_after_the_comma(n: I32, c: Bool) -> I32 {
  match n {
    0, if c => 1,                                   //~ E0002
    _ => 0,
  }
}

pub fn two_commas(n: I32) -> I32 {
  match n {
    0,, 1 => 1,                                     //~ E0002
    _ => 0,
  }
}

pub fn a_comma_at_the_start(n: I32) -> I32 {
  match n {
    , 1 => 1,                                       //~ E0002
    _ => 0,
  }
}

pub fn the_comma_after_a_nested_pattern(o: Option[I32]) -> I32 {
  match o {
    Some(0), => 1,                                  //~ E0002
    _ => 0,
  }
}

// The right form.
pub fn fine(n: I32) -> I32 {
  match n {
    0 | 1 => 1,
    _ => 0,
  }
}
