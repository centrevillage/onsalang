// onsa.toml
// [test]
// spec = ["§2.6", "§4.5", "§11.9", "§11.10", "§18.1"]

// W7-09 U3a/t, S-818 (a), S-555: the names and the types round a modifier. A name that is not found in the receiver is the E0302 of the
// names stage before the rule of the call (S-818 (a): an error of the names stage in the callee, the receiver `lp~(nope)` and its
// chain, comes before the E0812 of a name that the list has not or of a value receiver; the arguments are not the callee), and a
// name not found in the argument of a modifier of the list is E0302 as well. The condition of `when~` and `reset_if~` is `Bool`
// (§11.10: "`c` は `Bool`"), a type of the type stage (E0401), and the value of `.down~(N)`, `.up~(N)`, `.when~(c)` and
// `.reset_if~(c)` has the type of the receiver (§11.9: the modifier changes the rate, not the type). One error per flow (P-01).

pub rt fn g(x: F32) -> F32 {
  x
}

pub flow lp(x: F32 at sample) -> F32 at sample {
  x * 0.5 + prev~(x) * 0.5
}

// ---- E0302 ----

pub flow unlisted_name_on_a_receiver_that_is_not_found(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  lp~(nope).foo~(c)                                 //~ E0302
}

pub flow when_on_a_receiver_that_is_not_found(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  lp~(nope).when~(c)                                //~ E0302
}

pub flow down_on_a_receiver_that_is_not_found(p: F32 at block) -> F32 at sample {
  lp~(nope).down~(2) at sample                      //~ E0302
}

pub flow value_receiver_that_is_not_found(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  g(nope).when~(c)                                  //~ E0302
}

pub flow condition_that_is_not_found(x: F32 at sample) -> F32 at sample {
  lp~(x).when~(nope)                                //~ E0302
}

// ---- E0401 ----

pub flow when_with_a_float_condition(x: F32 at sample) -> F32 at sample {
  lp~(x).when~(1.0)                                 //~ E0401
}

pub flow reset_if_with_an_input_that_is_not_bool(x: F32 at sample) -> F32 at sample {
  lp~(x).reset_if~(x)                               //~ E0401
}

pub flow down_has_the_type_of_the_receiver(p: F32 at block) -> Bool at sample {
  lp~(p).down~(4) at sample                         //~ E0401
}

pub flow when_has_the_type_of_the_receiver(x: F32 at sample, c: Bool at sample) -> Bool at sample {
  lp~(x).when~(c)                                   //~ E0401
}
