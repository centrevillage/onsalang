// onsa.toml
// [test]
// spec = ["§11.7", "§3.3", "§18.1"]
// fixes = 0

// W7-13 U4b/t, S-200 (spec §11.7: "整数の入力の `min: 2.0` は修正候補 `2` で、`2.5` には候補が無い"): a float literal for an integer input is E0401, and
// it has a candidate (the same value as an integer literal) only when the value is a whole number; a float with a fraction has none,
// whatever the key, the width, the sign or the spelling is. The candidates are of the kind of the type and not of the value, so
// `fixes = 0` holds for the whole file. One error in each flow (§18.1).

pub flow default_with_a_fraction(
  x: F32 at sample,
  @param(min: 0, max: 10, default: 2.7)                //~ E0401
  n: I32 at block,
) -> F32 at sample {
  x
}

pub flow min_with_a_fraction(
  x: F32 at sample,
  @param(min: 2.5, max: 8, default: 4)                 //~ E0401
  n: I32 at block,
) -> F32 at sample {
  x
}

pub flow max_with_a_fraction(
  x: F32 at sample,
  @param(min: 0, max: 7.5, default: 4)                 //~ E0401
  n: U8 at block,
) -> F32 at sample {
  x
}

pub flow negative_with_a_fraction(
  x: F32 at sample,
  @param(min: -0.5, max: 8, default: 4)                //~ E0401
  n: I16 at block,
) -> F32 at sample {
  x
}

pub flow step_with_a_fraction(
  x: F32 at sample,
  @param(min: 0, max: 100, default: 4, step: 0.25)     //~ E0401
  n: U32 at block,
) -> F32 at sample {
  x
}

pub flow exponent_with_a_fraction(
  x: F32 at sample,
  @param(min: 0, max: 100, default: 2.5e-1)            //~ E0401
  n: I8 at block,
) -> F32 at sample {
  x
}

pub flow default_with_a_fraction_of_tenths(
  x: F32 at sample,
  @param(min: 0, max: 100, default: 33.3)              //~ E0401
  n: U16 at block,
) -> F32 at sample {
  x
}
