// onsa.toml
// [test]
// spec = ["§7", "§18.1"]

// S-260, S-187 (U2 of W5-09): a type a syntax error cut holds what was not read, so a `match` does not count it. An enum or a struct cut so, in a field of a struct
// that is read whole, is a column of the patterns that reports nothing that follows from the cut: no E0503 and no E0501, only the E0002 of the item (§18.1).

pub enum NoVariant {}                                   //~ E0002

pub enum CutEnum {
  First,
  3                                                     //~ E0002
}

pub struct CutStruct {
  on: Bool,
  3                                                     //~ E0002
}

pub struct HoldsNoVariant {
  cut: NoVariant,
  n: I32,
}

pub struct HoldsEnum {
  cut: CutEnum,
  n: I32,
}

pub struct HoldsStruct {
  cut: CutStruct,
  n: I32,
}

pub fn one_arm_on_an_enum_of_no_variant(h: HoldsNoVariant) -> I32 {
  match h {
    HoldsNoVariant { cut: _, _ } => 1,
  }
}

pub fn a_narrow_arm_on_an_enum_of_no_variant(h: HoldsNoVariant) -> I32 {
  match h {
    HoldsNoVariant { cut: _, n: 0 } => 1,
    _ => 2,
  }
}

pub fn the_variant_that_was_read_then_the_rest(h: HoldsEnum) -> I32 {
  match h {
    HoldsEnum { cut: CutEnum.First, _ } => 1,
    HoldsEnum { cut: _, _ } => 2,
  }
}

pub fn only_the_variant_that_was_read(h: HoldsEnum) -> I32 {
  match h {
    HoldsEnum { cut: CutEnum.First, _ } => 1,
  }
}

pub fn the_fields_that_were_read_then_the_rest(h: HoldsStruct) -> I32 {
  match h {
    HoldsStruct { cut: CutStruct { on: true, _ }, _ } => 1,
    HoldsStruct { cut: CutStruct { on: false, _ }, _ } => 2,
    HoldsStruct { cut: CutStruct { _ }, _ } => 3,
  }
}

pub fn only_one_value_of_a_field_that_was_read(h: HoldsStruct) -> I32 {
  match h {
    HoldsStruct { cut: CutStruct { on: true, _ }, _ } => 1,
  }
}
