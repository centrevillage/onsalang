// onsa.toml
// [test]
// spec = ["§18.1", "§2.5", "§15.1", "§14.1"]
// fixes = 0

// The forms that a line break cuts are not read on (W5-11 U4 must not change this; §18.1,
// S-435, S-459): `pub @fp(relaxed)`, `rt @fp(relaxed)` or `rt` at the end of its line, and
// `extern "C"` with the `{` on the next line. They keep the reading they have: one E0002 for the
// form that ends the line, and the item on the next line is an item of its own, read from its
// keyword, so a function is a name of the module (the visibility and the `rt` are not recorded
// on it) and the members of the block are not names (its user gets E0302).

fn uses_a() -> I32 {
  a()
}

fn uses_b() -> I32 {
  b()
}

fn uses_c() -> I32 {
  c()
}

fn uses_block() -> I32 {
  c_cut(1)                                          //~ E0302
}

pub @fp(relaxed)                                    //~ E0002 @5
fn a() -> I32 {
  1
}

rt @fp(relaxed)                                     //~ E0002 @4
fn b() -> I32 {
  1
}

rt                                                  //~ E0002 @3
fn c() -> I32 {
  1
}

extern "C"                                          //~ E0002 @11
{
  fn c_cut(x: I32) -> I32
}

// What was cut is not recorded on the item of the next line: it is not `rt`.
rt fn calls_c() -> I32 {
  c()                                               //~ E0901
}

fn own_error() -> I32 {
  a() + zz                                          //~ E0302 @9
}
