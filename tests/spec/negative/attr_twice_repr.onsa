// onsa.toml
// [test]
// spec = ["§4.5", "§6.5", "§18.1"]
// fixes = 0

// W5-24 U3a/t, S-490, S-495 (spec §6.5): `@repr(c)` twice on a struct is E0005 on the second one, with no candidate (the
// same rule as for `@fp`, attr_twice_fp.onsa). On one line or on lines of their own. One error in each declaration unit
// (P-01).

@repr(c) @repr(c) pub struct SameLine {   //~ E0005
  x: I32,
}

@repr(c)
@repr(c)                                            //~ E0005
pub struct TwoLines {
  x: I32,
}

@repr(c) @repr(c) struct SameLinePrivate {   //~ E0005
  x: I32,
}

@repr(c)
@repr(c)                                            //~ E0005
priv struct TwoLinesPrivate {
  x: I32,
  y: F32,
}

// One of them is fine.
@repr(c)
pub struct Once {
  x: I32,
}
