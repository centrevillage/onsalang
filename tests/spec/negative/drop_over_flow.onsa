// onsa.toml
// [test]
// spec = ["§5.2", "§5.4", "§7", "§8.1", "§10", "§12.2"]

// W6-02 U5b/t, R-32, S-1038 (§12.2: "代入で上書きされる前の値の破棄を含む（代入先が `var`・`move` の引数・`inout` の引数のどの場所でも …）: 要る"; §8.1: "効果行に無い使用は E0601"; §10 rule 1): an assignment
// to an `inout` argument whose old value needs `Alloc` to drop is an E0601 (an `rt fn` too, S-77) wherever it is written in the body: in a loop (the first run drops the value that the call received,
// the later runs the value that the run before wrote), in a loop over a borrowed array, over a `move` array and over a range (the element of the target), in an inner loop, in a branch of an `if` (one branch is
// enough: the effect row does not depend on the path; the other branch that panics drops nothing, §9.2, but the branch that assigns does), in both branches, in an arm of a `match`, in a branch inside a loop, and in an anonymous function that assigns its own `inout` parameter (its body is
// checked against the effect row of the type that is expected, §8.1: pure for `fn(inout Str)`, `rt` for `rt fn(inout Str)`; the error is the anonymous function's own, with no candidate, S-1032). This version counts no drop by an assignment (R-32), so none of these is reported
// today. The forms with a `?` that leaves before the assignment, and the ones that need more than one line, are not here (S-783). The functions are one-liners. One error per function (P-01).

pub rt fn mk(n: U32) -> Str { "x" }

pub fn run_s(f: fn(inout Str), inout s: Str) { f.(inout s) }

pub rt fn rt_run_s(f: rt fn(inout Str), inout s: Str) { f.(inout s) }

// ------------------------------------------------------------------ loops

pub fn loop_for(inout x: Str, xs: [Str; 2]) { for s in xs { x = s } }   //~ E0601

pub rt fn rt_loop_for(inout x: Str, xs: [Str; 2]) { for s in xs { x = s } }   //~ E0601

pub fn loop_for_move(inout b: Buf[F32], move q: [Buf[F32]; 2]) { for s in move q { b = move s } }   //~ E0601

pub rt fn rt_loop_for_move(inout b: Buf[F32], move q: [Buf[F32]; 2]) { for s in move q { b = move s } }   //~ E0601

pub fn loop_while(inout x: Str, t: Str, c: Bool) { while c { x = t } }   //~ E0601

pub rt fn rt_loop_while(inout x: Str, t: Str, c: Bool) { while c { x = t } }   //~ E0601

pub fn loop_range(inout xs: [Str; 3], t: Str) { for i in 0 ..< 3 { xs[i] = t } }   //~ E0601

pub rt fn rt_loop_range(inout xs: [Str; 3], t: Str) { for i in 0 ..< 3 { xs[i] = t } }   //~ E0601

pub fn loop_nested(inout x: Str, xs: [[Str; 2]; 2]) { for r in xs { for s in r { x = s } } }   //~ E0601

pub rt fn rt_loop_nested(inout x: Str, xs: [[Str; 2]; 2]) { for r in xs { for s in r { x = s } } }   //~ E0601

// ------------------------------------------------------------------ branches and arms

pub fn branch(inout s: Str, t: Str, c: Bool) { if c { s = t } }   //~ E0601

pub rt fn rt_branch(inout s: Str, t: Str, c: Bool) { if c { s = t } }   //~ E0601

pub fn both_branches(inout s: Str, t: Str, u: Str, c: Bool) { if c { s = t } else { s = u } }   //~ E0601

pub rt fn rt_both_branches(inout s: Str, t: Str, u: Str, c: Bool) { if c { s = t } else { s = u } }   //~ E0601

pub fn branch_else_panics(inout s: Str, t: Str, c: Bool) { if c { s = t } else { panic("x") } }   //~ E0601

pub rt fn rt_branch_else_panics(inout s: Str, t: Str, c: Bool) { if c { s = t } else { panic("x") } }   //~ E0601

pub fn arm(inout s: Str, o: Option[Str]) { match o { Some(v) => { s = v }, None => {} } }   //~ E0601

pub rt fn rt_arm(inout s: Str, o: Option[Str]) { match o { Some(v) => { s = v }, None => {} } }   //~ E0601

pub fn arm_move(inout b: Buf[F32], move o: Option[Buf[F32]]) { match move o { Some(v) => { b = move v }, None => {} } }   //~ E0601

pub rt fn rt_arm_move(inout b: Buf[F32], move o: Option[Buf[F32]]) { match move o { Some(v) => { b = move v }, None => {} } }   //~ E0601

pub fn branch_in_loop(inout s: Str, xs: [Str; 2], c: Bool) { for t in xs { if c { s = t } } }   //~ E0601

pub rt fn rt_branch_in_loop(inout s: Str, xs: [Str; 2], c: Bool) { for t in xs { if c { s = t } } }   //~ E0601

// ------------------------------------------------------------------ an anonymous function that assigns its own `inout` parameter

pub fn closure(inout s: Str) { run_s(fn(inout x: Str) { x = "b" }, inout s) }   //~ E0601

pub rt fn rt_closure(inout s: Str) { rt_run_s(fn(inout x: Str) { x = "b" }, inout s) }   //~ E0601

pub fn closure_call_result(inout s: Str) { run_s(fn(inout x: Str) { x = mk(1) }, inout s) }   //~ E0601
