// onsa.toml
// [test]
// mode = "check"
// spec = ["§2.5", "§18.1"]
// fixes = 0

// Two things on one line where the next token can start an expression as well (§2.5, S-401): `let c = a
// b`, `let y = neg x`, a literal after a literal, `if` and `match` and `fn` and `unsafe` after a value.
// A language that applies a function by writing the argument after it (Haskell, a Ruby call without
// parentheses) reads `a b` and `neg x` as an application, and `a if c { 1 } else { 2 }` as an
// application of `a`; another reader sees a newline that was lost. Which one is meant is not decided
// by the tokens, so the E0002 ("expected newline or `}`") has no candidate (`fixes = 0`), where the
// same line with a token that starts a statement only has the one that puts it on its own line
// (fixes/same_line_statements_block.onsa). The same in a block in parentheses, and at the top level
// (`const A: I32 = x y`). One diagnostic in each function.

pub fn two(a: I32, b: I32) -> I32 {
  a + b
}

pub fn neg(x: I32) -> I32 {
  -x
}

pub fn name_after_a_name(a: I32, b: I32) -> I32 {
  let c = a b                                       //~ E0002
  c
}

pub fn name_after_a_function(x: I32) -> I32 {
  let y = neg x                                     //~ E0002
  y
}

pub fn literal_after_a_literal() -> I32 {
  let c = 1 2                                       //~ E0002
  c
}

pub fn name_after_a_literal(a: I32) -> I32 {
  let c = 1 a                                       //~ E0002
  c
}

pub fn if_after_a_name(a: I32, c: Bool) -> I32 {
  let d = a if c { 1 } else { 2 }                   //~ E0002
  d
}

pub fn match_after_a_name(a: I32, c: Bool) -> I32 {
  let d = a match c { _ => 1 }                      //~ E0002
  d
}

pub fn fn_after_a_name(a: I32) -> I32 {
  let d = a fn(x: I32) -> I32 { x }                 //~ E0002
  d
}

pub fn unsafe_after_a_name(a: I32) -> I32 {
  let d = a unsafe { 1 }                            //~ E0002
  d
}

pub fn name_after_a_name_in_a_block_argument(a: I32) -> I32 {
  two({ a a }, 1)                                   //~ E0002
}

pub fn name_after_a_name_in_a_closure(a: I32) -> I32 {
  let f = fn(x: I32) -> I32 {
    let y = x a                                     //~ E0002
    y
  }
  f.(a)
}

pub fn name_after_a_name_in_a_match_arm(o: Option[I32]) -> I32 {
  match o {
    Some(v) => {
      let w = v v                                   //~ E0002
      w
    },
    None => 0,
  }
}

const NAME_AFTER_NAME: I32 = x y   //~ E0002

const LITERAL_AFTER_LITERAL: I32 = 1 2   //~ E0002
