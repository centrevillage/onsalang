// ---------------------------------------------------------------- nested_two

pub fn nested_two_init() -> nested_two.State {
  nested_two.init(8.0)
}

pub fn nested_two_process_in(inout st: nested_two.State, a: Span[F32], b: Span[F32], inout zs: Span[F32]) {
  nested_two.process(inout st, nested_two.In { l: a, r: b }, inout zs)
}

pub fn nested_two_process_spread(inout st: nested_two.State, a: Span[F32], b: Span[F32], inout zs: Span[F32]) {
  nested_two.process(inout st, a, b, inout zs)
}

pub fn nested_two_render(a: Span[F32], b: Span[F32]) -> I32 uses {Alloc} {
  let _ = nested_two.render(nested_two.In { l: a, r: b }, 8.0)
  1
}
