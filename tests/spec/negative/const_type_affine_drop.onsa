// onsa.toml
// [test]
// spec = ["§6.6", "§4.6", "§6.3", "§18.1"]

// S-610, S-755, S-138, R-85 (W5-04 U1; the first-period form of the case of W4-05 U4b): the judgement of §6.6 ("Affine の型を含む型も
// 置けない(E0407)…この判定は宣言の型だけで決まり、値の検査より先に行う") for a type that implements `Drop` (§4.6) needs a
// hand-written `impl Drop`, which is the E0200 of the form in this version (§18.1: "形の全体がこの版に無いもの…は形の E0200 で、
// 中の名前を読まない"; S-138; the second period opens it, tasks/phase2.md). The impl is not read, so the kind of the
// type is that of its structure (Copy for a struct of Copy fields, §4.6) and the `const` of the type, of a type that holds
// it and of `Option` of it, in a module and in an `impl`, are right with a right value: no E0407 is made from the failed
// `impl` (a result of a stage that failed is not a premise of the next, §18.1). The E0407 of the types that are Affine
// by their structure, with the value on the next line, is in negative/const_type_affine_position.onsa. The only error
// of the file is the E0200.

pub struct Handle {
  id: U32,
}

impl Drop for Handle {                          //~ E0200
  rt fn drop(move self) {}
}

pub struct Pair {
  first: Handle,
  second: U32,
}

const DROP_TYPE: Handle =
  Handle { id: 1 }

const HOLDS_A_DROP_TYPE: Pair =
  Pair { first: Handle { id: 1 }, second: 2 }

const OPTION_OF_A_DROP_TYPE: Option[Handle] =
  None

impl Handle {
  const ASSOCIATED: Handle =
    Handle { id: 3 }
}
