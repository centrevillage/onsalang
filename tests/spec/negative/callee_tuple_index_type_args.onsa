// onsa.toml
// [test]
// spec = ["§2.3", "§4.5", "§6.1", "§18.1"]

// E0002 for the type-argument mark `::[` after a tuple index (§4.5, S-606): `::[` stands right after
// a path of names that points to a generic item, and a path that ends with a tuple index is no path
// of names (the same sentence names `(e)::[T](x)` and `g(x)::[T](y)`), so there is no reading and no
// candidate. The syntax decides this by itself, whatever stands before the index (a name, a field, a
// call, an element) and before any name is looked up. A tuple index in the middle of the path is
// another case: `t.0.m::[I32](x)` ends with the name `m` of a method (tests/spec/types/type_args_syntax.onsa).
// Contrast tests/spec/fixes/e0020_callee_tuple_index_angle.onsa (the forms of other languages,
// `t.0<I32>(x)`, get E0020 with the candidate `t.0.(x)`). One error per function (P-01).

pub struct Pair {
  t: (fn(I32) -> I32, I32),
}

pub fn inc(x: I32) -> I32 {
  x + 1
}

pub fn mk2() -> (fn(I32) -> I32, I32) {
  (inc, 1)
}

pub fn after_a_name(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  t.0::[I32](x)                                     //~ E0002
}

pub fn after_a_field(p: Pair, x: I32) -> I32 {
  p.t.0::[I32](x)                                   //~ E0002
}

pub fn after_the_result_of_a_call(x: I32) -> I32 {
  mk2().0::[I32](x)                                 //~ E0002
}

pub fn after_an_element(ts: [(fn(I32) -> I32, I32); 2], x: I32) -> I32 {
  ts[0].0::[I32](x)                                 //~ E0002
}

pub fn after_two_tuple_indexes(n: ((I32, fn(I32) -> I32), I32), x: I32) -> I32 {
  n.0.1::[I32](x)                                   //~ E0002
}

pub fn with_two_type_arguments(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  t.0::[I32, U8](x)                                 //~ E0002
}

pub fn in_a_let(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  let y = t.0::[I32](x)                             //~ E0002
  y
}

pub fn in_an_argument(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  inc(t.0::[I32](x))                                //~ E0002
}

pub fn in_a_closure(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  let g = fn(u: (fn(I32) -> I32, I32), y: I32) -> I32 { u.0::[I32](y) }  //~ E0002
  g.(t, x)
}

pub fn in_an_arm(t: (fn(I32) -> I32, I32), o: Option[I32]) -> I32 {
  match o {
    Some(v) => t.0::[I32](v),                       //~ E0002
    None => 0,
  }
}

pub fn in_a_condition(t: (fn(I32) -> Bool, I32), x: I32) -> I32 {
  if t.0::[I32](x) { 1 } else { 2 }                 //~ E0002
}

pub fn in_a_generic_function[T](t: (fn(T) -> T, T), x: T) -> T {
  t.0::[T](x)                                       //~ E0002
}

pub fn after_a_name_that_is_not_defined(x: I32) -> I32 {
  nope.0::[I32](x)                                  //~ E0002
}

pub fn fine(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  t.0.(x)
}
