// onsa.toml
// [test]
// spec = ["§4.1", "§4.7", "§9.1", "§18.1"]
// fixes = 0

// W5-03 U4/t, S-71: a variant written as the receiver of `unwrap` whose type arguments nothing decides is E0406 at the
// expression that made the type variable (spec §4.7: "リテラル以外の型変数 … が関数の終わりに残れば、その型変数を作った式の
// 位置に E0406"). The receiver has a known head, so the call is no E0420 (§4.7: "型引数の中の型変数は後の文で決まってよい"),
// and the type argument that the result of `unwrap` could decide stays open when nothing uses it. The variants here are
// `Err(1)`, `Ok(2)` and `Ok(Some(1))`: the open variable is the own one of the variant (the `T` of the `Err`, the `E` of the
// `Ok`), so the error is at the variant itself, at its start (`@N`, from 1). The receivers with a `None` are in
// unwrap_variant_receiver_open_none.onsa. The statement that decides the variable is no error (the functions at the end).
// One error per function (P-01). `fixes = 0`: a type variable has no candidate.

// ---------------------------------------------------------------- E0406

pub fn err_receiver() {
  let x = Err(1).unwrap()               //~ E0406 @11
  let _ = x
}

pub fn ok_receiver() {
  let x = Ok(2).unwrap()                //~ E0406 @11
  let _ = x
}

pub fn ok_of_a_some_receiver() {
  let x = Ok(Some(1)).unwrap()          //~ E0406 @11
  let _ = x
}

pub fn in_a_loop() {
  for _ in 0 ..< 2 {
    let x = Err(1).unwrap()             //~ E0406 @13
    let _ = x
  }
}

pub fn in_a_match_arm(n: U8) -> U8 {
  match n {
    0 => {
      let x = Ok(1).unwrap()            //~ E0406 @15
      let _ = x
      n
    },
    _ => n,
  }
}

test "in a test" {
  let x = Err(1).unwrap()               //~ E0406 @11
  let _ = x
}

// ---------------------------------------------------------------- decided: no error

pub fn decided_by_the_return_type_of_an_err() -> U32 {
  Err(1).unwrap()
}

pub fn decided_by_an_annotation() -> U8 {
  let y: U8 = Err(1).unwrap()
  y
}

pub fn decided_inner_by_the_return_type() -> Option[U8] {
  Some(None).unwrap()
}
