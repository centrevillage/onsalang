// onsa.toml
// [test]
// spec = ["§18.1", "§2.5"]
// fixes = 0

// The members are closed and the `impl` is not: the `{` of the `impl` (N8).
// The unit ends at the item that follows it, on a line with the same or a shallower indentation. A bracket that is not closed
// is reported whatever stopped the reading: the E0002 points at the innermost bracket that is not closed (§18.1, S-943,
// R-371). The same file without the item after the unit is unclosed_eof_n08_impl_only.onsa, and the report is on the same line.

struct S { v: I32 }
impl S {                                        //~ E0002 @8
  fn a(self) -> I32 { self.v }
fn b() -> I32 { 2 }
