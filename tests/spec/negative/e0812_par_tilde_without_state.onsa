// onsa.toml
// [test]
// spec = ["§2.6", "§11.5", "§18.1"]
//
// [[test.fix]]
// at = "108:14"
// code = "E0812"
// candidate = 1
// leaves = ["109:15 E0812"]

// W7-06 U0/t, S-1177: a `par~` whose body holds nothing with state (no instance, no built-in delay, and no
// `par~` that holds one; §11.5) is E0812, and its one candidate removes the `~` (§11.5: "含まない `par~` は E0812
// で `~` を外す修正候補を示す"; §2.6; the same count as the E0812 of an `if~` / `match~` without state in a
// branch). Whether the body holds state is decided by its content, not by the spelling (§11.5), so a body of a
// function call (`scale(x, i)`), of an `if` without `~`, of a constant, and a body whose only inner replication
// is a `par` are all without state. The error is of the flow check stage (§18.1: "本体の中身で決まる `par` /
// `par~` の `~` の有無（E0811、E0812、§11.5）は flow の検査の段である"), so it is reported when the flow has no
// error of the names or the types, and the first of the errors of that stage by position is the one error of a
// flow (P-01): the second `par~` of a flow is not reported until the first one is mended (the header: the `par~`
// at line 108, then the one at line 109). The main position is the start of the `par~` (the `par` and the `~`;
// the place of the E0812 of a `par~` is the provisional reading of S-392: the head of the `par~`). The file with
// the `~` taken off is in the files e0812_par_tilde_clean_*. The same body with the `~` off is no error
// (flow/par_stateless.onsa) and a `par` with state in its body is E0811 (negative/e0811_par_without_tilde.onsa).

pub rt fn scale(x: F32, i: U32) -> F32 {
  x * F32.round_from(i)
}

pub rt fn total(xs: [F32; 4]) -> F32 {
  xs[0] + xs[1] + xs[2] + xs[3]
}

pub rt fn pair_sum(xs: [F32; 2]) -> F32 {
  xs[0] + xs[1]
}

pub flow lp(x: F32 at sample) -> F32 at sample {
  x * 0.5 + prev~(x) * 0.5
}

pub flow as_a_let(x: F32 at sample) -> [F32; 4] at sample {
  let ys = par~ i in 0 ..< 4 { x * F32.round_from(i) }  //~ E0812
  ys
}

pub flow as_the_tail(x: F32 at sample) -> [F32; 4] at sample {
  par~ i in 0 ..< 4 { x * F32.round_from(i) }          //~ E0812
}

pub flow as_an_argument(x: F32 at sample) -> F32 at sample {
  total(par~ i in 0 ..< 4 { x * F32.round_from(i) })    //~ E0812
}

pub flow with_a_function_call(x: F32 at sample) -> [F32; 4] at sample {
  par~ i in 0 ..< 4 { scale(x, i) }                     //~ E0812
}

pub flow with_an_if_without_the_tilde(x: F32 at sample) -> [F32; 4] at sample {
  par~ i in 0 ..< 4 { if x > F32.round_from(i) { 1.0 } else { 0.0 } }  //~ E0812
}

pub flow with_a_constant_body(x: F32 at sample) -> [F32; 4] at sample {
  par~ i in 1 ..< 5 { F32.round_from(i) }               //~ E0812
}

pub flow with_a_closed_range(x: F32 at sample) -> [F32; 4] at sample {
  par~ i in 1 ..= 4 { x * F32.round_from(i) }           //~ E0812
}

pub flow the_outer_of_a_nest_with_a_par_inside(x: F32 at sample) -> [F32; 3] at sample {
  par~ i in 0 ..< 3 {                                   //~ E0812
    pair_sum(par j in 0 ..< 2 { x * F32.round_from(i + j) })
  }
}

pub flow the_inner_of_a_nest(x: F32 at sample) -> [F32; 3] at sample {
  par i in 0 ..< 3 {
    pair_sum(par~ j in 0 ..< 2 { x * F32.round_from(i + j) })  //~ E0812
  }
}

pub flow the_inner_with_state_beside(x: F32 at sample) -> [F32; 3] at sample {
  par~ i in 0 ..< 3 {
    lp~(x) * pair_sum(par~ j in 0 ..< 2 { x * F32.round_from(i + j) })  //~ E0812
  }
}

pub flow beside_a_flow_with_state(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0 ..< 4 { x * F32.round_from(i) }  //~ E0812
  lp~(total(ys))
}

pub flow stateless_beside_stateful(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0 ..< 4 { x * F32.round_from(i) }  //~ E0812
  let zs = par~ i in 0 ..< 4 { lp~(x) * F32.round_from(i) }
  total(ys) + total(zs)
}

pub flow in_a_plain_branch(x: F32 at sample, c: Bool at sample) -> [F32; 2] at sample {
  if c {
    par~ i in 0 ..< 2 { x * F32.round_from(i) }         //~ E0812
  } else {
    [x, x]
  }
}

pub flow two_in_one_flow(x: F32 at sample) -> F32 at sample {
  let lows = par~ i in 0 ..< 4 { x * F32.round_from(i) }  //~ E0812
  let highs = par~ i in 0 ..< 4 { x * F32.round_from(i + 4) }
  total(lows) + total(highs)
}

// ---- Not errors ----

pub flow with_state(x: F32 at sample) -> [F32; 4] at sample {
  par~ i in 0 ..< 4 { lp~(x * F32.round_from(i)) }
}

pub flow without_the_tilde(x: F32 at sample) -> [F32; 4] at sample {
  par i in 0 ..< 4 { x * F32.round_from(i) }
}
