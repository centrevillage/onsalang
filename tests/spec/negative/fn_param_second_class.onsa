// onsa.toml
// [test]
// spec = ["§5.2", "§5.3", "§5.4"]
// fixes = 0

// S-190 (§5.2: "既定のモードの関数型の引数（`f: fn(I32) -> I32`）は、捕捉する無名関数も受け、関数の中では第二級になる（§5.3）.
// 呼ぶことと、別の関数の既定のモードの関数型の引数へ渡すことはでき、返す、保存する（`let` / `var` の初期化、代入、フィールド、要素）、
// … 無名関数で捕捉する、`move` の引数へ渡すと E0710"): a parameter of a function type that takes the default mode may be
// called and passed on to a default-mode parameter of a function type (values/fn_param_ok.onsa), and nothing else. Every
// function below makes one of the other uses of it, and has one error (§18.1), at the expression of the value (the
// tail of an `if`, a `match`, a block, and a parenthesis keep the position of the tail; a capture is the use of the
// parameter in the body of the anonymous function). No error has a candidate (`fixes = 0`: E0710 has none).
// This file is the positions that return a value. The ones that store it are in negative/fn_param_second_class_store.onsa,
// capture it or pass it to a `move` parameter in _capture.onsa, the other kinds of parameter in _kinds.onsa, the type parameter and
// the builtin method in _generic.onsa, the head of a `match` in _match.onsa, the marks in _move_mark.onsa and _inout_mark.onsa, and
// the module in fn_param_second_class_pkg/.

pub fn inc(x: I32) -> I32 {
  x + 1
}

// ------------------------------------------------------------------ the end of a function

pub fn return_the_parameter(f: fn(I32) -> I32) -> fn(I32) -> I32 {
  f //~ E0710
}

pub fn return_with_the_keyword(f: fn(I32) -> I32) -> fn(I32) -> I32 {
  return f //~ E0710
}

pub fn return_in_parentheses(f: fn(I32) -> I32) -> fn(I32) -> I32 {
  (f) //~ E0710
}

pub fn return_a_block(f: fn(I32) -> I32) -> fn(I32) -> I32 {
  {
    f //~ E0710
  }
}

pub fn return_the_tail_of_an_if(f: fn(I32) -> I32, c: Bool) -> fn(I32) -> I32 {
  if c {
    f //~ E0710
  } else {
    inc
  }
}

pub fn return_the_tail_of_the_else(f: fn(I32) -> I32, c: Bool) -> fn(I32) -> I32 {
  if c {
    inc
  } else {
    f //~ E0710
  }
}

pub fn return_the_arm_of_a_match(f: fn(I32) -> I32, n: I32) -> fn(I32) -> I32 {
  match n {
    0 => f, //~ E0710
    _ => inc,
  }
}

pub fn return_a_tail_in_nested_blocks(f: fn(I32) -> I32, c: Bool) -> fn(I32) -> I32 {
  if c {
    {
      (f) //~ E0710
    }
  } else {
    inc
  }
}

pub fn return_in_a_variant(f: fn(I32) -> I32) -> Option[fn(I32) -> I32] {
  Some(f) //~ E0710
}

pub fn return_in_a_tuple(f: fn(I32) -> I32) -> (fn(I32) -> I32, I32) {
  (f, 1) //~ E0710
}

pub fn return_in_an_array(f: fn(I32) -> I32) -> [fn(I32) -> I32; 2] {
  [f, inc] //~ E0710
}
