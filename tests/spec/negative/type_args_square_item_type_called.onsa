// onsa.toml
// [test]
// spec = ["§4.5", "§6.1", "§15.1", "§18.1"]
// fixes = 0

// W5-10 U3a (R-179, S-974): a type with the type argument in square brackets called as a function (`Pt[I32](1, 2)`) is the E0020 of the names
// stage, and the candidate is not offered. A type is a name that §6.1 counts with the items called as `f(x)` ("`f(x)` で呼ぶ項目か型"), so the
// `[…]` after it is the form of another language, as `Buf[F32].zeroed(4)` is (R-179: "型や関数の項目に型引数を書いて値の位置に置いた形"). The edit
// `Pt::[I32](1, 2)` would leave the E0308 of a type in the place of a value (§15.1: "型を値の位置に書く（`let a = P`）"), an error of the names
// stage, so the candidate is not offered (S-974: "型を直接呼んでいない（`Pt[I32](1, 2)` でない）ときに候補"; §18.1). A struct is written
// with its fields (`Pt { x: 1, y: 2 }`). The type is a struct, an enum and the standard `Buf`; the call is in a function, in an argument and in
// a `test`. `fixes = 0` checks that no error of the file has a candidate. One error per function (P-01).

pub struct Pt[T] {
  x: T,
  y: T,
}

pub struct Wrap[T] {
  v: T,
}

pub enum E[T] {
  A(T),
  B,
}

pub fn take(p: Pt[I32]) -> I32 {
  p.x
}

pub fn a_struct(a: I32, b: I32) -> I32 {
  let p = Pt[I32](a, b)                             //~ E0020
  p.x
}

pub fn a_struct_with_one_field(v: U8) -> U8 {
  let w = Wrap[U8](v)                               //~ E0020
  w.v
}

pub fn an_enum() -> I32 {
  match E[I32](1) {                                 //~ E0020
    E.A(x) => x,
    E.B => 0,
  }
}

pub fn the_standard_buffer() -> U32 uses {Alloc} {
  let b = Buf[F32](4)                               //~ E0020
  b.len()
}

pub fn in_an_argument() -> I32 {
  take(Pt[I32](1, 2))                               //~ E0020
}

pub fn in_a_closure(a: I32) -> I32 {
  let g = fn(x: I32) -> I32 { take(Pt[I32](x, x)) }   //~ E0020
  g.(a)
}

test "a type with a type argument in square brackets called as a function" {
  let p = Pt[I32](1, 2)                             //~ E0020
  assert p.x == 1
}

pub fn fine(a: I32, b: I32) -> I32 {
  let p = Pt::[I32] { x: a, y: b }
  p.y
}
