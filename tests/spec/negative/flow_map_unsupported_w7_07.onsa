// onsa.toml
// [test]
// spec = ["§11.4", "§18.1"]

// E0200 while the flow syntax is written in the terms of this version's checks (W3-10, K-02, K-08):
// the omitted `init` of a value type that is no number is `T.default()` (§11.4, S-29), which this
// version does not compute. One error per flow (P-01).
//
// A delay inside the first argument of a delay (R-13) is no longer here: it is no error (§11.4
// reads the stored value before every store, `prev~(prev~(x))` is `x[n-2]`), and the files
// lookback_nesting.onsa, lookback_sites.onsa and lookback_instances.onsa check the values.
//
// W7-07 U2 removes this file: after it these programs check (prev_default_types.onsa).

pub flow lp(x: F32 at sample) -> F32 at sample {
  let y = 0.5 * x + 0.5 * prev~(^y)
  y
}

pub flow default_bool(c: Bool at sample) -> Bool at sample {
  prev~(c) //~ E0200
}

pub flow default_array(x: [F32; 2] at sample) -> [F32; 2] at sample {
  delay~(x, 3) //~ E0200
}

// An instance in the first argument of a delay, and the omitted `init` of a number.
pub flow fine(x: F32 at sample, k: I32 at sample) -> F32 at sample {
  let a = prev~(lp~(x))
  let b = prev~(k)
  a + F32.round_from(b)
}
