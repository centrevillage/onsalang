// onsa.toml
// [test]
// spec = ["§4.7", "§7", "§5.3"]

// E0401 for iterating a number, whatever the number's type turns out to be (spec §4.7 "その場で既知を要する操作" and
// the paragraph after it: "`for` の反復元" is one of the operations that the candidates' kind alone decides, and
// they get the code of the annotated form `for i in n` with `n: I32` at once, not E0420; S-860, the extension
// of S-854). The candidates of a literal's type variable are the integer types or the float types, and none of
// them can be iterated (§7). The annotated forms are in infer_literal_subject_annotated_shapes.onsa. The subject
// is the literal itself, a parenthesized one, a binding, a binding that is decided later, a value that a
// generic call gives back, an element taken out of an array or a tuple of literals, and the place can be a
// closure body or a `test` body. A type variable that is not a literal's (`make()` of `fn make[T: Copy]() -> T`)
// stays E0420 (infer_literal_subject_open_shapes.onsa). One error per function (P-01).

// ---------------------------------------------------------------- an integer literal

pub fn iterate_an_integer() -> I32 {
  for i in 17 {                                     //~ E0401
    let _ = i
  }
  0
}

pub fn iterate_a_parenthesized_integer() -> I32 {
  for i in (17) {                                   //~ E0401
    let _ = i
  }
  0
}

pub fn iterate_a_bound_integer() -> I32 {
  let n = 17
  for i in n {                                      //~ E0401
    let _ = i
  }
  0
}

pub fn iterate_an_integer_decided_later() -> U8 {
  let n = 17
  for i in n {                                      //~ E0401
    let _ = i
  }
  n
}

pub fn iterate_a_generic_result() -> I32 {
  let z = id(17)
  for i in z {                                      //~ E0401
    let _ = i
  }
  0
}

pub fn iterate_an_indexed_element() -> I32 {
  for i in [1, 2][0] {                              //~ E0401
    let _ = i
  }
  0
}

pub fn iterate_a_tuple_element() -> I32 {
  for i in (1, 2).0 {                               //~ E0401
    let _ = i
  }
  0
}

pub fn iterate_a_loop_variable() -> I32 {
  for j in 0 ..< 3 {
    for i in j {                                    //~ E0401
      let _ = i
    }
  }
  0
}

pub fn iterate_in_a_closure(x: I32) -> I32 {
  let f = fn(y: I32) -> I32 {
    let n = 17
    for i in n {                                    //~ E0401
      let _ = i
    }
    y
  }
  f.(x)
}

test "iterate in a test" {
  let n = 17
  for i in n {                                      //~ E0401
    let _ = i
  }
}

// ---------------------------------------------------------------- a float literal

pub fn iterate_a_float() -> I32 {
  for i in 1.5 {                                    //~ E0401
    let _ = i
  }
  0
}

pub fn iterate_a_parenthesized_float() -> I32 {
  for i in (1.5) {                                  //~ E0401
    let _ = i
  }
  0
}

pub fn iterate_a_bound_float() -> I32 {
  let n = 1.5
  for i in n {                                      //~ E0401
    let _ = i
  }
  0
}

pub fn iterate_a_float_decided_later() -> F32 {
  let n = 1.5
  for i in n {                                      //~ E0401
    let _ = i
  }
  n
}

pub fn iterate_a_generic_float_result() -> I32 {
  let z = id(1.5)
  for i in z {                                      //~ E0401
    let _ = i
  }
  0
}

pub fn iterate_an_indexed_float_element() -> I32 {
  for i in [1.5, 2.5][0] {                          //~ E0401
    let _ = i
  }
  0
}

pub fn iterate_a_tuple_float_element() -> I32 {
  for i in (1.5, 2.5).0 {                           //~ E0401
    let _ = i
  }
  0
}

fn id[T](x: T) -> T {
  x
}
