// onsa.toml
// [test]
// spec = ["§18.1", "§2.4"]

// R-421 (§18.1: "どの項目にも入らない余分なトークンは、ひと続きごとに一つの単位"): a token that belongs to no item is reported also
// when the function before it has a syntax error. The function has the E0001 of `0o19` in its body, and the `0o19` that
// stands alone after it is one more unit with its own E0001 (a digit that is not octal, §2.4).

pub fn g(x: I32) -> I32 {
  x as 0o19                                         //~ E0001
}

0o19                                                //~ E0001

pub fn f() -> I32 {
  1
}
