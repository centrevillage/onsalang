// onsa.toml
// [test]
// spec = ["§18.1", "§2.4"]

// R-421 (§18.1): the extra tokens `foo bar` after a function that has a syntax error are the E0002 of one unit, reported
// as they are after a function that is right (stray_after_broken_item_clean.onsa).

pub fn g(x: I32) -> I32 {
  x as 0o19                                         //~ E0001
}

foo bar                                             //~ E0002

pub fn f() -> I32 {
  1
}
