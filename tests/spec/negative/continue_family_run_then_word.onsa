// onsa.toml
// [test]
// spec = ["§18.1", "§15.1"]
// fixes = 0

// A run of visibilities that is not right, and then a word that is no part of the head (W5-11
// U4; `pub pub export fn`): the unit reports the first error, the run (§18.1, S-464, S-593),
// at its first modifier. The head is read on past both, so the item is a name of the module and
// its users are checked against the head. The error of the run has no candidate here: what
// follows the run is not the keyword.
// The unit has a syntax error, so its body is not checked. One error in each unit.

pub pub export fn twice_then_word(x: I32) -> I32 {  //~ E0002 @1
  x + 1
}

pub pub export struct Pt {                          //~ E0002 @1
  x: I32,
}

pub pub export fn body_not_checked() -> I32 {       //~ E0002 @1
  zz
}

fn calls(p: Pt) -> I32 {
  twice_then_word(p.x) + body_not_checked()
}

fn nested(c: Bool) -> I32 {
  let f = fn(x: I32) -> I32 { twice_then_word(x) }
  if c { f.(1) } else { twice_then_word(body_not_checked()) }
}

// The head is the declaration that was read: a real error of a use is reported.
fn too_many_arguments() -> I32 {
  twice_then_word(1, 2)                             //~ E0412
}

fn wrong_argument_type() -> I32 {
  twice_then_word(true)                             //~ E0401
}

fn no_such_field(p: Pt) -> I32 {
  p.zz                                              //~ E0413
}

fn own_error() -> I32 {
  twice_then_word(1) + zz                           //~ E0302 @24
}
