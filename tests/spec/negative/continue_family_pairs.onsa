// onsa.toml
// [test]
// spec = ["§18.1", "§6.5", "§10", "§15.1"]
// fixes = 1
//
// [[test.fix]]
// at = "45:5"
// code = "E0002"
// candidate = 1
// leaves = ["45:14 E0002"]
//
// [[test.fix]]
// at = "49:5"
// code = "E0002"
// candidate = 1
// leaves = ["49:18 E0002"]
//
// [[test.fix]]
// at = "53:5"
// code = "E0002"
// candidate = 1
// leaves = ["53:18 E0002"]
//
// [[test.fix]]
// at = "57:5"
// code = "E0002"
// candidate = 1
// leaves = ["57:14 E0002"]

// Two errors in the head of one item (W5-11 U4): the unit reports the first one, and the head is
// read on past both, so the item is a name of the module and its users are checked against the
// head (§18.1, S-593, S-464, S-459). The candidates are none: the word or the attribute that is
// the first error has none. (The run of modifiers that is not right and then an attribute:
// continue_family_run_attr.onsa.)
// - A word that is no part of the head after `rt` (`rt export fn`): the word is the error, and
//   the `rt` stays (an `rt` function that calls the item gets no E0901).
// - An attribute after a visibility and then a second visibility, an attribute of another
//   language or a word: the attribute is the first error, at the `@`.
// The unit has a syntax error, so its body is not checked. One error in each unit.

rt export fn export_after_rt(x: F32) -> F32 {       //~ E0002
  x + 1.0
}

pub @fp(relaxed) pub fn attr_then_pub(x: F32) -> F32 {   //~ E0002 @5
  x * 5.0
}

pub @fp(relaxed) #[inline] fn attr_then_foreign(x: F32) -> F32 {   //~ E0002 @5
  x * 6.0
}

pub @fp(relaxed) export fn attr_then_word(x: F32) -> F32 {   //~ E0002 @5
  x * 7.0
}

pub @fp(relaxed) pub fn body_not_checked() -> F32 { //~ E0002 @5
  zz
}

fn calls() -> F32 {
  export_after_rt(1.0)
}

fn calls_more() -> F32 {
  attr_then_pub(1.0) + attr_then_foreign(1.0) + attr_then_word(1.0) + body_not_checked()
}

fn nested(c: Bool) -> F32 {
  let f = fn(x: F32) -> F32 { export_after_rt(x) + attr_then_pub(x) }
  if c { f.(1.0) } else { attr_then_pub(attr_then_foreign(2.0)) }
}

// What was written `rt` is `rt`: it may be called from an `rt` function.
rt fn calls_rt_ones(x: F32) -> F32 {
  export_after_rt(x)
}

// What was not written `rt` is not.
rt fn calls_attr_then_pub(x: F32) -> F32 {
  attr_then_pub(x)                                  //~ E0901
}

// The head is the declaration that was read: a real error of a use is reported.
fn too_many_arguments() -> F32 {
  attr_then_pub(1.0, 2.0)                           //~ E0412
}

fn wrong_argument_type() -> F32 {
  export_after_rt(true)                             //~ E0401
}

fn own_error() -> F32 {
  export_after_rt(1.0) + zz                         //~ E0302 @26
}
