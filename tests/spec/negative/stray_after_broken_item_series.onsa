// onsa.toml
// [test]
// spec = ["§18.1", "§2.4"]

// R-421 (§18.1): each function that has a syntax error is followed by its own extra tokens, and each run of them is one
// unit with one error, so the file has an error for each of the four units. A function that is right stands between them.

pub fn a(x: I32) -> I32 {
  x as 0o19                                         //~ E0001
}

0o19                                                //~ E0001

pub fn between() -> I32 {
  1
}

pub fn b(x: I32) -> I32 {
  x as F32 F32                                      //~ E0002
}

foo bar                                             //~ E0002

pub fn after() -> I32 {
  2
}
