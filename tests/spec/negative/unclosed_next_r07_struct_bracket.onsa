// onsa.toml
// [test]
// spec = ["§18.1", "§2.5"]
// fixes = 0

// `struct S[T {`: the `]` of the type parameters is missing (R7).
// The unit ends at the item that follows it, on a line with the same or a shallower indentation. A bracket that is not closed
// is reported whatever stopped the reading: the E0002 points at the innermost bracket that is not closed (§18.1, S-943,
// R-371). The same file without the item after the unit is unclosed_eof_r07_struct_bracket.onsa, and the report is on the same line.

struct S[T {                                    //~ E0002 @9
  a: T
}
fn z() -> I32 { 1 }
