// onsa.toml
// [test]
// spec = ["§2.4", "§18.1", "§7", "§4.5"]
// fixes = 0

// E0001 for a number with the prefix `0o` that holds a digit that is no octal digit, and for the prefix `0o`
// with no digit after it (spec §2.4, §18.1; S-451, S-965 R4). Onsa has no octal numbers, and `0o17` is the
// E0020 of fixes/e0020_numeric_leading_zero.onsa with the candidate `15`; a number with the prefix whose
// digits do not read in base 8 has no value to put in the candidate, so it is the E0001 of the token, on
// the line, with no candidate (`fixes = 0`). A number token is the longest run of letters, digits and `_`
// that starts with a digit, in every place a number can be written. The digits are counted without the `_`
// and the prefix may be `0o` or `0O`. One error per declaration (P-01).

pub struct S[const N: U32] {
  x: [I32; N],
}

fn takes(x: I32) -> I32 {
  x
}

pub fn a_nine() -> I32 {
  let n: I32 = 0o19                                 //~ E0001
  n
}

pub fn an_eight() -> I32 {
  let n: I32 = 0o8                                  //~ E0001
  n
}

pub fn a_nine_alone() -> I32 {
  let n: I32 = 0o9                                  //~ E0001
  n
}

pub fn an_eight_after_a_separator() -> I32 {
  let n: I32 = 0o1_8                                //~ E0001
  n
}

pub fn an_eight_after_octal_digits() -> I32 {
  let n: I32 = 0o17_8                               //~ E0001
  n
}

pub fn capital_prefix() -> I32 {
  let n: I32 = 0O19                                 //~ E0001
  n
}

pub fn under_a_minus() -> I32 {
  let n: I32 = -0o19                                //~ E0001
  n
}

pub fn prefix_alone() -> I32 {
  let n: I32 = 0o                                   //~ E0001
  n
}

pub fn capital_prefix_alone() -> I32 {
  let n: I32 = 0O                                   //~ E0001
  n
}

pub fn prefix_and_a_separator() -> I32 {
  let n: I32 = 0o_                                  //~ E0001
  n
}

pub fn prefix_and_separators() -> I32 {
  let n: I32 = 0o___                                //~ E0001
  n
}

pub fn in_an_argument() -> I32 {
  takes(0o19)                                       //~ E0001
}

pub fn in_an_array() -> [I32; 2] {
  [1, 0o19]                                         //~ E0001
}

pub fn in_a_pattern(x: I32) -> I32 {
  match x {
    0o19 => 1,                                      //~ E0001
    _ => 0,
  }
}

pub fn in_a_closure_body() -> I32 {
  let f = fn(y: I32) -> I32 { 0o8 }                 //~ E0001
  f.(1)
}

pub flow in_a_flow(x: F32 at sample) -> F32 at sample {
  x * 0o19                                          //~ E0001
}

const IN_A_CONST: I32 = 0o19                        //~ E0001

pub fn in_an_array_length(a: [I32; 0o19]) -> I32 {  //~ E0001
  1
}

pub flow in_a_param(
  x: F32 at sample,
  @param(min: 0o19, max: 2.0, default: 1.0)         //~ E0001
  level: F32 at block,
) -> F32 at sample {
  x * level
}

pub fn in_a_constant_type_argument(s: S[0o19]) -> I32 { //~ E0001
  1
}

pub fn in_a_constant_type_argument_with_no_digits(s: S[0o]) -> I32 { //~ E0001
  1
}

// The right forms.
pub fn fine() -> I32 {
  takes(7)
}
