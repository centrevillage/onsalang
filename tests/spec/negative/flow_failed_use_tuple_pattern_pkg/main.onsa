// A name that a failed `use` gives (here `Gone`, which `util` does not declare: E0302 at the `use`) is of
// the error type, and a part that could not be read gets no diagnostic where it is used (§18.1, R-271).
// A tuple pattern or the unit pattern `()` (§7, S-516) of a `let` in a flow body against a value of that
// type is such a use: its elements are of the error type too, and the check of the flow goes on after
// it. So the flows below report nothing of the pattern, and the last one reports the E0401 of the
// `let` after the pattern. The same forms in a fn body are silent too. One error per unit.

use util.{Gone} //~ E0302

pub flow unit_pattern(x: Gone at sample, y: F32 at sample) -> F32 at sample {
  let () = x
  y
}

pub flow pair_pattern(x: Gone at sample, y: F32 at sample) -> F32 at sample {
  let (p, q) = x
  y
}

pub flow nested_pattern(x: Gone at sample, y: F32 at sample) -> F32 at sample {
  let ((), (r, _)) = x
  y
}

pub flow goes_on_after_the_pattern(x: Gone at sample, y: F32 at sample) -> F32 at sample {
  let () = x
  let a: I32 = true //~ E0401
  y
}

pub fn unit_pattern_in_a_fn(x: Gone) -> I32 {
  let () = x
  1
}
