// onsa.toml
// [test]
// spec = ["§4.1", "§15.1", "§18.1"]
// fixes = 0

// S-607, R-249, §4.1, §15.1: a function that is not a variant of the prelude and not a name of the type
// either, called after `Option` or `Result` (`Option.Foo(1)`), is a name that is not found in the type: E0302 in
// the names stage, as the same name read or in a pattern is (`prelude_type_member_unknown.onsa`). It is not
// E0413 ("does not exist", the code of a name after a value). No fix candidate: taking off the type would
// leave `Foo`, which no name gives, an error of the same stage (the contract of the candidates, §18.1). One
// error in each unit (§18.1).

pub fn a_call() -> Option[I32] {
  Option.Foo(1)                                     //~ E0302
}

pub fn a_call_with_no_arguments() -> Option[I32] {
  Option.foo()                                      //~ E0302
}

pub fn a_call_of_result() -> Result[I32, I32] {
  Result.Foo(1)                                     //~ E0302
}

pub fn a_call_of_result_with_two_arguments() -> Result[I32, I32] {
  Result.foo(1, 2)                                  //~ E0302
}
