// onsa.toml
// [test]
// spec = ["§9.1", "§18.1", "§10", "§6.1"]
// fixes = 0

// E0413, R-96 (W5-03 U2/t; spec §9.1: the methods of `Option` and `Result` are `unwrap` and `map_err` only): the places where a name that
// they do not have is written. A body, an `rt` function (E0413 is the one error: the method is not there, so there is no call to
// judge by §10 rule 4), a generic body whose content is a type parameter (a plain one and `?Dup`), a method of a user's type, a chain
// of calls, a `test` body, the condition of an `if` and of a `while`, a guard of a `match`, the right side of a `let`, an argument, an
// operand of `&&`, an anonymous function and a `const`. The receiver is an `Option` or a `Result`. One error per function (P-01).

use std.array

pub struct Gate {
  o: Option[U32],
  r: Result[U32, U32],
}

impl Gate {
  pub fn open(self) -> Bool {
    self.o.is_some()                           //~ E0413
  }

  pub fn clean(self) -> Bool {
    self.r.is_ok()                             //~ E0413
  }
}

fn takes(b: Bool) -> U32 {
  if b { 1 } else { 0 }
}

pub fn in_a_body(o: Option[U32]) -> Bool {
  o.is_some()                                  //~ E0413
}

pub rt fn in_an_rt_function(o: Option[U32]) -> Bool {
  o.is_none()                                  //~ E0413
}

pub rt fn in_an_rt_function_result(r: Result[U32, U32]) -> U32 {
  r.unwrap_or(0)                               //~ E0413
}

pub fn in_a_generic_body[T](o: Option[T]) -> Bool {
  o.is_some()                                  //~ E0413
}

pub fn in_a_generic_body_unwrap_or[T](o: Option[T], d: T) -> T {
  o.unwrap_or(d)                               //~ E0413
}

pub fn in_a_generic_result_body[T, E](r: Result[T, E]) -> Bool {
  r.is_err()                                   //~ E0413
}

pub fn in_a_generic_body_owned[T: ?Dup](move o: Option[T]) -> Bool uses {Alloc} {
  o.is_some()                                  //~ E0413
}

pub fn in_a_generic_result_body_owned[T: ?Dup, E: ?Dup](move r: Result[T, E]) -> Bool uses {Alloc} {
  r.is_ok()                                    //~ E0413
}

pub fn in_a_chain_after_unwrap(oo: Option[Option[U32]]) -> Bool {
  oo.unwrap().is_some()                        //~ E0413
}

pub fn in_a_chain_before_unwrap(o: Option[Option[U32]]) -> U32 {
  o.unwrap_or(None).unwrap()                   //~ E0413
}

pub fn in_a_condition(o: Option[U32]) -> U32 {
  if o.is_some() {                             //~ E0413
    1
  } else {
    0
  }
}

pub fn in_an_else_if_condition(c: Bool, r: Result[U32, U32]) -> U32 {
  if c {
    1
  } else if r.is_ok() {                        //~ E0413
    2
  } else {
    3
  }
}

pub fn in_a_while_condition(o: Option[U32]) -> U32 {
  var n: U32 = 0
  while n < 3 && o.is_some() {                 //~ E0413
    n = n + 1
  }
  n
}

pub fn in_a_guard(o: Option[U32], r: Result[U32, U32]) -> U32 {
  match o {
    Some(v) if r.is_ok() => v,                 //~ E0413
    Some(_) => 1,
    None => 0,
  }
}

pub fn in_a_let(o: Option[U32]) -> U32 {
  let b = o.is_none()                          //~ E0413
  takes(b)
}

pub fn in_an_argument(o: Option[U32]) -> U32 {
  takes(o.is_some())                           //~ E0413
}

pub fn in_an_operand(c: Bool, o: Option[U32]) -> Bool {
  c && o.is_some()                             //~ E0413
}

pub fn in_a_negation(r: Result[U32, U32]) -> Bool {
  !r.is_err()                                  //~ E0413
}

pub fn in_a_return(o: Option[U32]) -> Bool {
  return o.is_some()                           //~ E0413
}

pub fn in_an_anonymous_function(os: [Option[U32]; 2]) -> [U32; 2] {
  array.from_fn(fn(i: U32) -> U32 { os[i].unwrap_or(0) })   //~ E0413
}

pub fn in_a_for_loop(os: [Option[U32]; 2]) -> U32 {
  var n: U32 = 0
  for i in 0 ..< 2 {
    n = n + takes(os[i].is_some())             //~ E0413
  }
  n
}

const GATE: Option[U32] = Some(1)
const GATE_IS_SOME: Bool = GATE.is_some()      //~ E0413

test "a test body writes is_some" {
  let o: Option[U32] = Some(1)
  assert o.is_some()                           //~ E0413
}

test "a test body writes is_err" {
  let r: Result[U32, U32] = Err(2)
  assert r.is_err()                            //~ E0413
}

test "a test body writes unwrap_or" {
  let o: Option[U32] = None
  assert o.unwrap_or(5) == 5                   //~ E0413
}
