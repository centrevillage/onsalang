// onsa.toml
// [test]
// spec = ["§5.2"]
// fixes = 1

// S-609 (§5.2): the other side of values/move_dup_args.onsa. "`move` 引数に渡す Dup 値（Copy、Shared、関数値の
// 変数）には `move` を書かず … 書くと E0703 で、修正候補はその `move` を消す形である（ブロックの末尾も同じで、
// 末尾ごとに一件）". The mark on a Copy variable, a field path of a Copy value, a Copy struct, a Shared
// value, a function value in a variable, and on the tail of a block placed at the argument (`if`, `match`,
// a block expression) is an E0703 with one candidate that removes the `move`. The tail forms have one
// `move` each, so one candidate each. The error is at the argument that has the mark. One error per
// function (P-01).

pub struct Pt {
  x: I32,
  y: I32,
}

pub struct Gain {
  n: U32,
  name: Str,
}

pub fn inc(x: I32) -> I32 {
  x + 1
}

pub fn tk(move n: U32) -> U32 {
  n
}

pub fn tp(move p: Pt) -> I32 {
  p.x + p.y
}

pub fn ts(move s: Str) -> U32 uses {Alloc} {
  s.len()
}

pub fn ap(move f: fn(I32) -> I32) -> I32 {
  f.(1)
}

// ------------------------------------------------------------------------- the variable

pub fn copy_variable(n: U32) -> U32 {
  tk(n) //~ E0703
}

pub fn copy_var(start: U32) -> U32 {
  var n = start
  n = n + 1
  tk(n) //~ E0703
}

pub fn copy_field_path(g: Gain) -> U32 {
  tk(g.n) //~ E0703
}

pub fn copy_struct(p: Pt) -> I32 {
  tp(p) //~ E0703
}

pub fn shared_variable(s: Str) -> U32 uses {Alloc} {
  ts(s) //~ E0703
}

pub fn function_value_variable(move f: fn(I32) -> I32) -> I32 {
  ap(f) //~ E0703
}

pub fn function_value_in_a_let() -> I32 {
  let g = inc
  ap(g) //~ E0703
}

// ----------------------------------------------------------------- tails of a block

pub fn tail_of_an_if(c: Bool, n: U32) -> U32 {
  tk(if c { n } else { 0 }) //~ E0703
}

pub fn tail_of_the_else(c: Bool, n: U32) -> U32 {
  tk(if c { 0 } else { n }) //~ E0703
}

pub fn tail_of_a_match(c: Bool, n: U32) -> U32 {
  tk(match c {
    true => n, //~ E0703
    false => 0,
  })
}

pub fn tail_of_a_block(n: U32) -> U32 {
  tk({ n }) //~ E0703
}

pub fn tail_of_a_shared_if(c: Bool, s: Str) -> U32 uses {Alloc} {
  ts(if c { s } else { "x" }) //~ E0703
}
