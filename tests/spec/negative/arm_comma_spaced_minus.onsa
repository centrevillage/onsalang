// onsa.toml
// [test]
// spec = ["§2.5", "§7", "§18.1"]

// E0002 for an arm without its `,` before a line that starts with `-` and a space (spec §2.5, S-386,
// S-236). The line is the head of the next arm (the move of the `-` to the end of the line before would
// end it at the `=>`, as in tests/spec/fixes/e0002_arm_comma_before_leading.onsa), but a `,` inserted
// leaves the E0020 of the space after the prefix `-`, so no candidate is made; the general syntax error
// stands with no candidate (§2.5: "`- 1` ... a candidate is not made"). The main position is the `-` that starts
// the line, so the marker is on its line. One error in each declaration unit.

pub fn after_a_block_body(x: I32) -> I32 {
  match x {
    0 => { 1 }
    - 1 => 2,                                       //~ E0002
    _ => 0,
  }
}

pub fn after_a_plain_body(x: I32) -> I32 {
  match x {
    0 => 2
    - 1 => 3,                                       //~ E0002
    _ => 0,
  }
}

pub fn after_a_name_body(x: I32, a: I32) -> I32 {
  match x {
    0 => a
    - 1 => 2,                                       //~ E0002
    _ => 0,
  }
}

pub fn after_a_comment(x: I32) -> I32 {
  match x {
    0 => 2 // two
    - 1 => 3,                                       //~ E0002
    _ => 0,
  }
}

pub fn in_a_match_in_a_call(x: I32) -> I32 {
  id(match x {
    0 => { 1 }
    - 1 => 2,                                       //~ E0002
    _ => 0,
  })
}

pub fn id(x: I32) -> I32 {
  x
}
