// onsa.toml
// [test]
// spec = ["§2.6", "§11.2", "§11.5", "§18.1"]

// Something with state (an instance, a built-in delay, a `par`) where only one side is evaluated
// (§11.5, S-110): in a branch or in the guard of a plain `if` / `match` it is E0811 ("枝と `match` の
// ガードには、状態を持つもの … を書けない（E0811）。条件と `match` の対象は常に評価されるので書ける"),
// and on the right of `&&` / `||` it is E0806 ("`&&` / `||` の右辺には、状態を持つものを書けない
// （E0806。修正候補は前の `let` に出すこと）"). `if~` / `match~` evaluate every branch, so a branch of
// those may hold state, and a plain `if` without state inside an `if~` branch is fine (the last flow).
// One error per flow; the marker is on the line of the offending construct. The spec does not fix the
// column of the primary position, so the markers carry no column.

pub flow acc(x: F32 at sample) -> F32 at sample {
  let y = x + prev~(^y)
  y
}

pub rt fn wrap(x: F32) -> F32 {
  x
}

// ---- E0811: a branch of a plain `if` ----

pub flow else_branch_with_state(x: F32 at sample) -> F32 at sample {
  if x > 0.0 { 1.0 } else { acc~(x) }                             //~ E0811
}

pub flow else_if_branch_with_state(x: F32 at sample) -> F32 at sample {
  if x > 1.0 { 1.0 } else if x > 0.0 { acc~(x) } else { 0.0 }    //~ E0811
}

pub flow constant_condition_with_state(x: F32 at sample) -> F32 at sample {
  if true { acc~(x) } else { 0.0 }                                //~ E0811
}

pub flow delay_in_a_branch(x: F32 at sample) -> F32 at sample {
  if x > 0.0 { delay~(x, 2) } else { 0.0 }                        //~ E0811
}

pub flow vdelay_in_a_branch(x: F32 at sample) -> F32 at sample {
  if x > 0.0 { vdelay~(x, 2.0, 4) } else { 0.0 }                  //~ E0811
}

pub flow state_inside_a_call_in_a_branch(x: F32 at sample) -> F32 at sample {
  if x > 0.0 { wrap(prev~(x)) } else { 0.0 }                      //~ E0811
}

pub flow state_inside_an_array_in_a_branch(x: F32 at sample) -> F32 at sample {
  if x > 0.0 { [prev~(x), x][0] } else { 0.0 }                    //~ E0811
}

// ---- E0811: nested branches ----

pub flow nested_if_with_state(x: F32 at sample) -> F32 at sample {
  if x > 0.0 { if x > 1.0 { acc~(x) } else { 0.0 } } else { 0.0 }   //~ E0811
}

pub flow plain_if_with_state_inside_an_if_tilde(x: F32 at sample) -> F32 at sample {
  if~ x > 0.0 { if x > 1.0 { acc~(x) } else { 0.0 } } else { acc~(x) }   //~ E0811
}

pub flow if_inside_a_match_arm(k: U32 at sample, x: F32 at sample) -> F32 at sample {
  match k { 0 => if x > 0.0 { acc~(x) } else { 0.0 }, _ => 0.0 }  //~ E0811
}

pub flow match_inside_an_if_branch(k: U32 at sample, x: F32 at sample) -> F32 at sample {
  if x > 0.0 { match k { 0 => prev~(x), _ => 0.0 } } else { 0.0 } //~ E0811
}

// ---- E0811: an arm and a guard of a plain `match` ----

pub flow arm_with_a_delay(k: U32 at sample, x: F32 at sample) -> F32 at sample {
  match k { 0 => 1.0, _ => prev~(x) }                             //~ E0811
}

pub flow guard_with_an_instance(k: U32 at sample, x: F32 at sample) -> F32 at sample {
  match k {
    0 if acc~(x) > 1.0 => 1.0,                                    //~ E0811
    _ => 0.0,
  }
}

pub flow guard_with_a_delay(k: U32 at sample, x: F32 at sample) -> F32 at sample {
  match k {
    _ if prev~(x) > 0.0 => 1.0,                                   //~ E0811
    _ => 0.0,
  }
}

pub flow guard_with_state_after_a_plain_arm(k: U32 at sample, x: F32 at sample) -> F32 at sample {
  match k {
    0 => 2.0,
    1 if delay~(x, 2) > 0.5 => 1.0,                               //~ E0811
    _ => 0.0,
  }
}

// ---- E0811: inside a `par` body ----

pub flow if_in_a_par_body(x: F32 at sample) -> F32 at sample {
  let xs = par i in 0..<2 {
    if x > 0.0 { acc~(x) * i.round_f32() } else { 0.0 }           //~ E0811
  }
  xs[0]
}

pub flow match_in_a_par_body(k: U32 at sample, x: F32 at sample) -> F32 at sample {
  let xs = par i in 0..<2 {
    match k { 0 => prev~(x) * i.round_f32(), _ => 0.0 }           //~ E0811
  }
  xs[1]
}

// ---- E0806: the right side of && and || ----

pub flow nested_or_with_state(x: F32 at sample) -> F32 at sample {
  let hit = x > 0.0 && (x > 1.0 || acc~(x) > 1.0)                 //~ E0806
  if hit { 1.0 } else { 0.0 }
}

pub flow chained_and_with_state(x: F32 at sample) -> F32 at sample {
  let hit = x > 0.0 && x < 1.0 && prev~(x) > 0.0                  //~ E0806
  if hit { 1.0 } else { 0.0 }
}

pub flow or_with_a_delay(x: F32 at sample) -> F32 at sample {
  let hit = x > 0.0 || delay~(x, 2) > 1.0                         //~ E0806
  if hit { 1.0 } else { 0.0 }
}

pub flow right_side_state_inside_a_call(x: F32 at sample) -> F32 at sample {
  let hit = x > 0.0 || wrap(acc~(x)) > 1.0                        //~ E0806
  if hit { 1.0 } else { 0.0 }
}

pub flow right_side_state_in_an_if_tilde_condition(x: F32 at sample) -> F32 at sample {
  if~ x > 0.0 && acc~(x) > 1.0 { 1.0 } else { acc~(x) }           //~ E0806
}

pub flow right_side_state_in_a_par_body(x: F32 at sample) -> F32 at sample {
  let flags = par i in 0..<2 {
    x > 0.0 && acc~(x) > i.round_f32()                            //~ E0806
  }
  if flags[0] { 1.0 } else { 0.0 }
}

// ---- Not errors ----

// An `if~` branch may hold state (every branch is evaluated); the plain `if` inside it holds none,
// and takes only the branch it needs, so the division by `d` happens only when `d` is not 0
// (the example of §11.5).
pub flow if_tilde_with_a_plain_if(c: Bool at sample, d: I32 at sample, x: F32 at sample) -> F32 at sample {
  if~ c { acc~(x) } else { if d != 0 { (100 / d).round_f32() } else { 0.0 } }
}

// The condition, the scrutinee and the left operand are always evaluated and may hold state.
pub flow state_where_it_is_always_evaluated(x: F32 at sample, k: U32 at sample) -> F32 at sample {
  let hit = acc~(x) > 1.0 && x > 0.0
  let m   = match prev~(k) { 0 => 1.0, _ => 2.0 }
  if prev~(x) > 0.0 && hit { m } else { 0.0 }
}
