// onsa.toml
// [test]
// spec = ["§7", "§18.1"]

// E0002, with no candidate, for the patterns that have a guard form as a candidate when the alternatives of a
// choice have a comment between them (spec §7, §18.1; S-251, S-317; the rows `float_pattern_choice` and
// `range_pattern_choice` of spec/foreign-forms.toml). The candidate puts the alternatives together in one
// guard and takes the later alternatives away, and a comment that stands in what it takes away would go with it,
// so there is no candidate (a comment is not in the range of an edit, §18.1). The code stays E0002 and the main
// message is the one of the form (a float literal cannot be a pattern, and these alternatives do not merge into
// one guard); the note says that the comment is why there is no candidate (the text of the note is the
// implementation's, and the runner of the cases does not compare it). The comment is the marker itself. The
// main position is the start of the pattern. One error in each declaration unit (P-01).

pub fn a_comment_at_the_end_of_the_alternative(x: F32) -> I32 {
  match x {
    1.0 //~ E0002
    | 2.0 => 1,
    _ => 0,
  }
}

pub fn a_comment_after_the_bar(x: F32) -> I32 {
  match x {
    1.0 | //~ E0002
    2.0 => 1,
    _ => 0,
  }
}

pub fn a_comment_between_ranges(x: I32) -> I32 {
  match x {
    1..<3 | //~ E0002
    7..<9 => 1,
    _ => 0,
  }
}

const LIMIT: I32 = 4
const OTHER: I32 = 9

pub fn a_comment_between_negated_constants(x: I32) -> I32 {
  match x {
    -LIMIT | //~ E0002
    -OTHER => 1,
    _ => 0,
  }
}
