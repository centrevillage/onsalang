// onsa.toml
// [test]
// spec = ["§18.1", "§2.5"]
// fixes = 0

// The members are closed and the `impl` is not: the `{` of the `impl` (N8).
// The unit is the last one of the file, so it ends at the end of the file. A bracket that is not closed is reported whatever
// stopped the reading: the E0002 points at the innermost bracket that is not closed (§18.1, S-943, R-371). The same file
// with an item after the unit is unclosed_next_n08_impl_only.onsa, and the report is on the same line.

struct S { v: I32 }
impl S {                                        //~ E0002 @8
  fn a(self) -> I32 { self.v }
