// onsa.toml
// [test]
// spec = ["§18.1", "§2.5"]
// fixes = 0

// `flow f(a: F32 at sample -> ...`: the `)` is missing, and the reading stops at the `->` (R8).
// The unit is the last one of the file, so it ends at the end of the file. A bracket that is not closed is reported whatever
// stopped the reading: the E0002 points at the innermost bracket that is not closed (§18.1, S-943, R-371). The same file
// with an item after the unit is unclosed_next_r08_flow_paren.onsa, and the report is on the same line.

flow f(a: F32 at sample -> F32 at sample {      //~ E0002 @7
  a
}
