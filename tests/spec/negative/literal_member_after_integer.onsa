// onsa.toml
// [test]
// spec = ["§2.4", "§4.7", "§6.1", "§18.1"]

// E0420 for a method called on a literal whose type is open (spec §4.7: the receiver of a method has a known
// type when the call is read; a literal is a type variable until the end of the function or a later
// statement decides it, so the receiver is unresolved), which tells that the `.` after the digits is the
// member's `.` and not a point (spec §2.4, S-350): a `.` after the digits of an integer, followed by a name, is
// a member, so there is no E0020 for `1.` and no E0002 for the name that follows. The call of an integer as
// a function value (`1.(x)`) is a member's `.` too; the code of its type error is for W4 / W5 and is not
// written here. The marker is the line only. One error per declaration (P-01).

pub fn method_on_an_integer() -> I32 {
  let a = 1.abs()                                   //~ E0420
  a
}

pub fn method_on_a_separated_integer() -> I32 {
  let a = 1_000.abs()                               //~ E0420
  a
}

pub fn method_on_zero() -> I32 {
  let a = 0.abs()                                   //~ E0420
  a
}

pub fn method_on_a_hexadecimal() -> I32 {
  let a = 0x1F.abs()                                //~ E0420
  a
}

pub fn method_on_a_binary() -> I32 {
  let a = 0b11.abs()                                //~ E0420
  a
}

pub fn method_with_an_argument() -> I32 {
  let a = 1.max(2)                                  //~ E0420
  a
}

pub fn method_whose_name_starts_with_e() -> I32 {
  let a = 1.exp()                                   //~ E0420
  a
}

pub fn method_named_e() -> I32 {
  let a = 1.e()                                     //~ E0420
  a
}

pub fn method_on_a_float() -> F32 {
  let a = 1.5.abs()                                 //~ E0420
  a
}

pub fn method_on_a_float_with_an_exponent() -> F32 {
  let a = 48e3.abs()                                //~ E0420
  a
}

pub fn method_on_an_integer_in_an_argument() -> I32 {
  id(1.abs())                                       //~ E0420
}

pub fn method_on_an_integer_in_a_closure_body() -> I32 {
  let f = fn(y: I32) -> I32 { 1.abs() }             //~ E0420
  f.(1)
}

pub fn method_on_an_integer_in_a_block_in_a_block() -> I32 {
  let r: I32 = {
    let s: I32 = {
      1.abs()                                       //~ E0420
    }
    s
  }
  r
}

pub flow method_on_an_integer_in_a_flow(x: F32 at sample) -> F32 at sample {
  let a = 1.abs()                                   //~ E0420
  x
}

fn id(x: I32) -> I32 {
  x
}

// A literal with a known type, and an integer that is not a receiver.
pub fn fine(x: I32, t: (I32, I32)) -> I32 {
  let a: I32 = 1
  let b = a.abs()
  let c = t.0.abs()
  let d = x.max(2)
  b + c + d
}
