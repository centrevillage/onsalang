// onsa.toml
// [test]
// spec = ["§5.4", "§5.1", "§5.3", "§18.1"]
// fixes = 0

// S-798, R-161 (§5.4, §18.1): a `let` is read-only (§5.1), so a write to the place of a borrowed `for` that is
// a `let` is the E0701 of the write, whether or not a loop iterates the place ("書けない場所の E0701 を先にし"),
// and the E0715 is not reported as well. And no candidate is given (`fixes = 0`): the candidate "change `let`
// to `var`" of the E0701 of an assignment to a `let` is not given when the place is iterated by a borrowed
// `for` of the body, because the program with the `var` is the E0715 of negative/for_borrowed_change.onsa, an
// error of the same stage that the candidate must not leave ("同じ段かそれより前の段の診断を残さない", §18.1).
// The borrowed argument and the value a closure captures are in negative/for_borrowed_change_readonly.onsa
// (the same E0701 without a candidate). One error per function (P-01).

pub fn reset(inout xs: [U32; 2]) {
  xs[0] = 0
}

pub fn assign_to_an_element_of_a_let() {
  let xs: [U32; 2] = [1 + 1, 2]
  for _ in xs {
    xs[0] = 1 //~ E0701
  }
}

pub fn assign_to_the_whole_of_a_let() {
  let xs: [U32; 2] = [1 + 1, 2]
  for _ in xs {
    xs = [3, 4] //~ E0701
  }
}

pub fn pass_a_let_as_inout() {
  let xs: [U32; 2] = [1 + 1, 2]
  for _ in xs {
    reset(inout xs) //~ E0701
  }
}

pub fn call_a_bang_method_on_a_let() {
  let b: [F32; 2] = [1.0 + 1.0, 2.0]
  for _ in b {
    b.fill!(0.0) //~ E0701
  }
}

pub fn let_iterated_by_an_if_heading(c: Bool) {
  let a: [U32; 2] = [1 + 1, 2]
  let b: [U32; 2] = [3, 4]
  for _ in if c { a } else { b } {
    a[0] = 1 //~ E0701
  }
}
