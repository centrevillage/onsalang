pub fn method_base_static() -> I32 {
  static.get()  //~ E0200 @3
}

pub fn array_element_static() -> I32 {
  let xs = [1, static]  //~ E0200 @16
  1
}

pub fn index_base_static() -> I32 {
  static[0]  //~ E0200 @3
}

pub fn condition_static() -> I32 {
  if static { 1 } else { 2 }  //~ E0200 @6
