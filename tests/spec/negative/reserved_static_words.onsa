pub fn return_value_static() -> I32 {
  return static  //~ E0200 @10
}

pub flow flow_call_static(x: F32 at sample) -> F32 at sample {
  let y = static~(x)  //~ E0200 @11
  y
}

pub flow clock_annotation_static(x: F32 at sample) -> F32 at sample {
  let y = x at static  //~ E0200 @16
  y
}

pub flow input_clock_static(x: F32 at static) -> F32 at sample {  //~ E0200 @39
  x
}

pub flow output_clock_static(x: F32 at sample) -> F32 at static {  //~ E0200 @58
  x
}

pub flow par_body_static(x: F32 at sample) -> F32 at sample {
  let xs = par~ i in 0..<2 {
    static  //~ E0200 @5
  }
  xs[0]
}

pub fn nested_block_static(c: Bool) -> I32 {
  if c {
    if c {
      let y = static  //~ E0200 @15
    }
  }
  1
}

pub fn closure_body_static() -> I32 {
  let f = fn(a: I32) -> I32 { static }  //~ E0200 @31
  1
