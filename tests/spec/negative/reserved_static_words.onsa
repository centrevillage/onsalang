pub fn generic_function_static[T](x: T) -> I32 {
  let y = static  //~ E0200 @11
  1
}

pub fn match_arm_body_static(n: I32) -> I32 {
  match n {
    0 => static,  //~ E0200 @10
    _ => 1,
  }
}

test "assert_operand_static" {
  assert static == 1  //~ E0200 @10
}

// ---- the word in a string hole or behind `^` (the marker is the line)

pub fn hole_head_static(a: I32) -> Str uses {Alloc} {
  "{static}"  //~ E0200
}

pub fn hole_head_field_static() -> Str uses {Alloc} {
  "{static.a}"  //~ E0200
}

pub fn hole_after_text_static(a: I32) -> Str uses {Alloc} {
  "x {a} y {static}"  //~ E0200
}

pub flow feedback_reference_static(x: F32 at sample) -> F32 at sample {
  let y = x + 0.5 * prev~(^static)  //~ E0200
  y
}

// ---- an element of the list of a `use`

use kp.{static}  //~ E0200 @9

use kp.{a, static}  //~ E0200 @12

use kp.{static, a}  //~ E0200 @9

use kp.sub.{static}  //~ E0200 @13

use kp.{a, b, static, c}  //~ E0200 @15

// ---- after a `.` the word is a name: no field of that name (E0413), not the E0200 of the syntax stage

pub fn after_dot_static(h: Holder) -> I32 {
  h.static  //~ E0413
}

pub fn after_dot_chain_static(h: Holder) -> I32 {
  h.a.static  //~ E0413
}

