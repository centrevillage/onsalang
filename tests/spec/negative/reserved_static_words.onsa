// onsa.toml
// [test]
// spec = ["§2.2", "§2.3", "§11.3", "§18.1"]

// (S-615.) E0200: `static` is a reserved word (§2.2), like `clock` and `ser` (negative/reserved_words.onsa, which
// has the same places word by word). It cannot be the name of a declaration, and this version does not read it as syntax
// either: the error is E0200 at the place the word stands (the marker has the column of the word), in the
// syntax stage (so `onsa fmt` stops at it, §18.2) and not the E0302 of an unknown name. After a `.` and at
// the head of a `use` path the word is read as a name like the other keywords (a later stage says E0413 for
// `h.static`; the module `static.onsa` is in packages/reserved_static_use_head_ok). The head of an item
// (`static fn h`) is E0002 as before (continue_foreign_words.onsa). One error per function or declaration.
// A name that only starts with the word (`static_rate`, `statics`) is an ordinary name
// (lex/reserved_static_prefix_names.onsa). The places: the name of a declaration, a binding, a parameter,
// a field, a variant, a type parameter, a method; a pattern; an expression, a call, a type position, a
// clock annotation; a string hole; the list of a `use`.

pub struct Holder {
  a: I32,
}

pub fn pair() -> (I32, I32) {
  (1, 2)
}

pub fn id(a: I32) -> I32 {
  a
}

// ---- the name of a declaration, a binding, a parameter or a field

pub fn static() -> I32 {  //~ E0200 @8
  1
}

pub fn let_static() -> I32 {
  let static = 1  //~ E0200 @7
  1
}

pub fn var_static() -> I32 {
  var static = 1  //~ E0200 @7
  1
}

pub fn first_param_static(static: I32) -> I32 {  //~ E0200 @27
  1
}

pub fn second_param_static(a: I32, static: I32) -> I32 {  //~ E0200 @36
  a
}

pub struct static {  //~ E0200 @12
  a: I32,
}

pub struct FieldHolder_static {
  a: I32,
  static: I32,  //~ E0200 @3
}

pub enum static {  //~ E0200 @10
  A,
  B,
}

pub const static: U32 = 1  //~ E0200 @11

pub type static = I32  //~ E0200 @10

pub flow static(x: F32 at sample) -> F32 at sample {  //~ E0200 @10
  x
}

pub flow flow_input_static(static: F32 at sample) -> F32 at sample {  //~ E0200 @28
  static
}

pub flow flow_second_input_static(x: F32 at sample,
  static: F32 at sample) -> F32 at sample {  //~ E0200 @3
  x
}

impl Holder {
  pub fn static(self) -> I32 {  //~ E0200 @10
    1
  }
}

pub fn for_static() -> I32 {
  for static in 0..<2 {  //~ E0200 @7
    1
  }
  1
}

pub fn match_static(n: I32) -> I32 {
  match n {
    static => 1,  //~ E0200 @5
  }
}

pub fn payload_static(o: Option[I32]) -> I32 {
  match o {
    Some(static) => 1,  //~ E0200 @10
    None => 0,
  }
}

pub fn tuple_pattern_static(t: (I32, I32)) -> I32 {
  match t {
    (a, static) => a,  //~ E0200 @9
  }
}

pub fn struct_pattern_static(h: Holder) -> I32 {
  match h {
    Holder { a: static } => 1,  //~ E0200 @17
  }
}

pub fn let_tuple_static() -> I32 {
  let (a, static) = pair()  //~ E0200 @11
  a
}

pub fn closure_static() -> I32 {
  let f = fn(static: I32) -> I32 { 1 }  //~ E0200 @14
  1
}

pub fn closure_second_static() -> I32 {
  let f = fn(a: I32, static: I32) -> I32 { a }  //~ E0200 @22
  1
}

// ---- an expression, a call, a clock annotation: where the word stands

pub fn operand_static() -> I32 {
  let y = static + 1  //~ E0200 @11
  y
}

pub fn right_operand_static(x: I32) -> I32 {
  x + static  //~ E0200 @7
}

pub fn last_expression_static() -> I32 {
  static  //~ E0200 @3
}

pub fn call_callee_static() -> I32 {
  static(1)  //~ E0200 @3
}

pub fn argument_static() -> I32 {
  id(static)  //~ E0200 @6
}

pub fn field_base_static() -> I32 {
  static.a  //~ E0200 @3
