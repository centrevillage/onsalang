// onsa.toml
// [test]
// spec = ["§4.7", "§2.4", "§3.4"]

// E0408 / E0401 for integer literals in the spellings of hexadecimal, binary and separated digits (spec §4.7, §2.4;
// S-184, S-62). The range of an integer literal is checked on the value with the prefix `-` written directly on
// it, whatever the spelling of the digits is, and the parentheses between the `-` and the literal are not seen:
// `-0x80` is the least I8 and `-0x81` is out of range, `-(0x81)` the same. An unsigned type has no unary minus:
// a negative literal for it is E0401 (§3.4). The same cases in decimal are in negative/literal_range.onsa; the
// values that fit are in lex/numeric_spellings.onsa. One error per declaration (P-01).

pub struct Cell {
  lo: I8,
}

fn takes_i8(x: I8) -> I8 {
  x
}

fn takes_u8(x: U8) -> U8 {
  x
}

// ---------------------------------------------------------------- E0408

pub fn hexadecimal_below() -> I8 {
  let x: I8 = -0x81                                 //~ E0408
  x
}

pub fn hexadecimal_below_with_a_capital_prefix() -> I8 {
  let x: I8 = -0X81                                 //~ E0408
  x
}

pub fn hexadecimal_below_in_parentheses() -> I8 {
  let x: I8 = -(0x81)                               //~ E0408
  x
}

pub fn hexadecimal_above() -> I8 {
  let x: I8 = 0x80                                  //~ E0408
  x
}

pub fn binary_below() -> I8 {
  let x: I8 = -0b1000_0001                          //~ E0408
  x
}

pub fn binary_above() -> I8 {
  let x: I8 = 0b1000_0000                           //~ E0408
  x
}

pub fn separated_below() -> I8 {
  let x: I8 = -1_29                                 //~ E0408
  x
}

pub fn separated_above() -> U8 {
  let x: U8 = 2__56                                 //~ E0408
  x
}

pub fn unsigned_above() -> U8 {
  let x: U8 = 0x100                                 //~ E0408
  x
}

pub fn unsigned_binary_above() -> U8 {
  let x: U8 = 0b1_0000_0000                         //~ E0408
  x
}

pub fn i64_below() -> I64 {
  let x: I64 = -0x8000_0000_0000_0001               //~ E0408
  x
}

pub fn i64_above() -> I64 {
  let x: I64 = 0x8000_0000_0000_0000                //~ E0408
  x
}

pub fn in_an_argument() -> I8 {
  takes_i8(-0x81)                                   //~ E0408
}

pub fn in_a_field() -> Cell {
  Cell { lo: -0b1000_0001 }                         //~ E0408
}

pub fn in_an_array() -> [I8; 2] {
  [-0x80, -0x81]                                    //~ E0408
}

pub fn in_a_tuple() -> (I8, U8) {
  (0x7F, 0x100)                                     //~ E0408
}

pub fn in_a_branch(flag: Bool) -> I8 {
  if flag { 1 } else { 0x80 }                       //~ E0408
}

pub fn in_a_closure_body() -> I8 {
  let f = fn(y: I8) -> I8 { -0x81 }                 //~ E0408
  f.(1)
}

pub fn decided_later(flag: Bool) -> I8 {
  let a = if flag { -0x81 } else { 1 }              //~ E0408
  takes_i8(a)
}

pub flow in_a_flow(x: I8 at sample) -> I8 at sample {
  x +% 0x80                                         //~ E0408
}

const IN_A_CONST: I8 = -0x81                        //~ E0408

// ---------------------------------------------------------------- E0401

pub fn unsigned_hexadecimal() -> U8 {
  let x: U8 = -0x1                                  //~ E0401
  x
}

pub fn unsigned_hexadecimal_in_parentheses() -> U8 {
  let x: U8 = -(0xFF)                               //~ E0401
  x
}

pub fn unsigned_binary() -> U8 {
  let x: U8 = -0b1                                  //~ E0401
  x
}

pub fn unsigned_separated() -> U32 {
  let x: U32 = -1_0                                 //~ E0401
  x
}

pub fn unsigned_with_a_capital_prefix() -> U8 {
  let x: U8 = -0XFF                                 //~ E0401
  x
}

pub fn unsigned_argument() -> U8 {
  takes_u8(-0x1)                                    //~ E0401
}

pub fn unsigned_array() -> [U8; 2] {
  [1, -0b10]                                        //~ E0401
}

// ---------------------------------------------------------------- the values that fit

pub fn fine() -> I8 {
  let a: I8 = -0x80
  let b: I8 = -0X80
  let c: I8 = -(0x80)
  let d: I8 = -0b1000_0000
  let e: I8 = 0x7F
  let f: I8 = -1_28
  let g: U8 = 0xFF
  let h: U8 = 2__55
  let i: I64 = -0x8000_0000_0000_0000
  takes_i8(-0x80) + a + b + c + d + e + f
}
