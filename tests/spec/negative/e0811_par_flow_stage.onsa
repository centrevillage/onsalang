// [[test.fix]]
// at = "59:12"
// code = "E0811"
// candidate = 1
// leaves = ["60:11 E0815"]
//
// [[test.fix]]
// at = "65:18"
// code = "E0811"
// candidate = 1
// leaves = ["66:12 E0811"]
//
// [[test.fix]]
// at = "65:18"
// code = "E0811"
// candidate = 2
// leaves = ["67:12 E0811"]
