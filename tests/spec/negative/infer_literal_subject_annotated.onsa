// onsa.toml
// [test]
// spec = ["§4.7", "§6.1", "§15.1", "§9.1", "§18.1"]

// The same operations as infer_literal_subject_call.onsa, _field.onsa, _index.onsa and _try.onsa, on a number
// whose type is known: the codes that the literal forms get (S-854, spec §4.7 "注釈したときと同じコードを
// その場で報告する"). A call `.(` is E0401 (spec §6.1, §15.1), a field, a tuple index and an index are E0413
// (§18.1), and `?` is E0414 (§9.1). The type is known by an annotation (`let n: I32 = 17`, `let n: F32 =
// 1.5`) or by an operator with a typed operand (`let m = n + x`, E0401 before S-854 as well). These stand
// today; they are kept apart from the literal forms because those wait for W5-01 (a case that waits is
// silenced as a whole, tests/README.md). One error per function (P-01).


// ---------------------------------------------------------------- an annotated integer

pub fn call_on_an_annotated_integer(x: I32) -> I32 {
  let n: I32 = 17
  let _ = n.(x)                                     //~ E0401
  0
}

pub fn field_on_an_annotated_integer(x: I32) -> I32 {
  let n: I32 = 17
  let _ = n.x                                       //~ E0413
  0
}

pub fn tuple_index_on_an_annotated_integer(x: I32) -> I32 {
  let n: I32 = 17
  let _ = n.0                                       //~ E0413
  0
}

pub fn index_on_an_annotated_integer(x: I32) -> I32 {
  let n: I32 = 17
  let _ = n[0]                                      //~ E0413
  0
}

pub fn try_on_an_annotated_integer(x: I32) -> Option[I32] {
  let n: I32 = 17
  let _ = n?                                        //~ E0414
  Some(0)
}

// ---------------------------------------------------------------- an annotated float

pub fn call_on_an_annotated_float(x: I32) -> I32 {
  let n: F32 = 1.5
  let _ = n.(x)                                     //~ E0401
  0
}

pub fn field_on_an_annotated_float(x: I32) -> I32 {
  let n: F32 = 1.5
  let _ = n.x                                       //~ E0413
  0
}

pub fn tuple_index_on_an_annotated_float(x: I32) -> I32 {
  let n: F32 = 1.5
  let _ = n.0                                       //~ E0413
  0
}

pub fn index_on_an_annotated_float(x: I32) -> I32 {
  let n: F32 = 1.5
  let _ = n[0]                                      //~ E0413
  0
}

pub fn try_on_an_annotated_float(x: I32) -> Option[I32] {
  let n: F32 = 1.5
  let _ = n?                                        //~ E0414
  Some(0)
}

// ---------------------------------------------------------------- a number decided by an operator

pub fn call_on_a_number_decided_by_an_operator(x: I32) -> I32 {
  let n = 17
  let m = n + x
  let _ = m.(x)                                     //~ E0401
  0
}

pub fn field_on_a_number_decided_by_an_operator(x: I32) -> I32 {
  let n = 17
  let m = n + x
  let _ = m.x                                       //~ E0413
  0
}

pub fn tuple_index_on_a_number_decided_by_an_operator(x: I32) -> I32 {
  let n = 17
  let m = n + x
  let _ = m.0                                       //~ E0413
  0
}

pub fn index_on_a_number_decided_by_an_operator(x: I32) -> I32 {
  let n = 17
  let m = n + x
  let _ = m[0]                                      //~ E0413
  0
}

pub fn try_on_a_number_decided_by_an_operator(x: I32) -> Option[I32] {
  let n = 17
  let m = n + x
  let _ = m?                                        //~ E0414
  Some(0)
}
