// onsa.toml
// [test]
// spec = ["§4.2", "§4.7"]

// S-1005 (§4.2: "容量が囲む総称の項目の定数のパラメータである `FixedStr[N]` ... は文字列リテラルの型にならない（E0401。値を作る位置、比較の他方、`match` のパターンのどれでも同じ）"):
// a string literal whose expected type is `FixedStr[N]` with the capacity `N` that is a const parameter of the enclosing item
// (`fn is_warm[const N: U32](t: FixedStr[N]) -> Bool { t == "warm" }`) is E0401 in the stage of the types: whether it fits is not decided before the item is instantiated, so it
// cannot be checked where it is defined (as an integer literal of a type parameter, §6.6). The note shows how a literal is given to an argument with its own capacity
// (`u.put_str!("warm")`, a function of two capacities; checked by crates/onsa_cli/tests/cli/decided_notes.rs). The positions are the comparison on either side, the annotation
// of a `let`, `return`, the last value and a field of a generic struct whose capacity is the parameter. The literal that is passed to such a function is fine: its capacity is
// decided by the argument (tests/spec/types/fixed_str_lit_generic.onsa). One error in each function (P-01).

use std.text.FixedStr

pub struct Label[const N: U32] {
  name: FixedStr[N],
}

pub fn is_warm[const N: U32](t: FixedStr[N]) -> Bool {
  t == "warm"                                       //~ E0401
}

pub fn warm_is[const N: U32](t: FixedStr[N]) -> Bool {
  "warm" == t                                       //~ E0401
}

pub fn in_a_let[const N: U32](t: FixedStr[N]) -> FixedStr[N] {
  let u: FixedStr[N] = "warm"                       //~ E0401
  u
}

pub fn in_a_return[const N: U32]() -> FixedStr[N] {
  return "warm"                                     //~ E0401
}

pub fn in_the_last_value[const N: U32]() -> FixedStr[N] {
  "warm"                                            //~ E0401
}

pub fn in_a_field_of_a_generic_struct[const N: U32]() -> Label[N] {
  Label { name: "warm" }                            //~ E0401
}

pub fn a_value_of_the_parameter_is_fine[const N: U32](t: FixedStr[N], u: FixedStr[N]) -> Bool {
  t == u
}
