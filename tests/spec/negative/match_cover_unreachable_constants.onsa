// onsa.toml
// [test]
// spec = ["§7", "§18.1"]

// S-187, S-185 (U1a and U2 of W5-09): the arm of a constant after a `_` or a binding is covered by it, so it is E0503 (§7: "`_` や束縛の後の腕"). The forms without a constant are in
// match_cover_unreachable.onsa. The candidates are U3 (match_unreachable_fix_constant.onsa), so no `fixes` is written here. One error per function (P-01).

const LIMIT: I32 = 5

const RATE: F32 = 1.5

pub fn constant_after_a_wildcard(n: I32) -> I32 {
  match n {
    _ => 0,
    LIMIT => 1,                                     //~ E0503
  }
}

pub fn constant_after_a_binding(n: I32) -> I32 {
  match n {
    k => k,
    LIMIT => 1,                                     //~ E0503
  }
}

// A constant of a type a pattern cannot compare, in an arm that is covered: the arm is the error to report, not the E0020, whose guard form would be an E0503 of the same stage (§18.1).

pub fn float_constant_after_a_wildcard(x: F32) -> I32 {
  match x {
    _ => 0,
    RATE => 1,                                      //~ E0503
  }
}

pub fn float_constant_inside_some(o: Option[F32]) -> I32 {
  match o {
    Some(_) => 1,
    Some(RATE) => 2,                                //~ E0503
    None => 0,
  }
}
