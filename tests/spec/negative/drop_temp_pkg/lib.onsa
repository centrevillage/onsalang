// The helpers of negative/drop_temp_pkg/main.onsa and the functions of another module that drop a temporary value (W6-02 U5a/t, spec §12.2, §15.1).
// The drop is reported where it is written, wherever the function is called from: here, in the module that declares it. The functions are one-liners (S-783).

pub struct G {
  s: Str,
  n: U32,
}

pub struct H {
  b: Buf[F32],
  s: Str,
  n: U32,
}

impl G {
  pub rt fn size(self) -> U32 { 0 }
}

pub rt fn mk(n: U32) -> Str { "x" }

pub rt fn mk_o(n: U32) -> Option[Str] { Some("x") }

pub rt fn mk_g(n: U32) -> G { G { s: "a", n: n } }

pub rt fn mk_h(move b: Buf[F32]) -> H { H { b: move b, s: "a", n: 1 } }

pub rt fn pass(move b: Buf[F32]) -> Buf[F32] { b }

pub rt fn pass_s(move s: Str) -> Str { s }

pub rt fn str_len(s: Str) -> U32 { 0 }

pub rt fn len_of(b: Buf[F32]) -> U32 { 0 }

pub fn lib_receiver(n: U32) -> U32 { mk(n).len() }   //~ E0601

pub rt fn rt_lib_receiver(n: U32) -> U32 { mk(n).len() }   //~ E0901

pub fn lib_argument(move b: Buf[F32]) -> U32 { len_of(pass(move b)) }   //~ E0601

pub rt fn rt_lib_argument(move b: Buf[F32]) -> U32 { len_of(pass(move b)) }   //~ E0901

pub fn lib_take_out(move b: Buf[F32]) -> Buf[F32] { mk_h(move b).b }   //~ E0601

pub rt fn rt_lib_take_out(move b: Buf[F32]) -> Buf[F32] { mk_h(move b).b }   //~ E0901
