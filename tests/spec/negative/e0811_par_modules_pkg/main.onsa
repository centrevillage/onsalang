// onsa.toml
// [test]
// spec = ["§2.6", "§11.5", "§15.1", "§18.1"]

// W4-20 U1/t, S-745; W7-06 U0/t, S-1177: whether a `par` without the `~` is the error E0811 is decided by
// the content of its body (§11.5), and the content does not depend on where the callee is: a flow of another
// module, by its qualified name (`util.lp~(x)`) or by the name a `use` takes in (`lp~(x)`), is state in the
// body, as in the single file (§11.5, §15.1; the callee is found through the module). A function of the module
// holds no state, so a `par` of it is no error (the section "Not errors"). A call in the body of a flow
// with the `~` missing (`lp(x)`) is the E0811 of the call, an error of the names stage (§18.1), which comes
// before the flow check stage by stage, not by position: the first error of that flow is the call, not the
// `par`, and the candidate of the call (the `~` after the name) leaves the E0811 of the `par` of the flow check
// stage, a later stage than the error it removes, which the contract of the candidates
// does not look at (§18.1), so there is no `[[test.fix]]` for it. One error per flow (P-01).

use util
use util.{lp, pair_sum}

pub flow qualified_in_the_body(x: F32 at sample) -> [F32; 3] at sample {
  par i in 0 ..< 3 { util.lp~(x * F32.round_from(i)) }  //~ E0811
}

pub flow imported_in_the_body(x: F32 at sample) -> [F32; 3] at sample {
  par i in 0 ..< 3 { lp~(x * F32.round_from(i)) }   //~ E0811
}

pub flow the_call_in_the_body_without_the_tilde(x: F32 at sample) -> [F32; 3] at sample {
  par i in 0 ..< 3 { lp(x * F32.round_from(i)) }    //~ E0811
}

pub flow the_inner_of_a_nest(x: F32 at sample) -> [F32; 2] at sample {
  par~ i in 0 ..< 2 {
    pair_sum(par j in 0 ..< 2 { util.lp~(x * F32.round_from(i + j)) })  //~ E0811
  }
}

// ---- Not errors ----

pub flow fine(x: F32 at sample) -> [F32; 3] at sample {
  par~ i in 0 ..< 3 { util.lp~(x * F32.round_from(i)) }
}

pub flow a_function_of_the_module_in_the_body(x: F32 at sample) -> [F32; 3] at sample {
  par i in 0 ..< 3 { pair_sum([x, x]) * F32.round_from(i) }
}
