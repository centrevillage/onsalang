// onsa.toml
// [test]
// mode = "test"
// spec = ["§11.7", "§11.3", "§6.5"]

// W7-13 U4a/t, S-87, R-99 (spec §11.7): the forms of `@param` that are right. The input is a `block` input whose value type is
// one of the scalars (`F32` `F64` `I8` `I16` `I32` `U8` `U16` `U32`; the `Bool` input is param_attr_ok_bool.onsa, its `default` is
// `true`, which the values of the work after this one take), the keys are from the list of eight and each is written once, and
// there is a `default`. The `@param` is a declaration and does not change what the flow does (§11.7): the flows are run with the
// value that they are given in `Params`, whatever the keys say. An alias of a scalar is the scalar. The attribute is read in a
// flow that is called by another, in a branch, with the other clocks of inputs, and with `@export`.

// ---- every one of the scalars

pub flow of_f32(
  x: F32 at sample,
  @param(min: 0.0, max: 1.0, default: 0.5)
  p: F32 at block,
) -> F32 at sample {
  x * p
}

pub flow of_f64(
  x: F64 at sample,
  @param(min: 0.0, max: 4.0, default: 2.0)
  p: F64 at block,
) -> F64 at sample {
  x * p
}

pub flow of_i8(
  x: F32 at sample,
  @param(min: -10, max: 10, default: 0)
  n: I8 at block,
) -> F32 at sample {
  if n > 2 { x } else { 0.0 }
}

pub flow of_i16(
  x: F32 at sample,
  @param(min: -1000, max: 1000, default: 0)
  n: I16 at block,
) -> F32 at sample {
  if n > 2 { x } else { 0.0 }
}

pub flow of_i32(
  x: F32 at sample,
  @param(min: 0, max: 10, default: 2, step: 1)
  n: I32 at block,
) -> F32 at sample {
  if n > 2 { x } else { 0.0 }
}

pub flow of_u8(
  x: F32 at sample,
  @param(min: 0, max: 255, default: 8)
  n: U8 at block,
) -> F32 at sample {
  if n > 2 { x } else { 0.0 }
}

pub flow of_u16(
  x: F32 at sample,
  @param(min: 0, max: 4096, default: 64)
  n: U16 at block,
) -> F32 at sample {
  if n > 2 { x } else { 0.0 }
}

pub flow of_u32(
  x: F32 at sample,
  @param(min: 0, max: 100000, default: 480)
  n: U32 at block,
) -> F32 at sample {
  if n > 2 { x } else { 0.0 }
}

// ---- the keys: all of the eight, once each, in the order of the list and in another

pub flow all_the_keys(
  x: F32 at sample,
  @param(min: 0.0, max: 1.0, default: 0.5, step: 0.25, unit: "dB", scale: "linear", label: "Level", id: "level")
  p: F32 at block,
) -> F32 at sample {
  x * p
}

pub flow all_the_keys_in_another_order(
  x: F32 at sample,
  @param(
    id: "cutoff",
    label: "Cutoff",
    scale: "log",
    unit: "Hz",
    step: 1.0,
    default: 1000.0,
    max: 20000.0,
    min: 20.0,
  )
  f: F32 at block,
) -> F32 at sample {
  x * f
}

pub flow only_the_default(
  x: F32 at sample,
  @param(default: 0.5)
  p: F32 at block,
) -> F32 at sample {
  x * p
}

pub flow log_scale(
  x: F32 at sample,
  @param(min: 20.0, max: 20000.0, default: 440.0, scale: "log")
  f: F32 at block,
) -> F32 at sample {
  x * f
}

pub flow negative_range(
  x: F32 at sample,
  @param(min: -60.0, max: 12.0, default: 0.0, unit: "dB")
  level: F32 at block,
) -> F32 at sample {
  x + level
}

// ---- an alias of a scalar is the scalar

type Gain = F32

type Count = U8

pub flow of_an_alias(
  x: F32 at sample,
  @param(min: 0.0, max: 1.0, default: 0.5)
  p: Gain at block,
  @param(min: 0, max: 8, default: 4)
  n: Count at block,
) -> F32 at sample {
  if n > 2 { x * p } else { 0.0 }
}

// ---- the other inputs of the flow, the clocks of them, and more than one `@param`

pub flow with_the_other_clocks(
  x: F32 at sample,
  k: U32 at init,
  @param(min: 0.0, max: 1.0, default: 0.5)
  a: F32 at block,
  b: F32 at block,
  @param(min: 0, max: 4, default: 1)
  n: I32 at block,
) -> F32 at sample {
  if n > 0 { x * a * b } else { x }
}

// ---- in a branch and in a flow that is called by another

pub flow in_a_branch(
  x: F32 at sample,
  @param(min: 0.0, max: 1.0, default: 0.5)
  p: F32 at block,
) -> F32 at sample {
  if p > 0.5 { x } else { 0.0 - x }
}

pub flow inner(
  x: F32 at sample,
  @param(min: 0.0, max: 1.0, default: 0.5)
  p: F32 at block,
) -> F32 at sample {
  x * p
}

pub flow outer(
  x: F32 at sample,
  @param(min: 0.0, max: 2.0, default: 1.0)
  q: F32 at block,
) -> F32 at sample {
  inner~(x, q) + inner~(x, 0.25)
}

@export
pub flow exported(
  x: F32 at sample,
  @param(min: 0.0, max: 1.0, default: 0.5, unit: "ratio")
  mix: F32 at block,
  @param(min: 0, max: 8, default: 2)
  taps: U8 at block,
) -> F32 at sample {
  if taps > 1 { x * mix } else { x }
}

// ---- the flows are run, and the value is the one that is given (the keys are not read)

test "a float input runs with the value it is given, whatever its range says" {
  let xs: [F32; 2] = [2.0, 3.0]
  let o = of_f32.render(of_f32.Params { p: 0.5 }, xs, 8.0)
  assert o.out[0] == 1.0
  assert o.out[1] == 1.5
  let o2 = of_f32.render(of_f32.Params { p: 4.0 }, xs, 8.0)
  assert o2.out[0] == 8.0
  assert o2.out[1] == 12.0
}

test "a double input runs" {
  let xs: [F64; 2] = [2.0, 3.0]
  let o = of_f64.render(of_f64.Params { p: 0.5 }, xs, 8.0)
  assert o.out[0] == 1.0
  assert o.out[1] == 1.5
}

test "an integer input of each width runs" {
  let xs: [F32; 2] = [2.0, 3.0]
  let a = of_i8.render(of_i8.Params { n: 3 }, xs, 8.0)
  assert a.out[0] == 2.0
  let b = of_i16.render(of_i16.Params { n: 1 }, xs, 8.0)
  assert b.out[0] == 0.0
  let c = of_i32.render(of_i32.Params { n: 5 }, xs, 8.0)
  assert c.out[1] == 3.0
  let d = of_u8.render(of_u8.Params { n: 2 }, xs, 8.0)
  assert d.out[1] == 0.0
  let e = of_u16.render(of_u16.Params { n: 9 }, xs, 8.0)
  assert e.out[0] == 2.0
  let f = of_u32.render(of_u32.Params { n: 3 }, xs, 8.0)
  assert f.out[1] == 3.0
}

test "the flow with all the keys and the one with the keys in another order run" {
  let xs: [F32; 2] = [2.0, 4.0]
  let o = all_the_keys.render(all_the_keys.Params { p: 0.5 }, xs, 8.0)
  assert o.out[0] == 1.0
  assert o.out[1] == 2.0
  let o2 = all_the_keys_in_another_order.render(all_the_keys_in_another_order.Params { f: 2.0 }, xs, 8.0)
  assert o2.out[0] == 4.0
  assert o2.out[1] == 8.0
}

test "a value that is outside the range of the attribute is used as it is" {
  let xs: [F32; 1] = [2.0]
  let o = negative_range.render(negative_range.Params { level: 100.0 }, xs, 8.0)
  assert o.out[0] == 102.0
}

test "an input of an alias, a flow with several inputs and a flow called by another run" {
  let xs: [F32; 2] = [2.0, 4.0]
  let a = of_an_alias.render(of_an_alias.Params { p: 0.5, n: 3 }, xs, 8.0)
  assert a.out[0] == 1.0
  assert a.out[1] == 2.0
  let b = in_a_branch.render(in_a_branch.Params { p: 0.25 }, xs, 8.0)
  assert b.out[0] == -2.0
  let c = outer.render(outer.Params { q: 1.0 }, xs, 8.0)
  assert c.out[0] == 2.5
  assert c.out[1] == 5.0
}
