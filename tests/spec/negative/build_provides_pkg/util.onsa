// onsa.toml
// [test]
// spec = ["§12.3", "§14.2", "§15.3"]

// E0610 through a module path: the exported function lives in module `util`,
// and the rule is the same as for a function in the root module (§14.2,
// §15.3). Only the target without `Alloc` rejects it.
pub fn version() -> U32 { 1 }

pub fn version_on_heap() -> U32 uses {Alloc} { 2 }   //~ E0610 [bare]
