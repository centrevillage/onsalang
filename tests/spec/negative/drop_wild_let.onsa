// onsa.toml
// [test]
// spec = ["§5.2", "§5.4", "§10", "§12.2"]

// W6-02 U6/t, R-390, R-32, S-1036, and the carry-over of W5-03 U1 (`let _ = to_w(move b)`) (§5.4: "所有の見出し … が消費した値のうち、パターンが束縛しなかった部分（`_`、最後の `_` が残すフィールド、束縛の無い腕の対象）は、`let`
// … では文の終わりに、`match` の腕と `for` の本体ではその腕・反復の終わり … に破棄される。腕が panic で抜ければ、その破棄は起きない"; §5.2: "意味は分解の `let Holder { buf: b, gain: _ } = move s` と同じ"; §12.2: "所有する Shared 値・`Buf`
// と、それらを含む値の破棄: 要る"): `let _ = e` binds nothing, and so do the `_` of a `let` that destructures, so the value of an owned head (`move x`, a call result, a literal that
// holds an owned part: §5.4) is dropped at the end of the statement. The drop of a `Buf`, a `Str` or a value that holds one needs `Alloc`. A function without `uses {Alloc}`
// is an E0601 and an `rt fn` an E0901 (§10 rule 1). This version counts no drop of what `let _` and the `_` of a destructuring `let` leave (R-32), so none of these is
// reported today. The `let _ = x` of a borrowed argument and of a static value are in negative/drop_wild_contrast.onsa; the `let` with a statement after it is in
// negative/drop_wild_let_lines.onsa. The functions are one-liners, so that the line does not depend on where the drop is reported (S-783). One error per function (P-01).

pub struct H {
  buf: Buf[F32],
  s: Str,
  n: U32,
}

pub struct G {
  s: Str,
  n: U32,
}

pub struct K {
  b: Buf[F32],
  n: U32,
}

pub rt fn mk(n: U32) -> Str { "x" }

pub rt fn pass(move b: Buf[F32]) -> Buf[F32] { b }

pub rt fn mk_h(move b: Buf[F32]) -> H { H { buf: move b, s: "a", n: 1 } }

pub rt fn mk_pair(move b: Buf[F32]) -> (Buf[F32], U32) { (move b, 1) }

// ------------------------------------------------------------------ `let _ = e` of an owned value

pub fn let_move(move b: Buf[F32]) { let _ = move b }   //~ E0601

pub rt fn rt_let_move(move b: Buf[F32]) { let _ = move b }   //~ E0901

pub fn let_move_option(move o: Option[Buf[F32]]) { let _ = move o }   //~ E0601

pub rt fn rt_let_move_option(move o: Option[Buf[F32]]) { let _ = move o }   //~ E0901

pub fn let_call(move b: Buf[F32]) { let _ = pass(move b) }   //~ E0601

pub rt fn rt_let_call(move b: Buf[F32]) { let _ = pass(move b) }   //~ E0901

pub fn let_call_str(n: U32) { let _ = mk(n) }   //~ E0601

pub rt fn rt_let_call_str(n: U32) { let _ = mk(n) }   //~ E0901

pub fn let_call_struct(move b: Buf[F32]) { let _ = mk_h(move b) }   //~ E0601

pub rt fn rt_let_call_struct(move b: Buf[F32]) { let _ = mk_h(move b) }   //~ E0901

pub fn let_literal_some(move b: Buf[F32]) { let _ = Some(move b) }   //~ E0601

pub rt fn rt_let_literal_some(move b: Buf[F32]) { let _ = Some(move b) }   //~ E0901

pub fn let_literal_tuple(s: Str) { let _ = (s, 1) }   //~ E0601

pub rt fn rt_let_literal_tuple(s: Str) { let _ = (s, 1) }   //~ E0901

pub fn let_literal_struct(s: Str) { let _ = G { s: s, n: 1 } }   //~ E0601

pub rt fn rt_let_literal_struct(s: Str) { let _ = G { s: s, n: 1 } }   //~ E0901

pub fn let_typed_call(move b: Buf[F32]) { let _: Buf[F32] = pass(move b) }   //~ E0601

pub rt fn rt_let_typed_call(move b: Buf[F32]) { let _: Buf[F32] = pass(move b) }   //~ E0901

pub fn let_typed_move(move b: Buf[F32]) { let _: Buf[F32] = move b }   //~ E0601

pub rt fn rt_let_typed_move(move b: Buf[F32]) { let _: Buf[F32] = move b }   //~ E0901

pub fn let_none_of_affine() { let _: Option[Buf[F32]] = None }   //~ E0601

pub rt fn rt_let_none_of_affine() { let _: Option[Buf[F32]] = None }   //~ E0901

// ------------------------------------------------------------------ the `_` of a `let` that destructures

pub fn let_destr_tuple_buf(move p: (U32, Buf[F32])) { let (_, _) = move p }   //~ E0601

pub rt fn rt_let_destr_tuple_buf(move p: (U32, Buf[F32])) { let (_, _) = move p }   //~ E0901

pub fn let_destr_tuple_one(move p: (Buf[F32], Buf[F32])) { let (_, _) = move p }   //~ E0601

pub rt fn rt_let_destr_tuple_one(move p: (Buf[F32], Buf[F32])) { let (_, _) = move p }   //~ E0901

pub fn let_destr_struct(move h: H) { let H { n: _, buf: _, s: _ } = move h }   //~ E0601

pub rt fn rt_let_destr_struct(move h: H) { let H { n: _, buf: _, s: _ } = move h }   //~ E0901

pub fn let_destr_call(move b: Buf[F32]) { let (_, _) = mk_pair(move b) }   //~ E0601

pub rt fn rt_let_destr_call(move b: Buf[F32]) { let (_, _) = mk_pair(move b) }   //~ E0901
