// onsa.toml
// [test]
// spec = ["§3.5", "§5.2", "§5.4", "§7", "§8.1", "§10", "§12.2"]

// W6-02 U4a/t, R-255, S-1030 (§5.2, the paragraph that begins "所有する束縛（`move` の引数、`move self`、... の全体が Copy でない Dup の値で"): the contrasts of negative/dup_release_later.onsa.
// A hand-off of a `move` parameter `s` that nothing reads, borrows or hands over afterwards on the path that goes on, is moved ("複製せずに移す"), so the original is not dropped and
// the function needs no `Alloc`: no E0601 in a function without `uses {Alloc}`, no E0601 in an `rt fn` (§12.2: "所有する Dup の値を、消費する位置で移すこと: 要らない"). The
// reads that come before the hand-off do not count (`(s.len(), eat_n(s))`: the elements of a tuple literal are evaluated in the order they are written, §3.5), and of two hand-offs in
// the elements of a literal only the last one moves (the first is copied, because the second uses `s` after it). The two branches of an `if` and the arms of a `match` can each hand
// the value off, because the paths do not meet again, and a function can hand it off as the statement it ends with. The other kinds of owned Dup value (`Param` with a `Str`,
// `Option[Str]`, `Result[Str, U32]`, `(Str, U32)`) are the same. The helpers drop their argument, so their own E0601 is reported (the same as negative/drop_for_one_path.onsa); the callers have no
// marker. Every function is an error today (the original is dropped after the copy is handed over, R-255) and none is one after. The functions with a statement list are on several
// lines (no error is expected, so the line does not matter, S-783).

pub struct Param {
  name: Str,
  value: F32,
}

pub rt fn eat(move s: Str) {}   //~ E0601

pub rt fn eat_n(move s: Str) -> U32 { s.len() }   //~ E0601

pub rt fn eat_p(move p: Param) -> U32 { 0 }   //~ E0601

pub rt fn eat_o(move o: Option[Str]) -> U32 { 0 }   //~ E0601

pub rt fn eat_r(move r: Result[Str, U32]) -> U32 { 0 }   //~ E0601

pub rt fn eat_t(move t: (Str, U32)) -> U32 { 0 }   //~ E0601

pub rt fn len_of(s: Str) -> U32 { s.len() }

// ------------------------------------------------------------------ the reads come before the hand-off, the last of two hand-offs moves

pub fn read_before(move s: Str) -> (U32, U32) { (s.len(), eat_n(s)) }

pub rt fn rt_read_before(move s: Str) -> (U32, U32) { (s.len(), eat_n(s)) }

pub fn borrowed_arg_before(move s: Str) -> (U32, U32) { (len_of(s), eat_n(s)) }

pub rt fn rt_borrowed_arg_before(move s: Str) -> (U32, U32) { (len_of(s), eat_n(s)) }

pub fn read_in_branch_before(move s: Str, c: Bool) -> (U32, U32) { (if c { s.len() } else { 0 }, eat_n(s)) }

pub rt fn rt_read_in_branch_before(move s: Str, c: Bool) -> (U32, U32) { (if c { s.len() } else { 0 }, eat_n(s)) }

pub fn last_hand_off_moves(move s: Str) -> (U32, U32) { (eat_n(s), eat_n(s)) }

pub rt fn rt_last_hand_off_moves(move s: Str) -> (U32, U32) { (eat_n(s), eat_n(s)) }

pub fn read_then_hand_off_sum(move s: Str) -> U32 { s.len() + eat_n(s) }

pub rt fn rt_read_then_hand_off_sum(move s: Str) -> U32 { s.len() + eat_n(s) }

// ------------------------------------------------------------------ the paths do not meet again, the statement the function ends with

pub fn both_branches(move s: Str, c: Bool) -> U32 { if c { eat_n(s) } else { eat_n(s) } }

pub rt fn rt_both_branches(move s: Str, c: Bool) -> U32 { if c { eat_n(s) } else { eat_n(s) } }

pub fn both_arms(move s: Str, n: U32) -> U32 { match n { 0 => eat_n(s), _ => eat_n(s) } }

pub rt fn rt_both_arms(move s: Str, n: U32) -> U32 { match n { 0 => eat_n(s), _ => eat_n(s) } }

pub fn three_arms(move s: Str, n: U32) -> U32 { match n { 0 => eat_n(s), 1 => eat_n(s), _ => eat_n(s) } }

pub rt fn rt_three_arms(move s: Str, n: U32) -> U32 { match n { 0 => eat_n(s), 1 => eat_n(s), _ => eat_n(s) } }

pub fn both_returns(move s: Str, c: Bool) -> U32 { if c { return eat_n(s) } else { return eat_n(s) } }

pub rt fn rt_both_returns(move s: Str, c: Bool) -> U32 { if c { return eat_n(s) } else { return eat_n(s) } }

pub fn nested_branches(move s: Str, c: Bool, d: Bool) -> U32 { if c { if d { eat_n(s) } else { eat_n(s) } } else { eat_n(s) } }

pub rt fn rt_nested_branches(move s: Str, c: Bool, d: Bool) -> U32 { if c { if d { eat_n(s) } else { eat_n(s) } } else { eat_n(s) } }

pub fn as_the_last_statement(move s: Str) { eat(s) }

pub rt fn rt_as_the_last_statement(move s: Str) { eat(s) }

pub fn read_statement_then_hand_off(move s: Str) -> U32 {
  let n = s.len()
  n + eat_n(s)
}

pub rt fn rt_read_statement_then_hand_off(move s: Str) -> U32 {
  let n = s.len()
  n + eat_n(s)
}

pub fn return_then_tail(move s: Str, c: Bool) -> U32 {
  if c { return eat_n(s) }
  eat_n(s)
}

pub rt fn rt_return_then_tail(move s: Str, c: Bool) -> U32 {
  if c { return eat_n(s) }
  eat_n(s)
}

// ------------------------------------------------------------------ the other kinds of owned Dup value

pub fn struct_field_before(move p: Param) -> (F32, U32) { (p.value, eat_p(p)) }

pub rt fn rt_struct_field_before(move p: Param) -> (F32, U32) { (p.value, eat_p(p)) }

pub fn option_read_before(move o: Option[Str]) -> (U32, U32) { (match o { Some(b) => b.len(), None => 0 }, eat_o(o)) }

pub rt fn rt_option_read_before(move o: Option[Str]) -> (U32, U32) { (match o { Some(b) => b.len(), None => 0 }, eat_o(o)) }

pub fn result_borrowed_before(move r: Result[Str, U32]) -> (U32, U32) { (match r { Ok(a) => a.len(), Err(e) => e }, eat_r(r)) }

pub rt fn rt_result_borrowed_before(move r: Result[Str, U32]) -> (U32, U32) { (match r { Ok(a) => a.len(), Err(e) => e }, eat_r(r)) }

pub fn tuple_field_before(move t: (Str, U32)) -> (U32, U32) { (t.1, eat_t(t)) }

pub rt fn rt_tuple_field_before(move t: (Str, U32)) -> (U32, U32) { (t.1, eat_t(t)) }
