// onsa.toml
// [test]
// spec = ["§6.6", "§6.1", "§15.1", "§5.2", "§18.1"]

// W5-02 U4a: what is written after an associated constant or an associated function of a scalar type.
//  - After a constant (`F32.PI.x`) is a name after a value, which is a field or a method of the value's
//    type (§15.1: "値の後の `.` はそのフィールドとメソッド"), so a name that the type has not is E0413, as
//    after any value: `F32` has no field `x`, `U32` has no field `BITS`.
//  - The name after an associated function is in scalar_assoc_fn_after_name.onsa.
//  - `!` marks the call of a method that changes its receiver, and the call of an associated function with
//    `!(` is E0714 (§5.2, §15.1: "`x!(...)` は §5.2 の E0714（関数でない値は E0401）"); the call of a constant
//    with `!(` is E0401 (negative/value_call_bang_not_a_function.onsa).
// One error per function (P-01). The forms that are right are the last functions of the file.

pub fn name_after_a_float_constant() -> F32 {
  F32.PI.x //~ E0413
}

pub fn constant_after_a_float_constant() -> F32 {
  F32.PI.PI //~ E0413
}

pub fn name_after_a_wide_float_constant() -> F64 {
  F64.EPSILON.MAX //~ E0413
}

pub fn bits_after_an_integer_constant() -> U32 {
  I32.MAX.BITS //~ E0413
}

pub fn name_after_bits() -> U32 {
  U8.BITS.x //~ E0413
}

pub fn bang_call_of_an_associated_function(u: U32) -> F32 {
  F32.from_bits!(u) //~ E0714
}

pub fn bang_call_of_the_wide_associated_function(u: U64) -> F64 {
  F64.from_bits!(u) //~ E0714
}

pub fn bang_call_of_an_associated_function_on_a_literal() -> F32 {
  F32.from_bits!(0x3F800000) //~ E0714
}

pub fn the_forms_that_are_right(u: U32, v: U64) -> F64 {
  let a = F32.from_bits(u)
  let b = F64.from_bits(v)
  b + (a as F64) + (F32.PI.to_bits() as F64) + (U8.BITS as F64)
}
