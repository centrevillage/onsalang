// onsa.toml
// [package]
// name = "lower_str_pattern"
// edition = "2026"
//
// [targets.c]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [test]
// spec = ["§7", "§18.1"]

// E0200 from lowering (S-225, S-67): a string pattern without an interpolation is a valid pattern, but this version does
// not lower `Str` (second-phase, §4.2). A string with only the escapes `{{` and `}}` is such a pattern. (With an
// interpolation it is E0020 before the build: negative/pattern_str.onsa.)
// Since W8-16 (the decision of 2026-11-27 on S-67) a unit whose binding has a type this version does not lower is stopped
// at the binding and not lowered: the E0200 is one for each unit, at the name of the parameter `s: Str`, and neither the
// subject `match s` nor the pattern is reported (they used to be, one E0200 each). Units with the same position,
// code and message are one (§18.1).

pub fn escaped(s: Str) -> U32 {   //~ E0200 @16
  match s {
    "a{{b" => 1,
    _ => 0,
  }
}

pub fn plain(s: Str) -> U32 {   //~ E0200 @14
  match s {
    "abc" => 1,
    _ => 0,
  }
}
