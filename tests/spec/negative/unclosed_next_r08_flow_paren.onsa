// onsa.toml
// [test]
// spec = ["§18.1", "§2.5"]
// fixes = 0

// `flow f(a: F32 at sample -> ...`: the `)` is missing, and the reading stops at the `->` (R8).
// The unit ends at the item that follows it, on a line with the same or a shallower indentation. A bracket that is not closed
// is reported whatever stopped the reading: the E0002 points at the innermost bracket that is not closed (§18.1, S-943,
// R-371). The same file without the item after the unit is unclosed_eof_r08_flow_paren.onsa, and the report is on the same line.

flow f(a: F32 at sample -> F32 at sample {      //~ E0002 @7
  a
}
fn z() -> I32 { 1 }
