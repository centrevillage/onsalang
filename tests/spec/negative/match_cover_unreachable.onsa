// onsa.toml
// [test]
// spec = ["§7", "§18.1"]

// S-187, S-932 (U2 of W5-09): an arm that an earlier arm covers, so that no value chooses it, is E0503 (§7: "前の腕で覆われて、どの値でも選ばれない腕は E0503（到達しない。
// `_` や束縛の後の腕、重複した `1 =>`、`true` と `false` の後の `_`）"). The marker is on the unreachable arm. The arms that cover: `_`, a binding, a
// literal that is written twice, the two values of `Bool` and all the variants of an enum together, a larger pattern for a smaller one inside (`Some(_)`
// before `Some(2)`). An arm with a guard covers nothing, but an arm with a guard can itself be unreachable. The arm of a constant after a `_` is in match_cover_unreachable_constants.onsa (U1a). The candidates are U3 (tests/spec/fixes/match_unreachable_fix_*.onsa), so no
// `fixes` is written here. One error per function (P-01): the first unreachable arm.

pub enum Color {
  Red,
  Green,
  Blue,
}

pub struct Flag {
  on: Bool,
  level: I32,
}

pub fn arm_after_a_wildcard(n: I32) -> I32 {
  match n {
    _ => 0,
    1 => 1,                                         //~ E0503
  }
}

pub fn arm_after_a_binding(n: I32) -> I32 {
  match n {
    k => k,
    1 => 1,                                         //~ E0503
  }
}

pub fn wildcard_after_a_binding_in_lower_case(n: I32) -> I32 {
  match n {
    limit => limit,
    _ => 0,                                         //~ E0503
  }
}

pub fn duplicate_literal(n: I32) -> I32 {
  match n {
    1 => 1,
    1 => 2,                                         //~ E0503
    _ => 0,
  }
}

pub fn duplicate_negative_literal(n: I32) -> I32 {
  match n {
    -1 => 1,
    -1 => 2,                                        //~ E0503
    _ => 0,
  }
}

pub fn duplicate_char_literal(c: Char) -> I32 {
  match c {
    'a' => 1,
    'a' => 2,                                       //~ E0503
    _ => 0,
  }
}

pub fn duplicate_str_literal(s: Str) -> I32 {
  match s {
    "a" => 1,
    "a" => 2,                                       //~ E0503
    _ => 0,
  }
}

pub fn literal_that_a_choice_covers(n: I32) -> I32 {
  match n {
    1 | 2 => 1,
    2 => 2,                                         //~ E0503
    _ => 0,
  }
}

pub fn duplicate_literal_inside_some(o: Option[I32]) -> I32 {
  match o {
    Some(1) => 1,
    Some(1) => 2,                                   //~ E0503
    Some(_) => 3,
    None => 0,
  }
}

pub fn wildcard_after_true_and_false(b: Bool) -> I32 {
  match b {
    true => 1,
    false => 0,
    _ => 2,                                         //~ E0503
  }
}

pub fn same_bool_value_twice(b: Bool) -> I32 {
  match b {
    true => 1,
    true => 2,                                      //~ E0503
    false => 0,
  }
}

pub fn wildcard_after_every_variant(c: Color) -> I32 {
  match c {
    Color.Red => 1,
    Color.Green => 2,
    Color.Blue => 3,
    _ => 0,                                         //~ E0503
  }
}

pub fn binding_after_some_and_none(o: Option[I32]) -> I32 {
  match o {
    Some(x) => x,
    None => 0,
    other => 1,                                     //~ E0503
  }
}

pub fn smaller_pattern_inside_some(o: Option[I32]) -> I32 {
  match o {
    Some(_) => 1,
    Some(2) => 2,                                   //~ E0503
    None => 0,
  }
}

pub fn wildcard_after_a_tuple_of_bools(a: Bool, b: Bool) -> I32 {
  match (a, b) {
    (true, true) => 1,
    (true, false) => 2,
    (false, _) => 3,
    _ => 4,                                         //~ E0503
  }
}

pub fn smaller_pattern_in_a_tuple(a: Bool, n: I32) -> I32 {
  match (a, n) {
    (true, _) => 1,
    (false, _) => 2,
    (true, 1) => 3,                                 //~ E0503
  }
}

pub fn struct_pattern_after_the_bool_values(f: Flag) -> I32 {
  match f {
    Flag { on: true, level: _ } => 1,
    Flag { on: false, level: _ } => 2,
    Flag { on: true, level: 0 } => 3,               //~ E0503
  }
}

pub fn guarded_arm_after_a_wildcard(n: I32) -> I32 {
  match n {
    _ => 0,
    k if k > 0 => k,                                //~ E0503
  }
}

pub fn in_a_statement_match(n: I32) -> I32 {
  var r = 0
  match n {
    _ => { r = 1 },
    0 => { r = 2 },                                 //~ E0503
  }
  r
}

pub fn in_a_match_inside_an_arm(n: I32, o: Option[I32]) -> I32 {
  match n {
    0 => match o {
      Some(x) => x,
      None => 0,
      _ => 1,                                       //~ E0503
    },
    _ => 2,
  }
}
