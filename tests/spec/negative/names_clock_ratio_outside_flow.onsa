// onsa.toml
// [test]
// spec = ["§11.1", "§11.3", "§18.1"]

// E0821 for a derived clock outside a flow (§11.3, S-1078: "flow の外は引かずに E0821"): `at` is written in the
// declaration of an input or an output and in the body of a flow only (§11.3), so in a `fn` the form is read by the syntax
// stage (it is a right form) and the names stage reports the `at` without looking up the base or reading N, whatever
// they are (`block`, a name that is not found). Today these are E0002. One error per declaration unit (§18.1).

pub fn in_the_body(x: F32) -> F32 {
  x at (sample / 2)   //~ E0821
}

pub fn in_an_input(x: F32 at (sample / 2)) -> F32 {   //~ E0821
  x
}

pub fn in_the_output(x: F32) -> F32 at (sample * 2) {   //~ E0821
  x
}

pub fn base_is_not_looked_up(x: F32) -> F32 {
  x at (nope / 2)   //~ E0821
}

pub fn base_is_not_sample(x: F32) -> F32 {
  x at (block / 2)   //~ E0821
}
