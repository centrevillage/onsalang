// onsa.toml
// [package]
// name = "lower_str_pattern_nested"
// edition = "2026"
//
// [targets.c]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [test]
// spec = ["§7", "§18.1", "§4.2"]

// R-434 (W5-12 U3a), E0200 from lowering (S-225, S-67): a string literal pattern inside another pattern (`Some("a")`, `("a", 1)`)
// on a subject whose type holds a `Str`: this version does not lower `Str` values or patterns to Core (§4.2). It used to be an
// internal error. Since W8-16 (the decision of 2026-11-27 on S-67) the unit is stopped at its parameter, whose type holds the
// `Str`, with one E0200 at the parameter's name, and neither the subject `match o` nor the patterns are reported (they used to
// be, one E0200 each); the pattern is not reached. The same patterns on a `FixedStr[N]` inside an `Option` and a tuple are
// lowered (the last function, with no error).

use std.text.FixedStr

pub fn in_some(o: Option[Str]) -> U32 {   //~ E0200 @16
  var r: U32 = 0
  match o {
    Some("a") => {
      r = 1
    },
    _ => {},
  }
  r
}

pub fn in_a_tuple(p: (Str, U32)) -> U32 {   //~ E0200 @19
  var r: U32 = 0
  match p {
    ("a", 1) => {
      r = 1
    },
    _ => {},
  }
  r
}

pub fn a_binding_in_some(o: Option[Str]) -> U32 {   //~ E0200 @26
  var r: U32 = 0
  match o {
    Some(_) => {
      r = 1
    },
    None => {},
  }
  r
}

pub fn fixed_str_is_lowered(o: Option[FixedStr[4]], p: (FixedStr[4], U32)) -> U32 {
  var r: U32 = 0
  match o {
    Some("a") => {
      r = 1
    },
    _ => {},
  }
  match p {
    ("a", 1) => {
      r = r + 1
    },
    _ => {},
  }
  r
}
