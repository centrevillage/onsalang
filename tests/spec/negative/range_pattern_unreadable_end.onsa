// onsa.toml
// [test]
// spec = ["§7", "§3.1", "§18.1"]

// E0002, with no candidate, for a range in a pattern whose end cannot be read as an expression, and for an end
// that has a comment in it (spec §7, §3.1, §18.1; S-251; the row `range_pattern` of spec/foreign-forms.toml). The
// candidate of a range is a guard that copies the ends (`1..<3` is `k if 1 <= k && k < 3`), so an end that
// does not read (nothing after `..<`, an `if` or a `{` right after it, an operator with no right side) cannot be
// copied, and an end with a comment in it would lose the comment in the copy. The code is E0002 and the main
// message is the one of the range (a range cannot be a pattern; compare in a guard), with the note of the
// form; the note is to say why there is no candidate (its text is the implementation's, and the runner of the
// cases does not compare it). The comment of the last function is the marker itself. The main position is the
// start of the range. One error in each declaration unit (P-01).

pub fn nothing_after_the_dots(x: I32) -> I32 {
  match x {
    1..< => 1,                                      //~ E0002
    _ => 0,
  }
}

pub fn an_if_after_the_dots(x: I32) -> I32 {
  match x {
    1..< if x > 0 => 1,                             //~ E0002
    _ => 0,
  }
}

pub fn a_block_end(x: I32) -> I32 {
  match x {
    1..<{ 8 } => 1,                                 //~ E0002
    _ => 0,
  }
}

pub fn an_operator_with_no_right_side(x: I32) -> I32 {
  match x {
    1..<3 + => 1,                                   //~ E0002
    _ => 0,
  }
}

pub fn a_comment_in_the_end(x: I32) -> I32 {
  match x {
    1..<(3 + //~ E0002
      1) => 1,
    _ => 0,
  }
}
