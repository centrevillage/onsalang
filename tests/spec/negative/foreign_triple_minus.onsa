// onsa.toml
// [test]
// spec = ["§3.1", "§5.1", "§18.1"]

// `---x` with no space reads as `--` and `-x` (S-297): a decrement whose operand is not a name, so
// E0002 with no candidate (docs/foreign-forms.toml row `increment_unfixable`). With spaces
// (`- - -x`) it is one stack of prefix operators, E0012 (syntax_prefix.onsa).

pub fn decrement_that_is_not_on_a_name(x: I32) -> I32 {
  let y = ---x                                      //~ E0002
  y
}

pub fn fine(x: I32) -> I32 {
  -(-(-x))
}
