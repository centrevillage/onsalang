// E0006: the nesting depth of the syntax tree is over 256 (§2.5). Every function below is one line
// and nests an expression about 290 steps (a step is one parenthesis, operator, call, index,
// bracket... that nests), well over the limit under any way of counting the nodes of one step (at
// least one per step). Each unit reports one E0006 and the units that follow are checked normally
// (§18.1: a unit is a declaration; a syntax error in one does not stop the others).

pub fn id[T](x: T) -> T { x }

pub struct Counter { n: I32 }

impl Counter {
  pub fn inc(self) -> Counter { Counter { n: self.n + 1 } }
}

