// onsa.toml
// [test]
// spec = ["§3.5", "§5.2", "§5.4", "§7", "§8.1", "§10", "§12.2"]

// W6-02 U4a/t, R-255, S-1030 (§5.2, §5.4, §7): the contrasts of negative/dup_release_borrowed_for.onsa. The hand-off moves when it is not in the body of a borrowed `for` or in the guard of a
// borrowed `match` on the same place: after the loop (the loop only reads, `c.len()`), in the body of an arm (§7: "腕の本体では `x` を変更できる"; the arms hand the value off, so none
// leaves it alive). The guard that only reads is not a hand-off. `guard_copy_arms_move` is the form that shows the guard alone: the guard of the borrowed
// `match o` hands over a copy (an E0715 in Affine terms, "置けなければ複製し"), and the body of each arm then hands `o` off with nothing after it, so the arms move it and no path leaves it alive; if the
// guard moved the value, the hand-offs of the arms would be copies and the function an error. The helpers drop their argument, so their own E0901 is reported (the same as
// negative/drop_for_one_path.onsa); the callers have no marker. Every function is an error today (the original is dropped after the copy is handed over, R-255) and none is one after. The functions
// with a statement list are on several lines (no error is expected, so the line does not matter, S-783).

pub struct Param {
  name: Str,
  value: F32,
}

pub rt fn eat_arr(move a: [Str; 2]) {}   //~ E0901

pub rt fn eat_o(move o: Option[Str]) -> U32 { 0 }   //~ E0901

pub rt fn eat_p(move p: Param) -> U32 { 0 }   //~ E0901

pub rt fn eat_go(move o: Option[Str]) -> Bool { true }   //~ E0901

// ------------------------------------------------------------------ the loop only reads, the hand-off is after it

pub fn read_loop_then_hand_off(move xs: [Str; 2]) {
  var n: U32 = 0
  for c in xs { n = n + c.len() }
  eat_arr(xs)
}

pub rt fn rt_read_loop_then_hand_off(move xs: [Str; 2]) {
  var n: U32 = 0
  for c in xs { n = n + c.len() }
  eat_arr(xs)
}

// ------------------------------------------------------------------ the guard only reads, the arms hand the value off

pub fn guard_reads_arms_hand_off(move o: Option[Str]) -> U32 { match o { Some(b) if b.len() > 0 => eat_o(o), _ => eat_o(o) } }

pub rt fn rt_guard_reads_arms_hand_off(move o: Option[Str]) -> U32 { match o { Some(b) if b.len() > 0 => eat_o(o), _ => eat_o(o) } }

pub fn guard_reads_struct(move p: Param) -> U32 { match p { Param { name: _, value: v } if v > 0.0 => eat_p(p), _ => eat_p(p) } }

pub rt fn rt_guard_reads_struct(move p: Param) -> U32 { match p { Param { name: _, value: v } if v > 0.0 => eat_p(p), _ => eat_p(p) } }

// ------------------------------------------------------------------ the guard of a borrowed `match` hands over a copy, the arms move the value

pub fn guard_copy_arms_move(move o: Option[Str]) -> U32 { match o { Some(_) if eat_go(o) => eat_o(o), _ => eat_o(o) } }

pub rt fn rt_guard_copy_arms_move(move o: Option[Str]) -> U32 { match o { Some(_) if eat_go(o) => eat_o(o), _ => eat_o(o) } }
