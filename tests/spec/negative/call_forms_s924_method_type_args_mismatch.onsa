// onsa.toml
// [test]
// spec = ["§4.5", "§18.1"]
// fixes = 0

// S-924 (§4.5: "型の段で見つける `v.m[I32](x)` は、当てた後に同じ段の E0412 が残る形（型パラメータの無い
// `v.plain[I32](x)`）には修正候補を出さない（§18.1）"): the `[…]` after a method with one type argument is
// found by the type stage, which knows that the type of `v` has the method `plain` and that it has no type
// parameter. The E0020 stays and has no candidate, because `v.plain::[I32](x)` would be the E0412 of the
// same stage (§4.5: "型パラメータを持たない項目 … に書いても E0412"; §18.1: "後の段で見つける形は E0020 のまま
// 候補を出さない"). The number of the type arguments that does not match the method (`v.pair[I32](x)`
// for `pair[A, B]`) is the same case: the candidate would leave the E0412 of the number (§4.5: "数が宣言と
// 合わなければ E0412"). `fixes = 0` checks that no error has a candidate. The method with the right
// number of type arguments is in tests/spec/fixes/call_forms_method_type_args.onsa, and the forms with two or more
// type arguments, which the syntax stage finds and which keep the candidate, in
// tests/spec/fixes/call_forms_s924_syntax_stage_keeps_candidate.onsa. The head is any value: an
// argument, a local binding, `self`, a field of a field, an element of an array, the result of a function, a
// constant, a method of a generic struct, a closure and a `test`. One error per function (P-01).

pub struct V {
  n: I32,
}

pub struct Holder {
  v: V,
}

pub struct W[T] {
  item: T,
}

impl V {
  pub fn plain(self, x: I32) -> I32 {
    x
  }

  pub fn conv[T](self, x: T) -> T {
    x
  }

  pub fn pair[A, B](self, a: A, b: B) -> A {
    a
  }

  pub fn through_self(self, x: I32) -> I32 {
    self.plain[I32](x)                              //~ E0020
  }
}

impl[T] W[T] {
  pub fn plain(self, x: I32) -> I32 {
    x
  }
}

pub fn mk() -> V {
  V { n: 1 }
}

pub const KV: V = V { n: 2 }

pub fn an_argument(v: V) -> I32 {
  v.plain[I32](1)                                   //~ E0020
}

pub fn a_local_binding() -> I32 {
  let v = mk()
  v.plain[I32](2)                                   //~ E0020
}

pub fn a_field_of_a_field(h: Holder) -> I32 {
  h.v.plain[I32](3)                                 //~ E0020
}

pub fn an_element_of_an_array(vs: [V; 2]) -> I32 {
  vs[0].plain[I32](4)                               //~ E0020
}

pub fn the_result_of_a_function() -> I32 {
  mk().plain[I32](5)                                //~ E0020
}

pub fn a_constant() -> I32 {
  KV.plain[I32](6)                                  //~ E0020
}

pub fn a_method_of_a_generic_struct(w: W[F32]) -> I32 {
  w.plain[F32](7)                                   //~ E0020
}

pub fn too_few_type_arguments(v: V) -> I32 {
  v.pair[I32](8, 2.0)                               //~ E0020
}

pub fn too_few_type_arguments_of_a_result() -> I32 {
  mk().pair[I32](9, 2.0)                            //~ E0020
}

pub fn in_a_closure(v: V) -> I32 {
  let g = fn(u: V, x: I32) -> I32 { u.plain[I32](x) }   //~ E0020
  g.(v, 10)
}

pub fn in_an_operand(v: V, x: I32) -> I32 {
  x + v.plain[I32](x) * 2                           //~ E0020
}

test "a method with no type parameter given a type argument in square brackets" {
  let v = mk()
  let y = v.plain[I32](11)                          //~ E0020
  assert y == 11
}

pub fn fine(v: V, w: W[F32]) -> I32 {
  v.plain(1) + w.plain(4) + v.n
}
