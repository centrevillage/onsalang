// onsa.toml
// [test]
// spec = ["§7", "§18.1"]
// fixes = 0

// The `assert c, m` of Python (S-879) whose message holds a bracket that does not close. The form ends at that bracket
// (§18.1), so it has no candidate (a candidate would drop the statements after it and the `}` of the function): the row is
// the E0002 with its note, at the `assert`, and the statement after it is not taken into it.

pub fn g(x: I32) -> I32 {
  x
}

pub fn unclosed_call(c: Bool) {
  assert c, g(1                                     //~ E0002
  assert c
}
