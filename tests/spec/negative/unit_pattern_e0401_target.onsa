// onsa.toml
// [test]
// spec = ["§7"]

// S-516 (U9 of W5-24): the pattern `()` takes a value of the type `()` and no other (§7: "unit の `()`（`()` 型の値に当たり、反駁不能 …）"; the decision: "`()` 以外の型の対象に書けば
// 今の型の段の E0401"). The target is an integer, a `Bool`, a `Str`, a float, a tuple, a struct, an `Option[()]` (the `Option`, not its content), the element of an `Option[I32]`, of
// a `Result`, of a tuple and of a struct field, a value of a type parameter, and a value of a flow. The pattern `()` is the error, on its line; the type of the target is the `I32` in
// the signature or the initializer. One error per function (P-01). The forms that are fine, with a `()` target, are in control/unit_pattern_run.onsa.

pub struct Pt {
  x: I32,
  y: I32,
}

pub fn let_of_an_integer() -> I32 {
  let () = 1 //~ E0401
  2
}

pub fn match_of_an_integer(x: I32) -> I32 {
  match x {
    () => 1, //~ E0401
    _ => 2,
  }
}

pub fn match_of_a_bool(b: Bool) -> I32 {
  match b {
    () => 1, //~ E0401
    _ => 2,
  }
}

pub fn match_of_a_string(s: Str) -> I32 {
  match s {
    () => 1, //~ E0401
    _ => 2,
  }
}

pub fn let_of_a_float() -> I32 {
  let () = 1.5 //~ E0401
  2
}

pub fn match_of_a_pair(t: (I32, I32)) -> I32 {
  match t {
    () => 1, //~ E0401
    _ => 2,
  }
}

pub fn match_of_a_struct(p: Pt) -> I32 {
  match p {
    () => 1, //~ E0401
    _ => 2,
  }
}

pub fn match_of_an_option_of_a_unit(o: Option[()]) -> I32 {
  match o {
    () => 1, //~ E0401
    _ => 2,
  }
}

pub fn some_of_an_integer(o: Option[I32]) -> I32 {
  match o {
    Some(()) => 1, //~ E0401
    None => 2,
  }
}

pub fn err_of_an_integer(r: Result[I32, I32]) -> I32 {
  match r {
    Ok(n) => n,
    Err(()) => 0, //~ E0401
  }
}

pub fn tuple_element_of_an_integer(k: I32) -> I32 {
  let (a, ()) = (k, 2) //~ E0401
  a
}

pub fn struct_field_of_an_integer(p: Pt) -> I32 {
  let Pt { x: (), y: b } = p //~ E0401
  b
}

pub fn value_of_a_type_parameter[T](x: T) -> I32 {
  let () = x //~ E0401
  1
}

pub flow flow_value_of_a_float(x: F32 at sample) -> F32 at sample {
  let () = x //~ E0401
  x
}
