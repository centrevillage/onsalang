// onsa.toml
// [test]
// spec = ["§2.3", "§2.6", "§6.1", "§18.1"]

// E0002 for a `!` or a `~` after a tuple index, written as the mark of a call (§2.6, S-591, S-606):
// the marks of a call stand right after the name of an item, a method or a flow, and a tuple index is
// no name (§2.3), so `t.0!(x)`, `t.0~(x)` and `mk2().0~(x)` have no reading. The syntax decides this
// by itself, whatever stands before the index (a name, a field, a call, an element), in a function and
// in a flow, and before any name is looked up. The error has no candidate. Contrast
// tests/spec/fixes/e0020_callee_tuple_index.onsa (the call `t.0(x)` without a mark gets E0020 with the
// candidate `.(`). One error per function (P-01).

pub struct Pair {
  t: (fn(I32) -> I32, I32),
}

pub fn inc(x: I32) -> I32 {
  x + 1
}

pub fn mk2() -> (fn(I32) -> I32, I32) {
  (inc, 1)
}

pub fn halve(x: F32) -> F32 {
  x / 2.0
}

// ------------------------------------------------ `!`

pub fn bang_after_a_name(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  t.0!(x)                                           //~ E0002
}

pub fn bang_after_a_field(p: Pair, x: I32) -> I32 {
  p.t.0!(x)                                         //~ E0002
}

pub fn bang_after_the_result_of_a_call(x: I32) -> I32 {
  mk2().0!(x)                                       //~ E0002
}

pub fn bang_after_an_element(ts: [(fn(I32) -> I32, I32); 2], x: I32) -> I32 {
  ts[0].0!(x)                                       //~ E0002
}

pub fn bang_after_two_tuple_indexes(n: ((I32, fn(I32) -> I32), I32), x: I32) -> I32 {
  n.0.1!(x)                                         //~ E0002
}

pub fn bang_in_a_let(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  let y = t.0!(x)                                   //~ E0002
  y
}

pub fn bang_in_an_argument(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  inc(t.0!(x))                                      //~ E0002
}

pub fn bang_in_a_closure(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  let g = fn(u: (fn(I32) -> I32, I32), y: I32) -> I32 { u.0!(y) }  //~ E0002
  g.(t, x)
}

pub fn bang_in_an_arm(t: (fn(I32) -> I32, I32), o: Option[I32]) -> I32 {
  match o {
    Some(v) => t.0!(v),                             //~ E0002
    None => 0,
  }
}

pub fn bang_in_a_condition(t: (fn(I32) -> Bool, I32), x: I32) -> I32 {
  if t.0!(x) { 1 } else { 2 }                       //~ E0002
}

pub fn bang_after_a_name_that_is_not_defined(x: I32) -> I32 {
  nope.0!(x)                                        //~ E0002
}

// ------------------------------------------------ `~`

pub fn tilde_after_a_name(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  t.0~(x)                                           //~ E0002
}

pub fn tilde_after_a_field(p: Pair, x: I32) -> I32 {
  p.t.0~(x)                                         //~ E0002
}

pub fn tilde_after_the_result_of_a_call(x: I32) -> I32 {
  mk2().0~(x)                                       //~ E0002
}

pub fn tilde_after_an_element(ts: [(fn(I32) -> I32, I32); 2], x: I32) -> I32 {
  ts[0].0~(x)                                       //~ E0002
}

pub fn tilde_after_two_tuple_indexes(n: ((I32, fn(I32) -> I32), I32), x: I32) -> I32 {
  n.0.1~(x)                                         //~ E0002
}

pub fn tilde_in_an_argument(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  inc(t.0~(x))                                      //~ E0002
}

pub fn tilde_in_an_arm(t: (fn(I32) -> I32, I32), o: Option[I32]) -> I32 {
  match o {
    Some(v) => t.0~(v),                             //~ E0002
    None => 0,
  }
}

pub fn tilde_after_a_name_that_is_not_defined(x: I32) -> I32 {
  nope.0~(x)                                        //~ E0002
}

pub flow tilde_in_a_flow(x: F32 at sample) -> F32 at sample {
  let k: F32 = 2.0
  let t = (halve, k)
  t.0~(x)                                           //~ E0002
}

pub flow tilde_in_a_flow_after_a_call(x: F32 at sample) -> F32 at sample {
  let y = mk2().0~(x)                               //~ E0002
  y
}

pub flow bang_in_a_flow(x: F32 at sample) -> F32 at sample {
  let k: F32 = 2.0
  let t = (halve, k)
  t.0!(x)                                           //~ E0002
}

pub fn fine(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  t.0.(x)
}
