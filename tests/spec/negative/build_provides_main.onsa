// onsa.toml
// [package]
// name = "build_provides_main"
// edition = "2026"
//
// [export]
// prefix = "bm_"
//
// [targets.bare]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [test]
// spec = ["§8.5", "§12.3", "§15.3"]

// E0610 holds the row of each entry of the build target to what the target
// provides (§15.3, §8.5, S-1056). The entries of a target whose kind is not
// `exe` are its `@export` flows and functions (`version` here); a `main` there
// is a function like any other, not an entry, so its `uses {Alloc}` is no
// error even on a target with no heap (§12.3). The `main` of an `exe` is held
// to it when `exe` opens (phase 2, `tasks/phase2.md`; R-134).
@export
pub fn version() -> U32 { 1 }

pub fn main() uses {Alloc} {}
