// onsa.toml
// [test]
// spec = ["§2.2", "§2.3", "§18.1"]
// fixes = 0

// The boundary of S-654 (§2.3, §18.1): a word that is reserved (`clock`, `ser`, `static`) written as the name of a
// declaration is the E0200 of §2.2, and it gets no candidate (`when` and `reset_if` are keywords, S-1082:
// fixes/keyword_name_when.onsa). One error in each unit.

pub fn let_clock() -> I32 {
  let clock: I32 = 1                                //~ E0200
  1
}

pub fn param_ser(ser: I32) -> I32 {                 //~ E0200
  1
}

pub fn static() -> I32 {                            //~ E0200
  1
}
