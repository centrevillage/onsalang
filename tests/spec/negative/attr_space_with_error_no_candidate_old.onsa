// onsa.toml
// [test]
// spec = ["§2.5", "§6.4", "§6.5", "§18.1"]
// fixes = 0

// S-959 (W5-11 U10d2/t2, §2.5, §6.4, §6.5, §18.1): an attribute with a space after the `@` (S-489) that is a form of the old
// version whose replacement goes in no place there reports the E0002 of the old form, with no candidate (§18.1: the E0020 that
// cannot make a candidate is the E0002 of the syntax stage): `@ relaxed` on a struct or a constant, `@ derive(Eq)` on a
// function, `@ bulk` on a function. The space is not reported (S-959: the attribute has an error of its own). One error per declaration unit (P-01).

@ relaxed   //~ E0002
pub struct RelaxedOnAStruct {
  x: F32,
}

@ relaxed   //~ E0002
const RELAXED_CONST: F32 = 1.0

@ derive(Eq)   //~ E0002
pub fn derive_on_a_function(x: F32) -> F32 {
  x
}

@ derive(PartialEq)   //~ E0002
const DERIVE_ON_CONST: I32 = 4

@ bulk   //~ E0002
pub fn bulk_on_a_function(x: F32) -> F32 {
  x
}

@  relaxed   //~ E0002
pub struct TwoSpaces {
  x: F32,
}

pub flow bulk_on_an_input(
  x: F32 at sample,
  @ bulk   //~ E0002
  g: F32 at block,
) -> F32 at sample {
  x * g
}
