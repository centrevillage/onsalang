// onsa.toml
// [test]
// fixes = 0
// spec = ["§2.4", "§18.1"]

// How a delimiter with `#` ends when the closing has more `#` than its opening (spec §2.4, S-941, S-858). A delimiter
// with `#` is closed by a `"` and the same number of `#` as its opening, so `##"x"###` is not closed: `"###` has three
// `#` where the opening has two. The token goes on to the end of the line, nothing after the opening is read, and the
// range of the error is the opening delimiter only (a marker holds the line and the column of the main position, not the
// range). Each form has a `{` at the end of the line: it is not read (it opens no block), so the error is this E0002 at
// the opening and the `}` on the next line ends the function. If the delimiter were closed by the first two `#`
// (`##"x"##`), the `{` would be read and be never closed. Each declaration has one error (P-01). No candidate
// (fixes = 0).
// What the pass reads today and the decision keeps is in negative/lex_delimiter_long_close_quotes.onsa and
// negative/lex_delimiter_long_close_kept.onsa.

// The right forms.
pub fn fine() -> Str {
  let a = "}}"
  a
}

pub fn two_hashes_closed_by_three() -> Str {
  ##"x"### {                                         //~ E0002 @3
}

pub fn two_hashes_closed_by_four() -> Str {
  ##"x"#### {                                        //~ E0002 @3
}

pub fn one_hash_closed_by_two() -> Str {
  #"x"## {                                           //~ E0002 @3
}

pub fn one_hash_closed_by_three() -> Str {
  #"x"### {                                          //~ E0002 @3
}

pub fn three_hashes_closed_by_four() -> Str {
  ###"x"#### {                                       //~ E0002 @3
}

pub fn three_hashes_closed_by_five() -> Str {
  ###"x"##### {                                      //~ E0002 @3
}

pub fn name_and_two_hashes_closed_by_three() -> Str {
  r##"x"### {                                        //~ E0002 @3
}

pub fn name_and_one_hash_closed_by_two() -> Str {
  r#"x"## {                                          //~ E0002 @3
}

pub fn two_hashes_closed_by_three_with_text_after() -> Str {
  ##"x"### text {                                    //~ E0002 @3
}

pub fn empty_with_two_hashes_closed_by_three() -> Str {
  ##""### {                                          //~ E0002 @3
}
