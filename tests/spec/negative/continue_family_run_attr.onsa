// onsa.toml
// [test]
// spec = ["§18.1", "§6.5", "§10", "§15.1"]
// fixes = 0

// A run of modifiers that is not right, and then an attribute after it (W5-11 U4; `rt pub
// @fp(relaxed) fn`, `rt rt @fp(relaxed) fn`, `pub pub @fp(relaxed) fn`): two errors in the head of
// one item. The unit reports the first one, the run (§18.1, S-464, S-593), at its first modifier,
// and the head is read on past both, so the item is a name of the module with the modifiers as
// they were written (an `rt` stays an `rt`, a `pub` stays a `pub`), and its users are checked
// against the head. The error of the run has no candidate here: what follows the run is not the
// keyword, so the run alone does not say whether the `rt` has a place. The unit has a syntax
// error, so its body is not checked. One error in each unit.

rt pub @fp(relaxed) fn rt_pub_attr(x: F32) -> F32 { //~ E0002 @1
  x * 2.0
}

rt rt @fp(relaxed) fn rt_rt_attr(x: F32) -> F32 {   //~ E0002 @1
  x * 3.0
}

pub pub @fp(relaxed) fn pub_pub_attr(x: F32) -> F32 {   //~ E0002 @1
  x * 4.0
}

rt pub @fp(relaxed) fn body_not_checked() -> F32 {  //~ E0002 @1
  zz
}

fn calls() -> F32 {
  rt_pub_attr(1.0) + rt_rt_attr(1.0) + pub_pub_attr(1.0) + body_not_checked()
}

fn nested(c: Bool) -> F32 {
  let f = fn(x: F32) -> F32 { rt_pub_attr(x) + pub_pub_attr(x) }
  if c { f.(1.0) } else { rt_rt_attr(pub_pub_attr(2.0)) }
}

// What was written `rt` is `rt`: it may be called from an `rt` function.
rt fn calls_rt_ones(x: F32) -> F32 {
  rt_pub_attr(rt_rt_attr(x)) + body_not_checked()
}

// What was not written `rt` is not.
rt fn calls_pub_pub(x: F32) -> F32 {
  pub_pub_attr(x)                                   //~ E0901
}

// The head is the declaration that was read: a real error of a use is reported.
fn too_many_arguments() -> F32 {
  rt_pub_attr(1.0, 2.0)                             //~ E0412
}

fn wrong_argument_type() -> F32 {
  rt_rt_attr(true)                                  //~ E0401
}

fn own_error() -> F32 {
  rt_pub_attr(1.0) + zz                             //~ E0302 @22
}
