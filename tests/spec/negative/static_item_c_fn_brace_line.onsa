// onsa.toml
// [test]
// spec = ["§2.2", "§18.1", "§19.1"]
// fixes = 0

// A function of C whose `{` is on the line after its head (S-620, §18.1): the body is skipped up to the `}` that matches
// the `{` wherever the `{` is written, and is not checked, so the body, a body on one line and a nested block raise
// nothing, and the item that follows is read as usual. The item is a declaration whose type is not read, so a call of it
// raises nothing. One error in each unit.

static int add(int a, int b)                        //~ E0002
{
  return a + b;
}

static inline int one(void)                         //~ E0002
{ return 1; }

static void tick(void)                              //~ E0002
{
  int i = 0;
  while (i < 3)
  {
    i = i + 1;
  }
}

pub fn use_them() -> I32 {
  add(1, 2) + one()
}

pub fn after_the_bodies(x: I32) -> I32 {
  zz                                                //~ E0302
}
