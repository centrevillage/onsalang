// onsa.toml
// [test]
// spec = ["§11.4", "§18.1"]

// `sample_tick()` is a flow builtin (§11.4) that this version does not handle yet: as the callee
// of its call in a flow body it is the E0200 of the flow stage (§18.1, R-288), not an E0302 that
// would tell the writer to declare the name. W7-09 implements `sample_tick()`; this case is the
// form until then, and that work removes it (its value is `tests/spec/flow/builtin_sample_tick_call.onsa`).

pub flow tick_value(x: F32 at sample) -> F32 at sample {
  let t = sample_tick()                             //~ E0200
  x
}

pub flow tick_as_the_output(x: F32 at sample) -> U32 at sample {
  sample_tick()                                     //~ E0200
}

pub flow tick_in_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par i in 0 ..< 2 {
    x * (sample_tick() as F32)                      //~ E0200
  }
  ys[0] + ys[1]
}
