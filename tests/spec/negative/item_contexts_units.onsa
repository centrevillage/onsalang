// onsa.toml
// [test]
// spec = ["§6.2", "§18.1"]

// Each member of an `impl` is a unit of its own, and so is a declaration that does not belong in an `impl`: the
// error of one does not hide the error of the next, and a member between two of them is checked (spec §18.1:
// "in `impl` and `trait` the recovery is by member", S-263, R-44, S-59). The body of a wrong `struct`, `enum`,
// `flow`, `test` or `impl` is skipped to its `}`; a `use` and a `type` end at the end of their line. This
// `impl` has all of them in one, and the methods between them have an error of their own (E0401) that
// has to be reported too. One error in each unit (P-01).

pub struct Target {
  x: F32,
}

impl Target {
  enum InnerEnum {                                  //~ E0002
    A,
    B,
  }

  pub fn first(self) -> F32 {
    let flag: Bool = 1                              //~ E0401
    self.x
  }

  type Sample = F32                                 //~ E0002

  pub fn second(self) -> F32 {
    let flag: Bool = 2                              //~ E0401
    self.x
  }

  use std.math.{sqrt}                               //~ E0002

  test "a test in an impl" {                        //~ E0002
    assert true
  }

  flow inner(x: F32 at sample) -> F32 at sample {   //~ E0002
    x
  }

  impl Target {                                     //~ E0002
    pub fn nested(self) -> F32 {
      self.x
    }
  }

  pub fn third(self) -> F32 {
    let flag: Bool = 3                              //~ E0401
    self.x
  }

  pub struct Last {                                 //~ E0002
    y: F32,
  }

  pub fn fine(self) -> F32 {
    self.x
  }
}
