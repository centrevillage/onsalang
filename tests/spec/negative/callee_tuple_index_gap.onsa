// onsa.toml
// [test]
// spec = ["§2.4", "§2.5", "§6.1", "§18.1"]

// E0002 with no candidate for a space between a tuple index and a `(` outside a list (§2.5, S-606):
// a path that ends with a tuple index (`t.0`) is not a path that can be a callee, so a `(` after the
// gap is the start of something that the expression cannot continue with, as after `)` in
// `let v = g(x) (y)` (syntax_gap_no_candidate.org). There is no `,` to insert outside a list, and
// the candidate that removes the space would leave `t.0(x)`, the call of a tuple index, which is an
// error of the same stage (the E0020 of tests/spec/fixes/e0020_callee_tuple_index.onsa), so no
// candidate is offered (§18.1: a candidate that cannot be made is not offered). The error is the
// same after a name, a field, a call and an element, and before any name is looked up. Inside a list
// the gap is e0002_callee_tuple_index_gap.onsa. A gap between a tuple index and a mark `~(` or `!(`
// (`t.0 ~(x)`, `t.0 !(x)`) is the same E0002 as `mk2().0 (1)` (S-606), in a function and in a flow
// (the E0821 of a `~` out of a flow is not reached, S-591). One error per function (P-01).

pub struct Pair {
  t: (fn(I32) -> I32, I32),
}

pub fn inc(x: I32) -> I32 {
  x + 1
}

pub fn mk2() -> (fn(I32) -> I32, I32) {
  (inc, 1)
}

pub fn after_a_name(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  let v = t.0 (x)                                   //~ E0002
  v
}

pub fn after_a_field(p: Pair, x: I32) -> I32 {
  let v = p.t.0 (x)                                 //~ E0002
  v
}

pub fn after_the_result_of_a_call(x: I32) -> I32 {
  let v = mk2().0 (x)                               //~ E0002
  v
}

pub fn after_an_element(ts: [(fn(I32) -> I32, I32); 2], x: I32) -> I32 {
  let v = ts[0].0 (x)                               //~ E0002
  v
}

pub fn as_the_value_of_a_function(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  t.0 (x)                                           //~ E0002
}

pub fn after_a_name_that_is_not_defined(x: I32) -> I32 {
  let v = nope.0 (x)                                //~ E0002
  v
}

pub fn a_tilde_after_a_name(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  let v = t.0 ~(x)                                  //~ E0002
  v
}

pub fn a_bang_after_a_name(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  let v = t.0 !(x)                                  //~ E0002
  v
}

pub fn a_tilde_after_a_field(p: Pair, x: I32) -> I32 {
  let v = p.t.0 ~(x)                                //~ E0002
  v
}

pub fn a_bang_after_the_result_of_a_call(x: I32) -> I32 {
  let v = mk2().0 !(x)                              //~ E0002
  v
}

pub flow a_tilde_in_a_flow(x: I32 at sample) -> I32 at sample {
  let t = (inc, 1)
  let v = t.0 ~(x)                                  //~ E0002
  v
}

pub fn fine(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  let v = t.0.(x)
  v
}
