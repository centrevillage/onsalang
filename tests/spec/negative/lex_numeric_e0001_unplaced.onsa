// onsa.toml
// [test]
// spec = ["§2.4", "§18.1"]
// fixes = 0

// E0001 for a number with a digit outside its base where no number goes, and before a float suffix (spec
// §2.4, §18.1; S-451, S-973). A number with the prefix `0b` or `0o` whose digits do not read in its base is
// one token, the E0001 of the lexer, with no candidate. Where no number goes (the type after `as`, the place
// of an item), the place's E0002 has the same range, and §18.1 orders the two by their code (S-281): the
// E0001 is the one. A float suffix after such a digit (`0b12f32`, `0o19f32`) is the E0001 of the digit too,
// and not the E0002 of the suffix with no candidate. One error per declaration (P-01).

0b12                                                //~ E0001

pub fn binary_after_as(x: I32) -> I32 {
  x as 0b12                                         //~ E0001
}

pub fn octal_after_as(x: I32) -> I32 {
  x as 0o19                                         //~ E0001
}

pub fn binary_before_a_float_suffix() -> F32 {
  0b12f32                                           //~ E0001
}

pub fn octal_before_a_float_suffix() -> F32 {
  0o19f32                                           //~ E0001
}
