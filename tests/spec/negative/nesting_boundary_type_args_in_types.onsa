// onsa.toml
// [test]
// mode = "parse"
// spec = ["§2.5", "§4.5"]

// Boundary of the nesting depth for `::[…]` in the length of an array type (§2.5, §4.5): the length
// is a constant expression read like an expression, so `Rg::[…].CAP` counts like the same form in
// a body: `.CAP` is one level, the `::[` below it is one level, and the token that makes the level of
// `::[` is its `[` (the list is one level, like a type with arguments). The case reads the syntax
// only (`mode = "parse"`), so it does not depend on how far the later stages go.
//
// A parameter type is the first form of the declaration (the heading is not counted), so the first
// form is level 1. Every repetition `[F32; Rg::[… , 4].CAP]` is three levels: the array type, the
// `.CAP`, the `::[`. `has_256` is `Option[` and 85 repetitions: the `[` of the innermost `::[` is
// level 1 + 3 * 85 = 256, so it is read. `has_257` is `Option[Option[` and 85 repetitions: the `[`
// of the innermost `::[` is level 2 + 3 * 85 = 257, the first token over the limit in reading
// order, and one E0006 is on it (the unit is not read further, so no other error is given).

pub struct Rg[T, const N: U32] {
  d: [T; N],
}

impl[T, const N: U32] Rg[T, N] {
  pub const CAP: U32 = 4
}

pub fn has_256(a: Option[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[[F32; Rg::[F32, 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP], 4].CAP]]) -> I32 {
  1
}

