// The units around are fine.
pub fn fine(x: Option[Option[I32]]) -> I32 {
  match x {
    Some(Some(y)) => y,
    _ => 0,
  }
}

pub fn unresolved(x: Missing) -> I32 {   //~ E0302
  1
}
