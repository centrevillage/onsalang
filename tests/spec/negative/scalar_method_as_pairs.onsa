// onsa.toml
// [test]
// spec = ["§3.3", "§15.1", "§18.1"]

// E0413 (W5-02 U4b): a conversion method for a pair of types that `as` can write has no method form (spec §3.3:
// "`as` で書ける組の変換メソッドは無い"; the same type, the wider integer of the same sign, the wider signed integer
// from an unsigned one, `F32` to `F64`, the small integers into a float that holds them). Every such pair is a
// function of its own (P-01). The candidates (the `as` form) are W5-14, so the markers do not count them. The
// methods of the pairs that `as` cannot write are in ops/convert_methods_table.onsa.

pub fn i8_narrow_i8(x: I8) -> Option[I8] {
  x.narrow_i8()    //~ E0413
}

pub fn i8_narrow_i16(x: I8) -> Option[I16] {
  x.narrow_i16()    //~ E0413
}

pub fn i8_narrow_i32(x: I8) -> Option[I32] {
  x.narrow_i32()    //~ E0413
}

pub fn i8_narrow_i64(x: I8) -> Option[I64] {
  x.narrow_i64()    //~ E0413
}

pub fn i8_round_f32(x: I8) -> F32 {
  x.round_f32()    //~ E0413
}

pub fn i8_round_f64(x: I8) -> F64 {
  x.round_f64()    //~ E0413
}

