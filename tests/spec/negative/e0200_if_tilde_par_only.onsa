// onsa.toml
// [test]
// spec = ["§2.6", "§11.5", "§18.1"]

// W7-06 U0/t, S-1177: a `match~` whose arms hold only a `par` (no state: a `par` is not a thing with
// state, §11.5) has no state in any arm, so it is the E0812 of §11.5 / §2.6 ("状態を持つものを枝に含まなければ
// E0812") once `match~` is implemented (W7-06 U3a). Until then every `match~` is E0200
// ("this version does not support `match~`"; the main position is the `~`), so the file expects the E0200 and is
// rewritten to the E0812 (with the candidate that takes the `~` off) by U3a. The `if~` forms of it are E0812 since W7-06 U2:
// fixes/e0812_if_tilde_forms.onsa. What is asked here is that a
// `par` in an arm of a `match~` is no error of its own before that point: the `par` is read as it is
// written, without the E0811 that it had as a `par` without the `~` of a names-stage error. One error per flow.

pub flow match_tilde_with_a_par_only(x: F32 at sample, k: U32 at sample) -> [F32; 2] at sample {
  match~ k {                                              //~ E0200
    0 => par i in 0 ..< 2 { x * F32.round_from(i) },
    _ => [x, x],
  }
}
