// onsa.toml
// [test]
// spec = ["§2.6", "§11.5", "§18.1"]

// W7-06 U0/t, S-1177: an `if~` / `match~` whose branches hold only a `par` (no state: a `par` is not a thing with
// state, §11.5) has no state in any branch, so it is the E0812 of §11.5 / §2.6 ("状態を持つものを枝に含まなければ
// E0812") once `if~` and `match~` are implemented (W7-06 U2 and U3a). Until then every `if~` / `match~` is E0200
// ("this version does not support `if~`"; the main position is the `~`), so the file expects the E0200 and is
// rewritten to the E0812 (with the candidate that takes the `~` off) by U2 and U3a. What is asked here is that a
// `par` in a branch of an `if~` / `match~` is no error of its own before that point: the `par` is read as it is
// written, without the E0811 that it had as a `par` without the `~` of a names-stage error. One error per flow.

pub flow if_tilde_with_a_par_only(x: F32 at sample, c: Bool at sample) -> [F32; 2] at sample {
  if~ c { par i in 0 ..< 2 { x * F32.round_from(i) } } else { [x, x] }  //~ E0200
}

pub flow if_tilde_with_a_par_in_the_else(x: F32 at sample, c: Bool at sample) -> [F32; 2] at sample {
  if~ c { [x, x] } else { par i in 0 ..< 2 { x * F32.round_from(i) } }  //~ E0200
}

pub flow if_tilde_chain_with_a_par_only(x: F32 at sample, c: Bool at sample, d: Bool at sample) -> [F32; 2] at sample {
  if~ c {                                                 //~ E0200
    par i in 0 ..< 2 { x * F32.round_from(i) }
  } else if d {
    [x, x]
  } else {
    [0.0, x]
  }
}

pub flow match_tilde_with_a_par_only(x: F32 at sample, k: U32 at sample) -> [F32; 2] at sample {
  match~ k {                                              //~ E0200
    0 => par i in 0 ..< 2 { x * F32.round_from(i) },
    _ => [x, x],
  }
}
