// onsa.toml
// [test]
// spec = ["§2.5", "§3.1", "§7", "§18.1"]

// E0002, not E0013: a block body, a binary `-` with a space on both sides and a number, then a `=>` on the
// same line (`0 => { 1 } - 1 => 2,`; spec §2.5, §3.1, S-537). The block-like expression could be read as the
// left operand of the `-` (an E0013), but in the list of arms the next `=>` at the depth 0, before the next `,`
// or `}`, shows that the arm before has lost its `,`: the error is the `=>` (the main position), a missing
// `,` between two arms, and its candidate would be the insertion of a `,` before the `-`, which leaves the
// space after the prefix `-` of the pattern (E0020), so there is no candidate (§2.5: "候補は無い"). No
// E0013 is reported, so the case lists none. One error in each declaration unit. The arms with `,` and the
// patterns with a negative number written the right way, at the end.

pub fn id(x: I32) -> I32 {
  x
}

pub fn first_arm(x: I32) -> I32 {
  match x {
    0 => { 1 } - 1 => 2,                            //~ E0002
    _ => 0,
  }
}

pub fn second_arm(x: I32) -> I32 {
  match x {
    0 => 1,
    1 => { 2 } - 1 => 3,                            //~ E0002
    _ => 0,
  }
}

pub fn a_block_with_a_statement(x: I32) -> I32 {
  match x {
    0 => { id(1) } - 1 => 2,                        //~ E0002
    _ => 0,
  }
}

pub fn in_a_call(x: I32) -> I32 {
  id(match x {
    0 => { 1 } - 1 => 2,                            //~ E0002
    _ => 0,
  })
}

pub fn in_a_closure(x: I32) -> I32 {
  let f = fn(k: I32) -> I32 {
    match k {
      0 => { 1 } - 1 => 2,                          //~ E0002
      _ => 0,
    }
  }
  f.(x)
}

pub fn in_a_generic_function[T: Num](x: I32, a: T) -> T {
  match x {
    0 => { a } - 1 => a,                            //~ E0002
    _ => a,
  }
}

pub flow in_a_flow(k: I32 at block, x: F32 at sample) -> F32 at sample {
  match k {
    0 => { x } - 1 => x * 2.0,                      //~ E0002
    _ => 0.0,
  }
}

// ---------------------------------------------------------------- fine

pub fn fine(x: I32, a: I32) -> I32 {
  match x {
    0 => { 1 },
    -1 => 2,
    1 => ({ a }) - 1,
    _ => 0,
  }
}
