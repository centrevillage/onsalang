// onsa.toml
// [test]
// spec = ["§3.5", "§5.2", "§8.1", "§9.1", "§10", "§12.2"]

// W6-02 U4a/t, R-32, R-255, S-1030 (§3.5, §5.2: "`move` 引数に渡す Dup 値 ... は ... その場で複製して渡す"; §9.1; §12.2: the drop of a Shared value needs `Alloc` and "Shared 値を含む値の型を組むこと
// （要素の複製は参照カウントの増加）: 要らない", so the copy that is made is not counted, but its drop is): the Dup value that waits for the operands after it, a copy or a new value. The element of a tuple, an
// array or a struct literal and the argument of a `move` parameter, which is a borrowed `s`, the result of a call (`mk(1)`) or the receiver of a `move self` method that is a borrowed place, is a
// Dup value that is evaluated and waits for the operands after it. If a later operand is a `?` that returns, or a branch with a `return` or a `break`, the value that waits is dropped, and the drop needs
// `Alloc`: an E0601 in a function without `uses {Alloc}` and an E0901 in an `rt fn`. The value that waits is not `s` itself (the borrowed `s` is not dropped): it is the copy that is made at the
// place ("その場で複製して渡す"; §12.2 does not look at the count), the same reading as negative/drop_iter_rest_array.onsa for the copy that a loop owns. The helpers `first_n`, `first_u` and `consume` drop
// their argument, so their own E0901 is reported (the same as negative/drop_for_one_path.onsa); `mk` returns a static string and needs no `Alloc`. This version counts only the `Buf` values that wait (U3) and
// no Dup value, so none of these is reported today. The forms where nothing waits are in negative/dup_pending_contrast.onsa. The functions are one-liners (S-783). One error per function (P-01), also where two
// values wait (`two_waiting`).

pub struct Param {
  name: Str,
  value: F32,
}

impl Param {
  pub rt fn consume(move self, n: U32) -> U32 { n }   //~ E0901
}

pub rt fn mk(n: U32) -> Str { "x" }

pub rt fn first_n(move a: Str, n: U32) -> U32 { a.len() }   //~ E0901

pub rt fn first_u(move a: Str, n: U32) {}   //~ E0901

// ------------------------------------------------------------------ a borrowed value, copied at its place

pub fn tuple_borrowed(s: Str, r: Option[U32]) -> Option[(Str, U32)] { Some((s, r?)) }   //~ E0601

pub rt fn rt_tuple_borrowed(s: Str, r: Option[U32]) -> Option[(Str, U32)] { Some((s, r?)) }   //~ E0901

pub fn tuple_result(s: Str, r: Result[U32, U32]) -> Result[(Str, U32), U32] { Ok((s, r?)) }   //~ E0601

pub rt fn rt_tuple_result(s: Str, r: Result[U32, U32]) -> Result[(Str, U32), U32] { Ok((s, r?)) }   //~ E0901

pub fn array_borrowed(s: Str, r: Option[Str]) -> Option[[Str; 2]] { Some([s, r?]) }   //~ E0601

pub rt fn rt_array_borrowed(s: Str, r: Option[Str]) -> Option[[Str; 2]] { Some([s, r?]) }   //~ E0901

pub fn struct_borrowed(s: Str, r: Option[F32]) -> Option[Param] { Some(Param { name: s, value: r? }) }   //~ E0601

pub rt fn rt_struct_borrowed(s: Str, r: Option[F32]) -> Option[Param] { Some(Param { name: s, value: r? }) }   //~ E0901

pub fn call_borrowed(s: Str, r: Option[U32]) -> Option[U32] { Some(first_n(s, r?)) }   //~ E0601

pub rt fn rt_call_borrowed(s: Str, r: Option[U32]) -> Option[U32] { Some(first_n(s, r?)) }   //~ E0901

pub fn receiver_borrowed(p: Param, r: Option[U32]) -> Option[U32] { Some(p.consume(r?)) }   //~ E0601

pub rt fn rt_receiver_borrowed(p: Param, r: Option[U32]) -> Option[U32] { Some(p.consume(r?)) }   //~ E0901

pub fn tuple_option_value(o: Option[Str], r: Option[U32]) -> Option[(Option[Str], U32)] { Some((o, r?)) }   //~ E0601

pub rt fn rt_tuple_option_value(o: Option[Str], r: Option[U32]) -> Option[(Option[Str], U32)] { Some((o, r?)) }   //~ E0901

pub fn tuple_tuple_value(t: (Str, U32), r: Option[U32]) -> Option[((Str, U32), U32)] { Some((t, r?)) }   //~ E0601

pub rt fn rt_tuple_tuple_value(t: (Str, U32), r: Option[U32]) -> Option[((Str, U32), U32)] { Some((t, r?)) }   //~ E0901

// ------------------------------------------------------------------ a value built for the argument

pub fn tuple_new_value(r: Option[U32]) -> Option[(Str, U32)] { Some((mk(1), r?)) }   //~ E0601

pub rt fn rt_tuple_new_value(r: Option[U32]) -> Option[(Str, U32)] { Some((mk(1), r?)) }   //~ E0901

pub fn call_new_value(r: Option[U32]) -> Option[U32] { Some(first_n(mk(1), r?)) }   //~ E0601

pub rt fn rt_call_new_value(r: Option[U32]) -> Option[U32] { Some(first_n(mk(1), r?)) }   //~ E0901

pub fn struct_new_value(r: Option[F32]) -> Option[Param] { Some(Param { name: mk(1), value: r? }) }   //~ E0601

pub rt fn rt_struct_new_value(r: Option[F32]) -> Option[Param] { Some(Param { name: mk(1), value: r? }) }   //~ E0901

// ------------------------------------------------------------------ a branch with a `return` or a `break` in a later operand

pub fn return_in_operand(s: Str, c: Bool) -> U32 { first_n(s, if c { return 0 } else { 1 }) }   //~ E0601

pub rt fn rt_return_in_operand(s: Str, c: Bool) -> U32 { first_n(s, if c { return 0 } else { 1 }) }   //~ E0901

pub fn return_in_arm(s: Str, n: U32) -> U32 { first_n(s, match n { 0 => { return 0 }, _ => 1 }) }   //~ E0601

pub rt fn rt_return_in_arm(s: Str, n: U32) -> U32 { first_n(s, match n { 0 => { return 0 }, _ => 1 }) }   //~ E0901

pub fn break_in_operand(s: Str, c: Bool, d: Bool) { while c { first_u(s, if d { break } else { 1 }) } }   //~ E0601

pub rt fn rt_break_in_operand(s: Str, c: Bool, d: Bool) { while c { first_u(s, if d { break } else { 1 }) } }   //~ E0901

// ------------------------------------------------------------------ two values wait

pub fn two_waiting(s: Str, r: Option[U32]) -> Option[(Str, Str, U32)] { Some((s, mk(1), r?)) }   //~ E0601

pub rt fn rt_two_waiting(s: Str, r: Option[U32]) -> Option[(Str, Str, U32)] { Some((s, mk(1), r?)) }   //~ E0901
