// onsa.toml
// [test]
// spec = ["§3.1", "§3.3"]

// E0010 / E0011 / E0012: operator groups (§3.1, §3.3). One error per function (P-01).
// The groups without a strength between them are an error; multiplicative over additive over
// comparison over `&&` and `||`, and remainder over comparison, are not (S-45). The wider list of
// E0010 is in operator_groups.onsa, of E0011 in cast_operands.onsa.
pub fn mixed(w: U32, n: U32) -> U32 {
  w + 1 % n                     //~ E0010
}

pub fn compare_chain(a: F32, b: F32, c: F32) -> Bool {
  a < b < c                     //~ E0010
}

pub fn bitwise_chain(a: U32, b: U32, c: U32) -> U32 {
  a & b | c                     //~ E0010
}

pub fn and_or(p: Bool, q: Bool, r: Bool) -> Bool {
  p && q || r                   //~ E0010
}

pub fn cast_operand(x: I32) -> I64 {
  (x as I64) + 1
}

pub fn cast_bare(x: I32) -> I64 {
  x as I64 + 1                  //~ E0011
}

pub fn stacked_prefix(x: F32) -> F32 {
  - -x                          //~ E0012
}

pub fn fine(x: F32, y: F32, z: F32, lo: F32, hi: F32, xs: [F32; 2]) -> Bool {
  let a = x + y - z
  let b = x + y * z
  let c = -xs[0]
  let d = (-x) as F64
  let e = -(-x)
  let f = x * y + z * a
  let g = f > 0.0 && d > 0.0
  (lo <= a && b < hi) || c == e || g
}
