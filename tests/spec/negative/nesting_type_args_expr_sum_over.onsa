// onsa.toml
// [test]
// mode = "parse"
// spec = ["§2.5", "§4.5"]

// The height of `::[…]` in an expression is the height of its receiver plus one plus the height of its
// list of types (§2.5, §4.5, S-332): the level of `::[` is one level on top of the receiver, like a
// postfix form (`x.f::[U8](y)` is three levels: `.f`, `::[`, the call), and the types of the list are
// counted on top of that level. The token that makes the level of `::[` is its `[`.
// Every function here has one `let g = …` whose last form is exactly 257 levels deep (the body is level
// 1, the `let` is no level), one over the limit, with a receiver and a list of types that are both deep,
// so that neither is 256 alone: each gets one E0006 and nothing else (the unit is not read further). The
// file reads the syntax only (`mode = "parse"`), so the names (`s`, `xs`, `Option`) need not mean
// anything. The same functions one level shallower are in nesting/nesting_type_args_expr_sum_fits.onsa.
// Shapes: the receiver is a chain of `.a` fields, parentheses, or `[0]` indexes; the list is a type with
// arguments, a tuple type, an array type, or a function type; the list has two types and the deeper is
// the first or the second (a sequence is no level); a chain of three-level segments
// `.f::[U8](a)` with the deep list in the last or in the first segment; the same under an `if` block
// and a closure block (the body, the `if` or the closure and its block are levels 1 to 3); and the
// whole as the argument of a call (one more level).

pub fn over_field_option(s: S, xs: [S; 1], y: U8, a: U8, c: Bool) -> I32 {
  let g = s.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.m::[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[U8]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]](y)   //~ E0006
  1
}

