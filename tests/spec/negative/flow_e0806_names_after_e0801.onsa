// onsa.toml
// [test]
// spec = ["§11.2", "§18.1"]
//
// [[test.fix]]
// at = "94:11"
// code = "E0801"
// candidate = 1
// leaves = ["96:3 E0806"]
//
// [[test.fix]]
// at = "101:15"
// code = "E0801"
// candidate = 1
// leaves = ["103:3 E0806"]

// W7-04 U1a/t, U2/t, S-267, S-116: an E0801 (a name used before its `let`, §11.2; also a `^` outside a delay) before a form a flow body cannot contain (E0806,
// §11.2). The E0801 is reported: it is the first by position, and an error of the names stage ("flow の本体の名前の順（E0801 …）", §18.1), like the E0806 ("本体の制限（E0806 …）"), and of the
// diagnostics of one stage the first by position is reported. The cases with the E0806 first are in flow_e0806_names_other_codes.onsa. One error per unit.

pub rt fn g(v: F32) -> F32 {
  v
}

pub rt fn pick(v: F32) -> Option[F32] {
  Some(v)
}

pub flow lp(x: F32 at sample) -> F32 at sample {
  x
}

pub flow forward_then_var(x: F32 at sample) -> F32 at sample {
  let a = b                                         //~ E0801
  let b = x
  var c = x
  a
}

pub flow forward_then_for(x: F32 at sample) -> F32 at sample {
  let a = b                                         //~ E0801
  let b = x
  for i in 0 ..< 2 { }
  a
}

pub flow forward_then_closure(x: F32 at sample) -> F32 at sample {
  let a = b                                         //~ E0801
  let b = x
  let k = fn(v: F32) -> F32 { v }
  a
}

pub flow forward_then_function_value(x: F32 at sample) -> F32 at sample {
  let a = b                                         //~ E0801
  let b = x
  let k = g
  a
}

pub flow forward_then_assign(x: F32 at sample) -> F32 at sample {
  let a = b                                         //~ E0801
  let b = x
  b = x
  a
}

pub flow forward_then_try(x: F32 at sample) -> F32 at sample {
  let a = b                                         //~ E0801
  let b = x
  let c = pick(x)?
  a
}

pub flow forward_then_nested_let(x: F32 at sample) -> F32 at sample {
  let a = b                                         //~ E0801
  let b = x
  let y = if x > 0.0 {
    let q = x
    q
  } else {
    x
  }
  a
}

pub flow self_reference_then_var(x: F32 at sample) -> F32 at sample {
  let y = x + y                                     //~ E0801
  var a = x
  y
}

pub flow caret_outside_a_delay_then_var(x: F32 at sample) -> F32 at sample {
  let a = ^b                                        //~ E0801
  let b = x
  var c = x
  a
}

pub flow caret_in_a_user_flow_then_for(x: F32 at sample) -> F32 at sample {
  let a = lp~(^b)                                   //~ E0801
  let b = x
  for i in 0 ..< 2 { }
  a
}

pub flow forward_in_the_closure_then_closure(x: F32 at sample) -> F32 at sample {
  let a = b                                         //~ E0801
  let k = fn(v: F32) -> F32 { v }
  let b = x
  a
}
