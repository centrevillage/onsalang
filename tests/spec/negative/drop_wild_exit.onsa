// onsa.toml
// [test]
// spec = ["§5.4", "§7", "§9.1", "§9.2", "§10", "§12.2"]

// W6-02 U6/t, R-32, S-1036 (§5.4: "所有の見出し … が消費した値のうち、パターンが束縛しなかった部分（`_`、最後の `_` が残すフィールド、束縛の無い腕の対象）は、`let` … では文の終わりに、`match` の腕と `for` の本体ではその腕・反復の終わり … に破棄される。腕が panic
// で抜ければ、その破棄は起きない"; §9.2: "panic で抜ける道では、生きている値の破棄は起きない"): the part that the pattern of an arm leaves unbound is dropped at the end of the arm,
// "`return`・`break`・`continue`・`?` で出るときを含む", so an arm that leaves the function or the loop (`{ return 1 }`, `{ break }`, `{ continue }`) drops it where it leaves, and the
// arm that has a path to its end and another that leaves with `?` or `panic` drops it on the path that does not panic. The drop of a `Buf`, a `Str` or a value that holds
// one needs `Alloc`. A function without `uses {Alloc}` is an E0601 and an `rt fn` an E0901 (§10 rule 1). The first functions are arms that only leave, so that no path
// reaches the end of the arm: the drop is where the arm leaves. This version counts no drop of what an arm leaves unbound (R-32), so none of these is reported today. The
// arm that only panics is in negative/drop_wild_panic.onsa. The functions are one-liners, so that the line does not depend on where the drop is reported (S-783). One error
// per function (P-01).

pub struct K {
  b: Buf[F32],
  n: U32,
}

pub rt fn mk_ob(n: U32) -> Option[Buf[F32]] { None }

pub rt fn mk_os(n: U32) -> Option[Str] { Some("x") }

// ------------------------------------------------------------------ an arm that leaves with `return`

pub fn exit_return_some(move o: Option[Buf[F32]]) -> U32 { match move o { Some(_) => { return 1 }, None => 0 } }   //~ E0601

pub rt fn rt_exit_return_some(move o: Option[Buf[F32]]) -> U32 { match move o { Some(_) => { return 1 }, None => 0 } }   //~ E0901

pub fn exit_return_call_str(n: U32) -> U32 { match mk_os(n) { Some(_) => { return 1 }, None => 0 } }   //~ E0601

pub rt fn rt_exit_return_call_str(n: U32) -> U32 { match mk_os(n) { Some(_) => { return 1 }, None => 0 } }   //~ E0901

pub fn exit_return_wild(move b: Buf[F32]) -> U32 { match move b { _ => { return 1 } } }   //~ E0601

pub rt fn rt_exit_return_wild(move b: Buf[F32]) -> U32 { match move b { _ => { return 1 } } }   //~ E0901

pub fn exit_return_rest(move k: K) -> U32 { match move k { K { n: q, _ } => { return q } } }   //~ E0601

pub rt fn rt_exit_return_rest(move k: K) -> U32 { match move k { K { n: q, _ } => { return q } } }   //~ E0901

pub fn exit_return_in_if(c: Bool, move o: Option[Buf[F32]]) -> U32 { match move o { Some(_) => if c { return 1 } else { 2 }, None => 0 } }   //~ E0601

pub rt fn rt_exit_return_in_if(c: Bool, move o: Option[Buf[F32]]) -> U32 { match move o { Some(_) => if c { return 1 } else { 2 }, None => 0 } }   //~ E0901

// ------------------------------------------------------------------ an arm in a loop that leaves with `break` or `continue`

pub fn exit_break_some(n: U32) { for i in 0 ..< n { match mk_ob(i) { Some(_) => { break }, None => {} } } }   //~ E0601

pub rt fn rt_exit_break_some(n: U32) { for i in 0 ..< n { match mk_ob(i) { Some(_) => { break }, None => {} } } }   //~ E0901

pub fn exit_continue_some(n: U32) { for i in 0 ..< n { match mk_ob(i) { Some(_) => { continue }, None => {} } } }   //~ E0601

pub rt fn rt_exit_continue_some(n: U32) { for i in 0 ..< n { match mk_ob(i) { Some(_) => { continue }, None => {} } } }   //~ E0901

pub fn exit_break_in_while(c: Bool) { while c { match mk_ob(1) { Some(_) => { break }, None => {} } } }   //~ E0601

pub rt fn rt_exit_break_in_while(c: Bool) { while c { match mk_ob(1) { Some(_) => { break }, None => {} } } }   //~ E0901

// ------------------------------------------------------------------ an arm with `?`, and an arm that panics on one path only

pub fn exit_try_option(move o: Option[Buf[F32]], r: Option[U32]) -> Option[U32] { Some(match move o { Some(_) => r?, None => 0 }) }   //~ E0601

pub rt fn rt_exit_try_option(move o: Option[Buf[F32]], r: Option[U32]) -> Option[U32] { Some(match move o { Some(_) => r?, None => 0 }) }   //~ E0901

pub fn exit_try_result(move o: Option[Buf[F32]], r: Result[U32, U32]) -> Result[U32, U32] { Ok(match move o { Some(_) => r?, None => 0 }) }   //~ E0601

pub rt fn rt_exit_try_result(move o: Option[Buf[F32]], r: Result[U32, U32]) -> Result[U32, U32] { Ok(match move o { Some(_) => r?, None => 0 }) }   //~ E0901

pub fn exit_panic_one_branch(c: Bool, move o: Option[Buf[F32]]) -> U32 { match move o { Some(_) => if c { panic("x") } else { 0 }, None => 0 } }   //~ E0601

pub rt fn rt_exit_panic_one_branch(c: Bool, move o: Option[Buf[F32]]) -> U32 { match move o { Some(_) => if c { panic("x") } else { 0 }, None => 0 } }   //~ E0901
