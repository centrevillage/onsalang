// onsa.toml
// [package]
// name = "lower_unfit_inout_field"
// edition = "2026"
//
// [targets.c]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [test]
// spec = ["§18.1", "§4.2", "§8.1"]

// W8-16 B, S-67 (the decision of 2026-11-27), R-335: an `inout` parameter of a struct that holds a `Str` is one E0200 at
// the parameter's name (the name, not the `inout`), whether the body writes a field, reads it or neither. It used to be an
// internal error (`no field`) that stopped `onsa test` and `onsa dump --core`. The body is not read.

pub struct P { a: Buf[F32], n: U32, s: Str }

pub fn write_and_read(inout p: P) -> U32 {   //~ E0200 @29
  p.n = 3
  p.n
}

pub fn write_only(inout p: P) {   //~ E0200 @25
  p.n = 3
}

pub fn read_only(inout p: P) -> U32 {   //~ E0200 @24
  p.n
}

pub fn not_touched(inout p: P) {   //~ E0200 @26
}

// The same shape of a struct with no `Str` is lowered: no diagnostic.
pub struct Q { a: Buf[F32], n: U32 }

pub fn plain_write_and_read(inout q: Q) -> U32 {
  q.n = 3
  q.n
}
