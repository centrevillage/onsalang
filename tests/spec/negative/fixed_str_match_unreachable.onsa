// onsa.toml
// [test]
// spec = ["§7", "§18.1", "§4.2"]

// S-614 (W5-12 U3a), S-187 (§7: "前の腕で覆われて、どの値でも選ばれない腕は E0503(… `_` や束縛の後の腕、重複した `1 =>` …)"): in a `match` on a `FixedStr[N]` an arm is covered when an earlier arm has the same
// literal (the same used length and the same bytes), is a `_` or a binding, or is a choice that has it. The forms: the same literal twice, a literal after `_`, after a binding, after a choice that holds it,
// the same literal inside `Some` and inside a tuple. The marker is on the line of the arm that is covered. The arms that only look alike are chosen by some value and are fine: `"a"` and `"a\0"` are two
// values, a literal after a guarded arm of the same literal, and the same literal twice inside one choice (§7: "選択の枝の重なり(`1 | 1 =>`)は誤りでない"). One error in each function (P-01).

use std.text.FixedStr

pub fn the_same_literal_twice(t: FixedStr[8]) -> U32 {
  var r: U32 = 0
  match t {
    "a" => {
      r = 1
    },
    "b" => {
      r = 2
    },
    "a" => {                                        //~ E0503
      r = 3
    },
    _ => {
      r = 4
    },
  }
  r
}

pub fn the_same_literal_after_the_wildcard(t: FixedStr[8]) -> U32 {
  var r: U32 = 0
  match t {
    _ => {
      r = 1
    },
    "a" => {                                        //~ E0503
      r = 2
    },
  }
  r
}

pub fn a_literal_after_a_binding(t: FixedStr[8]) -> U32 {
  var r: U32 = 0
  match t {
    other => {
      r = other.len()
    },
    "a" => {                                        //~ E0503
      r = 2
    },
  }
  r
}

pub fn a_literal_after_a_choice_that_holds_it(t: FixedStr[8]) -> U32 {
  var r: U32 = 0
  match t {
    "a" | "b" => {
      r = 1
    },
    "b" => {                                        //~ E0503
      r = 2
    },
    _ => {
      r = 3
    },
  }
  r
}

pub fn the_same_literal_inside_some(o: Option[FixedStr[8]]) -> U32 {
  var r: U32 = 0
  match o {
    Some("a") => {
      r = 1
    },
    Some("a") => {                                  //~ E0503
      r = 2
    },
    Some(_) => {
      r = 3
    },
    None => {
      r = 4
    },
  }
  r
}

pub fn the_same_pair_in_a_tuple(p: (FixedStr[4], FixedStr[4])) -> U32 {
  var r: U32 = 0
  match p {
    ("a", "b") => {
      r = 1
    },
    ("a", "b") => {                                 //~ E0503
      r = 2
    },
    _ => {
      r = 3
    },
  }
  r
}

pub fn the_same_empty_string_twice(t: FixedStr[8]) -> U32 {
  var r: U32 = 0
  match t {
    "" => {
      r = 1
    },
    "" => {                                         //~ E0503
      r = 2
    },
    _ => {
      r = 3
    },
  }
  r
}

pub fn a_literal_and_the_same_with_a_nul_are_two_values(t: FixedStr[8]) -> U32 {
  var r: U32 = 0
  match t {
    "a" => {
      r = 1
    },
    "a\0" => {
      r = 2
    },
    "" => {
      r = 3
    },
    "\0" => {
      r = 4
    },
    _ => {
      r = 5
    },
  }
  r
}

pub fn the_same_literal_after_a_guard_is_chosen_by_others(t: FixedStr[8], flag: Bool) -> U32 {
  var r: U32 = 0
  match t {
    "a" if flag => {
      r = 1
    },
    "a" => {
      r = 2
    },
    _ => {
      r = 3
    },
  }
  r
}

pub fn the_same_literal_twice_in_one_choice_is_fine(t: FixedStr[8]) -> U32 {
  var r: U32 = 0
  match t {
    "a" | "a" => {
      r = 1
    },
    _ => {
      r = 2
    },
  }
  r
}
