// onsa.toml
// [test]
// spec = ["§4.1", "§15.1", "§18.1"]
// fixes = 1

// S-607, S-305, §4.1: the variant qualified by the type of the prelude enum is E0302, with one candidate that
// takes the qualifier off, in every place a body has: a branch of `if`, an arm, a closure, a generic function,
// a method of an `impl`, a loop, a `test`, a constant, and the argument of a call of an associated function.
// The scope of the candidate is the same everywhere: applying it leaves no diagnostic in the unit. One
// error in each unit (§18.1), so each place is a function of its own.

pub struct Box {
  v: Option[I32],
}

impl Box {
  pub fn empty() -> Box {
    Box { v: None }                           //~ E0302
  }

  pub fn full(x: I32) -> Box {
    Box { v: Some(x) }
  }

  pub fn clear(inout self) {
    self.v = None                            //~ E0302
  }
}

pub fn in_a_branch(c: Bool) -> Option[I32] {
  if c {
    Some(1)                                  //~ E0302
  } else {
    None
  }
}

pub fn in_the_other_branch(c: Bool) -> Option[I32] {
  if c {
    Some(1)
  } else {
    None                                     //~ E0302
  }
}

pub fn in_an_arm(x: I32) -> Option[I32] {
  match x {
    0 => None,                               //~ E0302
    n => Some(n),
  }
}

pub fn in_a_closure() -> Option[I32] {
  let f = fn(x: I32) -> Option[I32] { Some(x) }   //~ E0302
  f.(3)
}

pub fn in_a_generic_function[T](x: T) -> Option[T] {
  Some(x)                                    //~ E0302
}

pub fn in_a_loop() -> I32 {
  var n = 0
  for i in 0..<4 {
    let o = Some(i)                          //~ E0302
    n = n + or_zero(o)
  }
  n
}

pub fn or_zero(o: Option[I32]) -> I32 {
  match o {
    None => 0,
    Some(v) => v,
  }
}

pub const NOTHING: Option[I32] = None        //~ E0302

test "a qualified variant in a test" {
  let o: Option[I32] = Some(1)               //~ E0302
  assert or_zero(o) == 1
}

pub fn as_the_argument_of_an_associated_function() -> Box {
  Box.full(or_zero(Some(2)))                 //~ E0302
}
