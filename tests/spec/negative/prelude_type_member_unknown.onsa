// onsa.toml
// [test]
// spec = ["§4.1", "§15.1", "§18.1"]
// fixes = 0

// S-607, R-249, §4.1, §15.1: the type namespaces of `Option` and `Result` give no variant, and a name that
// is not a variant of the prelude and not a name of the type either (`Option.Foo`, `Result.nosuch`) is a
// name that is not found in the type: E0302 in the names stage, when it is read or in a pattern (the call is
// in `prelude_type_member_unknown_call.onsa`). It is not E0413 ("does not exist") and not E0401. No fix
// candidate: taking off the type would leave `Foo`, which no name gives, an error of the same stage (the
// contract of the candidates, §18.1). One error in each unit (§18.1).

pub fn a_read() -> Option[I32] {
  Option.nosuch                                     //~ E0302
}

pub fn a_read_of_result() -> Result[I32, I32] {
  Result.nosuch                                     //~ E0302
}

pub fn a_pattern(o: Option[I32]) -> I32 {
  match o {
    Option.Foo => 0,                                //~ E0302
    _ => 1,
  }
}

pub fn a_pattern_with_a_field(o: Option[I32]) -> I32 {
  match o {
    Option.Foo(v) => v,                             //~ E0302
    _ => 1,
  }
}
