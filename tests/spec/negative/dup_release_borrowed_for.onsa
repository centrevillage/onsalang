// onsa.toml
// [test]
// spec = ["§3.5", "§5.2", "§5.4", "§7", "§8.1", "§10", "§12.2"]

// W6-02 U4a/t, R-255, S-1030 (§5.2: "借用の `for` とガードが持つ場所でない（E0715 と同じ判定、§5.4・§7）"; §5.4: "借用の `for`（`for s in xs`）の本体では、反復元 `xs` とその一部を変更できない。代入、
// `inout` への受け渡し、`!` のメソッドの呼び出し、`move` は E0715"; §7: "借用の `match x` のガードでは、`x` とその一部を変更できない（... `move` は E0715）"): the fifth condition, the place
// is not held by a borrowed `for` or a guard. The hand-off of the iterated value `xs` in the body of `for c in xs` (borrowed), or of the heading `o` in the guard of the borrowed `match o`, is an
// E0715 in Affine terms, so the value is copied and the original is dropped at the end of its binding, and the drop needs `Alloc`: an E0601 in a function without `uses {Alloc}` and an E0901 in an `rt fn`.
// The iterated value is an array `[Str; 2]` and an `Array[Str]`; the heading of the guard is an `Option[Str]`, a struct that holds a `Str` and a tuple. A one-liner cannot show this condition
// alone: the loop goes round again (negative/dup_release_loop.onsa) and the `_` arm leaves the value alive, so each function here is an error for the other reason too. The forms that the
// condition alone decides need a `return` in the body of the loop and the hand-off again after the loop, or a guard and arms that all hand the value off. The first has a statement list, so
// its error would have a line that is not decided (S-783) and it is not written; the second is a function with no error, in negative/dup_release_borrowed_for_ok.onsa (`guard_copy_arms_move`), where a hand-off in
// the guard that moved the value would make the hand-offs of the arms copies and an error. The helpers drop their argument, so their own E0901 is reported (the same as negative/drop_for_one_path.onsa).
// Today every function here is an error, and it stays one. The functions are one-liners (S-783). One error per function (P-01).

pub struct Param {
  name: Str,
  value: F32,
}

pub rt fn eat_arr(move a: [Str; 2]) {}   //~ E0901

pub rt fn eat_vec(move a: Array[Str]) {}   //~ E0901

pub rt fn eat_go(move o: Option[Str]) -> Bool { true }   //~ E0901

pub rt fn eat_gp(move p: Param) -> Bool { true }   //~ E0901

pub rt fn eat_gt(move t: (Str, U32)) -> Bool { true }   //~ E0901

// ------------------------------------------------------------------ the body of a borrowed `for`

pub fn for_body_array(move xs: [Str; 2]) { for c in xs { eat_arr(xs) } }   //~ E0601

pub rt fn rt_for_body_array(move xs: [Str; 2]) { for c in xs { eat_arr(xs) } }   //~ E0901

pub fn for_body_dynamic_array(move xs: Array[Str]) { for c in xs { eat_vec(xs) } }   //~ E0601

pub rt fn rt_for_body_dynamic_array(move xs: Array[Str]) { for c in xs { eat_vec(xs) } }   //~ E0901

pub fn for_body_in_branch(move xs: [Str; 2], d: Bool) { for c in xs { if d { eat_arr(xs) } else { eat_arr(xs) } } }   //~ E0601

pub rt fn rt_for_body_in_branch(move xs: [Str; 2], d: Bool) { for c in xs { if d { eat_arr(xs) } else { eat_arr(xs) } } }   //~ E0901

// ------------------------------------------------------------------ the guard of a borrowed `match`

pub fn guard_option(move o: Option[Str]) -> U32 { match o { Some(b) if eat_go(o) => 1, _ => 0 } }   //~ E0601

pub rt fn rt_guard_option(move o: Option[Str]) -> U32 { match o { Some(b) if eat_go(o) => 1, _ => 0 } }   //~ E0901

pub fn guard_struct(move p: Param) -> U32 { match p { Param { name: n, value: v } if eat_gp(p) => 1, _ => 0 } }   //~ E0601

pub rt fn rt_guard_struct(move p: Param) -> U32 { match p { Param { name: n, value: v } if eat_gp(p) => 1, _ => 0 } }   //~ E0901

pub fn guard_tuple(move t: (Str, U32)) -> U32 { match t { (a, k) if eat_gt(t) => 1, _ => 0 } }   //~ E0601

pub rt fn rt_guard_tuple(move t: (Str, U32)) -> U32 { match t { (a, k) if eat_gt(t) => 1, _ => 0 } }   //~ E0901
