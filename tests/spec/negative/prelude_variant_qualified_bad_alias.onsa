// onsa.toml
// [test]
// spec = ["§4.1", "§4.4", "§18.1"]
// fixes = 0

// S-607 (W5-10 U2a; the parent wrote it after the breaker): a variant of the prelude qualified by an alias whose type has an error
// (`type X = Option[Nope]`, then `X.None`) is the E0302 of the qualified variant with no candidate: the candidate writes the
// type arguments of the alias after the name (§4.1), and a type with an error has no text of a type (`None::[_]` would be the
// E0002 of §2.2, an error of an earlier stage that §18.1 does not let a candidate leave). The alias is the error of its own unit.

type X = Option[Nope]                               //~ E0302

pub fn through_a_bad_alias() -> I32 {
  let a = X.None                                    //~ E0302
  1
}
