// onsa.toml
// [test]
// spec = ["§4.5", "§6.1"]

// A `[…]` after a field, called (`g(1).m[I32](2)`, `ts[0].m[I32](x)`), is a method's type arguments
// written in the form of another language or an index of a field that holds function values: the
// syntax cannot tell them apart, so the syntax stage lets the call through, whatever the field is a
// field of, and the type stage decides (§4.5: "メソッドに付けた `[…]` は型の段"; §6.1). Here no type has
// the member `m`: E0413 of the type stage, not the E0020 of the syntax stage that a callee which is
// no path of names gets (tests/spec/fixes/e0020_callee_tuple_index.onsa). One error per function
// (P-01).

pub struct Pt {
  k: I32,
}

pub fn g(x: I32) -> I32 {
  x
}

pub fn after_the_result_of_a_call() -> I32 {
  g(1).m[I32](2)                                    //~ E0413
}

pub fn after_an_element(ts: [Pt; 2], x: I32) -> I32 {
  ts[0].m[I32](x)                                   //~ E0413
}

pub fn after_a_path_of_names(p: Pt) -> I32 {
  p.m[I32](1)                                       //~ E0413
}
