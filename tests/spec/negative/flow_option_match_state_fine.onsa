// onsa.toml
// [test]
// spec = ["§11.5", "§18.1"]

// The right forms that replace `o.unwrap_or(a)` in a flow (W5-03 U2/t; spec §11.5: "条件と `match` の対象は常に評価されるので書ける";
// a stateful node that is bound by a `let` advances on every sample). The `Option` is matched, and no arm holds a node: the
// node is bound before the `match` and the arm reads the binding, or the subject holds the node, or the arm holds no state. The
// errors of an arm that holds a node are in negative/flow_option_match_state_arm.onsa. No diagnostic.

pub flow acc(x: F32 at sample) -> F32 at sample {
  let y = x + prev~(^y)
  y
}

pub rt fn big(v: F32) -> Option[F32] {
  if v > 2.0 { Some(v) } else { None }
}

pub flow bound_before(x: F32 at sample) -> F32 at sample {
  let o: Option[F32] = if x > 2.0 { Some(x) } else { None }
  let a = acc~(1.0)
  match o {
    Some(v) => v,
    None => a,
  }
}

pub flow node_in_the_subject(x: F32 at sample) -> F32 at sample {
  match big(acc~(x)) {
    Some(v) => v,
    None => 0.0,
  }
}

pub flow arms_without_state(x: F32 at sample) -> F32 at sample {
  let o: Option[F32] = if x > 2.0 { Some(x) } else { None }
  match o {
    Some(v) => v * 2.0,
    None => 0.0,
  }
}
