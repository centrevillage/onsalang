// onsa.toml
// [test]
// spec = ["§5.2", "§5.3"]
// fixes = 0

// S-190 (§5.2: "関数値を受け取って持つ関数は `move f: fn(I32) -> I32` と宣言し、捕捉の無い関数値だけを受ける（捕捉する無名関数を渡すと
// E0710）"; §5.3: "保存できる関数値を受け取るのは `move` の関数型の引数で、捕捉の無い関数値だけを受けて所有する"): an anonymous function that
// captures a value, passed to a `move` parameter of a function type, is an E0710 at the anonymous function, because the
// parameter keeps the function value and the environment of the capture is on the frame of the caller. The capture is of a parameter
// of any mode, a `var`, a `let`, or the field of one, and the anonymous function may be in parentheses or the tail of an `if`. The
// function item and the anonymous function without a capture are accepted (values/fn_param_first_class_ok.onsa), and the
// function value in a variable is a function without a capture. One error per function (§18.1); no candidate (`fixes = 0`).

pub struct Op {
  f: fn(I32) -> I32,
}

pub struct Gain {
  k: I32,
}

pub fn inc(x: I32) -> I32 {
  x + 1
}

pub fn keep(move f: fn(I32) -> I32) -> Op {
  Op { f: f }
}

pub fn capture_of_a_parameter(k: I32) -> I32 {
  let o = keep(fn(x: I32) -> I32 { x + k }) //~ E0710
  o.f.(1)
}

pub fn capture_of_a_let() -> I32 {
  let k = 3
  let o = keep(fn(x: I32) -> I32 { x * k }) //~ E0710
  o.f.(1)
}

pub fn capture_of_a_var() -> I32 {
  var k = 3
  k = k + 1
  let o = keep(fn(x: I32) -> I32 { x * k }) //~ E0710
  o.f.(1)
}

pub fn capture_of_a_field(g: Gain) -> I32 {
  let o = keep(fn(x: I32) -> I32 { x * g.k }) //~ E0710
  o.f.(1)
}

pub fn capture_in_parentheses(k: I32) -> I32 {
  let o = keep((fn(x: I32) -> I32 { x + k })) //~ E0710
  o.f.(1)
}

pub fn capture_as_the_tail_of_an_if(k: I32, c: Bool) -> I32 {
  let o = keep(if c {
    fn(x: I32) -> I32 { x + k } //~ E0710
  } else {
    inc
  })
  o.f.(1)
}

pub fn capture_to_a_function_value_with_a_move_parameter(h: fn(move fn(I32) -> I32) -> I32, k: I32) -> I32 {
  h.(fn(x: I32) -> I32 { x + k }) //~ E0710
}
