// onsa.toml
// [test]
// spec = ["§18.1", "§14.1", "§15.1"]
// fixes = 0

// An `extern` head that can be read (W5-11 U4 must not change this): `extern "C" lib "m" {` is
// a block like any other, which this version does not support (E0200, §14.1), and not the
// error of a head that cannot be read (S-477); the members are names of the module. The
// head with the `{` on the next line is the other error that has a candidate
// (continue_noread_extern_newline.onsa).

extern "C" lib "m" {                                //~ E0200
  fn c_abs(x: I32) -> I32
  type Raw
}

fn calls() -> I32 {
  c_abs(1)
}

fn takes(r: Raw) -> I32 {
  c_abs(2)
}

fn own_error() -> I32 {
  c_abs(1) + zz                                     //~ E0302 @14
}
