// onsa.toml
// [test]
// spec = ["§3.1", "§18.1"]
// fixes = 0

// `===` and `!==` (S-450) where `==` / `!=` in their place would leave an error of the syntax stage in the chain around
// them: another comparison (`==` cannot be chained, E0010), a bitwise operator (no strength against the comparisons,
// E0010), an `as` (E0011), a block-like operand, or an operand after it whose end the reading of the tokens does not
// know (a struct literal, after which the chain goes on). No candidate keeps the contract of §18.1 there, so the row is the
// E0002 with its note and `fixes = 0`. One form for each function (one error per unit).

pub struct P {
  x: I32,
}

pub fn comparison_before(a: I32, b: I32, c: Bool) -> Bool {
  a < b === c                                       //~ E0002
}

pub fn comparison_after(a: Bool, b: I32, c: I32) -> Bool {
  a !== b < c                                       //~ E0002
}

pub fn bitwise_before(a: I32) -> Bool {
  a & 1 === 0                                       //~ E0002
}

pub fn cast_after(a: I32, b: I16) -> Bool {
  a === b as I32                                    //~ E0002
}

pub fn if_after(a: I32, c: Bool) -> Bool {
  a === if c { 1 } else { 2 }                       //~ E0002
}

pub fn struct_literal_after(a: I32, c: I32) -> Bool {
  a === P { x: 1 }.x < c                            //~ E0002
}

pub fn struct_literal_after_ne(a: I32, c: I32) -> Bool {
  a !== P { x: 1 }.x as I32                         //~ E0002
}

// W6-04 U10c: the chain is read as the tree of §3.1, so an error of its own in the operand after it (`%` and `-` have no
// strength between them, E0010) is one the `==` in its place would leave: no candidate.
pub fn no_strength_after(a: I32, b: I32, c: I32, d: I32) -> Bool {
  a === b % c - d                                   //~ E0002
}

// W6-04 U10c/i-fix1: the operand after it is broken (two operands in a row, an operator where an operand is wanted, an
// operand missing before a `)`, the end of the line or the body of a head, a range outside the head of a `for`): the
// `==` in its place would leave that error of the syntax stage, so no candidate.
pub fn takes(v: Bool) -> Bool {
  v
}

pub fn two_operands_after(a: I32, c: I32, d: I32) -> Bool {
  a === d c                                         //~ E0002
}

pub fn ampersand_after(a: I32, c: I32) -> Bool {
  a === &c                                          //~ E0002
}

pub fn range_after(a: I32, b: I32, c: I32) -> Bool {
  a === b ..< c                                     //~ E0002
}

pub fn star_after(a: I32, b: I32) -> Bool {
  a === * b                                         //~ E0002
}

pub fn missing_before_paren(a: I32) -> Bool {
  takes(a === )                                     //~ E0002
}

pub fn plus_at_end(a: I32) -> Bool {
  a !== +                                           //~ E0002
}

pub fn two_operands_then_and(a: I32, b: I32, c: I32, p: Bool) -> Bool {
  a === b c && p                                    //~ E0002
}

pub fn missing_before_body(a: I32) -> I32 {
  if a === { 1 } {                                  //~ E0002
    1
  } else {
    2
  }
}

// W6-04 U15, R-469: the chain ends at a closer that closes no bracket around it (`)` or `]` with no opener): the `==`
// in its place would leave that error of the syntax stage, so the chain does not read, as `a === )` above
// (spec/foreign-forms.toml: "読めなければ E0002").
pub fn closer_after(a: I32, b: I32) -> Bool {
  a === b )                                         //~ E0002
}

pub fn closer_after_ne(a: I32, b: I32) -> Bool {
  a !== b )                                         //~ E0002
}

pub fn closer_after_hole(a: I32) -> Bool {
  a === _ )                                         //~ E0002
}

pub fn closer_after_hole_ne(a: I32) -> Bool {
  a !== _ )                                         //~ E0002
}

pub fn bracket_after(a: I32, b: I32) -> Bool {
  a === b ]                                         //~ E0002
}

pub fn bracket_after_ne(a: I32, b: I32) -> Bool {
  a !== b ]                                         //~ E0002
}
