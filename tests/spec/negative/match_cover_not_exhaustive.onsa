pub fn char_literals_only(c: Char) -> I32 {
  match c {                                        //~ E0501
    'a' => 1,
    'b' => 2,
  }
}

pub fn str_literals_only(s: Str) -> I32 {
  match s {                                        //~ E0501
    "a" => 1,
    "b" => 2,
  }
}

pub fn bool_without_false(b: Bool) -> I32 {
  match b {                                        //~ E0501
    true => 1,
  }
}

pub fn enum_without_a_variant(c: Color) -> I32 {
  match c {                                        //~ E0501
    Color.Red => 1,
    Color.Green => 2,
  }
}

pub fn option_without_none(o: Option[I32]) -> I32 {
  match o {                                        //~ E0501
    Some(x) => x,
  }
}

pub fn guard_on_the_only_arm_of_a_variant(o: Option[I32]) -> I32 {
  match o {                                        //~ E0501
    Some(x) if x > 0 => x,
    None => 0,
  }
}

pub fn guard_on_true(b: Bool, c: Bool) -> I32 {
  match b {                                        //~ E0501
    true if c => 1,
    false => 0,
  }
}

pub fn tuple_of_bools_without_a_combination(a: Bool, b: Bool) -> I32 {
  match (a, b) {                                   //~ E0501
    (true, true) => 1,
    (true, false) => 2,
    (false, true) => 3,
  }
}

pub fn tuple_of_an_enum_and_a_bool(t: (Color, Bool)) -> I32 {
  match t {                                        //~ E0501
    (Color.Red, _) => 1,
    (Color.Green, _) => 2,
    (Color.Blue, true) => 3,
  }
}

pub fn struct_with_a_bool_field(f: Flag) -> I32 {
  match f {                                        //~ E0501
    Flag { on: true, level: _ } => 1,
  }
}

pub fn nested_option_of_a_bool(o: Option[Bool]) -> I32 {
  match o {                                        //~ E0501
    Some(true) => 1,
    None => 0,
  }
}

pub fn literal_in_a_tuple_with_one_bool_value(n: I32, b: Bool) -> I32 {
  match (n, b) {                                   //~ E0501
    (_, true) => 1,
    (0, false) => 2,
  }
}
