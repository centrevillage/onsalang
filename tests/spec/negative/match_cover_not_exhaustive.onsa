// onsa.toml
// [test]
// spec = ["§7", "§18.1"]

// S-187 (U2 of W5-09): the matches that are not exhaustive are E0501 (§7: "`match` は網羅的（E0501）"). What counts for the exhaustiveness is the two
// values of `Bool`, the variants of an enum and the tuples and structs of them; a literal of an integer, `Char` or `Str` and an arm with a guard are
// not counted ("`U8` の 256 個の値を全て並べても、`_` か束縛が要る"). So the match of a `U8` with the 256 literals but no `_` is E0501, and so is the match with a guard on the only arm of a variant, and the missing
// variant or `Bool` value. The forms with a constant are in match_cover_not_exhaustive_constants.onsa (U1a). The marker is on the line of the `match`. One error per function (P-01). `match~` is in match_cover_tilde.onsa.

pub enum Color {
  Red,
  Green,
  Blue,
}

pub struct Flag {
  on: Bool,
  level: I32,
}

pub fn integer_literals_only(n: I32) -> I32 {
  match n {                                        //~ E0501
    1 => 1,
    2 => 2,
  }
}

