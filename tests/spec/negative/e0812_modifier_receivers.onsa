// onsa.toml
// [test]
// spec = ["§2.6", "§11.4", "§11.9", "§11.10", "§18.1"]
// fixes = 0

// W7-09 U3a/t, S-555, S-556, S-1085, S-1086, S-1091: a modifier is looked up only when the head of `.name~(` is the call of an
// instance (a user flow, a built-in delay, a modifier chain, §11.10: "`.名前~(` の頭がインスタンスの式のときだけ引く"). The E0812
// of the names stage is reported, with no candidate (`fixes = 0`), when
//   - the receiver is a value: an input, a name bound by `let` (also of an instance or of a chain: "インスタンスを指す名前は持たな
//     い"), the result of a function, a `par~`, an `if~` or a `match~` (§11.10: "`let` で受けた名前…、値、`par`・`par~`、`if~` /
//     `match~` は E0812"). A head in parentheses is read through them (S-1181): its forms are in
//     modifier_head_in_parentheses_errors.onsa;
//   - the receiver is a built-in delay and the modifier is `down` or `up`: the delay takes the clock of its first argument, so the
//     chain rate would be apart from it (S-1091, provisional (1); §11.4: "総称の遅延に `.down~`・`.up~` を付けると…誤り");
//   - the name is not one of the closed list, on an instance or on a value (`foo`, `Down`; S-1086).
// The range is the whole call. One error per flow (P-01). Where the argument has an error of the names stage too, the diagnostic of
// the call comes first by its start (§18.1), as the arguments are not part of the callee (S-818).

pub rt fn g(x: F32) -> F32 {
  x
}

pub flow lp(x: F32 at sample) -> F32 at sample {
  x * 0.5 + prev~(x) * 0.5
}

// ---- the receiver is a value ----

pub flow down_on_a_let_of_an_instance(p: F32 at block) -> F32 at sample {
  let s = lp~(p).down~(4)
  s.down~(2) at sample                              //~ E0812
}

pub flow reset_if_on_the_result_of_a_function(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  g(x).reset_if~(c)                                 //~ E0812
}

pub flow when_on_a_par_tilde(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  let ys = (par~ i in 0 ..< 2 { lp~(x) * F32.round_from(i) }).when~(c)   //~ E0812
  ys[0] + ys[1]
}

pub flow when_on_an_if_tilde(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  (if~ c { lp~(x) } else { 0.0 }).when~(c)          //~ E0812
}

// ---- a built-in delay with `down` or `up` (S-1091) ----

pub flow down_on_prev(p: F32 at sample) -> F32 at sample {
  prev~(p).down~(2)                                 //~ E0812
}

pub flow up_on_delay(p: F32 at sample) -> F32 at sample {
  delay~(p, 2).up~(2)                               //~ E0812
}

// ---- a name that the list has not (S-1086) ----

pub flow unlisted_name_on_an_instance(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  lp~(x).foo~(c)                                    //~ E0812
}

pub flow unlisted_name_on_a_value(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  x.foo~(c)                                         //~ E0812
}

pub flow unlisted_name_with_a_name_not_found_in_the_argument(x: F32 at sample) -> F32 at sample {
  lp~(x).foo~(nope)                                 //~ E0812
}
