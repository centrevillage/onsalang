// onsa.toml
// [test]
// spec = ["§2.4", "§2.5", "§5.2", "§18.1"]

// E0002 for forms of the table whose candidate would change the reading (§18.1: an E0020 is given
// only when a candidate can be made; W3-20/b):
// - a space around the `.` of `.(` after an integer literal (`1 .(2)`): without the space, `1.(2)`
//   reads as the literal `1.` (as `1.(2)` itself does, S-350);
// - the `~` of C after `move` or `inout` (`move ~x`): `!` gives `move !x`, and the operand of a
//   mark is a postfix expression, never a prefix one (§5.2, R-42).
// One error per function (P-01).

pub fn a_space_before_the_dot_of_a_literal(f: fn(I32) -> I32) -> I32 {
  1 .(2)                                            //~ E0002
}

pub fn spaces_around_the_dot_of_a_literal(f: fn(I32) -> I32) -> I32 {
  1 . (2)                                           //~ E0002
}

pub fn a_tilde_after_move(x: I32) -> I32 {
  let a = move ~x                                   //~ E0002
  a
}

pub fn a_tilde_after_inout(inout x: I32) {
  bump(inout ~x)                                    //~ E0002
}

pub fn bump(inout x: I32) {
  x = x + 1
}
