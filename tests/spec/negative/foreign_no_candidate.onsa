// onsa.toml
// [test]
// spec = ["§5.1", "§7", "§18.1"]

// Forms of other languages with no candidate: E0002, and a note that shows the Onsa form (§18.1:
// E0020 only when a candidate can be made). The rows are in docs/foreign-forms.toml with
// code = "E0002". That these have no candidate and have a note is checked in
// crates/onsa_cli/tests/foreign_candidates.rs.

pub fn compound_on_an_index(inout xs: [I32; 4], i: U32) {
  xs[i] += 1                                        //~ E0002
}

pub fn compound_in_an_expression(inout x: I32) -> I32 {
  let y = x += 1                                    //~ E0002
  y
}

pub fn post_increment_in_an_expression(inout x: I32) -> I32 {
  let y = x++                                       //~ E0002
  y
}

pub fn pre_increment_in_an_expression(inout x: I32) -> I32 {
  let y = ++x                                       //~ E0002
  y
}

pub fn increment_of_an_index(inout xs: [I32; 4]) {
  xs[0]++                                           //~ E0002
}

pub fn at_binding_on_a_pattern(o: Option[I32]) -> I32 {
  match o {
    s @ Some(_) => 1,                               //~ E0002
    None => 0,
  }
}

pub fn range_pattern_in_a_choice(o: Option[I32]) -> I32 {
  match o {
    Some(1..<3) | None => 1,                        //~ E0002
    _ => 0,
  }
}

pub fn range_pattern_in_branches_of_other_shapes(t: (I32, I32)) -> I32 {
  match t {
    (1..<3, 1) | (5..<7, 2) => 1,                  //~ E0002
    _ => 0,
  }
}

pub fn range_outside_a_header() -> I32 {
  let r = 0..<4                                     //~ E0002
  1
}

pub fn fine(inout x: I32) {
  x = x + 1
}
