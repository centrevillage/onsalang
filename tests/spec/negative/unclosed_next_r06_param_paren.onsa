// onsa.toml
// [test]
// spec = ["§18.1", "§2.5"]
// fixes = 0

// `fn f(a: I32 {`: the `)` of the parameters is missing, and the reading stops at the `{` (R6).
// The unit ends at the item that follows it, on a line with the same or a shallower indentation. A bracket that is not closed
// is reported whatever stopped the reading: the E0002 points at the innermost bracket that is not closed (§18.1, S-943,
// R-371). The same file without the item after the unit is unclosed_eof_r06_param_paren.onsa, and the report is on the same line.

fn f(a: I32 {                                   //~ E0002 @5
  a
}
fn z() -> I32 { 1 }
