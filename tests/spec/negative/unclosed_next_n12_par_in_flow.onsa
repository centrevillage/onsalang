// The `{` of a `par~` never closed, in a flow whose `{` is never closed.
// The unit ends at the item that follows it, on a line with the same or a shallower indentation. A bracket that is not closed
// is reported whatever stopped the reading: the E0002 points at the innermost bracket that is not closed (§18.1, S-943,
// R-371). The same file without the item after the unit is unclosed_eof_n12_par_in_flow.onsa, and the report is on the same line.

pub flow unison(f0: F32 at block) -> F32 at sample {
  let saws = par~ i in 0 ..< 4 {                //~ E0002 @32
    saw~(f0)
fn z() -> I32 { 1 }
