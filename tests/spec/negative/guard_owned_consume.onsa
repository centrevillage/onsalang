// onsa.toml
// [test]
// spec = ["§3.5", "§5.1", "§5.2", "§5.4", "§7"]
// fixes = 0

// W6-02 U2b/t, S-1039, R-454 (§7: "所有の `match`（`match move x` と場所でない対象、§5.4）のガードでは、その腕の束縛を消費できない（`move`、Affine の
// フィールドの取り出し、束縛の見出しの `move`、`?` の被演算子、`move self` の受け手、返り値の位置は E0715。修正候補は無い）。腕が選ばれるまで対象の値は
// 一つのままで、ガードが偽なら後の腕が同じ値で判定される"): the guard of an arm of `match move o` (the heading is moved, so the binding of the arm owns the
// content once the arm is chosen) cannot consume the binding of the arm, whatever the form of the consumption: a `move` argument, the take-out of an Affine
// field (`move h.buf`, which consumes the whole `h`, §5.2), a `move` of the binding as the heading of an inner `match`, a `move` of it in the initializer
// of a `let` of a block that is the guard, a `?` on it (the operand of `?` is a consuming place, §9), a `move self` receiver, the return position
// (`return b`), and the same forms in the right operand of `&&` and `||` (§3.5: a guard that may not be evaluated all the way). This version accepts
// all of them (R-454): the guard moves `b`, and if it is false a later arm binds the value that is moved. The error is at the consumption, there is no
// candidate (`fixes = 0`), and the later arm here is `_` (the later arm that binds the same value is in negative/guard_owned_consume_next_arm.onsa, the
// heading that is not a place in negative/guard_owned_consume_temp.onsa). The consumption of the binding of the arm is the only error: the binding
// stays live in the arm and its drop is allowed by `uses {Alloc}`, `eat` is a function that is legal. The functions are one-liners (the `let` form is
// the only block: its error is at its `let` line, the only line that consumes `b`), so that the line does not depend on where the drop is reported
// (S-783). One error per function (P-01).

pub struct Holder {
  buf: Buf[F32],
  gain: F32,
}

impl Holder {
  pub fn eat_self(move self) -> Bool uses {Alloc} { true }
}

pub fn eat(move b: Buf[F32]) -> Bool uses {Alloc} { true }

// ------------------------------------------------------------------ the forms of the consumption (the heading is `move o`, the later arm is `_`)

pub fn g_move(move o: Option[Buf[F32]]) -> U32 uses {Alloc} { match move o { Some(b) if eat(move b) => 1, _ => 0 } }   //~ E0715

pub fn g_field(move o: Option[Holder]) -> U32 uses {Alloc} { match move o { Some(h) if eat(move h.buf) => 1, _ => 0 } }   //~ E0715

pub fn g_heading(move o: Option[Buf[F32]]) -> U32 uses {Alloc} { match move o { Some(b) if (match move b { t => eat(move t) }) => 1, _ => 0 } }   //~ E0715

pub fn g_let_heading(move o: Option[Buf[F32]]) -> U32 uses {Alloc} {
  match move o {
    Some(b) if {
      let c = move b   //~ E0715
      c.len() > 0
    } => 1,
    _ => 0,
  }
}

pub fn g_try(move o: Option[Option[Buf[F32]]]) -> Option[U32] uses {Alloc} { match move o { Some(r) if eat(r?) => Some(1), _ => Some(0) } }   //~ E0715

pub fn g_self(move o: Option[Holder]) -> U32 uses {Alloc} { match move o { Some(h) if h.eat_self() => 1, _ => 0 } }   //~ E0715

pub fn g_return(c: Bool, move o: Option[Buf[F32]]) -> Buf[F32] uses {Alloc} { match move o { Some(b) if (if c { return b } else { false }) => Buf.zeroed(1), _ => Buf.zeroed(0) } }   //~ E0715

// ------------------------------------------------------------------ the right operand of `&&` and `||`

pub fn g_and_right(c: Bool, move o: Option[Buf[F32]]) -> U32 uses {Alloc} { match move o { Some(b) if c && eat(move b) => 1, _ => 0 } }   //~ E0715

pub fn g_or_right(c: Bool, move o: Option[Buf[F32]]) -> U32 uses {Alloc} { match move o { Some(b) if c || eat(move b) => 1, _ => 0 } }   //~ E0715

pub fn g_and_field(c: Bool, move o: Option[Holder]) -> U32 uses {Alloc} { match move o { Some(h) if c && eat(move h.buf) => 1, _ => 0 } }   //~ E0715

pub fn g_and_self(c: Bool, move o: Option[Holder]) -> U32 uses {Alloc} { match move o { Some(h) if c && h.eat_self() => 1, _ => 0 } }   //~ E0715

pub fn g_and_try(c: Bool, move o: Option[Option[Buf[F32]]]) -> Option[U32] uses {Alloc} { match move o { Some(r) if c && eat(r?) => Some(1), _ => Some(0) } }   //~ E0715

// ------------------------------------------------------------------ the kinds of pattern and heading (the guard of any arm)

pub fn g_second_guard(move o: Option[Buf[F32]]) -> U32 uses {Alloc} { match move o { Some(b) if b.len() > 0 => 1, Some(c) if eat(move c) => 2, _ => 0 } }   //~ E0715

pub fn g_struct_pattern(move h: Holder) -> U32 uses {Alloc} { match move h { Holder { buf: b, gain: _ } if eat(move b) => 1, _ => 0 } }   //~ E0715

pub fn g_tuple_pattern(move p: (Buf[F32], U32)) -> U32 uses {Alloc} { match move p { (b, n) if eat(move b) => n, _ => 0 } }   //~ E0715

pub fn g_binding_pattern(move b: Buf[F32]) -> U32 uses {Alloc} { match move b { t if eat(move t) => 1, _ => 0 } }   //~ E0715

pub fn g_nested_pattern(move o: Option[(Buf[F32], U32)]) -> U32 uses {Alloc} { match move o { Some((b, n)) if eat(move b) => n, _ => 0 } }   //~ E0715

pub fn g_in_branch(c: Bool, move o: Option[Buf[F32]]) -> U32 uses {Alloc} { if c { match move o { Some(b) if eat(move b) => 1, _ => 0 } } else { 2 } }   //~ E0715

pub fn g_in_arm(n: U32, move o: Option[Buf[F32]]) -> U32 uses {Alloc} { match n { 0 => match move o { Some(b) if eat(move b) => 1, _ => 0 }, _ => 2 } }   //~ E0715

pub fn g_as_argument(move o: Option[Buf[F32]]) -> U32 uses {Alloc} { 1 + (match move o { Some(b) if eat(move b) => 1, _ => 0 }) }   //~ E0715
