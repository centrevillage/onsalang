// onsa.toml
// [test]
// spec = ["§2.5", "§7", "§8.3", "§5.2", "§18.1"]

// E0002 for a keyword at the end of a line, outside every pair of brackets (spec §2.5, S-416): the keywords in an
// expression (`if` and `match` before the condition or the subject, the `if` after an `else`, `with` before its handler,
// `move` before its operand) have no rule of where their operand stands, as `as` and `at` have none, and in a pair of
// brackets a line break is a space there (tests/spec/lex/keyword_operand_in_brackets.onsa). Outside the brackets the
// keyword ends the line (a line ends the statement, §2.5): the operand that the keyword needs is missing, and the error is the E0002 that
// the form gives today, kept, without a candidate (no `fmt` and no E0003: the rule of the place of `else` and `with`
// is about the `}` before them, and `with` and its handler are not made one by a candidate, S-414, S-416).
// The marker is on the line of the keyword. One error in each declaration unit (P-01).

pub fn if_condition(c: Bool) -> I32 {
  if                                                //~ E0002
    c { 1 } else { 2 }
}

pub fn if_condition_in_a_let(c: Bool) -> I32 {
  let a = if                                        //~ E0002
    c { 1 } else { 2 }
  a
}

pub fn match_subject(o: Option[I32]) -> I32 {
  match                                             //~ E0002
    o {
    Some(v) => v,
    None => 0,
  }
}

pub fn else_if_condition(c: Bool, d: Bool) -> I32 {
  if c { 1 } else if                                //~ E0002
    d { 2 } else { 3 }
}

pub fn else_if_condition_in_a_chain(c: Bool, d: Bool, e: Bool) -> I32 {
  if c {
    1
  } else if d {
    2
  } else if                                         //~ E0002
    e {
    3
  } else {
    4
  }
}

pub fn handler_name(x: I32) -> I32 {
  let r = handle { x } with                         //~ E0002
    quiet
  r
}

pub fn move_operand(x: Pt) -> Pt {
  let y = move                                      //~ E0002
    x
  y
}

pub fn for_move_operand(xs: [I32; 4]) -> I32 {
  var t = 0
  for s in move                                     //~ E0002
    xs {
    t = t + s
  }
  t
}

pub struct Pt {
  x: I32,
}

pub flow tilde_condition(c: Bool at sample) -> F32 at sample {
  if~                                               //~ E0002
    c { 1.0 } else { 2.0 }
}

pub flow tilde_match_subject(k: U32 at sample) -> F32 at sample {
  match~                                            //~ E0002
    k {
    0 => 1.0,
    _ => 2.0,
  }
}

// The right forms: the operand on the line of the keyword.
pub fn fine(c: Bool, d: Bool, o: Option[I32]) -> I32 {
  let a = if c { 1 } else if d { 2 } else { 3 }
  let b = match o {
    Some(v) => v,
    None => 0,
  }
  a + b
}
