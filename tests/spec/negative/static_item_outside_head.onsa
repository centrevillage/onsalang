// onsa.toml
// [test]
// spec = ["§2.2", "§18.1"]

// The boundary of the forms of `static` (S-620, §2.2): a `static` that is not at the head of an item (a statement of a body,
// an operand, a type position) is not read as another language's item. It stays the reserved word that this version does not
// accept as syntax, E0200 at the place where it stands. One error in each unit.

pub fn in_a_statement() -> I32 {
  static N: I32 = 4                                 //~ E0200
  N
}

pub fn in_an_operand(x: I32) -> I32 {
  let a: I32 = x + static                           //~ E0200
  a
}

pub fn in_a_type(x: static) -> I32 {                //~ E0200
  1
}
