// onsa.toml
// [test]
// spec = ["§2.5", "§6.4", "§6.5", "§18.1"]
// fixes = 0

// S-959 and S-957 (W5-11 U10d2/t2, §2.5, §6.5, §18.1): a line break after the `@` of an attribute (S-957) that is a form of the old
// version whose replacement goes in no place there reports the E0002 of the old form, with no candidate, as the space
// does (attr_space_with_error_no_candidate_old.onsa): the line break is not reported (S-959: the attribute has an error of
// its own). The main position is the attribute, from the `@` (§18.1: the range of a form that is not in the language
// starts at its first token), the line the `@` stands on. Before S-957 this was the E0002 "expected attribute name, found
// newline" at the `@`, with no candidate, so the code is the same and the text says another thing. One error per
// declaration unit (P-01).

@   //~ E0002 @1
  relaxed
pub struct RelaxedOnAStruct {
  x: F32,
}

@   //~ E0002 @1
  derive(Eq)
pub fn derive_on_a_function(x: F32) -> F32 {
  x
}

pub flow bulk_on_an_input(
  x: F32 at sample,
  @   //~ E0002 @3
  bulk
  g: F32 at block,
) -> F32 at sample {
  x * g
}
