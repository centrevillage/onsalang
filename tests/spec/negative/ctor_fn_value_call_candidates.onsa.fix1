// onsa.toml
// [test]
// spec = ["§4.4", "§5.2", "§5.4", "§18.1"]
// fixes = 1

// E0703, W5-03 U1/t, S-872, R-361 (§4.4: "関数値の引数は `move` で、`f.(x)` は直接の呼び出し `Shape.Circle(x)` と同じく要素を値で受ける
// （§5.2）"; §5.2: "構築子 … の要素は … 値で受ける"; "`f(move x)`（Affine 値。Dup 値は `f(x)`）"): a call through the function
// value of a constructor (`let f = Hold.B`, then `f.(x)`) has the same diagnostic as a call through any function value whose
// parameter is `move`. An owned Affine value without the mark is an E0703 whose one candidate inserts `move`; a `move` on a
// Copy value is an E0703 whose one candidate removes it. Before the work, the constructor took its payload as a borrow, so
// `f.(b)` was accepted and gave a borrowed Buf to a value that is returned (R-361). The callee in the last two functions
// is a function value of a parameter, the form the constructor now has. One error per function (P-01).

pub enum Hold {
  B(Buf[F32]),
  C(U32),
}

pub struct Holder {
  buf: Buf[F32],
  gain: F32,
}

pub fn an_owned_affine_value_without_the_mark(move b: Buf[F32]) -> Hold uses {Alloc} {
  let f = Hold.B
  f.(move b)                                                          //~ E0703
}

pub fn an_owned_affine_field_without_the_mark(move s: Holder) -> Hold uses {Alloc} {
  let f = Hold.B
  f.(move s.buf)                                                      //~ E0703
}

pub fn a_copy_value_with_the_mark(n: U32) -> Hold {
  let f = Hold.C
  f.(n)                                                     //~ E0703
}

pub fn an_owned_copy_value_with_the_mark(move n: U32) -> Hold {
  let f = Hold.C
  f.(n)                                                     //~ E0703
}

pub fn the_variant_of_the_prelude_with_a_mark_on_a_copy_value(n: U32) -> Option[U32] {
  let f: fn(move U32) -> Option[U32] = Some
  f.(n)                                                     //~ E0703
}

pub fn the_variant_of_the_prelude_without_the_mark_on_an_affine_value(move b: Buf[F32]) -> Option[Buf[F32]] uses {Alloc} {
  let f: fn(move Buf[F32]) -> Option[Buf[F32]] = Some
  f.(move b)                                                          //~ E0703
}

pub fn the_same_with_a_function_value_that_is_a_parameter(g: fn(move Buf[F32]) -> Hold, move b: Buf[F32]) -> Hold uses {Alloc} {
  g.(move b)                                                          //~ E0703
}

pub fn the_same_with_a_mark_on_a_copy_value_of_a_parameter(g: fn(move U32) -> Hold, n: U32) -> Hold {
  g.(n)                                                     //~ E0703
}

pub fn fine(move b: Buf[F32]) -> Hold {
  let f = Hold.B
  f.(move b)
}
