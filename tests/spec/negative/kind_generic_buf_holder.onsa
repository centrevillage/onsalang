// onsa.toml
// [test]
// spec = ["§4.5", "§4.6", "§5.2", "§5.3"]

// R-30 (W4-05 U1, kept by W4-16 U3; §4.6: "Affine … それらを含む型", §4.5): a generic type whose `?Dup` parameter is given a
// `Buf` holds an Affine value, so it is Affine: the second `move` is E0704 (§5.2) and the capture by an anonymous
// function is E0712 (§5.3). This is the answer of types/affine_generic_holder_alone.onsa for more shapes
// (a field, a field in a tuple, and `let` and capture), and it must stay after the kinds that are not found are
// taken for Affine (negative/kind_maybe_dup_struct.onsa). One error per function (P-01).

pub struct Holder[T: ?Dup] {
  items: (T, U32),
}

pub struct Direct[T: ?Dup] {
  item: T,
}

pub fn run(f: fn(U32) -> U32) -> U32 {
  f.(1)
}

pub fn take(move h: Holder[Buf[F32]]) uses {Alloc} {}

pub fn concrete_split(move h: Holder[Buf[F32]]) -> U32 uses {Alloc} {
  let a = move h
  let b = move h                //~ E0704
  take(move a)
  take(move b)
  1
}

pub fn concrete_direct_split(move d: Direct[Buf[F32]]) -> U32 uses {Alloc} {
  let a = move d
  let b = move d                //~ E0704
  let _ = (move a, move b)
  1
}

pub fn concrete_captured(h: Holder[Buf[F32]]) -> U32 {
  run(fn(i) { i + measure_buf(h) })   //~ E0712
}

pub fn measure_buf(h: Holder[Buf[F32]]) -> U32 {
  0
}

pub fn measure_direct(d: Direct[Buf[F32]]) -> U32 {
  0
}

pub fn concrete_direct_captured(d: Direct[Buf[F32]]) -> U32 {
  run(fn(i) { i + measure_direct(d) })   //~ E0712
}

pub fn concrete_held_in_a_tuple(move t: (Holder[Buf[F32]], U32)) -> U32 uses {Alloc} {
  let a = move t
  let b = move t                //~ E0704
  let _ = (move a, move b)
  1
}
