// onsa.toml
// [test]
// spec = ["§5.2", "§5.3"]
// fixes = 0

// R-31, S-805 (§5.2, §5.3): "部分ビュー（`xs.slice(from, to)`、§5.3）も範囲によらず、元の場所、その添字、同じ元のほかの
// 部分ビューと重なる（`f(inout a.slice(0, 4), a.slice(4, 8))` は E0702）". A view is a part of the place it is taken from, so
// in one call a view and the whole place, an element of the place, or another view of the same place overlap whatever the
// ranges are (the bounds are run-time values, and the ranges `[0, 4)` and `[4, 8)` that cannot meet overlap as well), when
// one of the two is `inout` (the receiver of an `inout self` method is one). The view of a view is the place of the root. The
// error is at the later written of the two, one per function (P-01), with no repair candidate (`fixes = 0`: which of the two
// to change is the writer's design). Two borrowed views are two reads and do not overlap, and views of other places do not
// (values/overlap_views_ok.onsa). The planar literals are in negative/overlap_views_planar.onsa, the writes through a
// view that cannot be written in negative/view_not_writable.onsa.

pub struct Voice {
  buf: Buf[F32],
  gain: F32,
}

impl Voice {
  pub fn mix_halves(inout self) {
    self.buf.slice(0, 2).copy_from!(self.buf.slice(2, 4)) //~ E0702
  }

  pub fn add_whole(inout self) {
    add(inout self.buf.slice(0, 2), self.buf) //~ E0702
  }
}

fn fill(inout s: Span[F32]) {
  s.fill!(1.0)
}

fn add(inout dst: Span[F32], src: Span[F32]) {
  dst.add_from!(src)
}

fn add_rev(src: Span[F32], inout dst: Span[F32]) {
  dst.add_from!(src)
}

fn two(inout a: Span[F32], inout b: Span[F32]) {
  a.fill!(1.0)
  b.fill!(2.0)
}

fn put(inout x: F32, src: Span[F32]) {
  x = src[0]
}

fn add_one(inout dst: Span[F32], x: F32) {
  dst.fill!(x)
}

// ------------------------------------------- a view and the whole place (R-31: they passed before)

pub fn whole_inout_and_view_borrowed() {
  var a: [F32; 8] = [1.0; 8]
  add(inout a, a.slice(0, 8)) //~ E0702
}

pub fn view_borrowed_and_whole_inout() {
  var a: [F32; 8] = [1.0; 8]
  add_rev(a.slice(0, 8), inout a) //~ E0702
}

pub fn view_inout_and_whole_borrowed() {
  var a: [F32; 8] = [1.0; 8]
  add(inout a.slice(0, 4), a) //~ E0702
}

pub fn receiver_whole_and_view_argument() {
  var a: [F32; 8] = [1.0; 8]
  a.copy_from!(a.slice(0, 8)) //~ E0702
}

pub fn receiver_whole_and_a_part() {
  var a: [F32; 8] = [1.0; 8]
  a.add_from!(a.slice(4, 8)) //~ E0702
}

pub fn receiver_view_and_whole_argument() {
  var a: [F32; 8] = [1.0; 8]
  a.slice(0, 4).copy_from!(a) //~ E0702
}

pub fn buffer(n: U32) uses {Alloc} {
  var b: Buf[F32] = Buf.zeroed(n)
  add(inout b, b.slice(0, 2)) //~ E0702
}

pub fn span_parameter(inout s: Span[F32]) {
  s.copy_from!(s.slice(2, 4)) //~ E0702
}

pub fn array_parameter(inout a: [F32; 8]) {
  add(inout a, a.slice(0, 4)) //~ E0702
}

// ---------------------------------------------------------- two views of the same place (S-805)

pub fn disjoint_ranges_inout_and_borrowed() {
  var a: [F32; 8] = [1.0; 8]
  add(inout a.slice(0, 4), a.slice(4, 8)) //~ E0702
}

pub fn disjoint_ranges_borrowed_and_inout() {
  var a: [F32; 8] = [1.0; 8]
  add_rev(a.slice(0, 4), inout a.slice(4, 8)) //~ E0702
}

pub fn disjoint_ranges_two_inouts() {
  var a: [F32; 8] = [1.0; 8]
  two(inout a.slice(0, 4), inout a.slice(4, 8)) //~ E0702
}

pub fn disjoint_ranges_receiver() {
  var a: [F32; 8] = [1.0; 8]
  a.slice(0, 4).copy_from!(a.slice(4, 8)) //~ E0702
}

pub fn run_time_bounds(n: U32) {
  var a: [F32; 8] = [1.0; 8]
  add(inout a.slice(0, n), a.slice(n, 8)) //~ E0702
}

pub fn the_same_range_twice() {
  var a: [F32; 8] = [1.0; 8]
  two(inout a.slice(2, 4), inout a.slice(2, 4)) //~ E0702
}

pub fn view_of_a_view_and_a_view() {
  var a: [F32; 8] = [1.0; 8]
  add(inout a.slice(0, 8).slice(1, 2), a.slice(4, 6)) //~ E0702
}

pub fn view_of_a_view_receiver() {
  var a: [F32; 8] = [1.0; 8]
  a.slice(0, 4).slice(0, 1).copy_from!(a.slice(6, 8)) //~ E0702
}

pub fn views_of_a_buffer(n: U32) uses {Alloc} {
  var b: Buf[F32] = Buf.zeroed(n)
  two(inout b.slice(0, 1), inout b.slice(1, 2)) //~ E0702
}

pub fn views_of_a_span_parameter(inout s: Span[F32]) {
  add(inout s.slice(0, 2), s.slice(2, 4)) //~ E0702
}

pub fn views_of_a_field(inout v: Voice) {
  add(inout v.buf.slice(0, 2), v.buf.slice(2, 4)) //~ E0702
}

// ------------------------------------------------------ a view and an element of the same place

pub fn view_borrowed_and_element_inout() {
  var a: [F32; 8] = [1.0; 8]
  put(inout a[5], a.slice(0, 4)) //~ E0702
}

pub fn element_borrowed_and_view_inout() {
  var a: [F32; 8] = [1.0; 8]
  add_one(inout a.slice(0, 4), a[5]) //~ E0702
}

pub fn element_with_a_run_time_index(i: U32) {
  var a: [F32; 8] = [1.0; 8]
  add_one(inout a.slice(0, 4), a[i]) //~ E0702
}

pub fn receiver_view_and_element() {
  var a: [F32; 8] = [1.0; 8]
  a.slice(0, 4).fill!(a[6]) //~ E0702
}

// ------------------------------------------------------------ in a branch, a loop and an arm

pub fn in_a_branch(c: Bool) {
  var a: [F32; 8] = [1.0; 8]
  if c {
    add(inout a.slice(0, 4), a.slice(4, 8)) //~ E0702
  }
}

pub fn in_a_loop(n: U32) {
  var a: [F32; 8] = [1.0; 8]
  for i in 0 ..< n {
    a.slice(0, 4).copy_from!(a.slice(i, 8)) //~ E0702
  }
}

pub fn in_an_arm(o: Option[U32]) {
  var a: [F32; 8] = [1.0; 8]
  match o {
    Some(_) => add(inout a, a.slice(0, 2)), //~ E0702
    None => {},
  }
}

// A view after a `move` of its place is a place argument too: E0702, not the E0704 of a read after the move (§5.2).
fn eat_with(move h: Buf[F32], s: Span[F32]) uses {Alloc} {}

pub fn a_view_after_a_move_of_its_place() uses {Alloc} {
  var b: Buf[F32] = Buf.zeroed(4)
  eat_with(move b, b.slice(0, 1)) //~ E0702
}

// ------------------------------------------------------------------- no error: the control

pub fn only_one_view_is_written() {
  var a: [F32; 8] = [1.0; 8]
  fill(inout a.slice(0, 4))
  fill(inout a.slice(4, 8))
}
