// onsa.toml
// [test]
// spec = ["§15.1", "§18.1", "§3.4"]
// fixes = 0

// S-515 (U6 of W5-11): an empty `use` list with a comment inside is still the E0002 of the syntax stage, but it
// has no candidate (§15.1: the candidate that takes out the whole `use` would take the comment with it, so there
// is none; `fixes = 0` checks that no diagnostic of the file has one). The comment is inside the list in each
// form here: on a line of its own, after the `{` on the line of the `{`, and after the `{` of a one-line list
// that goes on to the next line. A comment after the `}` is outside the list: its candidate is in
// use_empty_list_forms.onsa. A line break in the braces makes a multi-line diagnostic, whose line is the
// line of the `{`.

use std.array

use std.math.{                                      //~ E0002
  // nothing is brought in
}

use std.time.{ // a comment after the brace         //~ E0002
}

use std.io.{                                        //~ E0002
  // two lines

  // of comments
}

pub fn filled() -> [I32; 2] {
  array.from_fn(fn(i: U32) -> I32 { 1 })
}
