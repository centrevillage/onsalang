// onsa.toml
// [test]
// spec = ["§11.5", "§12.2", "§5.4", "§18.1"]
// fixes = 0

// W7-06 U3a/t, S-1043 (b), S-110 (§11.5: "flow の本体は効果を使わない。… 破棄に `Alloc` の要る所有の値を作る式（呼び出しの結果、所有の行のリテラル、§5.4）は、式のクロックによらず E0805 である。
// 位置はその式で、修正候補は無い"): the arm of a `match~` is evaluated like the rest of the body, so an expression that makes a value whose drop needs `Alloc` in it is E0805 at that expression, in an arm
// body, in a guard and in the scrutinee (the `match~` was E0200 before W7-06 and hid it: the walk of the check did not go into its arms). `mk` is a function that returns a `Str`, so the temporary
// `mk(1)` of `mk(1).len()` is dropped with `Alloc`. Every `match~` holds a thing with state in an arm body (it is no E0812), the error has no candidate (`fixes = 0`), and one error per flow
// (P-01); the marker is on the line of the offending expression.

pub rt fn mk(n: U32) -> Str {
  "x"
}

pub flow acc(x: F32 at sample) -> F32 at sample {
  let y = x + prev~(^y)
  y
}

pub flow in_the_first_arm(x: F32 at sample, k: U32 at sample) -> F32 at sample {
  match~ k {
    0 => acc~(F32.round_from(mk(1).len()) * x), //~ E0805
    _ => 0.0,
  }
}

pub flow in_the_last_arm(x: F32 at sample, k: U32 at sample) -> F32 at sample {
  match~ k {
    0 => acc~(x),
    _ => F32.round_from(mk(1).len()) * x, //~ E0805
  }
}

pub flow in_a_guard(x: F32 at sample, k: U32 at sample) -> F32 at sample {
  match~ k {
    0 if mk(1).len() > 0 => acc~(x), //~ E0805
    _ => 0.0,
  }
}

pub flow in_the_scrutinee(x: F32 at sample) -> F32 at sample {
  match~ (mk(1).len() > 0) { //~ E0805
    true => acc~(x),
    false => 0.0,
  }
}

pub flow in_the_value_of_a_let(x: F32 at sample, k: U32 at sample) -> F32 at sample {
  let a = match~ k { 0 => acc~(x), _ => F32.round_from(mk(1).len()) } //~ E0805
  a
}

pub flow in_a_match_tilde_in_an_arm(x: F32 at sample, k: U32 at sample, j: U32 at sample) -> F32 at sample {
  match~ k {
    0 => (match~ j { 0 => acc~(x), _ => F32.round_from(mk(1).len()) }), //~ E0805
    _ => 0.0,
  }
}

// ---- Not an error: a value that needs no `Alloc` in an arm ----

pub flow a_call_that_returns_a_number(x: F32 at sample, k: U32 at sample) -> F32 at sample {
  match~ k {
    0 => acc~(x),
    _ => F32.round_from(7) * x,
  }
}
