// onsa.toml
// [test]
// spec = ["§2.2", "§19.1", "§18.1"]

// W4-20 U1/t, S-745: `ser i in a ..< b { e }` without the `~` is E0200 in this version too (§19.1: "今は
// `ser`・`ser~` とも E0200"; §2.2: "`ser` … 構文として受け付けない（現れた位置で E0200、機能名を添える）"):
// `ser` is a reserved word that no form accepts, so the `~` is not what is judged (whereas the `par` of a
// flow body without the `~` is the E0811 of S-745). The places are the ones of e0200_ser_tilde.onsa. One
// error per flow (P-01).

pub flow lp(x: F32 at sample) -> F32 at sample {
  x * 0.5 + prev~(x) * 0.5
}

pub rt fn pair_sum(xs: [F32; 2]) -> F32 {
  xs[0] + xs[1]
}

pub flow in_a_let(x: F32 at sample) -> [F32; 2] at sample {
  let ys = ser i in 0 ..< 2 { x * F32.round_from(i) }   //~ E0200
  ys
}

pub flow as_the_tail(x: F32 at sample) -> [F32; 2] at sample {
  ser i in 0 ..< 2 { x * F32.round_from(i) }        //~ E0200
}

pub flow as_an_argument(x: F32 at sample) -> F32 at sample {
  pair_sum(ser i in 0 ..< 2 { x * F32.round_from(i) })  //~ E0200
}

pub flow with_state_in_the_body(x: F32 at sample) -> [F32; 2] at sample {
  let ys = ser i in 0 ..< 2 { lp~(x * F32.round_from(i)) }  //~ E0200
  ys
}

pub flow with_a_closed_range(x: F32 at sample) -> [F32; 3] at sample {
  let ys = ser i in 0 ..= 2 { x * F32.round_from(i) }   //~ E0200
  ys
}

pub flow in_the_body_of_a_par(x: F32 at sample) -> [F32; 3] at sample {
  par~ i in 0 ..< 3 {
    pair_sum(ser j in 0 ..< 2 { lp~(x * F32.round_from(i + j)) })  //~ E0200
  }
}

pub flow around_a_par(x: F32 at sample) -> [F32; 3] at sample {
  ser i in 0 ..< 3 {                                //~ E0200
    pair_sum(par~ j in 0 ..< 2 { lp~(x * F32.round_from(i + j)) })
  }
}

pub flow in_a_block_body(x: F32 at sample) -> [F32; 2] at sample {
  let ys = ser i in 0 ..< 2 {                       //~ E0200
    lp~(x * F32.round_from(i))
  }
  ys
}

// ---- Not errors: the replication is `par~` ----

pub flow fine(x: F32 at sample) -> [F32; 2] at sample {
  par~ i in 0 ..< 2 { lp~(x * F32.round_from(i)) }
}
