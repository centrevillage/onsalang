// onsa.toml
// [test]
// spec = ["§4.5", "§11.3", "§18.1"]

// S-329 (W5-24 U6a): the list of the `::[` written in the type of an input of a flow (§4.5: "型の位置（注釈、引数と返り値の型、
// 型の中の型引数）に書いた `Buf::[F32]` は E0020"; §11.3: the input of a flow is a type with its clock). The E0020 is the one of
// the other places of a heading (negative/type_args_const_arg_marked_headings.onsa). Today the input reads the type
// differently and says E0002 "expected `,` or `)`, found `::`" at the `::`, so the case waits for the unit that makes the
// reading of the type one.

pub struct Rg[T, const N: U32] {
  d: [T; N],
}

impl[T, const N: U32] Rg[T, N] {
  pub const CAP: U32 = 4
}

pub flow as_an_input(x: Rg::[F32, 4] at sample) -> F32 at sample { //~ E0020
  0.0
}

pub flow as_a_second_input(y: F32 at sample, x: Rg::[F32, 4] at sample) -> F32 at sample { //~ E0020
  0.0
}

pub flow the_neighbour_is_read(x: F32 at sample) -> F32 at sample {
  0.0
}
