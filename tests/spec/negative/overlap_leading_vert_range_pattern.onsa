// onsa.toml
// [test]
// spec = ["§2.5", "§7", "§18.1"]

// E0002 for a choice of range patterns (or of float literals) whose `|` is at the start of a line (R-206
// family; docs/foreign-forms.toml rows `range_pattern`, `float_pattern_choice` and `leading_vert`). Two rows
// are in the pattern: the range as a pattern (§7) and the `|` that goes at the end of the line, not at the
// start of the next one (§2.5). A unit reports one error, the one that sorts first by the order of
// `diagnostics` (start, end, code, message; S-281): the range starts on the line before the `|`, so it is
// the error, and the marker is on the line of the range, not on the line of the `|`.
//
// The error is E0002 and not E0020, because of the marker comment. The candidate of the range is the guard
// of §7 (`k if (1 <= k && k < 3) || (5 <= k && k < 7)`), which joins the branches of the choice into one
// pattern; a choice that has a comment between its first branch and its last one has no such candidate (S-317:
// the candidate would take the branches away together with the comment, S-251), so the range is E0002
// with no candidate. The marker of each line is that comment. The same choice with no comment in it
// would be E0020 with the guard as its only candidate, and the candidate would leave no error (the `|` goes
// with the branch it joins); a case cannot show it, because a case marks the line of the error with a
// comment. The same choice written with its `|` at the end of the line, and the choices of ranges with a
// comment inside, are in tests/spec/fixes/e0020_patterns_range.onsa; the `|` alone is in
// tests/spec/fixes/e0020_leading_vert.onsa. One error per function (P-01).

pub fn two_ranges(x: I32) -> I32 {
  match x {
    1..<3                                           //~ E0002 @5
    | 5..<7 => 1,
    _ => 0,
  }
}

pub fn three_ranges(x: I32) -> I32 {
  match x {
    1..<3                                           //~ E0002 @5
    | 5..<7
    | 9..<11 => 1,
    _ => 0,
  }
}

pub fn closed_ranges(x: I32) -> I32 {
  match x {
    1..=3                                           //~ E0002 @5
    | 5..=7 => 1,
    _ => 0,
  }
}

pub fn a_range_and_a_range_from(x: I32) -> I32 {
  match x {
    ..<0                                            //~ E0002 @5
    | 10.. => 1,
    _ => 0,
  }
}

pub fn two_floats(x: F32) -> I32 {
  match x {
    0.5                                             //~ E0002 @5
    | 1.5 => 1,
    _ => 0,
  }
}

pub fn ranges_inside_some(o: Option[I32]) -> I32 {
  match o {
    Some(1..<3                                      //~ E0002 @10
      | 5..<7) => 1,
    _ => 0,
  }
}

pub fn ranges_with_a_guard(x: I32, flag: Bool) -> I32 {
  match x {
    1..<3                                           //~ E0002 @5
    | 5..<7 if flag => 1,
    _ => 0,
  }
}

// The right forms: the `|` at the end of the line, and the guard.
pub fn fine(x: I32) -> I32 {
  match x {
    k if 1 <= k && k < 3 => 1,
    0 |
    7 => 2,
    _ => 0,
  }
}
