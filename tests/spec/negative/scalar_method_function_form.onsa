// onsa.toml
// [test]
// spec = ["§3.3", "§3.4", "§6.2", "§15.1", "§18.1"]

// E0308 (W5-02 U4b): a method of the scalar types called in the function form (spec §15.1: the name of the type is
// found and the member is a method, so it is E0308 and not E0302 or E0413; §6.2: the functions of an `impl` are called
// with the dot only). `F32.to_bits(x)` is in fixes/e0308_method_function_form_builtin.onsa; these are the other
// methods of the closed list (the conversions are associated functions of the target type, §3.3; the names of
// the old conversion methods in this form are not found, in negative/scalar_method_function_form_missing.onsa).
// One error per function (P-01). The associated functions `F32.from_bits(b)` and the constants are fine in the
// last function.

pub fn floor_division(a: I32, b: I32) -> I32 {
  I32.div_euclid(a, b)                              //~ E0308
}

pub fn remainder(a: U32, b: U32) -> U32 {
  U32.rem_euclid(a, b)                              //~ E0308
}

pub fn checked(a: I64, b: I64) -> Option[I64] {
  I64.checked_add(a, b)                             //~ E0308
}

pub fn fine(b: U32) -> F32 {
  F32.from_bits(b) + F32.PI
}
