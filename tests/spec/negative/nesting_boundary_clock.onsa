// onsa.toml
// [test]
// spec = ["§2.5", "§11.3", "§18.1"]

// Boundary of the nesting depth, the clock `at` (§2.5), one level over the limit: `at` is one
// level, as `as` is. The units are those of nesting/boundary_clock.onsa with one more level
// (a parenthesis, a call, and in the `if~` unit a parenthesis around the `at`): 257 levels each,
// so each gets one E0006, and the marker is on the line of the token that makes level 257, the
// `at` (the deepest form, first in reading order, §2.5).

pub flow paren_257(x: F32 at block) -> F32 at sample {
  (((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((x at sample)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))   //~ E0006
}

