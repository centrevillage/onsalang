// onsa.toml
// [test]
// spec = ["§9.1", "§4.7", "§18.1"]

// E0401 (W5-02 U6/t): the result of `map_err` is `Result[T, F]` (§9.1: `-> Result[T, F]`), where `T` is the `Ok` type of
// the receiver, which stays, and `F` is the type that the function given returns. So the type is not the one of the
// receiver any more, and it is not any other: a place that expects the error type of the receiver (`Low` here) or another
// `Ok` type is a type mismatch, E0401, at the expression. (The `?` that does not match the error type of the function is
// E0414, in negative/try_type_map_err.onsa.) One error per function (P-01). The function at the end is fine.

pub enum Low {
  Bad,
  Worse(U32),
}

pub enum High {
  Wrapped(Low),
  Other,
}

pub fn read_low() -> Result[U32, Low] {
  Ok(1)
}

pub fn wrap(move e: Low) -> High {
  High.Wrapped(e)
}

pub fn code(move e: Low) -> U32 {
  match e {
    Low.Bad => 0,
    Low.Worse(n) => n,
  }
}

pub fn takes_low(r: Result[U32, Low]) -> U32 {
  match r {
    Ok(n) => n,
    Err(_) => 0,
  }
}

pub fn the_error_type_is_not_the_old_one() -> Result[U32, Low] {
  read_low().map_err(wrap)                                       //~ E0401
}

pub fn the_error_type_is_what_the_function_returns() -> Result[U32, High] {
  read_low().map_err(code)                                       //~ E0401
}

pub fn the_ok_type_stays() -> Result[U8, High] {
  read_low().map_err(wrap)                                       //~ E0401
}

pub fn in_a_binding_with_an_annotation() -> U32 {
  let r: Result[U32, Low] = read_low().map_err(wrap)             //~ E0401
  takes_low(r)
}

pub fn as_the_argument_of_a_function() -> U32 {
  takes_low(read_low().map_err(wrap))                            //~ E0401
}

pub fn fine() -> Result[U32, High] {
  read_low().map_err(wrap)
}
