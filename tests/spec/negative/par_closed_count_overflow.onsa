// onsa.toml
// [test]
// spec = ["§11.5", "§4.2", "§18.1"]
//
// [[test.fix]]
// at = "44:17"
// code = "E0813"
// candidate = 1
// leaves = ["45:11 E0808"]

// W7-14 U3/t, S-1147 (PROVISIONAL, the code is not decided): the count of a closed range that does not fit
// in `U32`. `par~ i in 0 ..= 4294967295` is `N = b - a + 1 = 2^32` replicas (§11.5), and the size of the
// result `[T; N]` is a `U32` (§4.2), so the form is an error. The spec does not say which code: E0808 (the
// value of an end that is out of range) or E0409 (the size of a type that does not fit in `U32`, W9-04 and
// E0200 until then). The expectations of this file are the provisional treatment of S-1147, E0808 at the
// `par~`, and are changed with that decision (this file is the only one that has them). The forms
// that are accepted, `4294967294 ..= 4294967295` (N = 2) and `4294967295 ..= 4294967295` (N = 1), are in
// flow_semantics/par_closed_edges.onsa. The bounds are literals, so the count is the only thing that is wrong.

use std.math.sum

pub flow pass(c: F32 at block) -> F32 at sample { c }

pub flow the_whole_range(x: F32 at sample) -> F32 at sample {
  let _ = par i in 0 ..= 4294967295 { x }                          //~ E0808
  x
}

pub flow in_a_call(x: F32 at sample) -> F32 at sample {
  sum(par i in 0 ..= 4294967295 { x })                             //~ E0808
}

pub flow in_a_par_body(x: F32 at sample) -> F32 at sample {
  let _ = par i in 0 ..< 2 { par j in 0 ..= 4294967295 { x } }    //~ E0808
  x
}

pub flow in_a_nested_closed_range(x: F32 at sample) -> F32 at sample {
  let _ = par i in 0 ..= 1 { par j in 0 ..= 4294967295 { x } }    //~ E0808
  x
}

pub flow block_then_the_whole_range(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(p)                                          //~ E0813
  let b = par i in 0 ..= 4294967295 { x }
  x
}

pub flow pass_then_the_whole_range(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = pass~(x)                                          //~ E0815
  let b = par i in 0 ..= 4294967295 { x }
  x
}

pub flow the_whole_range_then_block(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = par i in 0 ..= 4294967295 { x }                  //~ E0808
  let b = prev~(p)
  x
}

pub flow the_whole_range_then_type_error(x: F32 at sample) -> F32 at sample {
  let a = par i in 0 ..= 4294967295 { x }
  let b: Bool = 1.0                                         //~ E0401
  x
}
