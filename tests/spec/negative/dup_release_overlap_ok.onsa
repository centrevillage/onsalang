// onsa.toml
// [test]
// spec = ["§3.5", "§5.2", "§5.4", "§7", "§8.1", "§10", "§12.2"]

// W6-02 U4a/t, R-255, S-1030 (§5.2): the contrasts of negative/dup_release_overlap.onsa. The hand-off moves when no other argument or receiver of the same call is the place: the arguments that read
// the place come before the call (`addn(s.len(), eat_n(s))`: "前の引数で読む形は通る"; `s.len() + eat_n(s)` has no call that holds both), the other arguments are Copy values or another place
// (`addn(eat_n(s), 1)`, `p.plus(eat_n(s))` with the receiver `p` another variable, `addn(eat_n(s), eat_n(t))` with two `move` parameters), and a Copy field of the receiver is read in a nested call that is finished before the other argument
// (`addn(plus_f(p.value, 0), eat_p(p))`; the field passed as a place to the same call is an overlap, `plus_f(p.value, eat_p(p))` of the other file). Two hand-offs of `s` in
// nested calls of two arguments (`addn(eat_n(s), eat_n(s))`): the first is used after (E0704 if it were Affine), so it copies, and the copy is read only to make the value of the
// argument, which does not overlap the second (§5.2: "引数の中で同じ変数を読んで値を作るだけなら重ならない"; `addn(len_b(b), eat_b(move b))` has no E0702), so the second moves. The original is not dropped, so the function needs no `Alloc`. The helpers drop their argument, so their own E0901 is reported
// (the same as negative/drop_for_one_path.onsa); the callers have no marker. Every function is an error today (the original is dropped after the copy is handed over, R-255) and none is one after.
// The functions are one-liners (S-783).

pub struct Param {
  name: Str,
  value: F32,
}

impl Param {
  pub rt fn plus(self, n: U32) -> U32 { n }
}

pub rt fn eat_n(move s: Str) -> U32 { s.len() }   //~ E0901

pub rt fn eat_p(move p: Param) -> U32 { 0 }   //~ E0901

pub rt fn addn(n: U32, m: U32) -> U32 { n }

pub rt fn plus_f(v: F32, n: U32) -> U32 { n }

pub fn read_arg_before(move s: Str) -> U32 { addn(s.len(), eat_n(s)) }

pub rt fn rt_read_arg_before(move s: Str) -> U32 { addn(s.len(), eat_n(s)) }

pub fn read_in_a_sum(move s: Str) -> U32 { s.len() + eat_n(s) }

pub rt fn rt_read_in_a_sum(move s: Str) -> U32 { s.len() + eat_n(s) }

pub fn copy_arg_after(move s: Str) -> U32 { addn(eat_n(s), 1) }

pub rt fn rt_copy_arg_after(move s: Str) -> U32 { addn(eat_n(s), 1) }

pub fn two_places(move s: Str, t: Str) -> U32 { addn(eat_n(s), t.len()) }

pub rt fn rt_two_places(move s: Str, t: Str) -> U32 { addn(eat_n(s), t.len()) }

pub fn two_owned_places(move s: Str, move t: Str) -> U32 { addn(eat_n(s), eat_n(t)) }

pub rt fn rt_two_owned_places(move s: Str, move t: Str) -> U32 { addn(eat_n(s), eat_n(t)) }

pub fn other_receiver(move s: Str, p: Param) -> U32 { p.plus(eat_n(s)) }

pub rt fn rt_other_receiver(move s: Str, p: Param) -> U32 { p.plus(eat_n(s)) }

pub fn copy_field_in_a_call_before(move p: Param) -> U32 { addn(plus_f(p.value, 0), eat_p(p)) }

pub rt fn rt_copy_field_in_a_call_before(move p: Param) -> U32 { addn(plus_f(p.value, 0), eat_p(p)) }

pub fn hand_off_twice_in_one_call(move s: Str) -> U32 { addn(eat_n(s), eat_n(s)) }

pub rt fn rt_hand_off_twice_in_one_call(move s: Str) -> U32 { addn(eat_n(s), eat_n(s)) }
