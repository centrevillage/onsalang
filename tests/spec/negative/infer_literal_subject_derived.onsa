pub fn tuple_index_on_a_negated_integer(x: I32, c: Bool) -> I32 {
  let _ = (-17).0                                   //~ E0413
  0
}

pub fn tuple_index_on_a_branch_of_integers(x: I32, c: Bool) -> I32 {
  let _ = (if c { 1 } else { 2 }).0                 //~ E0413
  0
}

// ---------------------------------------------------------------- index: derived from an integer literals

pub fn index_on_an_integer_sum(x: I32, c: Bool) -> I32 {
  let n = 17
  let m = n + 1
  let _ = m[0]                                      //~ E0413
  0
}

pub fn index_on_a_sum_of_two_literals(x: I32, c: Bool) -> I32 {
  let m = 1 + 2
  let _ = m[0]                                      //~ E0413
  0
}

pub fn index_on_an_alias_of_an_integer(x: I32, c: Bool) -> I32 {
  let n = 17
  let k = n
  let _ = k[0]                                      //~ E0413
  0
}

pub fn index_on_a_negated_integer(x: I32, c: Bool) -> I32 {
  let _ = (-17)[0]                                  //~ E0413
  0
}

pub fn index_on_a_branch_of_integers(x: I32, c: Bool) -> I32 {
  let _ = (if c { 1 } else { 2 })[0]                //~ E0413
  0
}

// ---------------------------------------------------------------- try: derived from an integer literals

pub fn try_on_an_integer_sum(x: I32, c: Bool) -> Option[I32] {
  let n = 17
  let m = n + 1
  let _ = m?                                        //~ E0414
  Some(0)
}

pub fn try_on_a_sum_of_two_literals(x: I32, c: Bool) -> Option[I32] {
  let m = 1 + 2
  let _ = m?                                        //~ E0414
  Some(0)
}

pub fn try_on_an_alias_of_an_integer(x: I32, c: Bool) -> Option[I32] {
  let n = 17
  let k = n
  let _ = k?                                        //~ E0414
  Some(0)
}

pub fn try_on_a_negated_integer(x: I32, c: Bool) -> Option[I32] {
  let _ = (-17)?                                    //~ E0414
  Some(0)
}

pub fn try_on_a_branch_of_integers(x: I32, c: Bool) -> Option[I32] {
  let _ = (if c { 1 } else { 2 })?                  //~ E0414
  Some(0)
}

// ---------------------------------------------------------------- call: derived from a float literals

pub fn call_on_a_float_product(x: I32, c: Bool) -> I32 {
  let f = 1.5
  let m = f * 2.0
  let _ = m.(x)                                     //~ E0401
  0
}

pub fn call_on_an_alias_of_a_float(x: I32, c: Bool) -> I32 {
  let f = 1.5
  let k = f
  let _ = k.(x)                                     //~ E0401
  0
}

pub fn call_on_a_negated_float(x: I32, c: Bool) -> I32 {
  let _ = (-1.5).(x)                                //~ E0401
  0
}

pub fn call_on_a_branch_of_floats(x: I32, c: Bool) -> I32 {
  let _ = (if c { 1.5 } else { 2.5 }).(x)           //~ E0401
  0
}

// ---------------------------------------------------------------- field: derived from a float literals

pub fn field_on_a_float_product(x: I32, c: Bool) -> I32 {
