pub fn index_on_a_float_product(x: I32, c: Bool) -> I32 {
  let f = 1.5
  let m = f * 2.0
  let _ = m[0]                                      //~ E0413
  0
}

pub fn index_on_an_alias_of_a_float(x: I32, c: Bool) -> I32 {
  let f = 1.5
  let k = f
  let _ = k[0]                                      //~ E0413
