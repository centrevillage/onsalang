  A,
  B(                                                //~ E0002
fn z_variant() -> I32 { 1 }
fn w_variant() -> I32 { z_variant() }

struct PFieldRt {                                   //~ E0002
  v:
rt fn z_field_rt() -> I32 { 1 }
fn w_field_rt() -> I32 { z_field_rt() }

