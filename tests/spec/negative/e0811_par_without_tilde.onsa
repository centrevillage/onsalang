// onsa.toml
// [test]
// spec = ["§2.6", "§11.5", "§18.1"]
//
// [[test.fix]]
// at = "91:15"
// code = "E0811"
// candidate = 1
// leaves = ["92:15 E0811"]

// W4-20 U1/t, S-745: a `par` without the `~` in the body of a flow is E0811 (§11.5: "flow の本体の `~` の
// 無い `par i in …` は E0811"; §2.6). It is an error of the names stage (§18.1: "`par~` の `~` の有無（E0811、
// §11.5）" is judged by the name and the spelling), so the type errors of the same flow are not reached.
// The body does not matter: with state (`saw~(f0)`) or without (`x * i.round_f32()`) it is the same E0811
// and never the E0812 of a `~` that has nothing to hold (§2.6: a `par~` without state is no error, so the
// error of the `par` is not "the `~` is not needed"). The place of the `par` does not matter either: the
// right side of a `let`, the tail (the output), an argument, one of two in a flow. One error per flow
// (P-01): the second `par` of a flow is not reported. The candidate (insert the `~`) is in
// fixes/e0811_par_*, the nested forms in e0811_par_nested.onsa, the same spelling outside a flow (E0821)
// in e0821_par_plain_outside_flow.onsa.

use std.math.{floor}

const N: U32 = 4

pub flow saw(f0: F32 at block) -> F32 at sample {
  let phase = wrap01(prev~(^phase) + f0 / sample_rate())
  2.0 * phase - 1.0
}

pub rt fn wrap01(x: F32) -> F32 {
  x - floor(x)
}

pub rt fn total(xs: [F32; 4]) -> F32 {
  xs[0] + xs[1] + xs[2] + xs[3]
}

pub flow in_a_let(f0: F32 at block) -> [F32; 4] at sample {
  let saws = par i in 0 ..< 4 { saw~(f0) }          //~ E0811
  saws
}

pub flow as_the_tail(f0: F32 at block) -> [F32; 4] at sample {
  par i in 0 ..< 4 { saw~(f0) }                     //~ E0811
}

pub flow as_an_argument(f0: F32 at block) -> F32 at sample {
  total(par i in 0 ..< 4 { saw~(f0) })              //~ E0811
}

pub flow without_state_in_a_let(x: F32 at sample) -> [F32; 4] at sample {
  let ys = par i in 0 ..< 4 { x * i.round_f32() }   //~ E0811
  ys
}

pub flow without_state_as_the_tail(x: F32 at sample) -> [F32; 4] at sample {
  par i in 0 ..< 4 { x * i.round_f32() }            //~ E0811
}

pub flow without_state_as_an_argument(x: F32 at sample) -> F32 at sample {
  total(par i in 0 ..< 4 { x * i.round_f32() })     //~ E0811
}

pub flow with_a_delay_in_the_body(x: F32 at sample) -> [F32; 4] at sample {
  par i in 0 ..< 4 { prev~(x * i.round_f32()) }     //~ E0811
}

pub flow with_a_constant_count(f0: F32 at block) -> [F32; N] at sample {
  par i in 0 ..< N { saw~(f0 * (1.0 + i.round_f32())) }  //~ E0811
}

pub flow with_a_lower_bound(f0: F32 at block) -> [F32; 3] at sample {
  par i in 2 ..< 5 { saw~(f0 * i.round_f32()) }     //~ E0811
}

pub flow with_a_block_body(f0: F32 at block, detune: F32 at block) -> [F32; 4] at sample {
  let saws = par i in 0 ..< 4 {                     //~ E0811
    saw~(f0 * (1.0 + detune * i.round_f32()))
  }
  saws
}

pub flow after_a_par_with_the_tilde(f0: F32 at block) -> F32 at sample {
  let lows  = par~ i in 0 ..< 4 { saw~(f0 * (1.0 + i.round_f32())) }
  let highs = par i in 0 ..< 4 { saw~(f0 * (5.0 + i.round_f32())) }  //~ E0811
  total(lows) + total(highs)
}

pub flow two_without_the_tilde_in_one_flow(f0: F32 at block) -> F32 at sample {
  let lows  = par i in 0 ..< 4 { saw~(f0 * (1.0 + i.round_f32())) }  //~ E0811
  let highs = par i in 0 ..< 4 { saw~(f0 * (5.0 + i.round_f32())) }
  total(lows) + total(highs)
}

// ---- Not errors ----

pub flow fine(f0: F32 at block, x: F32 at sample) -> F32 at sample {
  let lows  = par~ i in 0 ..< 4 { saw~(f0 * (1.0 + i.round_f32())) }
  let highs = par~ i in 0 ..< 4 { x * i.round_f32() }
  total(lows) + total(highs)
}
