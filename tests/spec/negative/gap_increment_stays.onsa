// onsa.toml
// [test]
// spec = ["§2.5", "§5.1", "§18.1"]
// fixes = 0

// S-429 (W5-11 U10i/t, §2.5, §5.1): the forms of a `--` or a `++` that the decision of S-429 leaves the E0002 they are, with no
// candidate (`fixes = 0`): a `--` or a `++` in the place of an expression (`let y = x --`, `two(x --, 1)`: the form of the row
// `increment` is a statement, S-297), and a `--` or a `++` that begins a line with no operand after it (it does not go on
// with the line before it, and nothing follows it to be the operand). The marker is on the line of the `--` or the `++`.

pub fn two(a: I32, b: I32) -> I32 {
  a + b
}

pub fn in_a_let(x: I32) -> I32 {
  let y = x --   //~ E0002
  y
}

pub fn in_a_let_increment(x: I32) -> I32 {
  let y = x ++   //~ E0002
  y
}

pub fn in_a_call(x: I32) -> I32 {
  two(x --, 1)   //~ E0002
}

pub fn in_a_call_increment(x: I32) -> I32 {
  two(x ++, 1)   //~ E0002
}

pub fn on_a_line_of_its_own(inout x: I32) {
  x
  --   //~ E0002
}

pub fn on_a_line_of_its_own_increment(inout x: I32) {
  x
  ++   //~ E0002
}
