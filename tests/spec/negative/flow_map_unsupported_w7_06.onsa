// onsa.toml
// [test]
// spec = ["§11.5", "§18.1"]

// E0200 while `if~` / `match~` are not implemented (W3-10, K-02): they evaluate every branch (§11.5, S-110), and this
// version advances an instance only where its branch is taken (R-14), so it says E0200 rather than read the program in
// another meaning. (The stateful call in a branch of a plain `if` / `match`, in a guard and on the right of `&&` /
// `||` is the E0811 / E0806 of the flow check stage since W7-06 U1: flow_state_branches.onsa, rules_negative.onsa.) One
// error per flow (P-01).
//
// W7-06 removes this file: after U2 (`if~`) and U3a (`match~`) they check, and the errors of the others are in the
// cases of W7-06 (rules_negative.onsa, branches_tilde.onsa).

pub flow acc(x: F32 at sample) -> F32 at sample {
  let y = x + prev~(^y)
  y
}

pub flow tilde_if(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  if~ c { acc~(x) } else { x } //~ E0200
}

pub flow tilde_match(x: F32 at sample, k: U32 at sample) -> F32 at sample {
  let a = match~ k { 0 => acc~(x), _ => x } //~ E0200
  a
}

// The condition, the scrutinee and the left of `&&` are always evaluated, and may hold state.
pub flow fine(x: F32 at sample, k: U32 at sample) -> F32 at sample {
  let a = if acc~(x) > 2.0 { x } else { 0.0 }
  let b = if prev~(k) == 0 { a } else { x }
  let c = acc~(x) > 1.0 && x > 0.0
  if c { b } else { a }
}
