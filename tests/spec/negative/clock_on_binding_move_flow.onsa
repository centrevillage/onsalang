// onsa.toml
// [test]
// spec = ["§11.3", "§5.2", "§18.1"]
// fixes = 0

// E0002, with no candidate, for the clock written on the binding side of a `let` or `var` in a flow body whose value
// is a `move` (spec §11.3, §5.2, §18.1; S-381, S-378): the candidate of E0020 moves the clock after the value, and a
// `move` cannot be written in parentheses (`(move a)` is E0002, §5.2), so there is no value to move it to and no
// candidate (`fixes = 0`). The note says the rule: the clock is written on the value, and a `move` takes none.
// The form is the same with or without an annotation, with a pattern and with `var` (E0806 of a later stage
// for the `var` of a flow body is not reported). The runner of the cases does not compare the note. One error in
// each declaration unit (P-01).

pub flow move_with_no_type(a: F32 at sample) -> F32 at sample {
  let y at sample = move a                          //~ E0002
  y
}

pub flow move_with_a_type(a: F32 at sample) -> F32 at sample {
  let y: F32 at sample = move a                     //~ E0002
  y
}

pub flow move_before_the_type(a: F32 at sample) -> F32 at sample {
  let y at sample: F32 = move a                     //~ E0002
  y
}

pub flow move_in_a_pattern(p: (F32, F32) at sample) -> F32 at sample {
  let (u, v) at sample = move p                     //~ E0002
  u
}

pub flow move_in_a_var(a: F32 at sample) -> F32 at sample {
  var y at sample = move a                          //~ E0002
  y
}
