// onsa.toml
// [test]
// spec = ["§2.5", "§7", "§18.1"]

// E0002 for a `--` or a `++` in front of a range pattern (R-206; docs/foreign-forms.toml rows `increment`
// and `range_pattern`). A pattern cannot start with `--` or `++`: the increment and decrement of C are not
// Onsa (S-250), and in a pattern there is no statement for the row `increment` to give its candidate
// `x = x - 1` (S-297: a decrement whose operand is not a name has no candidate, E0002). The range after
// it is the form of another row (a range as a pattern is E0020 with a guard as its candidate, §7).
//
// Both rows start in one unit, and a unit reports one error (§18.1): the one that sorts first by the order
// of `diagnostics` (start, end, code, message; S-281, tests/spec/negative/syntax_same_start.onsa). The
// `--` starts before the range, so it is the error, E0002 at the `--`, with no candidate. The marker has
// the column of the `--` or `++` so that a range (E0020) reported in its place would not match. The
// forms of the range itself are in tests/spec/fixes/e0020_patterns_range.onsa; the overlaps whose first
// error has a candidate are in tests/spec/fixes/e0020_overlap_range_pattern.onsa.
//
// The compiler used to stop with an internal error on the first function ("two rows match one failure").
// One error per function (P-01).

pub fn decrement_before_half_open(x: I32) -> I32 {
  match x { --..<3 => 1, _ => 0 }                   //~ E0002 @13
}

pub fn increment_before_half_open(x: I32) -> I32 {
  match x { ++..<3 => 1, _ => 0 }                   //~ E0002 @13
}

pub fn decrement_before_closed(x: I32) -> I32 {
  match x { --..=3 => 1, _ => 0 }                   //~ E0002 @13
}

pub fn decrement_before_two_dots(x: I32) -> I32 {
  match x { --..3 => 1, _ => 0 }                    //~ E0002 @13
}

pub fn decrement_before_three_dots(x: I32) -> I32 {
  match x { --...3 => 1, _ => 0 }                   //~ E0002 @13
}

pub fn decrement_before_a_range_from(x: I32) -> I32 {
  match x { --5.. => 1, _ => 0 }                    //~ E0002 @13
}

pub fn decrement_before_a_bounded_range(x: I32) -> I32 {
  match x { --1..<3 => 1, _ => 0 }                  //~ E0002 @13
}

pub fn increment_before_a_bounded_range(x: I32) -> I32 {
  match x { ++1..=3 => 1, _ => 0 }                  //~ E0002 @13
}

pub fn decrement_on_its_own_line(x: I32) -> I32 {
  match x {
    --..<3 => 1,                                    //~ E0002 @5
    _ => 0,
  }
}

pub fn decrement_inside_some(o: Option[I32]) -> I32 {
  match o {
    Some(--..<3) => 1,                              //~ E0002 @10
    _ => 0,
  }
}

pub fn decrement_in_a_tuple(t: (I32, I32)) -> I32 {
  match t {
    (--..<3, n) => n,                               //~ E0002 @6
    _ => 0,
  }
}

pub fn decrement_in_the_second_place(t: (I32, I32)) -> I32 {
  match t {
    (n, --..<3) => n,                               //~ E0002 @9
    _ => 0,
  }
}

pub fn decrement_after_a_choice_bar(x: I32) -> I32 {
  match x {
    0 | --..<3 => 1,                                //~ E0002 @9
    _ => 0,
  }
}

pub fn decrement_with_a_guard(x: I32, flag: Bool) -> I32 {
  match x {
    --..<3 if flag => 1,                            //~ E0002 @5
    _ => 0,
  }
}

pub fn decrement_in_a_statement_match(x: I32) -> I32 {
  var r = 0
  match x {
    --..<3 => { r = 1 },                            //~ E0002 @5
    _ => { r = 0 },
  }
  r
}

pub fn decrement_in_a_closure(n: I32) -> I32 {
  let f = fn(k: I32) -> I32 {
    match k {
      --..<3 => 1,                                  //~ E0002 @7
      _ => 0,
    }
  }
  f.(n)
}

// The decrement alone is the same error, with no range after it.
pub fn decrement_alone(x: I32) -> I32 {
  match x {
    -- => 1,                                        //~ E0002 @5
    _ => 0,
  }
}

// Right forms: a range written as a guard, and a negative literal (one `-`, §7).
pub fn fine(x: I32) -> I32 {
  match x {
    -1 => 1,
    k if k < 3 => 2,
    _ => 0,
  }
}
