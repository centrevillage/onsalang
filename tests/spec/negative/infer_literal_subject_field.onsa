}

pub fn tuple_index_on_an_indexed_float_element() -> I32 {
  let _ = [1.5, 2.5][0].0                           //~ E0413
  0
}

pub fn tuple_index_on_a_tuple_float_element() -> I32 {
  let _ = (1.5, 2.5).0.0                            //~ E0413
  0
}

fn id[T](x: T) -> T {
  x
}
