pub fn tuple_index_on_a_matched_integer() -> I32 {
  let _ = match Some(17) {
    Some(v) => {
      let _ = v.0                                   //~ E0413
      0
    },
    None => 0,
  }
  0
}

pub fn tuple_index_on_a_generic_result() -> I32 {
  let z = id(17)
  let _ = z.0                                       //~ E0413
  0
}

pub fn tuple_index_on_an_indexed_element() -> I32 {
  let _ = [1, 2][0].0                               //~ E0413
  0
}

pub fn tuple_index_on_a_tuple_element() -> I32 {
  let _ = (1, 2).0.0                                //~ E0413
  0
}

pub fn tuple_index_on_an_integer_decided_later() -> U8 {
  let n = 17
  let _ = n.0                                       //~ E0413
  n
}

// ---------------------------------------------------------------- tuple index: a float literal

pub fn tuple_index_on_a_float() -> I32 {
  let _ = (1.5).0                                   //~ E0413
  0
}

pub fn tuple_index_on_a_bound_float() -> I32 {
  let n = 1.5
  let _ = n.0                                       //~ E0413
  0
}

pub fn tuple_index_on_a_matched_float() -> I32 {
  let _ = match Some(1.5) {
    Some(v) => {
      let _ = v.0                                   //~ E0413
      0
