pub fn name_length() -> U32 {
  "lib".as_bytes().len() //~ E0200
}

pub const LENGTH: U32 = "lib".as_bytes().len() //~ E0200

pub fn name_bytes() -> Bytes {
  "lib".as_bytes() //~ E0200
}

pub fn bytes_of(s: Str) -> Bytes {
  s.as_bytes() //~ E0200
}

pub fn length_of(b: Bytes) -> U32 {
  b.len() //~ E0200
}

pub fn max_level() -> F32 {
  F32.MAX
}
