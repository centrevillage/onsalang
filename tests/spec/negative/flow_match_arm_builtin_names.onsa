// onsa.toml
// [test]
// spec = ["§2.2", "§5.1", "§11.4"]
// fixes = 0

// W7-03 U1c/t, S-542 (§2.2, §5.1, §11.4): `prev`, `delay`, `vdelay`, `sample_rate` and `sample_tick` are the built-in names of a flow and they are seen in the whole body
// of a flow, so a pattern of a `match` in the body that binds one of them is E0304, on the name in the pattern, with no candidate, as an input, a `let` and the
// index of a `par~` are (module/overlap_flow_builtin_locals.onsa). A name that only starts like one (`previous`) is free
// (flow/state_names_match_arm_names_free.onsa has them, and the same patterns in a `fn`, where the names are not built-in). Each flow is a unit with
// one error (§18.1) and is otherwise correct; the name of the E0304 is not counted as a binding, so the use of it in the arm has no other diagnostic.

pub struct Pair {
  l: F32,
  r: F32,
}

pub flow arm_prev(x: F32 at sample) -> F32 at sample {
  let o = Some(x)
  match o {
    Some(prev) => prev, //~ E0304
    None => 0.0,
  }
}

pub flow arm_delay(x: F32 at sample) -> F32 at sample {
  let o = Some(x)
  match o {
    Some(delay) => delay, //~ E0304
    None => 0.0,
  }
}

pub flow arm_vdelay(x: F32 at sample) -> F32 at sample {
  let o = Some(x)
  match o {
    Some(vdelay) => vdelay, //~ E0304
    None => 0.0,
  }
}

pub flow arm_sample_rate(x: F32 at sample) -> F32 at sample {
  let o = Some(x)
  match o {
    Some(sample_rate) => sample_rate, //~ E0304
    None => 0.0,
  }
}

pub flow arm_sample_tick(x: F32 at sample) -> F32 at sample {
  let o = Some(x)
  match o {
    Some(sample_tick) => sample_tick, //~ E0304
    None => 0.0,
  }
}

pub flow arm_bare_binding(x: F32 at sample) -> F32 at sample {
  let o = Some(x)
  match o {
    Some(v) => v,
    prev => 0.0, //~ E0304
  }
}

pub flow arm_tuple(x: F32 at sample) -> F32 at sample {
  let t = (x, x * 2.0)
  match t {
    (a, delay) => a + delay, //~ E0304
  }
}

pub flow arm_struct(x: F32 at sample) -> F32 at sample {
  let p = Pair { l: x, r: x * 2.0 }
  match p {
    Pair { l: vdelay, r: _ } => vdelay, //~ E0304
  }
}

pub flow arm_nested(x: F32 at sample) -> F32 at sample {
  let o = Some(Some(x))
  match o {
    Some(Some(prev)) => prev, //~ E0304
    Some(None) => 1.0,
    None => 0.0,
  }
}

pub flow arm_with_guard(x: F32 at sample) -> F32 at sample {
  let o = Some(x)
  match o {
    Some(prev) if prev > 0.0 => prev, //~ E0304
    Some(_) => 1.0,
    None => 0.0,
  }
}

pub flow arm_second_arm(x: F32 at sample) -> F32 at sample {
  let o = Some(x)
  match o {
    None => 0.0,
    Some(sample_tick) => sample_tick, //~ E0304
  }
}

pub flow arm_in_a_par_body(x: F32 at sample) -> [F32; 2] at sample {
  par~ i in 0 ..< 2 {
    match Some(x * F32.round_from(i)) {
      Some(delay) => delay, //~ E0304
      None => 0.0,
    }
  }
}

pub flow arm_in_an_if_branch(x: F32 at sample) -> F32 at sample {
  let o = Some(x)
  if x > 0.0 {
    match o {
      Some(prev) => prev, //~ E0304
      None => 0.0,
    }
  } else {
    0.0
  }
}

pub flow arm_in_an_arm(x: F32 at sample) -> F32 at sample {
  let o = Some(x)
  match o {
    Some(a) => match Some(a) {
      Some(vdelay) => vdelay, //~ E0304
      None => 0.0,
    },
    None => 0.0,
  }
}
