// onsa.toml
// [test]
// spec = ["§3.5", "§5.2", "§5.4", "§7", "§8.1", "§10", "§12.2"]

// W6-02 U4a/t, R-255, S-1030 (§5.2, §5.4, §7): the contrasts of negative/dup_release_derived.onsa. The hand-off of `o` moves when the derived binding of a borrowed `match o` is not used after
// the call: the binding is used before the hand-off, or not at all, or it is Copy (§7: "Copy の束縛は束縛した時点の値なので、そのまま使える"; the `F32` field and the `U32` element), or it is
// derived from another place (`match o2`, where `o2` is a borrowed parameter). The original is not dropped, so the function needs no `Alloc`. The helpers drop their argument, so their own E0601 is reported
// (the same as negative/drop_for_one_path.onsa); the callers have no marker. Every function is an error today (the original is dropped after the copy is handed over, R-255) and none is one after.
// The functions are one-liners (S-783).

pub struct Param {
  name: Str,
  value: F32,
}

pub rt fn eat_o(move o: Option[Str]) -> U32 { 0 }   //~ E0601

pub rt fn eat_r(move r: Result[Str, U32]) -> U32 { 0 }   //~ E0601

pub rt fn eat_p(move p: Param) -> U32 { 0 }   //~ E0601

pub rt fn eat_t(move t: (Str, U32)) -> U32 { 0 }   //~ E0601

// ------------------------------------------------------------------ the derived binding is used before the hand-off or not at all

pub fn payload_before(move o: Option[Str]) -> (U32, U32) { match o { Some(b) => (b.len(), eat_o(o)), None => (0, eat_o(o)) } }

pub rt fn rt_payload_before(move o: Option[Str]) -> (U32, U32) { match o { Some(b) => (b.len(), eat_o(o)), None => (0, eat_o(o)) } }

pub fn payload_unused(move o: Option[Str]) -> U32 { match o { Some(_) => eat_o(o), None => eat_o(o) } }

pub rt fn rt_payload_unused(move o: Option[Str]) -> U32 { match o { Some(_) => eat_o(o), None => eat_o(o) } }

pub fn result_before(move r: Result[Str, U32]) -> (U32, U32) { match r { Ok(a) => (a.len(), eat_r(r)), Err(e) => (e, eat_r(r)) } }

pub rt fn rt_result_before(move r: Result[Str, U32]) -> (U32, U32) { match r { Ok(a) => (a.len(), eat_r(r)), Err(e) => (e, eat_r(r)) } }

pub fn struct_field_before(move p: Param) -> (U32, U32) { match p { Param { name: n, value: _ } => (n.len(), eat_p(p)) } }

pub rt fn rt_struct_field_before(move p: Param) -> (U32, U32) { match p { Param { name: n, value: _ } => (n.len(), eat_p(p)) } }

// ------------------------------------------------------------------ a Copy binding keeps the value it was bound to

pub fn copy_field_after(move p: Param) -> (U32, F32) { match p { Param { name: _, value: v } => (eat_p(p), v) } }

pub rt fn rt_copy_field_after(move p: Param) -> (U32, F32) { match p { Param { name: _, value: v } => (eat_p(p), v) } }

pub fn copy_element_after(move t: (Str, U32)) -> (U32, U32) { match t { (_, k) => (eat_t(t), k) } }

pub rt fn rt_copy_element_after(move t: (Str, U32)) -> (U32, U32) { match t { (_, k) => (eat_t(t), k) } }

pub fn copy_error_after(move r: Result[Str, U32]) -> (U32, U32) { match r { Ok(_) => (eat_r(r), 0), Err(e) => (eat_r(r), e) } }

pub rt fn rt_copy_error_after(move r: Result[Str, U32]) -> (U32, U32) { match r { Ok(_) => (eat_r(r), 0), Err(e) => (eat_r(r), e) } }

// ------------------------------------------------------------------ the binding is derived from another place

pub fn other_heading(move o: Option[Str], o2: Option[Str]) -> (U32, U32) { match o2 { Some(b) => (eat_o(o), b.len()), None => (eat_o(o), 0) } }

pub rt fn rt_other_heading(move o: Option[Str], o2: Option[Str]) -> (U32, U32) { match o2 { Some(b) => (eat_o(o), b.len()), None => (eat_o(o), 0) } }
