// onsa.toml
// [test]
// spec = ["§3.1", "§3.3", "§18.1"]

// E0011: an `as` expression is not an operand of a binary operator without parentheses, and `as`
// does not chain (§3.1: "`as` と `at` は連鎖できず、二つ目の被演算子には括弧が要る"; §3.3: "`as` 式を
// 二項演算子のオペランドにするときは括弧が必要"). `as` binds tighter than the binary operators and
// looser than the prefix and postfix ones, so `-x as I64` is `(-x) as I64` and is accepted. One error
// per declaration unit, so each function has one marker; the functions at the end have none.

pub fn cast_then_sum(x: I32) -> I64 {
  x as I64 + 1                          //~ E0011
}

pub fn sum_then_cast(x: I32, acc: I64) -> I64 {
  acc + x as I64                        //~ E0011
}

pub fn cast_then_product(x: I32) -> F64 {
  x as F64 * 2.0                        //~ E0011
}

pub fn product_then_cast(a: I32, b: I32) -> I64 {
  a as I64 * b as I64                   //~ E0011
}

pub fn cast_under_a_product(a: I64, b: I32) -> I64 {
  a * b as I64                          //~ E0011
}

pub fn cast_then_compare(x: I32, y: I64) -> Bool {
  x as I64 == y                         //~ E0011
}

pub fn compare_then_cast(x: I32, y: I64) -> Bool {
  y != x as I64                         //~ E0011
}

pub fn cast_in_a_condition(x: I32) -> I32 {
  if x as I64 > 3 {                     //~ E0011
    1
  } else {
    0
  }
}

pub fn cast_then_and(x: I32, ok: Bool) -> Bool {
  x as I64 > 0 && ok                    //~ E0011
}

pub fn cast_with_a_shift(x: U32) -> U64 {
  x as U64 << 2                         //~ E0011
}

pub fn chain_of_two(x: I16) -> F64 {
  x as I32 as F64                       //~ E0011
}

pub fn chain_of_three(x: I8) -> F64 {
  x as I16 as I32 as F64                //~ E0011
}

pub fn chain_after_a_parenthesis(x: I16) -> F64 {
  (x as I32) as F64 as F64              //~ E0011
}

pub fn chain_after_a_prefix(x: I16) -> F64 {
  -x as I32 as F64                      //~ E0011
}

pub fn chain_in_a_let(x: I16) -> F64 {
  let y = x as I32 as F64               //~ E0011
  y
}

pub fn chain_in_an_argument(x: I16) -> F64 {
  id64(x as I32 as F64)                 //~ E0011
}

pub fn id64(a: F64) -> F64 {
  a
}

// ---- accepted ----------------------------------------------------------------------------------------

pub struct W {
  v: I64,
}

pub fn parenthesized_cast_in_a_sum(x: I32, acc: I64) -> I64 {
  acc + (x as I64)
}

pub fn parenthesized_cast_in_a_product(a: I32, b: I32) -> I64 {
  (a as I64) * (b as I64)
}

pub fn parenthesized_cast_in_a_comparison(x: I32, y: I64) -> Bool {
  (x as I64) == y
}

pub fn parenthesized_chain(x: I16) -> F64 {
  (x as I32) as F64
}

pub fn prefix_binds_tighter(x: I32) -> I64 {
  -x as I64
}

pub fn prefix_with_parentheses(x: I32) -> I64 {
  -(x as I64)
}

pub fn cast_alone(x: I32) -> I64 {
  let y = x as I64
  y
}

pub fn cast_in_places(x: I32, xs: [I64; 4], i: U8) -> I64 {
  let w = W { v: x as I64 }
  let t = (x as I64, 1)
  let a: [I64; 2] = [x as I64, w.v]
  id_i64(xs[i as U32] + t.0 + a[1])
}

pub fn id_i64(a: I64) -> I64 {
  a
}
