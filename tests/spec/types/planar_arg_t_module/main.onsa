// onsa.toml
// [test]
// spec = ["§4.5", "§5.3", "§4.7", "§15.1"]

// S-1070 (1) (W6-04, §4.5: "`T` が `Span` か平面の配列に決まっている引数（`x: T`、`xs: [T; N]`）は、`Span`・`Span` の配列の引数である"): the generic functions and the method of the
// module util.onsa, called from this module, take the planar literal in the same way as in the module of the call: the `T` the argument before, the written type
// arguments or the receiver decide is a `Span`, and the literal is planar; it is the E0710 of the ordinary literal when none of them decides it. The type arguments are
// read after the names of another module are resolved (the order of the arguments decides, not the module of the declaration). One error per function (P-01).

use util
use util.{W, c, g}

pub fn the_argument_before(a: Span[F32], b: Span[F32]) -> U32 {
  c(a, [a, b])
}

pub fn the_written_type_arguments(a: Span[F32], b: Span[F32]) -> U32 {
  g::[Span[F32], 2]([a, b])
}

pub fn the_receiver(w: W[Span[F32]], a: Span[F32], b: Span[F32]) -> U32 {
  w.m([a, b])
}

pub fn the_path_of_the_module(a: Span[F32], b: Span[F32]) -> U32 {
  util.c(a, [a, b])
}

pub fn the_literal_alone(a: Span[F32], b: Span[F32]) -> U32 {
  g([a, b]) //~ E0710
}

pub fn the_literal_alone_by_the_path(a: Span[F32], b: Span[F32]) -> U32 {
  util.g([a, b]) //~ E0710
}
