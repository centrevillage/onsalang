// onsa.toml
// [test]
// spec = ["§18.1", "§4.5"]

// S-1066 (W6-04 U16), §18.1, §4.5: the same ring as `type_ring_copy_param_ab` with a `P` that holds only a `Copy` field:
// `RA` and `RB` are `Copy`, so there is nothing to judge (the set is not an error).

pub struct Ph[T: Copy] { n: I32 }
pub struct RA { p: Ph[RB] }
pub struct RB { q: Ph[RA] }
