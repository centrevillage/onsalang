// onsa.toml
// [test]
// spec = ["§18.1", "§4.6"]

// S-1067 (W6-04 U16), §18.1, §4.6: a type with a part that was not read (here the field `e: Buf[Str]`, an E0416) judges
// what the parts that were read decide. A variant of an enum with a `Str` payload, and another with a payload that
// fails: the element of a `Buf` is an E0416.

pub enum E7 { A(Str), B(Buf[Str]) }   //~ E0416
pub struct U { u: Buf[E7] }   //~ E0416
