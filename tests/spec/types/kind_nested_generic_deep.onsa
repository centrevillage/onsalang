pub fn copy_h(h: H) -> (H, H) {
  (h, h)
}

pub fn copy_h_owned(move h: H) -> (H, H) {
  (h, h)
}

pub fn copy_ha(move h: HA) -> (HA, HA) {
  (h, h)
}

pub fn copy_hp(move h: HP) -> (HP, HP) {
  (h, h)
}

pub fn copy_he(move h: HE) -> (HE, HE) {
  (h, h)
}

pub fn copy_the_chain(move g: G18[F32]) -> (G18[F32], G18[F32]) {
  (g, g)
}

pub fn copy_the_chain_of_copy_parameter[T: Copy](move g: G18[T]) -> (G18[T], G18[T]) {
  (g, g)
}

pub fn copy_the_chain_of_dup_parameter[T](g: G18[T]) -> (G18[T], G18[T]) {
  (g, g)
}

pub fn copy_the_array_chain[T: Copy](move a: A18[T]) -> (A18[T], A18[T]) {
  (a, a)
}

pub fn copy_the_tuple_chain[T: Copy](move p: P10[T]) -> (P10[T], P10[T]) {
  (p, p)
}

pub fn copy_the_maybe_dup_chain[T: Copy](move e: E18[T]) -> (E18[T], E18[T]) {
  (e, e)
}

pub fn copy_the_maybe_dup_chain_of_f32(move e: E18[F32]) -> (E18[F32], E18[F32]) {
  (e, e)
}

pub fn copy_a_shared_leaf(g: G18[Str]) -> (G18[Str], G18[Str]) {
  (g, g)
}
