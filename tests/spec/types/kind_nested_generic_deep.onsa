// onsa.toml
// [test]
// spec = ["§4.5", "§4.6", "§5.2"]

// R-317 (W4-16 U3; §4.6: "全ての型は構造から次のどれかに分類される", "Copy: … Copy 要素の固定長配列・タプル・構造体・enum"): the kind
// of a generic type is decided from its declaration down to the parameter at its bottom and does not depend on
// how many generic types there are on the way. `G18[F32]` holds two `G17[Option[F32]]`, each of which holds two
// `G16[Option[Option[F32]]]`, and so on to a `G0` with a `v` of 18 `Option`s of `F32`: every leaf is a `F32`, so `H`
// is Copy and `(h, h)` is right (§5.2: a Copy value is copied where it is used twice). Before W4-16 U3 a kind that is
// not found was taken for one that is not Affine, so the chain was accepted whatever its depth; when R-30 takes a kind
// that is not found for Affine, `H` stays Copy only if the kind of the chain is found (the argument `Option[T]` is open
// in the shape of the declaration and was not a key of the answer, so the steps ran out). The same chains with the
// argument `[T; 1]` and `(T, T)`, and with the bound `T: Copy` of the function that names the type, follow.
// The Affine side of the same chains is negative/kind_nested_generic_deep_affine.onsa.

pub struct G0[T] {
  v: T,
}

pub struct G1[T] {
  x: G0[Option[T]],
  y: G0[Option[T]],
}

pub struct G2[T] {
  x: G1[Option[T]],
  y: G1[Option[T]],
}

pub struct G3[T] {
  x: G2[Option[T]],
  y: G2[Option[T]],
}

pub struct G4[T] {
  x: G3[Option[T]],
  y: G3[Option[T]],
}

pub struct G5[T] {
  x: G4[Option[T]],
  y: G4[Option[T]],
}

pub struct G6[T] {
  x: G5[Option[T]],
  y: G5[Option[T]],
}

pub struct G7[T] {
  x: G6[Option[T]],
  y: G6[Option[T]],
}

pub struct G8[T] {
  x: G7[Option[T]],
  y: G7[Option[T]],
}

pub struct G9[T] {
  x: G8[Option[T]],
  y: G8[Option[T]],
}

pub struct G10[T] {
  x: G9[Option[T]],
  y: G9[Option[T]],
}

pub struct G11[T] {
  x: G10[Option[T]],
  y: G10[Option[T]],
}

pub struct G12[T] {
  x: G11[Option[T]],
  y: G11[Option[T]],
}

pub struct G13[T] {
  x: G12[Option[T]],
  y: G12[Option[T]],
}

pub struct G14[T] {
  x: G13[Option[T]],
  y: G13[Option[T]],
}

pub struct G15[T] {
  x: G14[Option[T]],
  y: G14[Option[T]],
}

pub struct G16[T] {
  x: G15[Option[T]],
  y: G15[Option[T]],
}

pub struct G17[T] {
  x: G16[Option[T]],
  y: G16[Option[T]],
}

pub struct G18[T] {
  x: G17[Option[T]],
  y: G17[Option[T]],
}

pub struct H {
  g: G18[F32],
}

