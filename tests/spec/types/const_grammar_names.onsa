// onsa.toml
// [test]
// spec = ["§4.5", "§15.1", "§18.1", "§11.4", "§11.5"]

// The names in a constant expression are read by the names stage first, as the names of an ordinary expression are (§4.5: "中の名前は
// 普通の式と同じく名前の段が先に読む"; §18.1; S-968). In a form outside the grammar, a name that is not found is E0302 and a name that is no value
// is E0308, not the E0417 of the form. A name that the names stage has rejected for E0304 (`D`, defined twice) is used with no diagnostic where
// it is the whole expression (§18.1) and the form around it is E0417 (S-968). The forms that the walk of a flow body does not read into
// (a block with a statement, a function value) are only in the heading and the body of a function.
// The places are the heading of an item (a parameter, a result, a field, an alias, the type of a `const`, a const argument) and
// the repeat and the annotation of a body.
// The units whose result does not change are in const_grammar_names_unchanged.onsa. One error per unit (§18.1).

pub struct Ring[T, const N: U32] {
  data: [T; N],
  head: U32,
}

pub struct P {
  x: U32,
}

const K: U32 = 4
const XS: [U32; 2] = [1, 2]

fn g(a: U32) -> U32 {
  a
}

const D: U32 = 1
const D: U32 = 2   //~ E0304

pub fn duplicate_in_a_tuple_in_a_parameter(x: [F32; (D, 1)]) -> F32 {   //~ E0417
  1.0
}

pub fn duplicate_in_a_tuple_in_a_repeat() -> F32 {
  let a = [0.0; (D, 1)]   //~ E0417
  a[0]
}

pub fn duplicate_in_a_tuple_in_a_const_argument(r: Ring[F32, (D, 1)]) -> U32 {   //~ E0417
  r.head
}

pub fn duplicate_in_an_if_in_a_parameter(x: [F32; if true { D } else { 2 }]) -> F32 {   //~ E0417
  1.0
}

pub fn duplicate_in_an_if_in_a_repeat() -> F32 {
  let a = [0.0; if true { D } else { 2 }]   //~ E0417
  a[0]
}

pub fn duplicate_in_a_comparison_in_a_parameter(x: [F32; D < 2]) -> F32 {   //~ E0417
  1.0
}

pub fn duplicate_in_a_comparison_in_a_repeat() -> F32 {
  let a = [0.0; D < 2]   //~ E0417
  a[0]
}

pub struct DuplicateInAComparisonInAField {
  a: [F32; D < 2],   //~ E0417
}

pub fn duplicate_in_a_block_in_a_parameter(x: [F32; { D }]) -> F32 {   //~ E0417
  1.0
}

pub fn duplicate_in_a_block_in_a_repeat() -> F32 {
  let a = [0.0; { D }]   //~ E0417
  a[0]
}

const DUPLICATE_IN_A_BLOCK_IN_A_CONST_TYPE: [F32; { D }] = [0.0; 4]   //~ E0417

pub fn duplicate_in_a_match_in_a_parameter(x: [F32; match D { _ => 1 }]) -> F32 {   //~ E0417
  1.0
}

pub fn duplicate_in_a_match_in_a_repeat() -> F32 {
  let a = [0.0; match D { _ => 1 }]   //~ E0417
  a[0]
}

type DuplicateInAMatchInAnAlias = [F32; match D { _ => 1 }]   //~ E0417

pub fn statement_block_in_a_parameter(x: [F32; {   //~ E0417
  let q = 1
  q
}]) -> F32 {
  1.0
}

pub fn statement_block_in_a_repeat() -> F32 {
  let a = [0.0; {   //~ E0417
    let q = 1
    q
  }]
  a[0]
}

pub fn duplicate_name_in_a_statement_block() -> F32 {
  let a = [0.0; {   //~ E0417
    let q = 1
    q + D
  }]
  a[0]
}
