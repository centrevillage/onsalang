// onsa.toml
// [test]
// spec = ["§18.1", "§4.5"]

// S-1066 (W6-04 U16), §18.1, §4.5: what the decision does not change. The first error of `RA` is `x: Buf[Str]` (one
// diagnostic for the unit), and `RB.a` fails by what `RA` owns: two E0416 in either order.

pub struct RB { a: Buf[RA] }   //~ E0416
pub struct RA { x: Buf[Str], b: Buf[RB] }   //~ E0416
