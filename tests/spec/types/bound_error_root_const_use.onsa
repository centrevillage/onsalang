// onsa.toml
// [test]
// spec = ["§18.1", "§11.6"]

// S-1068 (W6-04 U16), §18.1: the type of an argument, of a result and of a `const` is not an error type when it fails
// (E0416), so the use of it is judged by that type: the `const` `K` has a type that fails (`Bool` is not `Num`) and `h`
// returns it as an `I32`: the E0401 stays.

pub struct N[T: Num] { v: T }
pub const K: N[Bool] = N { v: true }   //~ E0416
pub fn h() -> I32 { K }   //~ E0401
