// onsa.toml
// [test]
// spec = ["§18.1", "§4.5"]

// S-1066 (W6-04 U16), §18.1: `RA` and `RB` each fail on the field that names the other, and the declarations outside of
// the set see an error type in those fields, so their uses give no diagnostic of their own (the two E0416 of the set are
// all), in whatever order the set is written. The users go through an alias of a tuple that holds the type.

pub struct RB { a: Buf[RA] }   //~ E0416
pub struct RA { b: Buf[RB] }   //~ E0416
pub type RT = (RA, I32)
pub type RS = (RB, I32)
pub struct OC[T: Copy] { v: T }
pub struct RU { u: OC[RT] }
pub struct RV { u: OC[RS] }
