// onsa.toml
// [test]
// spec = ["§5.3", "§5.4"]

// S-217, R-37 (§5.3: "借用と `Span` (平面の要素と部分ビューを含む)だけは、§5.4 の規則で `let` と `for` と `match` の腕に束縛できる";
// §5.4: `let ch = input[0]`, `let half = xs.slice(0, n)`): a `Span` and an array of `Span`s are borrowed bindings of a `let`,
// with an annotation or without. The annotation names the type of the binding as it is, and its root is the place where a
// second-class type is right (the rule of §5.4 depends on the form of the initializer, not on the annotation). No diagnostic
// is expected anywhere in this file. Today every `let` below is an E0710 of the modes stage (the work W4-07 makes S-217
// pass, as `negative/modes.onsa` `span_stored` says), so these wait for W4-07 and not for U4a: the checks of the annotations
// of a body (U4a) must not reject the annotated forms when W4-07 lets them through. The `for` form is in
// types/wellformed_body_annotation_second_class_fine.onsa, the negative forms (below the root) in
// types/wellformed_body_annotation_second_class.onsa.

pub fn element_of_a_planar_argument(input: [Span[F32]; 2]) -> F32 {
  let ch = input[0]
  ch[0]
}

pub fn whole_planar_argument(input: [Span[F32]; 2]) -> U32 {
  let all = input
  all.len()
}

pub fn part_of_a_view(xs: Span[F32]) -> U32 {
  let part = xs.slice(0, 1)
  part.len()
}

pub fn view_of_an_argument(xs: Span[F32]) -> U32 {
  let same = xs
  same.len()
}

pub fn annotated_element_of_a_planar_argument(input: [Span[F32]; 2]) -> F32 {
  let ch: Span[F32] = input[0]
  ch[0]
}

pub fn annotated_whole_planar_argument(input: [Span[F32]; 2]) -> U32 {
  let all: [Span[F32]; 2] = input
  all.len()
}

pub fn annotated_part_of_a_view(xs: Span[F32]) -> U32 {
  let part: Span[F32] = xs.slice(0, 1)
  part.len()
}

pub fn annotated_view_of_an_argument(xs: Span[F32]) -> U32 {
  let same: Span[F32] = xs
  same.len()
}
