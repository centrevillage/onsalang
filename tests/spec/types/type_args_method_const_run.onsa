// onsa.toml
// [test]
// mode = "test"
// spec = ["§4.5", "§4.7"]

// S-239 (W5-10 U2b): the const parameter of a method is given in the list as a constant expression (§4.5: "並びの要素は型の位置の並びと同じに読み、
// const 引数は定数式（下記）である"; the constant expression is an integer literal, a name of a constant, or a const parameter by itself). A const
// parameter that only the result has (`fill`, `cn`) is decided by the list, and a method with a type parameter and a const parameter takes both in the
// order of the declaration. A const parameter of the method that calls, written by itself as the argument (`self.cn::[M]()`), is the same const parameter
// as the length `[F32; N]` is. The expressions with an operator are in type_args_method_const_arith.onsa. The values are worked out by hand.

pub const K: U32 = 8

pub struct V {
  n: U8,
}

impl V {
  pub fn cn[const N: U32](self) -> U32 {
    N
  }

  pub fn fill[const N: U32](self) -> [F32; N] {
    [0.0; N]
  }

  pub fn tag[T, const N: U32](self, x: T) -> (T, U32) {
    (x, N)
  }

  pub fn outer[const M: U32](self) -> U32 {
    self.cn::[M]()
  }
}

test "an integer literal" {
  let v = V { n: 1 }
  assert v.cn::[4]() == 4
  assert v.cn::[0]() == 0
}

test "the name of a constant" {
  let v = V { n: 1 }
  assert v.cn::[K]() == 8
}

test "the array of the length" {
  let v = V { n: 1 }
  let a = v.fill::[4]()
  assert a.len() == 4
  assert a[3] == 0.0
}

test "the array of the length with the annotation of the same length" {
  let v = V { n: 1 }
  let a: [F32; 4] = v.fill::[4]()
  assert a.len() == 4
}

test "a type parameter and a const parameter" {
  let v = V { n: 1 }
  let t = v.tag::[U8, 3](200)
  assert t.1 == 3
  let a = t.0
  assert a.checked_add(100) == None
}

test "the const parameter of the method that calls" {
  let v = V { n: 1 }
  assert v.outer::[5]() == 5
  assert v.outer::[K]() == 8
}
