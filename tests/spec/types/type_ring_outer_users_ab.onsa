// onsa.toml
// [test]
// spec = ["§18.1", "§4.5"]

// S-1066 (W6-04 U16), §18.1: `RA` and `RB` each fail on the field that names the other, and the declarations outside of
// the set see an error type in those fields, so their uses give no diagnostic of their own (the two E0416 of the set are
// all), in whatever order the set is written. The users are signatures that ask `Copy` and `Dup`, a tuple, an `rt`
// function that drops and a function that moves twice.

pub struct RA { b: Buf[RB] }   //~ E0416
pub struct RB { a: Buf[RA] }   //~ E0416
pub struct OC[T: Copy] { v: T }
pub struct W[T] { v: T }
pub fn fa(x: OC[RA]) -> I32 { 0 }
pub fn fb(x: OC[RB]) -> I32 { 0 }
pub fn fc(x: W[RA]) -> I32 { 0 }
pub fn fd(x: W[RB]) -> I32 { 0 }
pub fn fe() -> Option[OC[(RA, I32)]] { None }
pub fn ff() -> Option[OC[(RB, I32)]] { None }
pub rt fn ga(move x: RA) -> I32 { 0 }
pub rt fn gb(move x: RB) -> I32 { 0 }
pub fn ha(move x: RA) -> (RA, RA) { (move x, move x) }
pub fn hb(move x: RB) -> (RB, RB) { (move x, move x) }
