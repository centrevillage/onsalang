// onsa.toml
// [test]
// mode = "parse"
// spec = ["§4.4", "§18.2"]

// The `...` at the end of a struct literal (spec §4.4, S-697): it follows the fields that are written, and
// the `,` before it separates it from the last field; there is no `,` after it. The literal may have no
// field but the `...`, and the fields may be in any order. The file is canonical. The file is read by the
// syntax stage only (`mode = "parse"`): which fields the `...` fills is not asked here.

pub struct Item {
  x: U32,
  y: F32 = 0.0,
  z: F32 = 1.0,
}

pub fn some_fields() -> Item {
  Item { x: 1, ... }
}

pub fn two_fields() -> Item {
  Item { x: 1, y: 2.0, ... }
}

pub fn only_the_rest() -> Item {
  Item { ... }
}

pub fn fields_out_of_order() -> Item {
  Item { z: 3.0, x: 1, ... }
}

pub fn in_a_let() -> U32 {
  let v = Item { x: 7, ... }
  v.x
}

pub fn in_a_let_alone() -> F32 {
  let v = Item { ... }
  v.y
}
