// S-290 (W5-23 U2): the same as `instance_field_fn.onsa` in the content of a variant of an enum:
// the position is the line of the variant that holds the function type.

pub enum R[T] {
  N,
  C(T, fn(R[(T, T)]) -> I32),  //~ E0422
}

pub fn f(x: R[I32]) -> U32 {
  0
}

@export
pub fn anchor() -> U32 {
  1
}
