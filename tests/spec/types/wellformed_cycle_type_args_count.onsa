// onsa.toml
// [test]
// spec = ["§4.5", "§4.4", "§18.1"]

// R-323 (W4-05 U4a, §4.5: the number of the type arguments of a type is that of its declaration, E0412; §18.1: a
// type of a cycle of declarations is an error type for the units that use it, and a cycle is one error, E0311,
// at the first declaration of the set). A struct or an enum that is in a cycle of values (`C` and `D` hold each
// other) has no type parameter, and a type argument written after its name is an error of the number (E0412) in
// the unit that writes it, apart from the E0311 of the cycle: the cycle can be mended and the error of the number
// stays (the error type of the cycle does not hide it). The names `C`, `D` and `Chain` without arguments are the
// error type where they are used and there is no diagnostic (the last function). A type that is no part of a cycle
// gives the same E0412 (types/type_args_count.onsa). One error per item (P-01).

pub struct C {   //~ E0311
  d: D,
}

pub struct D {
  c: C,
}

pub enum Chain {   //~ E0311
  Next(Chain2),
  End,
}

pub enum Chain2 {
  Back(Chain),
}

pub fn argument_of_a_struct(x: C[I32]) -> I32 {   //~ E0412
  1
}

pub fn argument_of_the_other_struct(x: D[I32, F32]) -> I32 {   //~ E0412
  1
}

pub fn argument_of_an_enum(x: Chain[I32]) -> I32 {   //~ E0412
  1
}

pub fn return_type(x: I32) -> D[I32] {   //~ E0412
  1
}

pub struct FieldOfCycleWithArguments {
  c: C[I32],   //~ E0412
}

pub enum VariantOfCycleWithArguments {
  One(Chain2[I32]),   //~ E0412
}

impl C[I32] {   //~ E0412
  pub fn g(self) -> I32 {
    1
  }
}

impl Chain[I32] {   //~ E0412
  pub fn g(self) -> I32 {
    1
  }
}

pub fn without_arguments_no_diagnostic(c: C, d: D, e: Chain) -> I32 {
  1
}
