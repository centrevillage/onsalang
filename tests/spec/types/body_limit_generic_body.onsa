// onsa.toml
// [test]
// spec = ["§4.4", "§4.7", "§18.1", "§4.5"]
// fixes = 0

// S-264 (W5-16 U2), §4.4 ("型パラメータ" is a name that counts one): the body of a generic function is checked once, with
// the type parameter as it is (not with a type argument), so the types of its body have the limit in `onsa check`.
// `x` is `T` (1), so `(t10, t10, x)` is 4096 and is right (`g_boundary`), and `t12` of `g_over` is 8191: E0422 at the
// tuple. One error in a function (P-01). The depth of a chain of `Some(x)` is the same as for a closed type:
// `g_depth` passes 256 at `a257`.

pub fn g_boundary[T: Copy](x: T) -> U32 {
  let t0 = x
  let t1 = (t0, t0)
  let t2 = (t1, t1)
  let t3 = (t2, t2)
  let t4 = (t3, t3)
  let t5 = (t4, t4)
  let t6 = (t5, t5)
  let t7 = (t6, t6)
  let t8 = (t7, t7)
  let t9 = (t8, t8)
  let t10 = (t9, t9)
  let e = (t10, t10, x)
  let _ = e
  0
}

pub fn g_over[T: Copy](x: T) -> U32 {
  let t0 = x
  let t1 = (t0, t0)
  let t2 = (t1, t1)
  let t3 = (t2, t2)
  let t4 = (t3, t3)
  let t5 = (t4, t4)
  let t6 = (t5, t5)
  let t7 = (t6, t6)
  let t8 = (t7, t7)
  let t9 = (t8, t8)
  let t10 = (t9, t9)
  let t11 = (t10, t10)
  let t12 = (t11, t11)  //~ E0422
  let t13 = (t12, t12)
  let _ = t13
  0
}

