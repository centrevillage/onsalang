// onsa.toml
// [test]
// spec = ["§4.5", "§4.7", "§18.1"]

// S-239 (W5-10 U2a): a literal that is an argument of a call whose type argument is written has the type of the parameter from the start, so
// a literal out of the range of that type is E0408 (§4.7: "型が決まった時点で範囲外のリテラル … は E0408"; "被演算子が、括弧を除くと整数リテラルそのもので
// ある前置の `-` は、値に含めて検査する（`I8` に `-128` は書け、`-129` は E0408）"). `id::[U8](300)` is the same error as `let x: U8 = 300`, which the
// annotation without the list gives (types.onsa). The first and the second argument, a signed type and the edge that is right. One error per item (P-01).

pub fn id[T](x: T) -> T {
  x
}

pub fn first[A, B](a: A, b: B) -> A {
  a
}

pub fn too_big() -> U8 {
  id::[U8](300)                                     //~ E0408
}

pub fn just_over() -> U8 {
  id::[U8](256)                                     //~ E0408
}

pub fn too_small() -> I8 {
  id::[I8](-129)                                    //~ E0408
}

pub fn the_second_argument() -> U8 {
  first::[U8, U8](1, 256)                           //~ E0408
}

pub fn the_edges_are_right() -> I8 {
  let b = id::[I8](-128)
  let c = id::[I8](127)
  b + c
}

pub fn the_unsigned_edge_is_right() -> U8 {
  id::[U8](255)
}
