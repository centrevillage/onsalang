// onsa.toml
// [test]
// spec = ["§8.1", "§4.5", "§18.1"]

// R-27 (3), W6-01 U1 (spec §8.1: "その宣言を使う所では、変数を含む効果行に頼る判定（E0401、E0406）をしない"; §4.5: "式の中の型引数の数に、効果行変数は数えない"): a function that declares an effect row
// variable is E0200 at its declaration (the first unit of each group below), and the places that call it report no E0401 and no E0406, because the effect row of its type has a variable
// and the version does not rely on such a row. A pure function and a function with `Alloc` are given to a parameter `fn(I32) -> I32 uses {e}` (a function that has `Alloc` is given from
// a function that has `Alloc` too, as the case of the call asks), with a list of type arguments or without it; a function value that is put in a `let` and called afterwards; a method;
// a variable that no argument decides (E0406 before). What stays is what does not rely on the row: the number of the type arguments of the call (S-982: the variable is not counted, so
// two type arguments for `[T, e]` are E0412), and the types of the parameters and the number of them (a function of another parameter type or arity is still E0401). One error in each unit (P-01).

pub fn inc(x: I32) -> I32 {
  x + 1
}

pub fn bump(x: I32) -> I32 uses {Alloc} {
  x + 1
}

pub fn wrong_type(x: U32) -> U32 {
  x
}

pub fn wrong_arity() -> I32 {
  0
}

pub fn apply[e](f: fn(I32) -> I32 uses {e}, x: I32) -> I32 uses {e} { //~ E0200 @14
  f.(x)
}

pub fn apply_t[T, e](f: fn(T) -> T uses {e}, x: T) -> T uses {e} { //~ E0200 @19
  f.(x)
}

pub fn undecided[e](x: I32) -> I32 uses {e} { //~ E0200 @18
  x
}

pub struct V {
  n: I32,
}

impl V {
  pub fn ap[e](self, f: fn(I32) -> I32 uses {e}, x: I32) -> I32 uses {e} { //~ E0200 @13
    f.(x)
  }

  pub fn ap_t[T, e](self, f: fn(T) -> T uses {e}, x: T) -> T uses {e} { //~ E0200 @18
    f.(x)
  }
}

pub fn pure_function_without_a_list() -> I32 {
  apply(inc, 1)
}

pub fn function_with_alloc_without_a_list() -> I32 uses {Alloc} {
  apply(bump, 1)
}

pub fn pure_function_with_a_list() -> I32 {
  apply_t::[I32](inc, 1)
}

pub fn function_with_alloc_with_a_list() -> I32 uses {Alloc} {
  apply_t::[I32](bump, 1)
}

pub fn pure_function_to_a_generic_without_a_list() -> I32 {
  apply_t(inc, 1)
}

pub fn variable_that_no_argument_decides() -> I32 {
  undecided(1)
}

pub fn function_put_in_a_let() -> I32 {
  let _ = apply
  0
}

pub fn function_put_in_a_let_and_called() -> I32 {
  let h = apply
  h.(inc, 1)
}

pub fn function_put_in_a_let_and_called_with_alloc() -> I32 uses {Alloc} {
  let h = apply
  h.(bump, 1)
}

pub fn method_call_pure(v: V) -> I32 {
  v.ap(inc, 1)
}

pub fn method_call_with_alloc(v: V) -> I32 uses {Alloc} {
  v.ap(bump, 1)
}

pub fn method_call_with_a_list(v: V) -> I32 {
  v.ap_t::[I32](inc, 1)
}

pub fn method_call_with_a_list_and_alloc(v: V) -> I32 uses {Alloc} {
  v.ap_t::[I32](bump, 1)
}

pub fn call_in_a_branch(c: Bool) -> I32 {
  if c { apply(inc, 1) } else { apply_t::[I32](inc, 2) }
}

pub fn the_number_of_type_arguments_is_still_checked() -> I32 {
  apply_t::[I32, I32](inc, 1) //~ E0412
}

pub fn the_number_of_type_arguments_of_a_method_is_still_checked(v: V) -> I32 {
  v.ap_t::[I32, I32](inc, 1) //~ E0412
}

pub fn a_list_for_a_function_with_no_type_parameter() -> I32 {
  apply::[I32](inc, 1) //~ E0412
}

pub fn the_type_of_the_parameter_is_still_checked() -> I32 {
  apply(wrong_type, 1) //~ E0401
}

pub fn the_arity_of_the_parameter_is_still_checked() -> I32 {
  apply(wrong_arity, 1) //~ E0401
}

pub fn the_type_of_the_other_argument_is_still_checked() -> I32 {
  apply(inc, true) //~ E0401
}

pub fn the_type_of_the_parameter_of_a_method_is_still_checked(v: V) -> I32 {
  v.ap(wrong_type, 1) //~ E0401
}
