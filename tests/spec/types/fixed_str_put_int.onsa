// onsa.toml
// [test]
// mode = "test"
// spec = ["§4.2", "§6.4", "§3.3"]

// S-614 (W5-12 U3b, spec §4.2, §6.4): `put_int[T: Int](inout self, v: T)` writes the decimal of `v` (decision of 2026-11-11: widened to a 64-bit integer inside). §4.2: "書き足し（… 整数の 10 進 …）は、入る分だけ
// 書き". The decimal is the digits of the value without leading zeros (and `0` is one digit), with `-` first for a negative value. The types that satisfy `Int` (§6.4: `I8 I16 I32 I64 U8 U16 U32 U64`, §4.1)
// are all run, each with 0, 1, -1 (for the signed ones), MIN, MAX, the value next to each of them, and the edges of the number of the digits (10^k - 1 and 10^k, and the negative ones). The text of an
// integer is the same for all types, so the expected text is the decimal of the number (the lines of a type are in the order of the values). `I64.MIN` and `U64.MAX` are 20 bytes, the longest texts. The result
// is read from a `FixedStr[24]` that holds the text. A narrow type is not read as another type (`U8.MAX` is `255`, not `-1`; `I8.MIN` is `-128`). The cuts at the capacity are in fixed_str_put_truncate.onsa.

use std.text.FixedStr

fn int_str[T: Int](v: T) -> FixedStr[24] {
  var t: FixedStr[24] = ""
  t.put_int!(v)
  t
}

test "I8: 0, 1, the edges of the digits, MIN and MAX" {
  assert int_str(I8.MIN) == "-128"
  assert int_str::[I8](-127) == "-127"
  assert int_str::[I8](-100) == "-100"
  assert int_str::[I8](-99) == "-99"
  assert int_str::[I8](-10) == "-10"
  assert int_str::[I8](-9) == "-9"
  assert int_str::[I8](-1) == "-1"
  assert int_str::[I8](0) == "0"
  assert int_str::[I8](1) == "1"
  assert int_str::[I8](9) == "9"
  assert int_str::[I8](10) == "10"
  assert int_str::[I8](99) == "99"
  assert int_str::[I8](100) == "100"
  assert int_str::[I8](126) == "126"
  assert int_str(I8.MAX) == "127"
}

test "I16: 0, 1, the edges of the digits, MIN and MAX" {
  assert int_str(I16.MIN) == "-32768"
  assert int_str::[I16](-32767) == "-32767"
  assert int_str::[I16](-10000) == "-10000"
  assert int_str::[I16](-9999) == "-9999"
  assert int_str::[I16](-1000) == "-1000"
  assert int_str::[I16](-999) == "-999"
  assert int_str::[I16](-100) == "-100"
  assert int_str::[I16](-99) == "-99"
  assert int_str::[I16](-10) == "-10"
  assert int_str::[I16](-9) == "-9"
  assert int_str::[I16](-1) == "-1"
  assert int_str::[I16](0) == "0"
  assert int_str::[I16](1) == "1"
  assert int_str::[I16](9) == "9"
  assert int_str::[I16](10) == "10"
  assert int_str::[I16](99) == "99"
  assert int_str::[I16](100) == "100"
  assert int_str::[I16](999) == "999"
  assert int_str::[I16](1000) == "1000"
  assert int_str::[I16](9999) == "9999"
  assert int_str::[I16](10000) == "10000"
  assert int_str::[I16](32766) == "32766"
  assert int_str(I16.MAX) == "32767"
}

