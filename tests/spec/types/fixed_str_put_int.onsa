test "the length of the text is the number of the bytes" {
  let a = int_str(I64.MIN)
  assert a.len() == 20
  let b = int_str(U64.MAX)
  assert b.len() == 20
  assert int_str::[I32](0).len() == 1
  assert int_str::[I32](-1).len() == 2
  assert int_str::[U8](255).len() == 3
}

test "the digits are put after the text and one after another" {
  var t: FixedStr[24] = "n="
  let s: U8 = 7
  t.put_int!(-42)
  assert t == "n=-42"
  t.put_int!(s)
  assert t == "n=-427"
  t.put_int!(I8.MIN)
  assert t == "n=-427-128"
  assert t.len() == 10
}

test "the value is a number of any type, held by a binding" {
  let a: U16 = 65535
  let b: I16 = -32768
  var t: FixedStr[16] = ""
  t.put_int!(a)
  t.put_str!(",")
  t.put_int!(b)
  assert t == "65535,-32768"
  var u: FixedStr[16] = ""
  let c: U32 = 300
  let z: I8 = 0
  u.put_int!(c)
  u.put_int!(z)
  assert u == "3000"
}

test "the text of an integer is the text of the same number of another type" {
  assert int_str::[I8](99) == int_str::[U64](99)
  assert int_str::[I64](-1) != int_str::[U64](1)
  assert int_str(U32.MAX) == "4294967295"
  assert int_str(I32.MAX) == "2147483647"
  assert int_str(I32.MIN) == "-2147483648"
}

test "a value that is computed" {
  var n: U32 = 1
  var t: FixedStr[24] = ""
  for _ in 0 ..< 5 {
    t.put_int!(n)
    t.put_str!(" ")
    n = n * 10
  }
  assert t == "1 10 100 1000 10000 "
  assert t.len() == 20
}
