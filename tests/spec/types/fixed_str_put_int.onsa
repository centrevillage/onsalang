test "U8: 0, 1, the edges of the digits, MIN and MAX" {
  assert int_str(U8.MIN) == "0"
  assert int_str::[U8](1) == "1"
  assert int_str::[U8](9) == "9"
  assert int_str::[U8](10) == "10"
  assert int_str::[U8](99) == "99"
  assert int_str::[U8](100) == "100"
  assert int_str::[U8](254) == "254"
  assert int_str(U8.MAX) == "255"
}

