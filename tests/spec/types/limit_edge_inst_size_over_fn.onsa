// onsa.toml
// [package]
// name = "limit_edge_inst_size_over_fn"
// edition = "2026"
//
// [export]
// prefix = "lesof_"
//
// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [test]
// spec = ["§4.4", "§4.5", "§18.1"]
// fixes = 0

// W8-14 A3/t, §4.4, §4.5: one past `limit_edge_inst_size_fine.onsa`: with `X` of size 4091 the type that the
// instantiation makes with the type argument `fn(X) -> U8` is 4097. E0422 at the content of the variant `C` of `U`
// (§4.4: "型の宣言の中で超えたら、そのフィールドの型"), one error: the lowering stops at the first (§18.1). The check has no diagnostic (the
// written argument is small). `X` is a tuple of the chain aliases of size 4091. The field of a generic struct holds a
// form around the type argument, and the instantiation makes the type of the field, which is a type of the lowering
// (§4.5), with the limit 4096 (§4.4); a declared struct or enum is a leaf, so the argument `W[Buf[X]]` written in the
// signature is small (4095: the name, the shape, `Buf`'s name and shape, and `X`). The cost of each field:
// `Option[Option[T]]` is `T + 4` and `Buf[X]` is `X + 2`, so the field of `W[Buf[X]]` is `X + 6`; `[[T; 2]; 2]` is `T +
// 4` and `[X; 3]` is `X + 2` (`X + 6`); `((T, U8), U8)` is `T + 4` and `fn(X) -> U8` is `X + 2` (`X + 6`).

type A0 = I32
type A1 = (A0, A0)
type A2 = (A1, A1)
type A3 = (A2, A2)
type A4 = (A3, A3)
type A5 = (A4, A4)
type A6 = (A5, A5)
type A7 = (A6, A6)
type A8 = (A7, A7)
type A9 = (A8, A8)
type A10 = (A9, A9)
type X = (A10, A9, A8, A7, A6, A6)
pub enum U[T: ?Dup] {
  N,
  C(((T, U8), U8)),  //~ E0422
}

pub fn e(u: U[fn(X) -> U8]) -> U32 {
  0
}

@export
pub fn anchor() -> U32 {
  1
}
