// onsa.toml
// [test]
// spec = ["§4.5", "§15.1", "§18.1"]

// S-713 (a), S-719, S-721, S-103 (W4-04 U8b): the length of an array is a constant expression (§4.5),
// and the name in it is read by the kind the place needs (§15.1):
//  - a name that is a value and is not a constant (a function, a variant of an enum, the function of an
//    `extern` block, and in the body a local binding and a parameter) is E0417 (§4.5: "値だが定数でない
//    名前（関数、列挙子）もローカル変数と同じく E0417"), and so is a call `g()` ("関数の呼び出しは書けない");
//  - a name that is not a value (a type, an alias, a trait, an effect, a handler, a type of an `extern`
//    block, a flow) is E0308 (§4.5: "値でない名前（型、モジュール、flow、trait、効果など）は E0308"). The
//    name is found, so it is not the E0302 of an unknown name. The module is in
//    packages/kind_signature_places_modules.
// The kinds are the same wherever the length is written: a parameter, a result, the right side of a type
// alias, the field of a struct, the type of a `const`, a type inside another type (a tuple, an `Option`, an
// array of arrays, the type of a function value), the annotation of a `let` in a body, and the repeat
// `[x; N]` of a body. The names of the declarations that are E0200 in this version (an `effect`, a
// `handler`, a `trait`, an `extern` block) are read by the kind of their keyword (S-719, S-721), so
// `[F32; Ef]` is E0308 and `[F32; c_sin]` is E0417 ("`[F32; c_sin]` は E0417（S-713）", S-721).
// The local binding in an annotation of a body (`let n = 4` and `let a: [F32; n]`, E0417, S-729, R-304)
// is in kind_body_local_lengths.onsa.
// One error per unit (§18.1), so each form is in its own unit; the fine lengths (a constant, an
// associated constant, an operation on constants, a constant parameter, `I32.BITS`, a literal) are the
// fine units at the end of the file.

pub struct P {
  x: I32,
}

impl P {
  pub const N: U32 = 3
}

pub enum E {
  A,
  B(I32),
}

type Al = P

const K: U32 = 4

fn g() -> U32 {
  1
}

pub flow lp(x: F32 at sample) -> F32 at sample {
  x
}

pub trait Tr {                                      //~ E0200
  fn m(self) -> I32
}

pub effect Ef {                                     //~ E0200
  fn op(x: I32) -> I32
}

handler hh: Alloc { }                               //~ E0200

extern "C" lib "m" {                                //~ E0200
  fn c_sin(x: F64) -> F64
  type CHandle
}

// ---- A parameter: every kind ----

pub fn function_in_a_parameter(x: [F32; g]) -> F32 {   //~ E0417
  1.0
}

pub fn variant_in_a_parameter(x: [F32; E.A]) -> F32 {   //~ E0417
  1.0
}

pub fn tuple_variant_in_a_parameter(x: [F32; E.B]) -> F32 {   //~ E0417
  1.0
}

pub fn prelude_variant_in_a_parameter(x: [F32; None]) -> F32 {   //~ E0417
  1.0
}

pub fn extern_function_in_a_parameter(x: [F32; c_sin]) -> F32 {   //~ E0417
  1.0
}

pub fn struct_in_a_parameter(x: [F32; P]) -> F32 {  //~ E0308
  1.0
}

pub fn enum_in_a_parameter(x: [F32; E]) -> F32 {    //~ E0308
  1.0
}

pub fn alias_in_a_parameter(x: [F32; Al]) -> F32 {  //~ E0308
  1.0
}

pub fn builtin_type_in_a_parameter(x: [F32; I32]) -> F32 {   //~ E0308
  1.0
}

pub fn prelude_type_in_a_parameter(x: [F32; Option]) -> F32 {   //~ E0308
  1.0
}

pub fn prelude_trait_in_a_parameter(x: [F32; Show]) -> F32 {   //~ E0308
  1.0
}

pub fn kind_constraint_in_a_parameter(x: [F32; Copy]) -> F32 {   //~ E0308
  1.0
}

pub fn prelude_effect_in_a_parameter(x: [F32; Alloc]) -> F32 {   //~ E0308
  1.0
}

pub fn user_trait_in_a_parameter(x: [F32; Tr]) -> F32 {   //~ E0308
  1.0
}

pub fn user_effect_in_a_parameter(x: [F32; Ef]) -> F32 {   //~ E0308
  1.0
}

pub fn handler_in_a_parameter(x: [F32; hh]) -> F32 {   //~ E0308
  1.0
}

pub fn extern_type_in_a_parameter(x: [F32; CHandle]) -> F32 {   //~ E0308
  1.0
}

pub fn flow_in_a_parameter(x: [F32; lp]) -> F32 {   //~ E0308
  1.0
}

pub fn type_parameter_in_a_parameter[T](x: [F32; T]) -> F32 {   //~ E0308
  1.0
}

// The E0308 of `P` is of the names stage and the E0417 of `g` of the types stage, so the stage goes first
// (§18.1: the stages, then the places), though `g` is written first.
pub fn first_of_two_lengths(x: [F32; g], y: [F32; P]) -> F32 {   //~ E0308
  1.0
}

pub fn second_of_two_lengths(x: [F32; K], y: [F32; P]) -> F32 {   //~ E0308
  1.0
}

// ---- The other places of a signature and of a declaration ----

pub fn function_in_a_result() -> [F32; g] {          //~ E0417
  [0.0; 4]
}

pub fn type_in_a_result() -> [F32; P] {             //~ E0308
  [0.0; 4]
}

pub fn function_in_a_tuple_parameter(t: (U32, [F32; g])) -> F32 {   //~ E0417
  1.0
}

pub fn type_in_a_tuple_parameter(t: (U32, [F32; P])) -> F32 {   //~ E0308
  1.0
}

pub fn function_in_an_option(o: Option[[F32; g]]) -> F32 {   //~ E0417
  1.0
}

pub fn effect_in_an_option(o: Option[[F32; Alloc]]) -> F32 {   //~ E0308
  1.0
}

pub fn function_in_the_inner_array(x: [[F32; g]; 2]) -> F32 {   //~ E0417
  1.0
}

pub fn function_in_the_outer_array(x: [[F32; 2]; g]) -> F32 {   //~ E0417
  1.0
}

pub fn type_in_the_outer_array(x: [[F32; 2]; P]) -> F32 {   //~ E0308
  1.0
}

pub fn function_in_a_function_type(f: fn([F32; g]) -> F32) -> F32 {   //~ E0417
  1.0
}

pub fn type_in_the_result_of_a_function_type(f: fn(F32) -> [F32; P]) -> F32 {   //~ E0308
  1.0
}

type FunctionInAnAlias = [F32; g]                   //~ E0417

type TypeInAnAlias = [F32; P]                       //~ E0308

type TraitInAnAlias = [F32; Show]                   //~ E0308

type FunctionInATupleAlias = (U32, [F32; g])        //~ E0417

pub struct FunctionInAField {
  data: [F32; g],                                   //~ E0417
}

pub struct TypeInAField {
  count: U32,
  data: [F32; P],                                   //~ E0308
}

pub struct EffectInAField {
  data: [F32; Alloc],                               //~ E0308
}

pub struct VariantInAField {
  data: [F32; E.A],                                 //~ E0417
}

pub enum FunctionInAVariant {
  A([F32; g]),                                      //~ E0417
}

pub enum TypeInAVariant {
  A([F32; P]),                                      //~ E0308
}

const FUNCTION_IN_A_CONST_TYPE: [F32; g] = [0.0; 4]     //~ E0417

const TYPE_IN_A_CONST_TYPE: [F32; P] = [0.0; 4]         //~ E0308

const FLOW_IN_A_CONST_TYPE: [F32; lp] = [0.0; 4]        //~ E0308

impl P {
  pub fn function_in_a_method(self, x: [F32; g]) -> F32 {   //~ E0417
    1.0
  }

  pub fn type_in_a_method(self, x: [F32; Self]) -> F32 {   //~ E0308
    1.0
  }

  pub fn type_parameter_in_a_method[T](self, x: [F32; T]) -> F32 {   //~ E0308
    1.0
  }
}

// ---- The body: an annotation and the repeat `[x; N]` ----

pub fn function_in_an_annotation() -> F32 {
  let _: [F32; g] = [0.0; 4]                        //~ E0417
  1.0
}

pub fn type_in_an_annotation() -> F32 {
  let _: [F32; P] = [0.0; 4]                        //~ E0308
  1.0
}

pub fn effect_in_an_annotation() -> F32 {
  let _: [F32; Alloc] = [0.0; 4]                    //~ E0308
  1.0
}

pub fn function_in_a_cast(n: U32) -> F32 {
  let _ = n as [F32; g]                             //~ E0417
  1.0
}

pub fn function_in_a_closure_parameter() -> F32 {
  let f = fn(x: [F32; g]) -> F32 { 1.0 }            //~ E0417
  1.0
}

pub fn type_in_a_closure_result() -> F32 {
  let f = fn(x: F32) -> [F32; P] { [x; 4] }         //~ E0308
  1.0
}

pub fn function_in_a_repeat() -> F32 {
  let a = [0.0; g]                                  //~ E0417
  a[0]
}

pub fn variant_in_a_repeat() -> F32 {
  let a = [0.0; E.A]                                //~ E0417
  a[0]
}

pub fn type_in_a_repeat() -> F32 {
  let a = [0.0; P]                                  //~ E0308
  a[0]
}

pub fn alias_in_a_repeat() -> F32 {
  let a = [0.0; Al]                                 //~ E0308
  a[0]
}

pub fn trait_in_a_repeat() -> F32 {
  let a = [0.0; Show]                               //~ E0308
  a[0]
}

pub fn effect_in_a_repeat() -> F32 {
  let a = [0.0; Alloc]                              //~ E0308
  a[0]
}

pub fn flow_in_a_repeat() -> F32 {
  let a = [0.0; lp]                                 //~ E0308
  a[0]
}

pub fn user_effect_in_a_repeat() -> F32 {
  let a = [0.0; Ef]                                 //~ E0308
  a[0]
}

pub fn extern_function_in_a_repeat() -> F32 {
  let a = [0.0; c_sin]                              //~ E0417
  a[0]
}

pub fn parameter_in_a_repeat(n: U32) -> F32 {
  let a = [0.0; n]                                  //~ E0417
  a[0]
}

pub fn local_in_a_repeat() -> F32 {
  let n = 4
  let a = [0.0; n]                                  //~ E0417
  a[0]
}

pub fn function_in_a_repeat_in_a_branch(flag: Bool) -> F32 {
  if flag {
    let a = [0.0; g]                                //~ E0417
    a[0]
  } else {
    0.0
  }
}

pub fn type_in_a_repeat_in_a_closure() -> F32 {
  let f = fn(x: F32) -> F32 {
    let a = [x; P]                                  //~ E0308
    a[0]
  }
  f.(1.0)
}

pub fn type_in_a_repeat_in_a_generic_function[T](x: T) -> T {
  let a = [0.0; P]                                  //~ E0308
  x
}

test "a function name as the length of a repeat" {
  let a = [0.0; g]                                  //~ E0417
  assert a[0] == 0.0
}

// ---- Fine lengths ----

pub fn constant_in_a_parameter(x: [F32; K]) -> F32 {
  x[0]
}

pub fn associated_constant_in_a_parameter(x: [F32; P.N]) -> F32 {
  x[0]
}

pub fn literal_in_a_parameter(x: [F32; 8]) -> F32 {
  x[0]
}

pub fn constant_parameter_in_a_parameter[const N: U32](x: [F32; N]) -> F32 {
  x[0]
}

pub fn constant_in_a_result() -> [F32; K] {
  [0.0; K]
}

type FrameOfAConstant = [F32; K]

pub struct FieldOfAConstant {
  data: [F32; K],
  more: [F32; P.N],
}

const CONSTANT_IN_A_CONST_TYPE: [F32; K] = [0.0; K]

pub fn constant_in_an_annotation() -> F32 {
  let a: [F32; K] = [0.0; K]
  a[0]
}

pub fn constant_in_a_nested_array(x: [[F32; K]; P.N]) -> F32 {
  x[0][0]
}
