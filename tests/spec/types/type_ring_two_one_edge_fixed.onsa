// onsa.toml
// [test]
// spec = ["§18.1", "§4.5"]

// S-1066 (W6-04 U16), §18.1, §4.5: what the decision does not change. The ring of `type_ring_two_ab` where `RA` no
// longer names `RB`: `RA` still owns a `Buf[F32]` (Affine), so `RB.a` is the only E0416.

pub struct RA { b: Buf[F32] }
pub struct RB { a: Buf[RA] }   //~ E0416
