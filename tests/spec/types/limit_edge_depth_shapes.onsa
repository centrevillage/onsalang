// onsa.toml
// [test]
// spec = ["§4.4", "§18.1"]
// fixes = 0

// W8-14 A3/t, §4.4: the boundary of the depth limit 256 for each shape that counts a level (a type with arguments, a
// tuple, an array, a function type), on both sides; a name (`I32`) is none. In each chain `Op(k)` (`Option[..]`),
// `Tp(k)` (`(.., U8)`), `Ar(k)` (`[..; 1]`), `Fu(k)` (`fn(..) -> U8`) and the mixed chain `M(k)` (the four in turn) has
// the depth `k`: the first line of a chain makes 64 levels at once (so no line is nested near 256, §2.5) and the next
// ones add 64 and 62 (to 254), then 1 each: `Xx255` and `Xx256` are within the limit and `Xx257` is E0422 at its
// declaration, and `Xx258`, which uses it, is the error type and has none. `Buf[Op255]` and `Span[Op255]` are 256 and
// one more is 257: `Buf` and `Span` are a type with arguments, a level too. A written type that is made of an alias is
// the same: `Option[(Op254, U8)]` is 256 and `Option[(Op255, U8)]` is 257, E0422 at the written type. The sizes are
// small (about 2 per level).

// the chains of one shape
type Op64 = Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[I32]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]
type Op128 = Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Op64]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]
type Op192 = Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Option[Op128]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]
