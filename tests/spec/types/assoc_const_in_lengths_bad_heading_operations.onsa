// onsa.toml
// [test]
// fixes = 0
// spec = ["§4.5", "§6.2", "§18.1"]

// S-304 (W5-16 U1c, §18.1): an operation (E0200 in this version, K-05) or a prefix `-` (E0401) over a constant of an
// `impl` whose heading is wrong (E0416) has no diagnostic of its own in a signature, a const argument and an alias, as
// in a repeat of a body: the one error is the heading's, also with a constant of another `impl` (`R4.D`) beside it.
// Before this, these places were E0200 and E0401. One error per item (P-01).

pub struct Nb[T: Num, const N: U32] {
  a: [T; N],
}

impl[T, const N: U32] Nb[T, N] {   //~ E0416
  pub const D: U32 = N + 1
  pub const R: U32 = 4
}

pub struct Rg[T, const N: U32] {
  a: [T; N],
}

impl[T, const N: U32] Rg[T, N] {
  pub const D: U32 = N + 1
}

pub struct Ring[T, const N: U32] {
  a: [T; N],
}

type NF = Nb[F32, 4]
type R4 = Rg[F32, 4]

pub fn computed_plus_one(x: [F32; NF.D + 1]) -> F32 {
  x[0]
}

pub fn literal_plus_one(x: [F32; NF.R + 1]) -> F32 {
  x[0]
}

pub fn beside_another_impl(x: [F32; NF.D + R4.D]) -> F32 {
  x[0]
}

pub fn negated(x: [F32; -NF.R]) -> F32 {
  x[0]
}

pub fn in_a_const_argument(r: Ring[F32, NF.R * 2]) -> F32 {
  r.a[0]
}

type InAnAlias = [F32; NF.R + 1]
