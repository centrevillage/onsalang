// onsa.toml
// [test]
// spec = ["§4.5", "§4.6", "§5.3", "§18.1"]

// S-239 (W5-10 U1a): a second-class type (`Span`) or a type that holds one, written as the type argument of a type parameter
// without `?Escape`, is E0710 (§4.5: "第二級の型か、それを中に含む型を、`?Escape` の無い型パラメータの型引数に書いた所（`W[Span[F32]]`、
// `C[(Span[F32], F32)]`、`N[[Span[F32]; 2]]`）は位置の E0710 だけで、その型引数の要求は判定しない"; the list of an expression is a
// place of the type, "式の型引数 `::[…]`"). `Nm` here has a bound that `Span` does not meet, and the report is E0710 only. For an
// associated function, a struct literal, a variant, a tuple and an array. One error per item (P-01).

pub struct Wrap[T] {
  v: T,
}

impl[T] Wrap[T] {
  pub fn make(v: T) -> Wrap[T] {
    Wrap { v: v }
  }

  pub fn none() -> Option[T] {
    None
  }
}

pub struct Pr[T] {
  a: T,
}

pub struct Nm[T: Num] {
  a: T,
}

pub enum E[T] {
  A(T),
  B,
}

pub fn an_associated_function(s: Span[F32]) -> U32 {
  let _ = Wrap::[Span[F32]].make(s)                 //~ E0710
  1
}

pub fn an_associated_function_without_arguments() -> U32 {
  let _ = Wrap::[Span[F32]].none()                  //~ E0710
  1
}

pub fn a_struct_literal(s: Span[F32]) -> U32 {
  let _ = Pr::[Span[F32]] { a: s }                  //~ E0710
  1
}

pub fn a_variant() -> U32 {
  let _ = E::[Span[F32]].B                          //~ E0710
  1
}

pub fn in_a_tuple(s: Span[F32]) -> U32 {
  let _ = Wrap::[(Span[F32], F32)].make((s, 1.0))   //~ E0710
  1
}

pub fn in_an_array(s: Span[F32]) -> U32 {
  let _ = Wrap::[[Span[F32]; 2]].make([s, s])       //~ E0710
  1
}

pub fn a_bound_is_not_judged(s: Span[F32]) -> U32 {
  let _ = Nm::[Span[F32]] { a: s }                  //~ E0710
  1
}
