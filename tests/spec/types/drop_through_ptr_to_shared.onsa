// onsa.toml
// [test]
// spec = ["§4.1", "§4.6", "§10", "§12.2"]

// R-30, W4-05 U2b carry-over (W4-16 U3; §4.1: `Ptr[T]` is Copy and a value; §12.2: "Copy 値…の生成と破棄: 要らない"): a `Ptr[Str]`
// is a pointer, a Copy value, and holds no `Str`; the drop of a value that has one does not go to what the `Ptr` points to
// (the destruction of that `Str` is the owner's, not this value's). So a type with only `Ptr`s of Shared types and of `Buf`s
// needs no `Alloc` to be dropped: an `rt fn` takes it, and so does a function without `Alloc`. Before the fix the drop walked
// through the `Ptr` and asked for `Alloc` (an E0901 and an E0601 that are not in the spec). The `Str` next to a `Ptr` that
// is held by value is what needs it (negative/rt_drop_with_flat_ptr.onsa).

pub struct Named {
  p: Ptr[Str],
}

pub struct Raw {
  b: Ptr[Buf[F32]],
  items: Ptr[Array[Str]],
  n: U32,
}

pub struct Chain {
  next: Ptr[Chain],
  name: Ptr[Str],
}

pub rt fn own_named(move n: Named) -> U32 { 1 }

pub rt fn own_raw(move r: Raw) -> U32 { r.n }

pub rt fn own_chain(move c: Chain) -> U32 { 1 }

pub rt fn own_in_a_tuple(move t: (Named, U32)) -> U32 { t.1 }

pub rt fn own_in_an_array(move xs: [Chain; 2]) -> U32 { 1 }

pub fn own_named_plain(move n: Named) -> U32 { 1 }

pub fn own_raw_plain(move r: Raw) -> U32 { r.n }

pub fn own_chain_plain(move c: Chain) -> U32 { 1 }
