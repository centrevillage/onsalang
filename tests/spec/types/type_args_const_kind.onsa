// onsa.toml
// [test]
// spec = ["§4.5", "§15.1", "§18.1"]

// S-329, S-239 (W5-10 U1b): the kind of an element of the list written on a type in a constant expression is not the kind of the
// parameter in its place (§4.5: "要素の種類（型か定数式か）が宣言の位置と合わなければ、名前でない型の形と定数式（`Ring[F32, (F32, F32)]`、`Wrap[3]`）も
// E0308 である"; §15.1: "定数を型引数の位置に書く、型を const 引数の位置に書く"): a type for the const argument, a tuple type and a generic
// type for it, an integer and a constant for the type. The number of the elements is right (a wrong number is E0412). In the
// places of a length and a const argument. One error per item (P-01).

pub struct Rg[T, const N: U32] {
  d: [T; N],
}

impl[T, const N: U32] Rg[T, N] {
  pub const CAP: U32 = N
}

pub struct Ring[T, const N: U32] {
  d: [T; N],
}

const K: U32 = 4

pub fn a_type_for_the_const_argument(a: [F32; Rg::[F32, U8].CAP]) -> U32 { //~ E0308
  1
}

pub fn a_tuple_for_the_const_argument() -> [F32; Rg::[F32, (F32, F32)].CAP] { //~ E0308
  [0.0; 4]
}

pub fn a_generic_type_for_the_const_argument() -> U32 {
  let a: [F32; Rg::[F32, Option[U8]].CAP] = [0.0; 4] //~ E0308
  a.len()
}

pub fn an_integer_for_the_type(a: [F32; Rg::[3, 4].CAP]) -> U32 { //~ E0308
  1
}

pub fn a_constant_for_the_type() -> U32 {
  let a = [0.0; Rg::[K, 4].CAP]                     //~ E0308
  a.len()
}

pub fn a_constant_for_the_type_in_a_const_argument(r: Ring[F32, (Rg::[K, 4].CAP)]) -> U32 { //~ E0308
  1
}

pub fn right(a: [F32; Rg::[F32, K].CAP]) -> U32 {
  a.len()
}
