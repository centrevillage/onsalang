const STRUCT_AS_A_CONST_ARGUMENT_IN_A_CONST_TYPE: Ring[F32, P] = Ring { data: [0.0; 4], head: 0 }   //~ E0308

pub fn struct_as_a_const_argument_in_an_annotation() -> F32 {
