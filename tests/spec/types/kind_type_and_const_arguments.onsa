  1.0
}

pub fn constant_as_the_type_of_a_ring(r: Ring[K, 4]) -> F32 {   //~ E0308
  1.0
}

pub fn function_as_a_type_argument(o: Option[g]) -> F32 {   //~ E0308
  1.0
}

pub fn variant_as_a_type_argument(o: Option[E.A]) -> F32 {   //~ E0308
  1.0
}

pub fn constant_as_a_type_argument_in_a_result() -> Option[K] {   //~ E0308
  None
}

pub fn constant_as_a_type_argument_in_a_tuple(t: (U32, Option[K])) -> F32 {   //~ E0308
  1.0
}

pub fn constant_as_a_nested_type_argument(o: Option[Option[K]]) -> F32 {   //~ E0308
  1.0
}

pub fn constant_as_a_type_argument_of_an_array(x: [Option[K]; 2]) -> F32 {   //~ E0308
  1.0
}

pub fn constant_as_a_type_argument_of_a_function_type(f: fn(Option[K]) -> F32) -> F32 {   //~ E0308
  1.0
