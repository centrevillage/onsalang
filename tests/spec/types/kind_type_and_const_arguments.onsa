type ConstantAsAnArgumentInAnAlias = Option[K]      //~ E0308

pub struct ConstantAsAnArgumentInAField {
  o: Option[K],                                     //~ E0308
}

pub enum ConstantAsAnArgumentInAVariant {
  A(Option[K]),                                     //~ E0308
}

const CONSTANT_AS_AN_ARGUMENT_IN_A_CONST_TYPE: Option[K] = None   //~ E0308

pub fn constant_as_a_type_argument_in_an_annotation() -> F32 {
  let _: Option[K] = None                           //~ E0308
  1.0
}

pub fn constant_as_a_type_argument_in_a_cast(n: U32) -> F32 {
  let _ = n as Option[K]                            //~ E0308
  1.0
}

pub fn constant_as_a_type_argument_in_a_closure() -> F32 {
  let f = fn(o: Option[K]) -> F32 { 1.0 }           //~ E0308
  1.0
}

impl P {
  pub fn constant_as_a_type_argument_in_a_method(self, o: Option[K]) -> F32 {   //~ E0308
    1.0
  }
}

