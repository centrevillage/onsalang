// onsa.toml
// [test]
// spec = ["§18.1", "§4.6"]

// S-1067 (W6-04 U16), §18.1, §4.6: a type with a part that was not read (here the field `e: Buf[Str]`, an E0416) judges
// what the parts that were read decide. What depends on the part that was not read is not judged: a function whose type
// parameter has a bound that is not found (E0302) is checked no further, and the `Str` in the tuple does not make an
// E0416.

pub struct OC[T: Copy] { v: T }
pub fn f[T: Gone](x: OC[(T, Str)]) -> I32 { 0 }   //~ E0302
