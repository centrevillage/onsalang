// onsa.toml
// [test]
// fixes = 0
// spec = ["§4.4", "§4.5", "§18.1"]

// S-304 (W5-16 U1c): an alias whose type arguments are an error (`Rg[F32, -1]`, E0401: a prefix minus is no `U32`, §4.5)
// is an error type, and a place that uses it has no diagnostic (§18.1: "誤りの型を使う所には診断を出さない"). The constant
// of it in a constant expression (`RX.CAP`) is such a use: the one error is the alias's. Today the places also have
// an E0200 (a chain of the error). No candidate (`fixes = 0`). One error per unit (P-01); the units are the alias and
// the places that use it, which have no marker.

pub struct Rg[T, const N: U32] {
  a: [T; N],
}

impl[T, const N: U32] Rg[T, N] {
  pub const CAP: U32 = N
}

pub struct Ring[T, const N: U32] {
  a: [T; N],
}

type RX = Rg[F32, -1]   //~ E0401

pub fn in_an_argument(a: [F32; RX.CAP]) -> F32 {
  0.0
}

pub fn in_a_return() -> [F32; RX.CAP] {
  [0.0; 4]
}

pub fn in_a_repeat() -> F32 {
  let a = [0.0; RX.CAP]
  a[0]
}

pub fn in_a_let_annotation() -> F32 {
  let a: [F32; RX.CAP] = [0.0; 4]
  a[0]
}

pub fn in_a_const_argument(r: Ring[F32, RX.CAP]) -> F32 {
  0.0
}
