// onsa.toml
// [package]
// name = "instance_grow_array"
// edition = "2026"
//
// [export]
// prefix = "iga_"
//
// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [test]
// spec = ["§4.4", "§4.5", "§18.1"]
// fixes = 0

// S-290 (W5-23 U2): the growth wraps the type in a fixed array: `[x; 2]` has the type `[T; 2]`, one
// level deeper (an array type is one level, §4.4), and `T: Copy` is what the array repeat needs.

@export
pub fn root() -> U32 {
  g(1, 3)
}

fn g[T: Copy](x: T, n: U32) -> U32 {
  if n == 0 {
    return 0
  }
  g([x; 2], n - 1)  //~ E0422
}
