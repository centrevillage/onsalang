// onsa.toml
// [test]
// spec = ["§18.1", "§4.6"]

// S-1067 (W6-04 U16), §18.1, §4.6: a type with a part that was not read (here the field `e: Buf[Str]`, an E0416) judges
// what the parts that were read decide. `E1` has a `Str` (Shared), so it is not `Copy`: a type argument of a parameter
// that asks `Copy` is an E0416.

pub struct E1 { s: Str, e: Buf[Str] }   //~ E0416
pub struct OC[T: Copy] { v: T }
pub struct U { u: OC[E1] }   //~ E0416
