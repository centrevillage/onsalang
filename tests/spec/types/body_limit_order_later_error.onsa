// onsa.toml
// [test]
// spec = ["§4.4", "§4.7", "§18.1"]
// fixes = 0

// S-264 (W5-16 U2), §4.7, §18.1: the limit is reported when the statement that made the type is checked, and a unit
// stops its type stage at the first error (§18.1), so the error of a later statement (`takes(3)`, E0401) is not
// reported while the E0422 is.

fn takes(b: Bool) -> U32 {
  1
}

pub fn order() -> U32 {
  let t0: I32 = 0
  let t1 = (t0, t0)
  let t2 = (t1, t1)
  let t3 = (t2, t2)
  let t4 = (t3, t3)
  let t5 = (t4, t4)
  let t6 = (t5, t5)
  let t7 = (t6, t6)
  let t8 = (t7, t7)
  let t9 = (t8, t8)
  let t10 = (t9, t9)
  let t11 = (t10, t10)
  let w = (t11, t11)  //~ E0422
  let _ = w
  let q = takes(3)
  q
}
