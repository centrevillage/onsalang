// onsa.toml
// [test]
// spec = ["§18.2"]
// golden = ["interface"]

// R-382 (W5-17, §18.2: "シグネチャの型は、読み直すと同じ型になる形で書く"): the type parameters of an `impl` are of its heading, and a
// method's own are of the method. A type of a method names the parameter it names: a parameter of the method stays one (`y: U`, not `y: T`), a
// parameter of the `impl` stays one (`x: T`). (An effect variable of a method is named too, but its declaration is E0200 in this version, §8.1 R-27 (3), so the
// method is not in this case (the golden of the interface is of a file with no diagnostic); that part is kept for the version that has the variable, tasks/phase2.md.) The golden file is written from §18.2, not from the output.

pub struct Rack[T] {
  n: U32,
}

impl[T] Rack[T] {
  pub fn peek[U](self, y: U) -> U32 {
    self.n
  }

  pub fn both[U](self, x: T, y: U) -> U {
    y
  }
}
