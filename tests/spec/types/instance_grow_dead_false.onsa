// onsa.toml
// [package]
// name = "instance_grow_dead_false"
// edition = "2026"
//
// [export]
// prefix = "igdf_"
//
// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [test]
// spec = ["§4.4", "§4.5", "§18.1", "§7"]
// fixes = 0

// S-290 (W5-23 U2), §7: the instantiation does not look at the value of a condition, as the
// reachability does not (§7: "条件の値は見ない"; `if false { .. }` is not an error), so the call in
// the branch of `if false` is lowered and makes the type one level deeper at every call: E0422.

@export
pub fn root() -> U32 {
  g(1, 3)
}

fn g[T](x: T, n: U32) -> U32 {
  if false {
    return g(Some(x), n - 1)  //~ E0422
  }
  n
}
