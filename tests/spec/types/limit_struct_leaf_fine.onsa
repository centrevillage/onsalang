// onsa.toml
// [test]
// spec = ["§4.4"]

// S-264 (W4-05 U1): the fix the note of E0422 shows (§4.4: "途中の型に名前付きの struct で名前を付ける"):
// a declared struct is a leaf and its fields are not counted, so naming a middle of the chain with a
// struct keeps every type after it within the limit. A11 is 4095 and the fields of `Mid` hold it
// (the size of a field is its own type's, which is within the limit); `Mid` counts one, so the
// aliases above it and the written types with it are small, where `(A11, A11)` would be 8191 and
// E0422 (limit_written_size.onsa). The depth is the same: `Deep` holds B256 and the types made of
// `Deep` are shallow. This file has no diagnostic.

type A0 = I32

type A1 = (A0, A0)

type A2 = (A1, A1)

type A3 = (A2, A2)

type A4 = (A3, A3)

type A5 = (A4, A4)

type A6 = (A5, A5)

type A7 = (A6, A6)

type A8 = (A7, A7)

type A9 = (A8, A8)

type A10 = (A9, A9)

type A11 = (A10, A10)

