// S-264 (W5-16 U2), §4.4: the boundary below `body_limit_size_double_over.onsa`: `t11` is 4095, within the limit, and
// is the end of the chain. No diagnostic.

pub fn chain() -> U32 {
  let t0: I32 = 0
  let t1      = (t0, t0)
  let t2      = (t1, t1)
  let t3      = (t2, t2)
  let t4      = (t3, t3)
  let t5      = (t4, t4)
  let t6      = (t5, t5)
  let t7      = (t6, t6)
  let t8      = (t7, t7)
  let t9      = (t8, t8)
  let t10     = (t9, t9)
  let t11     = (t10, t10)
  let _       = t11
  0
}
