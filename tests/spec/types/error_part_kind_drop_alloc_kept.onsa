// onsa.toml
// [test]
// spec = ["§18.1", "§4.6"]

// S-1067 (W6-04 U16), §18.1, §4.6: a type with a part that was not read (here the field `e: Buf[Str]`, an E0416) judges
// what the parts that were read decide. Dropping a value that owns a `Str` (Shared) or a `Buf` needs `Alloc`, which an
// `rt` function does not have: E0601 for each (unchanged, §12.2).

pub struct E1 { s: Str, e: Buf[Str] }   //~ E0416
pub struct E2 { b: Buf[F32], e: Buf[Str] }   //~ E0416
pub rt fn d1(move x: E1) -> I32 { 0 }   //~ E0601
pub rt fn d2(move x: E2) -> I32 { 0 }   //~ E0601
