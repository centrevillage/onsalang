// onsa.toml
// [test]
// spec = ["§4.4", "§6.2", "§15.1", "§18.1"]

// S-737 (W4-05 U3a): a name after the name of a type that is E0304 is an error name where it is used
// (§18.1: "E0304・E0305 になった名前も、その空間では、使う所と他のモジュールの経路はどちらの宣言も引かず、
// その名前を誤りとして扱う"; S-737: "使う所（`E.A`、`Self.A`、別名の `F.A`、`E.A =>`）は §18.1 のとおり誤りの名前
// として黙る"). The enum `E` has the variant `A` and the `impl` has the constant `A` (E0304 at the constant). Each use
// of the name below would be an E0401 if it were read as the variant (`E` is not `Bool`; a variant that takes a value
// is not `Bool`; the field `x` of the variant is `I32`) or as the constant (`I32` is not `Bool`), so only the
// silence of the unit shows that the name is an error name: the path `E.A`, `Self.A` in a method, the path of an
// alias `F.A` and the pattern `E.A(x)`. The units that use the other variant `B` are not silent (E0401, the
// first ones: a name that is no clash is read as before). The same holds for the name that two `impl` blocks of one type
// give (a function `a` and a constant `N`, the later one of each E0304).

pub enum E {
  A(I32),
  B,
}

type F = E

impl E {
  pub const A: I32 = 1                              //~ E0304
  pub fn via_self() -> Bool { Self.A }
}

pub fn via_path() -> Bool {
  E.A
}

pub fn via_alias() -> Bool {
  F.A
}

pub fn via_pattern(e: E) -> Bool {
  match e {
    E.A(x) => x,
    _ => false,
  }
}

pub fn the_other_variant() -> Bool {
  E.B                                               //~ E0401
}

pub fn the_other_variant_by_alias() -> Bool {
  F.B                                               //~ E0401
}

pub struct S {
  x: I32,
}

impl S {
  pub fn a(x: I32) -> I32 { x }
  pub const N: U32 = 1
  pub fn unique(x: I32) -> I32 { x }
}

impl S {
  pub fn a(x: I32) -> I32 { x }                     //~ E0304
  pub const N: U32 = 2                              //~ E0304
}

pub fn two_impls_fn() -> Bool {
  S.a(1)
}

pub fn two_impls_const() -> Bool {
  S.N
}

pub fn unique_is_read() -> Bool {
  S.unique(1)                                       //~ E0401
}

pub struct S6 {
  x: I32,
}

impl S6 {
  pub fn get(self) -> I32 { 1 }
}

impl S6 {
  pub fn get(self) -> I32 { 2 }                     //~ E0304
}

pub fn use_method(s: S6) -> Bool {
  s.get()
}
