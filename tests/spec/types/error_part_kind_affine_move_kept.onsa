// onsa.toml
// [test]
// spec = ["§18.1", "§4.6"]

// S-1067 (W6-04 U16), §18.1, §4.6: a type with a part that was not read (here the field `e: Buf[Str]`, an E0416) judges
// what the parts that were read decide. `E2` is Affine by its `Buf`, so a `let` that consumes it without `move` is an
// E0711 (§5.2; unchanged).

pub struct E2 { b: Buf[F32], e: Buf[Str] }   //~ E0416
pub fn m2(move x: E2) -> E2 {
  let a = x   //~ E0711
  a
}
