// onsa.toml
// [package]
// name = "instance_ok_same_swap_closed"
// edition = "2026"
//
// [export]
// prefix = "iss_"
//
// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [test]
// spec = ["§4.4", "§4.5", "§18.1"]
// mode = "test"

// S-290 (W5-23 U2): recursion whose type argument does not grow ends the instantiation: the same type
// (`g(x, ..)`), the two types swapped (`h(y, x, ..)`: two instantiations that call each other), a
// closed argument (`k(Some(1), ..)`: the type argument is `Option[I32]` whatever the caller has, so
// there are two instantiations), and a recursion in a method. No diagnostic; the tests run.

fn g[T](x: T, n: U32) -> U32 {
  if n == 0 {
    return 0
  }
  g(x, n - 1)
}

fn h[A, B](x: A, y: B, n: U32) -> U32 {
  if n == 0 {
    return 0
  }
  h(y, x, n - 1) + 1
}

fn k[T](x: T, n: U32) -> U32 {
  if n == 0 {
    return 0
  }
  k(Some(1), n - 1) + 1
}

pub struct S[T] {
  v: T,
}

impl[T] S[T] {
  fn m(self, n: U32) -> U32 {
    if n == 0 {
      return 0
    }
    S { v: self.v }.m(n - 1) + 1
  }
}

@export
pub fn root() -> U32 {
  g(1, 3) + h(1, true, 3) + k(1, 3) + S { v: 1 }.m(3)
}

test "the same type" {
  assert g(1, 3) == 0
  assert g(true, 3) == 0
}

test "swapped types" {
  assert h(1, true, 3) == 3
  assert h(true, 1, 4) == 4
}

test "a closed argument" {
  assert k(1, 3) == 3
  assert k(true, 2) == 2
}

test "a method" {
  assert S { v: 1 }.m(3) == 3
}
