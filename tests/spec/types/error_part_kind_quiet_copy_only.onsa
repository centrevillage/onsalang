// onsa.toml
// [test]
// spec = ["§18.1", "§4.6"]

// S-1067 (W6-04 U16), §18.1, §4.6: a type with a part that was not read (here the field `e: Buf[Str]`, an E0416) judges
// what the parts that were read decide. What depends on the part that was not read is not judged: `E3` has only `Copy`
// parts that were read (`n: I32`), so whether it is `Copy` is not decided by them: a `Buf` element, an `Array` element
// and the drop in an `rt` function give nothing.

pub struct E3 { n: I32, e: Buf[Str] }   //~ E0416
pub struct U { u: Buf[E3] }
pub struct U2 { u: Array[E3] }
pub rt fn d3(move x: E3) -> I32 { 0 }
