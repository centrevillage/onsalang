// onsa.toml
// [test]
// spec = ["§8.1", "§2.3"]
// fixes = 0

// R-27 (3), W6-01 U1 (spec §8.1: the declaration of an effect row variable is E0200 in this version, at its name; §2.3: the shapes of the names, `snake_case` for an effect row variable
// with at most one `_` at the end that keeps a keyword away): the effect row variables whose names are fine in the shape (`inout_`, `item_key`, `e`) are declared in the
// units that were in naming_shapes_fine.onsa and naming_type_params_fine.onsa (R-260 had `inout_` give a candidate that changed nothing, an internal error in the debug build).
// Each is the E0200 of its declaration and nothing else: no E0320 for the name, no candidate, no internal error. `fixes = 0` checks that no candidate is offered.

pub fn run_inout[T, inout_](f: fn(T) -> T uses {inout_}, x: T) -> T uses {inout_} { //~ E0200 @21
  f.(x)
}

pub fn run_words[T, item_key](f: fn(T) -> T uses {item_key}, x: T) -> T uses {item_key} { //~ E0200 @21
  f.(x)
}

pub fn run_single_letter[T, e](f: fn(T) -> T uses {e}, x: T) -> T uses {e} { //~ E0200 @29
  f.(x)
}

pub fn run_a_digit[T, e2](f: fn(T) -> T uses {e2}, x: T) -> T uses {e2} { //~ E0200 @23
  f.(x)
}
