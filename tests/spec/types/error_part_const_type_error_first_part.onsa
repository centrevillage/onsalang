// onsa.toml
// [test]
// spec = ["§18.1", "§6.6"]

// S-1075 (W6-04 U16) (2), S-1067 (D-c), §18.1, §6.6: `E1` has a part that was not read (`e: Buf[Str]`) and a
// `Str` that was read, so it is not `Copy` (the bound of `OC` fails, E0416) and it is Shared: the placement is judged
// first, the E0200 of this version is the error of the unit of `C1`.

pub struct E1 { s: Str, e: Buf[Str] }   //~ E0416
pub struct OC[T: Copy] { v: T }
pub const C1: Option[OC[E1]] = None   //~ E0200
