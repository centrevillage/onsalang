// onsa.toml
// [test]
// spec = ["§4.4", "§18.1"]

// S-264 (W4-05 U1): the size limit of a type the check makes is 4096 (spec §4.4): the names (built-in
// types, declared types, type parameters), the shapes of a type and the const arguments each count one,
// and a declared struct or enum is a leaf. `type A0 = I32` has size 1, and `type Ak = (A(k-1), A(k-1))`
// is one tuple shape and two copies of the one before, so size(Ak) = 2^(k+1) - 1: A11 is 4095 (within
// the limit) and A12 is 8191, the first to pass 4096. The diagnostic is E0422 at the declaration of
// the alias that first passes (§4.4: "別名はその宣言"); the alias that uses it (A13, A14) is the error
// type and has no diagnostic of its own (§4.4, §18.1), and so is a signature that writes A12.
// The implementation gave no E0422 before W4-05 U1, which brought the code in.

type A0 = I32

type A1 = (A0, A0)

type A2 = (A1, A1)

type A3 = (A2, A2)

type A4 = (A3, A3)

type A5 = (A4, A4)

type A6 = (A5, A5)

type A7 = (A6, A6)

type A8 = (A7, A7)

type A9 = (A8, A8)

type A10 = (A9, A9)

type A11 = (A10, A10)

type A12 = (A11, A11)                               //~ E0422

type A13 = (A12, A12)
type A14 = (A13, A11)

pub fn uses_the_error_alias(x: A12, y: A14) {}

pub fn within_the_limit(x: A11) -> A11 {
  x
}
