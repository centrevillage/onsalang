// onsa.toml
// [test]
// spec = ["§4.4", "§4.6", "§5.2", "§10", "§12.2"]
// mode = "check"

// S-782 (§4.6: the kind of an `enum` is found from its payloads like a struct's; §12.2: the drop of what holds a `Str` or a `Buf` needs `Alloc`): a parameter taken by `move` is dropped at the end of the function, and the drop needs `Alloc` when the bottom of the chain holds a `Str` or a `Buf` (an E0901 in an `rt fn`, an E0601 otherwise), and needs nothing when it holds only Copy values or the parameter is borrowed.
// The chain is `E_k[T] { A(E_(k-1)[(T, T)]), B(E_(k-1)[(T, U8)]) }` with `E_0[T] { V(T) }` (all declared `[T: ?Dup]`), at the depth 11. `mode = "check"` only.

pub enum E0[T: ?Dup] {
  V(T),
}

pub enum E1[T: ?Dup] {
  A(E0[(T, T)]),
  B(E0[(T, U8)]),
}

pub enum E2[T: ?Dup] {
  A(E1[(T, T)]),
  B(E1[(T, U8)]),
}

pub enum E3[T: ?Dup] {
  A(E2[(T, T)]),
  B(E2[(T, U8)]),
}

pub enum E4[T: ?Dup] {
  A(E3[(T, T)]),
  B(E3[(T, U8)]),
}

pub enum E5[T: ?Dup] {
  A(E4[(T, T)]),
  B(E4[(T, U8)]),
}

pub enum E6[T: ?Dup] {
  A(E5[(T, T)]),
  B(E5[(T, U8)]),
}

pub enum E7[T: ?Dup] {
  A(E6[(T, T)]),
  B(E6[(T, U8)]),
}

pub enum E8[T: ?Dup] {
  A(E7[(T, T)]),
  B(E7[(T, U8)]),
}

pub enum E9[T: ?Dup] {
  A(E8[(T, T)]),
  B(E8[(T, U8)]),
}

pub enum E10[T: ?Dup] {
  A(E9[(T, T)]),
  B(E9[(T, U8)]),
}

pub enum E11[T: ?Dup] {
  A(E10[(T, T)]),
  B(E10[(T, U8)]),
}

pub rt fn drop_str_leaf_rt(move g: E11[Str]) -> U32 { 0 }   //~ E0901

pub fn drop_str_leaf(move g: E11[Str]) -> U32 { 0 }   //~ E0601

pub rt fn drop_buf_leaf_rt(move g: E11[Buf[F32]]) -> U32 { 0 }   //~ E0901

pub fn drop_buf_leaf(move g: E11[Buf[F32]]) -> U32 { 0 }   //~ E0601

pub rt fn drop_copy_leaf_rt(move g: E11[F32]) -> U32 { 0 }

pub rt fn borrowed_buf_leaf_rt(g: E11[Buf[F32]]) -> U32 { 0 }
