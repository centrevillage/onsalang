// onsa.toml
// [test]
// spec = ["§4.4", "§4.7", "§18.1"]
// fixes = 0

// S-264 (W5-16 U2), §4.4: the size is counted by the names (built-in types, declared types, type parameters), the
// shapes and the const arguments, one each. `t0` is `I32` (1) and `(t(k-1), t(k-1))` is one tuple shape and two
// copies, so the size of `tk` is `2^(k+1) - 1`: `t11` is 4095 (within the limit) and `t12` is 8191, the first to pass
// 4096. E0422 at the tuple of `t12`. The depth is 12, so it is the size that is over. `t13` and the line after use
// the type that is over the limit and have no diagnostic (§18.1).

pub fn chain() -> U32 {
  let t0: I32 = 0
  let t1 = (t0, t0)
  let t2 = (t1, t1)
  let t3 = (t2, t2)
  let t4 = (t3, t3)
  let t5 = (t4, t4)
  let t6 = (t5, t5)
  let t7 = (t6, t6)
  let t8 = (t7, t7)
  let t9 = (t8, t8)
  let t10 = (t9, t9)
  let t11 = (t10, t10)
  let t12 = (t11, t11)  //~ E0422
  let t13 = (t12, t12)
  let _ = t13
  0
}
