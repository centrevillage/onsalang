// onsa.toml
// [test]
// spec = ["§18.1", "§4.5"]

// S-1066 (W6-04 U16), §18.1, §4.5: what the decision does not change. Both `Dir` and `File` own a `Buf`, so both `Array`
// fields fail: two E0416 in either order.

pub struct File { parent: Array[Dir], data: Buf[U8] }   //~ E0416
pub struct Dir { files: Array[File], b: Buf[U8] }   //~ E0416
