// onsa.toml
// [test]
// spec = ["§18.1", "§4.4"]

// S-1066 (W6-04 U16), §18.1, §4.5: what the decision does not change. A set of an alias, another alias that names it,
// and a struct: the aliases are judged in the order of what they name (§4.4, S-1066), so `TA = Buf[SB]` fails (`SB` owns
// a `Buf`) and is an error type, and `TC`, which names it, gives nothing: one E0416 in every order.

pub type TC = Buf[(TA, I32)]
pub type TA = Buf[SB]   //~ E0416
pub struct SB { c: TC }
