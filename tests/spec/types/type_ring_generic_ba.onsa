// onsa.toml
// [test]
// spec = ["§18.1", "§4.5"]

// S-1066 (W6-04 U16), §18.1, §4.5: the declarations that name each other where they do not contain each other as a value
// (the elements of `Buf` and `Array`, type arguments) are each judged by the fields of the others as they are written,
// so each field that fails is an E0416 whatever the order of the declarations is; the field that failed is an error type
// only for the declarations outside the set. The set is two generic structs that name each other with their own type
// parameter.

pub struct GB[T] { g: Buf[GA[T]] }   //~ E0416
pub struct GA[T] { f: Buf[GB[T]] }   //~ E0416
