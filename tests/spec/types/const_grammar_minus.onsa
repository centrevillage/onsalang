// onsa.toml
// [test]
// spec = ["§4.5", "§3.4", "§11.4", "§11.5"]

// `U32` has no prefix `-`, so `-1`, `-0`, `-(1)`, `-K` and a prefix `-` in an operation or before a sum are E0401 wherever a constant
// expression is written (§4.5, §3.4; S-228), never E0408 or E0808. negative/const_expr_neg.onsa and negative/flow_const_neg.onsa have some
// of the places; this file has the others, and the flow places that are fine before W5-16 U1b1 are in the _unchanged file.
// The places are the heading of an item (a parameter, a result, a field, an alias, the type of a `const`, a const argument) and
// the repeat and the annotation of a body.
// The units whose result does not change are in const_grammar_minus_unchanged.onsa. One error per unit (§18.1).

pub struct Ring[T, const N: U32] {
  data: [T; N],
  head: U32,
}

pub struct P {
  x: U32,
}

const K: U32 = 4
const XS: [U32; 2] = [1, 2]

fn g(a: U32) -> U32 {
  a
}

pub fn constant_in_a_parameter(x: [F32; -K]) -> F32 {   //~ E0401
  1.0
}

pub fn constant_in_a_repeat() -> F32 {
  let a = [0.0; -K]   //~ E0401
  a[0]
}

pub fn sum_in_a_parameter(x: [F32; -(K + 1)]) -> F32 {   //~ E0401
  1.0
}

pub fn sum_in_a_repeat() -> F32 {
  let a = [0.0; -(K + 1)]   //~ E0401
  a[0]
}

pub struct SumInAField {
  a: [F32; -(K + 1)],   //~ E0401
}

pub fn after_operator_in_a_parameter(x: [F32; 2 * -K]) -> F32 {   //~ E0401
  1.0
}

pub fn after_operator_in_a_repeat() -> F32 {
  let a = [0.0; 2 * -K]   //~ E0401
  a[0]
}

const AFTER_OPERATOR_IN_A_CONST_TYPE: [F32; 2 * -K] = [0.0; 4]   //~ E0401
