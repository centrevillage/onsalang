// onsa.toml
// [test]
// spec = ["§4.5", "§6.3", "§18.1"]

// W5-05 U1 (§6.3, §4.5): the number traits are bounds of a program, at every place that has a list of bounds: a
// function, a method, a struct, an enum and the `[ ]` of an `impl` (they were the E0200 of the name until W5-05).
// The other forms are in num_traits/.

pub fn any_num_bound[T: AnyNum](x: T) -> T {
  x
}

pub fn int_bound[T: Int](x: T) -> T {
  x
}

pub fn unsigned_bound[T: Unsigned](x: T) -> T {
  x
}

pub fn num_and_int_bound[T: Num + Int](x: T) -> T {
  x
}

pub fn the_second_parameter[T, U: Int](x: T, y: U) -> U {
  y
}

pub struct IntRack[T: Int] {
  a: T,
}

pub enum IntShelf[T: AnyNum] {
  One(T),
  Nothing,
}

pub struct Plain {
  n: U32,
}

impl Plain {
  pub fn method_int[U: Int](self, y: U) -> U {
    y
  }
}

pub struct Rack2[T] {
  a: T,
}

impl[T: Int] Rack2[T] {
  pub fn tag() -> U32 {
    7
  }
}

// -------------------------------------------------------------------------------- what is right

pub fn num_bound[T: Num](x: T) -> T {
  x
}

pub fn float_bound[T: Float](x: T) -> T {
  x
}

pub fn ordered_bound[T: PartialOrd](x: T) -> T {
  x
}
