// onsa.toml
// [test]
// mode = "test"
// spec = ["§4.4", "§4.5", "§6.2", "§6.3"]

// S-304, R-187 (W5-05 U2): when the arguments of the alias meet the bounds of the `impl`, the constant is read with
// its value (the counterpart of types/assoc_const_bound_unmet.onsa). The bound is of the `impl` and not of the
// struct: two `impl` blocks of one struct with different bounds each give the constants of their own to the
// aliases that meet them. Every value is worked out by hand from the text of the declaration.

pub struct Sh[T] {
  x: T,
}

impl[T: Show + Copy] Sh[T] {
  pub const B: U32 = 2
  pub const Z: Option[T] = None
}

pub struct Pair[T, const N: U32] {
  a: [T; N],
}

impl[T: Num, const N: U32] Pair[T, N] {
  pub const NUM_CAP: U32 = N
}

impl[T: Float, const N: U32] Pair[T, N] {
  pub const FLOAT_CAP: U32 = N * 2
}

type ShI = Sh[I32]
type ShB = Sh[Bool]
type PairF = Pair[F32, 4]
type PairI = Pair[I32, 3]

test "a Show bound" {
  assert ShI.B == 2
  assert ShB.B == 2
}

test "a Show bound and the option of the argument" {
  let i: Option[I32] = ShI.Z
  let b: Option[Bool] = ShB.Z
  assert i == None
  assert b == None
}

test "the constants of the impl that the argument meets" {
  assert PairF.NUM_CAP == 4
  assert PairF.FLOAT_CAP == 8
  assert PairI.NUM_CAP == 3
}
