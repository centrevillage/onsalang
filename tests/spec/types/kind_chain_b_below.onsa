// onsa.toml
// [test]
// spec = ["§4.4", "§4.5", "§4.6", "§5.2", "§5.3"]
// mode = "check"

// S-782 (§4.6: "全ての型は構造から次のどれかに分類される"; "Copy: スカラ、Copy 要素の固定長配列・タプル・構造体・enum"): the kind
// of a type is found from its structure and does not change with the number of declarations on the way. The chain is
// `G_k[T] { x: G_(k-1)[(T, T)], y: G_(k-1)[Option[T]] }` with `G_0[T] { v: T }`, 'G13[F32]' holds only `F32`s, so it is Copy and a value of it
// is copied where it is used twice (§5.2), is an element of a `Buf` and of `[g; 3]`, and satisfies `T: Copy` (§4.5). A
// `Str` in place of the `F32` makes it Shared, which is copied too (§4.6). The depth is 13: one below the depth 14 where the first implementation stopped finding the
// kind (a limit on the steps of the walk, not in the spec); the file `kind_chain_b_copy.onsa` has the same
// forms at the depth 14, and the answers are the same. The kind of an Affine argument at the same depths is
// `kind_chain_b_affine.onsa` and, with the Affine forms of this depth, at the end of this file. The depth of a
// declared type stays inside §4.4 (a declaration is a leaf there) so there is no E0422 at any depth.

pub struct G0[T] {
  v: T,
}

pub struct G1[T] {
  x: G0[(T, T)],
  y: G0[Option[T]],
}

pub struct G2[T] {
  x: G1[(T, T)],
  y: G1[Option[T]],
}

pub struct G3[T] {
  x: G2[(T, T)],
  y: G2[Option[T]],
}

pub struct G4[T] {
  x: G3[(T, T)],
  y: G3[Option[T]],
}

pub struct G5[T] {
  x: G4[(T, T)],
  y: G4[Option[T]],
}

pub struct G6[T] {
  x: G5[(T, T)],
  y: G5[Option[T]],
}

pub struct G7[T] {
  x: G6[(T, T)],
  y: G6[Option[T]],
}

pub struct G8[T] {
  x: G7[(T, T)],
  y: G7[Option[T]],
}

pub struct G9[T] {
  x: G8[(T, T)],
  y: G8[Option[T]],
}

pub struct G10[T] {
  x: G9[(T, T)],
  y: G9[Option[T]],
}

pub struct G11[T] {
  x: G10[(T, T)],
  y: G10[Option[T]],
}

pub struct G12[T] {
  x: G11[(T, T)],
  y: G11[Option[T]],
}

pub struct G13[T] {
  x: G12[(T, T)],
  y: G12[Option[T]],
}

// ---- K1: the kind is Copy by the structure; a value used twice is copied ----

pub fn dup_it(g: G13[F32]) -> (G13[F32], G13[F32]) { (g, g) }

pub fn dup_in_a_branch(c: Bool, g: G13[F32]) -> (G13[F32], G13[F32]) { if c { (g, g) } else { (g, g) } }

pub fn dup_into_a_field(g: G13[F32]) -> Pair2 { Pair2 { a: g, b: g } }

pub struct Pair2 {
  a: G13[F32],
  b: G13[F32],
}

pub fn dup_through_a_binding(g: G13[F32]) -> (G13[F32], G13[F32]) {
  let a = g
  let b = g
  (a, b)
}

pub fn dup_with_a_move_head(move g: G13[F32]) -> (G13[F32], G13[F32]) {
  let a = move g
  let b = move g
  (a, b)
}

// ---- K2: Copy elements ----

pub struct HoldsBuf {
  a: Buf[G13[F32]],
}

pub fn need_copy[T: Copy](x: T) -> U32 { 0 }

pub fn pass_to_copy(g: G13[F32]) -> U32 { need_copy(g) }

pub fn repeat(g: G13[F32]) -> [G13[F32]; 3] { [g; 3] }

// ---- a Shared argument can be copied too ----

pub fn dup_shared_leaf(g: G13[Str]) -> (G13[Str], G13[Str]) { (g, g) }

pub struct SharedHolder {
  g: G13[F32],
  s: Str,
}

pub fn dup_shared_holder(h: SharedHolder) -> (SharedHolder, SharedHolder) { (h, h) }

// ---- forms of the argument ----

type Sc = F32

pub fn dup_alias_leaf(g: G13[Sc]) -> (G13[Sc], G13[Sc]) { (g, g) }

pub fn dup_open_copy[T: Copy](g: G13[T]) -> (G13[T], G13[T]) { (g, g) }

pub fn dup_open_plain[T](g: G13[T]) -> (G13[T], G13[T]) { (g, g) }

pub fn call_open(g: G13[F32]) -> (G13[F32], G13[F32]) { dup_open_copy(g) }

// ---- a capture of a Copy value ----

pub fn apply(f: fn(U32) -> U32) -> U32 { f.(1) }

pub fn pick(a: G13[F32], b: G13[F32]) -> U32 { 0 }

pub fn capture(g: G13[F32]) -> U32 { apply(fn(x: U32) -> U32 { pick(g, g) + x }) }

pub struct M0[T: ?Dup] {
  v: T,
}

pub struct M1[T: ?Dup] {
  x: M0[(T, T)],
  y: M0[Option[T]],
}

pub struct M2[T: ?Dup] {
  x: M1[(T, T)],
  y: M1[Option[T]],
}

pub struct M3[T: ?Dup] {
  x: M2[(T, T)],
  y: M2[Option[T]],
}

pub struct M4[T: ?Dup] {
  x: M3[(T, T)],
  y: M3[Option[T]],
}

pub struct M5[T: ?Dup] {
  x: M4[(T, T)],
  y: M4[Option[T]],
}

pub struct M6[T: ?Dup] {
  x: M5[(T, T)],
  y: M5[Option[T]],
}

pub struct M7[T: ?Dup] {
  x: M6[(T, T)],
  y: M6[Option[T]],
}

pub struct M8[T: ?Dup] {
  x: M7[(T, T)],
  y: M7[Option[T]],
}

pub struct M9[T: ?Dup] {
  x: M8[(T, T)],
  y: M8[Option[T]],
}

pub struct M10[T: ?Dup] {
  x: M9[(T, T)],
  y: M9[Option[T]],
}

pub struct M11[T: ?Dup] {
  x: M10[(T, T)],
  y: M10[Option[T]],
}

pub struct M12[T: ?Dup] {
  x: M11[(T, T)],
  y: M11[Option[T]],
}

pub struct M13[T: ?Dup] {
  x: M12[(T, T)],
  y: M12[Option[T]],
}

// ---- K5: really Affine ----

pub struct HoldsBufToo {
  g: M13[F32],
  b: Buf[F32],
}

pub fn dup_struct_with_buf(h: HoldsBufToo) -> (HoldsBufToo, HoldsBufToo) { (h, h) }   //~ E0711

pub fn dup_buf_leaf(g: M13[Buf[F32]]) -> (M13[Buf[F32]], M13[Buf[F32]]) { (g, g) }   //~ E0711

type Samples = Buf[F32]

pub fn dup_alias_buf_leaf(g: M13[Samples]) -> (M13[Samples], M13[Samples]) { (g, g) }   //~ E0711

pub fn dup_maybe_dup[T: ?Dup](g: M13[T]) -> (M13[T], M13[T]) { (g, g) }   //~ E0711

pub fn move_twice(move g: M13[Buf[F32]]) -> (M13[Buf[F32]], M13[Buf[F32]]) {
  let a = move g
  let b = move g   //~ E0704
  (a, b)
}

pub fn run_fn(f: fn(U32) -> U32) -> U32 { f.(1) }

pub fn peek(a: M13[Buf[F32]]) -> U32 { 0 }

pub fn capture_buf_leaf(g: M13[Buf[F32]]) -> U32 { run_fn(fn(x: U32) -> U32 { peek(g) + x }) }   //~ E0712


// ---- a Copy argument or a Copy bound makes the chain Copy (the parameter of the declaration is not what decides) ----

pub fn dup_copy_arg_m(g: M13[F32]) -> (M13[F32], M13[F32]) { (g, g) }

pub fn dup_copy_bound_m[T: Copy](g: M13[T]) -> (M13[T], M13[T]) { (g, g) }

pub fn call_copy_bound_m(g: M13[F32]) -> (M13[F32], M13[F32]) { dup_copy_bound_m(g) }
