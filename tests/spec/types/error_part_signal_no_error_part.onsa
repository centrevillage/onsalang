// onsa.toml
// [test]
// spec = ["§18.1", "§11.3"]

// S-1067 (W6-04 U16), §18.1, §11.3: the value type of a signal is `Copy` (E0810). Only the code and the line are asked:
// the text of the message is not fixed. Without a part that was not read (unchanged).

pub struct E0 { s: Str }
pub flow f0(x: E0 at sample) -> F32 at sample { 0.0 }   //~ E0810
