// onsa.toml
// [test]
// mode = "parse"
// spec = ["§4.5", "§2.5"]

// Type arguments written in the length of an array type, and after the `+` of a constant expression
// (§4.5): `Rg::[F32, 4].CAP` is the associated constant of a type with its arguments, a form of the
// constant expressions (§4.5), so it is read wherever the length of an array type is read, in every
// place of a type: a parameter, a result, a field, a payload, an alias, a `const`, an annotation, a
// closure, a method, a flow, and inside another type. Which type is generic and what the arguments
// are belong to the later stages (W5-10), so no name here is looked up and the syntax stage
// reports nothing for any item. The file is read by the parser only (mode = "parse"). The same
// forms in a const argument wait for W5-24 (S-329), whose unit U6 brings their case back.
//
// The file is written the way `onsa fmt` writes it (spec/tools.md §3.2).

pub struct Rg[T, const N: U32] {
  d: [T; N],
}

impl[T, const N: U32] Rg[T, N] {
  pub const CAP: U32 = 4
}

pub fn as_a_parameter(a: [F32; Rg::[F32, 4].CAP]) -> U32 {
  1
}

pub fn as_a_result() -> [F32; Rg::[F32, 4].CAP] {
  [0.0; 4]
}

pub struct AsAField {
  a: [F32; Rg::[F32, 4].CAP],
}

pub enum AsAPayload {
  A([F32; Rg::[F32, 4].CAP]),
  B,
}

type AsAnAlias = [F32; Rg::[F32, 4].CAP]

pub const AS_A_CONST_TYPE: [F32; Rg::[F32, 4].CAP] = [0.0; 4]

pub fn as_an_annotation() -> U32 {
  let a: [F32; Rg::[F32, 4].CAP] = [0.0; 4]
  1
}

pub fn in_a_branch(c: Bool) -> U32 {
  if c {
    let a: [F32; Rg::[F32, 4].CAP] = [0.0; 4]
    1
  } else {
    2
  }
}

pub fn in_a_closure() -> U32 {
  let f = fn(a: [F32; Rg::[F32, 4].CAP]) -> U32 { 1 }
  1
}

pub fn in_a_generic_function[T](a: [T; Rg::[F32, 4].CAP]) -> U32 {
  1
}

pub struct Holder {
  n: U32,
}

impl Holder {
  pub fn in_a_method(self, a: [F32; Rg::[F32, 4].CAP]) -> U32 {
    1
  }
}

pub flow in_a_flow(x: [F32; Rg::[F32, 4].CAP] at sample) -> F32 at sample {
  0.0
}

pub fn in_a_type_argument(o: Option[[F32; Rg::[F32, 4].CAP]]) -> U32 {
  1
}

pub fn in_a_tuple(t: (U8, [F32; Rg::[F32, 4].CAP])) -> U8 {
  t.0
}

pub fn in_a_function_type(f: fn([F32; Rg::[F32, 4].CAP]) -> U8) -> U8 {
  1
}

pub fn in_an_outer_array(a: [[F32; Rg::[F32, 4].CAP]; 2]) -> U32 {
  1
}

pub fn with_an_array_in_the_list(a: [F32; Rg::[[F32; 2], 4].CAP]) -> U32 {
  1
}

pub fn with_a_type_in_the_list(a: [F32; Rg::[Option[F32], 4].CAP]) -> U32 {
  1
}

pub fn with_three_elements(a: [F32; Rg::[F32, 4, 2].CAP]) -> U32 {
  1
}

pub fn after_an_arithmetic_operator(a: [F32; 2 + Rg::[F32, 4].CAP]) -> U32 {
  1
}

pub fn before_an_arithmetic_operator(a: [F32; Rg::[F32, 4].CAP * 2]) -> U32 {
  1
}

pub fn of_a_qualified_name(a: [F32; m.Rg::[F32, 4].CAP]) -> U32 {
  1
}

pub fn fine(a: [F32; 4]) -> U32 {
  1
}

pub struct Ring[T, const N: U32] {
  d: [T; N],
}

pub fn after_an_operator(r: Ring[F32, 2 + Rg::[F32, 4].CAP]) -> U32 {
  1
}
