// onsa.toml
// [test]
// fixes = 1
// spec = ["§2.6", "§4.5", "§6.1", "§15.1", "§18.1"]

// S-239, S-811 (W5-10 U2a): a function that is an item is called with `(`, not with `.(` (§6.1: "`inc.(1)` の `inc` が項目なら修正候補は `inc(1)`"), and the
// list written after the name does not change that: `id::[F32].(x)` is E0020 of the names stage, with the one candidate that replaces `.(` by `(`
// (S-811: "書いた印を呼び先の種類の印に置き換える一つの編集 … 当てた後に同じ段か前の段の誤りが残らないときだけ示す"; the list is right, so the call after it has no error).
// A function, a function with two parameters, and an associated function with the list of the function. The value of the function is called with `.(`
// after a value is made of it (type_args_fn_value.onsa). One error per item (P-01).

pub fn id[T](x: T) -> T {
  x
}

pub fn first[A, B](a: A, b: B) -> A {
  a
}

pub struct W[T] {
  v: T,
}

impl[T] W[T] {
  pub fn mk2[U](v: T, u: U) -> (W[T], U) {
    (W { v: v }, u)
  }
}

pub fn on_a_function(x: F32) -> F32 {
  id::[F32](x)                                     //~ E0020
}

pub fn on_a_function_of_two(x: F32) -> F32 {
  first::[F32, U8](x, 1)                           //~ E0020
}

pub fn on_an_associated_function(x: F32) -> F32 {
  let r = W::[F32].mk2::[U8](x, 1)                 //~ E0020
  r.0.v
}
