// onsa.toml
// [test]
// mode = "test"
// spec = ["§4.5", "§4.7"]

// S-239 (W5-10 U2a): the type arguments of a generic function are written after the name of the function (§4.5:
// "式の中では、型引数を総称の項目の名前の後に `::[…]` で書く（`parse::[U32]("1")`）"; "関数（`parse::[U32]("1")`。…）"). The type
// parameters of the call are decided by that statement (§4.5: "型引数を書いた呼び出しの型パラメータは、その文で決まる"), so a method
// that needs the type of the receiver (§4.7: "型の頭が決まっていなければ E0420") is called on the result in the next statement
// without an annotation: `checked_add(100)` of a `U8` that holds 200 is `None`, of an `I32` it is `Some(300)`. The list gives the
// parameters in the order of the declaration; a parameter that only the result has (`zero`, `none_of`) is decided by the list.
// The values are worked out by hand.

pub struct Pt {
  x: U8,
  y: U8,
}

impl Pt {
  pub fn lifted(self) -> U8 {
    id::[U8](self.x)
  }
}

pub fn id[T](x: T) -> T {
  x
}

pub fn first[A, B](a: A, b: B) -> A {
  a
}

pub fn second[A, B](a: A, b: B) -> B {
  b
}

pub fn zero[T: AnyNum]() -> T {
  T.ZERO
}

pub fn none_of[T]() -> Option[T] {
  None
}

pub fn take(x: U8) -> U8 {
  x
}

pub fn pass[T](x: T) -> T {
  id::[T](x)
}

pub fn pick(c: Bool) -> U8 {
  if c { id::[U8](200) } else { zero::[U8]() }
}

pub fn from_option(o: Option[U8]) -> U8 {
  match o {
    Some(v) => id::[U8](v),
    None => zero::[U8](),
  }
}

test "the type argument decides T before the next statement" {
  let k = id::[U8](200)
  assert k.checked_add(100) == None
  assert k.checked_add(50) == Some(250)
}

test "another type argument gives another type" {
  let k = id::[I32](200)
  assert k.checked_add(100) == Some(300)
}

test "two instantiations in one test do not mix" {
  let a = id::[U8](200)
  let b = id::[I32](200)
  assert a.checked_add(100) == None
  assert b.checked_add(100) == Some(300)
}

test "F32" {
  let f = id::[F32](1.5)
  assert f == 1.5
  assert f + 1.0 == 2.5
}

test "two type parameters, in the order of the declaration" {
  let a = first::[U8, F32](200, 2.5)
  let b = second::[U8, F32](200, 2.5)
  assert a.checked_add(100) == None
  assert b == 2.5
}

test "the order of the list is the order of the parameters" {
  let a = first::[F32, U8](2.5, 200)
  let b = second::[F32, U8](2.5, 200)
  assert a == 2.5
  assert b.checked_add(100) == None
}

test "a type parameter that only the result has" {
  let z = zero::[U8]()
  assert z.checked_sub(1) == None
  let i = zero::[I32]()
  assert i.checked_sub(1) == Some(-1)
  let f = zero::[F32]()
  assert f == 0.0
}

test "an Option that holds no value gets its T from the list" {
  let n = none_of::[U8]()
  let k = match n {
    Some(v) => v,
    None => 200,
  }
  assert k.checked_add(100) == None
}

test "the list and the annotation together" {
  let a: U8 = id::[U8](250)
  let b: Option[U8] = none_of::[U8]()
  let c: F32 = zero::[F32]()
  assert a.checked_add(10) == None
  assert b == None
  assert c == 0.0
}

test "a call in an argument and a call of the call" {
  assert take(id::[U8](9)) == 9
  assert id::[U8](id::[U8](7)) == 7
}

test "a type that is not a name" {
  let o = id::[Option[U8]](Some(200))
  let k = match o {
    Some(v) => v,
    None => 0,
  }
  assert k.checked_add(100) == None
  let t = id::[(U8, F32)]((200, 2.5))
  assert t.1 == 2.5
  let a = id::[[U8; 2]]([200, 1])
  assert a[0].checked_add(100) == None
}

test "a chain on the result" {
  let p = Pt { x: 200, y: 1 }
  assert id::[Pt](p).x == 200
  assert id::[Pt](p).x.checked_add(100) == None
}

test "in the body of a method" {
  let p = Pt { x: 200, y: 1 }
  assert p.lifted() == 200
}

test "the list names a type parameter of the function that calls" {
  assert pass::[U8](3) == 3
  let k = pass::[U8](200)
  assert k.checked_add(100) == None
}

test "in the arms of an if and of a match" {
  assert pick(true) == 200
  assert pick(false) == 0
  assert from_option(Some(5)) == 5
  assert from_option(None) == 0
}
