// onsa.toml
// [test]
// spec = ["§4.5", "§11.1", "§15.1", "§18.1"]

// W5-13 U2b/t, S-989 (3), R-436: the names stage reads a constant expression only inside the grammar of a constant expression, so a form
// outside it is E0417 and nothing inside it is looked for: not a type in the signature of a function value (`(fn(a: Nope) { 1 })`, `(fn() -> Nope { 1 })`), not
// the annotation of a `let` in a block, not the type of an `as` (`(1 as Nope)`), not a name in a tuple (`(zz, 1)`) or in the callee and the
// arguments of a call (`K(1)`), not the flow called in a length (`lp~(1.0)`; §11.1: "定数式（§4.5）の中のこれらの形は、flow の中でも外でも、定数式でない形の
// E0417 である"). §4.5: "名前の段は、定数式の文法の中（名前の鎖とその `::[…]` の並び、括弧、前置の `-`、算術の演算子の被演算子）だけを読み、文法の外の形（呼び出しと
// 上の形）の中と文字列リテラルの穴は読まない。そのため、中の名前の誤り（E0302・E0308）、値を `(` で呼ぶ形の E0020（§15.1）、flow だけの構文の E0821（§11.1）より、形の
// E0417 が先である ... 定数式が型の中にあっても式の中にあっても同じである". The same form gives the same E0417 in every place where a constant expression is
// written: the parameter and the result of a function, an alias, the field of a struct, the type of a `const`, the annotation of a `let`, a const
// argument, the repeat `[e; N]` and the type of the input of a flow. The mark of a form of several lines is on the line where the form starts.
// The forms that other files already put in a place (the tuple and the call in the parameter, the result, the annotation and the repeat: const_grammar_names_unchanged.onsa,
// length_names_constant_called.onsa, kind_length_calls_and_methods.onsa, negative/e0417_flow_calls_in_const_exprs.onsa) are not repeated. These are the units that already
// pass before W5-13 U2b (a form is E0417 in the heading of an item and in the annotation of a `let` without being read there): they are in their own file so that a
// regression of them is not silenced with the units of const_forms_positions.onsa, which change. The last section is the other side: inside the grammar the names
// are read, so a name that is not found is E0302. One error per unit (§18.1).

pub struct Ring[T, const N: U32] {
  data: [T; N],
  head: U32,
}

pub struct Rg[T, const N: U32] {
  data: [T; N],
}

impl[T, const N: U32] Rg[T, N] {
  pub const CAP: U32 = N
}

const K: U32 = 4

pub flow lp(x: F32 at sample) -> F32 at sample {
  x
}

// ---- the type of a parameter ----

pub fn param_closure_argument(x: [F32; (fn(a: Nope) { 1 })]) -> F32 {   //~ E0417
  1.0
}

pub fn param_block_let(x: [F32; {   //~ E0417
    let x: Nope = 1
    x
  }]) -> F32 {
  1.0
}

pub fn param_cast(x: [F32; (1 as Nope)]) -> F32 {   //~ E0417
  1.0
}

pub fn param_closure_result(x: [F32; (fn() -> Nope { 1 })]) -> F32 {   //~ E0417
  1.0
}

// ---- the result type ----

pub fn result_closure_argument() -> [F32; (fn(a: Nope) { 1 })] {   //~ E0417
  [0.0; 4]
}

pub fn result_block_let() -> [F32; {   //~ E0417
    let x: Nope = 1
    x
  }] {
  [0.0; 4]
}

pub fn result_cast() -> [F32; (1 as Nope)] {   //~ E0417
  [0.0; 4]
}

// ---- an alias ----

type AliasClosureArgument = [F32; (fn(a: Nope) { 1 })]   //~ E0417

type AliasBlockLet = [F32; {   //~ E0417
    let x: Nope = 1
    x
  }]

type AliasCast = [F32; (1 as Nope)]   //~ E0417

type AliasClosureResult = [F32; (fn() -> Nope { 1 })]   //~ E0417

// ---- the field of a struct ----

pub struct FieldClosureArgument {
  a: [F32; (fn(a: Nope) { 1 })],   //~ E0417
}

pub struct FieldBlockLet {
  a: [F32; {   //~ E0417
    let x: Nope = 1
    x
  }],
}

pub struct FieldCast {
  a: [F32; (1 as Nope)],   //~ E0417
}

// ---- the type of a const ----

const CONST_TYPE_CLOSURE_ARGUMENT: [F32; (fn(a: Nope) { 1 })] = [0.0; 4]   //~ E0417

const CONST_TYPE_BLOCK_LET: [F32; {   //~ E0417
    let x: Nope = 1
    x
  }] = [0.0; 4]

const CONST_TYPE_CAST: [F32; (1 as Nope)] = [0.0; 4]   //~ E0417

// ---- the annotation of a let ----

pub fn annotation_closure_argument() -> F32 {
  let _: [F32; (fn(a: Nope) { 1 })] = [0.0; 4]   //~ E0417
  1.0
}

pub fn annotation_block_let() -> F32 {
  let _: [F32; {   //~ E0417
    let x: Nope = 1
    x
  }] = [0.0; 4]
  1.0
}

pub fn annotation_cast() -> F32 {
  let _: [F32; (1 as Nope)] = [0.0; 4]   //~ E0417
  1.0
}

// ---- a const argument ----

pub fn const_arg_closure_argument(r: Ring[F32, (fn(a: Nope) { 1 })]) -> U32 {   //~ E0417
  r.head
}

pub fn const_arg_block_let(r: Ring[F32, {   //~ E0417
    let x: Nope = 1
    x
  }]) -> U32 {
  r.head
}

pub fn const_arg_cast(r: Ring[F32, (1 as Nope)]) -> U32 {   //~ E0417
  r.head
}

// ---- the repeat [e; N] ----

// ---- the type of the input of a flow ----

pub flow flow_input_closure_argument(a: [F32; (fn(a: Nope) { 1 })] at sample) -> F32 at sample {   //~ E0417
  0.0
}

pub flow flow_input_block_let(a: [F32; {   //~ E0417
    let x: Nope = 1
    x
  }] at sample) -> F32 at sample {
  0.0
}

pub flow flow_input_cast(a: [F32; (1 as Nope)] at sample) -> F32 at sample {   //~ E0417
  0.0
}

// ---- inside the grammar the names are read: E0302 ----

type NameInParentheses = [F32; (Nope)]   //~ E0302

pub fn name_in_a_sum(x: [F32; Nope + 1]) -> F32 {   //~ E0302
  1.0
}

pub fn name_in_the_type_arguments_of_a_path(x: [F32; Rg::[F32, Nope].CAP]) -> F32 {   //~ E0302
  1.0
}

pub struct NameAloneInAField {
  a: [F32; Nope],   //~ E0302
}

// ---- Fine: the names of the grammar ----

pub fn constant_in_the_grammar(a: [F32; K], b: [F32; (K)], c: [F32; Rg::[F32, 4].CAP]) -> F32 {
  1.0
}
