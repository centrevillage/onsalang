// onsa.toml
// [test]
// spec = ["§18.1", "§4.6"]

// S-1067 (W6-04 U16), §18.1, §4.6: a type with a part that was not read (here the field `e: Buf[Str]`, an E0416) judges
// what the parts that were read decide. As `error_part_kind_shared_second_argument` with an enum that gives `S1` a
// `Bytes` (not `Copy`: E0416) and an `rt` function that takes the value to drop: the E0416 of the signature is the
// diagnostic of the unit, and the E0601 of the drop is of a later stage (§18.1: a unit that failed in the types stage is
// not checked for effects).

pub struct S0[T0: ?Dup, T1: Copy] { f0: Array[F32] }
pub struct S1[T0: Copy] { f0: (T0, Str), f2: S0[F32, S0[F32, F32]] }   //~ E0416
pub enum S2 { V0(S1[Bytes]) }   //~ E0416
pub rt fn p0_0(move x: S1[S1[I32]]) -> I32 { 0 }   //~ E0416
