// onsa.toml
// [test]
// spec = ["§4.5", "§8.1"]

// S-982 (W5-10 U2a): the number of the type arguments of an expression does not count the effect row variable (§4.5: "式の中の型引数の数に、効果行変数
// （§8.1）は数えない（`fn apply[T, e](f: fn(T) -> T uses {e}, x: T)` には `apply::[I32](inc, 1)` と書き、効果行は呼び出しから決まる）"). `apply` has the
// type parameter `T` and the effect row variable `e` (a name that does not start with a capital letter, §8.1), so its list has one element. The
// effect row is decided by the call: `inc` is pure, `bump` has `Alloc`, and the call has the effect row of `f`. The errors of the
// number are in type_args_fn_count.onsa. Only the check: the body calls a function value (`onsa test` stops at that with E0200, R-295).
// In this version the declaration of an effect row variable is E0200, at the name of the first variable of the list (§8.1, R-27 (3); the type stage), and the
// places that use such a declaration do not rely on an effect row that has a variable (§8.1): the calls here, with the list (`apply::[I32](inc, 1)`)
// and without it, are no E0401 and no E0406, and no diagnostic is expected on them. What stays is that the list has one element (S-982: the variable
// is not counted), which is no E0412 here. The part that has no function type with a row (the number) is in type_args_fn_effect_row_declared.onsa.

pub fn inc(x: I32) -> I32 {
  x + 1
}

pub fn bump(x: I32) -> I32 uses {Alloc} {
  x + 1
}

pub fn to_f(x: I32) -> F32 {
  F32.round_from(x)
}

pub fn apply[T, e](f: fn(T) -> T uses {e}, x: T) -> T uses {e} { //~ E0200 @17
  f.(x)
}

pub fn apply2[T, U, e](f: fn(T) -> U uses {e}, x: T) -> U uses {e} { //~ E0200 @21
  f.(x)
}

pub fn a_pure_function() -> I32 {
  apply::[I32](inc, 1)
}

pub fn a_function_with_alloc() -> I32 uses {Alloc} {
  apply::[I32](bump, 1)
}

pub fn two_type_parameters_and_a_row() -> F32 {
  apply2::[I32, F32](to_f, 1)
}

pub fn the_list_is_not_needed_for_the_row() -> I32 {
  apply(inc, 1)
}
