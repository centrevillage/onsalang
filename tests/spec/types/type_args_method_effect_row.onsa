// onsa.toml
// [test]
// spec = ["§4.5", "§8.1"]

// S-982 (W5-10 U2b): the number of the type arguments of an expression does not count the effect row variable (§4.5: "式の中の型引数の数に、効果行変数
// （§8.1）は数えない（`fn apply[T, e](f: fn(T) -> T uses {e}, x: T)` には `apply::[I32](inc, 1)` と書き、効果行は呼び出しから決まる）"), and the method is the
// same: `ap[T, e]` has the type parameter `T` and the effect row variable `e` (a name that does not start with a capital letter, §8.1), so its list
// has one element. The effect row is decided by the call: `inc` is pure, `bump` has `Alloc`, and the call has the effect row of `f`. No diagnostic.
// The errors of the number are in type_args_method_count.onsa. Only the check: the body calls a function value (`onsa test` stops at that with
// E0200, R-295). This case waits for W6-01 (R-27): a pure function given to a parameter `fn(T) -> T uses {e}` is E0401 today, with the list and
// without it (type_args_fn_effect_row.onsa is the same). The part that does not need that (the number) is in
// type_args_method_effect_row_declared.onsa.

pub struct V {
  n: I32,
}

pub fn inc(x: I32) -> I32 {
  x + 1
}

pub fn bump(x: I32) -> I32 uses {Alloc} {
  x + 1
}

pub fn to_f(x: I32) -> F32 {
  F32.round_from(x)
}

impl V {
  pub fn ap[T, e](self, f: fn(T) -> T uses {e}, x: T) -> T uses {e} {
    f.(x)
  }

  pub fn ap2[T, U, e](self, f: fn(T) -> U uses {e}, x: T) -> U uses {e} {
    f.(x)
  }
}

pub fn a_pure_function(v: V) -> I32 {
  v.ap::[I32](inc, 1)
}

pub fn a_function_with_alloc(v: V) -> I32 uses {Alloc} {
  v.ap::[I32](bump, 1)
}

pub fn two_type_parameters_and_a_row(v: V) -> F32 {
  v.ap2::[I32, F32](to_f, 1)
}

pub fn the_list_is_not_needed_for_the_row(v: V) -> I32 {
  v.ap(inc, 1)
}
