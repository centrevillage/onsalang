// onsa.toml
// [test]
// spec = ["§4.4", "§4.7", "§18.1"]
// fixes = 0

// S-264 (W5-16 U2), §4.4, §7: the type that passes the limit is made inside the arm of a branch (a nested block). The
// position is the expression that made it, in the `then` arm: `(t11, t11)` is 8191. The `else` arm makes `Some(t10)`,
// which is 2049 and right, and has no diagnostic.

pub fn branch(c: Bool) -> U32 {
  let t0: I32 = 0
  let t1 = (t0, t0)
  let t2 = (t1, t1)
  let t3 = (t2, t2)
  let t4 = (t3, t3)
  let t5 = (t4, t4)
  let t6 = (t5, t5)
  let t7 = (t6, t6)
  let t8 = (t7, t7)
  let t9 = (t8, t8)
  let t10 = (t9, t9)
  let t11 = (t10, t10)
  if c {
    let _ = (t11, t11)  //~ E0422
    1
  } else {
    let _ = Some(t10)
    2
  }
}
