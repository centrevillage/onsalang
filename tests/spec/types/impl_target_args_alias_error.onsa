// onsa.toml
// [test]
// spec = ["§6.2", "§18.1"]

// S-753 (W4-05 U3b, §6.2): "引数に書いた別名は、別名そのものが誤りの型でもパラメータでないので E0307 で、見つからない
// 名前の引数は判定しない（§18.1）". An alias is never a parameter of the `impl`, so the E0307 stays when the alias is
// fixed and is not a chain from its error; the alias keeps its own error in its own unit. A name not found, written
// right in the argument, may be a parameter misspelled, so it has its E0302 only. The members of an `impl` with an
// E0307 are not checked (§18.1): the `let z: Bool = 2` below has no E0401. The alias `Bare = W` leaves out the
// argument that `W` takes, which is the E0412 of the number of arguments (§4.5, S-103, W4-05 U4c), not E0302.

pub struct W[T] {
  v: T,
}

type NotFound = Nope                                //~ E0302

impl W[NotFound] {                                  //~ E0307
  pub fn a(self) -> I32 {
    let z: Bool = 2
    1
  }
}

type Cyc = Cyc                                      //~ E0311

impl W[Cyc] {                                       //~ E0307
  pub fn b(self) -> I32 { 1 }
}

type Bare = W                                       //~ E0412

impl W[Bare] {                                      //~ E0307
  pub fn c(self) -> I32 { 1 }
}

impl W[Missing] {                                   //~ E0302
  pub fn d(self) -> I32 { 1 }
}
