// onsa.toml
// [test]
// spec = ["§4.4", "§18.1"]

// The `...` is written at the end of a struct literal only (spec §4.4). In the arguments of a call, in an
// array and in a tuple it is not an expression, so it is the general E0002 (§18.1: a form that is not in
// the closed list of foreign forms is reported by the general rule). Each function is a unit.

pub fn in_a_call() -> U32 {
  take(1, ...)  //~ E0002
}

pub fn in_an_array() -> U32 {
  let a = [1, ...]  //~ E0002
  1
}

pub fn in_a_tuple() -> U32 {
  let t = (1, ...)  //~ E0002
  1
}
