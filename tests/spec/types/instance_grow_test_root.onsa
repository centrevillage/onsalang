// onsa.toml
// [package]
// name = "instance_grow_test_root"
// edition = "2026"
//
// [export]
// prefix = "igte_"
//
// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [test]
// spec = ["§4.4", "§4.5", "§18.1"]
// fixes = 0

// S-290 (W5-23 U2): a `test` is a root of the instantiation (§4.5: the counted items are the
// functions, the tests, ..), and the root does not depend on the command, so the build of the target
// reports the growth that only a `test` starts. The `test` is not run (the mode of this case is
// `check`).

fn g[T](x: T, n: U32) -> U32 {
  if n == 0 {
    return 0
  }
  g(Some(x), n - 1)  //~ E0422
}

test "only a test calls g" {
  assert g(1, 3) == 0
}

@export
pub fn anchor() -> U32 {
  1
}
