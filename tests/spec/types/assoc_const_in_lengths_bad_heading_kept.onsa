// onsa.toml
// [test]
// spec = ["§4.5", "§6.2", "§18.1"]

// S-304 (W5-16 U1c, §18.1): the members of an `impl` whose heading is wrong (E0412 the number of type arguments, E0307 a
// parameter that the target does not use, E0416 a requirement of the type) are names in the space of `.` of the type
// (§6.2), but they are not checked, and a read of such a constant by the name of the type in a constant expression has
// no diagnostic of its own: the parameters of the `impl` are not decided by the read (so no E0406, which the constants
// of a well-formed generic `impl` have, types/assoc_const_in_lengths_unresolved_independent.onsa), and no bound is
// checked. The one error is the heading's, as for a read in a value (types/assoc_const_bad_heading_kept.onsa). These pass
// today and stay so. One error per item (P-01).

pub struct P[T] {
  a: T,
}

impl[T, U] P[T] {   //~ E0307
  pub const R: U32 = 4
}

pub struct Q {
  x: I32,
}

impl[T] Q[T] {   //~ E0412
  pub const R: U32 = 4
}

pub struct Nb[T: Num] {
  a: T,
}

impl[T] Nb[T] {   //~ E0416
  pub const R: U32 = 4
}

pub struct Ring[T, const N: U32] {
  a: [T; N],
}

pub fn unused_parameter_in_an_argument(a: [F32; P.R]) -> F32 {
  0.0
}

pub fn unused_parameter_in_a_repeat() -> F32 {
  let a = [0.0; P.R]
  a[0]
}

pub fn wrong_count_in_a_return() -> [F32; Q.R] {
  [0.0; 4]
}

pub fn wrong_count_in_a_const_argument(r: Ring[F32, Q.R]) -> F32 {
  0.0
}

pub fn unmet_requirement_in_an_argument(a: [F32; Nb.R]) -> F32 {
  0.0
}
