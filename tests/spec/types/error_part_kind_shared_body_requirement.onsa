// onsa.toml
// [test]
// spec = ["§18.1", "§4.6"]

// S-1067 (W6-04 U16), §18.1, §4.6: a type with a part that was not read (here the field `e: Buf[Str]`, an E0416) judges
// what the parts that were read decide. `E1` has a `Str` (Shared), so it is not `Copy`: the requirement of a type
// parameter that a call gives (§4.5) and the annotation of a `let` in a body are E0416.

pub struct E1 { s: Str, e: Buf[Str] }   //~ E0416
pub fn mk[T: Copy](x: T) -> I32 { 0 }
pub fn f(x: E1) -> I32 { mk(x) }   //~ E0416
pub fn g(x: E1) -> I32 {
  let b: Buf[E1] = Buf.zeroed(2)   //~ E0416
  0
}
