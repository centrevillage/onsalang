// onsa.toml
// [test]
// spec = ["§4.5"]

// S-24: const generic arguments in type position (§4.5).
pub struct Ring[T, const N: U32] {
  data: [T; N],
  head: U32,
}

const TABLE_SIZE: U32 = 8

impl[T, const N: U32] Ring[T, N] {
  pub rt fn capacity(self) -> U32 { N }
}

pub fn make4() -> Ring[F32, 4] {
  Ring { data: [0.0; 4], head: 0 }
}

pub fn make_table() -> Ring[F32, TABLE_SIZE] {
  Ring { data: [0.0; 8], head: 0 }
}

pub fn use_it() -> U32 {
  let r = make4()
  r.capacity() + make_table().capacity()
}
