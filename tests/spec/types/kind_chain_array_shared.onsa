// onsa.toml
// [test]
// spec = ["§4.1", "§4.5", "§4.6", "§12.2"]
// mode = "check"

// S-782 (§4.6, §12.2): An `Array[T]` is Shared whatever its argument (§4.1), so a chain that ends in `S_0[T] { a: Array[T], n: U32 }` is Shared. A copy is right. The depth is 11, in a chain `G_k[T] { x: G_(k-1)[(T, T)], y: G_(k-1)[(T, U8)] }`; `mode = "check"` only.

pub struct S0[T] {
  a: Array[T],
  n: U32,
}

pub struct S1[T] {
  x: S0[(T, T)],
  y: S0[(T, U8)],
}

pub struct S2[T] {
  x: S1[(T, T)],
  y: S1[(T, U8)],
}

pub struct S3[T] {
  x: S2[(T, T)],
  y: S2[(T, U8)],
}

pub struct S4[T] {
  x: S3[(T, T)],
  y: S3[(T, U8)],
}

pub struct S5[T] {
  x: S4[(T, T)],
  y: S4[(T, U8)],
}

pub struct S6[T] {
  x: S5[(T, T)],
  y: S5[(T, U8)],
}

pub struct S7[T] {
  x: S6[(T, T)],
  y: S6[(T, U8)],
}

pub struct S8[T] {
  x: S7[(T, T)],
  y: S7[(T, U8)],
}

pub struct S9[T] {
  x: S8[(T, T)],
  y: S8[(T, U8)],
}

pub struct S10[T] {
  x: S9[(T, T)],
  y: S9[(T, U8)],
}

pub struct S11[T] {
  x: S10[(T, T)],
  y: S10[(T, U8)],
}

pub fn dup_it(g: S11[F32]) -> (S11[F32], S11[F32]) { (g, g) }

pub fn dup_str_arg(g: S11[Str]) -> (S11[Str], S11[Str]) { (g, g) }

pub fn dup_open_plain[T](g: S11[T]) -> (S11[T], S11[T]) { (g, g) }
