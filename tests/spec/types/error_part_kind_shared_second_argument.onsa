// onsa.toml
// [test]
// spec = ["§18.1", "§4.6"]

// S-1067 (W6-04 U16), §18.1, §4.6: a type with a part that was not read (here the field `e: Buf[Str]`, an E0416) judges
// what the parts that were read decide. `S1[T0: Copy]` has `f0: (T0, Str)` that is read (a `Str`) and `f2` that fails
// (`S0[F32, F32]` holds an `Array`, so it is not `Copy` for the `T1: Copy` of `S0`): `S1[I32]` is not `Copy`, so the
// argument of `S1[S1[I32]]` and the element of a `Buf[S1[I32]]` are E0416.

pub struct S0[T0: ?Dup, T1: Copy] { f0: Array[F32] }
pub struct S1[T0: Copy] { f0: (T0, Str), f2: S0[F32, S0[F32, F32]] }   //~ E0416
pub fn p0_0(x: S1[S1[I32]]) -> I32 { 0 }   //~ E0416
pub fn p0_1(x: Buf[S1[I32]]) -> I32 { 0 }   //~ E0416
