// onsa.toml
// [test]
// spec = ["§18.1", "§4.5"]

// S-1073 (W6-04 U16) (2), S-1066, §18.1: as `type_ring_first_error_other_field_users_ab` with `RB` written
// first: `RA.x`, `RB.a` and `RU` are an E0416, `RV` gives nothing.

pub struct RB { a: Buf[RA] }   //~ E0416
pub struct RA { x: Buf[Str], b: Buf[RB] }   //~ E0416
pub struct OC[T: Copy] { v: T }
pub struct RU { u: OC[RA] }   //~ E0416
pub struct RV { u: OC[RB] }
