// onsa.toml
// [test]
// fixes = 0
// spec = ["§4.5", "§4.7", "§6.6"]

// S-304 (W5-05 U2): the constant whose value does not depend on a type parameter of the `impl` is the same as one
// that does (§4.5: "値が型パラメータに依らなくても同じで、`impl[T] Rg[T] { const CAP: U32 = 4 }` の `Rg.CAP` は E0406
// である（`Rg::[F32].CAP` か、`type R = Rg[F32]` の `R.CAP` と書く）"). The type variables of the `impl` stay open at
// the end of the function whatever the value is (§4.7). These forms pass the check today and are E0406 from this
// work; the form that depends on a parameter is in types/assoc_const_unresolved_value.onsa. No candidate
// (`fixes = 0`). One error per function (P-01); a type with a different shape of the `impl` for each.

// A type parameter only, a literal value.
pub struct Rg[T] {
  x: T,
}

impl[T] Rg[T] {
  pub const CAP: U32 = 4
}

pub fn literal_value() -> U32 {
  Rg.CAP                                            //~ E0406
}

// A const parameter that the value does not read.
pub struct Fixed[T, const N: U32] {
  a: [T; N],
}

impl[T, const N: U32] Fixed[T, N] {
  pub const FOUR: U32 = 4
}

pub fn const_parameter_unread() -> U32 {
  Fixed.FOUR                                        //~ E0406
}

// A bound on the type parameter.
pub struct Bounded[T] {
  x: T,
}

impl[T: Copy] Bounded[T] {
  pub const GAIN: F32 = 0.5
}

pub fn bounded_parameter() -> F32 {
  Bounded.GAIN                                      //~ E0406
}

// A type of the value that is not a number (a `Bool`).
pub struct Flagged[T] {
  x: T,
}

impl[T] Flagged[T] {
  pub const ENABLED: Bool = true
}

pub fn bool_value() -> Bool {
  Flagged.ENABLED                                   //~ E0406
}

// Read in an expected type that agrees with the type of the value: it still decides nothing of the `impl`.
pub fn to_an_annotated_let() {
  let c: U32 = Rg.CAP                               //~ E0406
  let _ = c
}

// Read in the initializer of a constant.
pub const K: U32 = Rg.CAP                           //~ E0406

// Read inside an `impl` by the name of the type.
impl[T] Flagged[T] {
  pub fn own_flag(self) -> Bool {
    Flagged.ENABLED                                 //~ E0406
  }
}

// A generic function that has nothing to do with the parameters of the `impl`.
pub fn inside_a_generic_function[V](v: V) -> U32 {
  let _ = v
  Rg.CAP                                            //~ E0406
}
