// onsa.toml
// [test]
// spec = ["§18.1", "§11.6"]

// S-1068 (W6-04 U16), §18.1, §11.6: an E0416 of a boundary makes an error type of the field of a struct, the payload of
// a variant and the input of a flow (a field of the type that the flow generates). The input `p` of `fl` fails (the
// elements of an `Array` are `Dup`, a `Buf` is not), so the field of `fl.Params` is an error type and the types that
// hold `fl.Params` (which would be `Copy` with a good input) give nothing: one E0416.

pub flow fl(x: F32 at sample, p: Array[Buf[F32]] at block) -> F32 at sample { x }   //~ E0416
pub struct H { ps: Buf[fl.Params] }
pub struct H2 { ps: Array[fl.Params] }
