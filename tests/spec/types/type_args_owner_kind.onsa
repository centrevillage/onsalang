// onsa.toml
// [test]
// spec = ["§4.5", "§15.1", "§18.1"]

// S-239 (W5-10 U1a): the kind of an element (a type or a constant expression) is not the kind of the parameter in its place
// (§4.5: "要素の種類（型か定数式か）が宣言の位置と合わなければ、名前でない型の形と定数式（`Ring[F32, (F32, F32)]`、`Wrap[3]`）も
// E0308 である"; §15.1: "定数を型引数の位置に書く、型を const 引数の位置に書く"). The number of the elements is right in all of
// these (a wrong number is E0412). For an associated function, a constant, a struct literal and a variant. One error per item
// (P-01).

pub struct Wrap[T] {
  v: T,
}

impl[T] Wrap[T] {
  pub fn make(v: T) -> Wrap[T] {
    Wrap { v: v }
  }
}

pub struct Rg[T, const N: U32] {
  d: [T; N],
}

impl[T, const N: U32] Rg[T, N] {
  pub const CAP: U32 = N
}

pub struct Pr[T] {
  a: T,
}

pub enum E[T] {
  A(T),
  B,
}

const K: U32 = 4

pub fn an_integer_for_a_type() -> U8 {
  let _ = Wrap::[3].make(1)                         //~ E0308
  1
}

pub fn a_constant_for_a_type() -> U8 {
  let _ = Wrap::[K].make(1)                         //~ E0308
  1
}

pub fn an_expression_for_a_type() -> U8 {
  let _ = Wrap::[1 + 2].make(1)                     //~ E0308
  1
}

pub fn a_type_for_a_const_argument() -> U32 {
  Rg::[F32, U8].CAP                                 //~ E0308
}

pub fn a_tuple_for_a_const_argument() -> U32 {
  Rg::[F32, (F32, F32)].CAP                         //~ E0308
}

pub fn a_generic_type_for_a_const_argument() -> U32 {
  Rg::[F32, Option[U8]].CAP                         //~ E0308
}

pub fn an_integer_for_a_type_of_a_literal() -> U8 {
  let _ = Pr::[3] { a: 1 }                          //~ E0308
  1
}

pub fn a_constant_for_a_type_of_a_variant() -> U8 {
  let _ = E::[K].B                                  //~ E0308
  1
}
