// onsa.toml
// [test]
// mode = "test"
// spec = ["§4.5", "§6.6"]

// S-239 (W5-10 U2a): the const argument written after the name of a function is a constant expression with arithmetic (§4.5: "算術の演算子
// （`+ - * / %`）と前置の `-`、括弧からなる"). Kept apart from type_args_fn_const_run.onsa: this version stops every constant expression with an
// operator in a length or a const argument at E0200 ("expressions as array lengths", the same wait as types/array_length_operations_fine.onsa),
// so the cases that need only the list pass without this one. The values are worked out by hand.

pub const K: U32 = 8

pub fn count[const N: U32]() -> U32 {
  N
}

pub fn fill[const N: U32]() -> [F32; N] {
  [0.0; N]
}

test "addition" {
  assert count::[2 + 3]() == 5
}

test "a constant in arithmetic" {
  assert count::[K * 2]() == 16
  assert count::[K - 3]() == 5
  assert count::[K / 2]() == 4
  assert count::[K % 3]() == 2
}

test "parentheses" {
  assert count::[(1 + 2) * 3]() == 9
}

test "the array of a computed length equals the array of the value" {
  let a: [F32; 8] = fill::[K]()
  let b: [F32; 8] = fill::[4 + 4]()
  assert a.len() == b.len()
}
