// onsa.toml
// [test]
// spec = ["§4.4", "§4.6", "§5.2", "§10", "§12.2"]
// mode = "check"

// S-782 (§4.6: the kind of an `enum` is found from its payloads like a struct's; §12.2: the drop of what holds a `Str` or a `Buf` needs `Alloc`): a chain of enums whose bottom holds only `F32` is Copy (and with a `Str` Shared), so a value of it is copied where it is used twice, matched, repeated, and is an element of a `Buf`.
// The chain is `E_k[T] { A(E_(k-1)[(T, T)]), B(E_(k-1)[(T, U8)]) }` with `E_0[T] { V(T) }` (all declared `[T: ?Dup]`), at the depth 11. `mode = "check"` only.

pub enum E0[T: ?Dup] {
  V(T),
}

pub enum E1[T: ?Dup] {
  A(E0[(T, T)]),
  B(E0[(T, U8)]),
}

pub enum E2[T: ?Dup] {
  A(E1[(T, T)]),
  B(E1[(T, U8)]),
}

pub enum E3[T: ?Dup] {
  A(E2[(T, T)]),
  B(E2[(T, U8)]),
}

pub enum E4[T: ?Dup] {
  A(E3[(T, T)]),
  B(E3[(T, U8)]),
}

pub enum E5[T: ?Dup] {
  A(E4[(T, T)]),
  B(E4[(T, U8)]),
}

pub enum E6[T: ?Dup] {
  A(E5[(T, T)]),
  B(E5[(T, U8)]),
}

pub enum E7[T: ?Dup] {
  A(E6[(T, T)]),
  B(E6[(T, U8)]),
}

pub enum E8[T: ?Dup] {
  A(E7[(T, T)]),
  B(E7[(T, U8)]),
}

pub enum E9[T: ?Dup] {
  A(E8[(T, T)]),
  B(E8[(T, U8)]),
}

pub enum E10[T: ?Dup] {
  A(E9[(T, T)]),
  B(E9[(T, U8)]),
}

pub enum E11[T: ?Dup] {
  A(E10[(T, T)]),
  B(E10[(T, U8)]),
}

pub fn dup_it(g: E11[F32]) -> (E11[F32], E11[F32]) { (g, g) }

pub fn dup_in_a_branch(c: Bool, g: E11[F32]) -> (E11[F32], E11[F32]) { if c { (g, g) } else { (g, g) } }

pub fn dup_shared_leaf(g: E11[Str]) -> (E11[Str], E11[Str]) { (g, g) }

pub fn dup_open_copy[T: Copy](g: E11[T]) -> (E11[T], E11[T]) { (g, g) }

pub fn dup_into_a_match(g: E11[F32]) -> U32 { match g { E11.A(_) => 1, E11.B(_) => 2 } }

pub struct HoldsBuf {
  a: Buf[E11[F32]],
}

pub fn repeat(g: E11[F32]) -> [E11[F32]; 3] { [g; 3] }
