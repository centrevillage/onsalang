// onsa.toml
// [package]
// name = "instance_grow_mutual"
// edition = "2026"
//
// [export]
// prefix = "igm_"
//
// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [test]
// spec = ["§4.4", "§4.5", "§18.1"]
// fixes = 0

// S-290 (W5-23 U2): the growth is in a cycle of two functions: `a` passes its type on, `b` wraps it
// and calls `a`, so each round trip makes the type one level deeper. The call that wraps is in `b`
// (the call of `b` in `a` does not change the type), and that line is the position.

@export
pub fn root() -> U32 {
  a(1, 3)
}

fn a[T](x: T, n: U32) -> U32 {
  if n == 0 {
    return 0
  }
  b(x, n - 1)
}

fn b[T](x: T, n: U32) -> U32 {
  a(Some(x), n)  //~ E0422
}
