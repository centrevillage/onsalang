// onsa.toml
// [test]
// spec = ["§4.5", "§15.1", "§18.1"]

// S-862 K (W5-17, §4.5: "`[T: ?Escape]` と書いてこの要求を外す（Swift の `~Escapable` と同じ形）"; "`?` を付けられるのは `Dup` と `Escape` だけで、
// 他の境界（`?Copy`、`?Show`）に付けると E0416"): the bound `?Escape` of a type parameter is right, in whatever the list around it is (`?Escape`
// alone, after `?Dup`, before a trait, after a trait) and wherever the type parameter is (a function, a method of its own, a struct, an
// enum, an `impl`). The name is the prelude's (`Escape`, §15.1), so it is not the E0302 of a name that is not found. The version before
// W5-17 had the E0200 of these headings (the same headings were this file). The `?` on any other bound is still the E0416 of
// types/bounds_maybe_other.onsa (the units at the end). The type parameter is not used by a call in this file (the uses are in
// types/maybe_escape_items_fine.onsa and types/maybe_escape_bounds_fine.onsa). One error per item (P-01).

pub fn maybe_escape[T: ?Escape](x: T) -> U32 {
  0
}

pub fn maybe_dup_and_escape[T: ?Dup + ?Escape](x: T) -> U32 {
  0
}

pub fn escape_then_a_trait[T: ?Escape + Show](x: T) -> U32 {
  0
}

pub fn a_trait_then_escape[T: Show + ?Escape](x: T) -> U32 {
  0
}

pub fn the_second_parameter[T, U: ?Escape](x: T, y: U) -> U32 {
  0
}

pub struct Rack[T: ?Escape] {
  a: U32,
}

pub enum Shelf[T: ?Escape] {
  One(U32),
  Nothing,
}

pub struct Plain {
  n: U32,
}

impl Plain {
  pub fn method_escape[U: ?Escape](self, y: U) -> U32 {
    self.n
  }
}

pub struct Box2[T: ?Escape] {
  a: U32,
}

impl[T: ?Escape] Box2[T] {
  pub fn tag() -> U32 {
    7
  }
}

// ---------------------------------------------------------------- the ? on other bounds is the E0416

pub fn maybe_copy[T: ?Copy](x: T) -> U32 {   //~ E0416
  0
}

pub fn maybe_show[T: ?Show](x: T) -> U32 {   //~ E0416
  0
}

pub fn maybe_num[T: ?Num](x: T) -> U32 {   //~ E0416
  0
}

// -------------------------------------------------------------------------------- what is right

pub fn maybe_dup[T: ?Dup](x: T) -> U32 {
  0
}

pub fn maybe_dup_with_a_trait[T: ?Dup + Show](x: T) -> U32 {
  0
}
