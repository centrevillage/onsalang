// onsa.toml
// [test]
// spec = ["§18.1", "§11.6"]

// S-1068 (W6-04 U16), §18.1, §11.6: an E0416 of a boundary makes an error type of the field of a struct, the payload of
// a variant and the input of a flow (a field of the type that the flow generates). With a good input the same types are
// fine (no diagnostic).

pub flow fl(x: F32 at sample, p: F32 at block) -> F32 at sample { x }
pub struct H { ps: Buf[fl.Params] }
pub struct H2 { ps: Array[fl.Params] }
