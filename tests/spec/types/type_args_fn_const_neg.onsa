// onsa.toml
// [test]
// spec = ["§4.5", "§15.1", "§18.1"]

// S-239 (W5-10 U2a): the const argument written after the name of a function is a constant expression (§4.5: "配列の長さと const 引数は定数式で書く"). What
// is not one is E0417 (§4.5: "定数式でないもの（関数の呼び出し、ローカル変数など）を書くと、位置によらず E0417"; "比較・論理・ビットの演算子 … は中の型によらず E0417"):
// a local variable, an argument, a call, a comparison. What is not a number of the type of the parameter is E0401: a negative number (`U32` has no prefix
// `-`, §3.4, so `-1` and `-0` are E0401 in every place), a float literal, a bool literal (§4.5: "整数でないリテラル（`1.5`、`true`、`"s"`）も E0401"). The number of the candidates is not written.
// One error per item (P-01).

pub fn count[const N: U32]() -> U32 {
  N
}

pub fn four() -> U32 {
  4
}

pub fn a_local() -> U32 {
  let n: U32 = 4
  count::[n]()                                      //~ E0417
}

pub fn an_argument(n: U32) -> U32 {
  count::[n]()                                      //~ E0417
}

pub fn a_call() -> U32 {
  count::[four()]()                                 //~ E0417
}

pub fn a_comparison() -> U32 {
  count::[1 < 2]()                                  //~ E0417
}

pub fn a_negative_number() -> U32 {
  count::[-1]()                                     //~ E0401
}

pub fn a_negative_zero() -> U32 {
  count::[-0]()                                     //~ E0401
}

pub fn a_float() -> U32 {
  count::[1.5]()                                    //~ E0401
}

pub fn a_bool() -> U32 {
  count::[true]()                                   //~ E0401
}

pub fn fine() -> U32 {
  count::[4]()
}
