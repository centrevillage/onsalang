// onsa.toml
// [test]
// spec = ["§18.1", "§4.6"]

// S-1067 (W6-04 U16), §18.1, §4.6: a type with a part that was not read (here the field `e: Buf[Str]`, an E0416) judges
// what the parts that were read decide. What depends on the part that was not read is not judged: `E1` has a `Str` and
// no Affine part, so whether it is `Dup` is not decided by what was read (the part that was not read could be Affine):
// an `Array` element, a type parameter that is `Dup` by default, a function that copies a value of such a parameter and
// `[x; 2]` give nothing.

pub struct E1 { s: Str, e: Buf[Str] }   //~ E0416
pub struct U { u: Array[E1] }
pub struct W[T] { v: T }
pub struct U2 { u: W[E1] }
pub fn dup2[T](x: T) -> (T, T) { (x, x) }
pub fn use1(x: E1) -> (E1, E1) { dup2(x) }
pub fn c1(x: E1) -> [E1; 2] { [x; 2] }
