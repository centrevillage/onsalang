// onsa.toml
// [test]
// spec = ["§11.3", "§11.6", "§18.1"]

// An output with no `at` is E0810 at its type (§11.3, §11.6, S-119). The caller reads the output as
// a value of an error clock, so it gets no second error that a clock would have made (§18.1,
// S-1077). One error per flow, so each form of the caller is a flow of its own.

pub fn half(v: F32) -> F32 { v * 0.5 }
pub flow slow_in(c: F32 at block) -> F32 at sample { c }
pub flow bad(x: F32 at sample) -> F32 { x }                  //~ E0810

pub flow at_slower(x: F32 at sample) -> F32 at sample {
  let _ = bad~(x) at block
  x
}

pub flow non_rt_call(x: F32 at sample) -> F32 at sample {
  let _ = half(bad~(x))
  x
}

pub flow into_block_input(x: F32 at sample) -> F32 at sample {
  let _ = slow_in~(bad~(x))
  x
}

pub flow into_delay_init(x: F32 at sample) -> F32 at sample {
  let _ = prev~(x, bad~(x))
  x
}

pub flow into_delay_value(x: F32 at sample) -> F32 at sample {
  let _ = prev~(bad~(x))
  x
}

pub flow summed(x: F32 at sample) -> F32 at sample {
  let u = bad~(x) + x
  u
}
