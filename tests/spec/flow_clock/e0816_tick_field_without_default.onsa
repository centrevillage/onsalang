// onsa.toml
// [test]
// spec = ["§11.3", "§18.1"]

// W7-09 U2r2/t, S-1158 (c), S-1186 (#14) (spec §11.3): the field that a faster stage reads a value of a tick from starts at `T.default()` and is set back to it by `reset`, so "`T` が `Default` を満たさなければ、
// 速い段で読む式で E0816". The error is at the expression that reads it (the line of the read). The values that are read at a faster stage are a computed part of a tick (`(NoDef { f: a }) at sample`), a `let`
// of a tick read by its name, the value of a delay that has no name, and a `let` of a tick read at a faster tick that is not `sample` (`m at (sample / 2)`). `NoDef` is a struct with no `Default` (and Copy, as
// the field `F32` is); `prev~` is given its `init`, so it is not the E0816 of the delay (S-29). The values that no faster stage reads, and a value of the parameter kinds alone, need no `Default` (the cases
// tick_values_need_no_default.onsa). `x` is the `sample` input. One error per flow, so each form is a flow of its own.

pub struct NoDef {
  f: F32,
}

pub flow computed_part(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = prev~(p at (sample / 4))
  let r = (NoDef { f: a }) at sample //~ E0816
  x * r.f
}

pub flow let_read_by_its_name(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = prev~(p at (sample / 4))
  let m = NoDef { f: a }
  x * (m at sample).f //~ E0816
}

pub flow delay_value_read_by_its_name(p: NoDef at block, x: F32 at sample) -> F32 at sample {
  let g = prev~(p at (sample / 4), NoDef { f: 0.0 })
  x * (g at sample).f //~ E0816
}

pub flow delay_value_with_no_name(p: NoDef at block, x: F32 at sample) -> F32 at sample {
  x * (prev~(p at (sample / 4), NoDef { f: 0.0 }) at sample).f //~ E0816
}

pub flow let_read_at_a_faster_tick(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = prev~(p at (sample / 4))
  let m = NoDef { f: a }
  let r = (m at (sample / 2)).f //~ E0816
  x * (r at sample)
}
