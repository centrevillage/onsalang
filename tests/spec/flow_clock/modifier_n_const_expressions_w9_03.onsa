// onsa.toml
// [test]
// spec = ["§4.5", "§11.9", "§18.1"]

// The N of `.down~(N)` and `.up~(N)` is a constant expression (§4.5, S-1077), so it may be an arithmetic expression of constants
// (`.down~(K * 2)`): the value is the ratio (`K * 2` is 8) and it is checked as the N of a literal is (E0808 for a value that is not
// a power of two that is 2 or more). This version does not compute the value of a constant expression of a flow (E0200,
// `FlowConstExprs`, W9-03: flow_delay_const_expression_w9_03.onsa), so the cases wait for it. One error per flow.

const K: U32 = 4
const TWO: U32 = 2

pub flow lp(x: F32 at sample) -> F32 at sample {
  x * 0.5 + prev~(x) * 0.5
}

pub flow down_by_a_product(p: F32 at block) -> F32 at sample {
  lp~(p).down~(K * 2) at sample
}

pub flow down_by_a_product_is_not_a_power_of_two(p: F32 at block) -> F32 at sample {
  lp~(p).down~(K * TWO + TWO) at sample                     //~ E0808
}

pub flow up_by_a_difference_is_one(p: F32 at block) -> F32 at sample {
  lp~(p).up~(K - 3) at sample                               //~ E0808
}
