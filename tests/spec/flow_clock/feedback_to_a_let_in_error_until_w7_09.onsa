// onsa.toml
// [test]
// spec = ["§11.3", "§11.4", "§11.5", "§18.1"]

// `^name` reads the clock of its `let` (§11.3) as a name written above it does. When that `let` is
// a part in error (its clock comes from a check that failed, S-1133), the part that reads it gets no
// diagnostic (§18.1): the one reported is the error of the `let` itself, whichever comes first in
// the text. Pending until W7-09 (R-496): today the read through `^` takes the clock of the first
// stage of the walk and reports an error of its own.

pub fn slow(v: F32) -> F32 { v * 0.5 }
pub fn noisy(v: F32) -> F32 uses {Alloc} { v }

pub flow caret_to_a_call_not_rt(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(^b)
  let b = slow(p)                                              //~ E0815
  a + x
}

pub flow caret_inside_a_call_not_rt(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(slow(^b))
  let b = prev~(p * 2.0)                                       //~ E0813
  a + x
}

pub flow caret_to_a_call_with_effects(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(^b)
  let b = noisy(p)                                             //~ E0805
  a + x
}
