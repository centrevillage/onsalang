// onsa.toml
// [test]
// spec = ["§11.3", "§11.4", "§11.5", "§11.9", "§18.1"]

// W7-09 U4b/t, S-1133 (1), R-496 (spec §11.3: "`^名前` で読む `let` … のクロックは、読む側の式のクロックを決める"; §18.1: "読めなかった部分は誤りの型として扱い、それを使う側には診断を出さない";
// S-1133: "`^名前` の先の `let` が誤りの部分のときも同じで、読む側は診断を出さない"): `^b` reads the clock of its `let` as a name written above it does, so when the `let` `b` is a part in
// error, the part that reads it through `^` has no diagnostic of its own and the one reported is the error of `b`, which is below the reader in the text. These are the forms that this version
// reports as the spec says (the reader happens to have no clock error of its own on the clock of the first stage), so they stay when U4b gives the reader the clock of the error: the part in error
// is the first argument of a delay at `block` (E0813), a call of a fn that is not `rt` with a `block` value (E0815), a state in a branch (E0811), a ratio that two operands do not meet (E0815), and
// the N of a chain that is not a power of two (E0808); the loops are of one `let` and of two, with the error in either and with the `let` in error read by its name as well. The forms in which the
// reader reported an error of its own before U4b are in feedback_to_a_let_in_error_parts_quiet.onsa. One error per flow (P-01), so each form is a flow of its own, and the error is on the line of `b`.

pub fn slow(v: F32) -> F32 {
  v * 0.5
}

pub flow lp(x: F32 at sample) -> F32 at sample {
  x * 0.5 + prev~(x) * 0.5
}

// ---------------------------------------------------------------- the forms of the part in error

pub flow delay_of_a_block_value(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(^b)
  let b = prev~(p)                                             //~ E0813
  a + x
}

pub flow call_not_rt_in_a_sum_read_by_delay(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(^b + x)
  let b = slow(p)                                              //~ E0815
  a + x
}

pub flow state_in_a_branch(c: Bool at sample, x: F32 at sample) -> F32 at sample {
  let a = prev~(^b)
  let b = if c { lp~(x) } else { x }                           //~ E0811
  a + x
}

pub flow ratios_that_do_not_meet(lf: F32 at (sample / 4), x: F32 at sample) -> F32 at sample {
  let a = prev~(^b)
  let b = x + lf                                               //~ E0815
  a + x
}

pub flow n_of_a_chain_that_is_not_a_power_of_two(x: F32 at sample) -> F32 at sample {
  let a = prev~(^b)
  let b = lp~(x).down~(3)                                      //~ E0808
  a + x
}

// ---------------------------------------------------------------- the loops

// ---------------------------------------------------------------- the loops

pub flow loop_of_one_let_with_the_error_inside(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(^a + slow(p))                                  //~ E0815
  a + x
}

pub flow loop_of_two_lets_with_the_error_in_the_second(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(^b)
  let b = a + slow(p)                                          //~ E0815
  b
}

pub flow loop_of_two_lets_with_the_error_in_the_first(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(^b) + slow(p)                                  //~ E0815
  let b = a + x
  b
}

pub flow read_by_a_caret_and_by_the_name(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(^b)
  let b = prev~(p)                                             //~ E0813
  let c = a + b
  c + x
}
