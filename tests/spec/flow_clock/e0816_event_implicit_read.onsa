// onsa.toml
// [test]
// spec = ["§11.3", "§11.4", "§11.11", "§18.1"]

// W7-11 U1b/t, S-563, S-1158, S-1186 (spec §11.11: "最初のイベントの前は `T.default()`（`T` が `Default` を満たさなければ E0816）"; §11.3: "速い段で読む式で E0816。速い段で読まない刻みの値には要らない"; §11.4: "`init` を省略すると…`T` が `Default` を満たさなければ
// E0816"): an event value read at a periodic clock by its name (`m`, `m.pitch`, a `let`, the output, a condition of `when~`) needs `Default` for the time before the first event; `Mode` and `Note` have none. A part computed from the event
// alone is read in a field of its own type (event_implicit_read_accepted.onsa). `m.pitch` is a read of the name `m` (§11.3 "名前とそのフィールドを読むだけ"). One error per flow (P-01). `x` is a `sample` input, `l4` is `sample / 4`.

pub enum Mode {
  Off,
  On,
}

pub struct Note {
  pitch: F32,
  vel: F32,
}

pub rt fn pick(m: Mode, x: F32) -> F32 {
  match m {
    Mode.Off => 0.0,
    Mode.On => x,
  }
}

pub rt fn armed_on(m: Mode, a: Bool) -> Bool {
  match m {
    Mode.Off => false,
    Mode.On => a,
  }
}

pub flow lp(x: F32 at sample) -> F32 at sample {
  x * 0.5
}

pub flow modes(x: F32 at sample) -> Mode at event {
  if x > 0.5 { Some(Mode.On) } else { None }
}

// ---------------------------------------------------------------- the read of the name at a periodic clock

pub flow in_an_expression(m: Mode at event, x: F32 at sample) -> F32 at sample {
  pick(m, x)                                                  //~ E0816
}

pub flow in_a_let(m: Mode at event, x: F32 at sample) -> F32 at sample {
  let s = m at sample                                         //~ E0816
  pick(s, x)
}

pub flow in_a_when_condition(m: Mode at event, x: F32 at sample, a: Bool at sample) -> F32 at sample {
  lp~(x).when~(armed_on(m, a))                                //~ E0816
}

pub flow as_the_output(m: Note at event) -> Note at sample {
  m                                                           //~ E0816
}

pub flow the_event_of_a_call(x: F32 at sample) -> F32 at sample {
  pick(modes~(x), x)                                          //~ E0816
}

pub flow a_field_of_a_struct(m: Note at event) -> F32 at sample {
  m.pitch                                                     //~ E0816
}

pub flow at_a_slow_tick(m: Mode at event, l4: F32 at (sample / 4)) -> F32 at sample {
  pick(m, l4) at sample                                       //~ E0816
}

// ---------------------------------------------------------------- the delay of an event with no `init`

pub flow delay_of_an_event(m: Mode at event) -> Mode at event {
  Some(prev~(m))                                              //~ E0816
}

pub flow delay_of_a_struct_event(m: Note at event) -> Note at event {
  Some(delay~(m, 2))                                          //~ E0816
}
