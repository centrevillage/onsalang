// onsa.toml
// [test]
// spec = ["§4.5", "§11.3", "§11.4", "§18.1"]

// The clock `sample / N` of an expression in the clock checks (§11.3, S-1078, S-1077, S-1079): the values of the parameter
// kinds (a constant, `init`, `block`) take it with `at (sample / N)`, two values of one ratio mix (the same ratio written
// two ways is one clock, by the value of N), the parameter kinds mix with it freely, a tick value is read at a faster tick
// by `at` (`a at (sample / 2)` of a value of `sample / 4`) and at `sample` by its name, and a delay counts in the ticks of
// its first argument (§11.4). The ticks stand in a branch, a `par`, a loop and an argument. No diagnostic. Every tick value
// is read at the faster stage by its name: a computed part read there is the work of the field (S-1158, S-1196, U2r2).

const K: U32 = 4

pub flow lp(x: F32 at sample) -> F32 at sample {
  0.5 * (x + prev~(x))
}

pub rt fn half(v: F32) -> F32 {
  v * 0.5
}

pub flow bases(p: F32 at block, q: F32 at init, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let b = q at (sample / 4)
  let c = 2.0 at (sample / 4)
  x * (a at sample) + (b at sample) + (c at sample)
}

pub flow a_tick_read_at_a_faster_tick(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let b = a at (sample / 2)
  let c = a at (sample / 4)
  x * (b at sample) + (c at sample)
}

pub flow the_same_ratio_mixes(p: F32 at block, q: F32 at init, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let b = q at (sample / 4)
  let s = a + b
  let t = s * a + p + q + 1.0
  x * (t at sample)
}

pub flow the_same_ratio_by_value(p: F32 at block, q: F32 at init, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / K)
  let b = q at (sample / 4)
  let c = p at (sample / U32.BITS)
  let d = q at (sample / 32)
  let s = a + b
  let t = c * d
  x * (s at sample) + (t at sample)
}

pub flow delays_count_in_the_ticks_of_the_first_argument(p: F32 at block, q: F32 at init) -> F32 at sample {
  let lf = p at (sample / 4)
  let d1 = prev~(lf)
  let d2 = prev~(p at (sample / 32))
  let d3 = delay~(q at (sample / 4), 2)
  let d4 = vdelay~(lf, p, 8)
  let d5 = prev~(lf, q)
  (d1 at sample) + (d2 at sample) + (d3 at sample) + (d4 at sample) + (d5 at sample)
}

pub flow loops_of_a_tick(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let acc = prev~(^acc + a)
  let u = prev~(^v)
  let v = u + a
  (acc at sample) + (v at sample) + x
}

pub flow in_a_branch_a_match_and_a_par(p: F32 at block, n: U32 at block, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let b = prev~(a)
  let r = if a > b { a * 2.0 } else { b }
  let m = match n {
    0 => a,
    _ => r,
  }
  let ys = par i in 0 ..< 2 { x * (m at sample) * F32.round_from(i) }
  ys[0] + ys[1]
}

pub flow in_the_arguments_of_a_call(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let h = half(a)
  lp~(a at sample) + lp~(x) + (h at sample)
}
