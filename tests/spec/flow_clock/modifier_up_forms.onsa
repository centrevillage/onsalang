// onsa.toml
// [test]
// spec = ["§4.5", "§11.3", "§11.9", "§18.1"]

// The modifier `.up~(N)` after the call of an instance (§11.9, S-555, S-566, S-557): the call runs at N times the call position, and
// its output is a value at `sample * N` that only a conversion flow takes (an input `at (sample * N)`, which the body sees as an
// array `[F32; N]` with the last at `x[N - 1]`; a call side operation on it is an error for now). The ratios of a chain compose
// whatever the order (`.down~(2).up~(4)` and `.up~(4).down~(2)` are the same 2 times). The cases wait for the conversion flows
// (W7-09 U4a: the declaration `x: F32 at (sample * 2)` is read, so the value of the chain meets an input of its ratio). No diagnostic.

const TWO: U32 = 2

pub flow lp(x: F32 at sample) -> F32 at sample {
  x * 0.5 + prev~(x) * 0.5
}

flow fold2(x: F32 at (sample * 2)) -> F32 at sample {
  (x[0] + x[1]) * 0.5
}

pub flow up_by_a_literal(p: F32 at block) -> F32 at sample {
  fold2~(lp~(p).up~(2))
}

pub flow up_by_a_constant(p: F32 at block) -> F32 at sample {
  fold2~(lp~(p).up~(TWO))
}

pub flow down_then_up_is_two_times(p: F32 at block) -> F32 at sample {
  fold2~(lp~(p).down~(2).up~(4))
}

pub flow up_then_down_is_two_times(p: F32 at block) -> F32 at sample {
  fold2~(lp~(p).up~(4).down~(2))
}
