// onsa.toml
// [test]
// spec = ["§11.3", "§11.9", "§11.10", "§18.1"]

// W7-21 U1/t, S-1207, S-1214 (1), S-1209 (spec §11.9: "集める入力の型が `Default` を満たさなければ E0816"; §11.10: "`when~`・`reset_if~` はレートを変えない"): the chains whose E0816 is the same when each modifier
// wraps the whole of its left as one part (S-1207) as when the ratios of the chain are summed. The part with a fast port under `.down~` over `.down~` is gathered at each of the boundaries (a boundary after a `.down~`
// still has the port faster than its own `sample`) and dealt the same, so the one error of the input or of the output stays (S-1214 (1)). The `.when~` and `.reset_if~` of a chain are no boundary: they change no E0816
// of a chain of `.down~`, before or after it (a chain with `.up~` and one of them is the E0816 of a boundary that gathers or deals first; the E0816 of the output a `.when~` keeps while it is stopped is in when_condition_e0816.onsa, and that of the `.reset_if~` is the unit W7-10 U2b, so none is written here). The forms that were no error before are in
// e0816_block_chain_gather_deal.onsa. One error per flow, so each form is a flow of its own. `Char` is a scalar with no `Default` (§6.4). `b` is a `block` input, `c` is a `block` input of `Char`.

flow take_fast_char(v: Char at (sample * 4)) -> F32 at sample {
  if v[3] == 'a' { 1.0 } else { 0.0 }
}

flow take_fast_char2(v: Char at (sample * 2)) -> F32 at sample {
  if v[1] == 'a' { 1.0 } else { 0.0 }
}

flow make_fast_char(c: F32 at sample) -> Char at (sample * 2) {
  [if c > 0.0 { 'a' } else { 'b' }, 'c']
}

pub flow gather_of_a_fast_port_down_then_down(c: Char at block, x: F32 at sample) -> F32 at sample {
  x + (take_fast_char~(c).down~(2).down~(2) at sample) //~ E0816
}

pub flow deal_of_a_fast_output_down_then_down(p: F32 at block) -> Char at (sample / 2) {
  make_fast_char~(p).down~(2).down~(2) //~ E0816
}

pub flow when_after_a_gather(b: Bool at block, x: F32 at sample) -> F32 at sample {
  x + (take_fast_char2~('a').down~(2).when~(b) at sample) //~ E0816
}

pub flow when_before_a_gather(b: Bool at block, x: F32 at sample) -> F32 at sample {
  x + (take_fast_char2~('a').when~(b).down~(2) at sample) //~ E0816
}

pub flow reset_if_after_a_gather(b: Bool at block, x: F32 at sample) -> F32 at sample {
  x + (take_fast_char2~('a').down~(2).reset_if~(b) at sample) //~ E0816
}

pub flow reset_if_between_two_downs(b: Bool at block, x: F32 at sample) -> F32 at sample {
  x + (take_fast_char~('a').down~(2).reset_if~(b).down~(2) at sample) //~ E0816
}
