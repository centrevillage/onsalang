// onsa.toml
// [test]
// spec = ["§11.3", "§11.4", "§18.1"]
// fixes = 1
//
// [[test.fix]]
// at = "18:10"
// code = "E0813"
// candidate = 1
// clean = true

// The candidate of E0813 promotes the first argument and leaves the other arguments (§11.4, S-102):
// `delay~(1.0, 2)` becomes `delay~(1.0 at sample, 2)`: a literal is promoted as a name is, and the length stays (a call without it would be an error, which `clean` rules out).
// The unit is the only one of the file, so the file as a whole is without an error after the
// candidate (`clean`).

pub flow f(x: F32 at sample) -> F32 at sample {
  delay~(1.0 at sample, 2) + x                                       //~ E0813
}
