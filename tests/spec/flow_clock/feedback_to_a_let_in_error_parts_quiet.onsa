// onsa.toml
// [test]
// spec = ["§11.3", "§11.4", "§11.5", "§18.1"]

// W7-09 U4b/t, S-1133 (1), R-496 (spec §18.1: "読めなかった部分は誤りの型として扱い、それを使う側には診断を出さない"; §11.3: "`^名前` で読む `let` … のクロックは、読む側の式のクロックを決める"):
// more forms of feedback_to_a_let_in_error_quiet.onsa, which waited for the same work (R-496, U4b). `^b` is read by a delay while the `let` `b`, written below it, is a part in error (a call
// of a fn that is not `rt` with a `block` value, E0815; a call with effects, E0805), and the delay is the one of `delay~` and `vdelay~` as well as `prev~`, with the loop of the `let`s of two
// or three, and two readers of one `let`. Before U4b the walk read `^b` with the clock of the first stage (`block`) and the delay reported an E0813 of its own, which the spec does not ask for:
// `b` is a part in error, so only its error is reported. One error per flow (P-01), and the error is on the line of `b`.

pub fn slow(v: F32) -> F32 {
  v * 0.5
}

pub fn noisy(v: F32) -> F32 uses {Alloc} {
  v
}

pub flow call_with_effects_read_by_delay_n(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = delay~(^b, 2)
  let b = noisy(p)                                             //~ E0805
  a + x
}

pub flow call_with_effects_read_by_vdelay(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = vdelay~(^b, x, 8)
  let b = noisy(p)                                             //~ E0805
  a + x
}

pub flow call_not_rt_read_by_vdelay(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = vdelay~(^b, x, 8)
  let b = slow(p)                                              //~ E0815
  a + x
}

pub flow loop_through_a_let_between(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(^c)
  let b = a + x
  let c = slow(p)                                              //~ E0815
  b
}

pub flow loop_through_two_lets_between(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(^d)
  let b = a + x
  let c = b * 0.5
  let d = noisy(p)                                             //~ E0805
  c
}

pub flow two_readers_of_the_same_let(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(^b) + delay~(^b, 2)
  let b = slow(p)                                              //~ E0815
  a + x
}
