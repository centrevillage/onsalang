// onsa.toml
// [test]
// spec = ["§7", "§11.2", "§11.3", "§11.4", "§18.1"]

// The errors of the shape of a `let` pattern in a flow body (the tuple that does not fit, E0401, the
// struct pattern's fields, E0410, a pattern that can fail to match, E0502) and of the number of the
// arguments of a delay, an instance or `sample_rate()` (E0412) are errors of the type stage (§18.1,
// the table of the codes), so they are reported over an error of the flow check written before them
// in the same flow (E0813, E0815, E0810, E0805, E0807, E0808), whatever the positions. The flow
// check is made on a body that has its types and its patterns (§4.7).
//
// One error per flow, so each form is a flow of its own: the first line has the error of the flow
// stage, which is not reported, and the second the error of the shape, which is. The forms with the
// error of the length of a delay or of the bounds of a `par~` first (R-329)
// are in `flow_stage_order_type_before_flow_check.onsa`.

pub fn noisy(v: F32) -> F32 uses {Alloc} { v }
pub struct Pair { l: F32, r: F32 }
pub flow pass(c: F32 at block) -> F32 at sample { c }
pub flow lp(y: F32 at sample) -> F32 at sample { y }

// ---------------------------------------------------------------- the shape of a `let` pattern

pub flow clock_then_tuple_of_a_scalar(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(p)
  let (u, v) = x                                                 //~ E0401
  x
}

pub flow clock_then_tuple_of_the_wrong_size(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(p)
  let (u, v) = (x, x, x)                                         //~ E0401
  x
}

pub flow slower_then_tuple_of_a_scalar(x: F32 at sample) -> F32 at sample {
  let a = x at block
  let (u, v) = x                                                 //~ E0401
  x
}

pub flow clock_then_missing_field(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(p)
  let Pair { l: u } = Pair { l: x, r: x }                        //~ E0410
  x
}

pub flow clock_then_unknown_field(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(p)
  let Pair { l: u, r: v, q: w } = Pair { l: x, r: x }            //~ E0410
  x
}

pub flow instance_then_missing_field(x: F32 at sample) -> F32 at sample {
  let a = pass~(x)
  let Pair { l: u } = Pair { l: x, r: x }                        //~ E0410
  x
}

pub flow clock_then_refutable_let(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(p)
  let Some(v) = Some(x)                                          //~ E0502
  x
}

pub flow slower_then_refutable_let(x: F32 at sample) -> F32 at sample {
  let a = x at block
  let Some(v) = Some(x)                                          //~ E0502
  x
}

pub flow let_type_then_tuple_of_a_scalar(x: F32 at sample) -> F32 at sample {
  let s = "text"
  let (u, v) = x                                                 //~ E0401
  x
}

pub flow effect_then_tuple_of_a_scalar(x: F32 at sample) -> F32 at sample {
  let a = noisy(x)
  let (u, v) = x                                                 //~ E0401
  x
}

pub flow let_type_then_refutable_let(x: F32 at sample) -> F32 at sample {
  let s = "text"
  let Some(v) = Some(x)                                          //~ E0502
  x
}

// ---------------------------------------------------------------- the number of arguments

pub flow clock_then_prev_with_three_arguments(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(p)
  let b = prev~(x, 0.0, 1.0)                                     //~ E0412
  x
}

pub flow clock_then_prev_without_arguments(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(p)
  let b = prev~()                                                //~ E0412
  x
}

pub flow clock_then_delay_with_four_arguments(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(p)
  let b = delay~(x, 4, 0.0, 1.0)                                 //~ E0412
  x
}

pub flow clock_then_vdelay_with_two_arguments(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(p)
  let b = vdelay~(x, x)                                          //~ E0412
  x
}

pub flow clock_then_sample_rate_with_an_argument(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(p)
  let r = sample_rate(1.0)                                       //~ E0412
  x
}

pub flow clock_then_instance_with_two_arguments(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(p)
  let b = lp~(x, x)                                              //~ E0412
  x
}

pub flow slower_then_prev_with_three_arguments(x: F32 at sample) -> F32 at sample {
  let a = x at block
  let b = prev~(x, 0.0, 1.0)                                     //~ E0412
  x
}

pub flow instance_argument_then_instance_with_two_arguments(x: F32 at sample) -> F32 at sample {
  let a = pass~(x)
  let b = lp~(x, x)                                              //~ E0412
  x
}

pub flow clock_then_prev_with_three_arguments_in_a_par_body(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(p)
  let bs = par~ i in 0 ..< 2 { prev~(x, 0.0, 1.0) }              //~ E0412
  x
}

pub flow let_type_then_prev_with_three_arguments(x: F32 at sample) -> F32 at sample {
  let s = "text"
  let b = prev~(x, 0.0, 1.0)                                     //~ E0412
  x
}

pub flow effect_then_instance_with_two_arguments(x: F32 at sample) -> F32 at sample {
  let a = noisy(x)
  let b = lp~(x, x)                                              //~ E0412
  x
}

// ---------------------------------------------------------------- the error of the shape first

pub flow tuple_of_a_scalar_then_clock(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let (u, v) = x                                                 //~ E0401
  let a = prev~(p)
  x
}

pub flow prev_with_three_arguments_then_clock(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let b = prev~(x, 0.0, 1.0)                                     //~ E0412
  let a = prev~(p)
  x
}
