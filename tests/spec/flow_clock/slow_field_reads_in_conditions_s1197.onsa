// onsa.toml
// [test]
// spec = ["§11.3", "§11.9"]

// W7-11 U2c/t, S-1197 (spec §11.3: "条件の位置の中では…名前と、そのフィールド・組の要素の連なりを取り出すだけの式（括弧を通す）は、刻みで読んでも届いたときに読んでも同じ値で…panic しないので、書ける。
// フィールド・組の要素の読みは、条件によらず、守りを付けずに刻みごとに読む"): the field or the element of a name of the tick `sample / 4` (`s.vel at sample`, `t.0 at sample`, `n.a.vel at sample`, `(s).vel at sample`) is read where a condition of another clock selects it
// (a branch of an `if` on a `sample` or `block` condition, the right of `&&`, an arm and a guard of a `match`, a branch in the body of a `par~`): no E0815, as the read of the name itself (`lf at sample`, which is accepted). The type of the field
// is the type of the read, so `M` (no `Default`) needs none. `check` reads the file with no diagnostic. The values are in tests/spec/flow_semantics/slow_field_reads_s1197.onsa. The reads that are not accepted (an index) are in e0815_field_reads_computed_s1197.onsa.
// `a` is a value of `sample / 4` (a delay of a `block` value at that tick), `x` and `g` and `k` are `sample` inputs, `b` is `block`. The branch under an `init` condition is accepted now (slow_field_reads_accepted.onsa).

pub struct M {
  vel: F32,
  q: F32,
  on: Bool,
}

pub struct Nest {
  a: M,
  k: F32,
}

pub flow lp(x: F32 at sample) -> F32 at sample {
  x * 0.5
}

pub flow field_under_a_sample_condition(p: F32 at block, x: F32 at sample, g: Bool at sample) -> F32 at sample {
  let a = prev~(p at (sample / 4))
  let s = M { vel: a, q: 2.0, on: a > 0.5 }
  if g { s.vel at sample } else { x }
}

pub flow field_in_the_other_branch(p: F32 at block, x: F32 at sample, g: Bool at sample) -> F32 at sample {
  let a = prev~(p at (sample / 4))
  let s = M { vel: a, q: 2.0, on: a > 0.5 }
  if g { x } else { s.vel at sample }
}

pub flow element_of_a_tuple(p: F32 at block, x: F32 at sample, g: Bool at sample) -> F32 at sample {
  let a = prev~(p at (sample / 4))
  let t: (F32, F32) = (a, 2.0)
  if g { t.0 at sample } else { x }
}

pub flow nested_field(p: F32 at block, x: F32 at sample, g: Bool at sample) -> F32 at sample {
  let a = prev~(p at (sample / 4))
  let n = Nest { a: M { vel: a, q: 2.0, on: a > 0.5 }, k: 0.0 }
  if g { n.a.vel at sample } else { x }
}

pub flow field_in_parentheses(p: F32 at block, x: F32 at sample, g: Bool at sample) -> F32 at sample {
  let a = prev~(p at (sample / 4))
  let s = M { vel: a, q: 2.0, on: a > 0.5 }
  if g { (s).vel at sample } else { x }
}

pub flow field_with_the_at_outside(p: F32 at block, x: F32 at sample, g: Bool at sample) -> F32 at sample {
  let a = prev~(p at (sample / 4))
  let s = M { vel: a, q: 2.0, on: a > 0.5 }
  if g { (s.vel) at sample } else { x }
}

pub flow right_of_an_and(p: F32 at block, x: F32 at sample, g: Bool at sample) -> F32 at sample {
  let a = prev~(p at (sample / 4))
  let s = M { vel: a, q: 2.0, on: a > 0.5 }
  if g && (s.on at sample) { x } else { 0.0 }
}

pub flow arm_of_a_match(p: F32 at block, x: F32 at sample, k: U32 at sample) -> F32 at sample {
  let a = prev~(p at (sample / 4))
  let s = M { vel: a, q: 2.0, on: a > 0.5 }
  match k { 0 => s.vel at sample, _ => x }
}

pub flow guard_of_a_match(p: F32 at block, x: F32 at sample, k: U32 at sample) -> F32 at sample {
  let a = prev~(p at (sample / 4))
  let s = M { vel: a, q: 2.0, on: a > 0.5 }
  match k { 0 if (s.on at sample) => x, _ => 0.0 }
}

pub flow under_a_block_condition(p: F32 at block, x: F32 at sample, b: I32 at block) -> F32 at sample {
  let a = prev~(p at (sample / 4))
  let s = M { vel: a, q: 2.0, on: a > 0.5 }
  if b > 0 { s.vel at sample } else { x }
}

pub flow in_the_body_of_a_par(p: F32 at block, x: F32 at sample, g: Bool at sample) -> [F32; 2] at sample {
  let a = prev~(p at (sample / 4))
  let s = M { vel: a, q: 2.0, on: a > 0.5 }
  par~ i in 0 ..< 2 { lp~(if g { s.vel at sample } else { x }) }
}
