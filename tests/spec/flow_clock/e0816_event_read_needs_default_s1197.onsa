// onsa.toml
// [test]
// spec = ["§11.3", "§11.5", "§11.11", "§18.1"]

// W7-11 U2c/t, S-1197 (spec §11.3: "全体を速い段で読んでから取り出す `(m at sample).vel` は、`M` に `Default` が要り、`M.default().vel` で始まる"、"隠れたフィールドの型はその読み（連なりの全体）の型である…下の E0816 は読みの型で判定する"; §11.11: "最初のイベントの前は
// `T.default()`（`T` が `Default` を満たさなければ E0816。`m.vel` のようにフィールドを取り出す読みの `T` は、その読みの型である、§11.3）"): the event value is read as a whole at a periodic clock (`(m at sample).vel`, a `match m` whose arm has a periodic operand, an `at` on the name), so the
// field that keeps it is of the type of the whole, `M`, which has no `Default`, or the read of the element is of a type that has none (the element `Tag` of a tuple, a `let` of the field `m.tag`): E0816 at the line of the read. These are errors now and after S-1197
// (the read of a field of a type that has no `Default` out of a struct that has one is in e0816_event_field_read_type_s1197.onsa). One error per flow (P-01). `M` and `Tag` have no `Default`; `x` and `g` are `sample` inputs.

pub struct M {
  vel: F32,
  q: F32,
  on: Bool,
}

pub enum Tag {
  Off,
  On,
}

pub struct P {
  tag: Tag,
  vel: F32,
}

impl Default for P {
  rt fn default() -> P {
    P { tag: Tag.Off, vel: 0.0 }
  }
}

pub rt fn pick(t: Tag, x: F32) -> F32 {
  match t {
    Tag.Off => 0.0,
    Tag.On => x,
  }
}

// ---------------------------------------------------------------- the whole value is read at a periodic clock

pub flow field_of_the_whole_read(m: M at event, x: F32 at sample) -> F32 at sample {
  x + (m at sample).vel   //~ E0816
}

pub flow field_of_the_whole_read_under_a_condition(m: M at event, x: F32 at sample, g: Bool at sample) -> F32 at sample {
  if g { (m at sample).vel } else { x }   //~ E0816
}

pub flow whole_read_in_a_let(m: M at event, x: F32 at sample) -> F32 at sample {
  let w = m at sample   //~ E0816
  x + w.vel
}

pub flow match_with_a_periodic_arm(m: M at event, x: F32 at sample) -> F32 at sample {
  match m { M { vel: v, q: w, on: _ } => v + w + x }   //~ E0816
}

pub flow whole_read_in_a_par(m: M at event, x: F32 at sample) -> [F32; 2] at sample {
  par i in 0 ..< 2 { x + (m at sample).vel }   //~ E0816
}

// ---------------------------------------------------------------- the read is of a type that has no `Default`

pub flow element_of_a_tuple(m: (F32, Tag) at event, x: F32 at sample) -> F32 at sample {
  pick(m.1, x)   //~ E0816
}

pub flow field_moved_to_a_let(m: P at event, x: F32 at sample) -> F32 at sample {
  let t = m.tag
  pick(t, x)   //~ E0816
}

pub flow field_moved_to_a_let_under_a_condition(m: P at event, x: F32 at sample, g: Bool at sample) -> F32 at sample {
  let t = m.tag
  if g { pick(t, x) } else { x }   //~ E0816
}
