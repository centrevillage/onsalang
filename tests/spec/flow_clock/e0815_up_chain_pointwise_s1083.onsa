// onsa.toml
// [test]
// spec = ["§11.9", "§18.1"]

// W7-09 U3b/t, S-1083, provisional reading (1) (spec §11.9: "呼び出し側で `sample * N` の値に点ごとの演算をする形（`ovs2~(x) * d`）は当面は誤り（E0815）である"): an
// operation on the value of `.up~(N)` on the call side is E0815 although the other operand is a value of the parameter kinds or of its own ratio (the ordinary rule of §11.3 would read the first with
// the clock of the value and the second as its own). The open question is S-1083 (the code); drop this file if another is decided. The error is at the operation. One error per flow, so each form is a
// flow of its own, and a `let` that reads the error has no mark. `x` is the `sample` input, `p` and `d` are `block` inputs.

pub rt fn half(v: F32) -> F32 {
  v * 0.5
}

pub flow lp(x: F32 at sample) -> F32 at sample {
  x * 0.5 + prev~(x) * 0.5
}

pub flow times_a_constant(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let y = lp~(p).up~(2) * 0.5                                 //~ E0815
  x
}

pub flow times_a_block_value(p: F32 at block, d: F32 at block, x: F32 at sample) -> F32 at sample {
  let y = lp~(p).up~(2) * d                                   //~ E0815
  x
}

pub flow sum_of_two_values_of_its_ratio(p: F32 at block, q: F32 at block, x: F32 at sample) -> F32 at sample {
  let y = lp~(p).up~(2) + lp~(q).up~(2)                       //~ E0815
  x
}

pub flow negation(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let y = -lp~(p).up~(2)                                      //~ E0815
  x
}

pub flow comparison(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let y = lp~(p).up~(2) > 0.0                                 //~ E0815
  x
}

pub flow argument_of_a_function(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let y = half(lp~(p).up~(2))                                 //~ E0815
  x
}

pub flow by_its_name(p: F32 at block, d: F32 at block, x: F32 at sample) -> F32 at sample {
  let y = lp~(p).up~(2)
  let z = y * d                                               //~ E0815
  x
}
