// onsa.toml
// [test]
// spec = ["§11.3", "§11.4", "§11.5", "§18.1"]
//
// [[test.fix]]
// at = "71:9"
// code = "E0813"
// candidate = 1
// leaves = ["71:30 E0810"]

// W7-14 U6b/t, S-372, S-1133 (spec §18.1: of the errors left in a unit the first by position, the start and then the end; "読めなかった部分は誤りの型として扱い、それを使う側には診断を出さない"):
// the order of the E0810 of a function value (an expression of a flow body whose type holds a function type, §11.3) and the errors of the checks that read the clock around it.
// - The E0810 keeps the clock its rule gives, so the outer check is made, and the first by position is reported: the outer error that starts first (flow_fn_value_clock_forms.onsa), the E0810 of
//   the part that starts first (an operand before the other, an expression that starts where the outer one starts and ends before it: `mk(x).k at block` is the E0810 of `mk(x)`, not the E0815 of
//   the `at` that is longer).
// - The checks that do not hold the clock of an expression whose rule failed (S-1133, §11.5): a call of a function with effects (E0805), of a function that is not `rt` with a faster
//   argument (E0815), and a delay whose first argument is slower than `sample` (E0813) give the error clock, so the `at` outside them says nothing and the E0810 of the operand before them is the
//   first and only error. The E0810 of a function value is not one of them.
// One error per flow (§18.1), so each form is a flow of its own and the marker is on its line.

pub rt fn dbl(x: F32) -> F32 {
  x * 2.0
}

const F: rt fn(F32) -> F32 = dbl

pub struct Pt {
  cb: rt fn(F32) -> F32,
  k: F32,
}

const KS: Pt = Pt { cb: dbl, k: 1.0 }

pub rt fn mk(g: F32) -> Pt {
  Pt { cb: dbl, k: g }
}

pub rt fn apply(f: rt fn(F32) -> F32, x: F32) -> F32 {
  f.(x)
}

pub fn slow(v: F32) -> F32 {
  v * 0.5
}

pub fn noisy(v: F32) -> F32 uses {Alloc} {
  v
}

// ---------------------------------------------------------------- the E0810 starts first

pub flow field_of_a_call_under_at_that_starts_at_the_call(x: F32 at sample) -> F32 at sample {
  mk(x).k at block                                  //~ E0810 @3
}

pub flow function_value_before_a_delay_error(x: F32 at sample, p: F32 at block) -> F32 at sample {
  KS.k * x + prev~(p)                               //~ E0810 @3
}

pub flow function_value_before_a_slower_input(x: F32 at sample) -> F32 at sample {
  apply(F, x) + slow(x)                             //~ E0810 @9
}

// ---------------------------------------------------------------- the other error starts first

pub flow slower_input_before_a_function_value(x: F32 at sample) -> F32 at sample {
  slow(x) + apply(F, x)                             //~ E0815 @3
}

pub flow delay_error_before_a_function_value(x: F32 at sample, p: F32 at block) -> F32 at sample {
  prev~(p) + apply(F, x)                            //~ E0813 @9
}

// ---------------------------------------------------------------- the function value before an expression of the error clock: the `at` outside says nothing

pub flow effect_in_the_sum_under_at(x: F32 at sample) -> F32 at sample {
  (apply(F, x) + noisy(x)) at block                 //~ E0810 @10
}

pub flow slower_input_in_the_sum_under_at(x: F32 at sample) -> F32 at sample {
  (apply(F, x) + slow(x)) at block                  //~ E0810 @10
}

pub flow delay_error_in_the_sum_under_at(x: F32 at sample, p: F32 at block) -> F32 at sample {
  (apply(F, x) + prev~(p)) at block                 //~ E0810 @10
}

// The same sums without the expression of the error clock: the `at` is the error, and it starts first.
pub flow sum_under_at_without_the_error_clock(x: F32 at sample) -> F32 at sample {
  (apply(F, x) + x) at block                        //~ E0815
}

// ---------------------------------------------------------------- the effect first, the function value in it

pub flow effect_over_a_function_value(x: F32 at sample) -> F32 at sample {
  noisy(apply(F, x))                                //~ E0805
}

// ---------------------------------------------------------------- the same value through a let

// The let `q` holds the function value and is at the clock of its value (`block`), so a delay of `q` below it is the second error: the E0810 is on the line of `q`.
pub flow let_then_a_delay_of_it(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let q = apply(F, p)                               //~ E0810
  prev~(q) + x
}

pub flow let_then_an_at_of_it(x: F32 at sample) -> F32 at sample {
  let q = apply(F, x)                               //~ E0810
  q at block
}
