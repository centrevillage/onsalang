// onsa.toml
// [test]
// spec = ["§11.3", "§11.6", "§15.1", "§18.1"]

// A flow of another module whose output clock is an error (the declaration is in util.onsa, the error
// is reported there) is read by its callers as a value of an error clock, through `use` and through
// the qualified name alike: the callers get no second error that a clock would have made (§18.1,
// S-1077). One error per flow, so each form of the caller is a flow of its own. The clock of an
// output that is fine is the declared one, so `at block` on it is still E0815.

use util
use util.{unknown_clock}

pub fn half(v: F32) -> F32 { v * 0.5 }
pub flow slow_in(c: F32 at block) -> F32 at sample { c }

pub flow at_slower_qualified(x: F32 at sample) -> F32 at sample {
  let a = util.unknown_clock~(x) at block
  x
}

pub flow at_slower_imported(x: F32 at sample) -> F32 at sample {
  let a = unknown_clock~(x) at block
  x
}

pub flow block_output_at_slower(x: F32 at sample) -> F32 at sample {
  let a = util.block_output~(x) at block
  x
}

pub flow no_clock_output_at_slower(x: F32 at sample) -> F32 at sample {
  let a = util.no_clock_output~(x) at block
  x
}

pub flow non_rt_call(x: F32 at sample) -> F32 at sample {
  let b = half(util.unknown_clock~(x))
  x
}

pub flow into_block_input(x: F32 at sample) -> F32 at sample {
  let c = slow_in~(util.block_output~(x))
  x
}

pub flow into_delay_init(x: F32 at sample) -> F32 at sample {
  let d = prev~(x, util.no_clock_output~(x))
  x
}

pub flow into_delay_value(x: F32 at sample) -> F32 at sample {
  let e = prev~(util.unknown_clock~(x))
  x
}

pub flow summed(x: F32 at sample) -> F32 at sample {
  util.unknown_clock~(x) + x
}

pub flow fine_output_at_slower(x: F32 at sample) -> F32 at sample {
  let a = util.fine~(x) at block                                 //~ E0815
  x
}
