// onsa.toml
// [test]
// spec = ["§11.3", "§11.9", "§18.1"]

// W7-09 U4a/t, W7-21 U1/t (the chain with `.up~` read at `sample`, and the chain `.down~(2).up~(2)`), S-578, S-1186 (1a), S-1203 (provisional reading (1)), S-1207, S-1214, S-1185 (spec §11.9: "配る型が `Default` を満たさなければ、集める入力の型と同じく、その呼び出しで E0816 である（§11.3 の刻みのフィールドと同じく、
// `reset_if~` が付くかに依らない）"; §11.3: "刻みで書いて速い段で読むフィールド…の初めの値と…戻り先は `T.default()` である（`T` が `Default` を満たさなければ、速い段で読む式で E0816。速い段で読まない刻みの値には
// 要らない）"): a conversion flow that `.down~(N)` runs deals an output at `sample * N` out of an array that starts at `T.default()`, so the type of the output needs `Default`; the E0816 is at the call, with
// its chain (the value that becomes a value of the caller's `sample`), S-1203 (1) (an open point: the other readings put it at the call of the flow only, or at the whole chain for both). `NoDef` is a struct with no
// `Default` (and Copy, as the field `F32` is, as in e0816_tick_field_without_default.onsa). The gather is in e0816_conversion_flow_gather_char.onsa. A chain with `.up~` is read in blocks (S-1207, S-1214): the `.down~` of `.up~(4).down~(8)` wraps the part that `.up~(4)` made, whose output is at `sample * 4`, so it deals it, and the error is at the whole chain, as for a
// deal of one step (the gathers and the deals of the chains with `.up~` are in e0816_block_chain_gather_deal.onsa). The values that need no `Default`: the value of a gather whose type has no `Default` that no faster stage
// reads (the part of it that a faster stage reads is of a type that has it), a chain `.down~(2).up~(2)` of the ratio one (no boundary of it gathers or deals), and an output at `sample / N` of a type with no `Default` (the root
// of an output at `sample / N` is the tick of the output: its computed part is no field). One error per flow, so each form is a flow of its own. `x` is the `sample` input, `p` is a `block` input.

pub struct NoDef {
  f: F32,
}

flow mk(c: F32 at sample) -> NoDef at sample {
  NoDef { f: c }
}

flow give_four(c: F32 at sample) -> NoDef at (sample * 4) {
  let v = NoDef { f: c }
  [v, v, v, v]
}

flow make_from_four(x: F32 at (sample * 4)) -> NoDef at sample {
  NoDef { f: x[3] }
}

// ---------------------------------------------------------------- the deal: an output at `sample * N` of a type with no `Default`

pub flow deal_a_nodef(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let r = give_four~(p).down~(4)                            //~ E0816
  x * r.f
}

pub flow deal_a_nodef_as_the_output(p: F32 at block) -> NoDef at sample {
  give_four~(p).down~(4)                                    //~ E0816
}

pub flow deal_a_nodef_of_a_slow_value(lf: F32 at (sample / 4), x: F32 at sample) -> F32 at sample {
  x * give_four~(lf).down~(4).f                             //~ E0816
}

// ---------------------------------------------------------------- a chain with `.up~`: the `.down~` over it deals the output that `.up~` made faster

// This one has two reasons for the error, the deal and the read of its tick at `sample` (§11.3), at the same line.

pub flow up_down_chain_read_at_sample(p: F32 at block, x: F32 at sample) -> F32 at sample {
  x * (mk~(p).up~(4).down~(8) at sample).f                  //~ E0816
}

// ---------------------------------------------------------------- the values that need no `Default`

pub flow down_up_chain_of_the_ratio_one(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let r = mk~(p).down~(2).up~(2)
  x * r.f
}

pub flow gather_of_a_float(x: F32 at sample) -> F32 at sample {
  let m = make_from_four~(x).down~(4)
  x * ((m.f * 2.0) at sample)
}

pub flow gather_that_makes_a_nodef_read_at_its_tick(x: F32 at sample) -> F32 at sample {
  let m = make_from_four~(x).down~(4)
  let n = m.f * 2.0
  x * (n at sample)
}

pub flow slow_nodef_output_of_a_literal(lf: F32 at (sample / 4)) -> NoDef at (sample / 4) {
  NoDef { f: lf * 2.0 }
}

pub flow slow_nodef_output_of_a_let(lf: F32 at (sample / 4)) -> NoDef at (sample / 4) {
  let m = NoDef { f: lf }
  m
}
