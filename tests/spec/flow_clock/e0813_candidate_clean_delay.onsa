// onsa.toml
// [test]
// spec = ["§11.3", "§11.4", "§18.1"]
// fixes = 1
//
// [[test.fix]]
// at = "18:10"
// code = "E0813"
// candidate = 1
// clean = true

// The candidate of E0813 promotes the first argument and leaves the other arguments (§11.4, S-102):
// `delay~(p, 4, 0.5)` becomes `delay~(p at sample, 4, 0.5)`: the length stays (`delay~(p at sample)` without it would be an error, which `clean` rules out).
// The unit is the only one of the file, so the file as a whole is without an error after the
// candidate (`clean`).

pub flow f(x: F32 at sample, p: F32 at block) -> F32 at sample {
  delay~(p, 4, 0.5) + x                                       //~ E0813
}
