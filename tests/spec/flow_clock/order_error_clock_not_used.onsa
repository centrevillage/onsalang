// A part that could not be read is an error and the part that uses it gets no diagnostic of its own
// (§18.1): the result of a delay whose first argument is not at a clock of ticks (E0813) has
// the clock of an error (the clock of a stateful part in a branch, E0811 since W7-06 U1, is a gap that the spec does not close, and is not in this file, nor is the clock of an E0812 `if~` / `match~`, S-1192). The check
// that would read that clock (an `at` that makes it slower, a delay that needs its first argument at
// `sample`, an input of an instance that is at `block`) does not report even where it starts before
// the error; only the error is reported, though by its position the outer one is first. The other
// order of the flow check is the order of the position, left to right. One error per flow.

pub flow gate(x: F32 at sample, k: F32 at block) -> F32 at sample { x * k }
pub fn noisy(v: F32) -> F32 uses {Alloc} { v }

// ---------------------------------------------------------------- the result of a delay in error

pub flow at_promotion_of_the_result(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = (prev~(p) + 1.0) at sample                             //~ E0813
  x
}

pub flow at_slower_of_the_result(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(p) at block                                      //~ E0813 @17
  x
}

pub flow at_slower_of_the_result_in_a_sum(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = (prev~(p) + x) at block                                //~ E0813 @18
  x
}

pub flow delay_of_the_result(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(p)                                               //~ E0813
  let b = prev~(a)
  x
}

pub flow delay_n_of_the_result(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(p)                                               //~ E0813
  let b = delay~(a, 2)
  x
}

pub flow vdelay_of_the_result(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(p)                                               //~ E0813
  let b = vdelay~(a, x, 8)
  x
}

pub flow let_of_the_result_at_slower(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(p)                                               //~ E0813
  let b = a at block
  x
}

pub flow let_of_the_result_to_a_block_input(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(p)                                               //~ E0813
  gate~(x, a)
}

pub flow result_as_a_block_argument(x: F32 at sample, p: F32 at block) -> F32 at sample {
  gate~(x, prev~(p))                                             //~ E0813 @18
}

// ---------------------------------------------------------------- left to right

pub flow two_delays_in_error(x: F32 at sample, p: F32 at block, q: F32 at block) -> F32 at sample {
  prev~(p) + prev~(q)                                            //~ E0813 @9
}

pub flow two_delays_in_error_swapped(x: F32 at sample, p: F32 at block, q: F32 at block) -> F32 at sample {
  prev~(q) + prev~(p)                                            //~ E0813 @9
}

pub flow effect_then_delay_in_error(x: F32 at sample, p: F32 at block) -> F32 at sample {
  noisy(x) + prev~(p)                                            //~ E0805 @3
}

pub flow delay_in_error_then_effect(x: F32 at sample, p: F32 at block) -> F32 at sample {
  prev~(p) + noisy(x)                                            //~ E0813 @9
}
