// onsa.toml
// [test]
// spec = ["§11.4", "§11.3", "§4.7", "§18.1"]

// W7-14 U3/t, S-88, R-100, R-329, R-495: the maximum of a `vdelay~` of `F32` over 2^24 (E0808, §11.4) is an
// error of the flow stage, like the maximum 0 and the length of a `delay~` (§18.1, the order of the stages).
// A clock error that has no candidate (E0815) written before it is the one reported, and so is a type error
// (E0401, E0412) wherever it is written, because the flow check is made on a body that has its types (§4.7).
// One error per flow, so each form is a flow of its own: the first line has the error that is reported. In
// these forms the error of the maximum is not reported either way, so they are the guard of the order and
// are reported so before the limit is made. The other forms are in
// vdelay_max_stage_order_clock_first.onsa (the clock error that has a candidate, which leaves the error of
// the maximum) and vdelay_max_stage_order_first.onsa (the error of the maximum written first). The same orders
// for the maximum 0 are in flow_stage_order_clock_before_flow_check.onsa, flow_stage_order_flow_check_first.onsa
// and flow_stage_order_type_before_flow_check.onsa.

pub fn id1(a: F32) -> F32 { a }
pub flow pass(c: F32 at block) -> F32 at sample { c }

pub flow pass_then_vdelay_over(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = pass~(x)                                          //~ E0815
  let b = vdelay~(x, d, 16777217)
  x
}

pub flow at_then_vdelay_over(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = x at block                                        //~ E0815
  let b = vdelay~(x, d, 16777217)
  x
}

pub flow vdelay_over_then_type_error(x: F32 at sample, d: F32 at sample) -> F32 at sample {
  let a = vdelay~(x, d, 16777217)
  let b: Bool = 1.0                                         //~ E0401
  x
}

pub flow vdelay_over_then_type_error_in_the_output(x: F32 at sample, d: F32 at sample) -> F32 at sample {
  let a = vdelay~(x, d, 16777217)
  x + true                                                  //~ E0401
}

pub flow vdelay_over_then_argument_count(x: F32 at sample, d: F32 at sample) -> F32 at sample {
  let a = vdelay~(x, d, 16777217)
  let b = id1(1.0, 2.0)                                     //~ E0412
  x
}

pub flow vdelay_over_in_a_par_body_then_type_error(x: F32 at sample, d: F32 at sample) -> F32 at sample {
  let a = par~ i in 0 ..< 2 { vdelay~(x, d, 16777217) }
  let b: Bool = 1.0                                         //~ E0401
  x
}

pub flow type_error_then_vdelay_over(x: F32 at sample, d: F32 at sample) -> F32 at sample {
  let a: Bool = 1.0                                         //~ E0401
  let b = vdelay~(x, d, 16777217)
  x
}
