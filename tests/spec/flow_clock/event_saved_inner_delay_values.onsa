// onsa.toml
// [test]
// mode = "test"
// spec = ["§11.3", "§11.4", "§11.5", "§11.11"]

// W7-11 U2/t3 (see the end of this note), S-1249, S-1240, S-1244, S-1245 (spec §11.3: "保存する値の残りと、段の終わりに評価する遅い段の部分式 … が読むイベントの値 … は、`^名前` を書いたものと、`^名前` で選ぶ `match~` の束縛 … を除いて、
// 評価が段の終わりでも、その読みを書いた位置 … までの最後の値である。条件の位置の中でも、遅い刻みの部分式の中でも同じで、その位置を選ぶ条件や部分式の他の所に `^名前` があるかによらない
// (読みに `^` を書いたかどうかだけで決まる)"): an event that a stored expression reads is the value where the read is written, whatever the condition that chooses the place or the part that holds it reads with a `^name`.
// Where the part is evaluated (the end of the stage, S-1244) is the other thing. Each form has a twin that moves the read without `^` into a `let` above the delay (the same value, §11.3 "その遅延を含む `let` の前の … `let` に出した形と同じ値になる")
// and a contrast that writes the read as a `^t` of a `let` below the producer, which is the value at the end of the stage.
//
// The input is `GS = 1 .. 9` and `gen~` gives the event `x` when `x % 3 != 0` (the samples 0 1 3 4 6 7, the values 1 2 4 5 7 8). The delay of the events `p = prev~(^d)` gives the event before (0 at the first), so p after
// each sample is `PA` = 0 1 1 2 4 4 5 7 7, and p before the event of the sample (`PB`, what a read written above the producer sees) is 0 0 1 1 2 4 4 5 7. A delay gives the expression it stored at the sample before (0 at the first),
// so its output is the stored expression shifted by one sample, and `prev~(x)` gives 0 1 2 .. 8 for the `x` of 1 .. 9. Every value is worked out by hand in the comments.

// The forms of this file are those where a delay inside the part, or inside the first argument of the delay, has a `^name` that does not count (§11.3: "中の遅延の第 1 引数の中の `^名前` は、その遅延の出力なので数えない").
// They are in `flow_clock` and not with the others in `flow_semantics`, which the reference evaluator runs too: it ticks a delay of a bare `^name` in an expression at `sample` (§11.4: at the clock of its first argument), to be mended with the loops of `hoist::kept` (W7-17).

const GS: [U32; 9] = [1, 2, 3, 4, 5, 6, 7, 8, 9]

flow gen(x: U32 at sample) -> U32 at event {
  if x % 3 != 0 { Some(x) } else { None }
}

// `p + prev~(^d)` holds a delay with a `^d`, which is the output of that delay and does not count: the part is read where it is written (the two delays give the same event, so the part is 2 * p).
pub flow inner_delay(x: U32 at sample) -> U32 at sample {
  let p = prev~(^d)
  let q = prev~(((p + prev~(^d)) at sample) + x)
  let d: U32 = gen~(x)
  q
}

pub flow inner_delay_let(x: U32 at sample) -> U32 at sample {
  let p = prev~(^d)
  let t = (p + prev~(^d)) at sample
  let q = prev~(t + x)
  let d: U32 = gen~(x)
  q
}

test "a ^name in the first argument of a delay in the part does not count: the part is read where it is written" {
  // `2 * PB + x` (PB = 0 0 1 1 2 4 4 5 7, x = 1 .. 9) = 1 2 5 6 9 14 15 18 23, shifted.
  let a: [U32; 9] = [0, 1, 2, 5, 6, 9, 14, 15, 18]
  let o = inner_delay.render(GS, 8.0)
  let t = inner_delay_let.render(GS, 8.0)
  for i in 0 ..< 9 {
    assert o.out[i] == a[i] && t.out[i] == a[i]
  }
}

// The producer gives an event at each tick of `sample / 4`: the sum of `k` at the ticks (2 4 6 8 for k = 2). `p` is the event before: after each tick 0 2 4 6 (PA), before the event of a tick 0 0 2 4 (PB).
flow slow_events(k: U32 at block) -> U32 at event {
  let c = prev~(^c) + (k at (sample / 4))
  Some(c)
}

pub flow slow_nested(k: U32 at block) -> U32 at sample {
  let p = prev~(^d)
  let q = prev~(prev~((p at (sample / 4)) * 2 + ^m) at sample)
  let m = prev~(^m) + (k at (sample / 4))
  let d = slow_events~(k)
  q
}

pub flow slow_nested_let(k: U32 at block) -> U32 at sample {
  let p = prev~(^d)
  let t = p at (sample / 4)
  let q = prev~(prev~(t * 2 + ^m) at sample)
  let m = prev~(^m) + (k at (sample / 4))
  let d = slow_events~(k)
  q
}

pub flow slow_nested_end(k: U32 at block) -> U32 at sample {
  let p = prev~(^d)
  let q = prev~(prev~(((^t at (sample / 4)) * 2) + ^m) at sample)
  let m = prev~(^m) + (k at (sample / 4))
  let d = slow_events~(k)
  let t = p at (sample / 4)
  q
}

test "the same part in a delay of sample / 4 that another delay at sample stores reads the event where it is written" {
  // The inner delay at `sample / 4` gives the part of the tick before (0 at the first): 0 2 4 10 per tick (the part 2 4 10 16), held for four frames; the outer delay at `sample` shifts it by one frame.
  let a: [U32; 16] = [0, 0, 0, 0, 0, 2, 2, 2, 2, 4, 4, 4, 4, 10, 10, 10]
  // With `^t`: the parts 2 8 14 20 give 0 2 8 14 per tick.
  let c: [U32; 16] = [0, 0, 0, 0, 0, 2, 2, 2, 2, 8, 8, 8, 8, 14, 14, 14]
  let o = slow_nested.render(slow_nested.Params { k: 2 }, 16, 8.0)
  let t = slow_nested_let.render(slow_nested_let.Params { k: 2 }, 16, 8.0)
  let e = slow_nested_end.render(slow_nested_end.Params { k: 2 }, 16, 8.0)
  for f in 0 ..< 16 {
    assert o.out[f] == a[f] && t.out[f] == a[f]
    assert e.out[f] == c[f]
  }
}
