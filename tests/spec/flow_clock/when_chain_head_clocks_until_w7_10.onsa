// onsa.toml
// [test]
// spec = ["§11.9", "§11.10", "§18.1"]

// W7-09 U4b/i2 (spec §11.10: `.when~` and `.reset_if~` change no type and no clock; §11.9: the head of a chain runs in the frame of the sum of its ratios; §18.1): until W7-10 gives the meaning of
// `.when~` and `.reset_if~`, a chain with one is E0200 and its value is in error, so what reads it reports nothing; its head is still read in its frame, so an argument of the head at another clock
// than its input is E0815, before the E0200 of the modifier in the order of the file. When W7-10 comes the E0200 of the last flow is the E0815 of the output read at `sample / 4`, and the file is
// renamed. One error per flow. `l` is a `sample / 4` input.

pub flow lp(x: U32 at sample) -> U32 at sample {
  x + prev~(x)
}

pub flow an_argument_of_the_head(l: U32 at (sample / 4), c: Bool at sample) -> U32 at sample {
  lp~(l).when~(c)                                   //~ E0815
}

pub flow an_argument_of_the_head_in_a_frame(x: U32 at sample, c: Bool at sample) -> U32 at sample {
  lp~(x).down~(2).when~(c) at sample                //~ E0815
}

pub flow an_argument_of_the_head_in_a_let(l: U32 at (sample / 4), c: Bool at sample) -> U32 at sample {
  let a = lp~(l).reset_if~(c)                       //~ E0815
  a
}

pub flow the_value_read_at_another_clock(x: U32 at sample, c: Bool at sample) -> U32 at (sample / 4) {
  lp~(x).when~(c)                                   //~ E0200
}
