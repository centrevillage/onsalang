// onsa.toml
// [test]
// spec = ["§11.5", "§18.1"]

// A call of a function that is not `rt` takes values at `init` or constants (§11.5, E0815 if
// faster), and is evaluated at `init`. A call in that error has no clock (its rule needs the values
// at `init`), so an outer call that takes it reads a part in error and is not checked (§18.1): the
// inner call is the one reported.

pub fn slow(v: F32) -> F32 { v * 0.5 }
pub fn slow2(a: F32, b: F32) -> F32 { a + b }

pub flow nested(x: F32 at sample, c: F32 at init) -> F32 at sample {
  let y = slow2(c, slow(x))                                    //~ E0815 @20
  y
}

pub flow inner_only(x: F32 at sample, c: F32 at init) -> F32 at sample {
  let k = slow2(c, slow(c))
  let y = slow(x) + k                                          //~ E0815 @11
  y
}
