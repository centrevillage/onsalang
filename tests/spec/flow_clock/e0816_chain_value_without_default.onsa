// onsa.toml
// [test]
// spec = ["§11.3", "§11.9", "§18.1"]

// W7-09 U3b/t, S-1185, S-1186 (1a), S-1139 (spec §11.3: "刻みで書いて速い段で読むフィールド（…刻みの `let` や入力の値を速い段で読むフィールド）の初めの値と…戻り先は `T.default()` である（`T` が `Default` を満たさなければ、
// 速い段で読む式で E0816。速い段で読まない刻みの値には要らない）", §11.6, §11.9): the value of a chain is a tick of its ratio, and a faster stage that reads it reads a field of its own (S-1185: the node of a chain
// that no name holds is in the field `_hoist_N`, a `let` that holds it is read by the field that has its name), so the type that the flow gives out needs `Default` where a faster stage reads it. `NoDef` is a
// struct with no `Default` (and Copy, as the field `F32` is), as in e0816_tick_field_without_default.onsa; `mk` gives it out. The error is at the expression that reads it (the line of the read). The values that
// no faster stage reads need no `Default` (chain_values_need_no_default.onsa). One error per flow, so each form is a flow of its own. `x` is the `sample` input, `p` is a `block` input.

pub struct NoDef {
  f: F32,
}

pub flow mk(c: F32 at sample) -> NoDef at sample {
  NoDef { f: c }
}

pub flow node_read_at_sample(p: F32 at block, x: F32 at sample) -> F32 at sample {
  x * (mk~(p).down~(4) at sample).f                           //~ E0816
}

pub flow let_read_by_its_name(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let m = mk~(p).down~(4)
  x * (m at sample).f                                         //~ E0816
}

pub flow let_read_at_a_faster_tick(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let m = mk~(p).down~(4)
  let r = (m at (sample / 2)).f                               //~ E0816
  x * (r at sample)
}

pub flow chain_of_two_downs(p: F32 at block, x: F32 at sample) -> F32 at sample {
  x * (mk~(p).down~(2).down~(2) at sample).f                  //~ E0816
}

pub flow let_of_a_chain_of_two_downs(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let m = mk~(p).down~(2).down~(2)
  x * (m at sample).f                                         //~ E0816
}
