// onsa.toml
// [test]
// spec = ["§11.3", "§11.4", "§11.9", "§18.1"]

// W7-09 U3b/t, S-566, S-567, S-557, S-1077, S-1079, S-1139, S-1185 (spec §11.9, §11.3, §11.4): the clock of a chain of modifiers. The chain rate is the call position (the `sample` of the flow
// that writes the call, not the clock of an argument) with every `.down~(N)` and `.up~(N)` applied (§11.9: "連鎖のレートの起点は最初の呼び出し…連鎖の全ての `.down~`・`.up~` を当てたレートを連鎖のレートと呼び"),
// so `.down~(2).down~(2)` is `sample / 4` and `.down~(2).up~(2)` is `sample`. The arguments of the first call are read at the chain rate (§11.3: a value of the parameter kinds anywhere, a tick of
// the same ratio, a slower tick that `at` promotes), and the value of the chain is the value of the output at the chain rate: `lp~(p).down~(4)` is a value of `sample / 4` of the caller, read at
// `sample` or at a ratio between by `at`, and meets the values of its own ratio (§11.9: "`.down~(N)` の出力は呼び出し側の `sample / N` の値"). A call written in the argument of another chain
// runs at the call position again (it is not inside the chain), a delay of a chain value counts in its ticks (§11.4), and the chain stands in a branch of `if~` and `match~`, a `par~`, a loop
// through the head, and a flow that has chains in its own body. The values are read at a faster stage by their names or by the node itself (S-1185). No diagnostic. `x` is the `sample` input,
// `p` is a `block` input, `q` is an `init` input. The conversion flows (`at (sample * N)` in a declaration) are modifier_up_forms.onsa (U4a).

const K: U32 = 4

pub rt fn half(v: F32) -> F32 {
  v * 0.5
}

pub flow lp(x: F32 at sample) -> F32 at sample {
  x * 0.5 + prev~(x) * 0.5
}

// A flow that has a chain in its own body: its `sample` is the clock that runs it.
pub flow smooth_slow(c: F32 at block) -> F32 at sample {
  lp~(c).down~(2) at sample
}

// ---------------------------------------------------------------- the arguments of the first call

pub flow head_of_the_parameter_kinds(p: F32 at block, q: F32 at init, x: F32 at sample) -> F32 at sample {
  let a = lp~(p).down~(4)
  let b = lp~(q).down~(4)
  let c = lp~(0.5).down~(4)
  let d = lp~(p * q + 1.0).down~(K)
  x * ((a + b + c + d) at sample)
}

pub flow head_at_the_chain_rate(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let b = lp~(a).down~(4)
  let c = lp~(a * 2.0 + b).down~(4)
  x * (c at sample)
}

pub flow head_promoted_from_a_slower_tick(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let s = p at (sample / 8)
  let t = lp~(s at (sample / 4)).down~(4)
  let u = lp~(p).down~(8)
  let v = lp~(u at (sample / 4)).down~(4)
  x * (t at sample) + (v at sample)
}

pub flow head_of_a_chain_of_two_modifiers(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let y = lp~(a).down~(2).down~(2)
  let z = lp~(a at (sample / 2)).down~(2)
  x * (y at sample) + (z at sample)
}

// ---------------------------------------------------------------- the value of the chain

pub flow value_read_at_sample_and_at_a_ratio_between(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let y = lp~(p).down~(4)
  let m = y at (sample / 2)
  x * (y at sample) + (m at sample)
}

pub flow value_with_the_values_of_its_own_ratio(p: F32 at block, q: F32 at block, x: F32 at sample) -> F32 at sample {
  let y = lp~(p).down~(4)
  let z = lp~(q).down~(4)
  let a = p at (sample / 4)
  let w = (y + z) * a + p + 1.0
  let g = if y > z { y } else { z }
  let h = half(g)
  x * (w at sample) + (h at sample)
}

pub flow the_call_in_the_output_expression(p: F32 at block, x: F32 at sample) -> F32 at sample {
  x * (lp~(p).down~(4) at sample) + (lp~(p).down~(2) at sample)
}

pub flow the_call_beside_the_call_with_a_modifier(p: F32 at block, x: F32 at sample) -> F32 at sample {
  lp~(p) + (lp~(p).down~(4) at sample) + (lp~(x).down~(2).up~(2))
}

pub flow delay_of_a_chain_value(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let y = lp~(p).down~(4)
  let d = prev~(y)
  let e = delay~(lp~(p).down~(2), 2)
  x * (d at sample) + (e at sample)
}

pub flow delay_of_a_chain_read_by_its_node(p: F32 at block, x: F32 at sample) -> F32 at sample {
  x * (prev~(lp~(p).down~(4)) at sample)
}

// ---------------------------------------------------------------- a chain whose ratio is one

pub flow chains_of_the_ratio_one(x: F32 at sample) -> F32 at sample {
  let a = lp~(x).down~(2).up~(2)
  let b = lp~(x * 0.5).up~(2).down~(2)
  let c = prev~(lp~(x).down~(4).up~(4))
  a + b + c + x
}

pub flow chains_of_a_slower_ratio_that_go_up_first(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let y = lp~(p).up~(4).down~(8)
  let z = lp~(p).up~(2).down~(4)
  x * (y at sample) + (z at sample)
}

// ---------------------------------------------------------------- calls in the arguments

pub flow chains_in_the_arguments(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = lp~(lp~(p).down~(4)).down~(4)
  let b = lp~(lp~(p).down~(2)).down~(2)
  let c = lp~(lp~(p).down~(4) at (sample / 2)).down~(2)
  x * (a at sample) + (b at sample) + (c at sample)
}

pub flow a_flow_with_a_chain_inside_run_by_a_chain(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let y = smooth_slow~(p).down~(4)
  x * (y at sample) + smooth_slow~(p).down~(2).up~(2)
}

// ---------------------------------------------------------------- branches, a `par~`, a loop

pub flow chains_in_if_tilde_and_match_tilde(c: Bool at sample, n: U32 at block, p: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = if~ c { x * (lp~(p).down~(4) at sample) } else { x }
  match~ n {
    0 => a,
    _ => a * (lp~(p).down~(2) at sample),
  }
}

pub flow chain_in_a_par_tilde(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0 ..< 2 { x * (lp~(p * F32.round_from(i)).down~(4) at sample) }
  ys[0] + ys[1]
}

pub flow loop_through_the_head(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let y = lp~(p + prev~(^y)).down~(4)
  x * (y at sample)
}

pub flow loop_of_two_lets_through_the_head(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let u = lp~(prev~(^v) + p).down~(4)
  let v = u * 0.5
  x * (v at sample)
}
