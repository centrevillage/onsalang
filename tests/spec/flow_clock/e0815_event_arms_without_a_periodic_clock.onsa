// onsa.toml
// [test]
// spec = ["§11.3", "§11.4", "§11.5", "§11.11", "§18.1"]

// W7-11 U2c/t, S-1239 (spec §11.11: "別の呼び出しを配列の要素か `if~`・`match~` の腕に並べた形は、条件・対象・ガードか要素・腕のどれかが周期の刻みのクロックの値（`at` で付けたクロックを含む）なら、§11.3 のとおり周期のクロックの式で、…どれも違えば（条件がパラメータの種類、イベントの値、`sample_tick()` だけの式）E0815 である"; §11.3:
// "`else if` より後ろの連なりは、一つの部分式として確かめる"; §11.11 "四つの所"): the arms are the events of two calls (each of a clock of its own), and nothing in the condition, the scrutinee or a guard is of a periodic clock, so the expression has no greatest
// clock: E0815 at the expression. The condition is a parameter kind (`block`, `init`, a constant), `sample_tick()` alone (it is not a periodic value there, §11.11) or an event (of another input than the arms, which are other clocks of their own). The chain after
// an `else if` is one sub-expression, so a periodic condition before it does not help (`if` and `if~`). The four places mix an event value with a periodic one (the first argument of a delay, the condition of `reset_if~`, the expression of an event output)
// whatever the condition is. The error is at the line of the whole expression, so the forms are on one line. The accepted forms of the same arms are in event_arms_periodic_condition_s1239.onsa, event_arms_with_a_periodic_value_accepted.onsa. One error per flow
// (P-01). `x` and `z` are `sample`, `a` and `b` are `block`, `c` is `sample`, `ev` and `m` and `n` are events of inputs.

pub flow det(x: F32 at sample, limit: F32 at block) -> F32 at event {
  if x > limit { Some(x) } else { None }
}

pub flow lp(x: F32 at sample) -> F32 at sample {
  x * 0.5
}

// ---------------------------------------------------------------- the condition is a parameter kind or a constant

pub flow block_condition(x: F32 at sample, a: F32 at block, b: F32 at block, kb: Bool at block) -> F32 at sample {
  if~ kb { det~(x, a) } else { det~(x, b) }   //~ E0815
}

pub flow init_condition(x: F32 at sample, a: F32 at block, b: F32 at block, ki: Bool at init) -> F32 at sample {
  if~ ki { det~(x, a) } else { det~(x, b) }   //~ E0815
}

pub flow constant_condition(x: F32 at sample, a: F32 at block, b: F32 at block) -> F32 at sample {
  if~ true { det~(x, a) } else { det~(x, b) }   //~ E0815
}

pub flow block_scrutinee(x: F32 at sample, a: F32 at block, b: F32 at block, k: U32 at block) -> F32 at sample {
  match~ k { 0 => det~(x, a), _ => det~(x, b) }   //~ E0815
}

pub flow block_scrutinee_with_a_block_guard(x: F32 at sample, a: F32 at block, b: F32 at block, k: U32 at block, gb: Bool at block) -> F32 at sample {
  match~ k { 0 if gb => det~(x, a), _ => det~(x, b) }   //~ E0815
}

pub flow block_condition_in_a_par(x: F32 at sample, a: F32 at block, b: F32 at block, kb: Bool at block) -> [F32; 2] at sample {
  par~ i in 0 ..< 2 { if~ kb { det~(x, a) } else { det~(x, b) } }   //~ E0815
}

// ---------------------------------------------------------------- `sample_tick()` alone

pub flow tick_condition(x: F32 at sample, a: F32 at block, b: F32 at block) -> F32 at sample {
  if~ sample_tick() % 2 == 0 { det~(x, a) } else { det~(x, b) }   //~ E0815
}

pub flow tick_scrutinee(x: F32 at sample, a: F32 at block, b: F32 at block) -> F32 at sample {
  match~ sample_tick() % 2 { 0 => det~(x, a), _ => det~(x, b) }   //~ E0815
}

// ---------------------------------------------------------------- the condition, the scrutinee or the guard is an event value

pub flow event_condition(x: F32 at sample, a: F32 at block, b: F32 at block, ev: F32 at event) -> F32 at sample {
  if~ ev > 0.5 { det~(x, a) } else { det~(x, b) }   //~ E0815
}

pub flow event_scrutinee(x: F32 at sample, a: F32 at block, b: F32 at block, ev: U32 at event) -> F32 at sample {
  match~ ev { 0 => det~(x, a), _ => det~(x, b) }   //~ E0815
}

pub flow event_guard(x: F32 at sample, a: F32 at block, b: F32 at block, k: U32 at block, ev: F32 at event) -> F32 at sample {
  match~ k { 0 if ev > 0.5 => det~(x, a), _ => det~(x, b) }   //~ E0815
}

pub flow event_of_a_call(x: F32 at sample, a: F32 at block, b: F32 at block) -> F32 at sample {
  if~ det~(x, a) > 0.5 { det~(x, a) } else { det~(x, b) }   //~ E0815
}

// ---------------------------------------------------------------- the chain after an `else if` is one sub-expression

pub flow events_after_an_else_if(x: F32 at sample, a: F32 at block, b: F32 at block, c: Bool at sample, kb: Bool at block) -> F32 at sample {
  if~ c { x } else if kb { det~(x, a) } else { det~(x, b) }   //~ E0815
}

pub flow events_in_all_the_arms_after_an_else_if(x: F32 at sample, a: F32 at block, b: F32 at block, c: Bool at sample, kb: Bool at block) -> F32 at sample {
  if~ c { det~(x, 0.3) } else if kb { det~(x, a) } else { det~(x, b) }   //~ E0815
}

pub flow plain_events_after_an_else_if(m: F32 at event, n: F32 at event, c: Bool at sample, kb: Bool at block) -> F32 at sample {
  if c { 0.0 } else if kb { m } else { n }   //~ E0815
}

// ---------------------------------------------------------------- the arms of calls in an array

pub flow two_calls_in_an_array(x: F32 at sample, a: F32 at block, b: F32 at block) -> [F32; 2] at sample {
  [det~(x, a), det~(x, b)]   //~ E0815
}

// ---------------------------------------------------------------- the four places: an event value and a periodic one mix, whatever the condition

pub flow in_a_delay_with_a_periodic_arm(x: F32 at sample, a: F32 at block, c: Bool at sample) -> F32 at sample {
  prev~(if~ c { det~(x, a) } else { x })   //~ E0815
}

pub flow in_a_delay_with_two_calls(x: F32 at sample, a: F32 at block, b: F32 at block, c: Bool at sample) -> F32 at sample {
  prev~(if~ c { det~(x, a) } else { det~(x, b) })   //~ E0815
}

pub flow in_the_condition_of_a_reset(x: F32 at sample, a: F32 at block, c: Bool at sample, g: Bool at sample) -> F32 at sample {
  lp~(x).reset_if~(if~ c { det~(x, a) > 0.5 } else { g })   //~ E0815
}

pub flow in_the_expression_of_an_event_output(x: F32 at sample, a: F32 at block, c: Bool at sample) -> F32 at event {
  Some(if~ c { det~(x, a) } else { x })   //~ E0815
}
