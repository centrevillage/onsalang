pub flow f9_par0(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let v = (par~ i in 3 ..< 3 { applyf(FF, p) })[0]  //~ E0808
  x
}

pub flow f9_del0(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let v = delay~(applyf(FF, p), 0)  //~ E0813
  x
}

pub flow f10_id(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let v = applyf(FF, 1.0)  //~ E0810
  x
