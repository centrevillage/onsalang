// onsa.toml
// [test]
// spec = ["§11.3", "§11.4", "§11.5", "§18.1"]

// W7-14 U6b/t, S-372, S-1133 (spec §11.3: the type of an expression of a flow body holds no function type, E0810; §11.3, §11.4, §11.5: the clock rules; §18.1: of the errors left in a unit the
// first by position, the start and then the end; "読めなかった部分は誤りの型として扱い、それを使う側には診断を出さない"). A grid of the expressions that hold a function value (the atoms) in the
// forms that read the clock of what they hold (the wraps), made from the spec by a model of the order of the diagnostics of the flow check (the atom alone, each in each wrap; the model is
// not in the repository, the grid is). The E0810 of a function value does not fail a clock rule, so the atom has the clock its rule gives and the check of the wrap is made; the first error by
// position is the one reported, one for each flow, and the marker is on its line. Where the E0810 starts first (it starts where the wrap's error starts and ends before it, or the wrap's
// error is on the argument and the argument is longer), the E0810 is the error. Where an expression of the error clock is in the atom (a delay of a slower value, a call that is not `rt` with a
// faster argument), the wrap that reads its clock says nothing.
//
// Atoms (clock): f1 `applyf(FF, x)` (sample), f2 `KS.gain` (constant), f3 `mks(x).gain` (sample), f4 `applyf(FF, prev~(p))` (error: E0813 of the delay in it), f5 `applyf(FF, slow(x))` (error:
// E0815 of the call that is not `rt`), f6 `prev~(KS.gain)` (error: E0813), f7 `first((x, FF))` (sample), f8 `Sh { gain: x, cb: FF }.gain` (sample), f9 `applyf(FF, p)` (block),
// f10 `applyf(FF, 1.0)` (constant). Wraps: id; lp `lp~(A)`; par `(par~ i in 0 ..< 2 { A })[0]`; add `(A + x)`; atb `(A) at block`; nrt `slow(A)` (not `rt`, E0815 for an argument at
// `block` or `sample`); tob `to_block~(A)` (an input at `block`); prev `prev~(A)`, del `delay~(A, 4)`, vdel `vdelay~(A, x, 8)` (the first argument at `sample`, E0813; a delay in it is read at its own clock, and an atom that is a delay (f6) is the E0810 of the function value in it);
// pinit `prev~(x, A)` (`init` at `init` or a constant); par0 `(par~ i in 3 ..< 3 { A })[0]` (E0808 at the `par~`); del0 `delay~(A, 0)` (E0808 at the `0`).
// The row f10_atb is in `flow_fn_value_clock_model_atb_constant.onsa` (it was in this file's list of the rows that this version could not report: an `at` that makes a
// computed expression faster was an E0200 until W7-05).

pub rt fn dbl(v: F32) -> F32 { v }
const FF: rt fn(F32) -> F32 = dbl
pub rt fn applyf(g: rt fn(F32) -> F32, v: F32) -> F32 { g.(v) }
pub rt fn first(p: (F32, rt fn(F32) -> F32)) -> F32 { p.0 }
pub fn slow(v: F32) -> F32 { v }
pub flow lp(y: F32 at sample) -> F32 at sample { y }
pub flow to_block(c: F32 at block) -> F32 at sample { c }
pub struct Sh { gain: F32, cb: rt fn(F32) -> F32 }
const KS: Sh = Sh { gain: 1.0, cb: dbl }
pub rt fn mks(g: F32) -> Sh { Sh { gain: g, cb: dbl } }

pub flow f1_id(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let v = applyf(FF, x)  //~ E0810
  x
}

pub flow f1_lp(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let v = lp~(applyf(FF, x))  //~ E0810
  x
}

pub flow f1_par(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let v = (par~ i in 0 ..< 2 { applyf(FF, x) })[0]  //~ E0810
  x
}

pub flow f1_add(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let v = (applyf(FF, x) + x)  //~ E0810
  x
}

pub flow f1_atb(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let v = (applyf(FF, x)) at block  //~ E0815
  x
}

pub flow f1_nrt(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let v = slow(applyf(FF, x))  //~ E0815
  x
}

pub flow f1_tob(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let v = to_block~(applyf(FF, x))  //~ E0815
  x
}

pub flow f1_prev(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let v = prev~(applyf(FF, x))  //~ E0810
  x
}

pub flow f1_del(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let v = delay~(applyf(FF, x), 4)  //~ E0810
  x
}

pub flow f1_vdel(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let v = vdelay~(applyf(FF, x), x, 8)  //~ E0810
  x
}

pub flow f1_pinit(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let v = prev~(x, applyf(FF, x))  //~ E0815
  x
}

pub flow f1_par0(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let v = (par~ i in 3 ..< 3 { applyf(FF, x) })[0]  //~ E0808
  x
}

pub flow f1_del0(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let v = delay~(applyf(FF, x), 0)  //~ E0810
  x
}

