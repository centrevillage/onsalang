  let v = (par~ i in 0 ..< 2 { applyf(FF, 1.0) })[0]  //~ E0810
  x
}

pub flow f10_add(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let v = (applyf(FF, 1.0) + x)  //~ E0810
