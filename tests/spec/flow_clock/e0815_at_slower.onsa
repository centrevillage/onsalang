// onsa.toml
// [test]
// spec = ["§11.3", "§11.4", "§11.5"]

// `e at k` with a `k` slower than the clock of `e` is E0815 (§11.3): a value is never made slower.
// The clock of `e` follows §11.3: an input is its declared clock, a call of a user flow is the
// declared output clock (not the clocks of the arguments), a delay is the clock of its first
// argument (§11.4), a call of an `rt` fn is the fastest of its arguments (§11.5), and a constant
// is at no clock and goes to any. One error per flow (§18.1), so each form is a flow of its own.

pub rt fn half(v: F32) -> F32 { v * 0.5 }
pub flow g(y: F32 at sample) -> F32 at sample { y }

pub flow sample_to_init(x: F32 at sample) -> F32 at sample {
  let a = x at init                                           //~ E0815
  x
}

pub flow block_to_init(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = p at init                                           //~ E0815
  x
}

pub flow of_an_rt_call(x: F32 at sample) -> F32 at sample {
  let a = half(x) at block                                    //~ E0815
  x
}

pub flow of_an_instance_to_block(x: F32 at sample) -> F32 at sample {
  let a = g~(x) at block                                      //~ E0815
  x
}

pub flow of_an_instance_to_init(x: F32 at sample) -> F32 at sample {
  let a = g~(x) at init                                       //~ E0815
  x
}

pub flow of_a_delay_result(x: F32 at sample) -> F32 at sample {
  let a = prev~(x)
  let b = a at block                                          //~ E0815
  x
}

pub flow of_a_delay_of_a_promoted_block(x: F32 at sample, p: F32 at block) -> F32 at sample {
  let a = prev~(p at sample)
  let b = a at block                                          //~ E0815
  x
}

pub flow in_an_instance_argument(x: F32 at sample) -> F32 at sample {
  g~(x at block)                                              //~ E0815
}

// The `at` is E0815 and the first argument it gives is at `block` (E0813), over the same span: the
// order of the codes puts E0813 first (§18.1).
pub flow in_a_delay_argument(x: F32 at sample) -> F32 at sample {
  prev~(x at block)                                           //~ E0813
}

pub flow in_a_par_body(x: F32 at sample) -> [F32; 2] at sample {
  par i in 0 ..< 2 { x at block }                            //~ E0815
}

pub flow in_an_if_branch(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  if c { x at block } else { 0.0 }                            //~ E0815
}

pub flow in_a_match_arm(x: F32 at sample, k: U32 at sample) -> F32 at sample {
  match k { 0 => x at block, _ => 0.0 }                       //~ E0815
}

pub flow in_a_destructuring_let(x: F32 at sample) -> F32 at sample {
  let (a, b) = (x at block, x)                                //~ E0815
  b
}

// The other directions are not errors: a slower value is read at a faster clock, and a constant
// goes to any clock.
pub flow promotions(x: F32 at sample, k: F32 at init, p: F32 at block) -> F32 at sample {
  let a = k at block
  let b = k at sample
  let c = p at sample
  let d = x at sample
  let e = p at block
  let f = k at init
  let one = 1.0
  let h = one at block
  x + a + b + c + d + e + f + h + (1.0 at init) + (1.0 at sample)
}
