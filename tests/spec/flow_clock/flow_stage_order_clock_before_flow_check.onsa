// The checks of the flow stage that one flow body has are found in the order of the diagnostics, the
// first by position (§18.1: "the first by the order of the diagnostics: start position, ..."), so
// an error of the clock rules (E0813 on the first argument of a delay, E0815 on a value that is too
// fast) is reported when it is written before an error of the other flow checks: the length of a
// delay (E0807 for 1, E0808 for 0 and for the `MAX` of `vdelay~`), the bounds of a `par~` (E0808),
// and the meaning this version does not take (E0200 for a `.reset_if~(c)`, W7-10 U2, none here; a delay inside a delay
// is no error since W7-07, so the two `nested_delay` flows have the first error alone). They are all of
// the flow stage, and none of them hides another by the way the compiler walks the body. One error per
// flow, so each form is a flow of its own: the first line has the reported error, the second the other.
//
// The first group has the two errors on two lines of a `let`, the second the later error in other
// places (the output expression, a `par~` body, a nested `par~`), and the last one the two on one
// line (the clock error starts first). The forms with the error of the length first are in
// `flow_stage_order_flow_check_first.onsa`. The candidate of E0813 leaves the later error.
// Since W7-14 (R-495) the walk of the types holds the errors of the lengths and goes on, so they do
// not win. The `when~(true)` of three flows was an E0200 until W7-10 U1 and is no error now; the error that is
// reported (the first one) does not change, and it is only after E0815, which has no candidate (the
// candidate of E0813 would have left that E0200).

const K: F32 = 1.0
pub flow pass(c: F32 at block) -> F32 at sample { c }

pub flow block_then_delay_one(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = prev~(p)                                          //~ E0813
  let b = delay~(x, 1)
  x
}

pub flow block_then_delay_zero(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = prev~(p)                                          //~ E0813
  let b = delay~(x, 0)
  x
}

pub flow block_then_vdelay_zero(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = prev~(p)                                          //~ E0813
  let b = vdelay~(x, d, 0)
  x
}

pub flow block_then_par_empty(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = prev~(p)                                          //~ E0813
  let b = par i in 2 ..< 2 { x }
  x
}

pub flow const_then_delay_one(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = prev~(K)                                          //~ E0813
  let b = delay~(x, 1)
  x
}

pub flow const_then_delay_zero(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = prev~(K)                                          //~ E0813
  let b = delay~(x, 0)
  x
}

pub flow const_then_vdelay_zero(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = prev~(K)                                          //~ E0813
  let b = vdelay~(x, d, 0)
  x
}

pub flow const_then_par_empty(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = prev~(K)                                          //~ E0813
  let b = par i in 2 ..< 2 { x }
  x
}

pub flow pass_then_delay_one(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = pass~(x)                                          //~ E0815
  let b = delay~(x, 1)
  x
}

pub flow pass_then_delay_zero(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = pass~(x)                                          //~ E0815
  let b = delay~(x, 0)
  x
}

pub flow pass_then_vdelay_zero(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = pass~(x)                                          //~ E0815
  let b = vdelay~(x, d, 0)
  x
}

pub flow pass_then_par_empty(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = pass~(x)                                          //~ E0815
  let b = par i in 2 ..< 2 { x }
  x
}

pub flow pass_then_nested_delay(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = pass~(x)                                          //~ E0815
  let b = prev~(prev~(x))
  x
}

pub flow pass_then_a_when(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = pass~(x)                                          //~ E0815
  let t = same~(x).when~(true)
  x
}

pub flow at_then_delay_one(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = x at block                                        //~ E0815
  let b = delay~(x, 1)
  x
}

pub flow at_then_delay_zero(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = x at block                                        //~ E0815
  let b = delay~(x, 0)
  x
}

pub flow at_then_vdelay_zero(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = x at block                                        //~ E0815
  let b = vdelay~(x, d, 0)
  x
}

pub flow at_then_par_empty(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = x at block                                        //~ E0815
  let b = par i in 2 ..< 2 { x }
  x
}

pub flow at_then_nested_delay(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = x at block                                        //~ E0815
  let b = prev~(prev~(x))
  x
}

pub flow at_then_a_when(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = x at block                                        //~ E0815
  let t = same~(x).when~(true)
  x
}

pub flow block_then_delay_one_in_the_output(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = prev~(p)                                          //~ E0813
  delay~(x, 1) + a
}

pub flow block_then_delay_one_in_a_par_body(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = prev~(p)                                          //~ E0813
  let b = par~ i in 0 ..< 2 { delay~(x, 1) }
  x
}

pub flow block_then_delay_zero_in_a_nested_par_body(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = prev~(p)                                          //~ E0813
  let b = par~ i in 0 ..< 2 { par~ j in 0 ..< 2 { delay~(x, 0) } }
  x
}

pub flow block_in_a_par_body_then_delay_one(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = par~ i in 0 ..< 2 { prev~(p) }                    //~ E0813
  let b = delay~(x, 1)
  x
}

pub flow pass_in_a_par_body_then_a_when(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  let a = par~ i in 0 ..< 2 { pass~(x) }                    //~ E0815
  let t = same~(x).when~(true)
  x
}

pub flow block_then_delay_one_in_one_line(x: F32 at sample, p: F32 at block, d: F32 at sample) -> F32 at sample {
  prev~(p) + delay~(x, 1)                                   //~ E0813
}

pub flow same(x: F32 at sample) -> F32 at sample { x }
