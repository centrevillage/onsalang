// onsa.toml
// [test]
// spec = ["§11.3", "§11.4", "§11.9", "§18.1"]

// Periodic clocks of different ratios do not meet without an `at` (§11.3, S-1077, S-1079): `sample / 4` with `sample / 2`, and
// `sample / N` with the `sample` of the body, are E0815 wherever the two meet (an operation, a branch, an arm, a `par` body, a
// delay, a call), and so are a slower ratio written on a faster value and the argument of a call that is faster than its input
// (§11.9: "`sample / N` の値は `at` なしに `sample` の入力へ読めない"). The value of a part in error is an error, so what reads it
// reports nothing, a value written `at (sample / N)` has the clock it was written with, and a loop of `let`s with two ratios
// that enter is one error (S-1133). One error per flow, so each form is a flow of its own; the `let`s that read the error have no
// mark. The notes of the error (the two clocks) and the place inside a loop of several `let`s are not fixed by the spec.

pub flow lp(x: F32 at sample) -> F32 at sample {
  x
}

pub flow gain(p: F32 at block, x: F32 at sample) -> F32 at sample {
  x * p
}

// ---------------------------------------------------------------- two ratios

pub flow two_ratios(p: F32 at block, q: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let c = q at (sample / 2)
  let s = a + c                                             //~ E0815
  let t = s + x
  t
}

pub flow two_ratios_the_other_way(p: F32 at block, q: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let c = q at (sample / 2)
  let s = c + a                                             //~ E0815
  x
}

pub flow two_ratios_in_parts(p: F32 at block, q: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let c = q at (sample / 2)
  let s = (a * 2.0) + (c * 0.5)                             //~ E0815
  x
}

pub flow two_ratios_through_a_let(p: F32 at block, q: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let c = q at (sample / 2)
  let u = a
  let s = u + c                                             //~ E0815
  x
}

pub flow two_ratios_in_the_arms_of_a_match(p: F32 at block, q: F32 at block, k: U32 at block) -> F32 at sample {
  let a = p at (sample / 4)
  let c = q at (sample / 2)
  let s = match k { 0 => a, _ => c }                        //~ E0815
  p
}

// ---------------------------------------------------------------- a ratio and the sample

pub flow a_tick_and_the_sample(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let s = a + x                                             //~ E0815
  x
}

pub flow the_sample_and_a_tick(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let s = x * a                                             //~ E0815
  x
}

pub flow a_tick_compared_with_the_sample(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let s = a > x                                             //~ E0815
  x
}

pub flow in_the_branches_of_an_if(p: F32 at block, g: Bool at sample, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let s = if g { a } else { x }                             //~ E0815
  x
}

pub flow in_a_branch_of_an_if_tilde(p: F32 at block, g: Bool at sample, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  if~ g { lp~(x) + a } else { x }                           //~ E0815
}

pub flow in_a_par_body(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let ys = par i in 0 ..< 2 { a + x }                       //~ E0815
  x
}

pub flow a_delay_of_a_tick_and_the_sample(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let s = prev~(a) + x                                      //~ E0815
  x
}

pub flow the_result_of_an_instance_and_a_tick(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let s = lp~(x) + a                                        //~ E0815
  x
}

// ---------------------------------------------------------------- the direction of `at`

pub flow the_sample_value_at_a_ratio(x: F32 at sample) -> F32 at sample {
  let b = x at (sample / 4)                                 //~ E0815
  x + (b at sample)
}

pub flow a_ratio_at_a_slower_ratio(q: F32 at block, x: F32 at sample) -> F32 at sample {
  let c = q at (sample / 2)
  let d = c at (sample / 4)                                 //~ E0815
  x + (d at sample)
}

pub flow in_a_delay_argument(x: F32 at sample) -> F32 at sample {
  let d = prev~(x at (sample / 4))                          //~ E0815
  x + (d at sample)
}

// ---------------------------------------------------------------- the arguments of a call

pub flow a_tick_to_an_input_of_the_sample(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let s = lp~(a)                                            //~ E0815
  x
}

pub flow a_tick_to_an_input_of_the_block(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let s = gain~(a, x)                                       //~ E0815
  x
}

// ---------------------------------------------------------------- loops

pub flow a_loop_of_two_ratios(p: F32 at block, q: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let c = q at (sample / 2)
  let u = prev~(^u + a) + c                                 //~ E0815
  let r = u + x
  r + (u at sample)
}

pub flow a_loop_of_a_tick_and_the_sample(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let u = prev~(^u + a) + x                                 //~ E0815
  let r = u * 2.0
  r + x
}

// ---------------------------------------------------------------- the output (§11.3: a value is never made slower)

pub flow a_tick_as_the_output(p: F32 at block) -> F32 at sample {
  let a = p at (sample / 4)
  a                                                         //~ E0815
}
