// onsa.toml
// [test]
// spec = ["§11.3", "§11.9", "§18.1"]
// fixes = 0

// The only derived clock that an expression can write is `(sample / N)`: `e at (sample * N)` is E0815 for any `e`, with no
// candidate (S-1078, S-567 K3: "行き先は本体の `sample` まで"). `sample * N` stands in the declarations of a flow of conversion
// (U4a). One error per flow, so each form is a flow of its own.

pub flow times_of_a_sample_value(x: F32 at sample) -> F32 at sample {
  let a = x at (sample * 2)                                 //~ E0815
  x
}

pub flow times_of_a_block_value(p: F32 at block) -> F32 at sample {
  let a = p at (sample * 4)                                 //~ E0815
  p
}

pub flow times_of_a_constant(x: F32 at sample) -> F32 at sample {
  let a: F32 = 1.0 at (sample * 2)                          //~ E0815
  x
}

pub flow times_of_a_tick_value(p: F32 at block, x: F32 at sample) -> F32 at sample {
  let a = p at (sample / 4)
  let b = a at (sample * 2)                                 //~ E0815
  x + (a at sample)
}
