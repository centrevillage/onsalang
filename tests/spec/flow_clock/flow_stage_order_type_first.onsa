// onsa.toml
// [test]
// spec = ["§4.7", "§11.4", "§11.5", "§18.1"]

// The checks of a unit come in the order syntax, names, types, the flow check (§18.1). A type error
// that is written before an error of the flow check (the length of a delay, E0807 and E0808, the
// bounds of a `par~`, E0808) is the one reported, and so is an error of the names stage written after
// it (the earlier stage is reported whatever the positions). One error per flow, so each form is a
// flow of its own. The flow check error first is in
// `flow_stage_order_type_before_flow_check.onsa`.

pub flow type_error_then_delay_one(x: F32 at sample) -> F32 at sample {
  let b: Bool = 1.0                                              //~ E0401
  let a = delay~(x, 1)
  x
}

pub flow type_error_then_delay_zero(x: F32 at sample) -> F32 at sample {
  let b: Bool = 1.0                                              //~ E0401
  let a = delay~(x, 0)
  x
}

pub flow type_error_then_vdelay_zero(x: F32 at sample, d: F32 at sample) -> F32 at sample {
  let b: Bool = 1.0                                              //~ E0401
  let a = vdelay~(x, d, 0)
  x
}

pub flow type_error_then_par_empty(x: F32 at sample) -> F32 at sample {
  let b: Bool = 1.0                                              //~ E0401
  let a = par~ i in 2 ..< 2 { x }
  x
}

pub flow delay_one_then_name_not_found(x: F32 at sample) -> F32 at sample {
  let a = delay~(x, 1)
  let b = nope                                                   //~ E0302
  x
}

pub flow par_empty_then_name_not_found(x: F32 at sample) -> F32 at sample {
  let a = par~ i in 2 ..< 2 { x }
  let b = nope                                                   //~ E0302
  x
}
