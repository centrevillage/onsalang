// onsa.toml
// [test]
// spec = ["§8.1", "§4.5", "§18.1"]
// fixes = 0

// W5-24 U3b/t, S-750 (spec §8.1: "同じ効果を二度書く形(`uses {Alloc, Alloc}`。効果行変数も同じ)は E0602 で、境界の重なりと同じ形で報告する(§4.5)"; §4.5: the error is on the first element of
// the row that overlaps one before it, and "修正候補は無い"): an effect written twice in the row of a function is E0602 on the second one, with no candidate
// (`fixes = 0`). The effect is `Alloc`, the one effect that this version takes in a row. The function has parameters, a result, a body that uses the effect and a body
// that does not, and the row is written in the same line as the signature and on lines of its own. The row of a function is what the keyword `uses` opens, so the
// error is on the second name and the marker is on its line. One error in each unit (P-01).

pub fn plain() uses {Alloc, Alloc} {}               //~ E0602

pub fn with_result(x: U32) -> U32 uses {Alloc, Alloc} { //~ E0602
  x
}

pub fn with_params_and_a_body(a: U32, b: U32) -> U32 uses {Alloc, Alloc} { //~ E0602
  a + b
}

pub fn row_on_its_own_lines(x: U32) -> U32
  uses {Alloc,
    Alloc} {                                        //~ E0602
  x
}

pub fn row_in_a_line_of_its_own(x: U32) -> U32
  uses {Alloc, Alloc} {                             //~ E0602
  x
}

pub fn that_allocates(x: U32) -> Str uses {Alloc, Alloc} { //~ E0602
  "n = {x}"
}

pub fn three_copies(x: U32) -> U32 uses {Alloc, Alloc, Alloc} { //~ E0602
  x
}

pub fn private_one() -> U32 uses {Alloc, Alloc} {   //~ E0602
  1
}
