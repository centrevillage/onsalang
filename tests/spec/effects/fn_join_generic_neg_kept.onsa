// onsa.toml
// [test]
// spec = ["§4.7", "§8.1", "§10"]

// W6-01 U2b/t, S-1031 (§4.7, §8.1, §10). The refused uses of the joins of fn_join_generic_ok.onsa (see there): a join of a generic function that is not `rt` with `r` is not `rt` (E0401 at an `rt` place, E0901 for the
// call in an `rt` function, an array of it is not an array of `rt fn`); a join with `b` has `uses {Alloc}` (E0401 at an empty-row place, E0601 for the call in a function with an empty row, written on one line so that the mark is
// the same at the heading and at the use); an assignment to a `var` that was started by the join, of a function with an effect row that is not in the type of the join. Checked, not run.
//
// The units of this file are the ones that the code before U2b already answers as written here; they are kept apart from the units that need the join (in fn_join_generic_neg.onsa), so that a change in them is not hidden by that file.

pub fn k(x: U32) -> U32 {
  x
}

pub rt fn r(x: U32) -> U32 {
  x
}

pub fn b(x: U32) -> U32 uses {Alloc} {
  x
}

// The places the joined type is tried at: an `rt` place, a place with an empty effect row, a place with `uses {Alloc}`, and the same three
// in an array type (an element of a type argument is compared as equal, so these say what the type of the join is).
pub rt fn at_rt(g: rt fn(U32) -> U32) -> U32 {
  g.(1)
}

pub fn at_pure(g: fn(U32) -> U32) -> U32 {
  g.(1)
}

pub fn at_alloc(g: fn(U32) -> U32 uses {Alloc}) -> U32 uses {Alloc} {
  g.(1)
}

pub rt fn arr_rt(a: [rt fn(U32) -> U32; 2]) -> U32 {
  a[0].(1)
}

pub fn arr_pure(a: [fn(U32) -> U32; 2]) -> U32 {
  a[0].(1)
}

pub fn arr_alloc(a: [fn(U32) -> U32 uses {Alloc}; 2]) -> U32 uses {Alloc} {
  a[0].(1)
}

pub rt fn arr3_rt(a: [rt fn(U32) -> U32; 3]) -> U32 {
  a[0].(1)
}

pub fn arr3_pure(a: [fn(U32) -> U32; 3]) -> U32 {
  a[0].(1)
}

pub fn arr3_alloc(a: [fn(U32) -> U32 uses {Alloc}; 3]) -> U32 uses {Alloc} {
  a[0].(1)
}

pub fn id[T](x: T) -> T {
  x
}

pub fn id_alloc[T](x: T) -> T uses {Alloc} {
  x
}

pub fn gen_id_r_to_rt(c: Bool) -> U32 {
  let f = if c { id } else { r }
  at_rt(f)   //~ E0401
}

pub rt fn gen_id_r_call_in_rt(c: Bool) -> U32 { (if c { id } else { r }).(1) }   //~ E0901

pub fn gen_id_r_type_rt(c: Bool) -> U32 {
  let f = if c { id } else { r }
  let fs = [f, f]
  arr_rt(fs)   //~ E0401
}

pub fn gen_k_id_to_rt(c: Bool) -> U32 {
  let f = if c { k } else { id }
  at_rt(f)   //~ E0401
}

pub rt fn gen_k_id_call_in_rt(c: Bool) -> U32 { (if c { k } else { id }).(1) }   //~ E0901

pub fn gen_k_id_type_rt(c: Bool) -> U32 {
  let f = if c { k } else { id }
  let fs = [f, f]
  arr_rt(fs)   //~ E0401
}

pub fn gen_id_k_to_rt(c: Bool) -> U32 {
  let f = if c { id } else { k }
  at_rt(f)   //~ E0401
}

pub rt fn gen_id_k_call_in_rt(c: Bool) -> U32 { (if c { id } else { k }).(1) }   //~ E0901

pub fn gen_id_k_type_rt(c: Bool) -> U32 {
  let f = if c { id } else { k }
  let fs = [f, f]
  arr_rt(fs)   //~ E0401
}

pub fn gen_b_id_to_pure(c: Bool) -> U32 {
  let f = if c { b } else { id }
  at_pure(f)   //~ E0401
}

pub fn gen_b_id_call_in_pure(c: Bool) -> U32 { (if c { b } else { id }).(1) }   //~ E0601

pub fn gen_b_id_type_pure(c: Bool) -> U32 {
  let f = if c { b } else { id }
  let fs = [f, f]
  arr_pure(fs)   //~ E0401
}

pub fn gen_match_id_r_stricter(n: U32) -> U32 {
  let f = match n { 0 => id, _ => r }
  at_rt(f)   //~ E0401
}

pub fn gen_array_id_r_stricter(c: Bool) -> U32 {
  let fs = [id, r]
  arr_rt(fs)   //~ E0401
}

pub fn var_arm_some_first_k(c: Bool) -> U32 {
  let v = None
  let f = match v { Some(g) => g, None => r }
  var h = f
  h = b   //~ E0401
  at_pure(h)
}

pub fn var_arm_none_first_k(c: Bool) -> U32 {
  let v = None
  let f = match v { None => r, Some(g) => g }
  var h = f
  h = b   //~ E0401
  at_pure(h)
}
