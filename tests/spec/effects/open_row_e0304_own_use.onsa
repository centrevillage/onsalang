// onsa.toml
// [test]
// spec = ["§18.1", "§8.1", "§15.1"]

// W6-03 U7a, S-691 (the note of 2026-11-15), §18.1: a `use` of a name of the prelude is an E0304 (§15.1), and the name is not read
// (S-675); the `Alloc` of the row may have meant the effect `Alloc`, so the interpolation of the body is no E0601.
use std.core.Alloc   //~ E0304

pub fn shown(x: U32) -> U32 uses {Alloc} {
  let _ = "{x}"
  x
}
