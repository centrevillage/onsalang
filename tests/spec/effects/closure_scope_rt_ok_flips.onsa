// onsa.toml
// [test]
// spec = ["§8.1", "§10", "§4.7"]
// fixes = 0

// W6-03 U5/t, R-451, S-1032 (§8.1: "`rt` でない無名関数の本体は、外側が `rt` でも `rt fn` の規則で検査しない"; §10: "無名関数は、`rt fn` の型を期待する位置に書いたものだけが `rt` である ... `rt` の関数の中で `rt` でない
// 無名関数を呼ぶと E0901"): this file has no error. An anonymous function that is written in an `rt` function and is not in a place where an `rt fn` type is expected is not `rt`, so its body is not checked by the rules of an `rt fn`:
// it may call a function that is not `rt`, or a function value that is not `rt`. What the `rt` function does is to make the value and pass it on (return it, give it to a parameter that is not `rt`, put it in a field,
// bind it and pass it on, join it with an `rt` function), and not to call it (the call of a value that is not `rt` is an E0901 in an `rt` function, which is in closure_scope_rt_value_call_kept.onsa). Today the body
// is counted in the `rt` function, and each of them is an E0901 at the call that the body makes. The forms in which the body is checked by the rules of `rt` are in closure_scope_rt_neg.onsa. Each binding is read (E0309).

pub struct Slot {
  f: fn(U32) -> U32,
}

pub fn heavy(n: U32) -> U32 { n }

const SLOW: fn(U32) -> U32 = heavy

pub rt fn fast(n: U32) -> U32 { n }

pub rt fn take_f(f: fn(U32) -> U32) -> U32 { 1 }

pub rt fn returns_a_closure() -> fn(U32) -> U32 {
  fn(y: U32) -> U32 { heavy(y) }
}

pub rt fn returns_a_closure_that_calls_a_value() -> fn(U32) -> U32 {
  fn(y: U32) -> U32 { SLOW.(y) }
}

pub rt fn passes_a_closure(n: U32) -> U32 {
  take_f(fn(y: U32) -> U32 { heavy(y) })
}

pub rt fn binds_a_closure_and_passes_it_on(n: U32) -> U32 {
  let l = fn(y: U32) -> U32 { heavy(y) }
  take_f(l)
}

pub rt fn puts_a_closure_in_a_field(n: U32) -> Slot {
  Slot { f: fn(y: U32) -> U32 { heavy(y) } }
}

pub rt fn joins_a_closure_with_an_rt_function(c: Bool) -> U32 {
  let f = if c { fast } else { fn(y: U32) -> U32 { heavy(y) } }
  take_f(f)
}

pub rt fn nested_in_a_closure_that_is_not_rt(n: U32) -> U32 {
  take_f(fn(y: U32) -> U32 { take_f(fn(z: U32) -> U32 { heavy(z) }) })
}
