// W6-03 U5/t, S-1032, R-359 (§8.1: "診断は最初の使用の位置に置く。`rt` でない関数では、効果行への追加（署名への挿入）を修正候補に示し"; "本体の使用は外側の関数と外側の無名関数の効果行に数えず"; §18.1: "報告は単位ごとに
// 一つ ... 診断の並べ方で最初のもの"): a function that has a use of `Alloc` of its own and writes an anonymous function (that is expected to be pure) that uses `Alloc` too has two uses that its rows do not hold, in two
// scopes. The function is one unit, so one error is reported, the first by position: the use of the function, which is before the anonymous function in every function of this file, with the candidate that inserts
// ` uses {Alloc}` into the signature. After that candidate the function has `Alloc`, but the anonymous function has the row of its type, so its use is still an E0601 (the error of the same stage that is `leaves`,
// at the place that it has after the candidate, which is the place that it had: the signature line is not the line of the anonymous function). The first use of the function is a call, the drop of an owned local
// (the name of the binding), an interpolation, the drop of an owned parameter (the name, on the signature line) and a call in a function that writes `uses {}`. Today the use in the anonymous function is counted
// in the function, so nothing is left after the candidate.

pub fn mk(n: U32) -> U32 uses {Alloc} { n }

pub fn ap(f: fn(U32) -> U32, x: U32) -> U32 { f.(x) }

pub fn outer_call_first(n: U32) -> U32 uses {Alloc} {
  let a = mk(n)   //~ E0601 @11
  ap(fn(y: U32) -> U32 { mk(y) }, a)
}

pub fn outer_buffer_first(n: U32) -> U32 uses {Alloc} {
  let b: Buf[F32] = Buf.zeroed(n)   //~ E0601 @7
  ap(fn(y: U32) -> U32 { mk(y) }, b.len())
}

pub fn outer_interpolation_first(n: U32) -> U32 uses {Alloc} {
  let s = "{n}"   //~ E0601 @7
  ap(fn(y: U32) -> U32 { mk(y) }, s.len())
}

pub fn outer_parameter_first(move t: Buf[F32], n: U32) -> U32 uses {Alloc} {   //~ E0601 @35
  ap(fn(y: U32) -> U32 { mk(y) }, n)
}

pub fn outer_empty_row_first(n: U32) -> U32 uses {Alloc} {
  let a = mk(n)   //~ E0601 @11
  ap(fn(y: U32) -> U32 { mk(y) }, a)
}
