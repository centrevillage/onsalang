// onsa.toml
// [test]
// spec = ["§4.7", "§8.1", "§10"]

// W6-01 U2b/t, S-1031 (§4.7, "関数型の合わせ": the type of an `if` or a `match` with no expected type is the join of the types of its branches, and "書く順によらない"). The branches that are
// not a plain name: the block that ends in the value after a statement (`if c { let _ = 1 ... k }`, and an arm that is a block), a value in parentheses, the whole join in parentheses,
// a join in a branch of a join (`if c { if d { X } else { Y } } else { Z }` and in the else branch, `else if` chains, a `match` in an `if` and an `if` in a `match`, a `match` in a `match`),
// and the arms that have a guard (`x if x > 3 => X`; the guard is not a part of the type). The type is the join of the leaves, in whatever order (the union of the effect rows, `rt` only if every leaf
// is `rt`); the leaf that is not `rt` in an inner join makes the outer join not `rt` too (`if c { if d { r } else { k } } else { r }`). The type is tried at the places that are exactly it and at the weaker
// places, as in fn_join_if_ok.onsa. The refused uses are in fn_join_passthrough_neg.onsa. Checked, not run.

pub fn k(x: U32) -> U32 {
  x
}

pub rt fn r(x: U32) -> U32 {
  x
}

pub fn b(x: U32) -> U32 uses {Alloc} {
  x
}

// The places the joined type is tried at: an `rt` place, a place with an empty effect row, a place with `uses {Alloc}`, and the same three
// in an array type (an element of a type argument is compared as equal, so these say what the type of the join is).
pub rt fn at_rt(g: rt fn(U32) -> U32) -> U32 {
  g.(1)
}

pub fn at_pure(g: fn(U32) -> U32) -> U32 {
  g.(1)
}

pub fn at_alloc(g: fn(U32) -> U32 uses {Alloc}) -> U32 uses {Alloc} {
  g.(1)
}

pub rt fn arr_rt(a: [rt fn(U32) -> U32; 2]) -> U32 {
  a[0].(1)
}

pub fn arr_pure(a: [fn(U32) -> U32; 2]) -> U32 {
  a[0].(1)
}

pub fn arr_alloc(a: [fn(U32) -> U32 uses {Alloc}; 2]) -> U32 uses {Alloc} {
  a[0].(1)
}

pub rt fn arr3_rt(a: [rt fn(U32) -> U32; 3]) -> U32 {
  a[0].(1)
}

pub fn arr3_pure(a: [fn(U32) -> U32; 3]) -> U32 {
  a[0].(1)
}

pub fn arr3_alloc(a: [fn(U32) -> U32 uses {Alloc}; 3]) -> U32 uses {Alloc} {
  a[0].(1)
}

pub fn block_rk_exact(c: Bool) -> U32 {
  let f = if c {
    let _ = 1
    r
  } else {
    let _ = 2
    k
  }
  f.(1) + at_pure(f)
}

pub fn block_rk_weaker(c: Bool) -> U32 uses {Alloc} {
  let f = if c {
    let _ = 1
    r
  } else {
    let _ = 2
    k
  }
  f.(1) + at_alloc(f)
}

pub fn block_rk_type(c: Bool) -> U32 {
  let f = if c {
    let _ = 1
    r
  } else {
    let _ = 2
    k
  }
  let fs = [f, f]
  arr_pure(fs)
}

pub fn block_kb_exact(c: Bool) -> U32 uses {Alloc} {
  let f = if c {
    let _ = 1
    k
  } else {
