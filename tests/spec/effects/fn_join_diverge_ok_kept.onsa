pub rt fn match_return_r_exact(n: U32) -> U32 {
  let f = match n { 0 => r, _ => { return 0 } }
  f.(1) + at_rt(f)
}

pub fn match_return_r_weaker(n: U32) -> U32 uses {Alloc} {
  let f = match n { 0 => r, _ => { return 0 } }
  at_pure(f) + at_alloc(f)
}

