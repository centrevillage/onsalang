// onsa.toml
// [test]
// spec = ["§4.7", "§8.1", "§10"]

// W6-01 U2b/t, S-1031 (§4.7, §8.1, §10). The refused uses of the type of a `match` with no expected type, with two or three arms (see fn_join_match_ok.onsa): with an arm that is
// `b` the joined type has `uses {Alloc}` (E0401 at an empty-row place and at an `rt` place; E0601 for the call in a function with an empty effect row); with an arm that is not `r`
// it is not `rt` (E0401 at an `rt` place; E0901 for the call in an `rt` function). The order of the arms does not change the type: the three arms `k`, `b` and `r` give
// the same type in all six orders. Checked, not run.
//
// The units of this file are the ones that the code before U2b already answers as written here; they are kept apart from the units that need the join (in fn_join_match_neg.onsa), so that a change in them is not hidden by that file.

pub fn k(x: U32) -> U32 {
  x
}

pub rt fn r(x: U32) -> U32 {
  x
}

pub fn b(x: U32) -> U32 uses {Alloc} {
  x
}

// The places the joined type is tried at: an `rt` place, a place with an empty effect row, a place with `uses {Alloc}`, and the same three
// in an array type (an element of a type argument is compared as equal, so these say what the type of the join is).
pub rt fn at_rt(g: rt fn(U32) -> U32) -> U32 {
  g.(1)
}

pub fn at_pure(g: fn(U32) -> U32) -> U32 {
  g.(1)
}

pub fn at_alloc(g: fn(U32) -> U32 uses {Alloc}) -> U32 uses {Alloc} {
  g.(1)
}

pub rt fn arr_rt(a: [rt fn(U32) -> U32; 2]) -> U32 {
  a[0].(1)
}

pub fn arr_pure(a: [fn(U32) -> U32; 2]) -> U32 {
  a[0].(1)
}

pub fn arr_alloc(a: [fn(U32) -> U32 uses {Alloc}; 2]) -> U32 uses {Alloc} {
  a[0].(1)
}

pub rt fn arr3_rt(a: [rt fn(U32) -> U32; 3]) -> U32 {
  a[0].(1)
}

pub fn arr3_pure(a: [fn(U32) -> U32; 3]) -> U32 {
  a[0].(1)
}

pub fn arr3_alloc(a: [fn(U32) -> U32 uses {Alloc}; 3]) -> U32 uses {Alloc} {
  a[0].(1)
}

pub fn match2_kr_to_rt(n: U32) -> U32 {
  let f = match n {
    0 => k,
    _ => r,
  }
  at_rt(f)   //~ E0401
}

pub rt fn match2_kr_call_in_rt(n: U32) -> U32 { (match n { 0 => k, _ => r }).(1) }   //~ E0901

pub fn match2_kr_type_alloc(n: U32) -> U32 uses {Alloc} {
  let f = match n {
    0 => k,
    _ => r,
  }
  let fs = [f, f]
  arr_alloc(fs)   //~ E0401
}

pub fn match2_kr_type_rt(n: U32) -> U32 {
  let f = match n {
    0 => k,
    _ => r,
  }
  let fs = [f, f]
  arr_rt(fs)   //~ E0401
}

pub fn match2_rr_type_pure(n: U32) -> U32 {
  let f = match n {
    0 => r,
    _ => r,
  }
  let fs = [f, f]
  arr_pure(fs)   //~ E0401
}

pub fn match2_rr_type_alloc(n: U32) -> U32 uses {Alloc} {
  let f = match n {
    0 => r,
    _ => r,
  }
  let fs = [f, f]
