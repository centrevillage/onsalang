// onsa.toml
// [test]
// spec = ["§8.1", "§8.2", "§15.1", "§18.1"]
// fixes = 1

// The same for the effect of another module (`Random` of `std.random`, S-659 (B)), in an anonymous
// function: one candidate, the `use` of the name at the top of the module.

pub fn closure() -> U32 {
  let g = fn(x: U32) -> U32 uses {Random} { x }   //~ E0302
  1
}
