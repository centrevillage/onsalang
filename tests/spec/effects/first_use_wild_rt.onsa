// onsa.toml
// [test]
// spec = ["§8.1", "§5.4", "§12.2", "§18.1"]
// fixes = 0

// W6-03 U4a/t, S-783, S-82, R-87 (6) (§8.1: "束縛しなかった部分はそれを書いた所（`_`）"; §5.4: what the pattern of an owned head leaves unbound is dropped, at the end of the statement for a `let` and at the end of the arm for a
// `match`): the part that a pattern does not bind needs `Alloc` for its drop (a `Buf`), and the use is at the `_` that leaves it: the `_` of a `let _ = e`, the `_` of a field in a `let` pattern, the `_` of an arm,
// the last `_` of a struct pattern (it leaves the other fields), the `_` of an arm that binds nothing. The call that makes the value (`mk_k`) is a call of an `rt fn` without `Alloc`, so it is no use. The
// parameter `move _: K` is on the heading line, and the position is the whole parameter (S-1051, decided (1); §8.1: "`move _` の引数は引数の全体"), so the column is that of `move` (@22). One error per function (P-01).
// An `rt fn` has no candidate (`fixes = 0`; §10 rule 1). The same forms in a `fn` are in first_use_wild_fn.onsa.

pub struct K {
  b: Buf[F32],
  n: U32,
}

pub rt fn mk_k(move b: Buf[F32]) -> K { K { b: move b, n: 1 } }

pub rt fn let_wild(move b: Buf[F32]) {
  let _ = mk_k(move b)   //~ E0601 @7
}

pub rt fn let_field_wild(move b: Buf[F32]) -> U32 {
  let K { b: _, n: q } = mk_k(move b)   //~ E0601 @14
  q
}

pub rt fn arm_wild(move o: Option[Buf[F32]]) -> U32 {
  match move o {
    Some(_) => 1,   //~ E0601 @10
    None => 0,
  }
}

pub rt fn struct_rest(move k: K) -> U32 {
  match move k {
    K { n: q, _ } => q,   //~ E0601 @15
  }
}

pub rt fn arm_binds_nothing(move b: Buf[F32]) -> U32 {
  match mk_k(move b) {
    _ => 0,   //~ E0601 @5
  }
}

pub rt fn param_wild(move _: K) {}   //~ E0601 @22
