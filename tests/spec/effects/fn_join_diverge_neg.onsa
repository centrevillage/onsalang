// onsa.toml
// [test]
// spec = ["§4.7", "§8.1", "§10"]

// W6-01 U2b/t, S-1031 (§4.7, §8.1, §10). The refused uses of the values of fn_join_diverge_ok.onsa (see there): a diverging branch does not make the join stronger than the leaves that are left. With the leaf
// `k` the join is not `rt` (E0401 at an `rt` place, E0901 for the call in an `rt` function), with the leaf `b` it has `uses {Alloc}` (E0401 at an empty-row place, E0601 for the call in a function with an empty row,
// written on one line so that the mark is the same at the heading and at the use); with the leaf `r` it is `rt` and so is not the type of an array of a weaker type (`arr_pure`, `arr_alloc` are E0401). Checked, not run.

pub fn k(x: U32) -> U32 {
  x
}

pub rt fn r(x: U32) -> U32 {
  x
}

pub fn b(x: U32) -> U32 uses {Alloc} {
  x
}

// The places the joined type is tried at: an `rt` place, a place with an empty effect row, a place with `uses {Alloc}`, and the same three
// in an array type (an element of a type argument is compared as equal, so these say what the type of the join is).
pub rt fn at_rt(g: rt fn(U32) -> U32) -> U32 {
  g.(1)
}

pub fn at_pure(g: fn(U32) -> U32) -> U32 {
  g.(1)
}

pub fn at_alloc(g: fn(U32) -> U32 uses {Alloc}) -> U32 uses {Alloc} {
  g.(1)
}

pub rt fn arr_rt(a: [rt fn(U32) -> U32; 2]) -> U32 {
  a[0].(1)
}

pub fn arr_pure(a: [fn(U32) -> U32; 2]) -> U32 {
  a[0].(1)
}

pub fn arr_alloc(a: [fn(U32) -> U32 uses {Alloc}; 2]) -> U32 uses {Alloc} {
  a[0].(1)
}

pub rt fn arr3_rt(a: [rt fn(U32) -> U32; 3]) -> U32 {
  a[0].(1)
}

pub fn arr3_pure(a: [fn(U32) -> U32; 3]) -> U32 {
  a[0].(1)
}

pub fn arr3_alloc(a: [fn(U32) -> U32 uses {Alloc}; 3]) -> U32 uses {Alloc} {
  a[0].(1)
}

pub fn match_middle_rk_to_rt(n: U32) -> U32 {
  let f = match n { 0 => r, 1 => panic("x"), _ => k }
  at_rt(f)   //~ E0401
}

pub rt fn match_middle_rk_call_in_rt(n: U32) -> U32 { (match n { 0 => r, 1 => panic("x"), _ => k }).(1) }   //~ E0901

pub fn match_middle_rk_type_alloc(n: U32) -> U32 uses {Alloc} {
  let f = match n { 0 => r, 1 => panic("x"), _ => k }
  let fs = [f, f]
  arr_alloc(fs)   //~ E0401
}

pub fn match_middle_rk_type_rt(n: U32) -> U32 {
  let f = match n { 0 => r, 1 => panic("x"), _ => k }
  let fs = [f, f]
  arr_rt(fs)   //~ E0401
}

pub fn match_middle_kb_to_pure(n: U32) -> U32 {
  let f = match n { 0 => k, 1 => panic("x"), _ => b }
  at_pure(f)   //~ E0401
}

pub fn match_middle_kb_call_in_pure(n: U32) -> U32 { (match n { 0 => k, 1 => panic("x"), _ => b }).(1) }   //~ E0601

pub fn match_middle_kb_to_rt(n: U32) -> U32 {
  let f = match n { 0 => k, 1 => panic("x"), _ => b }
  at_rt(f)   //~ E0401
}

pub fn match_middle_kb_type_pure(n: U32) -> U32 {
  let f = match n { 0 => k, 1 => panic("x"), _ => b }
  let fs = [f, f]
  arr_pure(fs)   //~ E0401
}

pub fn match_middle_kb_type_rt(n: U32) -> U32 {
  let f = match n { 0 => k, 1 => panic("x"), _ => b }
  let fs = [f, f]
  arr_rt(fs)   //~ E0401
}

pub fn elseif_middle_rk_to_rt(c: Bool, d: Bool) -> U32 {
  let f = if c { r } else if d { panic("x") } else { k }
  at_rt(f)   //~ E0401
}

pub rt fn elseif_middle_rk_call_in_rt(c: Bool, d: Bool) -> U32 { (if c { r } else if d { panic("x") } else { k }).(1) }   //~ E0901

pub fn elseif_middle_rk_type_alloc(c: Bool, d: Bool) -> U32 uses {Alloc} {
  let f = if c { r } else if d { panic("x") } else { k }
  let fs = [f, f]
  arr_alloc(fs)   //~ E0401
}

pub fn elseif_middle_rk_type_rt(c: Bool, d: Bool) -> U32 {
  let f = if c { r } else if d { panic("x") } else { k }
  let fs = [f, f]
  arr_rt(fs)   //~ E0401
}

pub fn elseif_middle_kb_to_pure(c: Bool, d: Bool) -> U32 {
  let f = if c { k } else if d { panic("x") } else { b }
  at_pure(f)   //~ E0401
}

pub fn elseif_middle_kb_call_in_pure(c: Bool, d: Bool) -> U32 { (if c { k } else if d { panic("x") } else { b }).(1) }   //~ E0601

pub fn elseif_middle_kb_to_rt(c: Bool, d: Bool) -> U32 {
  let f = if c { k } else if d { panic("x") } else { b }
  at_rt(f)   //~ E0401
}

pub fn elseif_middle_kb_type_pure(c: Bool, d: Bool) -> U32 {
  let f = if c { k } else if d { panic("x") } else { b }
  let fs = [f, f]
  arr_pure(fs)   //~ E0401
}

pub fn elseif_middle_kb_type_rt(c: Bool, d: Bool) -> U32 {
  let f = if c { k } else if d { panic("x") } else { b }
  let fs = [f, f]
  arr_rt(fs)   //~ E0401
}
