// onsa.toml
// [test]
// spec = ["§4.7", "§8.1", "§10"]

// W6-01 U2b/t, S-1031 (§4.7, "関数型の合わせ": "期待型の無い `if`・`match`・配列のリテラル（期待型が未決の型変数そのものである場合を含む）で ... 式の型はそれらを合わせた関数型である。
// ... 効果行は和、`rt` は全ての枝が `rt` のときだけ付く ... 書く順によらない"). The expected type is an undecided type variable itself, not a type: the tail of a lambda with no
// annotation (`fn(d: Bool) { if d { X } else { Y } }`, the type of its result is not known yet), the argument of `Some` (`Some(if c { X } else { Y })`), an array literal that is the
// argument of `first[T](xs: [T; 2]) -> T`, the field of `struct W[T]` (`W { h: if c { X } else { Y } }`) and the first argument of `pick[T](a: T, c: T) -> T` (`pick(if c { X } else { Y }, Z)`,
// where Z is `k`, or `r` when both X and Y are). The pairs are `r` and `k`, `k` and `r`, `k` and `b`, `b` and `k`, `r` and `r`, `r` and `b`: the union of the effect rows, and `rt` only for `r` and `r`,
// whatever the order. The type is tried by passing the value at the place that is exactly its type (`at_rt`, `at_pure`, `at_alloc`; for the type in `Option` and in `W`, the function whose parameter is
// that type, the elements of a type argument being compared as equal). The refused uses are in fn_join_open_var_neg.onsa. A lambda is called only from a function that is not `rt`
// (a lambda that has no annotation is not `rt`; what a lambda takes from its place is W6-03). Checked, not run.
//
// The units of this file are the ones that the code before U2b already answers as written here; they are kept apart from the units that need the join (in fn_join_open_var_ok.onsa), so that a change in them is not hidden by that file.

pub fn k(x: U32) -> U32 {
  x
}

pub rt fn r(x: U32) -> U32 {
  x
}

pub fn b(x: U32) -> U32 uses {Alloc} {
  x
}

// The places the joined type is tried at: an `rt` place, a place with an empty effect row, a place with `uses {Alloc}`, and the same three
// in an array type (an element of a type argument is compared as equal, so these say what the type of the join is).
pub rt fn at_rt(g: rt fn(U32) -> U32) -> U32 {
  g.(1)
}

pub fn at_pure(g: fn(U32) -> U32) -> U32 {
  g.(1)
}

pub fn at_alloc(g: fn(U32) -> U32 uses {Alloc}) -> U32 uses {Alloc} {
  g.(1)
}

pub rt fn arr_rt(a: [rt fn(U32) -> U32; 2]) -> U32 {
  a[0].(1)
}

pub fn arr_pure(a: [fn(U32) -> U32; 2]) -> U32 {
  a[0].(1)
}

pub fn arr_alloc(a: [fn(U32) -> U32 uses {Alloc}; 2]) -> U32 uses {Alloc} {
  a[0].(1)
}

pub rt fn arr3_rt(a: [rt fn(U32) -> U32; 3]) -> U32 {
  a[0].(1)
}

pub fn arr3_pure(a: [fn(U32) -> U32; 3]) -> U32 {
  a[0].(1)
}

pub fn arr3_alloc(a: [fn(U32) -> U32 uses {Alloc}; 3]) -> U32 uses {Alloc} {
  a[0].(1)
}

pub fn first[T](xs: [T; 2]) -> T {
  xs[0]
}

pub fn pick[T](a: T, c: T) -> T {
  a
}

pub struct W[T] {
  h: T,
}

pub fn opt_rt(o: Option[rt fn(U32) -> U32]) -> U32 {
  match o {
    Some(f) => f.(1),
    None => 0,
  }
}

pub fn opt_pure(o: Option[fn(U32) -> U32]) -> U32 {
  match o {
    Some(f) => f.(1),
    None => 0,
  }
}

pub fn opt_alloc(o: Option[fn(U32) -> U32 uses {Alloc}]) -> U32 uses {Alloc} {
  match o {
    Some(f) => f.(1),
    None => 0,
  }
}

pub fn w_rt(w: W[rt fn(U32) -> U32]) -> U32 {
  w.h.(1)
}

pub fn w_pure(w: W[fn(U32) -> U32]) -> U32 {
  w.h.(1)
}

pub fn w_alloc(w: W[fn(U32) -> U32 uses {Alloc}]) -> U32 uses {Alloc} {
  w.h.(1)
}

pub fn lam_kr_exact(c: Bool) -> U32 {
  let g = fn(d: Bool) { if d { k } else { r } }
  let f = g.(c)
  at_pure(f)
}

pub fn lam_kr_type(c: Bool) -> U32 {
  let g = fn(d: Bool) { if d { k } else { r } }
  let f = g.(c)
  let fs = [f, f]
  arr_pure(fs)
}

pub fn lam_bk_exact(c: Bool) -> U32 uses {Alloc} {
  let g = fn(d: Bool) { if d { b } else { k } }
  let f = g.(c)
  at_alloc(f)
}

pub fn lam_bk_type(c: Bool) -> U32 uses {Alloc} {
  let g = fn(d: Bool) { if d { b } else { k } }
  let f = g.(c)
  let fs = [f, f]
  arr_alloc(fs)
}

pub fn lam_rr_exact(c: Bool) -> U32 {
  let g = fn(d: Bool) { if d { r } else { r } }
  let f = g.(c)
  at_rt(f)
}

pub fn lam_rr_type(c: Bool) -> U32 {
  let g = fn(d: Bool) { if d { r } else { r } }
  let f = g.(c)
  let fs = [f, f]
  arr_rt(fs)
}

pub fn some_kr_exact(c: Bool) -> U32 {
  let v = Some(if c { k } else { r })
  opt_pure(v)
}

pub fn some_bk_exact(c: Bool) -> U32 uses {Alloc} {
  let v = Some(if c { b } else { k })
  opt_alloc(v)
}

pub fn some_rr_exact(c: Bool) -> U32 {
  let v = Some(if c { r } else { r })
  opt_rt(v)
}

pub fn first_kr_exact(c: Bool) -> U32 {
  let f = first([k, r])
  at_pure(f)
}

pub fn first_kr_type(c: Bool) -> U32 {
  let f = first([k, r])
  let fs = [f, f]
  arr_pure(fs)
}

pub fn first_bk_exact(c: Bool) -> U32 uses {Alloc} {
  let f = first([b, k])
  at_alloc(f)
}

pub fn first_bk_type(c: Bool) -> U32 uses {Alloc} {
  let f = first([b, k])
  let fs = [f, f]
  arr_alloc(fs)
}

pub fn first_rr_exact(c: Bool) -> U32 {
  let f = first([r, r])
  at_rt(f)
}

pub fn first_rr_type(c: Bool) -> U32 {
  let f = first([r, r])
  let fs = [f, f]
  arr_rt(fs)
}

pub fn wstruct_kr_exact(c: Bool) -> U32 {
  let v = W { h: if c { k } else { r } }
  w_pure(v)
}

pub fn wstruct_bk_exact(c: Bool) -> U32 uses {Alloc} {
  let v = W { h: if c { b } else { k } }
  w_alloc(v)
}

pub fn wstruct_rr_exact(c: Bool) -> U32 {
  let v = W { h: if c { r } else { r } }
  w_rt(v)
}

pub fn pick_kr_exact(c: Bool) -> U32 {
  let f = pick(if c { k } else { r }, k)
  at_pure(f)
}

pub fn pick_kr_type(c: Bool) -> U32 {
  let f = pick(if c { k } else { r }, k)
  let fs = [f, f]
  arr_pure(fs)
}

pub fn pick_bk_exact(c: Bool) -> U32 uses {Alloc} {
  let f = pick(if c { b } else { k }, k)
  at_alloc(f)
}

pub fn pick_bk_type(c: Bool) -> U32 uses {Alloc} {
  let f = pick(if c { b } else { k }, k)
  let fs = [f, f]
  arr_alloc(fs)
}

pub fn pick_rr_exact(c: Bool) -> U32 {
  let f = pick(if c { r } else { r }, r)
  at_rt(f)
}

pub fn pick_rr_type(c: Bool) -> U32 {
  let f = pick(if c { r } else { r }, r)
  let fs = [f, f]
  arr_rt(fs)
}
