// onsa.toml
// [test]
// spec = ["§8.1", "§10", "§18.1"]
// fixes = 0

// W6-03 U5/t, S-1032, R-27 (1) (§8.1: "本体の使用は外側の関数と外側の無名関数の効果行に数えず"): an anonymous function that is written in another anonymous function is a scope of its own. A use in the
// inner one is checked against the row of the inner one (the parameter it is given to, the annotation, nothing), and it is not a use of the outer anonymous function, whatever the row of the outer one is
// (a written `uses {Alloc}` does not cover what the inner one uses: `outer_row_does_not_cover_inner`). A use that the outer anonymous function makes outside of the inner one is checked against the row of
// the outer one: `outer_closure_own_use` is the use of the outer one, and the inner one that uses nothing is fine. When both have a use, the first by position is reported (`outer_use_comes_first`,
// `inner_use_comes_first`). An inner anonymous function in an `rt` anonymous function is `rt` only where an `rt fn` type is expected (`rt_inner_in_rt_outer`): the call of what is not `rt` is the E0901 of the
// inner one, and it is not a call of the outer one. There is no candidate (`fixes = 0`). The forms that are fine are in closure_scope_ok_flips.onsa and closure_scope_ok_kept.onsa. One error per function (P-01).

pub fn mk(n: U32) -> U32 uses {Alloc} { n }

pub fn heavy(n: U32) -> U32 { n }

pub fn ap(f: fn(U32) -> U32, x: U32) -> U32 { f.(x) }

pub fn ap_a(f: fn(U32) -> U32 uses {Alloc}, x: U32) -> U32 uses {Alloc} { f.(x) }

pub rt fn ap_r(f: rt fn(U32) -> U32, x: U32) -> U32 { f.(x) }

pub fn inner_only(n: U32) -> U32 uses {Alloc} {
  ap_a(fn(y: U32) -> U32 { ap(fn(z: U32) -> U32 { mk(z) }, y) }, n)   //~ E0601 @51
}

pub fn outer_row_does_not_cover_inner(n: U32) -> U32 uses {Alloc} {
  ap_a(fn(y: U32) -> U32 uses {Alloc} { ap(fn(z: U32) -> U32 { mk(z) }, y) }, n)   //~ E0601 @64
}

pub fn outer_closure_own_use(n: U32) -> U32 uses {Alloc} {
  ap(fn(y: U32) -> U32 { ap(fn(z: U32) -> U32 { z }, mk(y)) }, n)   //~ E0601 @54
}

pub fn outer_use_comes_first(n: U32) -> U32 uses {Alloc} {
  ap(fn(y: U32) -> U32 {
    let a = mk(y)   //~ E0601 @13
    ap(fn(z: U32) -> U32 { mk(z) }, a)
  }, n)
}

pub fn inner_use_comes_first(n: U32) -> U32 uses {Alloc} {
  ap(fn(y: U32) -> U32 {
    let a = ap(fn(z: U32) -> U32 { mk(z) }, y)   //~ E0601 @36
    mk(a)
  }, n)
}

pub fn three_levels(n: U32) -> U32 uses {Alloc} {
  ap_a(fn(y: U32) -> U32 { ap_a(fn(z: U32) -> U32 { ap(fn(w: U32) -> U32 { mk(w) }, z) }, y) }, n)   //~ E0601 @76
}

pub fn rt_inner_in_rt_outer(n: U32) -> U32 {
  ap_r(fn(y: U32) -> U32 { ap_r(fn(z: U32) -> U32 { heavy(z) }, y) }, n)   //~ E0901 @53
}
