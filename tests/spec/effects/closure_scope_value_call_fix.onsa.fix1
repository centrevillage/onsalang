// onsa.toml
// [test]
// spec = ["§8.1", "§12.2", "§18.1"]
// fixes = 1

// W6-03 U5/t, S-1032 (§8.1: "本体の使用は外側の関数と外側の無名関数の効果行に数えず ... 外側が数えるのは、その関数値の呼び出しである"): what the outer function counts of an anonymous function is the call of the function value
// (`l.(n)`, the row of its type) and the call of the function that takes it (`ap_a(...)`, the row of that function); the body of the anonymous function is not counted. So the function that writes an anonymous
// function with `uses {Alloc}` written, and that has no `uses {Alloc}` itself, is an E0601 at the call of the value, and the body that uses `Alloc` is fine (the row that is written has it). The
// candidate is the insertion of ` uses {Alloc}` into the signature of the outer function, as for any use that its own body makes, and nothing is left after it (the anonymous function
// has its row; the copy `.fix1` shows the result: it has no error). Today the use in the body is counted in the outer function first, and it is reported at the place of the body, which is another place. One error per function (P-01).

pub fn mk(n: U32) -> U32 uses {Alloc} { n }

pub fn ap_a(f: fn(U32) -> U32 uses {Alloc}, x: U32) -> U32 uses {Alloc} { f.(x) }

pub fn value_call_counts(n: U32) -> U32 uses {Alloc} {
  let l = fn(y: U32) -> U32 uses {Alloc} { mk(y) }
  l.(n)   //~ E0601 @3
}

pub fn value_call_in_place(n: U32) -> U32 uses {Alloc} {
  (fn(y: U32) -> U32 uses {Alloc} { mk(y) }).(n)   //~ E0601 @3
}

pub fn call_of_the_function_that_takes_it(n: U32) -> U32 uses {Alloc} {
  ap_a(fn(y: U32) -> U32 { mk(y) }, n)   //~ E0601 @3
}
