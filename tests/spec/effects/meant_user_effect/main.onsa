// onsa.toml
// [test]
// spec = ["§18.1", "§8.1"]

// W6-04 U7, R-463, §18.1 (what a name not read may have meant is each effect of the name of the last part of its path),
// S-1054 (1): the name `Tick` of the failed `use` may have meant the user's `effect` `m.Tick` as it may an effect of
// std, so the row of `f` admits the `Tick` that `g` needs, and the call is no E0601 (the unit of `f` fails by the
// name alone).
use kp.{Tick}   //~ E0302
use m.{g}

pub fn f() uses {Tick} { g() }
