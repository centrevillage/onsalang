pub fn pick_r_then_kr(c: Bool) -> U32 {
  let _ = pick(r, if c { k } else { r })   //~ E0401
  0
}

pub fn pick_r_then_rk(c: Bool) -> U32 {
  let _ = pick(r, if c { r } else { k })   //~ E0401
  0
}

pub fn pick_k_then_bk(c: Bool) -> U32 {
  let _ = pick(k, if c { b } else { k })   //~ E0401
  0
}

pub fn pick_k_then_kb(c: Bool) -> U32 {
  let _ = pick(k, if c { k } else { b })   //~ E0401
  0
}

pub fn pick_r_then_b(c: Bool) -> U32 {
  let _ = pick(r, if c { b } else { r })   //~ E0401
  0
}

pub fn pick_k_then_kr_to_rt(c: Bool) -> U32 {
  let f = pick(k, if c { k } else { r })
  at_rt(f)   //~ E0401
}

pub fn pick_b_then_kr_to_pure(c: Bool) -> U32 {
  let f = pick(b, if c { k } else { r })
  at_pure(f)   //~ E0401
}

pub fn pick_type_argument_arm(c: Bool) -> U32 {
  let _ = pick::[fn(U32) -> U32](if c { k } else { b }, k)   //~ E0401
  0
}

pub fn pick_type_argument_rt(c: Bool) -> U32 {
  let _ = pick::[rt fn(U32) -> U32](r, if c { r } else { k })   //~ E0401
  0
}

pub fn var_kr_assign_b(c: Bool) -> U32 {
  var f = if c { k } else { r }
  f = b   //~ E0401
  at_pure(f)
}

pub fn var_rr_assign_k(c: Bool) -> U32 {
  var f = if c { r } else { r }
  f = k   //~ E0401
  at_rt(f)
}

pub fn var_rr_assign_b(c: Bool) -> U32 {
  var f = if c { r } else { r }
  f = b   //~ E0401
  at_rt(f)
}

pub fn lambda_return_r_then_k(c: Bool) -> U32 {
  let g = fn(d: Bool) {
    if d {
      return r
    }
    k   //~ E0401
  }
  at_pure(g.(c))
}

pub fn lambda_return_k_then_b(c: Bool) -> U32 {
  let g = fn(d: Bool) {
    if d {
      return k
    }
    b   //~ E0401
  }
  at_pure(g.(c))
}

pub fn lambda_return_k_to_rt(c: Bool) -> U32 {
  let g = fn(d: Bool) {
    if d {
      return k
    }
    r
  }
  at_rt(g.(c))   //~ E0401
}
