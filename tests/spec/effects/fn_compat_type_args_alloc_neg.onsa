// onsa.toml
// [test]
// spec = ["§8.1", "§4.7"]

// W6-01 U2a/t, R-27 (2), S-1031 (§8.1: "向きを持つのは期待型そのものが関数型である位置だけで、型引数の中の関数型（`Option[F]` と `Option[G]`、配列・タプル・`Span` の要素、
// 総称の型の引数）は `rt` と効果行を含めて完全に一致する"; "引数の型とモード、返り値の型が等しい（… 引数の型の中の関数型も完全に一致する）"). A value that was made before, whose type
// has a function type inside (`Option[fn(U32) -> U32]`, `[fn(U32) -> U32; 2]`, a tuple, the error of a `Result`, a generic struct of the user, a function type that
// has a function type as its parameter), is not used where the same type with the other effect row is wanted: neither where the row is larger (`Option[F]` into
// `Option[G]`, F pure and G `uses {Alloc}`), nor where it is smaller. Each is E0401 (the `?` of an error type that differs is E0414, §9). Before U2a these are
// E0401 already (the rows are compared for equality); the values that are made in place are in fn_compat_alloc_in_place_ok.onsa, and the `rt` of a type argument in fn_compat_type_args_rt_neg.onsa. Checked, not run.

pub fn k(x: U32) -> U32 {
  x
}

pub fn b(x: U32) -> U32 uses {Alloc} {
  x
}

pub struct W[T] {
  h: T,
}

pub struct Holder {
  o: Option[fn(U32) -> U32 uses {Alloc}],
}

pub fn opt_k() -> Option[fn(U32) -> U32] {
  Some(k)
}

pub fn opt_b() -> Option[fn(U32) -> U32 uses {Alloc}] {
  Some(b)
}

pub fn take_option_b(o: Option[fn(U32) -> U32 uses {Alloc}]) -> U32 uses {Alloc} {
  match o {
    Some(f) => f.(1),
    None => 0,
  }
}

pub fn take_option_k(o: Option[fn(U32) -> U32]) -> U32 {
  match o {
    Some(f) => f.(1),
    None => 0,
  }
}

pub fn take_array_b(fs: [fn(U32) -> U32 uses {Alloc}; 2]) -> U32 uses {Alloc} {
  fs[0].(1)
}

pub fn take_array_k(fs: [fn(U32) -> U32; 2]) -> U32 {
  fs[0].(1)
}

pub fn take_tuple_b(t: (fn(U32) -> U32 uses {Alloc}, U32)) -> U32 uses {Alloc} {
  t.0.(t.1)
}

pub fn take_w_b(w: W[fn(U32) -> U32 uses {Alloc}]) -> U32 uses {Alloc} {
  w.h.(1)
}

pub fn take_w_k(w: W[fn(U32) -> U32]) -> U32 {
  w.h.(1)
}

pub fn read_span_b(xs: Span[fn(U32) -> U32 uses {Alloc}]) -> U32 uses {Alloc} {
  xs[0].(1)
}

pub fn read_span_k(xs: Span[fn(U32) -> U32]) -> U32 {
  xs[0].(1)
}

pub fn takes_outer_b(f: fn(fn(U32) -> U32 uses {Alloc}) -> U32 uses {Alloc}) -> U32 uses {Alloc} {
  f.(b)
}

pub fn takes_outer_k(f: fn(fn(U32) -> U32) -> U32) -> U32 {
  f.(k)
}

pub fn outer_with_k(g: fn(U32) -> U32) -> U32 {
  g.(1)
}

pub fn result_error_k() -> Result[U32, fn(U32) -> U32] {
  Err(k)
}

// The value of the type with the row smaller, at the place of the larger one.
pub fn option_as_an_argument() -> U32 uses {Alloc} {
  let o = opt_k()
  take_option_b(o)   //~ E0401
}

pub fn option_of_a_call_result() -> U32 uses {Alloc} {
  take_option_b(opt_k())   //~ E0401
}

pub fn option_in_a_let() -> U32 uses {Alloc} {
  let o: Option[fn(U32) -> U32 uses {Alloc}] = opt_k()   //~ E0401
  take_option_b(o)
}

pub fn option_parameter(o: Option[fn(U32) -> U32]) -> U32 uses {Alloc} {
  take_option_b(o)   //~ E0401
}

pub fn option_returned(o: Option[fn(U32) -> U32]) -> Option[fn(U32) -> U32 uses {Alloc}] {
  o   //~ E0401
}

pub fn option_in_a_field(o: Option[fn(U32) -> U32]) -> Holder {
  Holder { o: o }   //~ E0401
}

pub fn option_assigned(o: Option[fn(U32) -> U32]) -> U32 uses {Alloc} {
  var p = opt_b()
  p = o   //~ E0401
  take_option_b(p)
}

pub fn array_as_an_argument() -> U32 uses {Alloc} {
  let fs = [k, k]
  take_array_b(fs)   //~ E0401
}

pub fn array_parameter(fs: [fn(U32) -> U32; 2]) -> U32 uses {Alloc} {
  take_array_b(fs)   //~ E0401
}

pub fn tuple_as_an_argument() -> U32 uses {Alloc} {
  let t = (k, 1)
  take_tuple_b(t)   //~ E0401
}

pub fn generic_struct_as_an_argument() -> U32 uses {Alloc} {
  let w = W { h: k }
  take_w_b(w)   //~ E0401
}

pub fn generic_struct_parameter(w: W[fn(U32) -> U32]) -> U32 uses {Alloc} {
  take_w_b(w)   //~ E0401
}

pub fn span_of_the_array_read() -> U32 uses {Alloc} {
  let fs = [k, k]
  read_span_b(fs)   //~ E0401
}

pub fn result_error_returned() -> Result[U32, fn(U32) -> U32 uses {Alloc}] {
  let e: Result[U32, fn(U32) -> U32] = Err(k)
  e   //~ E0401
}

pub fn result_error_through_the_question_mark(o: Result[U32, fn(U32) -> U32]) -> Result[U32, fn(U32) -> U32 uses {Alloc}] {
  let x = o?   //~ E0414
  Ok(x)
}

pub fn function_with_a_function_parameter() -> U32 uses {Alloc} {
  takes_outer_b(outer_with_k)   //~ E0401
}

// The value of the type with the row larger, at the place of the smaller one.
pub fn option_larger_as_an_argument() -> U32 {
  let o = opt_b()
  take_option_k(o)   //~ E0401
}

pub fn option_larger_in_a_let() -> U32 {
  let o: Option[fn(U32) -> U32] = opt_b()   //~ E0401
  take_option_k(o)
}

pub fn array_larger_as_an_argument() -> U32 {
  let fs = [b, b]
  take_array_k(fs)   //~ E0401
}

pub fn generic_struct_larger_as_an_argument() -> U32 {
  let w = W { h: b }
  take_w_k(w)   //~ E0401
}

pub fn span_larger_read() -> U32 {
  let fs = [b, b]
  read_span_k(fs)   //~ E0401
}

pub fn function_with_a_function_parameter_larger(f: fn(fn(U32) -> U32 uses {Alloc}) -> U32) -> U32 {
  takes_outer_k(f)   //~ E0401
}

pub fn outer_function_in_an_option() -> U32 {
  let o: Option[fn(fn(U32) -> U32) -> U32] = Some(outer_with_k)
  let _: Option[fn(fn(U32) -> U32 uses {Alloc}) -> U32] = o   //~ E0401
  0
}
