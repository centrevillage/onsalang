// onsa.toml
// [test]
// spec = ["§4.7", "§8.1", "§10"]

// W6-01 U2b/t, S-1031 (§4.7, "関数型の合わせ": the elements of an array literal with no expected type are joined as the arms of an `if` are; §8.1; §10). `let fs = [X, Y]`
// (every pair of `k`, `r` and `b`, in every order) and the arrays of three elements: the type of the elements is the joined type (the union of the effect rows, `rt` only when every
// element is `rt`). The elements are tried at an `rt` place, a place with an empty row and a place with `uses {Alloc}`, and the array as a whole at the array types
// (the elements of a type argument are compared as equal). This file is the accepted uses; fn_join_array_neg.onsa the refused ones. Checked, not run.

pub fn k(x: U32) -> U32 {
  x
}

pub rt fn r(x: U32) -> U32 {
  x
}

pub fn b(x: U32) -> U32 uses {Alloc} {
  x
}

// The places the joined type is tried at: an `rt` place, a place with an empty effect row, a place with `uses {Alloc}`, and the same three
// in an array type (an element of a type argument is compared as equal, so these say what the type of the join is).
pub rt fn at_rt(g: rt fn(U32) -> U32) -> U32 {
  g.(1)
}

pub fn at_pure(g: fn(U32) -> U32) -> U32 {
  g.(1)
}

pub fn at_alloc(g: fn(U32) -> U32 uses {Alloc}) -> U32 uses {Alloc} {
  g.(1)
}

pub rt fn arr_rt(a: [rt fn(U32) -> U32; 2]) -> U32 {
  a[0].(1)
}

pub fn arr_pure(a: [fn(U32) -> U32; 2]) -> U32 {
  a[0].(1)
}

pub fn arr_alloc(a: [fn(U32) -> U32 uses {Alloc}; 2]) -> U32 uses {Alloc} {
  a[0].(1)
}

pub rt fn arr3_rt(a: [rt fn(U32) -> U32; 3]) -> U32 {
  a[0].(1)
}

pub fn arr3_pure(a: [fn(U32) -> U32; 3]) -> U32 {
  a[0].(1)
}

pub fn arr3_alloc(a: [fn(U32) -> U32 uses {Alloc}; 3]) -> U32 uses {Alloc} {
  a[0].(1)
}

pub fn array2_kb_exact(c: Bool) -> U32 uses {Alloc} {
  let fs = [k, b]
  fs[0].(1) + at_alloc(fs[1])
}

pub fn array2_kb_type(c: Bool) -> U32 uses {Alloc} {
  let fs = [k, b]
  arr_alloc(fs)
}

pub fn array2_rk_exact(c: Bool) -> U32 {
  let fs = [r, k]
  fs[0].(1) + at_pure(fs[1])
}

pub fn array2_rk_weaker(c: Bool) -> U32 uses {Alloc} {
  let fs = [r, k]
  fs[0].(1) + at_alloc(fs[1])
}

pub fn array2_rk_type(c: Bool) -> U32 {
  let fs = [r, k]
  arr_pure(fs)
}

pub fn array2_rb_exact(c: Bool) -> U32 uses {Alloc} {
  let fs = [r, b]
  fs[0].(1) + at_alloc(fs[1])
}

pub fn array2_rb_type(c: Bool) -> U32 uses {Alloc} {
  let fs = [r, b]
  arr_alloc(fs)
}

pub fn array3_kbr_exact(c: Bool) -> U32 uses {Alloc} {
  let fs = [k, b, r]
  fs[0].(1) + at_alloc(fs[1])
}

pub fn array3_kbr_type(c: Bool) -> U32 uses {Alloc} {
  let fs = [k, b, r]
  arr3_alloc(fs)
}

pub fn array3_rbk_exact(c: Bool) -> U32 uses {Alloc} {
  let fs = [r, b, k]
  fs[0].(1) + at_alloc(fs[1])
}

pub fn array3_rbk_type(c: Bool) -> U32 uses {Alloc} {
  let fs = [r, b, k]
  arr3_alloc(fs)
}

pub fn array3_rrk_exact(c: Bool) -> U32 {
  let fs = [r, r, k]
  fs[0].(1) + at_pure(fs[1])
}

pub fn array3_rrk_weaker(c: Bool) -> U32 uses {Alloc} {
  let fs = [r, r, k]
  fs[0].(1) + at_alloc(fs[1])
}

pub fn array3_rrk_type(c: Bool) -> U32 {
  let fs = [r, r, k]
  arr3_pure(fs)
}
