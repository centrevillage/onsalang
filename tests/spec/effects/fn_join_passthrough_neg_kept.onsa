pub fn guard_mid_krr_to_rt(n: U32) -> U32 {
  let f = match n { 0 => k, x if x > 3 => r, _ => r }
  at_rt(f)   //~ E0401
}

pub rt fn guard_mid_krr_call_in_rt(n: U32) -> U32 { (match n { 0 => k, x if x > 3 => r, _ => r }).(1) }   //~ E0901

pub fn guard_mid_krr_type_alloc(n: U32) -> U32 uses {Alloc} {
  let f = match n { 0 => k, x if x > 3 => r, _ => r }
  let fs = [f, f]
  arr_alloc(fs)   //~ E0401
}

pub fn guard_mid_krr_type_rt(n: U32) -> U32 {
  let f = match n { 0 => k, x if x > 3 => r, _ => r }
  let fs = [f, f]
  arr_rt(fs)   //~ E0401
}

pub fn arm_block_rr_type_pure(n: U32) -> U32 {
  let f = match n {
    0 => {
      let _ = 1
      r
    },
    _ => r,
  }
  let fs = [f, f]
  arr_pure(fs)   //~ E0401
}

