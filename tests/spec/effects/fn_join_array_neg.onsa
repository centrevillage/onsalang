// onsa.toml
// [test]
// spec = ["§4.7", "§8.1", "§10"]

// W6-01 U2b/t, S-1031 (§4.7, §8.1, §10). The refused uses of the elements of an array literal with no expected type (see fn_join_array_ok.onsa): with an element that is `b` the type of the
// elements has `uses {Alloc}` (E0401 at an empty-row place and at an `rt` place; E0601 for the call in a function with an empty effect row); with an element that is not `r` it is not
// `rt` (E0401 at an `rt` place; E0901 for the call in an `rt` function). The array as a whole does not go to an array type that differs in the effect row or in `rt`, in either
// direction. Checked, not run.

pub fn k(x: U32) -> U32 {
  x
}

pub rt fn r(x: U32) -> U32 {
  x
}

pub fn b(x: U32) -> U32 uses {Alloc} {
  x
}

// The places the joined type is tried at: an `rt` place, a place with an empty effect row, a place with `uses {Alloc}`, and the same three
// in an array type (an element of a type argument is compared as equal, so these say what the type of the join is).
pub rt fn at_rt(g: rt fn(U32) -> U32) -> U32 {
  g.(1)
}

pub fn at_pure(g: fn(U32) -> U32) -> U32 {
  g.(1)
}

pub fn at_alloc(g: fn(U32) -> U32 uses {Alloc}) -> U32 uses {Alloc} {
  g.(1)
}

pub rt fn arr_rt(a: [rt fn(U32) -> U32; 2]) -> U32 {
  a[0].(1)
}

pub fn arr_pure(a: [fn(U32) -> U32; 2]) -> U32 {
  a[0].(1)
}

pub fn arr_alloc(a: [fn(U32) -> U32 uses {Alloc}; 2]) -> U32 uses {Alloc} {
  a[0].(1)
}

pub rt fn arr3_rt(a: [rt fn(U32) -> U32; 3]) -> U32 {
  a[0].(1)
}

pub fn arr3_pure(a: [fn(U32) -> U32; 3]) -> U32 {
  a[0].(1)
}

pub fn arr3_alloc(a: [fn(U32) -> U32 uses {Alloc}; 3]) -> U32 uses {Alloc} {
  a[0].(1)
}

pub fn array2_kb_to_pure(c: Bool) -> U32 {
  let fs = [k, b]
  at_pure(fs[0])   //~ E0401
}

pub fn array2_kb_call_in_pure(c: Bool) -> U32 { [k, b][1].(1) }   //~ E0601

pub fn array2_kb_to_rt(c: Bool) -> U32 {
  let fs = [k, b]
  at_rt(fs[1])   //~ E0401
}

pub fn array2_kb_type_pure(c: Bool) -> U32 {
  let fs = [k, b]
  arr_pure(fs)   //~ E0401
}

pub fn array2_kb_type_rt(c: Bool) -> U32 {
  let fs = [k, b]
  arr_rt(fs)   //~ E0401
}

pub fn array2_rk_to_rt(c: Bool) -> U32 {
  let fs = [r, k]
  at_rt(fs[0])   //~ E0401
}

pub rt fn array2_rk_call_in_rt(c: Bool) -> U32 { [r, k][1].(1) }   //~ E0901

pub fn array2_rk_type_alloc(c: Bool) -> U32 uses {Alloc} {
  let fs = [r, k]
  arr_alloc(fs)   //~ E0401
}

pub fn array2_rk_type_rt(c: Bool) -> U32 {
  let fs = [r, k]
  arr_rt(fs)   //~ E0401
}

pub fn array2_rb_to_pure(c: Bool) -> U32 {
  let fs = [r, b]
  at_pure(fs[0])   //~ E0401
}

pub fn array2_rb_call_in_pure(c: Bool) -> U32 { [r, b][1].(1) }   //~ E0601

pub fn array2_rb_to_rt(c: Bool) -> U32 {
  let fs = [r, b]
  at_rt(fs[1])   //~ E0401
}

pub fn array2_rb_type_pure(c: Bool) -> U32 {
  let fs = [r, b]
  arr_pure(fs)   //~ E0401
}

pub fn array2_rb_type_rt(c: Bool) -> U32 {
  let fs = [r, b]
  arr_rt(fs)   //~ E0401
}

pub fn array3_kbr_to_pure(c: Bool) -> U32 {
  let fs = [k, b, r]
  at_pure(fs[0])   //~ E0401
}

pub fn array3_kbr_call_in_pure(c: Bool) -> U32 { [k, b, r][1].(1) }   //~ E0601

pub fn array3_kbr_to_rt(c: Bool) -> U32 {
  let fs = [k, b, r]
  at_rt(fs[1])   //~ E0401
}

pub fn array3_kbr_type_pure(c: Bool) -> U32 {
  let fs = [k, b, r]
  arr3_pure(fs)   //~ E0401
}

pub fn array3_kbr_type_rt(c: Bool) -> U32 {
  let fs = [k, b, r]
  arr3_rt(fs)   //~ E0401
}

pub fn array3_rbk_to_pure(c: Bool) -> U32 {
  let fs = [r, b, k]
  at_pure(fs[0])   //~ E0401
}

pub fn array3_rbk_call_in_pure(c: Bool) -> U32 { [r, b, k][1].(1) }   //~ E0601

pub fn array3_rbk_to_rt(c: Bool) -> U32 {
  let fs = [r, b, k]
  at_rt(fs[1])   //~ E0401
}

pub fn array3_rbk_type_pure(c: Bool) -> U32 {
  let fs = [r, b, k]
  arr3_pure(fs)   //~ E0401
}

pub fn array3_rbk_type_rt(c: Bool) -> U32 {
  let fs = [r, b, k]
  arr3_rt(fs)   //~ E0401
}

pub fn array3_rrk_to_rt(c: Bool) -> U32 {
  let fs = [r, r, k]
  at_rt(fs[0])   //~ E0401
}

pub rt fn array3_rrk_call_in_rt(c: Bool) -> U32 { [r, r, k][1].(1) }   //~ E0901

pub fn array3_rrk_type_alloc(c: Bool) -> U32 uses {Alloc} {
  let fs = [r, r, k]
  arr3_alloc(fs)   //~ E0401
}

pub fn array3_rrk_type_rt(c: Bool) -> U32 {
  let fs = [r, r, k]
  arr3_rt(fs)   //~ E0401
}
