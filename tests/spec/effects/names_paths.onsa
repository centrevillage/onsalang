// onsa.toml
// [test]
// spec = ["§8.1", "§8.2", "§15.1", "§18.1"]

// The name in an effect row is read as a path, like any other name (§8.1, S-659 (4)): its head is a
// module or a package that a `use` bound, and the rest is looked up in that module. `fs.Fs` after
// `use std.fs` is the effect `Fs` (E0200 in this version, D-08); `core.Alloc` is `Alloc` of the prelude
// (`std.core` holds it, §8.2), so it passes. A name that the module does not have is E0302, and so is a
// head that no `use` bound.

use std
use std.fs
use std.core

pub fn via_module() uses {fs.Fs} {}   //~ E0200

pub fn via_package() uses {std.fs.Fs} {}   //~ E0200

pub fn alloc_via_module() uses {core.Alloc} {}

pub fn alloc_via_package() uses {std.core.Alloc} {}

pub fn block_via_module() uses {core.Block} {}   //~ E0200

pub fn missing_in_module() uses {fs.Nope} {}   //~ E0302

// `use std.fs` binds `fs` and not the names of the module, and `io` was not taken by any `use`.
pub fn bare_name_of_module() uses {Fs} {}   //~ E0302

pub fn head_not_bound() uses {io.Stdout} {}   //~ E0302

pub fn in_a_function_type(f: fn() -> U32 uses {fs.Fs}) -> U32 {   //~ E0200
  1
}

pub fn in_a_closure() -> U32 {
  let g = fn(x: U32) -> U32 uses {fs.Nope} { x }   //~ E0302
  1
}
