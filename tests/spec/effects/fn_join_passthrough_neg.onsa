// onsa.toml
// [test]
// spec = ["§4.7", "§8.1", "§10"]

// W6-01 U2b/t, S-1031 (§4.7, §8.1, §10). The refused uses of the values of fn_join_passthrough_ok.onsa (see there). A leaf that is `b` anywhere in the nest gives the whole expression `uses {Alloc}`
// (E0401 at an empty-row place and at an `rt` place, E0601 for the call in a function with an empty row, written on one line so that the mark is the same at the heading and at the use); a leaf that is not `r`
// makes the whole expression not `rt` (E0401 at an `rt` place, E0901 for the call in an `rt` function). The array of the values does not go to an array type that is not the joined one. Checked, not run.

pub fn k(x: U32) -> U32 {
  x
}

pub rt fn r(x: U32) -> U32 {
  x
}

pub fn b(x: U32) -> U32 uses {Alloc} {
  x
}

// The places the joined type is tried at: an `rt` place, a place with an empty effect row, a place with `uses {Alloc}`, and the same three
// in an array type (an element of a type argument is compared as equal, so these say what the type of the join is).
pub rt fn at_rt(g: rt fn(U32) -> U32) -> U32 {
  g.(1)
}

pub fn at_pure(g: fn(U32) -> U32) -> U32 {
  g.(1)
}

pub fn at_alloc(g: fn(U32) -> U32 uses {Alloc}) -> U32 uses {Alloc} {
  g.(1)
}

pub rt fn arr_rt(a: [rt fn(U32) -> U32; 2]) -> U32 {
  a[0].(1)
}

pub fn arr_pure(a: [fn(U32) -> U32; 2]) -> U32 {
  a[0].(1)
}

pub fn arr_alloc(a: [fn(U32) -> U32 uses {Alloc}; 2]) -> U32 uses {Alloc} {
  a[0].(1)
}

pub rt fn arr3_rt(a: [rt fn(U32) -> U32; 3]) -> U32 {
  a[0].(1)
}

pub fn arr3_pure(a: [fn(U32) -> U32; 3]) -> U32 {
  a[0].(1)
}

pub fn arr3_alloc(a: [fn(U32) -> U32 uses {Alloc}; 3]) -> U32 uses {Alloc} {
  a[0].(1)
}

pub fn block_rk_to_rt(c: Bool) -> U32 {
  let f = if c {
    let _ = 1
    r
  } else {
    let _ = 2
    k
  }
  at_rt(f)   //~ E0401
}

pub fn block_rk_type_alloc(c: Bool) -> U32 uses {Alloc} {
  let f = if c {
    let _ = 1
    r
  } else {
    let _ = 2
    k
  }
  let fs = [f, f]
  arr_alloc(fs)   //~ E0401
}

pub fn block_rk_type_rt(c: Bool) -> U32 {
  let f = if c {
    let _ = 1
    r
  } else {
    let _ = 2
    k
  }
  let fs = [f, f]
  arr_rt(fs)   //~ E0401
}

