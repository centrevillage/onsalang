// onsa.toml
// [test]
// spec = ["§18.1", "§8.1", "§8.5"]

// W6-03 U7a, S-691 (the note of 2026-11-15), §18.1: an anonymous function in the body of a `test`, where a function type whose row may have
// meant `Alloc` (the item `Alloc` is an E0304) is expected, has that row, and its use of `Alloc` is no E0601.
pub enum Alloc { A }   //~ E0304

pub fn ap(g: fn(U32) -> U32 uses {Alloc}, n: U32) -> U32 { 0 }

test "t" {
  let _ = ap(fn(x: U32) -> U32 {
    let _ = "{x}"
    x
  }, 1)
}
