// onsa.toml
// [test]
// spec = ["§18.1", "§6.2"]

// S-850, R-180 (§18.1): the heading of this `impl` was read (`impl S {`) and a member of it was cut by a syntax
// error (E0002, the `)` of the arguments of `broken` is missing): only the heading that was not read makes the
// members and the traits of the type the parts that were not read, so the members this `impl` read before the cut
// (`f`) are names after the name of `S`, and a name no member of it has is a real error: a method `s.zz()` that
// is not there is E0413, and so is the name after the name of `S` that is not there. These errors stay when the
// `impl` whose heading was not read is silent (the other cases of `failed_impl_*`).
pub struct S {
  a: I32,
}

impl S {
  pub fn f(self) -> I32 {
    self.a
  }

  pub fn broken(self -> I32 {                       //~ E0002
    1
  }
}

fn method_that_was_read(s: S) -> I32 {
  s.f()
}

fn method_that_is_not_there(s: S) -> I32 {
  s.zz()                                            //~ E0413
}

fn associated_that_is_not_there() -> S {
  S.make()                                          //~ E0302
}

fn constant_that_is_not_there() -> U32 {
  S.K                                               //~ E0302
}

fn field_that_is_not_there(s: S) -> I32 {
  s.nope                                            //~ E0413
}

fn operator_that_is_not_there(p: S, q: S) -> Bool {
  p == q                                            //~ E0401
}
