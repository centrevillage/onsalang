// onsa.toml
// [test]
// spec = ["§18.1", "§4.4"]

// S-728 (W4-04 U8a): the alias whose type is the error type because it refers to itself (`type Lp =
// Lp`: the cycle of aliases is E0311, §4.4, R-105) is an alias of the error type like the alias of
// a failed name (kind_alias_of_failed_name.onsa), so written at the head of a path in a value place
// it stops the unit, and the `let b: Bool = 2` after it has no E0401. In a type place it is the error
// type and the unit goes on. The code of the cycle is E0311 (spec §4.4: "型別名の循環"); the
// implementation gives E0310 today (tests/pending.toml lists E0311 until W4-05), so this file waits
// for W4-05. The cycle of two aliases (`type C = D`, `type D = C`) is not written here: the spec does
// not say whether the diagnostic is one or on both declarations, a gap that is reported.

type Lp = Lp                                        //~ E0311

pub fn literal() -> Bool {
  let _ = Lp { a: 1 }
  let b: Bool = 2
  b
}

pub fn path() -> Bool {
  let _ = Lp.V
  let b: Bool = 2
  b
}

pub fn pattern(x: Lp) -> Bool {
  match x {
    Lp.V => {
      let b: Bool = 2
      b
    },
    _ => true,
  }
}

pub fn type_place_goes_on(x: Lp) -> Bool {
  let b: Bool = 2                                   //~ E0401
  b
}
