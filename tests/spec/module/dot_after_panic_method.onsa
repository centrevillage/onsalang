// onsa.toml
// [test]
// spec = ["§15.1", "§4.4", "§18.1"]
// fixes = 0

// S-713 (f): `panic.x()` is, in this version, the E0200 of `panic` in a value place (§15.1, §18.1;
// the function values of the prelude wait for W5-08), as `panic.x` (dot_after_function_name.onsa)
// and `let g = panic` are. It is not the E0413 of a method that a function value has not, and not
// the E0308 of a name that has no namespace: `panic` is a function, which has a value, not a trait.
// The E0200 shows what the version does not build; there is no candidate (`fixes = 0`). One error
// per unit (§18.1), so each form is in its own function; the places (a branch, an argument, a
// closure, a match arm, a generic function, a method, a `test`) give the same code.

pub struct P {
  x: I32,
}

impl P {
  pub fn in_a_method(self) -> I32 {
    panic.x()                                       //~ E0200
  }
}

pub fn plain() -> I32 {
  panic.x()                                         //~ E0200
}

pub fn with_arguments() -> I32 {
  panic.x(1, 2)                                     //~ E0200
}

pub fn in_a_branch(flag: Bool) -> I32 {
  if flag {
    panic.x()                                       //~ E0200
  } else {
    0
  }
}

pub fn in_an_argument() -> I32 {
  id(panic.x())                                     //~ E0200
}

pub fn in_a_closure() -> I32 {
  let f = fn(x: I32) -> I32 { panic.x() }           //~ E0200
  f.(1)
}

pub fn in_a_match_arm(n: U32) -> I32 {
  match n {
    0 => 0,
    _ => panic.x(),                                 //~ E0200
  }
}

pub fn in_a_generic_function[T: Num](x: T) -> T {
  panic.x()                                         //~ E0200
}

fn id[T](x: T) -> T {
  x
}

test "panic with a method call" {
  let n = panic.x()                                 //~ E0200
  assert n == 0
}
