// onsa.toml
// [test]
// spec = ["§15.1", "§8.1", "§6.3", "§4.6", "§18.1"]

// S-103, S-713 (W4-04 U8a): the name of a trait (`Show`, `Num`, `Default`), of a kind constraint
// (`Copy`, `Dup`) or of an effect (`Alloc`) alone in a value place is E0308 (§15.1: a name that is
// found and is not of the kind the place needs; a trait and a kind constraint are neither a
// namespace nor a value, an effect is a namespace and not a value). It is the E0308 of the name
// alone, not of the `.` after it (`Show.show(1)` is in dot_after_trait_name.onsa). One error per
// unit (§18.1), so each form is in its own unit; the places (an operand, an argument, a branch, a
// closure, a match arm, a `test`, a `const`, a generic fn) give the same code. The names in the
// places that need them (a bound `T: Show`, an effect row `uses {Alloc}`) are fine units of the file.

pub fn trait_in_a_let() -> I32 {
  let _ = Show                                      //~ E0308
  0
}

pub fn number_trait_in_a_let() -> I32 {
  let _ = Num                                       //~ E0308
  0
}

pub fn default_trait_in_a_let() -> I32 {
  let _ = Default                                   //~ E0308
  0
}

pub fn kind_constraint_copy_in_a_let() -> I32 {
  let _ = Copy                                      //~ E0308
  0
}

pub fn kind_constraint_dup_in_a_let() -> I32 {
  let _ = Dup                                       //~ E0308
  0
}

pub fn effect_in_a_let() -> I32 {
  let _ = Alloc                                     //~ E0308
  0
}

pub fn trait_as_an_operand(n: I32) -> I32 {
  n + Show                                          //~ E0308
}

pub fn effect_as_an_operand(n: I32) -> I32 {
  n * Alloc                                         //~ E0308
}

pub fn trait_as_an_argument() -> I32 {
  id(Show)                                          //~ E0308
}

pub fn effect_as_the_tail() -> I32 {
  Alloc                                             //~ E0308
}

pub fn trait_in_a_branch(flag: Bool) -> I32 {
  if flag {
    let _ = Show                                    //~ E0308
    1
  } else {
    0
  }
}

pub fn effect_in_a_match_arm(n: U32) -> I32 {
  match n {
    0 => 0,
    _ => {
      let _ = Alloc                                 //~ E0308
      1
    }
  }
}

pub fn trait_in_a_closure() -> I32 {
  let f = fn(x: I32) -> I32 {
    let _ = Show                                    //~ E0308
    x
  }
  f.(1)
}

pub fn trait_in_a_generic_fn[T: Show](x: T) -> T {
  let _ = Show                                      //~ E0308
  x
}

pub const TRAIT_IN_A_CONST: I32 = Show              //~ E0308

test "a trait name as a value in a test" {
  let n = Show                                      //~ E0308
  assert id(1) == 1
}

pub fn bound_is_the_place_of_a_trait[T: Show](x: T) -> T {
  x
}

pub fn effect_row_is_the_place_of_an_effect(n: I32) -> Str uses {Alloc} {
  "a{n}"
}

pub fn id(x: I32) -> I32 {
  x
}
