// onsa.toml
// [test]
// spec = ["§15.1", "§4.4", "§6.1", "§18.1"]

// S-713 (f): the name of a function has a value, so a `.` after it is a field or a method of that
// value, which the type stage reads (§15.1): a function value has none, and the name of a function
// of the user is E0413 (`g.y`, `g.y()`, the same as `p.norm` of §6.1). `panic` is a function of the
// prelude (§15.1) that has no value in this version (W5-08): its name in a value place is E0200
// (§18.1), also with a field after it (`panic.x`); the method form is in dot_after_panic_method.onsa.
// One error per unit (§18.1), so each form is in its own function; the places (a branch, a
// closure, a match arm, a `test`) give the same codes.

fn g(x: I32) -> I32 {
  x
}

pub fn panic_field() -> I32 {
  panic.x                                           //~ E0200
}

pub fn user_function_field() -> I32 {
  g.y                                               //~ E0413
}

pub fn user_function_method() -> I32 {
  g.y()                                             //~ E0413
}

pub fn user_function_in_a_branch(flag: Bool) -> I32 {
  if flag {
    g.y()                                           //~ E0413
  } else {
    0
  }
}

pub fn user_function_in_a_closure() -> I32 {
  let f = fn(x: I32) -> I32 { g.y }                 //~ E0413
  f.(1)
}

pub fn user_function_in_a_match_arm(n: U32) -> I32 {
  match n {
    0 => 0,
    _ => g.y,                                       //~ E0413
  }
}

pub fn function_value_field(f: fn(I32) -> I32) -> I32 {
  f.y                                               //~ E0413
}

pub fn right_forms(x: I32) -> I32 {
  let h = g
  h.(g(x))
}

test "a function name before a dot" {
  let n = g.y                                       //~ E0413
  assert n == 0
}
