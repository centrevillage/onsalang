// The generic types and functions of another module: a type that holds a `?Dup` parameter is not `Dup` or `Copy`, here and where
// it is named from another module (R-176, spec §4.5, §4.6).

pub struct W[T: ?Dup] {
  x: T,
}

pub struct Need[T] {
  x: T,
}

pub fn need_dup[T](x: T) -> U32 {
  0
}

pub fn need_copy[T: Copy](x: T) -> U32 {
  0
}

pub fn keep[T: ?Dup](move x: T) -> T {
  x
}

pub fn in_the_declaring_module[U: ?Dup](w: W[U]) -> U32 {
  need_dup(w)   //~ E0416
}

pub fn fine_in_the_declaring_module[U](w: W[U]) -> U32 {
  need_dup(w)
}
