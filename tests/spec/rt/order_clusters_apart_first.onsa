// onsa.toml
// [test]
// spec = ["§10", "§18.1"]

// R-462 (W6-04 U6), §10 rule 5 and §18.1: a recursion of `rt` functions that call each other by name is one E0903
// for each set of functions that reach each other ("互いに辿り合う宣言の集まりごとに一つ"), and its place is the first
// call, in the order of the source, of a function of the set (a call written in a function of the set: a use from
// outside the set gets no diagnostic). The count and the place do not depend on the order of the declarations. Two sets that do not reach each
// other (`a`, `b`, `c` and `x`, `y`, `z`, each with two cycles), with the callers first in each: one E0903 for
// each set, at its first call.

pub rt fn a() {
  b()   //~ E0903
  c()
}

pub rt fn b() { a() }

pub rt fn c() { a() }

pub rt fn x() {
  y()   //~ E0903
  z()
}

pub rt fn y() { x() }

pub rt fn z() { x() }
