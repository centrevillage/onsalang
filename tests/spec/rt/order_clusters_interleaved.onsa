// onsa.toml
// [test]
// spec = ["§10", "§18.1"]

// R-462 (W6-04 U6), §10 rule 5 and §18.1: a recursion of `rt` functions that call each other by name is one E0903
// for each set of functions that reach each other ("互いに辿り合う宣言の集まりごとに一つ"), and its place is the first
// call, in the order of the source, of a function of the set (a call written in a function of the set: a use from
// outside the set gets no diagnostic). The count and the place do not depend on the order of the declarations. The two sets of
// `order_clusters_apart_first.onsa` with their functions interleaved, the callers late: one E0903 for each set, at
// the first call of the set in the source (`x()` in `y` for `x`, `y`, `z`, and `a()` in `b` for `a`, `b`, `c`).

pub rt fn y() { x() }   //~ E0903

pub rt fn b() { a() }   //~ E0903

pub rt fn x() {
  y()
  z()
}

pub rt fn z() { x() }

pub rt fn a() {
  b()
  c()
}

pub rt fn c() { a() }
