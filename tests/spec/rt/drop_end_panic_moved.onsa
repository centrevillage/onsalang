// onsa.toml
// [test]
// spec = ["§7", "§9.2", "§10", "§12.2"]

// W6-02 U2a/t, S-873 (§9.2, §12.2: the drop on the path that panics is no `Alloc`; §7: `while true` without a `break` never ends):
// an owned local that is moved on one path and live on another path that panics or never ends has no drop, so the function needs no
// `Alloc` and an `rt fn` is no E0601. Every function here is legal. This version accepts them because it counts a local moved
// anywhere in the body as moved on every path (R-32); when the drop is counted on each path (W6-02 U2a), the path that panics must
// stay out of it, so these keep the form legal (rt/drop_end_panic_path.onsa is the local that is never moved, legal only after U2a).

pub struct Holder {
  buf: Buf[F32],
  gain: F32,
}

// ------------------------------------------------------------------ moved on one path, `panic` on the other

pub fn moved_or_panic(c: Bool, move b: Buf[F32]) -> Option[Buf[F32]] { if c { Some(move b) } else { panic("x") } }

pub rt fn rt_moved_or_panic(c: Bool, move b: Buf[F32]) -> Option[Buf[F32]] { if c { Some(move b) } else { panic("x") } }

pub rt fn rt_panic_or_moved(c: Bool, move b: Buf[F32]) -> Option[Buf[F32]] { if c { panic("x") } else { Some(move b) } }

pub fn nested_panics(c: Bool, d: Bool, move b: Buf[F32]) -> Option[Buf[F32]] { if c { if d { Some(move b) } else { panic("x") } } else { panic("y") } }

pub rt fn rt_nested_panics(c: Bool, d: Bool, move b: Buf[F32]) -> Option[Buf[F32]] { if c { if d { Some(move b) } else { panic("x") } } else { panic("y") } }

pub rt fn rt_chain_panics(c: Bool, d: Bool, move b: Buf[F32]) -> Option[Buf[F32]] { if c { Some(move b) } else if d { panic("x") } else { panic("y") } }

pub fn arm_panics(n: U32, move b: Buf[F32]) -> Option[Buf[F32]] { match n { 0 => Some(move b), _ => panic("x") } }

pub rt fn rt_arm_panics(n: U32, move b: Buf[F32]) -> Option[Buf[F32]] { match n { 0 => panic("x"), 1 => Some(move b), _ => panic("y") } }

pub rt fn rt_struct_panics(c: Bool, move h: Holder) -> Option[Holder] { if c { Some(move h) } else { panic("x") } }

// ------------------------------------------------------------------ the binding of an owned heading, moved on one path

pub rt fn rt_heading_arm_moved_or_panic(c: Bool, move o: Option[Buf[F32]]) -> Option[Buf[F32]] { match move o { Some(v) => if c { Some(move v) } else { panic("x") }, None => None } }

pub fn heading_binding_moved_or_panic(c: Bool, move b: Buf[F32]) -> Option[Buf[F32]] { match move b { t => if c { Some(move t) } else { panic("x") } } }

// ------------------------------------------------------------------ moved on one path, `while true` on the other

pub rt fn rt_moved_or_spin(c: Bool, move b: Buf[F32]) -> Option[Buf[F32]] { if c { Some(move b) } else { while true {} } }

pub rt fn rt_arm_spins(n: U32, move b: Buf[F32]) -> Option[Buf[F32]] { match n { 0 => Some(move b), _ => { while true {} } } }

pub fn spin_or_moved(c: Bool, move b: Buf[F32]) -> Option[Buf[F32]] { if c { while true {} } else { Some(move b) } }
