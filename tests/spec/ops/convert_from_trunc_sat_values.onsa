  assert I8.trunc_sat_from(s_f64(127.5)) == 127
  assert I8.trunc_sat_from(s_f64(-128.0)) == -128
  assert I8.trunc_sat_from(s_f64(-128.5)) == -128
  assert I8.trunc_sat_from(s_f64(128.0)) == 127
