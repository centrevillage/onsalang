// onsa.toml
// [test]
// mode = "test"
// spec = ["§3.3", "§3.4"]

// W5-14 S1/t: the values of `trunc_sat_from` (spec 3.3, 3.4): a float is cut toward zero and clamped to the
// range of the target, so a value beyond a limit (an infinity too) is that limit and a NaN is 0. A value in
// (-1, 0) is 0 for an unsigned target as well. For each integer target and each source (`F32` and `F64`) the
// values are the ones of trunc_values (they are not clamped), the first value beyond each limit, an infinity
// and a NaN. The helpers only give a literal its type.

fn s_f32(v: F32) -> F32 {
  v
}

fn s_f64(v: F64) -> F64 {
  v
}

test "I8.trunc_sat_from of an F32" {
  assert I8.trunc_sat_from(s_f32(0.0)) == 0
  assert I8.trunc_sat_from(s_f32(-0.0)) == 0
  assert I8.trunc_sat_from(s_f32(0.5)) == 0
  assert I8.trunc_sat_from(s_f32(-0.5)) == 0
  assert I8.trunc_sat_from(s_f32(0.9)) == 0
  assert I8.trunc_sat_from(s_f32(-0.9)) == 0
  assert I8.trunc_sat_from(s_f32(1.5)) == 1
  assert I8.trunc_sat_from(s_f32(-1.5)) == -1
  assert I8.trunc_sat_from(s_f32(127.0)) == 127
  assert I8.trunc_sat_from(s_f32(127.5)) == 127
  assert I8.trunc_sat_from(s_f32(-128.0)) == -128
  assert I8.trunc_sat_from(s_f32(-128.5)) == -128
  assert I8.trunc_sat_from(s_f32(128.0)) == 127
  assert I8.trunc_sat_from(s_f32(1.0e30)) == 127
  assert I8.trunc_sat_from(s_f32(-129.0)) == -128
  assert I8.trunc_sat_from(s_f32(-1.0e30)) == -128
  assert I8.trunc_sat_from(F32.INFINITY) == 127
  assert I8.trunc_sat_from(-F32.INFINITY) == -128
  assert I8.trunc_sat_from(F32.NAN) == 0
}

