// onsa.toml
// [test]
// mode = "test"
// spec = ["§3.3", "§3.4", "§9.2"]

// W5-14 S1/t: `trunc_from` panics when the cut value does not fit the target and for a NaN (spec 3.3, 3.4, 9.2).
// For each integer target the first float beyond the upper limit and (for a signed target) the first beyond the
// lower limit panic; `-1.0` panics for an unsigned target (its cut value is -1); an infinity and a NaN panic.
// Every test panics in the line that has the marker (one marker for one test). The helpers only give a literal
// its type.

fn s_f32(v: F32) -> F32 {
  v
}

fn s_f64(v: F64) -> F64 {
  v
}

test "I8.trunc_from(128.0) panics" {
  let y = I8.trunc_from(s_f64(128.0)) //~ PANIC "I8.trunc_from(128.0) panics"
  assert y == 0
}

test "I8.trunc_from(-129.0) panics" {
  let y = I8.trunc_from(s_f64(-129.0)) //~ PANIC "I8.trunc_from(-129.0) panics"
  assert y == 0
}

test "I8.trunc_from of an F32 -129.0 panics" {
  let y = I8.trunc_from(s_f32(-129.0)) //~ PANIC "I8.trunc_from of an F32 -129.0 panics"
  assert y == 0
}

test "I8.trunc_from of an F32 128.0 panics" {
  let y = I8.trunc_from(s_f32(128.0)) //~ PANIC "I8.trunc_from of an F32 128.0 panics"
  assert y == 0
}

test "I16.trunc_from(32768.0) panics" {
  let y = I16.trunc_from(s_f64(32768.0)) //~ PANIC "I16.trunc_from(32768.0) panics"
