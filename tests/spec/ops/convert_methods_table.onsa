// onsa.toml
// [test]
// spec = ["§3.3", "§18.1"]

// W5-02 U4b: every conversion method of the table in spec §3.3 is accepted for its pair of types (a pair that
// `as` cannot write): `narrow_<type>` between the integers, `trunc_<type>` and `trunc_<type>_sat` from a float to an
// integer, `round_f32` / `round_f64` into a float, and `to_bits`. The complement, the pairs that `as` writes, is in
// negative/scalar_method_as_pairs.onsa. The file only has to check (the values are in the other cases).

pub fn i8_narrow_u8(x: I8) -> Option[U8] {
  x.narrow_u8()
}

