// onsa.toml
// [test]
// spec = ["§3.3", "§18.1"]

// W5-02 U4b: every conversion function of the table in spec §3.3 is accepted for its pair of types (a pair that
// `as` cannot write): `narrow_from` between the integers, `trunc_from` and `trunc_sat_from` from a float to an
// integer, `F32.round_from` / `F64.round_from` into a float, and `to_bits`. The complement, the pairs that `as` writes, is in
// negative/scalar_method_as_pairs.onsa. The file only has to check (the values are in the other cases).

pub fn i8_narrow_u8(x: I8) -> Option[U8] {
  U8.narrow_from(x)
}

