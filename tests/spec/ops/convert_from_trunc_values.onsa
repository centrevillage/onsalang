test "I64.trunc_from of an F32" {
  assert I64.trunc_from(s_f32(0.0)) == 0
  assert I64.trunc_from(s_f32(-0.0)) == 0
  assert I64.trunc_from(s_f32(0.5)) == 0
  assert I64.trunc_from(s_f32(-0.5)) == 0
  assert I64.trunc_from(s_f32(0.9)) == 0
  assert I64.trunc_from(s_f32(-0.9)) == 0
  assert I64.trunc_from(s_f32(1.5)) == 1
  assert I64.trunc_from(s_f32(-1.5)) == -1
  assert I64.trunc_from(s_f32(9223371487098961920.0)) == 9223371487098961920
  assert I64.trunc_from(s_f32(-9223372036854775808.0)) == I64.MIN
}

