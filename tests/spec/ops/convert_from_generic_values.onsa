// onsa.toml
// [test]
// mode = "test"
// spec = ["§3.3", "§4.5", "§6.3"]

// W5-14 S1/t: a value of a type parameter as the argument of a conversion function (spec 3.3: "変換元か変換先が型
// パラメータなら、変換は関連関数で書く ... 具体化した型の組で `as` が書けても書ける"). The source is `x: T` with
// `T: Num` for `round_from` and `T: Float` for `trunc_from` and `trunc_sat_from`. The instances cover a pair that
// `as` cannot write (F64 to F32, I32 to F32, I64 to F64), a pair that `as` writes (F32 to F64, I32 to F64) and the
// same type (F32 to F32, F64 to F64), and all of them give the value of the conversion. The generic code sits in a
// nested call, a branch, a closure and an `impl` member.

use std.array

fn to_f32[T: Num](x: T) -> F32 {
  F32.round_from(x)
}

fn to_f64[T: Num](x: T) -> F64 {
  F64.round_from(x)
}

fn to_u32[T: Float](x: T) -> U32 {
  U32.trunc_from(x)
}

fn to_i8_sat[T: Float](x: T) -> I8 {
  I8.trunc_sat_from(x)
}

fn twice[T: Float](x: T) -> U32 {
  to_u32(x) + to_u32(x)
}

fn capped[T: Float](x: T, hi: U32) -> U32 {
  let n = U32.trunc_sat_from(x)
  if n > hi {
    hi
  } else {
    n
  }
}

fn steps_of[T: Float](xs: [T; 3]) -> [U32; 3] {
  array.from_fn(fn(i) { U32.trunc_sat_from(xs[i]) })
}

pub struct Meter[T: Float] {
  level: T,
}

impl[T: Float] Meter[T] {
  pub fn steps(self) -> U32 {
    U32.trunc_sat_from(self.level)
  }
}

test "F32.round_from of a type parameter instantiated with F32 is the same value" {
  let x: F32 = 1.5
  assert to_f32(x) == 1.5
  let y: F32 = -0.0
  assert to_f32(y).to_bits() == 0x80000000
}

test "F32.round_from of a type parameter instantiated with F64, I32 and I64 rounds" {
  let a: F64 = 16777217.0
  assert to_f32(a) == 16777216.0
  let n: I32 = 16777219
  assert to_f32(n) == 16777220.0
  let m: I64 = 1152921573326323713
  assert to_f32(m) == 1152921642045800448.0
}

test "F64.round_from of a type parameter instantiated with F32 and I32 is the same value as as" {
  let x: F32 = 0.1
  assert to_f64(x) == (x as F64)
  let n: I32 = -2147483648
  assert to_f64(n) == (n as F64)
  assert to_f64(n) == -2147483648.0
}

test "F64.round_from of a type parameter instantiated with F64 and I64" {
  let a: F64 = 0.1
  assert to_f64(a) == 0.1
  let m: I64 = 9007199254740993
  assert to_f64(m) == 9007199254740992.0
}

test "trunc_from of a type parameter cuts toward zero" {
  let a: F32 = 2.9
  assert to_u32(a) == 2
  let b: F64 = -0.9
  assert to_u32(b) == 0
  let c: F64 = 4294967295.0
  assert to_u32(c) == 4294967295
}

test "trunc_from of a type parameter panics out of the range" {
  let a: F64 = -1.0
  let n = to_u32(a) //~ PANIC "trunc_from of a type parameter panics out of the range"
  assert n == 0
}

test "trunc_from of a type parameter panics for a NaN" {
  let a: F32 = F32.NAN
  let n = to_u32(a) //~ PANIC "trunc_from of a type parameter panics for a NaN"
  assert n == 0
}

test "trunc_sat_from of a type parameter clamps and maps a NaN to 0" {
  let a: F32 = 300.5
  assert to_i8_sat(a) == 127
  let b: F64 = -300.5
  assert to_i8_sat(b) == -128
  let c: F64 = F64.NAN
  assert to_i8_sat(c) == 0
  let d: F32 = -2.9
  assert to_i8_sat(d) == -2
}

test "the generic conversions sit in a nested call, a branch and a closure" {
  let a: F64 = 2.5
  assert twice(a) == 4
  let b: F32 = 7.5
  assert capped(b, 5) == 5
  assert capped(b, 9) == 7
  let xs: [F64; 3] = [0.5, 1.5, 2.5]
  let ys = steps_of(xs)
  assert ys[0] == 0
  assert ys[1] == 1
  assert ys[2] == 2
}

test "an impl member of a generic type converts its field" {
  let a: Meter[F32] = Meter { level: 3.75 }
  assert a.steps() == 3
  let b: Meter[F64] = Meter { level: 1.0e30 }
  assert b.steps() == 4294967295
}
