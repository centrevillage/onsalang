// onsa.toml
// [test]
// mode = "test"
// spec = ["§3.1", "§3.4", "§9.2"]

// `MIN % -1` and `MIN / -1` as the left operand of a comparison, written
// without parentheses (spec §3.1: the remainder `%` and the multiplicative
// group `* /` bind tighter than the comparison group). The values are the ones
// of min_rem_neg1.onsa: `MIN % -1` is 0 and does not panic, `MIN / -1` is one
// above MAX and panics (spec §3.4, §9.2).

test "MIN % -1 == 0 reads as (MIN % -1) == 0 at every signed width" {
  let a8: I8 = I8.MIN
  let m8: I8 = -1
  assert a8 % m8 == 0
  let a16: I16 = I16.MIN
  let m16: I16 = -1
  assert a16 % m16 == 0
  let a32: I32 = I32.MIN
  let m32: I32 = -1
  assert a32 % m32 == 0
  let a64: I64 = I64.MIN
  let m64: I64 = -1
  assert a64 % m64 == 0
  assert a64 % -1 == 0
  assert a64 % m64 != 1
  assert a64 % m64 < 1
}

test "MAX / -1 compares with -MAX without parentheses" {
  let a: I32 = I32.MAX
  let m: I32 = -1
  assert a / m == -2147483647
  assert a / m < 0
  assert a / m > I32.MIN
}

test "a remainder is compared in the condition of an if" {
  let a: I16 = I16.MIN
  let m: I16 = -1
  let r = if a % m == 0 { 1 } else { 2 }
  assert r == 1
}

test "MIN / -1 as the left operand of a comparison panics" {   //~ TESTFAIL "MIN / -1 as the left operand of a comparison panics"
  let a: I32 = I32.MIN
  let m: I32 = -1
  assert a / m > 0
}

test "MIN / -1 as the left operand of an equality panics" {   //~ TESTFAIL "MIN / -1 as the left operand of an equality panics"
  let a: I8 = I8.MIN
  let m: I8 = -1
  assert a / m == 0
}
