// onsa.toml
// [test]
// mode = "test"
// spec = ["§3.5", "§5.2", "§9.2", "§7"]

// Evaluation order (spec §3.5, R-93). The order is observed through a `U32`
// log: `tick(inout log, d)` appends the decimal digit `d` to `log`, so the log
// after an expression reads as the order in which the calls ran.
//
// Whether the first of several panics is the one reported cannot be observed
// from a `test` block (a panic only fails the test), so that rule is not
// covered here.

use std.array

fn tick(inout log: U32, d: U32) -> U32 {
  let shifted = log * 10
  log = shifted + d
  d
}

// Appends `d` and returns `v`.
fn tick_i(inout log: U32, d: U32, v: I32) -> I32 {
  let shifted = log * 10
  log = shifted + d
  v
}

fn probe(inout log: U32, d: U32, r: Bool) -> Bool {
  let shifted = log * 10
  log = shifted + d
  r
}

// `k` goes up by one and the new value is returned.
fn next(inout k: U32) -> U32 {
  k = k + 1
  k
}

fn set100(inout c: U32) -> I64 {
  c = 100
  1
}

fn mk(inout log: U32, d: U32) -> [U32; 4] {
  let shifted = log * 10
  log = shifted + d
  [10, 20, 30, 40]
}

fn pair_minus(a: U32, b: U32) -> U32 {
  b - a
}

fn first_minus(a: I32, b: I32, c: I32) -> I32 {
  a - b - c
}

// Divides by `z`, so it panics when `z` is 0.
fn bad(z: I32) -> Bool {
  let q = 1 / z
  q == 0
}

fn ignore(v: I32) -> I32 {
  3
}

pub struct Acc {
  v: U32,
}

impl Acc {
  pub fn plus(self, k: U32) -> U32 {
    self.v + k
  }
}

fn acc(inout log: U32, d: U32, v: U32) -> Acc {
  let shifted = log * 10
  log = shifted + d
  Acc { v: v }
}

pub struct Pair {
  a: U32,
  b: U32,
}

// ------------------------------------------------------- operands, left to right

test "binary operands are evaluated left to right" {
  var log: U32 = 0
  let v = tick(inout log, 1) + tick(inout log, 2) + tick(inout log, 3)
  assert v == 6
  assert log == 123
}

test "the left operand of a non-commutative operator runs first" {
  var log: U32 = 0
  let d = tick_i(inout log, 1, 10) - tick_i(inout log, 2, 3)
  assert d == 7
  assert log == 12
  let q = tick_i(inout log, 3, 100) / tick_i(inout log, 4, 7)
  assert q == 14
  assert log == 1234
}

test "comparison operands are evaluated left to right" {
  var log: U32 = 0
  let lt = tick_i(inout log, 1, 5) < tick_i(inout log, 2, 6)
  assert lt
  assert log == 12
}

test "a chain of the same operator is evaluated from the left" {
  var log: U32 = 0
  let v = tick_i(inout log, 1, 100) - tick_i(inout log, 2, 10) - tick_i(inout log, 3, 1)
  assert v == 89
  assert log == 123
}

test "a read on the left is taken before a write on the right" {
  var c: U32 = 7
  let v = (c as I64) + set100(inout c)
  assert v == 8
  assert c == 100
}

test "a write on the left is seen by a read on the right" {
  var c: U32 = 7
  let v = set100(inout c) + (c as I64)
  assert v == 101
  assert c == 100
}

// ------------------------------------------------------- calls and arguments

test "the receiver is evaluated before the arguments" {
  var log: U32 = 0
  let r = acc(inout log, 1, 100).plus(tick(inout log, 2))
  assert r == 102
  assert log == 12
}

test "arguments are evaluated left to right" {
  var log: U32 = 0
  let r = first_minus(tick_i(inout log, 1, 100), tick_i(inout log, 2, 10), tick_i(inout log, 3, 1))
  assert r == 89
  assert log == 123
}

test "an argument that indexes uses the order of its own subexpressions" {
  var c: U32 = 0
  let ps: [U32; 3] = [0, 100, 200]
  let r = pair_minus(next(inout c), ps[next(inout c)])
  assert r == 199
  assert c == 2
}

test "all arguments are evaluated before the call" {
  var xs: [U32; 4] = [0, 0, 0, 0]
  xs.fill!(xs.len())
  assert xs[0] == 4
  assert xs[1] == 4
  assert xs[2] == 4
  assert xs[3] == 4
}

test "a panic in an argument happens before the call even if the value is unused" {   //~ TESTFAIL "a panic in an argument happens before the call even if the value is unused"
  let z: I32 = 0
  let r = ignore(1 / z)
  assert r == 3
}

// ------------------------------------------------------------------- literals

test "struct literal fields are evaluated in the order written" {
  var log: U32 = 0
  let p = Pair { b: tick(inout log, 2), a: tick(inout log, 1) }
  assert log == 21
  assert p.a == 1
  assert p.b == 2
}

test "array and tuple literals are evaluated in the order written" {
  var log: U32 = 0
  let xs = [tick(inout log, 1), tick(inout log, 2), tick(inout log, 3)]
  assert log == 123
  assert xs[0] == 1
  assert xs[2] == 3
  let t = (tick(inout log, 4), tick(inout log, 5))
  assert log == 12345
  assert t.0 == 4
  assert t.1 == 5
}

test "a repeated array literal evaluates its element once" {
  var log: U32 = 0
  let xs = [tick(inout log, 7); 3]
  assert log == 7
  assert xs[0] == 7
  assert xs[1] == 7
  assert xs[2] == 7
}

// ------------------------------------------------------------ assignment, index

test "assignment evaluates the right-hand side before the place" {
  var k: U32 = 0
  var ys: [U32; 4] = [0, 0, 0, 0]
  ys[next(inout k)] = next(inout k)
  assert ys[2] == 1
  assert ys[1] == 0
  assert k == 2
}

test "assignment to a nested element: the right-hand side, then the indices left to right" {
  var k: U32 = 0
  var grid: [[U32; 4]; 4] = [[0; 4]; 4]
  grid[next(inout k)][next(inout k)] = next(inout k)
  assert grid[2][3] == 1
  assert grid[3][2] == 0
  assert grid[1][2] == 0
  assert grid[2][1] == 0
  assert k == 3
}

test "an index is evaluated after the indexed expression" {
  var log: U32 = 0
  let v = mk(inout log, 1)[tick(inout log, 2)]
  assert v == 30
  assert log == 12
}

test "nested indices are evaluated from the outside in" {
  var k: U32 = 0
  let grid: [[U32; 3]; 3] = [[0, 1, 2], [10, 11, 12], [20, 21, 22]]
  let v = grid[next(inout k)][next(inout k)]
  assert v == 12
}

// ------------------------------------------------------------------ branches

test "short-circuit operators evaluate the right operand only when needed" {
  var log: U32 = 0
  let f: Bool = false
  let t: Bool = true
  let a = f && probe(inout log, 1, true)
  assert !a
  assert log == 0
  let b = t || probe(inout log, 2, true)
  assert b
  assert log == 0
  let c = t && probe(inout log, 3, true)
  assert c
  assert log == 3
  let d = f || probe(inout log, 4, false)
  assert !d
  assert log == 34
}

test "a chain of && stops at the first false operand" {
  var log: U32 = 0
  let t: Bool = true
  let r = t && probe(inout log, 5, false) && probe(inout log, 6, true)
  assert !r
  assert log == 5
}

test "a chain of || stops at the first true operand" {
  var log: U32 = 0
  let f: Bool = false
  let r = f || probe(inout log, 7, true) || probe(inout log, 8, true)
  assert r
  assert log == 7
}

test "a short-circuit operator inside parentheses" {
  var log: U32 = 0
  let f: Bool = false
  let r = (f && probe(inout log, 1, true)) || probe(inout log, 2, true)
  assert r
  assert log == 2
}

test "if evaluates the condition, then only the taken branch" {
  var log: U32 = 0
  let r = if probe(inout log, 1, true) {
    tick(inout log, 2)
  } else {
    tick(inout log, 3)
  }
  assert r == 2
  assert log == 12
}

test "else is not evaluated when the condition holds, and the reverse" {
  var log: U32 = 0
  let r = if probe(inout log, 1, false) {
    tick(inout log, 2)
  } else {
    tick(inout log, 3)
  }
  assert r == 3
  assert log == 13
}

test "a branch that would panic is not evaluated when it is not taken" {
  let z: I32 = 0
  let f: Bool = false
  let t: Bool = true
  let a = t || bad(z)
  assert a
  let b = f && bad(z)
  assert !b
  let c = if f {
    1 / z
  } else {
    7
  }
  assert c == 7
}

test "a match arm that would panic is not evaluated when it is not taken" {
  let z: I32 = 0
  let k: I32 = 2
  let d = match k {
    1 => 1 / z,
    _ => 9,
  }
  assert d == 9
}

test "the right operand of && is evaluated when the left is true" {   //~ TESTFAIL "the right operand of && is evaluated when the left is true"
  let z: I32 = 0
  let t: Bool = true
  let r = t && bad(z)
  assert !r
}

test "the taken branch of an if is evaluated" {   //~ TESTFAIL "the taken branch of an if is evaluated"
  let z: I32 = 0
  let t: Bool = true
  let c = if t {
    1 / z
  } else {
    7
  }
  assert c == 7
}

// -------------------------------------------------------- loops and closures

test "the loop body sees the writes of earlier iterations in order" {
  var log: U32 = 0
  for i in 1..4 {
    let seen = tick(inout log, i)
    assert seen == i
  }
  assert log == 123
}

test "a while condition is evaluated before every iteration and once more at the end" {
  var log: U32 = 0
  var n: U32 = 0
  while probe(inout log, 1, n < 3) {
    n = n + 1
  }
  assert n == 3
  assert log == 1111
}

test "a closure built later sees the later value of a captured variable" {
  var k: U32 = 2
  let before: [U32; 3] = array.from_fn(fn(i) { k + i })
  k = 10
  let after: [U32; 3] = array.from_fn(fn(i) { k + i })
  assert before[0] == 2
  assert before[2] == 4
  assert after[0] == 10
  assert after[2] == 12
}
