// onsa.toml
// [test]
// mode = "test"
// spec = ["§9.1", "§6.1", "§5.3", "§4.7", "§7"]

// `?` and `return` in an anonymous function passed to `array.from_fn` (spec §9.1,
// §6.1, §5.3; S-192, R-08): both leave the innermost function, and an anonymous
// function is a function, so they leave the anonymous function, which then has
// its value for that element. They do not leave the function the anonymous
// function is written in, and that function goes on with the array it was given.
// The type of the error of `?` is the error type of the anonymous function's
// return type (§9.1), not that of the enclosing function.
//
// Every value is worked out by hand from the spec text. The anonymous functions
// that are called with `.(` are in try_in_closure.onsa. Until the formal lowering
// of function values (W8-09), `?` and `return` in an anonymous function passed to
// `from_fn` are E0200 (negative/lower_closure_exit.onsa; `return` is E0200 already
// today, `?` leaves the enclosing function silently); W8-09 removes that file, and
// this one has to pass.

use std.array

pub enum ParseError {
  Negative,
  TooBig(I32),
}

fn parse(n: I32) -> Result[I32, ParseError] {
  if n < 0 {
    return Err(ParseError.Negative)
  }
  if n > 100 {
    return Err(ParseError.TooBig(n))
  }
  Ok(n)
}

fn half(n: U32) -> Option[U32] {
  if n < 100 {
    Some(n / 2)
  } else {
    None
  }
}

fn opt_val(o: Option[U32]) -> U32 {
  match o {
    Some(v) => v,
    None => 9999,
  }
}

fn error_code(e: ParseError) -> I32 {
  match e {
    ParseError.Negative => -1,
    ParseError.TooBig(n) => -1000 - n,
  }
}

fn code(r: Result[I32, ParseError]) -> I32 {
  match r {
    Ok(v) => v,
    Err(e) => error_code(e),
  }
}

// ------------------------------------------------ `?` leaves the anonymous function

// Every element is None or Some from the `?` of its own anonymous function; the
// enclosing function goes on and returns the sum. The elements are
// half(99) = Some(49), half(100) = None, half(101) = None.
fn build() -> Option[U32] {
  let xs: [Option[U32]; 3] = array.from_fn(fn(i: U32) -> Option[U32] {
    let h = half(i + 99)?
    Some(h)
  })
  Some(opt_val(xs[0]) + opt_val(xs[1]) + opt_val(xs[2]))
}

pub enum OuterError {
  Bad,
}

// The enclosing function returns another error type than the anonymous function.
fn convert() -> Result[I32, OuterError] {
  let ints: [I32; 3] = [1, -2, 200]
  let rs: [Result[I32, ParseError]; 3] = array.from_fn(fn(i: U32) -> Result[I32, ParseError] {
    let v = parse(ints[i])?
    Ok(v + 1)
  })
  Ok(code(rs[0]) + code(rs[1]) + code(rs[2]))
}

test "? in a closure of Option leaves the closure and the function goes on" {
  assert opt_val(build()) == 20047
}

test "? in a closure of Result with another error type than the function" {
  // code(Ok(2)) = 2, code(Err(Negative)) = -1, code(Err(TooBig(200))) = -1200.
  let r = convert()
  match r {
    Ok(v) => {
      assert v == -1199
    },
    Err(_) => {
      assert false
    },
  }
}

// ---------------------------------------------- the enclosing function's own `?`

fn around(a: I32, b: I32) -> Result[I32, ParseError] {
  let x = parse(a)?
  let rs: [Result[I32, ParseError]; 2] = array.from_fn(fn(i: U32) -> Result[I32, ParseError] {
    let v = parse(b)?
    if i == 0 {
      Ok(v)
    } else {
      Ok(v + 1000)
    }
  })
  let y = parse(x + 1)?
  Ok(y + code(rs[0]) + code(rs[1]))
}

test "the enclosing function's ? before and after a closure with its own ?" {
  // x = 1, rs = [Ok(2), Ok(1002)], y = 2, so 2 + 2 + 1002.
  assert code(around(1, 2)) == 1006
  // The closure fails for both elements (-1 each), the function does not: 2 - 1 - 1.
  assert code(around(1, -5)) == 0
  // The function's own first ? fails before the closure is made.
  assert code(around(-1, 2)) == -1
  // The function's own ? after the closure fails: parse(101) is TooBig(101).
  assert code(around(100, 2)) == -1101
}

// ----------------------------------------------- `return` leaves the anonymous function

fn doubled_or_fifty() -> [U32; 3] {
  array.from_fn(fn(i: U32) -> U32 {
    if i == 1 {
      return 50
    }
    i * 2
  })
}

fn first_match() -> [U32; 5] {
  array.from_fn(fn(i: U32) -> U32 {
    for j in 0..4 {
      if j == i {
        return j * 100
      }
    }
    7
  })
}

fn tail_after_return(n: U32) -> U32 {
  let xs: [U32; 2] = array.from_fn(fn(i: U32) -> U32 {
    if i == 0 {
      return n
    }
    n + 1
  })
  xs[0] + xs[1] + 1000
}

test "return in a closure gives the value of that element" {
  let xs = doubled_or_fifty()
  assert xs[0] == 0
  assert xs[1] == 50
  assert xs[2] == 4
}

test "return from a loop inside a closure leaves the closure only" {
  let xs = first_match()
  assert xs[0] == 0
  assert xs[1] == 100
  assert xs[2] == 200
  assert xs[3] == 300
  assert xs[4] == 7
}

test "the code after the closure runs after a return inside it" {
  // xs = [n, n + 1] = [5, 6].
  assert tail_after_return(5) == 1011
}

// ------------------------------------------ captured values, generics, nesting

// h > limit leaves with `return`, half(i * 40) failing leaves with `?`.
// Elements for limit 30: half(0) = Some(0), half(40) = Some(20), half(80) = Some(40)
// is above 30 so None, half(120) = None.
fn capped_sum(limit: U32) -> U32 {
  let xs: [Option[U32]; 4] = array.from_fn(fn(i: U32) -> Option[U32] {
    let h = half(i * 40)?
    if h > limit {
      return None
    }
    Some(h)
  })
  opt_val(xs[0]) + opt_val(xs[1]) + opt_val(xs[2]) + opt_val(xs[3])
}

fn wrap[T: Copy](v: T) -> [Option[T]; 2] {
  array.from_fn(fn(i: U32) -> Option[T] {
    if i == 0 {
      return None
    }
    Some(v)
  })
}

fn nested(k: U32) -> U32 {
  let outer: [U32; 2] = array.from_fn(fn(i: U32) -> U32 {
    let inner: [Option[U32]; 2] = array.from_fn(fn(j: U32) -> Option[U32] {
      let h = half(j + k)?
      Some(h)
    })
    opt_val(inner[0]) + opt_val(inner[1]) + i
  })
  outer[0] + outer[1]
}

test "a closure that captures a limit uses ? and return together" {
  // limit 30: 0 + 20 + 9999 + 9999. limit 100: 0 + 20 + 40 + 9999.
  assert capped_sum(30) == 20018
  assert capped_sum(100) == 10059
}

test "return in a closure inside a generic function, for two types" {
  let a: [Option[U32]; 2] = wrap(5)
  assert opt_val(a[0]) == 9999
  assert opt_val(a[1]) == 5
  let b = wrap(true)
  let none_b = match b[0] {
    Some(_) => false,
    None => true,
  }
  assert none_b
  let some_b = match b[1] {
    Some(v) => v,
    None => false,
  }
  assert some_b
}

test "? in a closure inside a closure leaves the inner closure only" {
  // k = 0: inner = [half(0), half(1)] = [Some(0), Some(0)], outer = [0 + 0 + 0, 0 + 0 + 1], sum 1.
  assert nested(0) == 1
  // k = 100: inner = [None, None] = 9999 + 9999 = 19998, outer = [19998, 19999], sum 39997.
  assert nested(100) == 39997
}
