// onsa.toml
// [test]
// mode = "test"
// spec = ["§6.1", "§5.2", "§5.3", "§12.5"]

// Recursion through function values (spec §6.1 `.(` calls, §5.2, §5.3): a
// function that passes a function value to itself, an anonymous function that
// calls its enclosing function (with and without a captured value), and a named
// function used as a value. The depth is at most 50 (the limit of the call
// depth is 128, §12.5; the cases at and beyond the limit are in
// recursion_deep_fn_values.onsa).

fn apply_n(f: fn(I32) -> I32, n: U32, x: I32) -> I32 {
  if n == 0 {
    x
  } else {
    apply_n(f, n - 1, f.(x))
  }
}

fn call_with(k: U32, f: fn(U32) -> U32) -> U32 {
  f.(k)
}

// The anonymous function calls the enclosing function: every level of the
// recursion goes through a function value.
fn via_closure(n: U32) -> U32 {
  if n == 0 {
    0
  } else {
    call_with(n, fn(k: U32) -> U32 { via_closure(k - 1) + 1 })
  }
}

// The same with a captured value (a copy of `step`, spec §5.3).
fn via_capture(n: U32, step: U32) -> U32 {
  if n == 0 {
    0
  } else {
    call_with(n, fn(k: U32) -> U32 { via_capture(k - 1, step) + step })
  }
}

// A named function used as a value calls itself through the value.
fn walk(n: U32) -> U32 {
  if n == 0 {
    0
  } else {
    let g: fn(U32) -> U32 = walk
    1 + g.(n - 1)
  }
}

// An anonymous function that is not a captured one, bound by `let`, calls the
// recursive function.
fn via_local(n: U32) -> U32 {
  let f = fn(k: U32) -> U32 { k + 1 }
  if n == 0 {
    0
  } else {
    f.(via_local(n - 1))
  }
}

// Two functions that call each other, one through a function value.
fn left(n: U32) -> U32 {
  if n == 0 {
    0
  } else {
    call_with(n - 1, right)
  }
}

fn right(n: U32) -> U32 {
  if n == 0 {
    0
  } else {
    1 + left(n - 1)
  }
}

test "a function value is applied by a recursive function" {
  assert apply_n(fn(x: I32) -> I32 { x + 3 }, 40, 0) == 120
  let step = 2
  assert apply_n(fn(x: I32) -> I32 { x + step }, 25, 1) == 51
}

test "an anonymous function that calls its enclosing function" {
  assert via_closure(40) == 40
  assert via_closure(0) == 0
}

test "an anonymous function that captures a value and recurses" {
  assert via_capture(30, 3) == 90
  assert via_capture(30, 0) == 0
}

test "a recursion through a named function used as a value" {
  assert walk(40) == 40
}

test "a local anonymous function applied to the result of a recursive call" {
  assert via_local(40) == 40
}

test "mutual recursion with one call through a function value" {
  // left(n) = right(n - 1) = 1 + left(n - 2), left(0) = 0 and left(1) = right(0) = 0:
  // left(2k) = k and left(2k + 1) = k.
  assert left(40) == 20
  assert left(41) == 20
  assert left(0) == 0
}

test "an overflow inside a recursion through function values fails the test" {   //~ TESTFAIL "an overflow inside a recursion through function values fails the test"
  let r = apply_n(fn(x: I32) -> I32 { x * 1000 }, 10, 5)
  assert r == 0
}

test "the test after the failed one runs" {
  assert apply_n(fn(x: I32) -> I32 { x + 1 }, 10, 0) == 10
}
