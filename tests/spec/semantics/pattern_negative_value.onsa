// onsa.toml
// [test]
// mode = "test"
// spec = ["§7", "§4.7"]

// The same negative literal patterns as pattern_negative.onsa, in a `match` that gives a value
// (S-185; the lowering of this form is R-06 / W8-06, so this file is waiting for it).
//
// Every value below is worked out by hand from the spec text.

fn sign(n: I32) -> I32 {
  match n {
    -1 => 100,
    0 => 200,
    1 => 300,
    _ => 0,
  }
}

fn ends8(x: I8) -> I32 {
  match x {
    -128 => 1,
    127 => 2,
    _ => 0,
  }
}

fn tup(a: I32, b: I32) -> I32 {
  match (a, b) {
    (-1, -1) => 1,
    (-1, _) => 2,
    (_, -1) => 3,
    _ => 0,
  }
}

fn in_some(o: Option[I32]) -> I32 {
  match o {
    Some(-5) => 1,
    Some(_) => 2,
    None => 3,
  }
}

test "negative literal patterns in a match that gives a value" {
  assert sign(-1) == 100
  assert sign(0) == 200
  assert sign(1) == 300
  assert sign(-2) == 0
  assert ends8(I8.MIN) == 1
  assert ends8(I8.MAX) == 2
  assert ends8(0) == 0
  assert tup(-1, -1) == 1
  assert tup(-1, 5) == 2
  assert tup(5, -1) == 3
  assert tup(5, 5) == 0
  assert in_some(Some(-5)) == 1
  assert in_some(Some(5)) == 2
  assert in_some(None) == 3
}
