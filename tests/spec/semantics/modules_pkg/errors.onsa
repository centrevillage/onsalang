pub enum AppError {
  Negative,
  Overflow,
}

pub const LIMIT: I64 = 9223372036854775807

// Doubles `n`, reporting a result that does not fit in an I64.
pub fn checked_double(n: I64) -> Result[I64, AppError] {
  if n < 0 {
    return Err(AppError.Negative)
  }
  match n.checked_mul(2) {
    Some(v) => Ok(v),
    None => Err(AppError.Overflow),
  }
}
