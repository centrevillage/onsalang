// Types and functions used from other modules of the package (spec §15.1).

pub struct Point {
  x: I32,
  y: I32,
}

pub enum Shape {
  Circle(I32),
  Rect(I32, I32),
  Dot,
}

pub fn area(s: Shape) -> I32 {
  match s {
    Shape.Circle(r) => 3 * r * r,
    Shape.Rect(w, h) => w * h,
    Shape.Dot => 0,
  }
}

pub fn origin() -> Point {
  Point { x: 0, y: 0 }
}

pub fn or_default[T](o: Option[T], d: T) -> T {
  match o {
    Some(v) => v,
    None => d,
  }
}
