// onsa.toml
// [test]
// mode = "test"
// spec = ["§3.4", "§9.2", "§4.7", "§6.6"]

// `-a` of a signed integer is `0 - a` and panics when `a` is the minimum of the type: the
// result does not fit (spec §3.4). The operand does not have to be a literal for this to
// hold: `-(I32.MIN)` is the negation of the value `I32.MIN`, not a literal with a
// sign (R-03; the prefix `-` is part of the literal only when it is written directly on an
// integer literal, §4.7). `0 -% a` wraps (`checked_neg` is in checked_ops.onsa).
//
// A panic fails the test it happens in; `TESTFAIL` marks the expected failures.
// S-227 (§4.7): the `-` that is part of a literal is the one written directly on an integer
// literal, parentheses between them not seen, and only one. The `-` before a parenthesised
// negative literal (`-(-2147483648)`, `-(-128)`) is a negation of the value, not a literal:
// the inner `-2147483648` fits `I32`, so the checker accepts it, and the outer `-` panics at
// run time like `-(I32.MIN)` (§3.4). In a `const` initializer the same overflow is E0419
// (negative/const_neg_min.onsa). `-(-127) == 127` does not overflow.
//
// Every value below is worked out by hand from the spec text.

use std.array

const LOW: I32 = -2147483648

fn neg(x: I32) -> I32 {
  -x
}

fn neg8(x: I8) -> I8 {
  -x
}

test "negating I32.MIN panics" {   //~ TESTFAIL "negating I32.MIN panics"
  let a = -(I32.MIN)
  assert a == 0
}

test "negating I32.MIN without parentheses panics" {   //~ TESTFAIL "negating I32.MIN without parentheses panics"
  let a = -I32.MIN
  assert a == 0
}

test "negating I8.MIN panics" {   //~ TESTFAIL "negating I8.MIN panics"
  let a = -(I8.MIN)
  assert a == 0
}

test "negating I16.MIN panics" {   //~ TESTFAIL "negating I16.MIN panics"
  let a = -(I16.MIN)
  assert a == 0
}

test "negating I64.MIN panics" {   //~ TESTFAIL "negating I64.MIN panics"
  let a = -(I64.MIN)
  assert a == 0
}

test "negating a constant that holds the minimum panics" {   //~ TESTFAIL "negating a constant that holds the minimum panics"
  let a = -LOW
  assert a == 0
}

test "negating a variable that holds the minimum panics" {   //~ TESTFAIL "negating a variable that holds the minimum panics"
  let m: I32 = -2147483648
  let a = -m
  assert a == 0
}

test "negating the minimum in a function panics" {   //~ TESTFAIL "negating the minimum in a function panics"
  let a = neg(I32.MIN)
  assert a == 0
}

test "negating I8.MIN in a function panics" {   //~ TESTFAIL "negating I8.MIN in a function panics"
  let a = neg8(I8.MIN)
  assert a == 0
}

test "negation of values next to the minimum does not panic" {
  assert -(I32.MIN + 1) == I32.MAX
  let low1 = I32.MIN + 1
  assert -I32.MAX == low1
  assert neg(I32.MAX) == -2147483647
  assert neg(-5) == 5
  assert neg8(-127) == 127
}

test "wrapping negation of the minimum gives the minimum" {
  let m: I32 = I32.MIN
  assert (0 -% m) == I32.MIN
  let n: I8 = I8.MIN
  assert (0 -% n) == I8.MIN
}

// ---------------------------------------------------------------- S-227: -(-literal)

test "negating a parenthesised I32 minimum literal panics" {   //~ TESTFAIL "negating a parenthesised I32 minimum literal panics"
  let a = -(-2147483648)
  assert a == 0
}

test "negating a parenthesised I32 minimum literal with an annotation panics" {   //~ TESTFAIL "negating a parenthesised I32 minimum literal with an annotation panics"
  let a: I32 = -(-2147483648)
  assert a == 0
}

test "negating a parenthesised I8 minimum literal panics" {   //~ TESTFAIL "negating a parenthesised I8 minimum literal panics"
  let a: I8 = -(-128)
  assert a == 0
}

test "negating a parenthesised I16 minimum literal panics" {   //~ TESTFAIL "negating a parenthesised I16 minimum literal panics"
  let a: I16 = -(-32768)
  assert a == 0
}

test "negating a parenthesised I64 minimum literal panics" {   //~ TESTFAIL "negating a parenthesised I64 minimum literal panics"
  let a: I64 = -(-9223372036854775808)
  assert a == 0
}

test "negating a parenthesised minimum literal in an argument panics" {   //~ TESTFAIL "negating a parenthesised minimum literal in an argument panics"
  let a = neg8(-(-128))
  assert a == 0
}

test "negating a parenthesised minimum literal in a branch panics" {   //~ TESTFAIL "negating a parenthesised minimum literal in a branch panics"
  let flag = true
  let a: I8 = if flag { -(-128) } else { 0 }
  assert a == 0
}

test "negating a parenthesised minimum literal in a closure panics" {   //~ TESTFAIL "negating a parenthesised minimum literal in a closure panics"
  let xs: [I8; 2] = array.from_fn(fn(i) { -(-128) })
  assert xs[0] == 0
}

test "the negation of a negative literal one above the minimum does not panic" {
  let a: I8 = -(-127)
  assert a == 127
  assert -(-127) == 127
  let b: I32 = -(-2147483647)
  assert b == I32.MAX
  let c: I32 = -(-5)
  assert c == 5
  let d: I16 = -(-32767)
  assert d == I16.MAX
}

test "the positive extreme negated and negated again does not panic" {
  let a: I8 = -(127)
  assert a == -127
  let b: I8 = -(-(127))
  assert b == 127
}
