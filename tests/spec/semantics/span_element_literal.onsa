// onsa.toml
// [test]
// mode = "test"
// spec = ["§5.3", "§5.2", "§11.6"]

// Channels in separate variables, passed to a function of `[Span[T]; N]` as `[a, b]` / `inout [a, b]`
// (§5.3: "別々の変数にあるときは `[a, b]` / `inout [a, b]` と配列リテラルを引数の位置にだけ書け（要素の
// 種類と長さは揃っていなくてよい…）"), and the elements used as receivers (S-181). The channels
// here differ in length and in kind (an array and a part of another array), so they cannot be
// one nested array. The same functions over a nested array are in span_element_receiver.onsa.

fn lens(xs: [Span[F32]; 2]) -> U32 {
  (xs[0].len() * 100) + xs[1].len()
}

fn write_at(inout xs: [Span[F32]; 2], k: U32, i: U32, v: F32) {
  xs[k][i] = v
}

fn fill_channel(inout xs: [Span[F32]; 2], k: U32, v: F32) {
  xs[k].fill!(v)
}

fn clear(inout s: Span[F32]) {
  s.fill!(0.0)
}

fn clear_channel(inout xs: [Span[F32]; 2], k: U32) {
  clear(inout xs[k])
}

fn ramp_all(inout xs: [Span[F32]; 2]) {
  for k in 0..<2 {
    for i in 0..<xs[k].len() {
      xs[k][i] = ((k * 10) + i).round_f32()
    }
  }
}

fn get_or(xs: [Span[F32]; 2], k: U32, i: U32) -> F32 {
  match xs[k].get(i) {
    Some(v) => v,
    None => -1.0,
  }
}

test "xs[k].len() on channels of different lengths in separate variables" {
  let a: [F32; 3] = [1.0, 2.0, 3.0]
  let b: [F32; 5] = [0.0; 5]
  assert lens([a, b]) == 305
  assert lens([b, a]) == 503
}

test "xs[k].get(i) on channels of different lengths" {
  let a: [F32; 2] = [1.0, 2.0]
  let b: [F32; 4] = [10.0, 20.0, 30.0, 40.0]
  assert get_or([a, b], 0, 1) == 2.0
  assert get_or([a, b], 0, 2) == -1.0
  assert get_or([a, b], 1, 3) == 40.0
}

test "xs[k][i] = v through inout [a, b]" {
  var a: [F32; 3] = [0.0; 3]
  var b: [F32; 5] = [0.0; 5]
  write_at(inout [a, b], 1, 4, 7.5)
  write_at(inout [a, b], 0, 0, 1.5)
  assert a[0] == 1.5
  assert a[2] == 0.0
  assert b[4] == 7.5
  assert b[0] == 0.0
}

test "xs[k].fill!(v) through inout [a, b] fills one channel and leaves the other" {
  var a: [F32; 3] = [1.0, 1.0, 1.0]
  var b: [F32; 2] = [2.0, 2.0]
  fill_channel(inout [a, b], 1, 9.0)
  assert a[0] == 1.0
  assert a[2] == 1.0
  assert b[0] == 9.0
  assert b[1] == 9.0
}

test "inout xs[k] as an argument, through inout [a, b]" {
  var a: [F32; 2] = [1.0, 2.0]
  var b: [F32; 3] = [3.0, 4.0, 5.0]
  clear_channel(inout [a, b], 0)
  assert a[0] == 0.0
  assert a[1] == 0.0
  assert b[0] == 3.0
  assert b[2] == 5.0
}

test "nested loops over inout [a, b] write each channel up to its own length" {
  var a: [F32; 3] = [0.0; 3]
  var b: [F32; 2] = [0.0; 2]
  ramp_all(inout [a, b])
  assert a[0] == 0.0
  assert a[1] == 1.0
  assert a[2] == 2.0
  assert b[0] == 10.0
  assert b[1] == 11.0
}

test "a part of a buffer is one channel of inout [a, b]" {
  var a: [F32; 3] = [0.0; 3]
  var long: [F32; 6] = [0.0; 6]
  fill_channel(inout [a, long.slice(2, 4)], 1, 4.0)
  assert long[1] == 0.0
  assert long[2] == 4.0
  assert long[3] == 4.0
  assert long[4] == 0.0
}
