// onsa.toml
// [test]
// mode = "test"
// spec = ["§12.5", "§6.6", "§11.3", "§9.2"]

// A `const` is evaluated from its own entry (spec §12.5, decided as S-222): the
// limit of the call depth is 128, counted from the entry of an evaluation (the
// initializer of the `const`) by the number of nested calls, and READING a
// `const` is not a call. The value of a `const` is the same wherever it is
// read, so it does not depend on the depth of the call that reads it, nor on
// which test reads it first, nor on the order of the tests (§11.3: the same
// expression gives the same result whether or not it is written as a `const`).
//
// Each initializer below makes at most 128 nested calls from its own entry, and
// is read from places that are nested up to 100 or 127 calls deep, so a depth
// that was inherited from the reader would be far over the limit. The reader
// that is itself too deep (`user(128)`) fails its own test, and nothing else.

fn dive(n: U32) -> U32 {
  if n == 0 {
    0
  } else {
    1 + dive(n - 1)
  }
}

// 128 nested calls from the entry of the initializer.
const AT_LIMIT: U32 = dive(127)
const HALF: U32 = dive(63)

// Reads another `const` (not a call) and makes 128 nested calls of its own.
const SECOND: U32 = AT_LIMIT + dive(127)

// An associated `const` is an entry too (§6.6).
pub struct Counter {
  base: U32,
}

impl Counter {
  const START: U32 = dive(127)
}

// A recursion of depth k that reads `AT_LIMIT` at the bottom.
fn user(n: U32) -> U32 {
  if n == 0 {
    AT_LIMIT
  } else {
    user(n - 1)
  }
}

fn user_half(n: U32) -> U32 {
  if n == 0 {
    HALF
  } else {
    user_half(n - 1)
  }
}

// A first read from a deep place: this test is the first in the file that reads
// `AT_LIMIT`, at depth 100 (user(100) is depth 1 .. 101, and the read of the
// `const` is not a call).
test "a deep user reads a constant first" {
  assert user(100) == 127
}

test "the top level reads the same constant" {
  assert AT_LIMIT == 127
}

test "a deep user reads it again" {
  assert user(100) == 127
}

test "the user at the boundary depth reads it" {
  // user(127) is depth 1 .. 128: user(0) at depth 128 reads `AT_LIMIT`.
  assert user(127) == 127
}

test "a user one level beyond the boundary fails its own test" {   //~ TESTFAIL "a user one level beyond the boundary fails its own test"
  assert user(128) == 127
}

test "the constant is the same value after that failed test" {
  assert AT_LIMIT == 127
  assert user(127) == 127
}

test "a constant whose initializer reads another constant" {
  assert SECOND == 254
}

test "an associated constant evaluated from its own entry" {
  assert Counter.START == 127
  assert user(100) == 127
}

test "a constant used in the arguments of deep calls" {
  assert dive(AT_LIMIT) == 127
  assert user_half(120) == 63
}

test "a call and a constant in one expression" {
  // The call `dive(127)` is depth 1 .. 128, and the constants read next to it
  // do not add to it.
  assert (dive(127) + AT_LIMIT + HALF) == 317
}

// ---------------------------------------- an initializer that reads a deep user

// `P1` is initialized by a recursion 100 deep that reads `P0` at the bottom;
// `P0` is evaluated from its own entry and makes 128 nested calls. If the depth
// of the reader were inherited, `P0` would be at depth 101 + 128. Each of P1, P2
// and P3 does the same with the one before.
const P0: U32 = dive(127)

fn via0(n: U32) -> U32 {
  if n == 0 {
    P0
  } else {
    via0(n - 1)
  }
}

const P1: U32 = via0(100)

fn via1(n: U32) -> U32 {
  if n == 0 {
    P1
  } else {
    via1(n - 1)
  }
}

const P2: U32 = via1(100)

fn via2(n: U32) -> U32 {
  if n == 0 {
    P2
  } else {
    via2(n - 1)
  }
}

const P3: U32 = via2(100)

test "the last constant of a chain through deep readers is read first" {
  assert P3 == 127
}

test "the others of that chain have the same value" {
  assert P1 == 127
  assert P2 == 127
  assert P0 == 127
}

test "a reader in a test reads the end of the chain from the boundary depth" {
  assert via2(127) == 127
}

// -------------------------------------- a chain of constants is not a recursion

// L0 .. L299: each reads the one before. A `const` that reads a `const` is not a
// call, so a chain of 300 is not 300 deep. M0 .. M299 are the same with 128
// nested calls in each initializer.

