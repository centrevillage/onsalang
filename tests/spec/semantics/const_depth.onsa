test "the end of a chain of 300 constants" {
  assert L299 == 300
}

test "the middle of the chain" {
  assert L150 == 151
  assert L0 == 1
}

test "the end of a chain of 300 constants that make calls" {
  assert M299 == 38100
}

test "the end of the chains is read from a deep place" {
  assert via_chain(100) == 300
}

fn via_chain(n: U32) -> U32 {
  if n == 0 {
    L299
  } else {
    via_chain(n - 1)
  }
}
