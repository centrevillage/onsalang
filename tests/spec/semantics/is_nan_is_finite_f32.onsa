// onsa.toml
// [test]
// mode = "test"
// spec = ["§3.4", "§13.4"]

// `std.math.is_nan` and `std.math.is_finite` on an `F32` (spec §13.4, §3.4; the same judgements as for an `F64`
// in is_nan_is_finite_f64.onsa). A number that overflows binary32 is an infinity, which an `F64` of the same
// size is not; `-0.0` and a subnormal number are numbers; every NaN, whatever its sign and payload, is NaN.

use std.math.{is_finite, is_nan}

test "F32: the special values" {
  let nan: F32  = F32.NAN
  let inf: F32  = F32.INFINITY
  let ninf: F32 = -F32.INFINITY
  assert is_nan(nan)
  assert !is_finite(nan)
  assert !is_nan(inf)
  assert !is_finite(inf)
  assert !is_nan(ninf)
  assert !is_finite(ninf)
}

test "F32: -0.0 and the ends of the range are numbers" {
  let nzero: F32 = -0.0
  let big: F32   = F32.MAX
  let nbig: F32  = -F32.MAX
  assert !is_nan(nzero)
  assert is_finite(nzero)
  assert !is_nan(big)
  assert is_finite(big)
  assert is_finite(nbig)
}

test "F32: a number that overflows binary32 is an infinity, not NaN" {
  let big: F32 = F32.MAX
  let two: F32 = 2.0
  let doubled  = big * two
  assert !is_nan(doubled)
  assert !is_finite(doubled)
  let wide: F64 = F32.MAX as F64
  assert is_finite(wide * 2.0)
}

test "F32: a subnormal number is a number" {
  let smallest: F32 = F32.from_bits(1)
  let biggest: F32  = F32.from_bits(0x007F_FFFF)
  assert !is_nan(smallest)
  assert is_finite(smallest)
  assert !is_nan(biggest)
  assert is_finite(biggest)
}

test "F32: NaN from bits, with any sign and payload" {
  let quiet: F32    = F32.from_bits(0x7FC0_0000)
  let negative: F32 = F32.from_bits(0xFFC0_0000)
  let payload: F32  = F32.from_bits(0x7FC0_0001)
  let inf: F32      = F32.from_bits(0x7F80_0000)
  let ninf: F32     = F32.from_bits(0xFF80_0000)
  assert is_nan(quiet)
  assert is_nan(negative)
  assert is_nan(payload)
  assert !is_finite(payload)
  assert !is_nan(inf)
  assert !is_finite(inf)
  assert !is_nan(ninf)
  assert !is_finite(ninf)
}

test "F32: the results of operations" {
  let zero: F32 = 0.0
  let inf: F32  = F32.INFINITY
  let one: F32  = 1.0
  assert is_nan(zero / zero)
  assert is_nan(inf - inf)
  assert !is_nan(one / zero)
  assert !is_finite(one / zero)
  assert is_finite(one / inf)
  assert is_nan(inf % one)
  assert !is_nan(one % inf)
  assert is_finite(one % inf)
}
