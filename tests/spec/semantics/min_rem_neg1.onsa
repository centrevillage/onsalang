// onsa.toml
// [test]
// mode = "test"
// spec = ["§3.4", "§5.3", "§7", "§9.2"]

// `MIN % -1` and `MIN / -1` at every signed width (spec §3.4, §9.2). Only a
// result that does not fit the type panics: `MIN / -1` is 2^(w-1), which is one
// above MAX, so it panics (and so does `MIN.div_euclid(-1)`), while
// `MIN % -1` and `MIN.rem_euclid(-1)` are 0, which fits, so they do not panic
// (the host remainder instruction traps here, and the spec says it must not).
// `MIN` is -2^(w-1) and `MAX` is 2^(w-1) - 1 for w = 8, 16, 32, 64. The
// values next to the edge are in the tests of each width; the same operations
// inside a function, a closure, a `match` arm and a loop are at the end.
// Checked methods (`checked_rem` and friends) are in min_checked_rem.onsa and
// the generic form in numeric_generic_edges.onsa.
//
//   a % b            a - (a / b) * b, the sign follows the dividend
//   a.rem_euclid(b)  r with 0 <= r < |b| and a == q * b + r
//   a.div_euclid(b)  the q of that equation

use std.array

fn rem32(a: I32, b: I32) -> I32 {
  a % b
}

fn div32(a: I32, b: I32) -> I32 {
  a / b
}

fn rem_opt(o: Option[I16]) -> I16 {
  match o {
    Some(v) => v % -1,
    None => 7,
  }
}

fn div_opt(o: Option[I16]) -> I16 {
  match o {
    Some(v) => v / -1,
    None => 7,
  }
}

// ---------------------------------------------------------------------- I8

test "I8.MIN % -1 is 0" {
  let a: I8 = I8.MIN
  let m: I8 = -1
  let r = a % m
  assert r == 0
  let l = a % -1
  assert l == 0
  let e = a.rem_euclid(m)
  assert e == 0
  let f = a.rem_euclid(-1)
  assert f == 0
}

test "I8: (MIN + 1) % -1 and MAX % -1 are 0, MAX / -1 is -MAX" {
  let a: I8 = I8.MIN
  let b = a + 1
  let m: I8 = -1
  let v1 = b % m
  assert v1 == 0
  let c: I8 = I8.MAX
  let v2 = c % m
  assert v2 == 0
  assert c.rem_euclid(m) == 0
  let q = c / m
  assert q == -127
  let p = b / m
  assert p == 127
}

test "I8: the quotient and remainder next to MIN are exact" {
  let a: I8 = I8.MIN
  let b = a + 1
  let mx: I8 = I8.MAX
  // -128 = -1 * 127 - 1, so the truncated quotient is -1 and the remainder -1.
  let v3 = a / mx
  assert v3 == -1
  let v4 = a % mx
  assert v4 == -1
  // The Euclidean remainder is not negative: -128 = -2 * 127 + 126.
  assert a.div_euclid(mx) == -2
  assert a.rem_euclid(mx) == 126
  // Dividing by 1, 2, -2 and by MIN itself.
  let v5 = a / 1
  assert v5 == a
  let v6 = a % 1
  assert v6 == 0
  let v7 = a % 2
  assert v7 == 0
  let v8 = b % 2
  assert v8 == -1
  assert b.rem_euclid(2) == 1
  assert b.div_euclid(2) == -64
  let v9 = a / -2
  assert v9 == 64
  let v10 = a % -2
  assert v10 == 0
  assert a.div_euclid(-2) == 64
  assert a.rem_euclid(-2) == 0
  let v11 = a / a
  assert v11 == 1
  let v12 = a % a
  assert v12 == 0
  let v13 = a / b
  assert v13 == 1
  let v14 = a % b
  assert v14 == -1
  let v15 = b / a
  assert v15 == 0
  let v16 = b % a
  assert v16 == b
}

test "I8.MIN / -1 panics" {   //~ TESTFAIL "I8.MIN / -1 panics"
  let a: I8 = I8.MIN
  let m: I8 = -1
  let _ = a / m
}

test "I8.MIN / -1 with a literal divisor panics" {   //~ TESTFAIL "I8.MIN / -1 with a literal divisor panics"
  let a: I8 = I8.MIN
  let _ = a / -1
}

test "I8.MIN.div_euclid(-1) panics" {   //~ TESTFAIL "I8.MIN.div_euclid(-1) panics"
  let a: I8 = I8.MIN
  let m: I8 = -1
  let _ = a.div_euclid(m)
}

// ---------------------------------------------------------------------- I16

test "I16.MIN % -1 is 0" {
  let a: I16 = I16.MIN
  let m: I16 = -1
  let r = a % m
  assert r == 0
  let l = a % -1
  assert l == 0
  let e = a.rem_euclid(m)
  assert e == 0
  let f = a.rem_euclid(-1)
  assert f == 0
}

test "I16: (MIN + 1) % -1 and MAX % -1 are 0, MAX / -1 is -MAX" {
  let a: I16 = I16.MIN
  let b = a + 1
  let m: I16 = -1
  let v17 = b % m
  assert v17 == 0
  let c: I16 = I16.MAX
  let v18 = c % m
  assert v18 == 0
  assert c.rem_euclid(m) == 0
  let q = c / m
  assert q == -32767
  let p = b / m
  assert p == 32767
}

test "I16: the quotient and remainder next to MIN are exact" {
  let a: I16 = I16.MIN
  let b = a + 1
  let mx: I16 = I16.MAX
  // -32768 = -1 * 32767 - 1, so the truncated quotient is -1 and the remainder -1.
  let v19 = a / mx
  assert v19 == -1
  let v20 = a % mx
  assert v20 == -1
  // The Euclidean remainder is not negative: -32768 = -2 * 32767 + 32766.
  assert a.div_euclid(mx) == -2
  assert a.rem_euclid(mx) == 32766
  // Dividing by 1, 2, -2 and by MIN itself.
  let v21 = a / 1
  assert v21 == a
  let v22 = a % 1
  assert v22 == 0
  let v23 = a % 2
  assert v23 == 0
  let v24 = b % 2
  assert v24 == -1
  assert b.rem_euclid(2) == 1
  assert b.div_euclid(2) == -16384
  let v25 = a / -2
  assert v25 == 16384
  let v26 = a % -2
  assert v26 == 0
  assert a.div_euclid(-2) == 16384
  assert a.rem_euclid(-2) == 0
  let v27 = a / a
  assert v27 == 1
  let v28 = a % a
  assert v28 == 0
  let v29 = a / b
  assert v29 == 1
  let v30 = a % b
  assert v30 == -1
  let v31 = b / a
  assert v31 == 0
  let v32 = b % a
  assert v32 == b
}

test "I16.MIN / -1 panics" {   //~ TESTFAIL "I16.MIN / -1 panics"
  let a: I16 = I16.MIN
  let m: I16 = -1
  let _ = a / m
}

test "I16.MIN / -1 with a literal divisor panics" {   //~ TESTFAIL "I16.MIN / -1 with a literal divisor panics"
  let a: I16 = I16.MIN
  let _ = a / -1
}

test "I16.MIN.div_euclid(-1) panics" {   //~ TESTFAIL "I16.MIN.div_euclid(-1) panics"
  let a: I16 = I16.MIN
  let m: I16 = -1
  let _ = a.div_euclid(m)
}

// ---------------------------------------------------------------------- I32

test "I32.MIN % -1 is 0" {
  let a: I32 = I32.MIN
  let m: I32 = -1
  let r = a % m
  assert r == 0
  let l = a % -1
  assert l == 0
  let e = a.rem_euclid(m)
  assert e == 0
  let f = a.rem_euclid(-1)
  assert f == 0
}

test "I32: (MIN + 1) % -1 and MAX % -1 are 0, MAX / -1 is -MAX" {
  let a: I32 = I32.MIN
  let b = a + 1
  let m: I32 = -1
  let v33 = b % m
  assert v33 == 0
  let c: I32 = I32.MAX
  let v34 = c % m
  assert v34 == 0
  assert c.rem_euclid(m) == 0
  let q = c / m
  assert q == -2147483647
  let p = b / m
  assert p == 2147483647
}

test "I32: the quotient and remainder next to MIN are exact" {
  let a: I32 = I32.MIN
  let b = a + 1
  let mx: I32 = I32.MAX
  // -2147483648 = -1 * 2147483647 - 1, so the truncated quotient is -1 and the remainder -1.
  let v35 = a / mx
  assert v35 == -1
  let v36 = a % mx
  assert v36 == -1
  // The Euclidean remainder is not negative: -2147483648 = -2 * 2147483647 + 2147483646.
  assert a.div_euclid(mx) == -2
  assert a.rem_euclid(mx) == 2147483646
  // Dividing by 1, 2, -2 and by MIN itself.
  let v37 = a / 1
  assert v37 == a
  let v38 = a % 1
  assert v38 == 0
  let v39 = a % 2
  assert v39 == 0
  let v40 = b % 2
  assert v40 == -1
  assert b.rem_euclid(2) == 1
  assert b.div_euclid(2) == -1073741824
  let v41 = a / -2
  assert v41 == 1073741824
  let v42 = a % -2
  assert v42 == 0
  assert a.div_euclid(-2) == 1073741824
  assert a.rem_euclid(-2) == 0
  let v43 = a / a
  assert v43 == 1
  let v44 = a % a
  assert v44 == 0
  let v45 = a / b
  assert v45 == 1
  let v46 = a % b
  assert v46 == -1
  let v47 = b / a
  assert v47 == 0
  let v48 = b % a
  assert v48 == b
}

test "I32.MIN / -1 panics" {   //~ TESTFAIL "I32.MIN / -1 panics"
  let a: I32 = I32.MIN
  let m: I32 = -1
  let _ = a / m
}

test "I32.MIN / -1 with a literal divisor panics" {   //~ TESTFAIL "I32.MIN / -1 with a literal divisor panics"
  let a: I32 = I32.MIN
  let _ = a / -1
}

test "I32.MIN.div_euclid(-1) panics" {   //~ TESTFAIL "I32.MIN.div_euclid(-1) panics"
  let a: I32 = I32.MIN
  let m: I32 = -1
  let _ = a.div_euclid(m)
}

// ---------------------------------------------------------------------- I64

test "I64.MIN % -1 is 0" {
  let a: I64 = I64.MIN
  let m: I64 = -1
  let r = a % m
  assert r == 0
  let l = a % -1
  assert l == 0
  let e = a.rem_euclid(m)
  assert e == 0
  let f = a.rem_euclid(-1)
  assert f == 0
}

test "I64: (MIN + 1) % -1 and MAX % -1 are 0, MAX / -1 is -MAX" {
  let a: I64 = I64.MIN
  let b = a + 1
  let m: I64 = -1
  let v49 = b % m
  assert v49 == 0
  let c: I64 = I64.MAX
  let v50 = c % m
  assert v50 == 0
  assert c.rem_euclid(m) == 0
  let q = c / m
  assert q == -9223372036854775807
  let p = b / m
  assert p == 9223372036854775807
}

test "I64: the quotient and remainder next to MIN are exact" {
  let a: I64 = I64.MIN
  let b = a + 1
  let mx: I64 = I64.MAX
  // -9223372036854775808 = -1 * 9223372036854775807 - 1, so the truncated quotient is -1 and the remainder -1.
  let v51 = a / mx
  assert v51 == -1
  let v52 = a % mx
  assert v52 == -1
  // The Euclidean remainder is not negative: -9223372036854775808 = -2 * 9223372036854775807 + 9223372036854775806.
  assert a.div_euclid(mx) == -2
  assert a.rem_euclid(mx) == 9223372036854775806
  // Dividing by 1, 2, -2 and by MIN itself.
  let v53 = a / 1
  assert v53 == a
  let v54 = a % 1
  assert v54 == 0
  let v55 = a % 2
  assert v55 == 0
  let v56 = b % 2
  assert v56 == -1
  assert b.rem_euclid(2) == 1
  assert b.div_euclid(2) == -4611686018427387904
  let v57 = a / -2
  assert v57 == 4611686018427387904
  let v58 = a % -2
  assert v58 == 0
  assert a.div_euclid(-2) == 4611686018427387904
  assert a.rem_euclid(-2) == 0
  let v59 = a / a
  assert v59 == 1
  let v60 = a % a
  assert v60 == 0
  let v61 = a / b
  assert v61 == 1
  let v62 = a % b
  assert v62 == -1
  let v63 = b / a
  assert v63 == 0
  let v64 = b % a
  assert v64 == b
}

test "I64.MIN / -1 panics" {   //~ TESTFAIL "I64.MIN / -1 panics"
  let a: I64 = I64.MIN
  let m: I64 = -1
  let _ = a / m
}

test "I64.MIN / -1 with a literal divisor panics" {   //~ TESTFAIL "I64.MIN / -1 with a literal divisor panics"
  let a: I64 = I64.MIN
  let _ = a / -1
}

test "I64.MIN.div_euclid(-1) panics" {   //~ TESTFAIL "I64.MIN.div_euclid(-1) panics"
  let a: I64 = I64.MIN
  let m: I64 = -1
  let _ = a.div_euclid(m)
}

// ------------------------------------------------------- the same in other places

test "MIN % -1 in a function, a closure, a match arm and a loop is 0" {
  let a: I32 = I32.MIN
  assert rem32(a, -1) == 0
  let min16: I16 = I16.MIN
  assert rem_opt(Some(min16)) == 0
  assert rem_opt(None) == 7
  // The closure captures the dividend and the divisor.
  let d: I64 = -1
  let x: I64 = I64.MIN
  let ys: [I64; 3] = array.from_fn(fn(_) { x % d })
  assert ys[0] == 0
  assert ys[2] == 0
  var acc: I8 = 0
  for _ in 0..<3 {
    let m: I8 = I8.MIN
    let r = m % -1
    acc = acc + r
  }
  assert acc == 0
}

test "MIN / -1 in a function panics" {   //~ TESTFAIL "MIN / -1 in a function panics"
  let a: I32 = I32.MIN
  let _ = div32(a, -1)
}

test "MIN / -1 in the arm of a match on an Option panics" {   //~ TESTFAIL "MIN / -1 in the arm of a match on an Option panics"
  let a: I16 = I16.MIN
  let _ = div_opt(Some(a))
}

test "MIN / -1 inside an anonymous function panics" {   //~ TESTFAIL "MIN / -1 inside an anonymous function panics"
  let d: I64 = -1
  let x: I64 = I64.MIN
  let _: [I64; 2] = array.from_fn(fn(_) { x / d })
}

test "MIN / -1 in a loop panics" {   //~ TESTFAIL "MIN / -1 in a loop panics"
  var acc: I8 = 0
  for _ in 0..<3 {
    let m: I8 = I8.MIN
    let q = m / -1
    acc = acc + q
  }
}

test "MIN / -1 in the middle of an expression panics" {   //~ TESTFAIL "MIN / -1 in the middle of an expression panics"
  let a: I32 = I32.MIN
  let m: I32 = -1
  let q = (a / m) - 1
  assert q == 0
}
