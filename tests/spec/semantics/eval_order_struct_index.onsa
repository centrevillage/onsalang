// onsa.toml
// [test]
// mode = "test"
// spec = ["§3.5", "§5.2", "§4.4"]

// Evaluation order of struct literals and of nested indices (spec §3.5, the
// paragraph of sibling elements of §5.2). The order is observed through a
// `U32` log: `tick(inout log, d)` appends the decimal digit `d` to `log`, so
// the log after an expression reads as the order in which the calls ran.
//
// The forms of `eval_order.onsa` (a struct literal of two fields against the
// declaration order, one nested assignment of two indices into a 4x4 grid, one
// nested read of two indices) are not repeated.
//
// Not covered: an index that changes its own base (`xs[reset(inout xs)]`),
// which is E0702 (§5.2).

fn tick(inout log: U32, d: U32) -> U32 {
  let shifted = log * 10
  log = shifted + d
  d
}

// Appends `d` to the log and returns `i` (an index).
fn idx(inout log: U32, d: U32, i: U32) -> U32 {
  let shifted = log * 10
  log = shifted + d
  i
}

// `k` goes up by one and the new value is returned.
fn next(inout k: U32) -> U32 {
  k = k + 1
  k
}

// `x` goes up by ten and the new value is returned.
fn bump(inout x: U32) -> U32 {
  x = x + 10
  x
}

fn rows(inout log: U32, d: U32) -> [[U32; 3]; 3] {
  let shifted = log * 10
  log = shifted + d
  [[0, 1, 2], [10, 11, 12], [20, 21, 22]]
}

fn boom(z: I32) -> I32 {
  1 / z
}

pub struct Pair {
  a: U32,
  b: U32,
}

pub struct Trio {
  a: U32,
  b: U32,
  c: U32,
}

pub struct Mixed {
  a: U32,
  b: I32,
}

pub struct Outer {
  x: U32,
  y: Pair,
}

pub struct Cfg {
  gain: U32,
  bias: U32 = 7,
  mode: U32 = 9,
}

pub struct Wrap[T] {
  v: T,
  w: T,
}

pub struct Cell {
  vals: [U32; 4],
}

pub struct World {
  cells: [Cell; 3],
}

fn pair_sum(p: Pair, k: U32) -> U32 {
  p.a * 100 + p.b * 10 + k
}

// ------------------------------------------------------------- struct literals

test "three fields written against the declaration order run in the order written" {
  var log: U32 = 0
  let t = Trio { c: tick(inout log, 1), a: tick(inout log, 2), b: tick(inout log, 3) }
  assert log == 123
  assert t.c == 1
  assert t.a == 2
  assert t.b == 3
}

test "a sibling field written first reads the value before a later field changes it" {
  var x: U32 = 5
  let p = Pair { b: x, a: bump(inout x) }
  assert p.b == 5
  assert p.a == 15
  assert x == 15
}

test "a sibling field written later reads the value that an earlier field changed" {
  var x: U32 = 5
  let p = Pair { b: bump(inout x), a: x }
  assert p.b == 15
  assert p.a == 15
  assert x == 15
}

test "a field that indexes uses the variable after the field written before it" {
  var x: U32 = 0
  let xs: [U32; 3] = [10, 20, 30]
  let p = Pair { b: next(inout x), a: xs[x] }
  assert p.b == 1
  assert p.a == 20
  assert x == 1
}

test "fields that are filled by the declared defaults run no effect and keep the order written" {
  var log: U32 = 0
  let c = Cfg { mode: tick(inout log, 1), gain: tick(inout log, 2), ... }
  assert log == 12
  assert c.mode == 1
  assert c.gain == 2
  assert c.bias == 7
  let d = Cfg { bias: tick(inout log, 3), gain: tick(inout log, 4), ... }
  assert log == 1234
  assert d.bias == 3
  assert d.gain == 4
  assert d.mode == 9
}

test "a nested struct literal runs the inner fields where it is written" {
  var log: U32 = 0
  let o = Outer { y: Pair { b: tick(inout log, 1), a: tick(inout log, 2) }, x: tick(inout log, 3) }
  assert log == 123
  assert o.y.b == 1
  assert o.y.a == 2
  assert o.x == 3
  let q = Outer { x: tick(inout log, 4), y: Pair { b: tick(inout log, 5), a: tick(inout log, 6) } }
  assert log == 123456
  assert q.x == 4
  assert q.y.b == 5
  assert q.y.a == 6
}

test "a generic struct literal runs its fields in the order written" {
  var log: U32 = 0
  let g: Wrap[U32] = Wrap { w: tick(inout log, 1), v: tick(inout log, 2) }
  assert log == 12
  assert g.w == 1
  assert g.v == 2
}

test "struct literals in an array literal run one after the other" {
  var log: U32 = 0
  let ps = [Pair { b: tick(inout log, 1), a: tick(inout log, 2) }, Pair { b: tick(inout log, 3), a: tick(inout log, 4) }]
  assert log == 1234
  assert ps[0].b == 1
  assert ps[0].a == 2
  assert ps[1].b == 3
  assert ps[1].a == 4
}

test "a struct literal argument runs before the argument that follows it" {
  var log: U32 = 0
  let r = pair_sum(Pair { b: tick(inout log, 1), a: tick(inout log, 2) }, tick(inout log, 3))
  assert log == 123
  assert r == 213
}

test "only the struct literal of the taken branch runs" {
  var log: U32 = 0
  let c: Bool = true
  let p = if c {
    Pair { b: tick(inout log, 1), a: tick(inout log, 2) }
  } else {
    Pair { b: tick(inout log, 3), a: tick(inout log, 4) }
  }
  assert log == 12
  assert p.b == 1
  assert p.a == 2
}

test "a struct literal in a loop body runs in the order written at every iteration" {
  var log: U32 = 0
  for i in 1..<3 {
    let p = Pair { b: tick(inout log, i), a: tick(inout log, i + 1) }
    assert p.b == i
  }
  assert log == 1223
}

test "a field that reads a nested index runs where it is written" {
  var k: U32 = 0
  let grid: [[U32; 4]; 4] = [[0, 1, 2, 3], [10, 11, 12, 13], [20, 21, 22, 23], [30, 31, 32, 33]]
  let p = Pair { b: grid[next(inout k)][next(inout k)], a: next(inout k) }
  assert p.b == 12
  assert p.a == 3
  assert k == 3
}

// ------------------------------------------------------- panics, struct literals

test "the first panic of a struct literal is the field written first" {
  let z: I32 = 0
  let xs: [U32; 2] = [1, 2]
  let i: U32 = 5
  let p = Mixed {
    b: 1 / z,   //~ PANIC "the first panic of a struct literal is the field written first"
    a: xs[i],
  }
  assert p.a == 0
}

test "the first panic of a struct literal written in the declaration order is its first field" {
  let z: I32 = 0
  let xs: [U32; 2] = [1, 2]
  let i: U32 = 5
  let p = Mixed {
    a: xs[i],   //~ PANIC "the first panic of a struct literal written in the declaration order is its first field"
    b: 1 / z,
  }
  assert p.a == 0
}

test "the first panic of an array literal is the element written first" {
  let z: I32 = 0
  let xs: [I32; 2] = [1, 2]
  let i: U32 = 5
  let a = [1 / z, xs[i]]   //~ PANIC "the first panic of an array literal is the element written first" @12
  assert a[0] == 0
}

test "the second element of an array literal panics when the first does not" {
  let z: I32 = 0
  let xs: [I32; 2] = [1, 2]
  let i: U32 = 5
  let a = [xs[i], 1 / z]   //~ PANIC "the second element of an array literal panics when the first does not" @12
  assert a[0] == 0
}

test "a panic of the right-hand side is reported before an index of the place that is out of range" {
  let z: I32 = 0
  let i: U32 = 9
  var ys: [I32; 4] = [0, 0, 0, 0]
  ys[i] = boom(z)   //~ PANIC "a panic of the right-hand side is reported before an index of the place that is out of range" @11
  assert ys[0] == 0
}

// ------------------------------------------------------------- nested indices

test "a nested read runs the base, then the first index, then the second" {
  var log: U32 = 0
  let v = rows(inout log, 1)[idx(inout log, 2, 1)][idx(inout log, 3, 2)]
  assert v == 12
  assert log == 123
}

test "a read of three nested indices takes them from the base outward" {
  var k: U32 = 0
  var cube: [[[U32; 4]; 4]; 4] = [[[0; 4]; 4]; 4]
  cube[1][2][3] = 77
  let v = cube[next(inout k)][next(inout k)][next(inout k)]
  assert v == 77
  assert k == 3
}

test "a nested read through a field takes the indices where they are written" {
  var k: U32 = 0
  let w = World { cells: [Cell { vals: [1, 2, 3, 4] }, Cell { vals: [5, 6, 7, 8] }, Cell { vals: [9, 10, 11, 12] }] }
  let v = w.cells[next(inout k)].vals[next(inout k)]
  assert v == 7
  assert k == 2
}

test "an assignment to a nested element runs the right-hand side, then the indices from the left" {
  var log: U32 = 0
  var grid: [[U32; 4]; 4] = [[0; 4]; 4]
  grid[idx(inout log, 1, 1)][idx(inout log, 2, 2)] = tick(inout log, 3)
  assert log == 312
  assert grid[1][2] == 3
  assert grid[2][1] == 0
}

test "an assignment to three nested elements runs the right-hand side first" {
  var k: U32 = 0
  var cube: [[[U32; 5]; 5]; 5] = [[[0; 5]; 5]; 5]
  cube[next(inout k)][next(inout k)][next(inout k)] = next(inout k)
  assert cube[2][3][4] == 1
  assert cube[1][2][3] == 0
  assert cube[4][3][2] == 0
  assert k == 4
}

test "an assignment through a field between two indices runs the right-hand side first" {
  var k: U32 = 0
  var w = World { cells: [Cell { vals: [0; 4] }, Cell { vals: [0; 4] }, Cell { vals: [0; 4] }] }
  w.cells[next(inout k)].vals[next(inout k)] = next(inout k)
  assert w.cells[2].vals[3] == 1
  assert w.cells[1].vals[2] == 0
  assert k == 3
}

// R-534: the index of the base is read before a later index changes it.
test "a nested read reads the index of the base before the later index writes it" {
  let g: [[U32; 2]; 2] = [[0, 1], [10, 11]]
  var k: U32 = 0
  let v = g[k][next(inout k)]
  assert v == 1
  assert k == 1
}

test "an assignment to a nested element reads the index of the base before the later index writes it" {
  var g: [[U32; 2]; 2] = [[0, 1], [10, 11]]
  var k: U32 = 0
  g[k][next(inout k)] = 5
  assert g[0][1] == 5
  assert g[1][1] == 11
  assert k == 1
}

// §3.5: evaluating the base includes the range checks inside it, so the
// out-of-range `grid[i]` panics before the later index is evaluated.
fn some_nonzero(z: U32) -> Option[U32] {
  if z == 0 { None } else { Some(z) }
}

fn element_or_none(grid: [[U32; 3]; 3], i: U32, z: U32) -> Option[U32] {
  Some(grid[i][some_nonzero(z)?])
}

test "an index of the base out of range panics before a later index that divides by zero" {
  let grid: [[U32; 3]; 3] = [[0; 3]; 3]
  var i: U32 = 5
  var z: U32 = 0
  let v = grid[i][1 / z] //~ PANIC "an index of the base out of range panics before a later index that divides by zero" @11
  assert v == 0
}

test "an index of the base out of range panics before a later index returns early" {
  let grid: [[U32; 3]; 3] = [[0; 3]; 3]
  let v = element_or_none(grid, 5, 0) //~ PANIC "an index of the base out of range panics before a later index returns early"
  assert v == None
}
