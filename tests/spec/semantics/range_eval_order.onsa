// onsa.toml
// [test]
// mode = "test"
// spec = ["§3.5", "§7", "§4.5"]

// The ends of a range `a..b` (S-188, §3.5): "範囲 `a..b` は、`a`、`b` の順に、最初の反復の前に一度だけ
// 評価する。本体で端の変数を変えても、反復の回数は変わらない". The order is observed through a
// `U32` log, as in eval_order.onsa: `tick(inout log, d)` appends the digit `d` to `log` and returns
// `d`, so the log reads as the order in which the ends ran, and a digit that appears twice means
// an end ran twice. A range is written only as the header of a `for` (`par` needs constants, §11.5).

fn tick(inout log: U32, d: U32) -> U32 {
  let shifted = log * 10
  log = shifted + d
  d
}

fn next(inout k: U32) -> U32 {
  k = k + 1
  k
}

fn tick_i(inout log: U32, d: U32, v: I32) -> I32 {
  let shifted = log * 10
  log = shifted + d
  v
}

pub struct Bounds {
  lo: U32,
  hi: U32,
}

impl Bounds {
  pub fn width(self, inout log: U32, d: U32) -> U32 {
    let shifted = log * 10
    log = shifted + d
    self.hi - self.lo
  }
}

// A range in a generic function: the end is a const parameter, the start has a side effect.
fn count_from[const N: U32](xs: [F32; N], inout log: U32, d: U32) -> U32 {
  var n: U32 = 0
  for _ in tick(inout log, d)..N {
    n = n + 1
  }
  n
}

test "the start is evaluated before the end, both once, before the first iteration" {
  var log: U32 = 0
  var n: U32 = 0
  for _ in tick(inout log, 1)..tick(inout log, 4) {
    n = n + 1
  }
  assert n == 3
  assert log == 14
}

test "the ends are not evaluated again by later iterations" {
  var log: U32 = 0
  var seen: U32 = 0
  for i in tick(inout log, 1)..tick(inout log, 3) {
    seen = (seen * 10) + i
  }
  // i runs over 1 and 2 only; the log has no third digit.
  assert seen == 12
  assert log == 13
}

test "the start decides before the end: a start taken first leaves one iteration" {
  var k: U32 = 0
  var n: U32 = 0
  var first: U32 = 99
  for i in next(inout k)..next(inout k) {
    if n == 0 {
      first = i
    }
    n = n + 1
  }
  // start = 1, end = 2: one iteration with i = 1. Evaluated in the other order the range would
  // be 2..1 and empty.
  assert n == 1
  assert first == 1
  assert k == 2
}

test "the start is read first even when the end changes what the start reads" {
  var c: U32 = 1
  var n: U32 = 0
  // the start reads c (1) before the end sets it to 4
  for _ in c..tick(inout c, 4) {
    n = n + 1
  }
  assert n == 3
  assert c == 14
}

test "a changed end variable does not change the number of iterations" {
  var hi: U32 = 3
  var n: U32 = 0
  for _ in 0..hi {
    hi = hi + 1
    n = n + 1
  }
  assert n == 3
  assert hi == 6
}

test "an end lowered in the body does not stop the loop early" {
  var hi: U32 = 4
  var n: U32 = 0
  for _ in 0..hi {
    hi = 1
    n = n + 1
  }
  assert n == 4
  assert hi == 1
}

test "a changed start variable does not change the iterations" {
  var lo: U32 = 0
  var sum: U32 = 0
  for i in lo..3 {
    lo = 2
    sum = sum + i
  }
  // i = 0, 1, 2 although lo is 2 after the first iteration.
  assert sum == 3
  assert lo == 2
}

test "an empty range still evaluates both ends, in order" {
  var log: U32 = 0
  var n: U32 = 0
  for _ in tick(inout log, 3)..tick(inout log, 3) {
    n = n + 1
  }
  assert n == 0
  assert log == 33
  for _ in tick(inout log, 1)..tick(inout log, 1) {
    n = n + 1
  }
  assert log == 3311
  assert n == 0
}

test "each execution of a loop evaluates its own ends once: nested loops" {
  var log: U32 = 0
  var n: U32 = 0
  for _ in 0..2 {
    for _ in tick(inout log, 1)..tick(inout log, 2) {
      n = n + 1
    }
  }
  // the inner header runs once per outer iteration: log reads 1 2 1 2
  assert log == 1212
  assert n == 2
}

test "an outer range is evaluated before the inner header runs" {
  var log: U32 = 0
  var n: U32 = 0
  for _ in tick(inout log, 1)..tick(inout log, 3) {
    for _ in tick(inout log, 4)..tick(inout log, 5) {
      n = n + 1
    }
  }
  // outer 1 3, then the inner header 4 5 for i = 1 and again for i = 2
  assert log == 134545
  assert n == 2
}

test "the ends of a range are evaluated once in a loop that is skipped by a branch" {
  var log: U32 = 0
  let go: Bool = false
  if go {
    for _ in tick(inout log, 1)..tick(inout log, 2) {
      log = log + 100
    }
  }
  // the loop did not run, so neither end did
  assert log == 0
}

test "receivers and arguments inside an end follow the order of the expression" {
  var log: U32 = 0
  let b = Bounds { lo: 2, hi: 5 }
  var n: U32 = 0
  for _ in tick(inout log, 1)..b.width(inout log, 2) {
    n = n + 1
  }
  // start is 1, end is 3 (5 - 2): two iterations. start ran first.
  assert log == 12
  assert n == 2
}

test "the ends can be signed" {
  var log: U32 = 0
  var seen: I32 = 0
  for i in tick_i(inout log, 1, -2)..tick_i(inout log, 2, 2) {
    seen = seen + i
  }
  // -2, -1, 0, 1
  assert seen == -2
  assert log == 12
}

test "a loop variable of an outer loop is read by an inner end after it changed" {
  var n: U32 = 0
  for i in 1..4 {
    for _ in 0..i {
      n = n + 1
    }
  }
  // 1 + 2 + 3
  assert n == 6
}

test "a generic function evaluates the start once and the const end" {
  var log: U32 = 0
  let n = count_from([0.0; 5], inout log, 2)
  assert n == 3
  assert log == 2
}
