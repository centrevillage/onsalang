// onsa.toml
// [test]
// mode = "test"
// spec = ["§3.4", "§6.3", "§13.4"]

// `is_nan` and `is_finite` of `std.math` in a generic body (spec §13.4: `is_nan[T: Float](x: T) -> Bool`;
// §6.3: `Float: Num`). The associated constants of `T: Float` are in is_nan_is_finite_generic_constants.onsa.
// The same function runs on an `F32` and an `F64` and gives the same answers. The classes are worked out by
// hand: NaN is 0, a finite number is 1, an infinity is 2.

use std.math.{is_finite, is_nan}

fn classify[T: Float](x: T) -> U32 {
  if is_nan(x) {
    0
  } else if is_finite(x) {
    1
  } else {
    2
  }
}

fn difference_is_nan[T: Float](a: T, b: T) -> Bool {
  is_nan(a - b)
}

fn product_is_finite[T: Float](a: T, b: T) -> Bool {
  is_finite(a * b)
}

test "the classes of F32 and F64 values through one generic function" {
  let f_nan: F32 = F32.NAN
  let f_inf: F32 = F32.INFINITY
  let f_big: F32 = F32.MAX
  let d_nan: F64 = F64.NAN
  let d_ninf: F64 = -F64.INFINITY
  let d_big: F64 = F64.MAX
  assert classify(f_nan) == 0
  assert classify(f_inf) == 2
  assert classify(f_big) == 1
  assert classify(d_nan) == 0
  assert classify(d_ninf) == 2
  assert classify(d_big) == 1
  let f_zero: F32 = -0.0
  let d_zero: F64 = 0.0
  assert classify(f_zero) == 1
  assert classify(d_zero) == 1
}

test "NaN from an operation in a generic body" {
  let f_inf: F32 = F32.INFINITY
  let f_one: F32 = 1.0
  let d_inf: F64 = F64.INFINITY
  let d_one: F64 = 1.0
  // inf - inf is NaN; 1 - 1 and inf - 1 are not.
  assert difference_is_nan(f_inf, f_inf)
  assert !difference_is_nan(f_one, f_one)
  assert !difference_is_nan(f_inf, f_one)
  assert difference_is_nan(d_inf, d_inf)
  assert !difference_is_nan(d_one, d_one)
}

test "overflow in a generic body is an infinity" {
  let f_big: F32 = F32.MAX
  let f_one: F32 = 1.0
  let f_two: F32 = 2.0
  let f_zero: F32 = 0.0
  let f_inf: F32 = F32.INFINITY
  // MAX * 2 overflows binary32; MAX * 1 does not; inf * 0 is NaN, which is not finite either.
  assert !product_is_finite(f_big, f_two)
  assert product_is_finite(f_big, f_one)
  assert !product_is_finite(f_inf, f_zero)
  // The same product in binary64 is finite.
  let d_big: F64 = F32.MAX as F64
  let d_two: F64 = 2.0
  assert product_is_finite(d_big, d_two)
}
