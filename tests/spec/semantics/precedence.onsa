// onsa.toml
// [test]
// mode = "test"
// spec = ["§3.1", "§3.2", "§3.4"]

// The values of mixed-group expressions (spec §3.1). The groups are:
// multiplicative `* / *% *|`, remainder `%`, additive `+ - +% -% +| -|`,
// comparison, `&&`, `||`, and the bit group. Multiplicative binds tighter than
// additive, which binds tighter than comparison, which binds tighter than `&&`
// and `||`; remainder binds tighter than comparison; a chain of one group is
// left-associative. Prefix operators and `as` bind tighter than every binary
// operator, and postfix operators tighter than prefix ones.
//
// The expressions are written without redundant parentheses (the form `onsa
// fmt` produces).

// Appends the decimal digit `d` to `log`.
fn bump(inout log: U32, d: U32) -> U32 {
  let shifted = log * 10
  log = shifted + d
  d
}

test "multiplicative binds tighter than additive" {
  let x: I32 = 2
  let y: I32 = 3
  let z: I32 = 4
  let a = x + y * z
  assert a == 14
  let b = x * y + z
  assert b == 10
  let c = z - y * x
  assert c == -2
  let d: I32 = 1 + 2 * 3 - 4 / 2
  assert d == 5
}

test "a chain of one group is left-associative" {
  let a: I32 = 100
  let b: I32 = 10
  let c: I32 = 5
  let d = a / b / c
  assert d == 2
  let e = a / c * b
  assert e == 200
  let f = a - b - c
  assert f == 85
  let g = b - c + a
  assert g == 105
}

test "comparison binds looser than arithmetic" {
  let a: I32 = 3
  let b: I32 = 3
  let lt = a + 1 < b * 2
  assert lt
  let eq = a * 2 == b + 3
  assert eq
  let ne = a + b != 6
  assert !ne
}

test "remainder binds tighter than comparison" {
  let i: U32 = 4
  let j: U32 = 5
  let even_i = i % 2 == 0
  let even_j = j % 2 == 0
  assert even_i
  assert !even_j
  let r = i % 3 < j % 3
  assert r
}

test "comparison binds tighter than && and ||" {
  let lo: I32 = 1
  let hi: I32 = 10
  let x: I32 = 5
  let inside = lo <= x && x < hi
  assert inside
  let outside = x < lo || hi <= x
  assert !outside
  let y: I32 = 11
  let past = lo <= y && y < hi
  assert !past
}

test "arithmetic, comparison and && together" {
  let a: I32 = 2
  let b: I32 = 3
  let c: I32 = 4
  let r = a * b < c + 3 && b + c > a * 3
  assert r
}

test "a chain of && or of || and a chain of the same bit operator" {
  let t: Bool = true
  let f: Bool = false
  let r1 = t && t && f
  assert !r1
  let r2 = f || f || t
  assert r2
  let a: U32 = 1
  let b: U32 = 2
  let c: U32 = 4
  let o = a | b | c
  assert o == 7
  let mask: U32 = 6
  let n = o & mask & 3
  assert n == 2
  let one: U32 = 1
  let s = one << 2 << 3
  assert s == 32
}

test "prefix operators and as bind tighter than binary operators" {
  let x: I32 = 5
  let a = -x * 2
  assert a == -10
  let xs: [I32; 3] = [1, 2, 3]
  let b = -xs[1] + 10
  assert b == 8
  let c = -x as I64
  assert c == -5
  let flag: Bool = false
  let ok: Bool = true
  let d = !flag && ok
  assert d
}

test "wrapping and saturating operators sit in the groups of + and *" {
  let a: U8 = 250
  let b: U8 = 2
  let c: U8 = 3
  let w = a +% b * c
  assert w == 0
  let v = a +% 10 -% 5
  assert v == 255
  let big: U8 = 200
  let m = big *% 2 / 3
  assert m == 48
  let s = a +| b * 4
  assert s == 255
}

test "precedence does not change the order of evaluation" {
  var log: U32 = 0
  let r = bump(inout log, 1) + bump(inout log, 2) * bump(inout log, 3)
  assert r == 7
  assert log == 123
}
