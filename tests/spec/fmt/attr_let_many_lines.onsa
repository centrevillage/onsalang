// onsa.toml
// [test]
// mode = "parse"
// spec = ["§12.4", "§18.2"]

// The `let` after its attribute (spec/tools.md §3.2, S-527). The attribute is on the line of its `let` when
// it is on one line in the output and nothing is written between them. When its arguments are in the block
// form or in the continuation (the attribute is on many lines), or a comment is between them (a comment at
// the end of the line of the attribute, or a line of a comment alone), the `let` is on the next line, at the
// indentation of the attribute. The file is canonical, so `onsa fmt` leaves it unchanged. Only the syntax is
// read here (`mode = "parse"`): the meaning of `@mem(bulk)` is not in this version (E0200 until W9-06, as in
// let_equals_mem.onsa).

pub flow one_line_attribute(x: F32 at sample) -> F32 at sample {
  @mem(bulk) let d = delay~(x, 4800)
  d
}

pub flow block_form_attribute(x: F32 at sample) -> F32 at sample {
  @mem(
    bulk,
  )
  let d = delay~(x, 4800)
  d
}

pub flow continuation_attribute(x: F32 at sample) -> F32 at sample {
  @mem(bulk,
       other)
  let d = delay~(x, 4800)
  d
}

pub flow a_line_of_a_comment_between(x: F32 at sample) -> F32 at sample {
  @mem(bulk)
  // a line of a comment alone
  let d = delay~(x, 4800)
  d
}

pub flow a_comment_at_the_end_of_the_attribute(x: F32 at sample) -> F32 at sample {
  @mem(bulk) // a comment at the end of the line
  let d = delay~(x, 4800)
  d
}
