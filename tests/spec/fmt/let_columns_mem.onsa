// onsa.toml
// [test]
// mode = "parse"
// spec = ["§12.4", "§18.2"]

// The column of `=` and the `let` with an attribute (spec/tools.md §3.2, S-122): a `let` with
// `@mem(bulk)` cuts the column, so the `let` lines before it, the `let` lines after it and the `let` itself
// do not share a column, and a column does not take the `=` of the attributed line. The attribute is on the
// line of the `let` (spec/tools.md §3.2). The file is canonical, so `onsa fmt` leaves it unchanged;
// the lines written without the column are in let_columns_mem_loose.onsa. Only the syntax is read here
// (`mode = "parse"`): the meaning of `@mem(bulk)` is not in this version (E0200 until W9-06, as in
// flow_syntax/mem_attribute.onsa).

pub flow around_a_bulk_let(x: F32 at sample) -> F32 at sample {
  let g        = x * 0.5
  let gain_two = g * 2.0
  @mem(bulk) let d = delay~(g, 4800)
  let h      = d + g
  let h_long = h * 2.0
  h_long + gain_two
}

pub flow the_attributed_let_is_first(x: F32 at sample) -> F32 at sample {
  @mem(bulk) let line_long_name = delay~(x, 4800)
  let a   = line_long_name
  let abc = a + x
  abc
}

pub flow the_attributed_let_is_last(x: F32 at sample) -> F32 at sample {
  let p  = x
  let pq = p
  @mem(bulk) let tail = delay~(pq, 64)
  tail
}

pub flow the_attributed_let_has_a_type(x: F32 at sample) -> F32 at sample {
  let a = x
  @mem(bulk) let d: F32 = delay~(a, 4800)
  let bc = d
  let b  = bc + a
  b
}

pub flow in_a_nested_block(c: Bool at block, x: F32 at sample) -> F32 at sample {
  if c {
    let one = x
    @mem(bulk) let line = delay~(one, 4800)
    let t  = line
    let tt = t + one
    tt
  } else {
    x
  }
}

pub fn in_a_fn(x: F32) -> F32 {
  let a    = x
  let abcd = a + x
  @mem(bulk) let b = abcd
  let c  = b
  let cc = c + a
  cc
}
