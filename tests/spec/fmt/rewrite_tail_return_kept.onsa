// onsa.toml
// [test]
// mode = "check"
// spec = ["§6.1", "§18.2"]

// The `return`s that `onsa fmt` keeps (W3-12, unit U1; spec/tools.md §3.3, spec §6.1). Only a `return e`
// with a value in the tail position is taken off: the end of the body of a function or of an anonymous
// function, and the end of every branch of an `if` and every arm of a `match` that is there, down to the end.
// The `return`s with a value below are early exits, and none of them is in the tail position: one in a loop
// (also when it is the last statement of the loop), one before the end of the body, one in the value of a
// `let`, one in the condition of an `if`. A `return` without a value stays wherever it is (S-547), in the
// tail position too (the last functions; with dead code before it, `rewrite_valueless_return_kept.onsa`).
// The file is canonical, so `onsa fmt` leaves it unchanged; the same functions with a `return` in the tail
// position are in crates/onsa_cli/tests/fmt_rewrites.rs.

fn first_big(xs: [I32; 4]) -> I32 {
  for i in 0 ..< 4 {
    if xs[i] > 9 {
      return xs[i]
    }
  }
  -1
}

fn guard_clause(x: I32) -> I32 {
  if x < 0 {
    return 0
  }
  x * 2
}

fn drain(inout n: I32) -> I32 {
  while n > 0 {
    n = n - 1
    return n
  }
  0
}

fn in_a_let(c: Bool) -> I32 {
  let x = if c {
    return 1
  } else {
    2
  }
  x + 1
}

fn in_a_condition(c: Bool, d: Bool) -> I32 {
  if d && (if c { return 1 } else { true }) {
    2
  } else {
    3
  }
}

fn loop_in_a_branch(c: Bool, n: I32) -> I32 {
  if c {
    for i in 0 ..< n {
      if i == 3 {
        return i
      }
    }
    -1
  } else {
    0
  }
}

fn early_without_a_value(c: Bool, inout x: I32) {
  if c {
    return
  }
  x = 2
}

fn closure_with_an_early_exit() -> I32 {
  let g = fn(x: I32) -> I32 {
    if x < 0 {
      return 0
    }
    x
  }
  g.(1)
}

fn without_a_value_at_the_end(inout x: I32) {
  x = 1
  return
}

fn without_a_value_at_the_end_of_branches(c: Bool, inout x: I32) {
  if c {
    x = 1
    return // one
  } else {
    return
  }
}

fn without_a_value_in_a_closure() {
  let f = fn(inout x: I32) {
    x = 2
    return
  }
}

fn without_a_value_alone() { return }
