// onsa.toml
// [test]
// mode = "parse"
// canonical = false
// spec = ["§2.5", "§2.6", "§11.5", "§18.2"]

// W4-20 U1/t, S-745: the forms of par_tilde.onsa with more spaces after the `~` of `par~`, where the
// language lets a writer put them (more than one space between the `~` and the name of the index, none
// of them between `par` and the `~`: that one is E0020, spec §2.6). `onsa fmt` writes `par~ i`, one
// space after the `~`, in the right side of a `let` and in a nest (spec/tools.md §3.2). The file is
// not canonical on purpose (`canonical = false`): `onsa fmt` has to change it, and what it writes
// has to read and to be a fixed point.

pub flow in_a_let(f0: F32 at block) -> [F32; 4] at sample {
  let saws = par~    i in 0 ..< 4 { saw~(f0) }
  saws
}

pub flow as_the_tail(f0: F32 at block) -> [F32; 4] at sample {
  par~   i in 0 ..< 4 { saw~(f0 * i.round_f32()) }
}

pub flow nested_in_a_let(x: F32 at sample) -> F32 at sample {
  let rows = par~   i in 0 ..< 3 {
    pair_sum(par~    j in 0 ..< 2 { lp~(x * (i + j).round_f32()) })
  }
  total(rows)
}

pub flow with_a_closed_range(f0: F32 at block) -> [F32; 3] at sample {
  let saws = par~  i in 1 ..= 3 { saw~(f0 * i.round_f32()) }
  saws
}
