// onsa.toml
// [test]
// mode = "test"
// spec = ["§4.5", "§18.2"]

// The `=` of consecutive `const` items with names of different lengths keep one space on each side and are
// in no column, as the `=` of `let` and `var` lines (spec/tools.md §3.2: one space on each side of `=`,
// S-970). The file is canonical, so `onsa fmt` leaves it unchanged. Every value below is worked out by hand
// from the spec text.

const RATE: U32 = 48000
const A: U32 = 4
pub const LONGER_NAME: F32 = 0.5
const COUNT: U32 = 3

fn total() -> U32 {
  let two_rates = RATE * 2
  let a_count = A * COUNT
  two_rates + a_count
}

test "constants in a row" {
  assert total() == 96012
  assert LONGER_NAME == 0.5
}
