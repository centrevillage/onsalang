// onsa.toml
// [test]
// spec = ["§3.1", "§18.2"]

// A block expression in parentheses, the operand of an operator that §3.1 asks for (E0013), in the block
// form: the content is one level deeper than the line of the `({`, and the `})` is on that line, as with
// `(if t {` … `})` in indent_enclosures.onsa (spec/tools.md §3.2, S-498). The parentheses are not
// redundant, so `onsa fmt` keeps them. The file is canonical, so `onsa fmt` leaves it unchanged.

fn left(n: I32) -> I32 {
  ({
    let b = n
    b
  }) - 10
}

fn on_a_continued_line(n: I32) -> I32 {
  let z = n +
    ({
      let a = n
      a
    })
  z
}

fn both(n: I32) -> I32 {
  ({ n }) - ({
    let c = n
    c
  })
}
