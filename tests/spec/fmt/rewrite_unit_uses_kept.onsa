// onsa.toml
// [test]
// mode = "check"
// spec = ["§6.1", "§8.1", "§18.2"]

// What `onsa fmt` keeps next to the `-> ()` and the empty `uses {}` that it is to take off (W3-12, unit U1;
// spec/tools.md §3.3, spec §6.1 and §8.1; the user left that rewrite to the second phase on
// 2026-10-15, so today `fmt` keeps them too). Only the `()` that is the return type of a function or of a
// function type, and an empty effect row, are to go. Kept: an effect row that has an
// effect (`uses {Alloc}`, also on a function type), a `()` that is a type argument (`Result[(), Str]`),
// a tuple, the type and the value of a unit in a `let`. The file is canonical, so `onsa fmt` leaves it
// unchanged; the same declarations written with `-> ()` and `uses {}` are in
// crates/onsa_cli/tests/fmt_rewrites.rs.

fn ok_unit() -> Result[(), Str] {
  Ok(())
}

fn pair() -> (I32, I32) {
  (1, 2)
}

fn alloc_unit() uses {Alloc} {}

fn alloc_value() -> I32 uses {Alloc} {
  1
}

fn unit_value() {
  let u: () = ()
}

pub struct Sinks {
  plain: fn(F32),
  pure: fn(F32) -> F32,
  result: fn(F32) -> Result[(), Str],
  alloc: fn(F32) uses {Alloc},
}

fn apply(f: fn(F32) uses {Alloc}, g: fn() -> Result[(), Str], x: F32) uses {Alloc} {
  f.(x)
}
