// onsa.toml
// [test]
// mode = "parse"
// spec = ["§2.5", "§2.6", "§11.5", "§18.2"]

// W4-20 U1/t, S-745: how `onsa fmt` writes a `par~` (spec/tools.md §3.2 with §2.6): the `~` right after
// `par` with no space (a space is E0020, so no file that has one is formatted) and one space after the
// `~`, before the name of the index, as `if~ c` is written (fmt/attr_else_with.onsa has the `if~`). The
// forms are the right side of a `let`, the tail, an argument and a nested `par~`, with a header of a
// literal, a name and a closed range. The file is written the way `onsa fmt` writes it, so it is a fixed
// point of `onsa fmt` (the default `canonical`); the loose spelling that `onsa fmt` writes in this form is
// in par_tilde_loose.onsa. The file is read by the syntax stage only (`mode = "parse"`).

const N: U32 = 4

pub flow in_a_let(f0: F32 at block) -> [F32; 4] at sample {
  let saws = par~ i in 0 ..< 4 { saw~(f0) }
  saws
}

pub flow as_the_tail(f0: F32 at block) -> [F32; N] at sample {
  par~ i in 0 ..< N { saw~(f0 * F32.round_from(i)) }
}

pub flow as_an_argument(f0: F32 at block) -> F32 at sample {
  total(par~ i in 0 ..< 4 { saw~(f0) })
}

pub flow with_a_closed_range(f0: F32 at block) -> [F32; 3] at sample {
  let saws = par~ i in 1 ..= 3 { saw~(f0 * F32.round_from(i)) }
  saws
}

pub flow with_a_block_body(f0: F32 at block) -> [F32; 4] at sample {
  let saws = par~ i in 0 ..< 4 {
    saw~(f0 * F32.round_from(i))
  }
  saws
}

pub flow nested_in_a_let(x: F32 at sample) -> F32 at sample {
  let rows = par~ i in 0 ..< 3 {
    pair_sum(par~ j in 0 ..< 2 { lp~(x * F32.round_from(i + j)) })
  }
  total(rows)
}

pub flow nested_as_the_tail(x: F32 at sample) -> [F32; 3] at sample {
  par~ i in 0 ..< 3 {
    pair_sum(par~ j in 0 ..< 2 { lp~(x * F32.round_from(i + j)) })
  }
}

pub flow beside_the_branches(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  let ys = par~ i in 0 ..< 4 { x * F32.round_from(i) }
  if~ c {
    lp~(total(ys))
  } else {
    x
  }
}
