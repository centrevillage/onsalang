// onsa.toml
// [test]
// mode = "parse"
// spec = ["§4.4", "§18.2"]

// How `onsa fmt` leaves a literal with `...` on one line (spec/tools.md §3.2, spec §4.4): one space inside
// the braces, the `...` is not an element of the list, so it is not counted as the last element, and no
// `,` is put after it. The file is canonical, so `onsa fmt` leaves it unchanged. The file is read by the
// syntax stage only (`mode = "parse"`).

pub struct Item {
  x: U32,
  y: F32 = 0.0,
}

pub fn a_field_and_the_rest() -> Item {
  Item { x: 1, ... }
}

pub fn fields_and_the_rest() -> Item {
  Item { x: 1, y: 2.0, ... }
}

pub fn only_the_rest() -> Item {
  Item { ... }
}

pub fn as_an_argument() -> U32 {
  take(Item { x: 1, ... }, Item { ... })
}
