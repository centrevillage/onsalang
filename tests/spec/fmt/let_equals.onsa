// onsa.toml
// [test]
// mode = "test"
// spec = ["§5.1", "§18.2"]

// The `=` of a `let` and a `var` has one space on each side and is in no column (spec/tools.md §3.2,
// S-970): consecutive one-line `let` and `var` lines with left sides of different lengths, a `let` with a
// type, a `var` and a `let` that takes a tuple apart, with a blank line, a statement of more than one line,
// another statement or a line of a comment between them, in a nested block, in an anonymous function and in
// a test block. The comments at the ends of consecutive lines are still in one column, one space after the
// longest code (`with_comments`). The file is canonical, so `onsa fmt` leaves it unchanged; the same lines
// written with more spaces before the `=` and the comments out of their column are in let_equals_loose.onsa.
// Every value below is worked out by hand from the spec text.

use std.array

fn plain_group(a: U32) -> U32 {
  let x = a + 1
  let width = x * 2
  let y = width - 1
  y
}

fn mixed(p: (U32, U32)) -> U32 {
  let gain: U32 = 3
  let bias = 1
  var total: U32 = 0
  let (lo, hi) = p
  let same = lo == hi
  total = total + gain + bias + lo + hi
  if same {
    0
  } else {
    total
  }
}

fn across_a_comment(a: U32) -> U32 {
  let first = a + 1
  // A line of a comment.
  let b = first * 2
  // Two lines
  // of comments.
  let third_long_name = b + 1
  third_long_name
}

fn after_a_blank_line(a: U32) -> U32 {
  let first = a + 1
  let second = first + 1

  let c = second + 1
  let dd = c + 1
  dd
}

fn around_a_multi_line_statement(a: U32) -> U32 {
  let first = a + 1
  let second_long = first + 1
  let picked = if a > 0 {
    first
  } else {
    second_long
  }
  let n = picked + 1
  let nn_long = n + 1
  nn_long
}

fn around_another_statement(a: U32) -> U32 {
  var t: U32 = a
  let big_name = 2
  t = t + big_name
  let u = t
  let uu = u + 1
  uu
}

fn nested(c: Bool, a: U32) -> U32 {
  let outer = a
  let o = a + 1
  var t: U32 = 0
  if c {
    let inner_long_name = o
    let i = inner_long_name + 1
    t = i
  }
  let after = t + outer
  let a2 = after + 1
  a2
}

fn in_an_anonymous_function() -> [U32; 3] {
  array.from_fn(fn(i: U32) -> U32 {
    let twice = i * 2
    let plus_one = twice + 1
    plus_one
  })
}

fn with_comments(a: U32) -> U32 {
  let x = a + 1     // one
  let width = x * 2 // two
  var y: U32 = 0    // three
  y = width - 1
  y
}

test "the lines mean what they say" {
  assert plain_group(1) == 3
  // gain 3 + bias 1 + lo 2 + hi 5.
  assert mixed((2, 5)) == 11
  assert mixed((4, 4)) == 0
  // first = 2, b = 4, third_long_name = 5.
  assert across_a_comment(1) == 5
  assert after_a_blank_line(1) == 5
  // first = 2, second_long = 3, picked = first = 2, n = 3, nn_long = 4.
  assert around_a_multi_line_statement(1) == 4
  // t = 1, big_name = 2, t = 3, u = 3, uu = 4.
  assert around_another_statement(1) == 4
  // x = 2, width = 4, y = 3.
  assert with_comments(1) == 3
}

test "the lines of a nested block" {
  // outer = 1, o = 2, inner_long_name = 2, i = 3, t = 3, after = 4, a2 = 5.
  assert nested(true, 1) == 5
  // t stays 0: after = 1, a2 = 2.
  assert nested(false, 1) == 2
  let a = in_an_anonymous_function()
  assert a[0] == 1
  assert a[1] == 3
  assert a[2] == 5
}

test "lines in a test block" {
  let x = nested(true, 1)
  let y_long = nested(false, 1)
  assert x == 5
  assert y_long == 2
}
