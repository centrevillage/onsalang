// onsa.toml
// [test]
// spec = ["§7", "§5.4", "§5.2", "§3.5"]

// R-110, S-42, S-613, S-796, S-799, S-808 (§7: "借用の `match x` のガードでは、`x` とその一部を変更できない … 重なりの判定と当たらない形は、
// 借用の `for` の E0715 と同じである（§5.4）"): the guards that change something and are not hit by
// the E0715 of negative/match_guard_change*.onsa. The change is of another field ("異なるフィールドは重ならない"); the
// subject is `match move o` (the arms own the value, nothing is borrowed); the heading is a call (`b.len()`), a static
// value (`["a", "bc"][i]`, a constant) or a literal that needs no drop (`(n, m)`), which have no place that the guard
// can change ("派生元は無いので、§7 の重なる束縛の無効化と E0715 は当たらない": the `match (n, m)` of Copy places is not the
// `match n`, whose place is the subject itself); the binding that is the heading is a Copy value, which keeps its value
// at the binding; the `move` is of a Dup value, which copies it and reads it (§5.2, S-808); the change is in the body of an
// arm, or in the guard of a `match` that is in the body of an arm of another `match` (the frame of the guard is held
// only while the guard is walked); the guard reads the subject, or changes a local that it declares. The values of these
// forms are in semantics/match_guard_values.onsa.

pub struct W {
  a: Option[Buf[F32]],
  c: U32,
}

const TABLE: [U32; 3] = [4, 5, 6]

pub fn mko() -> Option[Buf[F32]] uses {Alloc} {
  Some(Buf.zeroed(2))
}

pub fn reset(inout o: Option[Buf[F32]]) -> Bool {
  o = None
  true
}

pub fn put(inout n: U32) -> Bool {
  n = 7
  true
}

pub fn some_len(o: Option[Buf[F32]]) -> U32 uses {Alloc} {
  match o {
    Some(b) => b.len(),
    None => 0,
  }
}

// --------------------------------------------------------------------- another field or place

pub fn change_the_other_field() -> U32 uses {Alloc} {
  var w = W { a: Some(Buf.zeroed(3)), c: 0 }
  match w.a {
    Some(b) if {
      w.c = 1
      true
    } => b.len() * 10 + w.c,
    _ => 0,
  }
}

pub fn pass_the_other_field_as_inout() -> U32 uses {Alloc} {
  var w = W { a: Some(Buf.zeroed(3)), c: 0 }
  match w.a {
    Some(b) if put(inout w.c) => b.len() * 10 + w.c,
    _ => 0,
  }
}

pub fn change_the_other_member_of_a_tuple() -> U32 uses {Alloc} {
  var p = (mko(), 0)
  match p.0 {
    Some(_) if {
      p.1 = 5
      true
    } => p.1,
    _ => 0,
  }
}

pub fn change_another_array() -> U32 {
  var xs: [U32; 2] = [1, 2]
  var ys: [U32; 2] = [0, 0]
  match xs {
    v if {
      ys[0] = 7
      true
    } => v[1] + ys[0],
    _ => 0,
  }
}

pub fn change_another_option() -> U32 uses {Alloc} {
  var o = mko()
  var p = mko()
  match o {
    Some(_) if reset(inout p) => some_len(o) * 10 + some_len(p),
    _ => 0,
  }
}

// --------------------------------------------------------------------- the subject is owned

pub fn match_move_owns_the_value() -> U32 uses {Alloc} {
  var o = mko()
  match move o {
    Some(b) if {
      o = None
      true
    } => b.len(),
    _ => 0,
  }
}

// -------------------------------------------------------------- the heading has no place

pub fn the_heading_is_a_call() -> U32 uses {Alloc} {
  var o = mko()
  match o {
    Some(b) => match b.len() {
      k if {
        o = None
        k > 0
      } => k,
      _ => 0,
    },
    None => 0,
  }
}

pub fn the_heading_is_a_static_value(i: U32) -> U32 uses {Alloc} {
  var k: U32 = 0
  match ["a", "bc"][i] {
    s if {
      k = 1
      s.len() > 0
    } => k * 10 + s.len(),
    _ => 0,
  }
}

pub fn the_heading_is_a_string_literal() -> U32 {
  var k: U32 = 0
  match "ab" {
    s if {
      k = 2
      s.len() > 0
    } => k * 10 + s.len(),
    _ => 0,
  }
}

pub fn the_heading_is_a_constant() -> U32 {
  var k: U32 = 0
  match TABLE {
    v if {
      k = 2
      v[0] > 0
    } => k * 10 + v[1],
    _ => 0,
  }
}

pub fn the_heading_is_a_literal_that_needs_no_drop() -> U32 {
  var n: U32 = 1
  var m: U32 = 2
  match (n, m) {
    (a, b) if {
      n = 0
      a > 0
    } => a * 100 + b * 10 + n,
    _ => 0,
  }
}

pub fn the_changed_place_is_not_a_tail(c: Bool) -> U32 uses {Alloc} {
  var o = mko()
  var p = mko()
  var q = mko()
  match if c { o } else { p } {
    Some(_) if reset(inout q) => 1,
    _ => 0,
  }
}

pub fn the_changed_place_is_beside_a_static_tail(c: Bool) -> U32 uses {Alloc} {
  var s: Str = "x"
  var u: Str = "y"
  match if c { s } else { "z" } {
    t if {
      u = "w"
      t.len() > 0
    } => t.len() + u.len(),
    _ => 0,
  }
}

// ----------------------------------------------------------- the heading is a Copy binding

pub fn copy_binding_in_a_chain() -> U32 uses {Alloc} {
  var o: Option[(Buf[F32], U32)] = Some((Buf.zeroed(2), 0))
  match o {
    Some(t) => match t {
      (_, n) => match n {
        0 if {
          o = None
          true
        } => 1,
        _ => 0,
      },
    },
    None => 0,
  }
}

pub fn copy_member_of_the_subject() -> U32 uses {Alloc} {
  var w = W { a: mko(), c: 0 }
  match w {
    W { a: _, c: k } => match k {
      0 if {
        w.c = 1
        true
      } => 1 + w.c,
      _ => 0,
    },
  }
}

// ------------------------------------------------------------------------- a Dup value moved

pub fn move_a_dup_value_in_a_guard() -> U32 uses {Alloc} {
  var names: [Str; 2] = ["a", "bc"]
  match names {
    v if {
      let c = move names
      c.len() > 0
    } => v.len(),
    _ => 0,
  }
}

// -------------------------------------------------------------- the frame of a guard only

pub fn guard_in_the_body_of_an_arm() -> U32 uses {Alloc} {
  var o = mko()
  var p = mko()
  match o {
    Some(b) if b.len() > 0 => match p {
      Some(_) if reset(inout o) => 1,
      _ => 0,
    },
    _ => 0,
  }
}

pub fn change_in_the_body_of_an_arm() -> U32 uses {Alloc} {
  var o = mko()
  match o {
    Some(b) => {
      let n = b.len()
      o = None
      n
    },
    None => 0,
  }
}

pub fn change_after_the_match() -> U32 uses {Alloc} {
  var o = mko()
  let n = match o {
    Some(b) if b.len() > 1 => b.len(),
    _ => 0,
  }
  o = None
  n
}

// -------------------------------------------------------------- the guard reads or has a local

pub fn guard_reads_the_subject() -> U32 uses {Alloc} {
  var o = mko()
  match o {
    Some(_) if some_len(o) > 0 => 1,
    _ => 0,
  }
}

pub fn guard_reads_a_part_of_the_subject() -> U32 uses {Alloc} {
  var w = W { a: mko(), c: 4 }
  match w.a {
    Some(b) if w.c == 4 && b.len() > 1 => b.len() + w.c,
    _ => 0,
  }
}

pub fn guard_changes_a_local_of_its_own() -> U32 uses {Alloc} {
  var o = mko()
  match o {
    Some(b) if {
      var t: U32 = 0
      t = b.len()
      t > 1
    } => b.len(),
    _ => 0,
  }
}
