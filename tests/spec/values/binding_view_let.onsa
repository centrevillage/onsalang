// onsa.toml
// [test]
// spec = ["§5.3", "§5.4", "§10"]

// S-217 (§5.3, §5.4): the part of a view (`xs.slice(a, b)`) whose source is a borrowed origin or a
// borrowed binding derived from one is a borrowed binding of a `let` ("`Span` の部分ビュー `let y =
// x.slice(a, b)`（`x` は借用の起点、または起点から派生した借用束縛）": a row of the table of §5.4;
// `let half = xs.slice(0, n)`), and the iterated value of a `for` over it is the place of its source
// (`for v in xs.slice(a, b)`: "部分ビューの `for s in xs.slice(a, b)` は、範囲によらず `xs` の場所を反復元
// とする", a borrowed `for`). The source may be a `Span`, a planar element, an array or a `Buf` that is
// an argument in the default mode, or a binding derived from one. The bound name stays second-class (it
// can be read, passed on in the default mode, and used as a receiver; the uses that stay an E0710 are
// in negative/binding_view_span.onsa). Every binding is read (a binding never read is an E0309). No
// diagnostic is expected anywhere in this file. The `Span` of a whole argument and of a planar element
// is in values/binding_span_let.onsa, the run is in values/binding_view_run.onsa.

pub struct Holder {
  buf: Buf[F32],
  gain: F32,
}

pub fn sum(s: Span[F32]) -> F32 {
  var total: F32 = 0.0
  for i in 0 ..< s.len() {
    total = total + s[i]
  }
  total
}

// -------------------------------------------------------------------------- the let forms

pub fn half_of_a_span(xs: Span[F32], n: U32) -> F32 {
  let half = xs.slice(0, n)
  half[0]
}

pub fn view_of_a_buffer(b: Buf[F32]) -> U32 {
  let v = b.slice(0, 1)
  v.len()
}

pub fn view_of_an_array(a: [F32; 4]) -> F32 {
  let v = a.slice(1, 3)
  v[0] + v[1]
}

pub fn view_of_a_planar_element(input: [Span[F32]; 2]) -> F32 {
  let part = input[1].slice(1, 3)
  part[0]
}

pub fn view_of_a_field(h: Holder) -> U32 {
  let part = h.buf.slice(0, 1)
  part.len()
}

pub fn view_with_run_time_bounds(xs: Span[F32], a: U32, b: U32) -> U32 {
  let part = xs.slice(a, b)
  part.len()
}

pub fn view_of_a_binding_of_the_argument(xs: Span[F32]) -> U32 {
  let s    = xs
  let part = s.slice(0, 1)
  part.len()
}

pub fn view_of_a_planar_binding(input: [Span[F32]; 2]) -> U32 {
  let ch   = input[0]
  let part = ch.slice(0, 2)
  part.len()
}

pub fn view_of_a_view(xs: Span[F32]) -> U32 {
  let a = xs.slice(0, 3)
  let b = a.slice(1, 2)
  b.len()
}

// ---------------------------------------------------------------------------- derived

pub fn derived(xs: Span[F32], n: U32) -> F32 {
  let half  = xs.slice(0, n)
  let again = half
  again[0]
}

pub fn derived_from_the_element_of_a_for(xss: [Span[F32]; 2]) -> F32 {
  var total: F32 = 0.0
  for ch in xss {
    let part = ch.slice(0, 1)
    total = total + part[0]
  }
  total
}

// -------------------------------------------------------------------- uses of the binding

pub fn passed_on(xs: Span[F32], n: U32) -> F32 {
  let half = xs.slice(0, n)
  sum(half)
}

pub fn as_a_receiver(xs: Span[F32], n: U32) -> U32 {
  let half = xs.slice(0, n)
  half.len()
}

pub fn get_through_the_binding(xs: Span[F32], n: U32) -> F32 {
  let half = xs.slice(0, n)
  match half.get(1) {
    Some(v) => v,
    None => -1.0,
  }
}

pub fn sliced_and_passed_on(xs: Span[F32]) -> F32 {
  let half = xs.slice(0, 2)
  sum(half) + sum(half.slice(0, 1))
}

// ----------------------------------------------------------------------- the for over a view

pub fn for_over_a_view(xs: Span[F32], a: U32, b: U32) -> F32 {
  var total: F32 = 0.0
  for v in xs.slice(a, b) {
    total = total + v
  }
  total
}

pub fn for_over_the_view_of_a_planar_element(input: [Span[F32]; 2]) -> F32 {
  var total: F32 = 0.0
  for v in input[0].slice(0, 2) {
    total = total + v
  }
  total
}

pub fn for_over_the_view_of_an_array(a: [F32; 4]) -> F32 {
  var total: F32 = 0.0
  for v in a.slice(1, 3) {
    total = total + v
  }
  total
}

pub fn for_over_the_view_of_a_buffer(b: Buf[F32]) -> F32 {
  var total: F32 = 0.0
  for v in b.slice(0, 2) {
    total = total + v
  }
  total
}

pub fn for_over_the_view_of_a_binding(xs: Span[F32]) -> F32 {
  let half       = xs.slice(0, 3)
  var total: F32 = 0.0
  for v in half.slice(1, 3) {
    total = total + v
  }
  total
}

pub fn for_over_the_view_of_the_binding_of_a_for(xss: [Span[F32]; 2]) -> F32 {
  var total: F32 = 0.0
  for ch in xss {
    for v in ch.slice(0, 1) {
      total = total + v
    }
  }
  total
}

// A `for` over the view of an `inout` argument is a borrowed `for` over its place, as a `for` over the
// argument itself (values/binding_borrow_let.onsa `for_over_inout`): only the `let` of the view is an
// E0710 for an `inout` argument (negative/binding_view_span.onsa).
pub fn for_over_the_view_of_an_inout_argument(inout xs: Span[F32]) -> F32 {
  var total: F32 = 0.0
  for v in xs.slice(0, 2) {
    total = total + v
  }
  total
}

pub fn for_over_the_view_of_a_local_array(n: U32) -> F32 {
  var a: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  a[0] = a[0] + n.round_f32()
  var total: F32 = 0.0
  for v in a.slice(0, 2) {
    total = total + v
  }
  total
}

// ------------------------------------------------------------------------ nesting

pub fn in_a_branch(xs: Span[F32], flag: Bool) -> U32 {
  if flag {
    let part = xs.slice(0, 1)
    part.len()
  } else {
    let part = xs.slice(0, 2)
    part.len()
  }
}

pub fn in_a_loop(xs: Span[F32], n: U32) -> F32 {
  var total: F32 = 0.0
  for k in 0 ..< n {
    let part = xs.slice(k, k + 1)
    total = total + part[0]
  }
  total
}

pub fn in_an_arm(xs: Span[F32], o: Option[U32]) -> U32 {
  match o {
    Some(k) => {
      let part = xs.slice(0, k)
      part.len()
    },
    None => 0,
  }
}

pub fn in_a_loop_over_a_view(xs: Span[F32]) -> F32 {
  var total: F32 = 0.0
  for v in xs.slice(0, 2) {
    let part = xs.slice(2, 3)
    total = total + v + part[0]
  }
  total
}

// ------------------------------------------------------------------------ a closure argument

pub fn apply_span(f: fn(Span[F32]) -> U32, s: Span[F32]) -> U32 {
  f.(s)
}

pub fn closure_argument(xs: Span[F32]) -> U32 {
  apply_span(fn(s) {
    let part = s.slice(0, 1)
    part.len()
  }, xs)
}

// ---------------------------------------------------------------------------------- rt

pub rt fn rt_view(xs: Span[F32], n: U32) -> F32 {
  let half = xs.slice(0, n)
  half[0]
}

pub rt fn rt_for_over_a_view(xs: Span[F32], n: U32) -> F32 {
  var total: F32 = 0.0
  for v in xs.slice(0, n) {
    total = total + v
  }
  total
}
