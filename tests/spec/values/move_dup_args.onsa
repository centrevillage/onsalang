// onsa.toml
// [test]
// spec = ["§5.2", "§5.4"]

// S-609 (§5.2): "`move` の印は、所有が移って前の値が以後使えなくなる所（Affine 値）にだけ付ける。`move` 引数に渡す
// Dup 値（Copy、Shared、関数値の変数）には `move` を書かず（`tk(n)`、`ts(s)`、`ap(f)`）、その場で複製して渡す". A
// `move` parameter takes a Copy value, a Shared value and a function value as they are, in a variable,
// a field, a literal, the tail of a block placed at the argument, and the caller keeps its value. The
// mark is still written for the values that move: an Affine value (`take(move b)`), and a value of a
// `T: ?Dup` type parameter, which may be Affine. "`let` などの位置の Dup の値の `move`（`let y = move s`）は
// 所有の束縛を選ぶ印として受け付ける" and a new value built for the argument takes no mark
// (`take(Buf.zeroed(4))`). The marks that are an error are in negative/move_dup_mark.onsa. Every binding
// is read or passed on. No diagnostic is expected anywhere in this file.

pub struct Pt {
  x: I32,
  y: I32,
}

pub struct Gain {
  n: U32,
  name: Str,
}

pub fn inc(x: I32) -> I32 {
  x + 1
}

pub fn tk(move n: U32) -> U32 {
  n
}

pub fn tp(move p: Pt) -> I32 {
  p.x + p.y
}

pub fn ts(move s: Str) -> U32 uses {Alloc} {
  s.len()
}

pub fn ap(move f: fn(I32) -> I32) -> I32 {
  f.(1)
}

pub fn take(move b: Buf[F32]) uses {Alloc} {}

pub fn sink[T: ?Dup](move x: T) {}

// ------------------------------------------------------------------ Copy and Shared values

pub fn copy_variable(n: U32) -> U32 {
  tk(n)
}

pub fn copy_var_changed_after(start: U32) -> U32 {
  var n = start
  let a = tk(n)
  n = n + 1
  a + tk(n)
}

pub fn copy_field(g: Gain) -> U32 {
  tk(g.n)
}

pub fn copy_literal() -> U32 {
  tk(7)
}

pub fn copy_struct(p: Pt) -> I32 {
  tp(p) + tp(Pt { x: 1, y: 2 })
}

pub fn shared_variable(s: Str) -> U32 uses {Alloc} {
  ts(s)
}

pub fn shared_field(g: Gain) -> U32 uses {Alloc} {
  ts(g.name)
}

pub fn shared_literal() -> U32 uses {Alloc} {
  ts("abc")
}

// ------------------------------------------------------------------- tails of a block

pub fn copy_in_an_if(c: Bool, n: U32) -> U32 {
  tk(if c { n } else { 0 })
}

pub fn copy_in_a_match(c: Bool, n: U32) -> U32 {
  tk(match c {
    true => n,
    false => 0,
  })
}

pub fn copy_in_a_block(n: U32) -> U32 {
  tk({ n })
}

pub fn shared_in_an_if(c: Bool, s: Str, t: Str) -> U32 uses {Alloc} {
  ts(if c { s } else { t })
}

// ---------------------------------------------------------------------- function values

pub fn function_item() -> I32 {
  ap(inc)
}

pub fn function_value_variable(move f: fn(I32) -> I32) -> I32 {
  ap(f) + ap(f)
}

pub fn call_through_a_function_value(f: fn(move I32) -> I32, n: I32) -> I32 {
  f.(n)
}

pub fn function_value_in_a_let() -> I32 {
  let g = inc
  ap(g)
}

// --------------------------------------------- the marks that stay: Affine and ?Dup values

pub fn affine_with_the_mark(move b: Buf[F32]) uses {Alloc} {
  take(move b)
}

pub fn new_value_without_the_mark() uses {Alloc} {
  take(Buf.zeroed(4))
}

pub fn maybe_dup_with_the_mark[T: ?Dup](move x: T) {
  sink(move x)
}

pub fn maybe_dup_in_an_if[T: ?Dup](c: Bool, move x: T, move y: T) {
  sink(if c { move x } else { move y })
}

// ----------------------------------------------------- the mark of a binding, accepted

pub fn mark_of_a_binding(s: Str) -> U32 uses {Alloc} {
  let y = move s
  ts(y) + ts(s)
}

pub fn mark_of_a_copy_binding(n: U32) -> U32 {
  let y = move n
  tk(y) + tk(n)
}
