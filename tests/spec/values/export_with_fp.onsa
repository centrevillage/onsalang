// onsa.toml
// [test]
// spec = ["§6.5", "§14.2"]

// W4-02 U1, S-639 (spec §6.5, §14.2): `@export` and `@fp(relaxed)` are both attributes of a function and of a
// flow (§6.5), so a declaration can have the two, in either order. The spec does not name the case; it
// follows from the two places of §6.5 being the same place (NEW). No diagnostic is expected.

@export
@fp(relaxed)
pub fn export_first(x: F32) -> F32 {
  x * 2.0
}

@fp(relaxed)
@export
pub fn fp_first(x: F32) -> F32 {
  x * 3.0
}

@export
@fp(relaxed)
pub flow flow_export_first(x: F32 at sample) -> F32 at sample {
  x * 2.0
}

@fp(relaxed)
@export
pub flow flow_fp_first(x: F32 at sample) -> F32 at sample {
  x * 3.0
}
