// onsa.toml
// [test]
// spec = ["§5.2", "§11.6"]

// S-1113 (§5.2, §11.6): the calls whose tails are a struct literal of the generated `In` or `Out` (or a
// parameter of that type) and are not an overlap, next to the errors of negative/overlap_args_tail_generated.onsa.
// The fields of a literal are places of their own, so a tail whose fields name other variables than the `inout`
// of the same call, two literals read at borrowed arguments of the same call, and a view `In` that is the
// parameter itself against an `inout` `Out` parameter (two variables) do not overlap. The literal of `In` at an
// argument is the places of its elements ("排他性はフィールドの場所ごとに検査する").

pub struct Stereo {
  l: F32,
  r: F32,
}

pub flow pair(l: F32 at sample, r: F32 at sample) -> Stereo at sample {
  Stereo { l: l, r: r }
}

pub struct Wide {
  a: F32,
  b: F32,
}

pub flow spread(x: [F32; 2] at sample, m: F32 at sample) -> Wide at sample {
  Wide { a: x[0] + m, b: x[1] + m }
}

pub fn put_in(i: pair.In, inout o: pair.Out) {}

pub fn put_in_rev(inout o: pair.Out, i: pair.In) {}

pub fn put_out(o: pair.Out, inout s: Span[F32]) {}

pub fn in_sp(i: pair.In, inout s: Span[F32]) {}

pub fn read_both(i: pair.In, j: pair.In) {}

pub fn spread_in(i: spread.In, inout s: Span[F32]) {}

pub fn spread_out(i: spread.In, inout o: spread.Out) {}

pub fn in_literals_of_other_variables(c: Bool) {
  var x: [F32; 2] = [0.0; 2]
  var y: [F32; 2] = [0.0; 2]
  var z: [F32; 2] = [0.0; 2]
  var w: [F32; 2] = [0.0; 2]
  put_in(if c { pair.In { l: x, r: y } } else { pair.In { l: y, r: y } }, inout pair.Out { l: z, r: w })
}

pub fn in_literals_of_other_variables_in_a_match(c: Bool) {
  var x: [F32; 2] = [0.0; 2]
  var y: [F32; 2] = [0.0; 2]
  var z: [F32; 2] = [0.0; 2]
  var w: [F32; 2] = [0.0; 2]
  put_in(match c { true => pair.In { l: x, r: y }, false => pair.In { l: y, r: y } }, inout pair.Out { l: z, r: w })
}

pub fn in_literal_in_a_block(c: Bool) {
  var x: [F32; 2] = [0.0; 2]
  var y: [F32; 2] = [0.0; 2]
  var z: [F32; 2] = [0.0; 2]
  var w: [F32; 2] = [0.0; 2]
  put_in({ pair.In { l: x, r: y } }, inout pair.Out { l: z, r: w })
}

pub fn in_literals_of_other_variables_inout_first(c: Bool) {
  var x: [F32; 2] = [0.0; 2]
  var y: [F32; 2] = [0.0; 2]
  var z: [F32; 2] = [0.0; 2]
  var w: [F32; 2] = [0.0; 2]
  put_in_rev(inout pair.Out { l: z, r: w }, if c { pair.In { l: x, r: y } } else { pair.In { l: y, r: y } })
}

pub fn in_literal_and_a_span_of_another_variable(c: Bool) {
  var x: [F32; 2] = [0.0; 2]
  var y: [F32; 2] = [0.0; 2]
  var z: [F32; 2] = [0.0; 2]
  in_sp(if c { pair.In { l: x, r: y } } else { pair.In { l: y, r: y } }, inout z)
}

pub fn in_the_parameters(c: Bool, i: pair.In, j: pair.In, inout o: pair.Out) {
  put_in(if c { i } else { j }, inout o)
}

pub fn in_a_parameter_and_a_literal(c: Bool, i: pair.In, inout o: pair.Out) {
  var x: [F32; 2] = [0.0; 2]
  var y: [F32; 2] = [0.0; 2]
  put_in(if c { i } else { pair.In { l: x, r: y } }, inout o)
}

pub fn in_two_reads_of_the_same_variable(c: Bool) {
  var x: [F32; 2] = [0.0; 2]
  var y: [F32; 2] = [0.0; 2]
  read_both(if c { pair.In { l: x, r: y } } else { pair.In { l: y, r: y } }, pair.In { l: x, r: x })
}

pub fn out_literals_of_other_variables(c: Bool) {
  var x: [F32; 2] = [0.0; 2]
  var y: [F32; 2] = [0.0; 2]
  var z: [F32; 2] = [0.0; 2]
  put_out(if c { pair.Out { l: x, r: y } } else { pair.Out { l: y, r: x } }, inout z)
}

pub fn out_a_parameter_and_a_literal(c: Bool, o: pair.Out, inout s: Span[F32]) {
  var x: [F32; 2] = [0.0; 2]
  var y: [F32; 2] = [0.0; 2]
  put_out(if c { o } else { pair.Out { l: x, r: y } }, inout s)
}

pub fn spread_in_array_field_of_other_variables(c: Bool) {
  var x: [F32; 2] = [0.0; 2]
  var y: [F32; 2] = [0.0; 2]
  var z: [F32; 2] = [0.0; 2]
  var w: [F32; 2] = [0.0; 2]
  spread_in(if c { spread.In { m: x, x: [y, z] } } else { spread.In { m: y, x: [y, y] } }, inout w)
}

pub fn spread_in_array_field_against_an_out_literal(c: Bool) {
  var x: [F32; 2] = [0.0; 2]
  var y: [F32; 2] = [0.0; 2]
  var z: [F32; 2] = [0.0; 2]
  var w: [F32; 2] = [0.0; 2]
  var v: [F32; 2] = [0.0; 2]
  spread_out(if c { spread.In { m: x, x: [y, z] } } else { spread.In { m: y, x: [y, y] } }, inout spread.Out { a: w, b: v })
}
