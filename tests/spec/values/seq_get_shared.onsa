// onsa.toml
// [test]
// spec = ["§5.3", "§4.6", "§5.2"]

// A Shared element (`Str`) is Dup, so `len` and `get` of `[Str; N]` are there (S-853: "`[T; N]` は
// `len()` を要素によらず持ち、`get`・`fill!` は要素が Dup のとき", S-794 "Shared の要素と Dup の `T` の `get` は
// 通る"). `fill!` is for a Copy element (S-1040: "`[T; N]` の `fill!` は要素が Copy のときだけ持つ"), so a
// `[Str; N]` is filled with `xs = [v; N]`, which drops the previous elements (`uses {Alloc}`, §12.2). The other
// methods that need Copy (`slice`, `copy_from!`, `add_from!`) are E0416 for it: negative/seq_slice_shared.onsa, and
// `fill!` of it: negative/seq_fill_shared.onsa. This version cannot run a Shared type (E0200 in the lowering), so the
// case only checks: the values of `get` and the fill are for the `test` blocks that W5-02 U6 (`Str`) can add.

pub fn len_of(xs: [Str; 3]) -> U32 {
  xs.len()
}

pub fn get_length(xs: [Str; 3], i: U32) -> U32 uses {Alloc} {
  match xs.get(i) {
    Some(s) => s.len(),
    None => 0,
  }
}

pub fn get_of_a_var() -> U32 uses {Alloc} {
  var xs: [Str; 2] = ["a", "bc"]
  xs = ["z"; 2]
  match xs.get(1) {
    Some(s) => s.len(),
    None => 0,
  }
}

pub fn fill_with(inout xs: [Str; 3], s: Str) uses {Alloc} {
  xs = [s; 3]
}

pub fn fill_an_inner_array(inout rows: [[Str; 2]; 2]) uses {Alloc} {
  rows[0] = ["eee"; 2]
}

pub fn get_of_an_inner_array(rows: [[Str; 2]; 2]) -> U32 uses {Alloc} {
  match rows[1].get(0) {
    Some(s) => s.len(),
    None => 0,
  }
}

pub fn len_of_a_parameter[T, const N: U32](xs: [T; N]) -> U32 {
  xs.len()
}

pub fn get_of_a_parameter[T, const N: U32](xs: [T; N], i: U32) -> U32 uses {Alloc} {
  match xs.get(i) {
    Some(_) => 1,
    None => 0,
  }
}

pub fn use_the_parameters(xs: [Str; 3]) -> U32 uses {Alloc} {
  len_of_a_parameter(xs) + get_of_a_parameter(xs, 1)
}
