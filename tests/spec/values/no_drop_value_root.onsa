// onsa.toml
// [test]
// spec = ["§5.4", "§5.2", "§10", "§12.2", "§8.1"]

// S-1065 (§5.4, §5.2, §10, §12.2, §8.1), with D1: "破棄の要らない値は、…それらの経路（フィールドと添字。`["a", "bc"][i]`、
// `("gain", v).0`、`p.name`、`t[i]`）、…発散しない全ての末尾が破棄の要らない値である `if`・`match`・ブロック式とその経路
// （`if c { "a" } else { "b" }`、`(if c { ("a", 1) } else { ("b", 2) }).0`）である". The path of a literal that needs no drop
// (`("gain", v).0`) and the path whose root is an `if`, a `match` or a block that needs no drop
// (`(if c { ("a", 1) } else { ("b", 2) }).0`) are values that need no drop wherever they stand: the initializer of a `let`, the
// element of a literal (also one that waits for a `?`), the receiver of a method and the heading of a `match`. Their copy
// and drop need no `Alloc` (§12.2), so there is no E0601 in an `rt fn` (§10 rule 1). The same functions without `rt` are in
// values/no_drop_value_root_plain.onsa. Before S-1065 the path of a literal and the path of an `if` as an element of a
// literal, and the path of an `if` anywhere, were owned (E0601). The path of an `if` whose tails are borrowed arguments
// (`(if c { x } else { y }).0`) is not done in this version (D2, S-1065 and L3 of tasks/phase2.md): it is in
// negative/no_drop_value_owned_elem.onsa. One form in one function (P-01). The arguments `v`, `w` are `F32`. No
// diagnostic is expected anywhere in this file.

pub rt fn tlen(p: (Str, F32), n: U32) -> U32 {
  p.0.len() + n
}

// ----------------------------------------------- the path of a literal as an element (S-1065)

pub rt fn let_a_tuple_with_the_path_of_a_literal(v: F32, w: F32) -> U32 {
  let p = (("gain", v).0, w)
  p.0.len()
}

pub rt fn wait_a_tuple_with_the_path_of_a_literal(v: F32, w: F32, r: Result[U32, U32]) -> Result[((Str, F32), U32), U32] {
  Ok(((("gain", v).0, w), r?))
}

pub rt fn borrow_a_tuple_with_the_path_of_a_literal(v: F32, w: F32) -> U32 {
  tlen((("gain", v).0, w), 1)
}

pub rt fn let_a_tuple_with_the_path_of_a_nested_literal(v: F32, w: F32) -> U32 {
  let p = ((("gain", v), w).0.0, w)
  p.0.len()
}

// ----------------------------------------------- the root is an `if`, a `match` or a block (D1)

pub rt fn let_the_path_of_an_if(c: Bool) -> U32 {
  let t = (if c { ("a", 1) } else { ("b", 2) }).0
  t.len()
}

pub rt fn let_the_path_of_a_match(i: U32) -> U32 {
  let t = (match i { 0 => ("a", 1), _ => ("b", 2) }).0
  t.len()
}

pub rt fn let_the_path_of_a_block(v: F32) -> U32 {
  let t = ({ ("a", v) }).0
  t.len()
}

pub rt fn let_the_path_of_an_if_then_a_binding(c: Bool) -> U32 {
  let q = if c { ("a", 1) } else { ("b", 2) }
  let t = q.0
  t.len()
}

pub rt fn receive_the_path_of_an_if(c: Bool) -> U32 {
  (if c { ("a", 1) } else { ("b", 2) }).0.len()
}

pub rt fn wait_the_path_of_an_if(c: Bool, r: Result[U32, U32]) -> Result[(Str, U32), U32] {
  Ok(((if c { ("a", 1) } else { ("b", 2) }).0, r?))
}

pub rt fn wait_a_tuple_with_the_path_of_an_if(c: Bool, v: F32, r: Result[U32, U32]) -> Result[((Str, F32), U32), U32] {
  Ok((((if c { ("a", 1) } else { ("b", 2) }).0, v), r?))
}

pub rt fn let_a_tuple_with_the_path_of_an_if(c: Bool, v: F32) -> U32 {
  let p = ((if c { ("a", 1) } else { ("b", 2) }).0, v)
  p.0.len()
}

pub rt fn match_the_path_of_an_if(c: Bool) -> U32 {
  match (if c { ("a", 1) } else { ("b", 2) }).0 {
    s => s.len(),
  }
}

pub rt fn for_over_the_path_of_an_if(c: Bool) -> U32 {
  var n: U32 = 0
  for s in (if c { (["a", "b"], 1) } else { (["c", "d"], 2) }).0 {
    n = n + s.len()
  }
  n
}

pub rt fn wait_the_path_of_a_match_with_a_diverging_arm(i: U32, r: Result[U32, U32]) -> Result[(Str, U32), U32] {
  Ok(((match i { 0 => ("a", 1), 1 => ("b", 2), _ => { return Err(1) } }).0, r?))
}
