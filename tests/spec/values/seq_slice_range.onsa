// onsa.toml
// [test]
// mode = "test"
// spec = ["§5.3", "§9.2"]

// `slice(from, to)` is the half-open range `[from, to)` of a `Span`, and "範囲外（`to > len`）と端の逆転（`from > to`）は
// panic" (§5.3; §9.2: "範囲外の添字アクセス `xs[i]` と `xs.slice(from, to)`" and "`xs.slice(from, to)` の端の逆転（`from > to`）"; S-1148 (1)). Inside the range,
// also the empty ranges at the start, in the middle and at the end (`from == to`, also `xs.slice(4, 4)` for a length of 4), it is a view of `to - from`
// elements. A view that goes beyond `len()` panics (`xs.slice(5, 5)` too, an empty range past the end), and so does an inverted range (`xs.slice(3, 1)` for a length of 4, both ends inside the length),
// for the three receivers `[T; N]`, `Buf[T]` and `Span[T]`, and for a view of a view. The inverted range is a case of its own and not an empty range: `xs.slice(2, 2)` is a view of
// length 0 and `xs.slice(2, 1)` panics.

fn view_len(s: Span[F32]) -> U32 {
  s.len()
}

fn view_of(xs: Span[F32], a: U32, b: U32) -> U32 {
  view_len(xs.slice(a, b))
}

test "slice inside the range is a view of to - from elements" {
  let xs: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  assert view_len(xs.slice(0, 4)) == 4
  assert view_len(xs.slice(1, 3)) == 2
  assert view_len(xs.slice(2, 2)) == 0
  assert view_len(xs.slice(0, 0)) == 0
  assert view_len(xs.slice(4, 4)) == 0
  assert view_len(xs.slice(3, 4)) == 1
}

test "slice of a Buf and of a Span inside the range" {
  let b: Buf[F32] = Buf.zeroed(4)
  assert view_len(b.slice(1, 4)) == 3
  assert view_len(b.slice(4, 4)) == 0
  let xs: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  assert view_of(xs, 1, 4) == 3
  assert view_of(xs.slice(1, 4), 1, 3) == 2
  assert view_of(xs.slice(1, 4), 3, 3) == 0
}

test "slice of an array past the end panics" {
  let xs: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  let n = view_len(xs.slice(2, 5)) //~ PANIC "slice of an array past the end panics"
  assert n == 3
}

test "slice of an array with both ends past the end panics" {
  let xs: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  let n = view_len(xs.slice(5, 6)) //~ PANIC "slice of an array with both ends past the end panics"
  assert n == 1
}

test "slice of an array that starts past the end and is empty panics" {
  let xs: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  let n = view_len(xs.slice(5, 5)) //~ PANIC "slice of an array that starts past the end and is empty panics"
  assert n == 0
}

test "slice of a Buf past the end panics" {
  let b: Buf[F32] = Buf.zeroed(3)
  let n = view_len(b.slice(0, 4)) //~ PANIC "slice of a Buf past the end panics"
  assert n == 4
}

test "slice of a Span past the end panics" {
  let xs: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  let n = view_of(xs, 0, 5) //~ PANIC "slice of a Span past the end panics"
  assert n == 5
}

test "slice of a view is checked against the view and not the array" {
  let xs: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  let n = view_of(xs.slice(0, 2), 1, 3) //~ PANIC "slice of a view is checked against the view and not the array"
  assert n == 2
}

test "slice with an empty range is a view of length 0" {
  let xs: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  assert view_len(xs.slice(2, 2)) == 0
  assert view_len(xs.slice(4, 4)) == 0
  assert view_len(xs.slice(0, 0)) == 0
}

test "slice of an array with the ends inverted inside the length panics" {
  let xs: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  let n = view_len(xs.slice(3, 1)) //~ PANIC "slice of an array with the ends inverted inside the length panics"
  assert n == 0
}

test "slice of an array with the ends inverted by one panics" {
  let xs: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  let n = view_len(xs.slice(2, 1)) //~ PANIC "slice of an array with the ends inverted by one panics"
  assert n == 0
}

test "slice of an array with the ends inverted to the start panics" {
  let xs: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  let n = view_len(xs.slice(4, 0)) //~ PANIC "slice of an array with the ends inverted to the start panics"
  assert n == 0
}

test "slice of an array with the ends inverted and past the end panics" {
  let xs: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  let n = view_len(xs.slice(6, 5)) //~ PANIC "slice of an array with the ends inverted and past the end panics"
  assert n == 0
}

test "slice of a Buf with the ends inverted panics" {
  let b: Buf[F32] = Buf.zeroed(3)
  let n = view_len(b.slice(2, 1)) //~ PANIC "slice of a Buf with the ends inverted panics"
  assert n == 0
}

test "slice of a Span with the ends inverted panics" {
  let xs: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  let n = view_of(xs, 3, 1) //~ PANIC "slice of a Span with the ends inverted panics"
  assert n == 0
}

test "slice of a view with the ends inverted is checked against the view" {
  let xs: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  let n = view_of(xs.slice(1, 4), 2, 1) //~ PANIC "slice of a view with the ends inverted is checked against the view"
  assert n == 0
}
