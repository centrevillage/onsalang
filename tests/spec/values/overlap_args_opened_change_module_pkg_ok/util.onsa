// onsa.toml
// [test]
// spec = ["§5.2", "§5.3", "§11.6", "§15.1"]

// R-486, S-196 (§5.2) across modules: the callees and the flow of this module are used from app.onsa. The changes inside
// an argument that is a struct literal of the generated `In` (a statement of an arm before the literal, a field's own
// block that declares its variable), and inside a planar array literal, do not overlap the other places of the call
// whatever module declares the callee, a type or the generated `In`/`Out` (§11.6, §15.1).

pub struct Stereo {
  l: F32,
  r: F32,
}

pub flow pair(l: F32 at sample, r: F32 at sample) -> Stereo at sample {
  Stereo { l: l, r: r }
}

pub fn take_in(i: pair.In) -> F32 {
  i.l[0]
}

pub fn put_in(i: pair.In, inout o: pair.Out) {}

pub fn planes(xs: [Span[F32]; 2]) -> F32 {
  xs[0][0] + xs[1][1]
}
