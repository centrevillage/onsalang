// onsa.toml
// [test]
// spec = ["§5.2", "§5.4", "§7", "§10", "§12.2"]

// S-604, S-589, R-85 (§5.4, §5.2): the tails of an `if`, a `match`, a block and a parenthesis decide
// the binding of a `let` for an Affine type too. When every tail that stays is a borrowed origin
// (`x` and `y` are arguments in the default mode, of the type `Buf[F32]`), the binding is a borrowed
// binding of an Affine value: "借用束縛は消費しない" (§5.2), it can be read and passed on in the default
// mode, and a binding derived from it (`let q = t`) is borrowed too (§5.4: "派生"). A borrowed binding
// ends without a drop (§12.2), so an `rt fn` binds a `Buf` this way, where an owned `Buf` is an E0901.
// Every binding is read (a binding never read is an E0309). No diagnostic is expected anywhere in this
// file. The uses that stay an error (moving the binding on, returning it) are in
// negative/binding_tail_affine_move.onsa, the run is in values/binding_tail_run.onsa.

pub struct Holder {
  buf: Buf[F32],
  gain: F32,
}

pub fn length(b: Buf[F32]) -> U32 {
  b.len()
}

// ------------------------------------------------------------------------------ the forms

pub fn if_tails(c: Bool, x: Buf[F32], y: Buf[F32]) -> U32 {
  let t = if c { x } else { y }
  t.len()
}

pub fn block_tail(x: Buf[F32]) -> U32 {
  let t = { x }
  t.len()
}

pub fn parenthesis(x: Buf[F32]) -> U32 {
  let t = (x)
  t.len()
}

pub fn match_tails(o: Option[Buf[F32]], d: Buf[F32]) -> U32 {
  let t = match o {
    Some(b) => b,
    None => d,
  }
  t.len()
}

pub fn field_tails(c: Bool, h: Holder, g: Holder) -> U32 {
  let t = if c { h.buf } else { g.buf }
  t.len()
}

pub fn else_returns(c: Bool, x: Buf[F32]) -> U32 {
  let t = if c { x } else { return 0 }
  t.len()
}

pub fn nested(c: Bool, o: Option[Buf[F32]], x: Buf[F32], y: Buf[F32]) -> U32 {
  let t = if c {
    match o {
      Some(b) => b,
      None => x,
    }
  } else {
    y
  }
  t.len()
}

// ------------------------------------------------------------------- the binding is read

pub fn read_twice(c: Bool, x: Buf[F32], y: Buf[F32]) -> U32 {
  let t = if c { x } else { y }
  t.len() + t.len()
}

pub fn passed_on(c: Bool, x: Buf[F32], y: Buf[F32]) -> U32 {
  let t = if c { x } else { y }
  length(t)
}

pub fn derived(c: Bool, x: Buf[F32], y: Buf[F32]) -> U32 {
  let t = if c { x } else { y }
  let q = t
  q.len()
}

pub fn derived_twice(c: Bool, x: Buf[F32], y: Buf[F32]) -> U32 {
  let t = if c { x } else { y }
  let q = t
  let r = q
  length(r)
}

pub fn the_arguments_are_still_whole(c: Bool, x: Buf[F32], y: Buf[F32]) -> U32 {
  let t = if c { x } else { y }
  t.len() + x.len() + y.len()
}

// A Copy field out of the binding is a copy.
pub fn copy_field(c: Bool, h: Holder, g: Holder) -> F32 {
  let t = if c { h } else { g }
  t.gain
}

pub fn in_a_loop(c: Bool, x: Buf[F32], y: Buf[F32], n: U32) -> U32 {
  var total: U32 = 0
  for i in 0 ..< n {
    let t = if c { x } else { y }
    total = total + t.len() + i
  }
  total
}

// --------------------------------------------------------------- in an rt fn: no drop, no E0901

pub rt fn rt_if_tails(c: Bool, x: Buf[F32], y: Buf[F32]) -> U32 {
  let t = if c { x } else { y }
  t.len()
}

pub rt fn rt_match_tails(o: Option[Buf[F32]], d: Buf[F32]) -> U32 {
  let t = match o {
    Some(b) => b,
    None => d,
  }
  t.len()
}

pub rt fn rt_derived(c: Bool, x: Buf[F32], y: Buf[F32]) -> U32 {
  let t = if c { x } else { y }
  let q = t
  q.len()
}

pub rt fn rt_block_tail(x: Buf[F32]) -> U32 {
  let t = { x }
  t.len()
}

pub rt fn rt_else_returns(c: Bool, x: Buf[F32]) -> U32 {
  let t = if c { x } else { return 0 }
  t.len()
}

// ------------------------------------------------------------------------------- generic

// A value of a type parameter that may be Affine (`T: ?Dup`, §4.6) in a borrowed argument is a
// borrowed origin, so the binding of the tails is borrowed and the value is not duplicated.
pub fn probe[T: ?Dup](v: T) -> U32 {
  0
}

pub fn generic_tails[T: ?Dup](c: Bool, x: T, y: T) -> U32 {
  let t = if c { x } else { y }
  probe(t)
}

pub fn generic_tails_derived[T: ?Dup](c: Bool, x: T, y: T) -> U32 {
  let t = if c { x } else { y }
  let q = t
  probe(q)
}

// ----------------------------------------------------------------- self and the binding of a for

impl Holder {
  pub fn pick(self, c: Bool, other: Holder) -> U32 {
    let t = if c { self.buf } else { other.buf }
    t.len()
  }
}

pub fn for_element(c: Bool, xs: [Holder; 2], y: Buf[F32]) -> U32 {
  var n: U32 = 0
  for s in xs {
    let t = if c { s.buf } else { y }
    n = n + t.len()
  }
  n
}

// ------------------------------------------------------------------ an anonymous function

pub fn apply_buf(f: fn(Bool, Buf[F32], Buf[F32]) -> U32, c: Bool, x: Buf[F32], y: Buf[F32]) -> U32 {
  f.(c, x, y)
}

pub fn closure_argument(c: Bool, x: Buf[F32], y: Buf[F32]) -> U32 {
  apply_buf(fn(k, a, b) {
    let t = if k { a } else { b }
    t.len()
  }, c, x, y)
}
