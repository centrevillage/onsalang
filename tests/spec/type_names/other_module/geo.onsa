pub struct Point {
  x: F32,
  y: F32,
}

impl Point {
  pub const ORIGIN: Point = Point { x: 0.0, y: 0.0 }

  pub fn new(x: F32, y: F32) -> Point {
    Point { x: x, y: y }
  }
}

pub type Pt = Point

pub enum Shape {
  Circle(F32),
  Dot,
}

pub type Sh = Shape

pub struct Counter {
  n: U32,
  priv last: U32,
}

impl Counter {
  pub fn start() -> Counter {
    Counter { n: 0, last: 0 }
  }

  pub fn count(self) -> U32 {
    self.n
  }
}

pub type Ctr = Counter

pub type Sample = F32
