// onsa.toml
// [test]
// spec = ["§15.1", "§5.1", "§18.1"]

// S-729 (W4-04 U10): a local binding or a parameter written in a type place of a body is a value that is
// found there, so it is E0308 (§15.1: "値（ローカルの束縛と引数を含む）…を型の位置に書く"), not the E0302 of a
// name that is not found. §5.1 does not divide the names into spaces: a name that is visible is found. The
// places are all the type places of a body: the annotation of a `let`, the target of an `as`, the type of
// the parameter and of the result of an anonymous function, a type argument, an element of a tuple or of an
// array, the type of a function value; and every kind of binding that is visible there: a `let`, a `var`,
// a parameter of the function, a part of a destructuring, the binding of a `for` and of a `match` arm, the
// parameter of an anonymous function, a binding of the function outside the anonymous function (it is
// captured, so it is visible). The bodies are a function, a method, a generic function, a `test`, the
// initializer of a `const` and a flow (a `let`, an input, the index of a `par`).
// A name that is not visible there (a name of a sibling scope, a name declared later, a name of a closed
// block) stays E0302 (§5.1: the visible range), and is in body_locals_not_visible.onsa.
// One error per unit (§18.1), so each form is in its own unit. The E0308 of a visible local and the E0302 of
// a name that is not found are of the same stage (the names), so the first in the place is reported.

pub struct P {
  x: I32,
}

fn inc(x: I32) -> I32 {
  x + 1
}

// ---- A binding of a function in the annotation of a `let` ----

pub fn local_in_an_annotation() -> I32 {
  let a = 1
  let _: a = 2                                      //~ E0308
  0
}

pub fn variable_in_an_annotation() -> I32 {
  var a = 1
  let _: a = 2                                      //~ E0308
  0
}

pub fn parameter_in_an_annotation(n: I32) -> I32 {
  let _: n = 2                                      //~ E0308
  0
}

pub fn second_parameter_in_an_annotation(m: I32, n: I32) -> I32 {
  let _: n = m                                      //~ E0308
  0
}

pub fn local_with_a_type_in_an_annotation() -> I32 {
  let a: I32 = 1
  let _: a = 2                                      //~ E0308
  0
}

pub fn function_value_in_an_annotation() -> I32 {
  let f = fn(x: I32) -> I32 { x }
  let _: f = inc                                    //~ E0308
  0
}

pub fn part_of_a_destructuring_in_an_annotation() -> I32 {
  let (p, q) = (1, 2)
  let _: q = 3                                      //~ E0308
  0
}

pub fn field_of_a_struct_pattern_in_an_annotation(s: P) -> I32 {
  let P { x: v } = s
  let _: v = 3                                      //~ E0308
  0
}

// ---- Other type places ----

pub fn local_as_a_cast_target(n: I32) -> I32 {
  let a = 1
  let _ = n as a                                    //~ E0308
  0
}

pub fn parameter_as_a_cast_target(n: I32, m: I32) -> I32 {
  let _ = n as m                                    //~ E0308
  0
}

pub fn local_as_a_type_argument() -> I32 {
  let a = 1
  let _: Option[a] = None                           //~ E0308
  0
}

pub fn local_in_a_nested_type_argument() -> I32 {
  let a = 1
  let _: Option[Option[a]] = None                   //~ E0308
  0
}

pub fn local_in_a_tuple_type() -> I32 {
  let a = 1
  let _: (I32, a) = (1, 2)                          //~ E0308
  0
}

pub fn local_as_the_element_of_an_array() -> I32 {
  let a = 1
  let _: [a; 2] = [1, 2]                            //~ E0308
  0
}

pub fn local_in_a_function_type() -> I32 {
  let a = 1
  let _: fn(a) -> I32 = inc                         //~ E0308
  0
}

pub fn local_in_the_result_of_a_function_type() -> I32 {
  let a = 1
  let _: fn(I32) -> a = inc                         //~ E0308
  0
}

// ---- An anonymous function ----

pub fn local_as_a_closure_parameter_type() -> I32 {
  let a = 1
  let f = fn(x: a) -> I32 { 0 }                     //~ E0308
  f.(1)
}

pub fn local_as_a_closure_result_type() -> I32 {
  let a = 1
  let f = fn(x: I32) -> a { x }                     //~ E0308
  f.(1)
}

pub fn parameter_as_a_closure_parameter_type(n: I32) -> I32 {
  let f = fn(x: n) -> I32 { 0 }                     //~ E0308
  f.(1)
}

pub fn parameter_of_a_closure_in_its_own_body() -> I32 {
  let f = fn(y: I32) -> I32 {
    let _: y = 1                                    //~ E0308
    y
  }
  f.(1)
}

pub fn captured_local_in_the_body_of_a_closure() -> I32 {
  let a = 1
  let f = fn(x: I32) -> I32 {
    let _: a = x                                    //~ E0308
    x
  }
  f.(1)
}

pub fn parameter_of_the_outer_closure_in_the_inner_one() -> I32 {
  let f = fn(x: I32) -> I32 {
    let g = fn(y: x) -> I32 { 0 }                   //~ E0308
    g.(x)
  }
  f.(1)
}

// ---- The bindings of `for` and `match`, and the branches ----

pub fn binding_of_a_for_in_an_annotation() -> I32 {
  for i in 0 ..< 3 {
    let _: i = 1                                    //~ E0308
  }
  0
}

pub fn binding_of_a_match_arm_in_an_annotation(o: Option[I32]) -> I32 {
  match o {
    Some(v) => {
      let _: v = 1                                  //~ E0308
      v
    },
    None => 0,
  }
}

pub fn binding_of_a_match_arm_as_a_cast_target(o: Option[I32]) -> I32 {
  match o {
    Some(v) => v as v,                              //~ E0308
    None => 0,
  }
}

pub fn local_in_a_branch(flag: Bool) -> I32 {
  if flag {
    let a = 1
    let _: a = 2                                    //~ E0308
    1
  } else {
    0
  }
}

pub fn outer_local_in_a_branch(flag: Bool) -> I32 {
  let a = 1
  if flag {
    let _: a = 2                                    //~ E0308
    1
  } else {
    0
  }
}

pub fn outer_local_in_a_match_arm(n: U32) -> I32 {
  let a = 1
  match n {
    0 => 0,
    _ => {
      let _: a = 2                                  //~ E0308
      1
    },
  }
}

pub fn outer_local_in_a_for(n: U32) -> I32 {
  let a = 1
  for _ in 0 ..< n {
    let _: a = 2                                    //~ E0308
  }
  0
}

// ---- A generic function, a method, a `test`, the initializer of a `const` ----

pub fn local_in_a_generic_function[T](x: T) -> T {
  let a = 1
  let _: a = 2                                      //~ E0308
  x
}

pub fn parameter_in_a_generic_function[T](x: T, n: I32) -> T {
  let _: n = 2                                      //~ E0308
  x
}

impl P {
  pub fn local_in_a_method(self) -> I32 {
    let a = 1
    let _: a = 2                                    //~ E0308
    self.x
  }

  pub fn parameter_in_a_method(self, n: I32) -> I32 {
    let _: n = 2                                    //~ E0308
    self.x
  }
}

test "a local as a type in a test" {
  let a = 1
  let _: a = 2                                      //~ E0308
  assert a == 1
}

test "a binding of a for as a type in a test" {
  for i in 0 ..< 2 {
    let _: i = 1                                    //~ E0308
  }
  assert true
}

const LOCAL_IN_A_CONST: I32 = {
  let a = 1
  let _: a = 2                                      //~ E0308
  3
}

const LOCAL_AS_A_CAST_TARGET_IN_A_CONST: I32 = {
  let a = 1
  2 as a                                            //~ E0308
}

// ---- A flow: a `let`, an input, the index of a `par` ----

pub flow local_in_a_flow(x: F32 at sample) -> F32 at sample {
  let a = x * 2.0
  let _: a = 1.0                                    //~ E0308
  a
}

pub flow input_in_a_flow(x: F32 at sample) -> F32 at sample {
  let _: x = 1.0                                    //~ E0308
  x
}

pub flow local_as_a_type_argument_in_a_flow(x: F32 at sample) -> F32 at sample {
  let a = x * 2.0
  let _: Option[a] = None                           //~ E0308
  a
}

pub flow index_of_a_par_in_a_flow(x: F32 at sample) -> F32 at sample {
  let ys = par i in 0 ..< 3 {
    let _: i = 1                                    //~ E0308
    x * i.round_f32()
  }
  ys[0]
}

// ---- The first error in the place is reported ----

pub fn local_then_unknown_name() -> I32 {
  let a = 1
  let _: a = 2                                      //~ E0308
  let _: Nope = 3
  0
}

pub fn local_then_unknown_name_in_one_annotation() -> I32 {
  let a = 1
  let _: (a, Nope) = (1, 2)                         //~ E0308
  0
}
