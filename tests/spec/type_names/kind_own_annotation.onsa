// onsa.toml
// [test]
// spec = ["§5.1", "§15.1", "§18.1"]

// S-739 (3), S-741 (W4-19): the binding of a `let` or a `var` of a function (a destructuring too) is visible
// from the statement after it, and not from its own annotation and its initializer (§5.1: "fn の本体の `let`・
// `var` の束縛（分解を含む）はその文の後ろから見え、自分の注釈と初期化式からは見えない（`let a: a = 1` は
// 見つからない名前の E0302）"). So the name of a binding written in its own annotation is not found there:
// E0302, not the E0308 of a name that is found and is a value. The places are the annotation itself, the
// type argument, the element of a tuple and the length of an array in it, and a part of a destructuring
// (the other part of the same pattern is not visible either). The bodies are a function, a method, a generic
// function, a `test` and the initializer of a `const`. The statement after the binding sees it (the last
// units), and these units do not change with the rest of W4-19: the forms are kept.
// One error per unit (§18.1), so each form is in its own unit.

pub struct P {
  x: I32,
}

pub fn own_name_in_a_let() -> I32 {
  let a: a = 1   //~ E0302
  0
}

pub fn own_name_in_a_var() -> I32 {
  var a: a = 1   //~ E0302
  0
}

pub fn own_name_in_a_type_argument() -> I32 {
  let a: Option[a] = None   //~ E0302
  0
}

pub fn own_name_in_an_array_length() -> I32 {
  let a: [F32; a] = [0.0; 2]   //~ E0302
  0
}

pub fn own_name_in_a_tuple_type() -> I32 {
  let a: (I32, a) = (1, 2)   //~ E0302
  0
}

pub fn later_part_of_a_destructuring() -> I32 {
  let (p, q): (q, I32) = (1, 2)   //~ E0302
  0
}

pub fn earlier_part_of_a_destructuring() -> I32 {
  let (p, q): (I32, p) = (1, 2)   //~ E0302
  0
}

pub fn own_part_of_a_destructuring() -> I32 {
  let (p, q): (p, p) = (1, 2)   //~ E0302
  0
}

pub fn part_of_a_struct_pattern(s: P) -> I32 {
  let P { x: v }: v = s   //~ E0302
  0
}

pub fn own_name_after_a_right_binding() -> I32 {
  let b = 1
  var a: a = b   //~ E0302
  b
}

pub fn own_name_in_a_generic_function[T](x: T) -> T {
  let a: a = 1   //~ E0302
  x
}

pub fn own_name_in_a_branch(flag: Bool) -> I32 {
  if flag {
    let a: a = 1   //~ E0302
    1
  } else {
    0
  }
}

impl P {
  pub fn own_name_in_a_method(self) -> I32 {
    let a: a = 1   //~ E0302
    self.x
  }
}

test "own name in a test" {
  let a: a = 1   //~ E0302
  assert true
}

const OWN_NAME_IN_A_CONST: I32 = {
  let a: a = 1   //~ E0302
  2
}

pub fn own_name_in_a_closure_body() -> I32 {
  let f = fn(x: I32) -> I32 {
    let a: a = x   //~ E0302
    a
  }
  f.(1)
}

// ---- The statement after the binding sees it ----

pub fn name_of_the_statement_before() -> I32 {
  let a = 1
  let _: a = 2   //~ E0308
  0
}

pub fn name_of_a_destructuring_in_the_next_statement() -> I32 {
  let (p, q) = (1, 2)
  let _: p = q   //~ E0308
  0
}
