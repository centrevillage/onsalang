// onsa.toml
// [test]
// spec = ["§15.1", "§8.1", "§4.1", "§18.1"]

// R-302, R-300, S-103, S-713 (W4-04 U8b): a name that is found and is not of the kind that the place needs is
// E0308, and a name that is not found is E0302 (§15.1: "名前が見つからなければ E0302。名前は見つかったが、その位置
// に要る種類 … でなければ、位置によらず E0308"). These are the found names that were E0302 ("cannot find",
// a false word for a name that is found):
//  - the head of a struct literal needs a type, so a const parameter (`M { x: 1 }`, a value and a constant)
//    and an associated constant (`F32.PI { x: 1 }`, `I32.BITS { x: 1 }`, `P.N { x: 1 }`) are E0308; the same in
//    the annotation of a `let` in a body (`let _: F32.PI`,
//    `let _: Str.len`, `let _: F32.from_bits`, `let _: I32.BITS`; the same names of a type of the program,
//    `let _: P.N`, are the fine reference);
//  - a method of a built-in type with a name after it (`Str.len.zz`) is the E0308 of a method named through
//    its type (the name `Str.len` is found), as for a type of the program (`P.get.zz`);
//  - a name that the built-in type does not have is still E0302 (`F32.NOPE`, `Str.zz`).
// The call of an effect with a member that the effect has not (`Alloc.x()`) is the E0302 of a name that the
// namespace has not (§15.1: "名前空間に無いメンバは E0302"), as the value `Alloc.y` is (R-300): an effect is a
// namespace (§15.1). One error per unit (§18.1), so each form is in its own unit; the places (a branch, a
// closure, a match arm, a `test`, a generic fn) give the same code. The head of a struct literal that is a type
// parameter (`T { x: 1 }`) is in kind_struct_literal_head_type_parameter.onsa.

pub struct P {
  x: I32,
}

impl P {
  pub const N: U32 = 3

  pub fn get(self) -> I32 {
    self.x
  }
}

// ---- The head of a struct literal ----

pub fn const_parameter_as_a_head[const M: U32]() -> I32 {
  let _ = M { x: 1 }                                //~ E0308
  0
}

pub fn associated_constant_as_a_head() -> I32 {
  let _ = F32.PI { x: 1 }                           //~ E0308
  0
}

pub fn integer_constant_as_a_head() -> I32 {
  let _ = I32.BITS { x: 1 }                         //~ E0308
  0
}

pub fn associated_constant_of_the_program_as_a_head() -> I32 {
  let _ = P.N { x: 1 }                              //~ E0308
  0
}

pub fn const_parameter_as_a_head_in_a_branch[const M: U32](flag: Bool) -> I32 {
  if flag {
    let _ = M { x: 1 }                              //~ E0308
    1
  } else {
    0
  }
}

pub fn associated_constant_as_a_head_in_a_closure() -> I32 {
  let f = fn(n: I32) -> I32 {
    let _ = F32.PI { x: n }                         //~ E0308
    n
  }
  f.(1)
}

pub fn associated_constant_as_a_head_in_a_match_arm(n: U32) -> I32 {
  match n {
    0 => 0,
    _ => {
      let _ = F32.PI { x: 1 }                       //~ E0308
      1
    },
  }
}

pub fn associated_constant_as_a_head_in_a_generic_function[T](x: T) -> T {
  let _ = F32.PI { x: 1 }                           //~ E0308
  x
}

test "a constant as the head of a struct literal" {
  let n = F32.PI { x: 1 }                           //~ E0308
  assert 1 == 1
}

// ---- The annotation of a `let` ----

pub fn associated_constant_in_an_annotation() -> I32 {
  let _: F32.PI = 1                                 //~ E0308
  0
}

pub fn method_in_an_annotation() -> I32 {
  let _: Str.len = 1                                //~ E0308
  0
}

pub fn associated_function_in_an_annotation() -> I32 {
  let _: F32.from_bits = 1                          //~ E0308
  0
}

pub fn integer_constant_in_an_annotation() -> I32 {
  let _: I32.BITS = 1                               //~ E0308
  0
}

pub fn max_constant_in_an_annotation() -> I32 {
  let _: U8.MAX = 1                                 //~ E0308
  0
}

pub fn associated_constant_of_the_program_in_an_annotation() -> I32 {
  let _: P.N = 1                                    //~ E0308
  0
}

pub fn method_of_the_program_in_an_annotation() -> I32 {
  let _: P.get = 1                                  //~ E0308
  0
}

pub fn associated_constant_in_a_tuple_annotation() -> I32 {
  let _: (I32, F32.PI) = (1, 2)                     //~ E0308
  0
}

pub fn associated_constant_in_a_cast(n: I32) -> I32 {
  let _ = n as F32.PI                               //~ E0308
  0
}

pub fn associated_constant_in_a_closure_parameter() -> I32 {
  let f = fn(x: F32.PI) -> I32 { 0 }                //~ E0308
  f.(1)
}

pub fn method_in_a_closure_result() -> I32 {
  let f = fn(x: I32) -> Str.len { 0 }               //~ E0308
  f.(1)
}

pub fn associated_constant_in_a_branch(flag: Bool) -> I32 {
  if flag {
    let _: F32.PI = 1                               //~ E0308
    1
  } else {
    0
  }
}

pub fn associated_constant_in_a_generic_function[T](x: T) -> T {
  let _: F32.PI = 1                                 //~ E0308
  x
}

test "a constant as a type in a test" {
  let n: F32.PI = 1                                 //~ E0308
  assert 1 == 1
}

pub fn missing_associated_name_in_an_annotation() -> I32 {
  let _: F32.NOPE = 1                               //~ E0302
  0
}

pub fn missing_method_in_an_annotation() -> I32 {
  let _: Str.zz = 1                                 //~ E0302
  0
}

// ---- A method of a built-in type with a name after it ----

pub fn method_with_a_name_after_it() -> I32 {
  let _ = Str.len.zz                                //~ E0308
  0
}

pub fn method_with_a_name_after_it_called() -> I32 {
  Str.len.zz()                                      //~ E0308
}

pub fn method_with_a_name_after_it_as_an_argument() -> I32 {
  id(Str.len.zz)                                    //~ E0308
}

pub fn method_with_two_names_after_it() -> I32 {
  let _ = Str.len.zz.yy                             //~ E0308
  0
}

pub fn method_of_the_program_with_a_name_after_it() -> I32 {
  let _ = P.get.zz                                  //~ E0308
  0
}

pub fn method_with_a_name_after_it_in_a_closure() -> I32 {
  let f = fn(n: I32) -> I32 {
    let _ = Str.len.zz                              //~ E0308
    n
  }
  f.(1)
}

pub fn method_with_a_name_after_it_in_a_generic_function[T](x: T) -> T {
  let _ = Str.len.zz                                //~ E0308
  x
}

// ---- A member that an effect has not ----

pub fn effect_member_called() -> I32 {
  Alloc.x()                                         //~ E0302
}

pub fn effect_member_called_with_arguments() -> I32 {
  Alloc.x(1, 2)                                     //~ E0302
}

pub fn effect_member_called_in_a_let() -> I32 {
  let _ = Alloc.x()                                 //~ E0302
  0
}

pub fn effect_member_as_a_value() -> I32 {
  let _ = Alloc.y                                   //~ E0302
  0
}

pub fn effect_member_called_in_a_branch(flag: Bool) -> I32 {
  if flag {
    Alloc.x()                                       //~ E0302
  } else {
    0
  }
}

pub fn effect_member_called_in_a_closure() -> I32 {
  let f = fn(n: I32) -> I32 { Alloc.x() }           //~ E0302
  f.(1)
}

pub fn effect_member_called_in_a_generic_function[T](x: T) -> T {
  let _ = Alloc.x()                                 //~ E0302
  x
}

pub fn effect_member_called_in_an_argument() -> I32 {
  id(Alloc.x())                                     //~ E0302
}

pub fn id(x: I32) -> I32 {
  x
}
