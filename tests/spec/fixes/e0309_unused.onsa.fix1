// onsa.toml
// [test]
// spec = ["§5.1", "§18.1"]
// fixes = 1

// E0309: a binding that is never read. The candidate renames it to `_` (§5.1).

pub fn unused_let() -> I32 {
  let _ = 1                                         //~ E0309
  2
}

pub fn unused_in_a_destructuring(pair: (I32, I32)) -> I32 {
  let (l, _) = pair                                 //~ E0309
  l
}

pub fn unused_loop_variable(n: U32) -> U32 {
  var count = 0
  for _ in 0..n {                                   //~ E0309
    count = count + 1
  }
  count
}

pub fn unused_arm_binding(o: Option[I32]) -> I32 {
  match o {
    Some(_) => 0,                                   //~ E0309
    None => 1,
  }
}

pub fn fine(pair: (I32, I32), o: Option[I32]) -> I32 {
  let (l, _) = pair
  let _ = 1
  match o {
    Some(_) => l,
    None => 1,
  }
}
