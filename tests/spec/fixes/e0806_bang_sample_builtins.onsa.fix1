// onsa.toml
// [test]
// spec = ["§2.6", "§11.2", "§11.4", "§18.1"]
// fixes = 1

// W7-04 U1b/t, S-811, S-817, R-285: `sample_rate` and `sample_tick` are the names of flows that are called without `~` (§11.4: "flow の組込み名は
// `prev` `delay` `vdelay` `sample_rate` `sample_tick` だけ", `sample_rate()`), so a call with `!` is E0806 in a flow body (§11.2), and the one
// candidate removes the `!` (§11.2: "`f(x)` で呼ぶ項目なら `!` を消す候補"; the E0812 of `sample_rate~()` also removes the `~`, §2.6). It is not
// the replacement of the whole call (`sample_rate()` keeps its name, S-251). `sample_tick()` is accepted (§11.4, W7-09 U4b), so a unit is clean after
// the candidate; a file has one candidate unit for `clean`, so it is in fixes/e0806_bang_sample_rate_clean.onsa for `sample_rate` and in
// fixes/e0806_bang_sample_tick_clean.onsa for `sample_tick`. One error per flow (P-01).

pub flow rate_in_a_let(x: F32 at sample) -> F32 at sample {
  let r = sample_rate()                            //~ E0806
  x * r
}

pub flow rate_as_an_operand(x: F32 at sample) -> F32 at sample {
  sample_rate() * x                                //~ E0806
}

pub flow rate_in_a_par_body(x: F32 at sample) -> F32 at sample {
  let ys = par i in 0 ..< 2 {
    x * sample_rate()                              //~ E0806
  }
  ys[0] + ys[1]
}

pub flow rate_in_the_arm_of_an_if(x: F32 at sample) -> F32 at sample {
  if x > 0.0 {
    sample_rate()                                  //~ E0806
  } else {
    0.0
  }
}

pub flow tick_in_a_let(x: F32 at sample) -> U32 at sample {
  let t = sample_tick()                            //~ E0806
  t
}

pub flow tick_as_the_output(x: F32 at sample) -> U32 at sample {
  sample_tick()                                    //~ E0806
}

pub flow tick_in_a_par_body(x: F32 at sample) -> F32 at sample {
  let ys = par i in 0 ..< 2 {
    x * (sample_tick() as F32)                     //~ E0806
  }
  ys[0] + ys[1]
}
