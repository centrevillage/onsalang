// onsa.toml
// [test]
// spec = ["§4.5", "§18.1"]
//
// [[test.fix]]
// at = "83:37"
// code = "E0020"
// candidate = 1
// leaves = ["83:55 E0020"]

// S-329 (W5-24 U6a): E0020 for a `[…]` with a `,` after a name in a const argument of a type (§4.5, §18.1), in the shapes
// that tests/spec/fixes/e0020_type_args_square_const_arg.onsa (the places of a heading, one list of two elements) does not
// have: three elements, a type with arguments in the list, a constant expression in the list, the name after an operator,
// before an operator and in parentheses, a const argument that is the first or the second of two, the name of a constant
// with an operator (`TABLE[1, 2] * 2`), and the place of a branch, a closure and a generic function. A const argument is a
// constant expression (§4.5), so the `[…]` is read as in a value: the syntax stage, one error per unit. Only the code and the
// line are asked of the candidates: their number is in the cases of S-333 (type_args_square_candidates_*.onsa, W5-24 U6b).

use std.array

pub struct Rg[T, const N: U32] {
  d: [T; N],
}

impl[T, const N: U32] Rg[T, N] {
  pub const CAP: U32 = 4
}

pub struct Ring[T, const N: U32] {
  d: [T; N],
}

pub struct Mat[T, const R: U32, const C: U32] {
  d: [T; R],
}

pub const TABLE: U32 = 8

pub fn with_three_elements(r: Ring[F32, Rg[F32, 4, 2].CAP]) -> U32 { //~ E0020
  1
}

pub fn with_a_type_in_the_list(r: Ring[F32, Rg[Option[F32], 4].CAP]) -> U32 { //~ E0020
  1
}

pub fn with_an_array_in_the_list(r: Ring[F32, Rg[[F32; 2], 4].CAP]) -> U32 { //~ E0020
  1
}

pub fn with_a_constant_expression_in_the_list(r: Ring[F32, Rg[F32, 2 + 2].CAP]) -> U32 { //~ E0020
  1
}

pub fn after_a_subtraction(r: Ring[F32, 8 - Rg[F32, 4].CAP]) -> U32 { //~ E0020
  1
}

pub fn before_a_remainder(r: Ring[F32, Rg[F32, 4].CAP % 3]) -> U32 { //~ E0020
  1
}

pub fn in_parentheses_with_an_operator(r: Ring[F32, (Rg[F32, 4].CAP + 1) * 2]) -> U32 { //~ E0020
  1
}

pub fn of_a_constant_with_an_operator(r: Ring[F32, TABLE[1, 2] * 2]) -> U32 { //~ E0020
  1
}

pub fn of_a_constant_after_an_operator(r: Ring[F32, 2 + TABLE[1, 2]]) -> U32 { //~ E0020
  1
}

pub fn as_the_first_of_two(m: Mat[F32, Rg[F32, 2].CAP, 3]) -> U32 { //~ E0020
  1
}

pub fn as_the_second_of_two(m: Mat[F32, 2, Rg[F32, 3].CAP]) -> U32 { //~ E0020
  1
}

pub fn as_both_of_two(m: Mat[F32, Rg[F32, 2].CAP, Rg[F32, 3].CAP]) -> U32 { //~ E0020
  1
}

pub fn after_another_type_argument(r: Ring[Option[F32], Rg[F32, 4].CAP]) -> U32 { //~ E0020
  1
}

pub fn in_a_bounded_generic_function[T: Num](r: Ring[T, Rg[F32, 4].CAP]) -> U32 { //~ E0020
  1
}

pub fn in_a_branch(c: Bool) -> U32 {
  if c {
    let r: Ring[F32, Rg[F32, 4].CAP] = Ring { d: [0.0; 4] } //~ E0020
    1
  } else {
    2
  }
}

pub fn in_a_closure() -> [U32; 2] {
  array.from_fn(fn(_) {
    let r: Ring[F32, Rg[F32, 4].CAP] = Ring { d: [0.0; 4] } //~ E0020
    1
  })
}

pub flow in_a_flow(x: Ring[F32, Rg[F32, 4].CAP] at sample) -> F32 at sample { //~ E0020
  0.0
}

pub fn fine(r: Ring[F32, Rg::[F32, 4].CAP]) -> U32 {
  1
}
