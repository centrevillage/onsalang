// onsa.toml
// [test]
// spec = ["§2.5", "§7", "§11.5", "§18.1"]
// fixes = 1
//
// [[test.fix]]
// at = "182:3"
// code = "E0003"
// candidate = 1
// leaves = ["183:3 E0003"]

// The `[[test.fix]]` entries in the header name what a candidate leaves in its unit: a second misplaced
// token, reported by the next check (§18.1, S-236). The `at` and `leaves` positions are those of the spec
// (the misplaced token). The entries were commented out (`// # `) until W3-06/i made the check report
// the diagnostics.
//
// E0003: the `{` of a block that is not on the line of the last token of its head (spec §2.5, S-47, S-202,
// R-62, S-216, R-160). A head is the declaration or the keyword that has the block: `fn`, `flow`, `impl`, a
// method, `test`, `if`, `else`, `while`, `for`, `match`, `par`, an anonymous function; a head that goes on
// over lines (after an operator) ends on its last line, and the `{` is on that line. The main position is the
// `{`, so the marker is on its line, and the candidate moves the `{` (and the rest of its line up to the
// comment) to the end of the line of the head's last token. At the top level and in a block the rule is
// the same, and in the pairs of brackets (the closure in a call) too.

use std.array

pub struct Pt {
  x: I32,
  y: I32,
}

pub fn function_head(x: I32) -> I32
{                                                   //~ E0003
  x
}

pub flow flow_head(x: F32 at sample) -> F32 at sample
{                                                   //~ E0003
  x
}

pub fn generic_head[T: PartialOrd](x: T, lo: T, hi: T) -> T
{                                                   //~ E0003
  if x < lo { lo } else if x > hi { hi } else { x }
}

impl Pt
{                                                   //~ E0003
  pub fn norm1(self) -> I32 {
    self.x + self.y
  }
}

pub struct Wide {
  x: I32,
}

impl Wide {
  pub fn double(self) -> I32
  {                                                 //~ E0003
    self.x * 2
  }
}

test "the brace is on the next line"
{                                                   //~ E0003
  assert 1 == 1
}

pub fn if_head(c: Bool) -> I32 {
  if c
  {                                                 //~ E0003
    1
  } else {
    2
  }
}

pub fn else_head(c: Bool) -> I32 {
  if c {
    1
  } else
  {                                                 //~ E0003
    2
  }
}

pub fn else_if_head(c: Bool, d: Bool) -> I32 {
  if c {
    1
  } else if d
  {                                                 //~ E0003
    2
  } else {
    3
  }
}

pub fn while_head(n: I32) -> I32 {
  var t = 0
  while t < n
  {                                                 //~ E0003
    t = t + 1
  }
  t
}

pub fn for_head(n: U32) -> U32 {
  var t: U32 = 0
  for i in 0..<n
  {                                                 //~ E0003
    t = t + i
  }
  t
}

pub fn match_head(x: I32) -> I32 {
  match x
  {                                                 //~ E0003
    0 => 1,
    _ => 2,
  }
}

pub flow par_head(x: F32 at sample) -> [F32; 4] at sample {
  par i in 0..<4
  {                                                 //~ E0003
    x * i.round_f32()
  }
}

// R-62: the closure's `{` when a line break is a blank (in the brackets of a call).
pub fn closure_head() -> [U32; 3] {
  array.from_fn(fn(i)
    { i })                                          //~ E0003
}

// S-202: a head that goes on over lines ends on its last line, and the `{` is on that line.
pub fn continued_if_head(a: Bool, b: Bool) -> I32 {
  if a &&
    b
  {                                                 //~ E0003
    1
  } else {
    2
  }
}

pub fn continued_while_head(a: Bool, b: Bool) -> I32 {
  while a &&
    b
  {                                                 //~ E0003
    return 1
  }
  0
}

// The `{` of an `if` in a call, and of a `match` in an arm.
pub fn id(x: I32) -> I32 {
  x
}

pub fn if_in_a_call(c: Bool) -> I32 {
  id(if c
     { 1 } else { 2 })                              //~ E0003
}

pub fn match_in_an_arm(c: Bool, x: I32) -> I32 {
  match c {
    true => match x
            { 0 => 1, _ => 2 },                     //~ E0003
    false => 0,
  }
}

// An `else` and a `{` that are both misplaced are two errors, and the unit reports the first one;
// the candidate fixes it, and the second is reported by the next check (the `[[test.fix]]` above).
pub fn two_misplaced(c: Bool) -> I32 {
  if c {
    1
  }
  else                                              //~ E0003
  {
    2
  }
}

pub fn fine(c: Bool, a: Bool, b: Bool) -> I32 {
  let k = if c { 1 } else { 2 }
  let m = if a &&
    b {
    3
  } else {
    4
  }
  k + m
}
