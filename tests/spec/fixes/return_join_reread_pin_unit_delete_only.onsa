// S-876, S-886 (U4b of W5-09; R-388): the joined form `return need_i64(n)` would decide `n` as an `I64` and the later `let k: I32 = n` rejects it (E0401), so the deletion is the one candidate, and the file after it has no diagnostic (`clean`).
// The pin makes a lost candidate a failure.

pub fn need_i64(x: I64) {
}

pub fn join_decides_a_type_that_a_later_let_does_not_accept(c: Bool) {
  let n = 5
  if c {
    return
    need_i64(n)                                     //~ E0503
  }
  let k: I32 = n
  let _ = k
}
