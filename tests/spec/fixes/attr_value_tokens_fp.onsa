// onsa.toml
// [test]
// spec = ["§2.5", "§6.5", "§18.1"]
// fixes = 1

// W5-24 U3a/t, S-834 (spec §6.5: "一覧の値を取る属性（`@repr`・`@fp`・`@host`）と `@export` の括弧の中は、閉じた括弧の中のトークンによらず値として扱い、一覧の値でなければこの E0005
// である"): the value of `@fp` is a word of the list (`relaxed`, §6.5), and any other token or tokens in the parentheses (a keyword,
// a number, a negative number, a character, `()`, an expression, a call, a name) are the E0005 whose one candidate is the value of
// the list, `@fp(relaxed)`, in the place of what is there. A fn and a flow, on the line of the item or on a line of its own, a
// value on lines of its own, and the space after the `@` (§2.5), whose candidate takes the space out with it. One error in each
// declaration unit (P-01).

@fp(true) pub fn u0(x: F32) -> F32 {                //~ E0005
  x * 1.0
}

@fp(1) pub fn u1(x: F32) -> F32 {                   //~ E0005
  x * 2.0
}

@fp(1.5) pub fn u2(x: F32) -> F32 {                 //~ E0005
  x * 3.0
}

@fp(-1) pub fn u3(x: F32) -> F32 {                  //~ E0005
  x * 4.0
}

@fp('c') pub fn u4(x: F32) -> F32 {                 //~ E0005
  x * 5.0
}

@fp(()) pub fn u5(x: F32) -> F32 {                  //~ E0005
  x * 6.0
}

@fp(1 + 2) pub fn u6(x: F32) -> F32 {               //~ E0005
  x * 7.0
}

@fp(f(1)) pub fn u7(x: F32) -> F32 {                //~ E0005
  x * 8.0
}

@fp(x) pub fn u8(x: F32) -> F32 {                   //~ E0005
  x * 9.0
}

@fp(true) pub flow f0(x: F32 at sample) -> F32 at sample {   //~ E0005
  x * 1.0
}

@fp(1 + 2) pub flow f1(x: F32 at sample) -> F32 at sample {   //~ E0005
  x * 2.0
}

@fp(true)                                           //~ E0005
pub fn u20(x: F32) -> F32 {
  x * 21.0
}

@fp(f(1))                                           //~ E0005
pub flow f2(x: F32 at sample) -> F32 at sample {
  x * 3.0
}

@fp(                                                //~ E0005
  true
)
pub fn u30(x: F32) -> F32 {
  x * 3.0
}

@ fp(1) pub fn u21(x: F32) -> F32 {                 //~ E0005
  x * 22.0
}

@fp(relaxed)
pub fn fine(x: F32) -> F32 {
  x * 9.0
}
