// §8.1: no result type, so the candidate inserts the row after the parameters: `fn k(n: U32) uses {Alloc}`.

pub fn mk(n: U32) -> U32 uses {Alloc} { n }

pub fn k(n: U32) uses {Alloc} {
  let _ = mk(n)                                     //~ E0601 @11
}
