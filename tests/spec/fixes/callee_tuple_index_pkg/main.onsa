// onsa.toml
// [test]
// spec = ["§2.4", "§6.1", "§15.1", "§18.1"]
// fixes = 1

// E0020 for a call whose callee ends with a tuple index, when the tuple comes from another module
// (§6.1, S-342, S-606): the field of an imported struct, the result of an imported function called by
// its imported name or by its qualified name, a field of the result of a method of an imported type.
// The syntax alone decides, so the module the names come from changes neither the error nor the one
// candidate (`.(`). The calls with `.(` are the function `fine`. One error per function (P-01).

use shapes
use shapes.{Pair, Rack, make, make_pair}

pub fn field_of_an_imported_struct(p: Pair, x: I32) -> I32 {
  p.t.0(x)                                          //~ E0020
}

pub fn result_of_an_imported_function(x: I32) -> I32 {
  make().0(x)                                       //~ E0020
}

pub fn result_of_a_qualified_function(x: I32) -> I32 {
  shapes.make().0(x)                                //~ E0020
}

pub fn field_of_the_result_of_an_imported_function(x: I32) -> I32 {
  make_pair().t.0(x)                                //~ E0020
}

pub fn field_of_the_result_of_a_qualified_function(x: I32) -> I32 {
  shapes.make_pair().t.0(x)                         //~ E0020
}

pub fn field_of_a_field_of_an_imported_struct(r: Rack, x: I32) -> I32 {
  r.pair.t.0(x)                                     //~ E0020
}

pub fn field_of_the_result_of_an_associated_function(x: I32) -> I32 {
  Rack.new().pair.t.0(x)                            //~ E0020
}

pub fn fine(p: Pair, x: I32) -> I32 {
  p.t.0.(x) + make().0.(x) + shapes.make().0.(x) + make_pair().t.0.(x) + shapes.inc(x)
}
