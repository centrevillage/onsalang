// Types and functions whose tuple elements another module calls (main.onsa).

pub struct Pair {
  t: (fn(I32) -> I32, I32),
}

pub struct Rack {
  pair: Pair,
}

pub fn inc(x: I32) -> I32 {
  x + 1
}

pub fn make() -> (fn(I32) -> I32, I32) {
  (inc, 1)
}

pub fn make_pair() -> Pair {
  Pair { t: make() }
}

impl Rack {
  pub fn new() -> Rack {
    Rack { pair: make_pair() }
  }
}
