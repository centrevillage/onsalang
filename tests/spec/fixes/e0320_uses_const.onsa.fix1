// onsa.toml
// [test]
// spec = ["§2.3", "§4.5", "§2.4", "§18.1"]
// fixes = 1
// [[test.fix]]
// at = "24:7"
// code = "E0320"
// candidate = 1
// clean = true

// W4-04 U9, S-82, R-87 (5): the one candidate of an E0320 on a constant renames the declaration and
// every use of the name in the module, and the file is clean after it (`clean`). The uses are in a
// number in a body, the initializer of another constant, the length of an array in a type and in an
// expression (`[e; N]`), the constant argument of a generic type, the bound of a `for`, the end of the
// head of an `if`, a `while` and a `match`, a hole of an interpolated string (`"{N}"`, §2.4) and a
// `test`. In the heads the new name is written with capital letters before a `{`, which is not a
// struct literal there (a head of a statement takes none outside parentheses, §4.4), so the
// candidate leaves no syntax error. Each use is in a unit of its own that has no other error.

pub struct Ring[T, const N: U32] {
  data: [T; N],
}

const MAX_VOICES: U32 = 8 //~ E0320

const DOUBLE: U32 = MAX_VOICES * 2

pub fn in_a_body(x: U32) -> U32 {
  x + MAX_VOICES
}

pub fn array_length_in_a_type(xs: [F32; MAX_VOICES]) -> [F32; MAX_VOICES] {
  xs
}

pub fn array_length_in_an_expression() -> [F32; 8] {
  [0.0; MAX_VOICES]
}

pub fn constant_argument(r: Ring[F32, MAX_VOICES]) -> Ring[F32, MAX_VOICES] {
  r
}

pub fn for_bound() -> U32 {
  var total = 0
  for i in 0 ..< MAX_VOICES {
    total = total + i
  }
  total
}

pub fn heads_of_statements(n: U32) -> U32 {
  var total = 0
  if n > MAX_VOICES {
    total = total + 1
  }
  while total < MAX_VOICES {
    total = total + 2
  }
  match MAX_VOICES {
    8 => total,
    _ => n,
  }
}

pub fn interpolated() -> Str uses {Alloc} {
  "voices: {MAX_VOICES}"
}

pub fn twice() -> U32 {
  DOUBLE
}

test "a use in a test" {
  assert MAX_VOICES == 8
}
