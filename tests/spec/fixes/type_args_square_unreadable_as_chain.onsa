// onsa.toml
// [test]
// spec = ["§4.5", "§18.1"]
// fixes = 1
//
// [[test.fix]]
// at = "58:5"
// code = "E0020"
// candidate = 1
// leaves = ["58:11 E0011"]
//
// [[test.fix]]
// at = "61:47"
// code = "E0020"
// candidate = 1
// leaves = ["61:53 E0011"]
//
// [[test.fix]]
// at = "65:52"
// code = "E0020"
// candidate = 1
// leaves = ["65:58 E0011"]
//
// [[test.fix]]
// at = "69:66"
// code = "E0020"
// candidate = 1
// leaves = ["69:72 E0011"]

// R-418 (W5-24 U6b): an element that is neither a type nor a constant expression (a chained `as` (E0011 in the index form too)) makes the list
// one that cannot be type arguments, so the candidate `::` is not given: it would only move the error into the list
// (§4.5: "中身が型引数として読めない並び… の候補は `xs["s"][2]` の形だけ"; §18.1: the candidate leaves no error of the stage
// of the diagnostic). The one candidate is the index form. The E0011 of the element is an error the unit had hidden
// behind the E0020, because the syntax stage reports the first error of a unit, so the index form leaves it, and the entries of
// the candidates say so with `leaves` (their positions, after the edit, are written by whoever turns the entries on: the
// position of that error is not given by the spec). The places are a value, the length of an array type, a const argument and
// the length of an array inside a list of type arguments.

pub struct Rg[T, const N: U32] {
  d: [T; N],
}

impl[T, const N: U32] Rg[T, N] {
  pub const CAP: U32 = 4
}

pub struct Ring[T, const N: U32] {
  d: [T; N],
}

pub struct Mat[T, const R: U32, const C: U32] {
  d: [T; R],
}

pub const TABLE: U32 = 8

pub fn in_a_value(c: Bool) -> U32 {
  Rg[F32, 1 as U32 as U32].CAP                     //~ E0020
}

pub fn in_an_array_length(c: Bool, a: [F32; Rg[F32, 1 as U32 as U32].CAP]) -> U32 { //~ E0020
  1
}

pub fn in_a_const_argument(c: Bool, r: Ring[F32, Rg[F32, 1 as U32 as U32].CAP]) -> U32 { //~ E0020
  1
}

pub fn in_a_length_in_a_type_argument(c: Bool, o: Option[[F32; Rg[F32, 1 as U32 as U32].CAP]]) -> U32 { //~ E0020
  1
}
