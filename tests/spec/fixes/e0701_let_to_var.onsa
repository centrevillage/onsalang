// onsa.toml
// [test]
// spec = ["§5.1", "§5.4", "§18.1"]
// fixes = 1

// R-161 (§5.1: "E0701 は宣言を `var` にする"; §18.1: a diagnostic whose fix is one only has it as a candidate): the write to a
// `let` that cannot be changed has one candidate, which turns the `let` into `var`. Every write to the same binding is right
// after it (the unit holds more than one write, and the check of the candidate looks at the whole unit), and the candidate is
// given where the `var` is a binding of the same value: a Copy value, an owned value (the result of a call, a `Buf`), a
// literal that is a borrowed binding only because it needs no drop (`let p = ("a", 1)`), a Copy value that is a borrowed
// binding (`let c = x` of a borrowed `x`), the place of an `inout` argument and the receiver of a `!` call. The cases that get
// no candidate are in negative/e0701_no_let_candidate.onsa. A unit reports its first error, so each function holds writes in
// more than one of the forms; the later ones are what the candidate has to fix as well. One error per function (P-01).

pub struct P {
  x: U32,
  y: U32,
}

impl P {
  pub fn scale(inout self, k: U32) { self.x = self.x * k }
}

pub fn set(inout n: U32) {
  n = 1
}

pub fn copy_value() -> U32 {
  let x = 1
  x = 2                          //~ E0701
  x = x + 1
  set(inout x)
  x
}

pub fn struct_fields() -> U32 {
  let p = P { x: 1, y: 2 }
  p.x = 3                        //~ E0701
  p.scale!(2)
  set(inout p.y)
  p.x + p.y
}

pub fn owned_buf() -> F32 uses {Alloc} {
  let b = Buf.zeroed(4)
  b[0] = 1.0                     //~ E0701
  b.fill!(2.0)
  b[1]
}

pub fn array_of_copy() -> F32 {
  let xs: [F32; 2] = [0.0, 0.0]
  xs[0] = 1.0                    //~ E0701
  xs.fill!(3.0)
  xs[1]
}

pub fn literal_without_drop() -> U32 {
  let p = ("a", 1)
  p.1 = 2                        //~ E0701
  p.1
}

pub fn copy_of_a_borrowed_argument(k: U32) -> U32 {
  let y = k
  y = y + 1                      //~ E0701
  y
}

pub fn inout_argument_first(n: U32) -> U32 {
  let x = n
  set(inout x)                   //~ E0701
  x = x + 1
  x
}

pub fn bang_receiver_first() -> F32 uses {Alloc} {
  let b = Buf.zeroed(2)
  b.fill!(1.0)                   //~ E0701
  b[0] = 2.0
  b[0]
}

pub fn in_a_branch_and_a_loop(c: Bool, n: U32) -> U32 {
  let x = 0
  if c {
    x = 1                        //~ E0701
  }
  for i in 0..<n {
    x = x + i
  }
  x
}

pub fn read_only_is_right() -> U32 {
  let x = 1
  let y = x + 1
  y
}
