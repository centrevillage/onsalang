// onsa.toml
// [test]
// spec = ["§3.4", "§13.4", "§15.1", "§18.1", "§5.2"]
// fixes = 0

// E0413 of a function of `std.math` written with a `!` after the name (§3.4, §5.2, §13.4, §18.1, S-98). The `!`
// marks the call of a method that has an `inout self` (§5.2: `out.fill!(0.0)`), and a function of `std.math` takes
// its argument by value, so the function form of `x.abs!()` or `a.max!(b)` would not be what the writer wrote: no
// candidate is offered (`fixes = 0`), and the diagnostic is the E0413 of the method name alone. The names are
// imported. One error per function (P-01). The function at the end is fine.

use std.math.{abs, max}

pub fn magnitude(x: F32) -> F32 {
  x.abs!()                                          //~ E0413
}

pub fn bigger(a: F32, b: F32) -> F32 {
  a.max!(b)                                         //~ E0413
}

pub fn fine(a: F32, b: F32) -> F32 {
  max(abs(a), b)
}
