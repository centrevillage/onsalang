// onsa.toml
// [test]
// spec = ["§2.4", "§18.1"]
// fixes = 1

// E0020 for the escapes of other languages in every place a string or a character literal can stand (spec
// §2.4, §18.1; S-461, S-965 R1: the reading of a literal does not depend on the place). The forms and the one
// candidate are those of e0020_escape_u4.onsa, e0020_escape_u8.onsa, e0020_escape_x.onsa and
// e0020_escape_control.onsa. The places: an argument, a return, an early return, a field, an element, a tuple,
// a branch, a match arm, a closure body, a block in a block, a generic function, a loop body, a method, a
// `const`, a `test`, a flow, the body of a `par~` and a literal that holds a hole. The functions that follow stand on their own: one error
// per function (P-01).

pub struct Pair {
  a: Str,
  b: Str,
}

fn takes(s: Str, n: I32) -> I32 {
  n
}

pub fn in_an_argument() -> I32 {
  takes("\u0041", 1)                                //~ E0020
}

pub fn in_a_return() -> Str {
  "\U0001F600"                                      //~ E0020
}

pub fn in_an_early_return(flag: Bool) -> Str {
  if flag {
    return "\x41"                                   //~ E0020
  }
  "a"
}

pub fn in_a_field() -> Pair {
  Pair { a: "a", b: "\u0041" }                      //~ E0020
}

pub fn in_an_array() -> [Str; 2] {
  ["a", "\x41"]                                     //~ E0020
}

pub fn in_a_tuple() -> (Str, I32) {
  ("\f", 2)                                         //~ E0020
}

pub fn in_a_character_tuple() -> (Char, Char) {
  ('a', '\x41')                                     //~ E0020
}

pub fn in_a_branch(flag: Bool) -> Str {
  if flag { "a" } else { "\u0041" }                 //~ E0020
}

pub fn in_a_match_arm(n: I32) -> Str {
  match n {
    0 => "\b",                                      //~ E0020
    _ => "a",
  }
}

pub fn in_a_closure_body() -> I32 {
  let f = fn(n: I32) -> Str { "\x41" }              //~ E0020
  1
}

pub fn in_a_block_in_a_block() -> Str {
  let r: Str = {
    let s: Str = {
      "\u0041"                                      //~ E0020
    }
    s
  }
  r
}

pub fn in_a_generic_function[T](x: T) -> Str {
  let s = "\v"                                      //~ E0020
  s
}

pub fn in_a_loop_body(n: I32) -> I32 {
  var m: I32 = 0
  for i in 0..<n {
    let s = "\x41"                                  //~ E0020
    m = m + i
  }
  m
}

pub struct Label {
  text: Str,
}

impl Label {
  pub fn marker(self) -> Str {
    "\U0001F600"                                    //~ E0020
  }
}

pub const MARK: Str = "\u0041"                      //~ E0020

pub const MARK_CHAR: Char = '\x41'                  //~ E0020

pub fn with_a_hole(x: U32) -> Str uses {Alloc} {
  "x = {x} \x41"                                    //~ E0020
}

test "a form of another language in a test body" {
  let s = "\u0041"                                  //~ E0020
}

pub flow in_a_flow(x: F32 at sample) -> F32 at sample {
  let s = "\x41"                                    //~ E0020
  x
}

pub flow in_a_par_body(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<2 {
    let s = "\f"                                    //~ E0020
    x
  }
  ys[0]
}

// The right forms.
pub fn fine() -> (Str, Char) {
  ("\u{41}", '\u{41}')
}
