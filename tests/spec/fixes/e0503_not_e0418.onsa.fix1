// onsa.toml
// [test]
// spec = ["§6.1", "§7", "§18.1"]
// fixes = 1

// S-128 with S-127 (§6.1, §7): "ブロックの途中の文に書いた式は、文の時点で型が `()` と決まっていなければ E0418（発散する式は除く、§7）".
// A diverging expression in the middle of a block (`panic("a")`, a block that returns, an `if` and a `match` whose branches and
// arms all diverge, a `while true`) is not a value that is dropped: it is not E0418. The statement after it is E0503, which is the one
// error of the function, and its candidate deletes the unreachable items. The lines of the diverging expressions have no marker (E0418
// would be on them), and the marker is on the first line after. The value is not of the type `()` here (`panic("a")` is any type), so
// the check is that the rule of the value left in a statement does not fire. One error per function (P-01).

fn g(n: I32) {
}

pub fn panic_then_statement(x: I32) -> I32 {
  panic("a")
  
}

pub fn panic_then_last_expression(x: I32) -> I32 {
  panic("a")
                                               //~ E0503
}

pub fn panic_in_the_middle(x: I32) -> I32 {
  let y = x * 2
  g(y)
  panic("a")
                                               //~ E0503
}

pub fn panic_then_a_minus(a: I32, b: I32) -> I32 {
  panic("a")
                                                  //~ E0503
}

pub fn block_that_returns_then_last_expression(x: I32) -> I32 {
  { return x }
                                               //~ E0503
}

pub fn if_that_returns_then_last_expression(c: Bool, x: I32) -> I32 {
  if c { return 1 } else { panic("a") }
                                               //~ E0503
}

pub fn match_that_returns_then_last_expression(o: Option[I32], x: I32) -> I32 {
  match o {
    Some(v) => { return v },
    None => panic("a"),
  }
                                               //~ E0503
}

pub fn while_true_then_last_expression(x: I32) -> I32 {
  while true {}
                                               //~ E0503
}

pub fn panic_in_a_unit_function(x: I32) {
  panic("a")
                                           //~ E0503
}

pub fn panic_in_a_branch(c: Bool, x: I32) -> I32 {
  if c {
    panic("a")
                                                   //~ E0503
  } else {
    x + 1
  }
}

pub fn panic_in_an_anonymous_function(x: I32) -> I32 {
  let f = fn(a: I32) -> I32 {
    panic("a")
                                               //~ E0503
  }
  f.(x)
}

test "panic then a statement in a test" {
  panic("a")
                                       //~ E0503
}
