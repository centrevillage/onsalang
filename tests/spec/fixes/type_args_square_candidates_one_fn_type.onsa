// onsa.toml
// [test]
// spec = ["§4.5", "§18.1"]
// fixes = 1

// S-333 (W5-24 U6b): a list with an element that is a function type (`g[fn(I32) -> I32, I32](h, x)`) reads as type arguments, but
// the candidate of the multi-dimensional index is not given: the `fn(I32) -> I32` of the index form `g[fn(I32) -> I32][I32]`
// is no expression and leaves an error of the syntax stage (§18.1: the candidate leaves no error of the stage of the
// diagnostic). The one candidate is `::` (§4.5, §18.1). The places are a value, the length of an array type, a const argument,
// the length of an array inside a list of type arguments, a method, and the function type as the first and as a later
// element.

pub struct Rg[T, const N: U32] {
  d: [T; N],
}

impl[T, const N: U32] Rg[T, N] {
  pub const CAP: U32 = 4
}

pub struct Ring[T, const N: U32] {
  d: [T; N],
}

pub struct Mat[T, const R: U32, const C: U32] {
  d: [T; R],
}

pub const TABLE: U32 = 8

pub fn in_a_value(h: fn(I32) -> I32, x: I32) -> I32 {
  g[fn(I32) -> I32, I32](h, x)                      //~ E0020
}

pub fn as_a_later_element(h: fn(I32) -> I32, x: I32) -> I32 {
  g[I32, fn(I32) -> I32](x, h)                      //~ E0020
}

pub fn of_a_method(v: V, h: fn(I32) -> I32, x: I32) -> I32 {
  v.m[fn(I32) -> I32, I32](h, x)                    //~ E0020
}

pub fn of_an_associated_constant() -> U32 {
  Rg[fn(F32) -> F32, 4].CAP                         //~ E0020
}

pub fn with_a_result_type(h: fn(I32) -> Option[I32], x: I32) -> I32 {
  g[fn(I32) -> Option[I32], Option[I32]](h, x)      //~ E0020
}

pub fn in_an_array_length(a: [F32; Rg[fn(F32) -> F32, 4].CAP]) -> U32 { //~ E0020
  1
}

pub fn in_a_const_argument(r: Ring[F32, Rg[fn(F32) -> F32, 4].CAP]) -> U32 { //~ E0020
  1
}

pub fn in_a_length_in_a_type_argument(o: Option[[F32; Rg[fn(F32) -> F32, 4].CAP]]) -> U32 { //~ E0020
  1
}
