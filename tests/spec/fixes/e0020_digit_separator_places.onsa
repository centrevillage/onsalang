// onsa.toml
// [test]
// spec = ["§2.4", "§18.1", "§7"]
// fixes = 1

// E0020 for the digit separator of C++14 in every place a number can be written (spec §2.4, §18.1; S-476,
// S-965 R4: the reading of a number token does not depend on the place). The token, the code and the one
// candidate (every `'` of the token replaced with `_`) are those of e0020_digit_separator.onsa. The places: an
// argument, a return, an early return, a field, an element, a tuple, an operand, a comparison, a pattern, an
// arm, a branch, a closure body, a block in a block, a generic function, the header of `for` and of `par~`, a
// flow, a `const`, the count of a repeated element, the length of an array type and an argument of `@param`.
// The position of a constant type argument (`S[1'000]`) is in e0020_digit_separator_const_arg.onsa. One error
// per declaration (P-01).

pub struct Pair {
  a: I32,
  b: I32,
}

fn takes(x: I32) -> I32 {
  x
}

pub fn in_an_argument() -> I32 {
  takes(1'000)                                      //~ E0020
}

pub fn in_a_return() -> I32 {
  1'000                                             //~ E0020
}

pub fn in_an_early_return(flag: Bool) -> I32 {
  if flag {
    return 1'000                                    //~ E0020
  }
  0
}

pub fn in_a_field() -> Pair {
  Pair { a: 1, b: 1'000 }                           //~ E0020
}

pub fn in_an_array() -> [I32; 2] {
  [1, 1'000]                                        //~ E0020
}

pub fn in_a_tuple() -> (I32, I32) {
  (0xFF'FF, 2)                                      //~ E0020
}

pub fn as_an_operand(x: I32) -> I32 {
  x + 1'000                                         //~ E0020
}

pub fn in_a_comparison(x: I32) -> Bool {
  x < 1'000                                         //~ E0020
}

pub fn in_a_pattern(x: I32) -> I32 {
  match x {
    1'000 => 1,                                     //~ E0020
    _ => 0,
  }
}

pub fn in_a_hexadecimal_pattern(x: U32) -> I32 {
  match x {
    0xFF'FF => 1,                                   //~ E0020
    _ => 0,
  }
}

pub fn in_an_arm(x: I32) -> I32 {
  match x {
    0 => 1'000,                                     //~ E0020
    _ => 0,
  }
}

pub fn in_a_branch(flag: Bool) -> I32 {
  if flag { 1 } else { 1'000 }                      //~ E0020
}

pub fn in_a_closure_body() -> I32 {
  let f = fn(y: I32) -> I32 { 1'000 }               //~ E0020
  f.(1)
}

pub fn in_a_block_in_a_block() -> I32 {
  let r: I32 = {
    let s: I32 = {
      1'000                                         //~ E0020
    }
    s
  }
  r
}

pub fn in_a_generic_function[T](x: T) -> T {
  let _: I32 = 1'000                                //~ E0020
  x
}

pub fn in_a_for_header() -> I32 {
  var s: I32 = 0
  for i in 0..<1'000 {                              //~ E0020
    s = s + i
  }
  s
}

pub flow in_a_par_header(x: F32 at sample) -> [F32; 40] at sample {
  par~ i in 0..<4'0 {                               //~ E0020
    x * F32.round_from(i)
  }
}

pub flow in_a_flow(x: F32 at sample) -> F32 at sample {
  x * 1'000.5                                       //~ E0020
}

const IN_A_CONST: I32 = 1'000                       //~ E0020

pub fn in_a_repeated_element() -> [I32; 1000] {
  let a: [I32; 1000] = [0; 1'000]                   //~ E0020
  a
}

pub fn in_an_array_length(a: [I32; 1'000]) -> I32 {  //~ E0020
  1
}

pub flow in_a_param(
  x: F32 at sample,
  @param(min: 0.0, max: 1'000.5, default: 1.0)      //~ E0020
  level: F32 at block,
) -> F32 at sample {
  x * level
}

// The right forms.
pub fn fine(x: I32) -> I32 {
  takes(1_000) + x
}
