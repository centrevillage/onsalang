// onsa.toml
// [test]
// spec = ["§2.5", "§3.1", "§18.1"]
// fixes = 1

// R-445 (W5-13 U7d): the scans of the chain that a moved operator joins (§3.1, §18.1) read a block-like
// operand whole, from its keyword (S-537), know the ends of a chain at a `:` of a field, after `assert`
// and a range's marks, and the `{` of the body of the head it is in, so these candidates are kept.
// Past the keyword of a block-like operand its operand ends: the `if` of a guard before it ends the chain.

pub struct P {
  x: I32,
}

pub fn after_an_if(c: Bool, a: I32, b: I32) -> I32 {
  if c { a } else { b }
  * b                                               //~ E0020
}

pub fn after_a_match(a: I32, b: I32) -> I32 {
  match a { _ => b }
  + b                                               //~ E0020
}

pub fn after_an_anonymous_function(a: I32, b: I32) -> I32 {
  fn(x: I32) -> I32 { x }.(a)
  % b                                               //~ E0020
}

pub fn before_an_if(c: Bool, a: I32, b: I32) -> I32 {
  a + b
  * if c { a } else { b }                           //~ E0020
}

pub fn in_a_field(a: I32, b: I32) -> I32 {
  let q = P { x: a
    * b }                                           //~ E0020
  q.x
}

pub fn in_an_assertion(a: I32, b: I32) -> I32 {
  assert a < b
    + b                                             //~ E0020
  a
}

pub fn in_a_head(c: Bool, a: I32, b: I32) -> I32 {
  if a < b
    * b {                                           //~ E0020
    a
  } else {
    b
  }
}

pub fn after_a_range(a: I32, b: I32) -> I32 {
  var s = 0
  for i in 0 ..< a
    * b {                                           //~ E0020
    s = i
  }
  s
}

pub fn in_a_guard_after_a_match(a: I32, b: I32) -> I32 {
  match a {
    x if match a { _ => b }
    * b > x => 1,                                   //~ E0020
    _ => 0,
  }
}

pub fn in_a_guard_after_an_anonymous_function(a: I32, b: I32) -> I32 {
  match a {
    x if fn(y: I32) -> I32 { y }.(a)
    % b > x => 1,                                   //~ E0020
    _ => 0,
  }
}

pub fn in_a_guard_after_a_struct_literal(a: I32, b: I32) -> I32 {
  match a {
    x if P { x: a }.x
    * b > x => 1,                                   //~ E0020
    _ => 0,
  }
}
