// onsa.toml
// [test]
// spec = ["§2.4", "§2.6", "§11.2", "§11.4", "§18.1"]
// fixes = 1

// The FAUST forms of the table in §18.1 (spec/foreign-forms.toml; S-48, R-59, S-466). E0020, with the Onsa form as the
// one candidate, for: `~ _` after a `let` name (the candidate is `prev~(^y)` for the name `y`), a prefix `~` that touches its
// operand (`!` for it), and `x@N` (`prev~(x)` for 1, `delay~(x, N)` for a literal of 2 or more and for an UPPER_SNAKE
// name). E0002 with no candidate for: a `~ _` with no `let` name, `x@k` with a name that is not a constant, the FAUST
// composition operators, and `x'`: a `'` that touches a name starts a character literal, and the form is the
// `string_prefix` E0002 of §2.4 (the `prev~(x)` is in the note, which is not compared; S-466). One error in each unit.

const N: U32 = 4

pub flow feedback(x: F32 at sample) -> F32 at sample {
  let y = x + prev~(^y)                                   //~ E0020
  y
}

pub fn bit_not(m: U32) -> U32 {
  let n = !m                                        //~ E0020
  n
}

pub flow apostrophe(x: F32 at sample) -> F32 at sample {
  let a = x'                                        //~ E0002
  a
}

pub flow delay_one(x: F32 at sample) -> F32 at sample {
  let a = prev~(x)                                       //~ E0020
  a
}

pub flow delay_two(x: F32 at sample) -> F32 at sample {
  let a = delay~(x, 2)                                       //~ E0020
  a
}

pub flow delay_literal(x: F32 at sample) -> F32 at sample {
  let a = delay~(x, 480)                                     //~ E0020
  a
}

pub flow delay_constant(x: F32 at sample) -> F32 at sample {
  let a = delay~(x, N)                                       //~ E0020
  a
}

pub flow delay_variable(x: F32 at sample, k: U32 at init) -> F32 at sample {
  let a = x@k                                       //~ E0002
  a
}

pub flow feedback_without_a_name(x: F32 at sample) -> F32 at sample {
  x + ~ _                                           //~ E0002
}

pub flow serial(x: F32 at sample) -> F32 at sample {
  let a = x : x                                     //~ E0002
  a
}

pub flow split(x: F32 at sample) -> F32 at sample {
  let a = x <: x                                    //~ E0002
  a
}

pub flow merge(x: F32 at sample) -> F32 at sample {
  let a = x :> x                                    //~ E0002
  a
}

pub flow fine(x: F32 at sample) -> F32 at sample {
  let a = x + prev~(^a)
  let b = prev~(x)
  let c = delay~(x, 2)
  a + b + c
}
