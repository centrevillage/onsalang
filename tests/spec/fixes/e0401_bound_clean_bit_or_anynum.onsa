// E0401 for `a | b` where `T: AnyNum` (§6.3: the bit operators are `Int`, so `T: AnyNum` becomes `T: Int`, which
// contains `AnyNum`). The one candidate replaces the bound; no diagnostic is left after it.

pub fn merge[T: AnyNum](a: T, b: T) -> T {
  a | b                                             //~ E0401
}
