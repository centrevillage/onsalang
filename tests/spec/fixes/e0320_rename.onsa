// onsa.toml
// [test]
// spec = ["§2.3", "§18.1"]
// fixes = 1

// E0320: a name against the naming rules. The one candidate changes the declaration and every use
// of the name in the package (§2.3, S-82), so the fixed file has no E0302 left over.

pub fn BadFn() -> I32 {                             //~ E0320
  1
}

pub fn calls_bad_fn() -> I32 {
  BadFn() + BadFn()
}

pub struct bad_type {                               //~ E0320
  x: F32,
}

pub fn pass_bad_type(b: bad_type) -> bad_type {
  b
}

pub fn read_bad_type(b: bad_type) -> F32 {
  b.x
}

pub enum Shape {
  circle(F32),                                      //~ E0320
  Square(F32),
}

pub fn unit_circle() -> Shape {
  Shape.circle(1.0)
}

pub fn area(s: Shape) -> F32 {
  match s {
    Shape.circle(r) => r * r,
    Shape.Square(a) => a * a,
  }
}

const max_voices: U32 = 8                           //~ E0320

pub fn voices() -> U32 {
  max_voices * 2
}

pub fn camel_parameter(someValue: I32) -> I32 {     //~ E0320
  someValue * 2
}

pub fn capitalized_var() -> I32 {
  var Count = 0                                     //~ E0320
  Count = Count + 1
  Count
}

pub fn double__underscore() -> I32 {                //~ E0320
  1
}

pub fn calls_double_underscore() -> I32 {
  double__underscore()
}
