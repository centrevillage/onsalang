// onsa.toml
// [test]
// spec = ["§2.5", "§15.1", "§18.1"]
// fixes = 1

// S-963 (W5-11 U10i/t, §2.5, §15.1, the row `path_separator` of spec/foreign-forms.toml): a line break after the `::` of
// a path (`F32::` and then `PI` on the next line) is the E0020 of the row `path_separator`, inside the brackets as well, with
// a comment line, a line comment or a blank line between. The one candidate writes the `::` as a `.` and moves it to the
// line of the name after it (`F32` and then `.PI`), as the candidate of a `.` at the end of a line does (S-353); the
// line that begins with a `.` goes on with the line before. The path with more than one `::` is one error with one
// candidate (`std::math::` and then `sqrt(2.0)`). The marker is on the line of the first `::`. The `::` that begins a line is
// not this rule: gap_path_line_start.onsa. One error per declaration unit (P-01).

use std::   //~ E0020
  math

pub fn two(a: F32, b: F32) -> F32 {
  a + b
}

pub fn a_line_break() -> F32 {
  F32::   //~ E0020
    PI
}

pub fn a_comment_line() -> F32 {
  F32::   //~ E0020
    // pi
    PI
}

pub fn a_blank_line() -> F32 {
  F32::   //~ E0020

    PI
}

pub fn a_space_before() -> F32 {
  F32 ::   //~ E0020
    PI
}

pub fn a_path_of_two() -> F32 {
  std::math::   //~ E0020
    sqrt(2.0)
}

pub fn the_first_of_two() -> F32 {
  std::   //~ E0020
    math::sqrt(2.0)
}

pub fn in_a_call() -> F32 {
  two(F32::   //~ E0020
    PI, 1.0)
}

pub fn in_an_array() -> [F32; 2] {
  [F32::   //~ E0020
    PI, 1.0]
}

pub fn in_a_pattern(x: I32) -> I32 {
  match x {
    I32::   //~ E0020
      MAX => 1,
    _ => 0,
  }
}

pub flow in_a_flow(x: F32 at sample) -> F32 at sample {
  let y = x + F32::   //~ E0020
    PI
  y
}

pub flow in_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<2 {
    x + F32::   //~ E0020
      PI
  }
  ys[0]
}
