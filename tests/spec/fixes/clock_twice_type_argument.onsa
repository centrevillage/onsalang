// onsa.toml
// [test]
// spec = ["§11.3", "§18.1"]
// fixes = 1
//
// [[test.fix]]
// at = "31:48"
// code = "E0020"
// candidate = 1
// leaves = ["31:48 E0020"]
//
// [[test.fix]]
// at = "36:21"
// code = "E0020"
// candidate = 1
// leaves = ["36:21 E0020"]
//
// [[test.fix]]
// at = "40:54"
// code = "E0020"
// candidate = 1
// leaves = ["40:54 E0020"]

// Two `at` after one type (spec §11.3, §18.1; S-382): the first is the form of E0020, so it is the one that is
// reported, with its candidate, by the rule of §18.1 that of the remaining diagnostics the first by position is
// reported (the second `at` is not E0002 hiding the first). Each unit has one error (P-01). The candidate takes the
// first clock away, so the second is still there and is reported by the next check (`leaves`, at its place after
// the first `at sample` is gone). The entries assume that the main position is the `at` token.
// The type argument of a parameter, of a `let`, and of the output of a `fn`.

pub fn two_clocks_in_a_parameter(x: Option[F32 at sample at block]) -> I32 {  //~ E0020
  1
}

pub fn two_clocks_in_a_let_type(x: Option[F32]) -> I32 {
  let y: Option[F32 at sample at block] = x         //~ E0020
  1
}

pub fn two_clocks_in_an_output(x: F32) -> Option[F32 at sample at block] {  //~ E0020
  None
}
