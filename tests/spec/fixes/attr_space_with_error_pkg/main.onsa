// onsa.toml
// [test]
// spec = ["§2.5", "§6.5", "§15.1", "§18.1"]
// fixes = 1

// S-959 (W5-11 U10d2/t2, §2.5, §6.5): an attribute with a space after the `@` and an error of its own reports its own error in
// each module of a package, and the candidates are applied in each file. This module has a value error (E0005, with
// a candidate) and the E0020 of the space alone, and util.onsa has an old form (E0020, with a candidate) and an E0005
// without a candidate. One error per declaration unit (P-01).

use util.{Frame, scale}

@ fp(fast)   //~ E0005
pub fn a_function_of_this_module(x: F32) -> F32 {
  scale(x)
}

@ fp(relaxed)   //~ E0020
pub fn the_space_alone(x: F32) -> F32 {
  x
}

pub fn uses_the_imported_ones(f: Frame) -> I32 {
  f.x
}
