// onsa.toml
// [test]
// spec = ["§18.1", "§15.1", "§11.2"]
// fixes = 1

// The names of the module util whose heads have an error (`pub(crate)`, `pub (pkg)`, `const fn`,
// `export`, `priv pub`, `pub(super)`; every one is one error in util.onsa) are names for the
// module that brings them in with `use`: the `use` and the places that use the names get no
// E0302 (§18.1, S-435, S-459, S-464), and no E0303, because the visibility of a declaration that
// was read on is the default, which is the package (§15.1: an unspecified visibility is
// visible in the package). What was read is checked here: a call with too many arguments, a
// field that is not there. A real error of this module is still reported. (That an unspecified
// visibility is the package is W4-03, so this case holds until then.)

use util.{from_crate, Pt, lp, constant, exported, both, narrower}

pub fn run(p: Pt) -> I32 {
  from_crate(p.x) + constant(2) + exported(3) + both(4) + narrower()
}

pub flow main(x: F32 at sample) -> F32 at sample {
  lp~(x)
}

fn nested(c: Bool, p: Pt) -> I32 {
  let f = fn(x: I32) -> I32 { from_crate(x) + constant(x) }
  if c { f.(p.x) } else { exported(both(narrower())) }
}

fn too_many_arguments() -> I32 {
  exported(1, 2)                                    //~ E0412
}

fn no_such_field(p: Pt) -> I32 {
  p.zz                                              //~ E0413
}

fn own_error() -> I32 {
  from_crate(1) + zz                                //~ E0302 @19
}
