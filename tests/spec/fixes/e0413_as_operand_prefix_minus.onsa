// onsa.toml
// [test]
// spec = ["§3.1", "§3.3", "§18.1"]
// fixes = 1

// E0413 for a conversion function of a pair that `as` can write (§3.3), as the operand of a prefix `-`. A prefix `-`
// binds stronger than `as` (`-x as F64` is `(-x) as F64`, §3.1), so the candidate for `-F64.round_from(x)` is
// `-(x as F64)`, not `-x as F64` (R-239). Most functions have an unsigned source, which has no unary `-` (§3.4), so
// the wrong candidate leaves an E0401 and the runner rejects it. `signed_widened` cannot show the difference by an
// error (the two readings give the same value); its copy (.fix1) is the check. `signed_receiver` is the call to the
// same type, where the call is removed and the candidate is `-x`. One error in each function (P-01).

pub fn twice(v: F64) -> F64 {
  v + v
}

pub fn negated(x: U8) -> F64 {
  -F64.round_from(x)                                //~ E0413
}

pub fn negated_single(x: U16) -> F32 {
  -F32.round_from(x)                                //~ E0413
}

pub fn negated_in_a_sum(x: U8, a: F64) -> F64 {
  -F64.round_from(x) + a                            //~ E0413
}

pub fn negated_right_of_a_product(x: U8, a: F64) -> F64 {
  a * -F64.round_from(x)                            //~ E0413
}

pub fn negated_in_a_let(x: U8) -> F64 {
  let n = -F64.round_from(x)                        //~ E0413
  n
}

pub fn negated_in_an_argument(x: U8) -> F64 {
  twice(-F64.round_from(x))                         //~ E0413
}

pub fn negated_in_a_comparison(x: U8, a: F64) -> Bool {
  -F64.round_from(x) < a                            //~ E0413
}

pub fn negated_in_parentheses(x: U8) -> U64 {
  (-F64.round_from(x)).to_bits()                    //~ E0413
}

pub fn signed_receiver(x: F32) -> F32 {
  -F32.round_from(x)                                //~ E0413
}

pub fn signed_widened(x: I16) -> F32 {
  -F32.round_from(x)                                //~ E0413
}
