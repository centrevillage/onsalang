// onsa.toml
// [test]
// spec = ["§2.3", "§6.1", "§18.1"]
// fixes = 1

// E0020 for a call whose callee ends with a tuple index, whatever stands before the index (§6.1,
// S-342, S-606): a tuple index is no name (§2.3), so the callee is a value and the form is decided
// by the syntax alone, before any name is looked up and before any type is known. A name that is
// not defined, an item, a type, a binding that is no tuple, a name from the prelude: each gets the
// same error and the same one candidate (`.(`) as a parameter that is a tuple of function values
// (e0020_callee_tuple_index.onsa), and no error of the names or the types stage shows up in these
// functions. One error per function (P-01).

pub fn inc(x: I32) -> I32 {
  x + 1
}

pub struct Pt {
  x: I32,
}

pub fn a_name_that_is_not_defined(x: I32) -> I32 {
  nope.0.(x)                                         //~ E0020
}

pub fn a_path_that_is_not_defined(x: I32) -> I32 {
  nope.a.b.0.(x)                                     //~ E0020
}

pub fn a_path_of_modules_that_is_not_defined(x: I32) -> I32 {
  nope.sub.table.0.(x)                               //~ E0020
}

pub fn an_item(x: I32) -> I32 {
  inc.0.(x)                                          //~ E0020
}

pub fn a_type(x: I32) -> I32 {
  Pt.0.(x)                                           //~ E0020
}

pub fn a_binding_that_is_no_tuple(x: I32) -> I32 {
  let n = 5
  n.0.(x)                                            //~ E0020
}

pub fn a_parameter_that_is_no_tuple(n: I32, x: I32) -> I32 {
  n.1.(x)                                            //~ E0020
}

pub fn an_index_beyond_the_tuple(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  t.5.(x)                                            //~ E0020
}

pub fn a_variant_of_the_prelude(x: I32) -> I32 {
  None.0.(x)                                         //~ E0020
}

pub fn the_value_of_a_call_that_is_not_defined(x: I32) -> I32 {
  nope().0.(x)                                       //~ E0020
}

pub fn in_a_let(x: I32) -> I32 {
  let y = nope.0.(x)                                 //~ E0020
  y
}

pub fn fine(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  t.0.(x)
}
