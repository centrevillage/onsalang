// W5-10 U3a (R-179): A generic function taken as a value and not called, `let f = ops[I32]`, is the E0020 of the names stage (R-179).
// The one candidate puts `::` before the `[` and leaves nothing behind (`clean`, S-253): the check reads the file after the
// edit without a report. The main position is the `[` of the form (§18.1: "E0020 の主の範囲は外来の形の範囲 … `<T>` は `<` から `>` まで").
// A file with one error, so that `clean` looks at the whole file.

pub fn ops[T](x: T) -> T {
  x
}

pub fn f() -> I32 {
  let g = ops[I32]                                  //~ E0020
  g.(1)
}
