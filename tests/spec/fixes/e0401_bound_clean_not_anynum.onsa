// E0401 for `!x` where `T: AnyNum` (§6.3: `!` is `Int`, so `T: AnyNum` becomes `T: Int`). The one candidate replaces
// the bound; no diagnostic is left after it.

pub fn invert[T: AnyNum](x: T) -> T {
  !x                                                //~ E0401
}
