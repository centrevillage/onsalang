// onsa.toml
// [test]
// spec = ["§4.4", "§18.1"]
// fixes = 1

// E0020 for a struct written with a tuple of one element (`struct Hz(F32)`, a newtype; spec §4.4, §18.1, S-39,
// R-51; the row `tuple_struct` of docs/foreign-forms.toml). There is no tuple struct in Onsa: a type that is to
// be told from its content is a struct with one named field (`pub struct Q { priv value: F32 }`, made by
// `Q.new(x)`, §15.1). The candidate is a struct with one field named `value`, `priv` as in that form, but in a
// `priv struct`, where `priv` is redundant (§15.1, S-494); the visibility word and the type parameters stay where
// they are. A tuple of two elements or more has no candidate
// (negative/tuple_struct_many.onsa). The main position is not in the spec, so it is not pinned here. The
// fields that were not read are a wrong type for the code that uses the type (§18.1), so the functions that
// use it below have no diagnostic. One error in each declaration unit (P-01).

pub struct Hz {
  priv value: F32,
}                                  //~ E0020

struct Gain {
  priv value: F32,
}                                  //~ E0020

priv struct Level {
  value: I32,
}                                  //~ E0020

pub struct Wrap[T] {
  priv value: T,
}                               //~ E0020

pub struct Flag {
  priv value: Bool,
}                               //~ E0020

pub fn takes(h: Hz) -> Hz {
  h
}

pub fn gain_of(g: Gain) -> Gain {
  g
}

pub struct Named {
  value: F32,
}
