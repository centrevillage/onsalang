// onsa.toml
// [test]
// spec = ["§5.2", "§18.1"]
// fixes = 1
// [[test.fix]]
// at = "17:14"
// code = "E0711"
// candidate = 1
// clean = true

// R-198, S-605, S-807 (§5.2): the heading of a `match` is a consuming position, so the `if` that has the `move` on the whole is an E0711 at the operand of the `move`, and the one candidate removes
// it and puts a `move` on the end of each arm that is an owned Affine place, which makes the binding of the arm own the payload. After it the file has no diagnostic.

pub fn eat(move b: Buf[F32]) uses {Alloc} {}

pub fn match_head_if(c: Bool, move a: Option[Buf[F32]], move b: Option[Buf[F32]]) uses {Alloc} {
  match move if c { a } else { b } { //~ E0711
    Some(x) => eat(move x),
    None => {},
  }
}
