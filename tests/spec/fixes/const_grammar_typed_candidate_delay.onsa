// onsa.toml
// [test]
// spec = ["§4.5", "§4.1"]
// fixes = 1
//
// [[test.fix]]
// at = "19:13"
// code = "E0401"
// candidate = 1
// clean = true

// W5-16 U1b/t, R-61, S-50: a constant that is not of the type `U32` (the length of a delay line) is E0401, and the candidate is to make the type of the constant
// `U32` (§4.5: "期待型でない定数は E0401 で、修正候補は定数の型を `U32` にすること"). The candidate leaves no error in the file (`clean`). A file with one
// unit, so that `clean` looks at the whole file. The leaf is judged by its type, wherever the constant is written (const_grammar_typed.onsa).

const WIDTH: I64 = 4

pub flow width_as_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, WIDTH)   //~ E0401
}
