// onsa.toml
// [test]
// spec = ["§2.6", "§11.5", "§18.1"]
//
// [[test.fix]]
// at = "16:8"
// code = "E0812"
// candidate = 1
// clean = true

// W7-06 U3a/t, S-110, S-1177 (§11.5: "状態を持つものを枝に含まなければ E0812（修正候補は `~` を外すこと）"; §2.6): a `match~` whose arms hold only a `par` (no state: a `par` is
// not a thing with state, §11.5, S-1177). The removal of the `~` leaves a plain `match` with the `par` in its arms, which is no error (a `par` without state may stand
// in an arm, and it is evaluated when the arm is taken). The main position (`at`) is the `~` (S-392, provisional). One error per flow (P-01).

pub flow par_only(x: F32 at sample, k: U32 at sample) -> [F32; 2] at sample {
  match~ k { 0 => par i in 0 ..< 2 { x * F32.round_from(i) }, _ => [x, x] } //~ E0812
}
