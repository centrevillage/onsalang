// S-876 (U4b of W5-09; R-387): the `break` in the unreachable arm of a `for` body. Both candidates are made, and the file after each of them has no diagnostic (`clean`). The pin makes a lost candidate a failure.

pub fn break_in_a_for_body(n: I32) -> I32 {
  var r = 0
  for i in 0 ..< 3 {
    match n {
      
      1 => { break },
      _ => { r = r + i },                               //~ E0503
    }
  }
  r
}
