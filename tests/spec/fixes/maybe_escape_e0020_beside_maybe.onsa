// onsa.toml
// [test]
// spec = ["§4.5", "§0.5.1", "§18.1"]
// fixes = 1

// S-751 (c), S-868 (W5-17, §4.5: "重なりも矛盾も無い並びの、`?` の無い `Dup` と `Escape` は E0020"): the explicit `Dup` beside `?Escape`, and the explicit `Escape`
// beside `?Dup`, are lists with no overlap and no contradiction (`?Dup` is a contradiction only with a bound that needs `Dup`, and `Escape` does not;
// `?Escape` is none with `Dup`), so the `Dup` or the `Escape` is the E0020, in either order. The candidate takes the element out and leaves the
// `?` one (`T: Dup + ?Escape` is `T: ?Escape`; `T: ?Dup + Escape` is `T: ?Dup`). One candidate (`fixes = 1`). The same bound with and without the `?`
// is the contradiction of types/maybe_escape_contradiction.onsa and types/bounds_contradiction.onsa. One error per item (P-01).

pub fn dup_then_maybe_escape[T: Dup + ?Escape](x: T) -> U32 {   //~ E0020
  0
}

pub fn maybe_escape_then_dup[T: ?Escape + Dup](x: T) -> U32 {   //~ E0020
  0
}

pub fn escape_then_maybe_dup[T: Escape + ?Dup](x: T) -> U32 {   //~ E0020
  0
}

pub fn maybe_dup_then_escape[T: ?Dup + Escape](x: T) -> U32 {   //~ E0020
  0
}

pub struct RackDup[T: Dup + ?Escape] {   //~ E0020
  n: U32,
}

pub enum ShelfEscape[T: ?Dup + Escape] {   //~ E0020
  One(U32),
  Nothing,
}
