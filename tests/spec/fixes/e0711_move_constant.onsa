// onsa.toml
// [test]
// spec = ["§5.2", "§18.1"]
// fixes = 1
// [[test.fix]]
// at = "21:11"
// code = "E0711"
// candidate = 1
// clean = true

// R-198, S-605 (§5.2): a constant under a `move` in the argument of a `move` parameter is an E0711 at the operand of the `move`, and the one candidate removes it. A constant is not
// a place, so removing the mark is the whole change.

pub const LIMIT: U32 = 4

pub fn tk(move n: U32) -> U32 {
  n
}

pub fn constant() -> U32 {
  tk(move LIMIT) //~ E0711
}
