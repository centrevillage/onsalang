// onsa.toml
// [test]
// spec = ["§4.5", "§0.5.1", "§18.1"]
// fixes = 1

// S-751 (c), S-868 (W5-17, §4.5: "修正候補は要素を外す形（隣の `+`、残りが無ければ `:` ごと）"): the `Dup` or the `Escape` between two other bounds: the candidate
// takes out the element and one `+` that is next to it, so that the list is still joined by one `+` (`T: Show + Dup + PartialEq` is `T: Show +
// PartialEq`). One candidate (`fixes = 1`). Every place that has a list. One error per item (P-01).

pub struct Held[T] {
  n: U32,
}

pub struct Plain {
  n: U32,
}

pub fn dup_between[T: Show + PartialEq](x: T) -> U32 {   //~ E0020
  0
}

pub fn escape_between[T: Show + PartialEq](x: T) -> U32 {   //~ E0020
  0
}

pub struct RackDup[T: Show + PartialEq] {   //~ E0020
  n: U32,
}

pub enum ShelfEscape[T: Show + PartialEq] {   //~ E0020
  One(U32),
  Nothing,
}

impl[T: Show + PartialEq] Held[T] {   //~ E0020
  pub fn tag() -> U32 {
    7
  }
}

impl Plain {
  pub fn method_escape_between[U: Show + PartialEq](self, y: U) -> U32 {   //~ E0020
    self.n
  }
}
