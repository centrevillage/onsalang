// onsa.toml
// [test]
// spec = ["§5.2", "§18.1"]
// fixes = 1
// [[test.fix]]
// at = "16:19"
// code = "E0703"
// candidate = 1
// clean = true

// S-795 (§5.2: "そこに置いたブロックの末尾も位置を継ぎ、末尾ごとに一件"): a `move` at the end of an arm of an `if` at the right of an assignment, on a Copy value, is an E0703 at the
// `move`, and the one candidate removes it.

pub fn assign_tail(c: Bool, n: U32) -> U32 {
  var x: U32 = 0
  x = if c { n } else { 0 } //~ E0703
  x
}
