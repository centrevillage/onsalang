// onsa.toml
// [test]
// spec = ["§2.5", "§6.5", "§11.7", "§18.1"]
// fixes = 1
//
// [[test.fix]]
// at = "19:3"
// code = "E0020"
// candidate = 1
// clean = true

// S-489 (W5-11 U10d2, §2.5, §6.5): the candidate of a space after the `@` of the attribute of a flow input removes the
// space, and nothing is left behind (`clean`, S-253): `@param(…)` before an input is a right declaration. The main
// position is the `@`, the first token of the form (§18.1). A file with one unit, so that `clean` looks at the whole
// file.

pub flow f(
  x: F32 at sample,
  @param(min: 0.0, max: 1.0, default: 0.5)   //~ E0020
  g: F32 at block,
) -> F32 at sample {
  x * g
}
