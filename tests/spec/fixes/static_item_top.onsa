// onsa.toml
// [test]
// spec = ["§2.2", "§18.1"]
// fixes = 1
// [[test.fix]]
// at = "16:1"
// code = "E0020"
// candidate = 1
// clean = true

// E0020 for the `static NAME: T = e` of Rust at the top level (S-620, row `static_item`, §18.1): the candidate is
// `const NAME: T = e`. The item is read as far as its name and is a constant of the type `T` for the names stage, so the
// places that use it get no E0302: an expression, the result of a function whose type is `T`, another function, a branch
// and a closure. The initializer is not checked. After the candidate is applied the file has no diagnostic. One error.

static LIMIT: I32 = 4                               //~ E0020

pub fn in_an_expression(x: I32) -> I32 {
  x + LIMIT
}

pub fn as_the_result() -> I32 {
  LIMIT
}

pub fn in_a_branch(c: Bool) -> I32 {
  if c { LIMIT } else { 0 }
}

pub fn in_a_closure(x: I32) -> I32 {
  let add = fn(y: I32) -> I32 { y + LIMIT }
  add.(x)
}
