// onsa.toml
// [test]
// spec = ["§2.5", "§6.5", "§18.1"]
// fixes = 1

// S-489 (W5-11 U10d2, §2.5, §6.5): the `@` of an attribute and its name take no space (`@fp(relaxed)`), as a mark that
// belongs to a name does. A space after the `@` in the heading of an item is E0020, and the candidate removes the
// space. The forms are tried on the items that take an attribute: a function and a flow (`@fp`), a struct (`@repr`),
// a method of an `impl`, a top-level function with `@export`, on its own line and on the line of the heading, after
// another attribute, with two spaces and with a tab. One error per declaration unit (P-01). The attributes of the
// inputs of a flow are in space_after_attr_at_flow_input.onsa, and the ones of a statement in
// space_after_attr_at_statement.onsa. The right forms are at the end of the file.

@ fp(relaxed)   //~ E0020
pub fn a_function(x: F32) -> F32 {
  x
}

@ fp(relaxed)   //~ E0020
pub flow a_flow(x: F32 at sample) -> F32 at sample {
  x
}

@ repr(c)   //~ E0020
pub struct Frame {
  x: I32,
}

pub struct Holder {
  x: I32,
}

impl Holder {
  @ fp(relaxed)   //~ E0020
  pub fn a_method(self) -> I32 {
    self.x
  }
}

@ fp(relaxed) pub fn on_the_line_of_the_heading(x: F32) -> F32 {   //~ E0020
  x
}

@fp(relaxed)
@ export   //~ E0020
pub fn after_another_attribute(x: F32) -> F32 {
  x
}

@ export   //~ E0020
pub fn an_export(x: F32) -> F32 {
  x
}

@  fp(relaxed)   //~ E0020
pub fn two_spaces(x: F32) -> F32 {
  x
}

@	fp(relaxed)   //~ E0020
pub fn a_tab(x: F32) -> F32 {
  x
}

@fp(relaxed)
pub fn fine_function(x: F32) -> F32 {
  x
}

@fp(relaxed)
@export
pub fn fine_two_attributes(x: F32) -> F32 {
  x
}

@repr(c)
pub struct FineFrame {
  x: I32,
}
