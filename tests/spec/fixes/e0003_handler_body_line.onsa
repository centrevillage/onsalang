// onsa.toml
// [test]
// spec = ["§2.3", "§2.5", "§8.3", "§18.1"]
// fixes = 1

// E0003: the `{` of the body of a handler written in place, `handle { … } with Ask { … }`, that is not on the line of the
// effect name before it (spec §2.5, §8.3, S-421, S-216). The last name of the path after `with` is UpperCamel (§2.3), so
// it names an effect, and the body must follow on the same line: the `{` on the next line is E0003 outside every
// pair of brackets, as inside one, and not a statement of its own (the name of a struct literal in the same place
// is another matter: negative/ and fixes/e0003_struct_literal_brace.onsa). The main position is the `{`, the marker is
// on its line, and the candidate moves the `{` and the rest of its line up to the comment to the end of the line of the
// effect name (before a comment that stands there, which stays on its line); the lines and comments between stay as they are.
// A lower_snake name after `with` is a named handler, and a `{` on the next line is a block statement of its own.
// Effects, and handlers written in place, are not in this version (E0200, tests/spec/negative/unsupported.onsa), but
// the placement of the `{` is a rule of the syntax stage: the unit with the E0003 does not reach the stage that reports
// the E0200, the candidate leaves the E0200, a diagnostic of a later stage, and the units that are written right
// (the body on the line of the name, a named handler) have the E0200 alone. One error in each declaration unit.

pub fn two(a: I32, b: I32) -> I32 {
  a + b
}

pub fn tail_expression() -> I32 {
  handle { 1 } with Ask
  { fn ask() -> I32 { 1 } }                         //~ E0003
}

pub fn let_value() -> I32 {
  let r = handle { 1 } with Ask
  { fn ask() -> I32 { 1 } }                         //~ E0003
  r
}

pub fn block_body() -> I32 {
  handle {
    1
  } with Ask
  {                                                 //~ E0003
    fn ask() -> I32 { 1 }
  }
}

pub fn qualified_effect() -> I32 {
  let r = handle { 1 } with io.Ask
  { fn ask() -> I32 { 1 } }                         //~ E0003
  r
}

pub fn empty_body() -> I32 {
  let r = handle { 1 } with Ask
  { }                                               //~ E0003
  r
}

pub fn a_comment_line_between() -> I32 {
  let r = handle { 1 } with Ask
  // the operations of the handler
  { fn ask() -> I32 { 1 } }                         //~ E0003
  r
}

pub fn a_blank_line_between() -> I32 {
  let r = handle { 1 } with Ask

  { fn ask() -> I32 { 1 } }                         //~ E0003
  r
}

pub fn a_comment_on_the_line_of_the_name() -> I32 {
  let r = handle { 1 } with Ask // the effect
  { fn ask() -> I32 { 1 } }                         //~ E0003
  r
}

pub fn in_a_call() -> I32 {
  two(handle { 1 } with Ask
      { fn ask() -> I32 { 1 } }, 1)                 //~ E0003
}

pub fn in_an_array() -> I32 {
  let v = [handle { 1 } with Ask
    { fn ask() -> I32 { 1 } }, 2]                   //~ E0003
  v[0]
}

pub fn in_a_tuple() -> (I32, I32) {
  (handle { 1 } with Ask
   { fn ask() -> I32 { 1 } }, 2)                    //~ E0003
}

pub fn in_an_arm(x: I32) -> I32 {
  match x {
    0 => handle { 1 } with Ask
         { fn ask() -> I32 { 1 } },                 //~ E0003
    _ => 2,
  }
}

pub fn in_an_if_branch(c: Bool) -> I32 {
  if c {
    handle { 1 } with Ask
    { fn ask() -> I32 { 1 } }                       //~ E0003
  } else {
    2
  }
}

pub fn the_body_on_the_line_of_the_name() -> I32 {
  handle { 1 } with Ask { fn ask() -> I32 { 1 } }   //~ E0200
}

pub fn the_body_opened_on_the_line_of_the_name() -> I32 {
  let r = handle { 1 } with Ask {                   //~ E0200
    fn ask() -> I32 { 1 }
  }
  r
}

pub fn the_body_in_a_call() -> I32 {
  two(handle { 1 } with Ask { fn ask() -> I32 { 1 } }, 1)   //~ E0200
}

pub fn a_named_handler_and_a_block() -> I32 {
  let r = handle { 1 } with quiet                   //~ E0200
  { let a = 1 }
  r
}

pub fn a_named_handler_in_a_call() -> I32 {
  two(handle { 1 } with quiet, 1)                   //~ E0200
}
