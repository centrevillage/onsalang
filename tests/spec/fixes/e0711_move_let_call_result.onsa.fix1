// onsa.toml
// [test]
// spec = ["§5.2", "§18.1"]
// fixes = 1
// [[test.fix]]
// at = "18:16"
// code = "E0711"
// candidate = 1
// clean = true

// R-198, S-605 (§5.2): the result of a call under a `move` in the initialization of a `let` is an E0711 at the operand of the `move`, and the one candidate removes it.

pub fn mk() -> Buf[F32] uses {Alloc} {
  Buf.zeroed(2)
}

pub fn let_call_result() -> U32 uses {Alloc} {
  let z = mk() //~ E0711
  z.len()
}
