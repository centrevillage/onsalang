// onsa.toml
// [test]
// spec = ["§2.5", "§3.1", "§18.1"]
// fixes = 1
//
// [[test.fix]]
// at = "131:3"
// code = "E0020"
// candidate = 1
// leaves = ["132:3 E0020"]

// The `[[test.fix]]` entries in the header name what a candidate leaves in its unit: a second misplaced
// token, reported by the next check (§18.1, S-236). The `at` and `leaves` positions are those of the spec
// (the misplaced token). The entries were commented out (`// # `) until W3-06/i made the check report
// the diagnostics.
//
// E0020: an operator that is used only as a binary operator, at the start of a line (spec §2.5, S-124,
// S-370, S-216, R-160). A line ends at its end, so a line that starts with `+` is not the continuation
// of the line before it (as it is in JavaScript and Python) but a new statement, which has no reading;
// the writer's reading is the line before it going on, and the candidate is that reading: the operator
// moves to the end of the line before it (before that line's comment), and the next line has its operand.
// The main position is the operator (the marker is on its line). The rule is the same in a pair of
// brackets, where a line break is a blank (S-370), in an arm and in the head of an `if` and a `while`.
// One error in each declaration unit, as each unit stops at its first error.
// The prefix operators `-` and `^`, which also start a line of their own, are in
// e0020_leading_minus.onsa and e0020_leading_minus_parens.onsa; the range symbols are in
// e0020_leading_range.onsa.

use std.array

pub fn two(x: I32, y: I32) -> I32 {
  x - y
}

// ---------------------------------------------------------------- in a block, one operator each

pub fn plus(a: I32, b: I32) -> I32 {
  let c = a
  + b                                               //~ E0020
  c
}

pub fn times(a: I32, b: I32) -> I32 {
  let c = a
  * b                                               //~ E0020
  c
}

pub fn divide(a: I32, b: I32) -> I32 {
  let c = a
  / b                                               //~ E0020
  c
}

pub fn remainder(a: I32, b: I32) -> I32 {
  let c = a
  % b                                               //~ E0020
  c
}

pub fn equal(a: I32, b: I32) -> Bool {
  let c = a
  == b                                              //~ E0020
  c
}

pub fn not_equal(a: I32, b: I32) -> Bool {
  let c = a
  != b                                              //~ E0020
  c
}

pub fn less_equal(a: I32, b: I32) -> Bool {
  let c = a
  <= b                                              //~ E0020
  c
}

pub fn greater_equal(a: I32, b: I32) -> Bool {
  let c = a
  >= b                                              //~ E0020
  c
}

pub fn and(a: Bool, b: Bool) -> Bool {
  let c = a
  && b                                              //~ E0020
  c
}

pub fn or(a: Bool, b: Bool) -> Bool {
  let c = a
  || b                                              //~ E0020
  c
}

pub fn shift_left(a: U32) -> U32 {
  let c = a
  << 1                                              //~ E0020
  c
}

pub fn shift_right(a: U32) -> U32 {
  let c = a
  >> 1                                              //~ E0020
  c
}

// ---------------------------------------------------------------- where the first operand is

pub fn tail_expression(a: I32, b: I32) -> I32 {
  a
  * b                                               //~ E0020
}

pub fn assignment(a: I32, b: I32) -> I32 {
  var t = a
  t = t
  + b                                               //~ E0020
  t
}

pub fn after_a_call(a: I32, b: I32) -> I32 {
  let c = two(a, b)
  + 1                                               //~ E0020
  c
}

pub fn a_chain_of_lines(a: I32, b: I32, c: I32) -> I32 {
  let d = a
  + b                                               //~ E0020
  + c
  d
}

// ---------------------------------------------------------------- the comments of the lines

pub fn comment_at_the_end_of_the_line(a: I32, b: I32) -> I32 {
  let c = a // the first operand
  + b                                               //~ E0020
  c
}

pub fn comment_line_between(a: I32, b: I32) -> I32 {
  let c = a
  // the second operand
  + b                                               //~ E0020
  c
}

pub fn comments_and_blank_lines_between(a: I32, b: I32) -> I32 {
  let c = a // the first operand

  // the second operand

  + b                                               //~ E0020
  c
}

// ---------------------------------------------------------------- the head of an `if` and a `while`

pub fn if_head(a: Bool, b: Bool) -> I32 {
  if a
  && b {                                            //~ E0020
    1
  } else {
    2
  }
}

pub fn else_if_head(a: Bool, b: Bool, c: Bool) -> I32 {
  if a {
    1
  } else if b
  || c {                                            //~ E0020
    2
  } else {
    3
  }
}

pub fn while_head(a: Bool, b: Bool) -> I32 {
  while a
  && b {                                            //~ E0020
    return 1
  }
  0
}

// ---------------------------------------------------------------- in a pair of brackets (S-370)

pub fn in_a_call(a: I32, b: I32) -> I32 {
  two(a
      + b, 1)                                       //~ E0020
}

pub fn in_a_call_second_argument(a: I32, b: I32) -> I32 {
  two(1, a
         * b)                                       //~ E0020
}

pub fn in_an_array(a: I32, b: I32) -> [I32; 2] {
  [a
   + b, 1]                                          //~ E0020
}

pub fn in_a_tuple(a: I32, b: I32) -> (I32, I32) {
  (a
   * b, 1)                                          //~ E0020
}

pub struct Pt {
  x: I32,
  y: I32,
}

pub fn in_a_struct_literal(a: I32, b: I32) -> Pt {
  Pt { x: a
        + b, y: 2 }                                 //~ E0020
}

pub fn in_an_index(xs: [I32; 4], i: U32) -> I32 {
  xs[i
     + 1]                                           //~ E0020
}

pub fn in_a_parenthesis(a: I32, b: I32) -> I32 {
  (a
   + b) * 2                                         //~ E0020
}

pub fn in_a_nested_call(a: I32, b: I32) -> I32 {
  two(two(a
          + 1, b), b)                               //~ E0020
}

pub fn in_a_comparison_argument(a: I32, b: I32) -> Bool {
  id_bool(a
          == b)                                     //~ E0020
}

pub fn id_bool(c: Bool) -> Bool {
  c
}

pub fn in_a_call_with_comments(a: I32, b: I32) -> I32 {
  two(a // the first operand
      // a comment line
      + b, 1)                                       //~ E0020
}

// ---------------------------------------------------------------- in an arm and a closure

pub fn in_an_arm(k: U32, a: I32, b: I32) -> I32 {
  match k {
    0 => a
         + b,                                       //~ E0020
    _ => 0,
  }
}

pub fn in_a_guard(k: I32, a: Bool, b: Bool) -> I32 {
  match k {
    n if a
         && b => n,                                 //~ E0020
    _ => 0,
  }
}

pub fn in_a_closure_body() -> [U32; 3] {
  array.from_fn(fn(i) {
    i
    * 2                                             //~ E0020
  })
}

pub fn in_a_closure_with_a_call() -> [U32; 3] {
  array.from_fn(fn(i) { i
                        + 1 })                      //~ E0020
}

// ---------------------------------------------------------------- the right forms

pub fn fine(a: I32, b: I32, xs: [I32; 4]) -> I32 {
  let c = a +
    b
  let d = two(a +
    1, b)
  let e = xs[0] *
    2
  c + d + e
}
