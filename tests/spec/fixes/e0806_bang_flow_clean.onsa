// onsa.toml
// [test]
// spec = ["§2.6", "§11.2", "§18.1"]
//
// [[test.fix]]
// at = "20:11"
// code = "E0806"
// candidate = 1
// clean = true

// W7-04 U1b/t, S-813: the candidate of `lp!(x)` replaces the `!` with `~` (§11.2), and the file has no error after it (`clean`): `lp(x)`, the
// candidate that removes the `!`, would leave the E0811 of a flow called without `~` (§2.6), an error of the same stage. The one error of the file
// is the call.

pub flow lp(x: F32 at sample) -> F32 at sample {
  x * 0.5 + prev~(x) * 0.5
}

pub flow call(x: F32 at sample) -> F32 at sample {
  let a = lp!(x)                                    //~ E0806 @11
  a + x
}
