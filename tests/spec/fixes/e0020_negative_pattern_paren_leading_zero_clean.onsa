// onsa.toml
// [test]
// spec = ["§2.4", "§4.7", "§7", "§18.1"]
//
// [[test.fix]]
// at = "25:7"
// code = "E0020"
// candidate = 1
// clean = true
//
// [[test.fix]]
// at = "25:7"
// code = "E0020"
// candidate = 2
// clean = true

// The two candidates of `-(017)` in a pattern (spec §2.4, §4.7, §7, §18.1; S-63, S-227) leave nothing behind:
// `-(17)` and `-(15)` are negative literal patterns that the check reads without a report (`clean`, which is
// about the whole file, so this file has this one error). The main position is the first digit of the
// literal, inside the parentheses. The candidates of this form and the other places of the number are in
// `e0020_negative_pattern_paren_leading_zero.onsa`.

pub fn only_error(x: I32) -> I32 {
  match x {
    -(017) => 1,                                    //~ E0020 @7
    _ => 0,
  }
}
