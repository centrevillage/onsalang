// onsa.toml
// [test]
// spec = ["§6.2", "§6.5", "§10", "§18.1"]
// fixes = 1

// W5-24 U3a/t, S-600 (spec §18.1: "項目の位置（トップレベルと `impl` / `trait` / `effect` / `handler` / `extern` のメンバ）"; an attribute after the
// visibility or `rt` of a member of an `impl` is one E0002 with one candidate that writes the attribute before the visibility and `rt`
// of the member). The member is a unit of its own (§18.1), the head is read on so the method call finds it, and the visibility and the
// `rt` that were written stay (an `rt` function may call `b` and `c`, and gets E0901 for `a`). One error in each member.

pub struct Pt {
  x: F32,
}

impl Pt {
  @fp(relaxed) pub fn a(self) -> F32 {              //~ E0002
    self.x
  }

  @fp(relaxed) rt fn b(self) -> F32 {               //~ E0002
    self.x
  }

  @fp(relaxed) pub rt fn c(self, k: F32) -> F32 {   //~ E0002
    self.x * k
  }

  @fp(relaxed) pub fn make(x: F32) -> Pt {          //~ E0002
    Pt { x: x }
  }
}

fn calls(p: Pt) -> F32 {
  p.a() + p.b() + p.c(2.0) + Pt.make(1.0).a()
}

rt fn calls_rt_ones(p: Pt) -> F32 {
  p.b() + p.c(2.0)
}

rt fn calls_a(p: Pt) -> F32 {
  p.a()                                             //~ E0901
}

fn too_many_arguments(p: Pt) -> F32 {
  p.c(1.0, 2.0)                                     //~ E0412
}

fn own_error(p: Pt) -> F32 {
  p.a() + zz                                        //~ E0302
}
