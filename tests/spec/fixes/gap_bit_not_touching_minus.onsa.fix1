// onsa.toml
// [test]
// spec = ["§2.5", "§2.6", "§3.1", "§18.1"]
// fixes = 1

// S-958 (W5-11 U10i/t, §2.6, §3.1, §18.1): the `~` that touches an operand that begins with a prefix `-` (`~-x`) is the
// E0020 of the bit negation with the one candidate that writes the operand in parentheses (`!(-x)`), and not the E0012 of
// two prefix operators in a row. The candidate stays after S-958 (S-962 removes only the `!` operand's). This is the form
// that the pinned binary reports before S-958, so this file passes without the work and pins that it stays: the spaced
// forms are in gap_bit_not_minus.onsa. The main position is the `~`. One error per declaration unit (P-01).

pub fn id(m: I32) -> I32 {
  m
}

pub fn a_name(m: I32) -> I32 {
  let n = !(-m)   //~ E0020
  n
}

pub fn a_group(m: I32) -> I32 {
  let n = !(-(m + 1))   //~ E0020
  n
}

pub fn a_literal() -> I32 {
  let n = !(-1)   //~ E0020
  n
}

pub fn in_an_argument(m: I32) -> I32 {
  id(!(-m))   //~ E0020
}
