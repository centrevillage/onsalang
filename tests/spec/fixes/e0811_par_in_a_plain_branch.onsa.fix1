// candidate = 1
// leaves = ["73:5 E0811"]

// W4-20 U1/t, S-745; W7-06 U0/t, S-1177: a `par` without the `~` that holds state in a branch of a plain `if`
// or `match` is judged twice by the flow check stage (§18.1: "`if` / `match` の枝の状態を持つものの E0811 と、
// … 本体の中身で決まる `par` / `par~` の `~` の有無（E0811、E0812、§11.5）は flow の検査の段である"): as a thing
// with state in a branch (§11.5) and as a `par` without the `~` (§11.5). Both are E0811 at the same place, so
// the unit reports the one error of the `par` (the first by position, §18.1), and its one candidate is the
// insertion of the `~` (§11.5; `fixes = 1`: the candidates of the error of the branch, the `if~` / `match~`
// and the lift into a `let`, are not asked for here). What stays after the candidate is in
// e0811_par_in_a_plain_branch_leaves.onsa. After the candidate the `par~` holds state in the branch, which this
// version reports as the E0811 of a thing with state in a branch (`leaves` in the header, at the start of the
// `par~`; S-1183 (1), the provisional reading: the candidate is shown although the branch stays an error). Which
// candidates the one error has when the `par` and the branch are both E0811 at the same place is a gap (W7-06 U1/t).
// A `par` without state in a branch is no error: it is a thing
// without state that is taken only when the branch is (par_in_plain_branches.onsa).

pub flow lp(x: F32 at sample) -> F32 at sample {
  x * 0.5 + prev~(x) * 0.5
}

pub flow in_the_then_branch(x: F32 at sample, c: Bool at sample) -> [F32; 2] at sample {
  if c {
    par~ i in 0 ..< 2 { lp~(x * F32.round_from(i)) }     //~ E0811
  } else {
    [x, x]
  }
}

pub flow in_the_else_branch(x: F32 at sample, c: Bool at sample) -> [F32; 2] at sample {
  if c {
    [x, x]
  } else {
    par~ i in 0 ..< 2 { lp~(x * F32.round_from(i)) }     //~ E0811
  }
}

pub flow in_an_arm(x: F32 at sample, k: U32 at sample) -> [F32; 2] at sample {
  match k {
    0 => par~ i in 0 ..< 2 { lp~(x * F32.round_from(i)) },  //~ E0811
    _ => [x, x],
  }
}

pub flow in_a_let_of_a_branch(x: F32 at sample, c: Bool at sample) -> [F32; 2] at sample {
  let ys = if c {
    par~ i in 0 ..< 2 { lp~(x * F32.round_from(i)) }     //~ E0811
  } else {
    [x, x]
  }
  ys
}
