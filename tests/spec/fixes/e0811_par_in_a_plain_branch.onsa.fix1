// [[test.fix]]
// at = "50:5"
// code = "E0811"
// candidate = 1
// leaves = ["50:5 E0811"]
//
// [[test.fix]]
// at = "60:5"
// code = "E0811"
// candidate = 1
// leaves = ["60:5 E0811"]
//
