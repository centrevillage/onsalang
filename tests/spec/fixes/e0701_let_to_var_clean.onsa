// onsa.toml
// [test]
// spec = ["§5.1", "§18.1"]
//
// [[test.fix]]
// at = "34:3"
// code = "E0701"
// candidate = 1
// clean = true

// R-161 (§5.1: "E0701 は宣言を `var` にする"): the candidate of the write to a `let` leaves nothing behind. The unit holds
// writes of every kind to the one binding (an assignment, an `inout` argument, a `!` call, an element), and the first one is
// reported. After the `let` is a `var` the whole file has no error (`clean` is about the whole file, so this file has this
// one error; a candidate that left a write behind, or an error of a later stage, would fail here).

pub struct Acc {
  total: U32,
  count: U32,
}

impl Acc {
  pub fn add(inout self, k: U32) {
    self.total = self.total + k
    self.count = self.count + 1
  }
}

pub fn set(inout n: U32) {
  n = 1
}

pub fn writes_of_every_kind() -> U32 {
  let acc = Acc { total: 0, count: 0 }
  acc.total = 5                  //~ E0701
  acc.add!(2)
  set(inout acc.count)
  acc.total + acc.count
}
