// onsa.toml
// [test]
// spec = ["§4.5", "§18.1"]
// fixes = 2
//
// [[test.fix]]
// at = "34:22"
// code = "E0020"
// candidate = 1
// clean = true

// S-999 (W5-24 U6b): with a member after the outer `]` (`Q[Rg[F32, 4]].CAP`) the content of the outer brackets is still a type,
// so the candidate that puts `::` before the outer `[` (`Q::[Rg[F32, 4]].CAP`, which is 4) leaves nothing behind, here in the
// length of an array type (the value is in type_args_square_outer_clean_member_after_value.onsa). `clean` is about the whole
// file, so the file has this one unit with an error. The main
// position of the diagnostic is not asked (the entry says the outer `[`, which the implementation may change).

pub struct Rg[T, const N: U32] {
  d: [T; N],
}

impl[T, const N: U32] Rg[T, N] {
  pub const CAP: U32 = 4
}

pub struct Q[T] {
  d: T,
}

impl[T] Q[T] {
  pub const CAP: U32 = 4
}

pub fn len(a: [F32; Q[Rg[F32][4]].CAP]) -> U32 {   //~ E0020
  a.len()
}
