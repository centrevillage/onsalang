// onsa.toml
// [test]
// spec = ["§3.1", "§3.3", "§18.1"]
// fixes = 1

// E0413 for a conversion function of a pair that `as` can write (§3.3), by the form of the argument. The candidate puts
// the argument on the left of an `as`, and `as` binds weaker than a postfix and a prefix symbol and stronger than a
// binary operator (§3.1), so the argument needs parentheses where it binds weaker than `as`: a binary expression
// (`F64.round_from(a + b)` is `(a + b) as F64`), an `as` expression (`F64.round_from(x as I32)` is `(x as I32) as F64`,
// E0011), and a block-like expression (E0013). It needs none for a name, a prefix `-` (`-n as F64` is `(-n) as F64`,
// the same value as `F64.round_from(-n)`), a call, a call of a function value, a field, an index and `?`. Where the
// result is also the operand of a binary operator or the receiver of a call, it gets its own parentheses over those of
// the argument (`((a + b) as F64) * c`). One error in each function (P-01).

pub struct P {
  b: I32,
}

pub fn f(x: I32) -> I32 {
  x
}

pub fn g64(v: F64) -> F64 {
  v
}

pub fn a_name(n: I32) -> F64 {
  n as F64                                 //~ E0413
}

pub fn a_sum(a: I32, b: I32) -> F64 {
  (a + b) as F64                             //~ E0413
}

pub fn a_product(a: I32, b: I32) -> F64 {
  (a * b) as F64                             //~ E0413
}

pub fn a_difference(a: I16, b: I16) -> F32 {
  (a - b) as F32                             //~ E0413
}

pub fn an_as_expression(x: I16) -> F64 {
  (x as I32) as F64                          //~ E0413
}

pub fn a_prefix_minus(n: I32) -> F64 {
  -n as F64                                //~ E0413
}

pub fn a_call(x: I32) -> F64 {
  f(x) as F64                              //~ E0413
}

pub fn a_call_of_a_function_value(g: fn(I32) -> I32, x: I32) -> F64 {
  g.(x) as F64                             //~ E0413
}

pub fn a_field(p: P) -> F64 {
  p.b as F64                               //~ E0413
}

pub fn an_index(xs: [I32; 4], i: U32) -> F64 {
  xs[i] as F64                             //~ E0413
}

pub fn a_try(o: Option[I32]) -> Option[F64] {
  Some(o? as F64)                          //~ E0413
}

pub fn a_block_like(c: Bool, a: I32, b: I32) -> F64 {
  (if c { a } else { b }) as F64             //~ E0413
}

pub fn a_sum_as_the_right_of_a_sum(acc: F64, a: I32, b: I32) -> F64 {
  acc + ((a + b) as F64)                       //~ E0413
}

pub fn a_sum_as_the_left_of_a_product(a: I32, b: I32, c: F64) -> F64 {
  ((a + b) as F64) * c                         //~ E0413
}

pub fn an_as_expression_as_the_left_of_a_sum(x: I16, acc: F64) -> F64 {
  ((x as I32) as F64) + acc                    //~ E0413
}

pub fn a_prefix_as_the_right_of_a_product(n: I32, c: F64) -> F64 {
  c * (-n as F64)                            //~ E0413
}

pub fn a_sum_as_the_receiver(a: I32, b: I32) -> U64 {
  ((a + b) as F64).to_bits()                   //~ E0413
}

pub fn a_sum_after_a_prefix(a: I32, b: I32) -> F64 {
  -((a + b) as F64)                            //~ E0413
}

pub fn a_sum_in_an_argument(a: I32, b: I32) -> F64 {
  g64((a + b) as F64)                        //~ E0413
}
