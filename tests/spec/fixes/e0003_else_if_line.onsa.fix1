// onsa.toml
// [test]
// spec = ["§2.5", "§7", "§18.1"]
// fixes = 1

// E0003 for an `if` that is not on the line of the `else` before it (spec §2.5, §7, S-414, S-216): `else` and the `if`
// that follows it (`else if`) are written on one line, as `else` is on the line of the `}` before it. The main
// position is the `if`, so the marker is on its line, and the candidate moves the `if` and the rest of its line,
// up to the comment, to the end of the line of the `else`, before the comment of that line; the comment lines and
// blank lines between stay where they are. The rule is the same in a pair of brackets and outside them (the `if`
// after the `else` is read by the parser in both, so the rule adds no condition). The `else` on a line of its own
// is the E0003 of tests/spec/fixes/e0003_else_line.onsa. (The line break between `with` and its handler
// is not in this rule: tests/spec/negative/s416_keyword_operand_outside_brackets.onsa.) One error in each declaration
// unit (P-01). The right forms are at the end of the file.

pub fn two(x: I32, y: I32) -> I32 {
  x + y
}

pub fn basic(c: Bool, d: Bool) -> I32 {
  if c {
    1
  } else if d {
                                                    //~ E0003
    2
  } else {
    3
  }
}

pub fn a_chain(c: Bool, d: Bool, e: Bool) -> I32 {
  if c {
    1
  } else if d {
    2
  } else if e {
                                                    //~ E0003
    3
  } else {
    4
  }
}

pub fn on_one_line(c: Bool, d: Bool) -> I32 {
  let a = if c { 1 } else if d { 2 } else { 3 }
                                                    //~ E0003
  a
}

pub fn as_the_value_of_a_function(c: Bool, d: Bool) -> I32 {
  if c { 1 } else if d { 2 } else { 3 }
                                                    //~ E0003
}

pub fn in_a_call(c: Bool, d: Bool) -> I32 {
  two(if c { 1 } else if d { 2 } else { 3 }, 1)
                                                    //~ E0003
}

pub fn in_a_call_second_argument(c: Bool, d: Bool) -> I32 {
  two(1, if c { 1 } else if d { 2 } else { 3 })
                                                    //~ E0003
}

pub fn in_an_array(c: Bool, d: Bool) -> U32 {
  let v = [if c { 1 } else if d { 2 } else { 3 }, 4]
                                                    //~ E0003
  v.len()
}

pub fn in_a_group(c: Bool, d: Bool) -> I32 {
  let a = (if c { 1 } else if d { 2 } else { 3 })
                                                    //~ E0003
  a
}

pub fn in_an_arm_body(n: I32, c: Bool, d: Bool) -> I32 {
  match n {
    0 => if c { 1 } else if d { 2 } else { 3 },
                                                    //~ E0003
    _ => 0,
  }
}

pub fn in_a_block_in_a_call(c: Bool, d: Bool) -> I32 {
  two({
    if c {
      1
    } else if d {
                                                    //~ E0003
      2
    } else {
      3
    }
  }, 1)
}

pub fn in_a_closure(x: I32, c: Bool, d: Bool) -> I32 {
  let f = fn(y: I32, p: Bool, q: Bool) -> I32 {
    if p {
      y
    } else if q {
                                                    //~ E0003
      y + 1
    } else {
      y + 2
    }
  }
  f.(x, c, d)
}

pub fn in_a_generic_head[T: Num](c: Bool, d: Bool, x: T, y: T) -> T {
  if c {
    x
  } else if d {
                                                    //~ E0003
    y
  } else {
    x + y
  }
}

pub flow in_a_flow(c: Bool at sample, d: Bool at sample, x: F32 at sample) -> F32 at sample {
  if c {
    x
  } else if d {
                                                    //~ E0003
    x * 2.0
  } else {
    x * 3.0
  }
}

pub flow in_a_par(c: Bool at sample, d: Bool at sample, x: F32 at sample) -> [F32; 4] at sample {
  par i in 0..<4 {
    if c {
      x
    } else if d {
                                                    //~ E0003
      x * i.round_f32()
    } else {
      x * 2.0
    }
  }
}

pub fn a_comment_on_the_else_line(c: Bool, d: Bool) -> I32 {
  if c {
    1
  } else if d { // otherwise
                                                    //~ E0003
    2
  } else {
    3
  }
}

pub fn a_comment_on_the_if_line(c: Bool, d: Bool) -> I32 {
  if c {
    1
  } else if d {
  // the second condition                    //~ E0003
    2
  } else {
    3
  }
}

pub fn comment_lines_between(c: Bool, d: Bool) -> I32 {
  if c {
    1
  } else if d {
  // the second condition

                                                    //~ E0003
    2
  } else {
    3
  }
}

pub fn the_rest_of_the_line_goes_with_the_if(c: Bool, d: Bool) -> I32 {
  if c { 1 } else if d { 2 } else { 3 } // otherwise
  // tail                     //~ E0003
}

pub flow tilde_in_a_flow(c: Bool at sample, d: Bool at sample) -> F32 at sample {
  if~ c {
    1.0
  } else if d {
                                                    //~ E0003
    2.0
  } else {
    3.0
  }
}

pub flow tilde_one_line(c: Bool at sample, d: Bool at sample) -> F32 at sample {
  let a = if~ c { 1.0 } else if d { 2.0 } else { 3.0 }
                                                    //~ E0003
  a
}

// The right forms: `else if` on one line, an `else` block, and a plain `else` followed by a block.
pub fn fine(c: Bool, d: Bool) -> I32 {
  let a = if c { 1 } else if d { 2 } else { 3 }
  let b = if c {
    1
  } else if d {
    2
  } else {
    3
  }
  let e = if c {
    1
  } else {
    if d { 2 } else { 3 }
  }
  a + b + e
}
