// onsa.toml
// [test]
// spec = ["§2.5", "§18.1"]
// fixes = 1
//
// [[test.fix]]
// at = "17:13"
// code = "E0002"
// candidate = 1
// clean = true

// A `while` after a `var` on the same line (§2.5, §18.1, S-401): `while` starts a statement only, so the
// E0002 has the candidate that puts it on its own line, and the file has no diagnostic after it
// (`clean = true`).

pub fn count(c: Bool) -> I32 {
  var t = 0
  while c {                               //~ E0002
    t = 1
    break
  }
  t
}
