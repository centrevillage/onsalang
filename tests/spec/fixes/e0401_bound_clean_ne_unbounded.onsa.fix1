// at = "15:5"
// code = "E0401"
// candidate = 1
// clean = true

// E0401 for `a != b` where `T` has no bound (§6.3: `==` and `!=` are `PartialEq`, not a number trait, because a type that is
// not a number can be compared). The one candidate is `T: PartialEq`; no diagnostic is left after it.

pub fn differs[T: PartialEq](a: T, b: T) -> Bool {
  a != b                                            //~ E0401
}
