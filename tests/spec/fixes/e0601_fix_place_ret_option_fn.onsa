// §8.1: a function type inside `Option[…]` ends at the `]`, so the row after the result is the function's:
// `-> Option[fn(I32) -> I32] uses {Alloc}`.

pub fn bump(y: I32) -> I32 uses {Alloc} { y }

pub fn mk() -> Option[fn(I32) -> I32] {
  let _ = bump(1)                                   //~ E0601 @11
  None
}
