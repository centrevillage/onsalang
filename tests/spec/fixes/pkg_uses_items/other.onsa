use util
use dsp.synth

pub fn call_through_the_module(x: I32) -> I32 {
  util.BadFn(x)
}

pub fn struct_through_the_module(x: F32) -> util.Bad_Pt {
  util.Bad_Pt { x: x }
}

pub fn enum_through_the_module(x: F32) -> util.Bad_Shape {
  util.Bad_Shape.Square(x)
}

pub fn pattern_through_the_module(s: util.Bad_Shape) -> F32 {
  match s {
    util.Bad_Shape.Circle(r) => r,
    util.Bad_Shape.Square(a) => a,
  }
}

pub fn constant_through_the_module() -> U32 {
  util.max_voices + 1
}

pub fn alias_through_the_module(x: util.Bad_Alias) -> util.Bad_Alias {
  x
}

pub fn flow_through_the_module(move s: synth.BadFlow.State) -> synth.BadFlow.State {
  s
}

pub fn flow_params_through_the_module(g: F32) -> synth.BadFlow.Params {
  synth.BadFlow.Params { gain: g }
}

pub fn variant_through_the_module() -> util.Wave {
  util.Wave.saw_tooth
}

pub fn field_through_the_module(c: util.Cfg) -> F32 {
  c.badField
}

pub fn literal_through_the_module(x: F32) -> util.Cfg {
  util.Cfg { badField: x }
}

pub fn method_through_the_module(c: util.Cfg) -> F32 {
  c.BadM()
}

pub fn associated_function_through_the_module(c: util.Cfg) -> util.Cfg {
  util.Cfg.BadNew(c)
}
