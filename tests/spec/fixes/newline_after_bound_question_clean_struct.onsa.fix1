// S-957 (W5-11 U10d2/t2, §2.5, §4.5): the candidate of a line break after the `?` of a bound in the `[ ]` of a struct moves the
// `?` to the line of its name, before the `+` that follows the name, and nothing is left behind (`clean`, S-253). The main
// position is the `?`. A file with one unit, so that `clean` looks at the whole file.

pub struct Bag[T:   //~ E0020 @19
  ?Dup + Show] {
  n: U32,
}
