// onsa.toml
// [test]
// spec = ["§2.6", "§11.5", "§18.1"]

// W4-20 U1/t, S-745; W7-06 U0/t, S-1177: the E0811 of a `par` without the `~` that holds state in its body is
// decided by the content of the body (§11.5), so it is an error of the flow check stage (§18.1: "本体の中身で
// 決まる `par` / `par~` の `~` の有無（E0811、E0812、§11.5）は flow の検査の段である"), after the names and the
// types: an error of those stages in the same flow is the one reported, wherever it is (§18.1: "依存する段の
// 間では、位置によらず先の段の誤りを報告する"). The type error of `x + 1` comes before and after the `par`
// by position and is the one error in both flows; a name that is not found (E0302, in the let, in the body or
// in the header of the `par`) is a names error and is the one error too. The `par` has no error in these
// flows (its error is of a later stage), so it carries no marker, and the file has no candidate of an E0811.
// The place where the E0811 of the `par` is reported is in e0811_par_flow_stage.onsa. One error per flow
// (P-01).

pub rt fn total(xs: [F32; 4]) -> F32 {
  xs[0] + xs[1] + xs[2] + xs[3]
}

pub flow type_error_then_par(x: F32 at sample) -> F32 at sample {
  let a = x + 1                                         //~ E0401
  let ys = par i in 0 ..< 4 { prev~(x * F32.round_from(i)) }
  a + total(ys)
}

pub flow par_then_a_type_error(x: F32 at sample) -> F32 at sample {
  let ys = par i in 0 ..< 4 { prev~(x * F32.round_from(i)) }
  let a = x + 1                                         //~ E0401
  a + total(ys)
}

pub flow par_then_a_name_not_found(x: F32 at sample) -> F32 at sample {
  let ys = par i in 0 ..< 4 { prev~(x * F32.round_from(i)) }
  let z = nope                                          //~ E0302
  total(ys)
}

pub flow a_name_not_found_then_par(x: F32 at sample) -> F32 at sample {
  let z = nope                                          //~ E0302
  let ys = par i in 0 ..< 4 { prev~(x * F32.round_from(i)) }
  total(ys)
}

pub flow a_name_not_found_in_the_body(x: F32 at sample) -> F32 at sample {
  let ys = par i in 0 ..< 4 { prev~(nope * F32.round_from(i)) }  //~ E0302
  total(ys)
}

pub flow a_name_not_found_in_the_header(x: F32 at sample) -> F32 at sample {
  let ys = par i in 0 ..< NOPE { prev~(x * F32.round_from(i)) }  //~ E0302
  total(ys)
}
