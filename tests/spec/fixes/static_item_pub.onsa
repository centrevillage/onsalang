// E0020 for `pub static NAME: T = e` (S-620, row `static_item`): the visibility stays in front of the candidate
// (`pub const NAME: T = e`), and the main position is the `static`. The item is a public constant of the type `T`.
// After the candidate is applied the file has no diagnostic. One error.

pub static RATE: U32 = 48000                        //~ E0020

pub fn twice() -> U32 {
  RATE * 2
}
