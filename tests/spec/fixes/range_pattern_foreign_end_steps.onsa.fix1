// onsa.toml
// [test]
// spec = ["§7", "§18.1"]
// fixes = 1
//
// [[test.fix]]
// at = "49:5"
// code = "E0020"
// candidate = 1
// leaves = ["49:24 E0002"]
//
// [[test.fix]]
// at = "56:5"
// code = "E0020"
// candidate = 1
// leaves = ["56:11 E0002"]
//
// [[test.fix]]
// at = "63:5"
// code = "E0020"
// candidate = 1
// leaves = ["63:25 E0002"]
//
// [[test.fix]]
// at = "70:5"
// code = "E0020"
// candidate = 1
// leaves = ["70:26 E0002"]
//
// [[test.fix]]
// at = "77:5"
// code = "E0020"
// candidate = 1
// leaves = ["77:24 E0002"]

// W5-24 U4b (S-428, S-475): a range pattern whose end holds an increment or a decrement (`1..<++N`, `1..<(--3)`, `1..<-(--3)`, the start
// `(--3)` in parentheses, and `- --3` with a space after the minus) reads as an expression, so the error is the range's (E0020) and
// the candidate copies the end as it is written into a guard (§7: "修正候補は端をそのまま写し、端の形の誤りは当てた後の検査で報告する").
// The copy is the writer's text, not yet checked there (§18.1: "候補が写すか動かす部分 … に同じ段の別の誤り … があっても、形そのものが
// 読めれば候補を出し"), so the E0002 of the increment left in the guard, which has no candidate, does not take the candidate away
// (tests/spec/fixes/range_pattern_foreign_end_decrement.onsa is the `--3` without parentheses). `- --3` keeps its space (`---3`
// would be other tokens). The columns of `leaves` assume a name of one letter, as in range_pattern_foreign_end_forms.onsa.
// One error per function (P-01).

pub const N: I32 = 3

pub fn increment_end(x: I32) -> I32 {
  match x {
    v if 1 <= v && v < ++N => 1,                   //~ E0020
    _ => 0,
  }
}

pub fn decrement_start_in_parentheses(x: I32) -> I32 {
  match x {
    v if (--3) <= v && v < 5 => 1,                 //~ E0020
    _ => 0,
  }
}

pub fn decrement_end_in_parentheses(x: I32) -> I32 {
  match x {
    v if 1 <= v && v < (--3) => 1,                 //~ E0020
    _ => 0,
  }
}

pub fn negated_decrement_end(x: I32) -> I32 {
  match x {
    v if 1 <= v && v < -(--3) => 1,                //~ E0020
    _ => 0,
  }
}

pub fn minus_then_decrement_end(x: I32) -> I32 {
  match x {
    v if 0 <= v && v < - --3 => 1,                 //~ E0020
    _ => 0,
  }
}
