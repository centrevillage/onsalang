// onsa.toml
// [test]
// spec = ["§7", "§2.5", "§18.1"]
// fixes = 1

// S-876, S-886 (U4b of W5-09; R-388): the joined form `return x` of a `return` without a value (E0401 in a function that gives a value) is made when the body read again with it applied has no error of the stage of the types (§7, §18.1).
// The joined form decides the type of a variable (`let n = 5`, `n` is an `I64`) and the statements that follow read it with that type or do not read it, so the one candidate is made. The contexts: a loop body,
// a closure, a method and a generic function. The text after the candidate is not written here. One error per function (P-01); the marker is on the `return`.

pub struct P {
  x: I64,
}

pub fn joined_decides_a_type_that_a_later_cast_accepts(c: Bool) -> I64 {
  let n = 5
  if c {
    return                                          //~ E0401
    n
  }
  n as I64
}

pub fn joined_decides_a_type_that_a_later_let_accepts(c: Bool) -> I64 {
  let n = 5
  if c {
    return                                          //~ E0401
    n
  }
  let k: I64 = n
  k
}

pub fn joined_variable_is_not_read_again(c: Bool) -> I64 {
  let n = 5
  if c {
    return                                          //~ E0401
    n
  }
  0
}

pub fn joined_float_decides_a_type_that_a_later_let_accepts(c: Bool) -> F32 {
  let x = 1.5
  if c {
    return                                          //~ E0401
    x
  }
  let y: F32 = x
  y
}

pub fn joined_expression_with_a_variable(c: Bool) -> I64 {
  let n = 5
  if c {
    return                                          //~ E0401
    n * 2
  }
  n as I64
}

pub fn joined_in_a_loop_body(count: I32) -> I64 {
  let n = 5
  for i in 0 ..< count {
    return                                          //~ E0401
    n
  }
  n as I64
}

pub fn joined_in_a_closure(x: I32) -> I64 {
  let f = fn(a: I32) -> I64 {
    let n = 5
    if a > 0 {
      return                                        //~ E0401
      n
    }
    n as I64
  }
  f.(x)
}

impl P {
  pub fn get(self, c: Bool) -> I64 {
    let n = 5
    if c {
      return                                        //~ E0401
      n
    }
    n as I64
  }
}

fn pick[T: Num](x: T, c: Bool) -> T {
  if c {
    return                                          //~ E0401
    x
  }
  x
}
