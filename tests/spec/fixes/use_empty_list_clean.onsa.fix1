// S-515 (U6 of W5-11): an empty `use` list is the E0002 of the syntax stage, and the candidate takes out the whole
// `use` (§15.1), so the check of the whole file reports nothing after it (`clean`). The braces alone would not
// do: `use std.math` is a different program, it brings in `math`. The main position is the `{` of the list.
// The names the other `use`s bring in are used as before. The file has this one error, so the other forms of the
// empty list are in use_empty_list_forms.onsa (one unit a file for `clean`).

use std.array
use std.math.{sqrt}

pub fn root(x: F32) -> F32 {
  sqrt(x)
}

pub fn filled() -> [I32; 3] {
  array.from_fn(fn(i: U32) -> I32 { 1 })
}

pub fn double(x: I32) -> I32 {
  x * 2
}

                                     //~ E0002

pub fn after_it(x: I32) -> I32 {
  double(x)
}
