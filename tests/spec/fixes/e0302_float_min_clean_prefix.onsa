// E0302 for `F32.MIN` under a prefix `-` (§6.6): the candidate `-F32.MAX` inside the negation needs parentheses, because
// the candidate is itself a prefix expression: `-(-F32.MAX)`. No diagnostic is left after it.

pub fn highest() -> F32 {
  -F32.MIN                                          //~ E0302
}
