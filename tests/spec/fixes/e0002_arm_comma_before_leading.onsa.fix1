// onsa.toml
// [test]
// spec = ["§2.5", "§7", "§18.1"]
// fixes = 1
//
// [[test.fix]]
// at = "50:5"
// code = "E0002"
// candidate = 1
// leaves = ["50:5 E0020"]
//
// [[test.fix]]
// at = "58:5"
// code = "E0002"
// candidate = 1
// leaves = ["58:5 E0020"]
//
// [[test.fix]]
// at = "66:5"
// code = "E0002"
// candidate = 1
// leaves = ["66:5 E0020"]
//
// [[test.fix]]
// at = "74:5"
// code = "E0002"
// candidate = 1
// leaves = ["74:5 E0020"]

// The `[[test.fix]]` entries in the header name what a candidate leaves in its unit: a second misplaced
// token, reported by the next check (§18.1, S-236). The `at` and `leaves` positions are those of the spec
// (the misplaced token). The entries were commented out (`// # `) until W3-06/i made the check report
// the diagnostics.
//
// E0002: an arm without its `,` before a line that starts with `|` or `-` (spec §2.5, S-386). A `|` or a
// `-` at the start of a line is a binary operator that the writer meant to continue the line before
// (S-370, S-380: E0020, and the candidate moves it up). When the move would end the line before at
// the `=>` of the next arm (`0 => 2` and `-1 => 3` would be `0 => 2 -` and `1 => 3`: the arm body `2 - 1`
// and then a `=>`), the binary reading does not hold and the line is the head of the next arm, whose `,`
// is missing. The reading does not split, so the error is the general one of a missing `,` (S-384) with
// the `,` insertion as the only candidate (right after the last token of the line before it, before the
// line's comment), and the E0020 and its move are not made. The main position is the `|` or `-` that
// starts the line. The error of a `|` before the first alternative is left for the next check (S-383, the
// `[[test.fix]]` above): the `,` and then the removal of the `|`. The `-1` is a valid negative literal
// pattern, and nothing is left. One error in each declaration unit.

pub fn bar_after_a_plain_body(x: U32) -> U32 {
  match x {
    0 => 2,
    | 1 => 1,                                       //~ E0002
    _ => 0,
  }
}

pub fn bar_after_a_block_body(x: U32) -> U32 {
  match x {
    0 => { 1 },
    | 1 => 2,                                       //~ E0002
    _ => 0,
  }
}

pub fn bar_before_a_choice(x: U32) -> U32 {
  match x {
    0 => 1,
    | 1 | 2 => 3,                                   //~ E0002
    _ => 0,
  }
}

pub fn bar_after_a_comment(x: U32) -> U32 {
  match x {
    0 => 2,  // two
    | 1 => 1,                                       //~ E0002
    _ => 0,
  }
}

pub fn minus_after_a_block_body(x: I32) -> I32 {
  match x {
    0 => { 1 },
    -1 => 2,                                        //~ E0002
    _ => 0,
  }
}

pub fn minus_after_a_plain_body(x: I32) -> I32 {
  match x {
    0 => 2,
    -1 => 3,                                        //~ E0002
    _ => 0,
  }
}

pub fn minus_after_a_name_body(x: I32, a: I32) -> I32 {
  match x {
    0 => a,
    -1 => 2,                                        //~ E0002
    _ => 0,
  }
}

pub fn minus_after_a_comment(x: I32) -> I32 {
  match x {
    0 => 2,  // two
    -1 => 3,                                        //~ E0002
    _ => 0,
  }
}

pub fn minus_in_a_match_in_a_call(x: I32) -> I32 {
  id(match x {
    0 => { 1 },
    -1 => 2,                                        //~ E0002
    _ => 0,
  })
}

pub fn id(x: I32) -> I32 {
  x
}

pub fn minus_second_arm(x: I32) -> I32 {
  match x {
    0 => 1,
    1 => { 2 },
    -1 => 3,                                        //~ E0002
    _ => 0,
  }
}

// The right forms: the `,` ends each arm, and a `-` at the end of a line is a binary operator that goes on.
pub fn fine(x: I32, a: I32, b: I32) -> I32 {
  match x {
    0 => 2,
    1 => 3,
    -1 => 4,
    _ => a -
      b,
  }
}
