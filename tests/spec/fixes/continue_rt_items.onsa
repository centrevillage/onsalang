// onsa.toml
// [test]
// spec = ["§18.1", "§10", "§14.1", "§15.1"]
// fixes = 1

// `rt` before the declarations that this version does not support (W5-11 U4): a `trait`, an
// `effect`, a `handler`, an `extern` block, and `rt` before a member of an `extern` block that is
// not a function. The `rt` is one E0002 (§18.1, S-492) whose candidate removes it, whose main
// position is the `rt`, and the `rt` of `rt extern` is not moved to the members. The head is
// read on, so each declaration is a name of its kind (a trait, an effect, a handler; the `fn`
// of an `extern` block is a function and its `type` is a type), and the members of the `extern`
// block are names of the module (§18.1). The unit has a syntax error, so it raises no E0200 and
// its body is not checked. One error in each unit.
// (The same for the other keywords: continue_rt_decls.onsa.)

rt trait Shape {                                    //~ E0002 @1
  fn area(self) -> F32
}

rt effect Ef {                                      //~ E0002 @1
  fn op(x: I32) -> I32
}

rt handler hh: Ef {                                 //~ E0002 @1
  fn op(x: I32) -> I32 { zz }
}

rt extern "C" lib "m" {                             //~ E0002 @1
  fn c_abs(x: I32) -> I32
  type Raw
}

extern "C" lib "n" {
  rt type Handle                                    //~ E0002 @3
  fn c_open() -> Handle
}

fn takes_trait(x: Shape) -> I32 {                   //~ E0308
  1
}

fn takes_effect() -> I32 uses {Ef} {                //~ E0200
  1
}

fn takes_handler() -> I32 {
  let a = hh                                        //~ E0308
  1
}

fn calls_c() -> I32 {
  c_abs(1)
}

fn takes_raw(r: Raw) -> I32 {
  1
}

fn takes_handle(h: Handle) -> I32 {
  2
}

fn nested(c: Bool) -> I32 {
  let f = fn(x: I32) -> I32 { c_abs(x) }
  if c { f.(1) } else { takes_handle(c_open()) }
}

// The head is the declaration that was read: a real error of a use is reported.
fn too_many_arguments(r: Raw) -> I32 {
  takes_raw(r, r)                                   //~ E0412
}

fn own_error() -> I32 {
  c_abs(1) + zz                                     //~ E0302 @14
}
