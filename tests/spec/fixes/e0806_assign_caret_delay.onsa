// onsa.toml
// [test]
// spec = ["§11.2", "§18.1"]
// fixes = 1

// W7-04 U2/t, R-59, S-116: an assignment in a flow body (E0806, §11.2) that reads the target in the first argument of a delay (`y = prev~(^y) + x`) has the candidate `let`
// before it, and the unit is clean after it: the `^y` is a feedback reference of the `let` itself (§11.2: "定義中のものも含む"), with no error. The assignments that read the target outside
// a delay have no candidate (fixes/e0806_assign_caret_no_candidate.onsa). One error per flow (P-01): the candidate leaves no error of the unit, the check of each flow.

pub flow caret_in_a_delay(x: F32 at sample) -> F32 at sample {
  y = prev~(^y) + x                                 //~ E0806
  y
}

pub flow caret_in_a_delay_on_the_right(x: F32 at sample) -> F32 at sample {
  y = x + 0.5 * prev~(^y)                           //~ E0806
  y
}

pub flow caret_in_a_delay_line(x: F32 at sample) -> F32 at sample {
  acc = x + delay~(^acc, 2)                         //~ E0806
  acc
}

pub flow caret_in_a_variable_delay(x: F32 at sample, d: F32 at block) -> F32 at sample {
  y = x + vdelay~(^y, d, 8)                         //~ E0806
  y
}

pub flow caret_in_a_delay_after_a_let(x: F32 at sample) -> F32 at sample {
  let a = x * 2.0
  y = a + prev~(^y)                                 //~ E0806
  y
}
