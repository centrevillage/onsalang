// onsa.toml
// [test]
// spec = ["§5.2", "§18.1"]
// fixes = 1
// [[test.fix]]
// at = "14:18"
// code = "E0703"
// candidate = 1
// clean = true

// S-605, S-343 (§5.2): the `move` at the end of an arm of an `if` in an index is an E0703, and the one candidate removes it.

pub fn index(c: Bool, i: U32, xs: [F32; 4]) -> F32 {
  xs[if c { i } else { 0 }] //~ E0703
}
