// onsa.toml
// [test]
// spec = ["§6.1", "§18.1"]
// fixes = 1

// E0020 for a callee that is no path of names (§6.1), in two shapes of its start (W3-20/b):
// - parentheses that touch a word before them (`return(s.f)(x)`, `if(s.f)(x) > 0`): taking them
//   away would join the word and the name (`returns.f`), so the candidate keeps them and inserts
//   the `.` of `.(` (`return(s.f).(x)`; §18.1, the reading outside the edits stays);
// - an `if` whose last block ends the callee: the diagnostic starts at the `if`, the start of the
//   whole callee, not at its last block (S-316).
// One error per function (P-01).

pub struct Shaper {
  f: fn(I32) -> I32,
}

pub fn inc(x: I32) -> I32 {
  x + 1
}

pub fn after_return(s: Shaper, x: I32) -> I32 {
  return(s.f).(x)                                    //~ E0020
}

pub fn after_if(s: Shaper, x: I32) -> I32 {
  if(s.f).(x) > 0 { 1 } else { 2 }                   //~ E0020
}

pub fn after_move(f: fn(I32) -> I32, x: I32) -> I32 {
  let a = move(f).(x)                                //~ E0020
  a
}

pub fn an_if_as_the_callee(c: Bool, x: I32) -> I32 {
  if c { inc } else {                               //~ E0020
    inc
  }.(x)
}
