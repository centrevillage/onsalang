// onsa.toml
// [test]
// spec = ["§11.2", "§11.5", "§18.1"]
// fixes = 1

// W7-07 U2 (from U1, R-03): E0801 in the body of a `par~` has the candidates of §11.2 as outside it, now that a `^name` of a
// later `let` may stand in the first argument of a delay in a `par~` (W7-07 U1 took off the E0200 of that form). A name used before
// its `let` inside the first argument of a delay has the candidate that inserts `^`; a `^name` outside the first argument of a
// delay has the candidate `prev~(^name)`. Each flow is clean after its candidate (§18.1). One error per flow (P-01).

pub flow forward_in_a_delay_in_a_par(x: F32 at sample) -> F32 at sample {
  let a = par~ i in 0 ..< 2 { prev~(b) + x * F32.round_from(i) }     //~ E0801
  let b = x * 0.5
  a[0] + a[1]
}

pub flow caret_outside_a_delay_in_a_par(x: F32 at sample) -> F32 at sample {
  let a = par~ i in 0 ..< 2 { ^b + x * F32.round_from(i) }           //~ E0801
  let b = x * 0.5
  a[0] + a[1]
}

pub flow fine(x: F32 at sample) -> F32 at sample {
  let a = par~ i in 0 ..< 2 { prev~(^b) + x * F32.round_from(i) }
  let b = x * 0.5
  a[0] + a[1]
}
