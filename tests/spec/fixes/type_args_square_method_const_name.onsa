// onsa.toml
// [test]
// spec = ["§4.5", "§6.2", "§18.1"]
// fixes = 1

// W5-10 U3b (S-974, the line of the method): the const argument of a method written as the name of a constant in square brackets, `v.arr[K]()`,
// is the E0020 of the type stage with a candidate. The content is one name that is a constant, the kind a const parameter takes, so nothing of
// the type stage or before is left after the candidate (§4.5: "名前の段で見つける形の修正候補は、中身が一つの名前か整数のリテラルで、…ときだけ出す。… メソッドの形も
// 同じ"; §18.1). The one candidate puts `::` before the `[` (`v.arr::[K]()`). It is the change of S-974: the method gave no candidate to the
// name of a constant and gave it to the literal (tests/spec/fixes/type_args_square_method_const_literal.onsa), the line of the function gives it to both.
// Every function of the file has the name of a constant, so that `fixes = 1` is not met by a function with a literal. The receiver is an argument,
// `self`, a field of a field, an element of an array, the result of a function and a constant. One error per function (P-01).

pub struct V {
  n: U8,
}

pub struct Holder {
  v: V,
}

pub const K: U32 = 4

pub const KV: V = V { n: 2 }

impl V {
  pub fn arr[const N: U32](self) -> [U8; N] {
    [self.n; N]
  }

  pub fn through_self(self) -> [U8; 4] {
    self.arr[K]()                                   //~ E0020
  }
}

pub fn mk() -> V {
  V { n: 1 }
}

pub fn an_argument(v: V) -> [U8; 4] {
  v.arr[K]()                                        //~ E0020
}

pub fn a_local_binding() -> [U8; 4] {
  let v = mk()
  v.arr[K]()                                        //~ E0020
}

pub fn a_field_of_a_field(h: Holder) -> [U8; 4] {
  h.v.arr[K]()                                      //~ E0020
}

pub fn an_element_of_an_array(vs: [V; 2]) -> [U8; 4] {
  vs[0].arr[K]()                                    //~ E0020
}

pub fn the_result_of_a_function() -> [U8; 4] {
  mk().arr[K]()                                     //~ E0020
}

pub fn a_constant() -> [U8; 4] {
  KV.arr[K]()                                       //~ E0020
}

pub fn in_a_closure(v: V) -> [U8; 4] {
  let g = fn(u: V) -> [U8; 4] { u.arr[K]() }        //~ E0020
  g.(v)
}

pub fn in_an_if_arm(v: V, c: Bool) -> [U8; 4] {
  if c {
    v.arr[K]()                                      //~ E0020
  } else {
    [0; 4]
  }
}

test "the const argument of a method as a name of a constant in square brackets" {
  let v = mk()
  let a = v.arr[K]()                                //~ E0020
  assert a.len() == 4
}

pub fn fine(v: V) -> [U8; 4] {
  v.arr::[K]()
}
