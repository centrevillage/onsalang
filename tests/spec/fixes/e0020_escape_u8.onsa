// onsa.toml
// [test]
// spec = ["§2.4", "§18.1"]
// fixes = 1

// E0020 for the escape `\U` and eight hexadecimal digits of C, C++, C# and Python (spec §2.4, §18.1; S-461,
// S-965 R1; the row `escape_fixed_width` of spec/foreign-forms.toml). The value is the same in every language
// that has the form (JavaScript has no `\U`, so its reading does not count), so the one candidate is the escape
// of the same value, `\u{…}`. The eight digits are all of the form: a character after them is a plain
// character, also a hexadecimal digit. The value is a scalar value: from 0 to 10FFFF, not a surrogate. The
// digits may be in either case. One error per function (P-01). The marker is the line only. The values that are
// no scalar value (`\U00110000`, `\U0000D800`) are E0001 and are in negative/lex_escape_foreign_split.onsa.

pub fn emoji() -> Str {
  "\U0001F600"                                      //~ E0020
}

pub fn emoji_in_lower_case() -> Str {
  "\U0001f600"                                      //~ E0020
}

pub fn ascii_with_leading_zeros() -> Str {
  "\U00000041"                                      //~ E0020
}

pub fn zero() -> Str {
  "\U00000000"                                      //~ E0020
}

pub fn last_scalar_value() -> Str {
  "\U0010FFFF"                                      //~ E0020
}

pub fn first_of_the_supplementary_planes() -> Str {
  "\U00010000"                                      //~ E0020
}

pub fn last_below_the_surrogates() -> Str {
  "\U0000D7FF"                                      //~ E0020
}

pub fn first_above_the_surrogates() -> Str {
  "\U0000E000"                                      //~ E0020
}

pub fn a_digit_after_the_eight() -> Str {
  "\U0001F6001"                                     //~ E0020
}

pub fn a_hexadecimal_letter_after_the_eight() -> Str {
  "\U0001F600F"                                     //~ E0020
}

pub fn a_non_hexadecimal_letter_after_the_eight() -> Str {
  "\U0001F600z"                                     //~ E0020
}

pub fn text_around() -> Str {
  "before \U0001F600 after"                         //~ E0020
}

pub fn after_a_valid_escape() -> Str {
  "\t\U0001F600"                                    //~ E0020
}

pub fn after_a_multi_byte_character() -> Str {
  "日本\U0001F600"                                   //~ E0020
}

pub fn before_a_hole(x: U32) -> Str uses {Alloc} {
  "\U0001F600{x}"                                   //~ E0020
}

pub fn after_a_hole(x: U32) -> Str uses {Alloc} {
  "{x}\U0001F600"                                   //~ E0020
}

// The right forms: the braced escape, and the text of a form behind an escaped backslash.
pub fn fine(x: U32) -> Str uses {Alloc} {
  "\u{1F600}\u{10FFFF}\\U0001F600{x}"
}
