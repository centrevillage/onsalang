// S-327 (W5-11 U10i/t, §2.5, §4.5, the row `type_position_path` of spec/foreign-forms.toml): the one candidate of a type with a line
// break after its `::` (`Buf::` and then `[F32]`) takes the `::` and the line break out (`Buf[F32]`), and nothing is left
// behind (`clean`, S-253). The main position is the `::`. A file with one unit, so that `clean` looks at the whole file.

pub fn f(b: Buf::   //~ E0020
  [F32]) -> U32 {
  b.len()
}
