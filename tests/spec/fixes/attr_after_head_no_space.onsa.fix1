// W5-24 U4b (S-990, S-475): an attribute written right after the visibility with no space between (`pub@fp(strict) fn h`) gets the
// same candidate as with a space (tests/spec/fixes/attr_after_head_default_name.onsa): the attribute moves to the head, and the
// visibility keeps one space before the name (`@fp(strict) pub fn h`). What the candidate writes at the head is the writer's text,
// not yet checked there (S-475, 137th supplement), so the E0005 of the value left at the attribute moved does not take the candidate
// away, and the walk of the candidates ends clean in two steps (`@fp(strict)` is taken out next), with no undo. `@nope` is
// the same move and leaves the E0005 of an unknown attribute. One error per function (P-01).

@fp(strict) pub fn h() -> F32 {      //~ E0002
  1.0
}

@nope pub fn g() -> I32 {            //~ E0002
  1
}
