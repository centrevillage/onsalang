// onsa.toml
// [test]
// spec = ["§2.4", "§2.5", "§6.1", "§18.1"]
// fixes = 1

// E0002 for a space or a line break between a tuple index and a `(`, inside a list (§2.5, S-606): the
// `(` of a call is written right after a path of names that can be a callee, and a path that ends with
// a tuple index (`t.0`) is not one, so the `(` after it starts a second element, as after `)` or `]`:
// a `,` is missing. The one candidate inserts the `,` after the tuple index. A candidate that removes
// the gap is not offered: `t.0(x)` is no call that reads (it is the E0020 of
// e0020_callee_tuple_index.onsa), as `(1, 2)(3, 4)` is not (e0002_comma_missing.onsa). The error is
// the same after a name, a field, a call and an element, and before any name is looked up. Outside a
// list the same gap is in tests/spec/negative/callee_tuple_index_gap.onsa; a `[` after the tuple
// index is in e0002_callee_tuple_index_gap_index.onsa. One error per function (P-01).

pub struct Pair {
  t: (fn(I32) -> I32, I32),
}

pub fn inc(x: I32) -> I32 {
  x + 1
}

pub fn mk2() -> (fn(I32) -> I32, I32) {
  (inc, 1)
}

pub fn two(a: I32, b: I32) -> I32 {
  a + b
}

pub fn a_space_after_a_name(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  two(t.0, (x), 1)                                   //~ E0002
}

pub fn a_space_after_a_field(p: Pair, x: I32) -> I32 {
  two(p.t.0, (x), 1)                                 //~ E0002
}

pub fn a_space_after_the_result_of_a_call(x: I32) -> I32 {
  two(mk2().0, (x), 1)                               //~ E0002
}

pub fn a_space_after_an_element(ts: [(fn(I32) -> I32, I32); 2], x: I32) -> I32 {
  two(ts[0].0, (x), 1)                               //~ E0002
}

pub fn a_wide_space(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  two(t.0,     (x), 1)                               //~ E0002
}

pub fn a_tab(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  two(t.0,	(x), 1)                                   //~ E0002
}

pub fn a_line_break(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  two(t.0,
    (x), 1)                                         //~ E0002
}

pub fn in_an_array(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  let v = [t.0, (x), 2]                              //~ E0002
  v[0]
}

pub fn in_a_tuple(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  let u = (t.0, (x), 2)                              //~ E0002
  u.1
}

pub fn in_a_closure_body(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  let g = fn(u: (fn(I32) -> I32, I32), y: I32) -> I32 { two(u.0, (y), 1) }  //~ E0002
  g.(t, x)
}

pub fn after_a_name_that_is_not_defined(x: I32) -> I32 {
  two(nope.0, (x), 1)                                //~ E0002
}

pub fn fine(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  two(t.0.(x), t.1)
}
