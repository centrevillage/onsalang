// E0401 for `a <= b` where `T` has no bound (§6.3: `<` `<=` `>` `>=` are `PartialOrd`, not a number trait). The one
// candidate is `T: PartialOrd`; no diagnostic is left after it.

pub fn at_most[T: PartialOrd](a: T, b: T) -> Bool {
  a <= b                                            //~ E0401
}
