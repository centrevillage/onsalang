// onsa.toml
// [test]
// spec = ["§2.2", "§18.1"]
// fixes = 1

// E0020 for `static NAME: T = e` with several types `T` (S-620, row `static_item`): a float, a `Bool` and an array. Each item
// is a constant of its own type for the names stage, and the places that use it (an expression, a branch, a `flow` body)
// get no diagnostic. The initializers are not checked. One error in each unit.

static GAIN: F32 = 0.5                              //~ E0020

static ON: Bool = true                              //~ E0020

static TABLE: [I32; 3] = [1, 2, 3]                  //~ E0020

pub flow scaled(x: F32 at sample) -> F32 at sample {
  x * GAIN
}

pub fn on() -> Bool {
  ON
}

pub fn pick(c: Bool) -> I32 {
  if c && ON { TABLE[1] } else { 0 }
}
