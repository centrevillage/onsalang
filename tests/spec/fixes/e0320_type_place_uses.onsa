// W4-04 U10c (S-729, R-304, S-82, R-87 (5)): a local binding or a parameter written at a type place of a
// body is a name found there (§5.1), a value: E0308 at a type (§15.1), E0417 in a constant expression
// (§4.5). It is a use of the binding, so the candidate of the E0320 of its name renames it with the
// declaration and the uses as a value. Applied alone, it leaves no E0302 "cannot find" of the old name:
// what is left in the unit is the E0308 or the E0417 of the place, under the new name (`leaves`; an E0417
// is of the types stage, after the E0320, and is not compared). The bindings are a parameter, a `let`, a
// `for` (with a leading `_`: a capital name in a pattern is a path, §7) and the parameter of an anonymous
// function; the places are an annotation, the target of an `as`,
// an array length, a const argument, the type of a function value and the type of a parameter of an
// anonymous function. One error per unit (§18.1), so each is in its own unit. The text after the candidates
// is the copy `.fix1` of the implementation.

pub struct Ring[T, const N: U32] {
  data: [T; N],
  head: U32,
}

fn inc(x: I32) -> I32 {
  x + 1
}

pub fn parameter_in_a_length(N: U32) -> U32 { //~ E0320
  let _: [F32; N] = [0.0; 3]
  N
}

pub fn parameter_in_an_annotation(Q: I32) -> I32 { //~ E0320
  let _: Q = 3
  Q
}

pub fn let_as_a_cast_target(x: I32) -> I32 {
  let _k = 2 //~ E0320
  let _ = x as _k
  _k
}

pub fn let_in_a_const_argument() -> U32 {
  let _n: U32 = 4 //~ E0320
  let _: Ring[F32, _n] = Ring { data: [0.0; 4], head: 0 }
  _n
}

pub fn for_in_a_length(n: U32) -> U32 {
  var s: U32 = 0
  for _i in 0 ..< n { //~ E0320
    let _: [F32; _i] = [0.0; 4]
    s = s + _i
  }
  s
}

pub fn let_in_a_function_type() -> I32 {
  let _t = 1 //~ E0320
  let _: fn(_t) -> I32 = inc
  _t
}

pub fn closure_parameter_in_a_closure_parameter_type() -> I32 {
  let f = fn(V: I32) -> I32 { //~ E0320
    let g = fn(y: V) -> I32 { y }
    g.(V)
  }
  f.(1)
}
