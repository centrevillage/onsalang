// onsa.toml
// [test]
// spec = ["§3.1", "§3.3", "§4.5", "§4.7", "§7", "§11.5", "§18.1"]
// fixes = 1

// E0413 for a conversion function of a pair that `as` can write (§3.3), inside the other forms of a body: a function
// passed as an argument (a closure that captures), the first branch of an `if` and the first arm of a `match` (the
// type that the return type expects reaches them, §4.7), a loop, a call in an argument, a type parameter, the body
// of a `par~` in a flow, the condition of an `if`, and a `test` block. The candidate is the same as outside them (the
// `as` form, in parentheses where it is the operand of an operator), and the runner applies it and checks that
// nothing is left. The later branches and arms are not here (S-880). One error in each function (P-01).

pub fn apply(f: fn(F32) -> F64) -> F64 {
  f.(1.0)
}

pub fn apply_wide(f: fn(I32) -> I64) -> I64 {
  f.(1)
}

pub fn id64(v: F64) -> F64 {
  v
}

pub fn in_a_closure_that_captures(a: F64) -> F64 {
  apply(fn(y: F32) -> F64 { (y as F64) + a })    //~ E0413
}

pub fn in_the_tail_of_a_closure() -> I64 {
  apply_wide(fn(m: I32) -> I64 { m as I64 })  //~ E0413
}

pub fn in_the_first_branch(c: Bool, n: I32) -> I64 {
  if c { n as I64 } else { 0 }            //~ E0413
}

pub fn in_the_first_branch_of_an_option(c: Bool, n: I32) -> Option[I64] {
  if c { Some(n as I64) } else { None }         //~ E0413
}

pub fn in_the_first_arm(o: Option[I32]) -> I64 {
  match o {
    Some(v) => v as I64,                  //~ E0413
    None => 0,
  }
}

pub fn in_a_loop(n: U32, a: F64) -> F64 {
  var acc = a
  for i in 0 ..< n {
    acc = acc + (i as F64)                   //~ E0413
  }
  acc
}

pub fn in_a_nested_call(x: F32, a: F64) -> F64 {
  id64((x as F64) + a)                       //~ E0413
}

pub fn with_a_type_parameter[T](x: F32, t: T) -> F64 {
  let _ = t
  (x as F64) + 1.0                           //~ E0413
}

pub fn in_a_condition(x: F32, a: F64) -> F64 {
  if (x as F64) < a { 1.0 } else { 2.0 }     //~ E0413
}

pub flow in_a_par(x: F32 at sample) -> F64 at sample {
  let ys = par~ i in 0 ..< 2 { (x as F64) + 1.0 }  //~ E0413
  ys[0]
}

test "widen" {
  let x: F32 = 1.5
  assert (x as F64) == 1.5                   //~ E0413
}
