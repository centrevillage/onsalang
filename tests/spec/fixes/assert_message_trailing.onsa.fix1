// clean = true

// E0020 for `assert!(a, "m") && b` (S-879, in the syntax stage). The form of Rust ends at the `)` that closes `!(`, as in
// `assert_bang`, and the tokens after it stay: the one candidate drops the message, the `!(` and the `)`, and the file has
// no diagnostic after it.

pub fn both(a: Bool, b: Bool) {
  assert a && b                              //~ E0020
}
