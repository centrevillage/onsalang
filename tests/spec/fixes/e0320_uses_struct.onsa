// onsa.toml
// [test]
// spec = ["§2.3", "§4.4", "§6.2", "§18.1"]
// fixes = 1
// [[test.fix]]
// at = "25:12"
// code = "E0320"
// candidate = 1
// clean = true

// W4-04 U9, S-82, R-87 (5): the one candidate of an E0320 on a struct renames the declaration and
// every use of the name in the module, and the file is clean after it (`clean`). The uses are in
// every place a type name is written: a parameter and a return type, a field of another struct, a type
// argument, the right side of a type alias, a `let` annotation, the head of an `impl`, the head of a
// struct literal and of a struct pattern (in a `let` and in a `match`), and a type in a closure. The
// name has a capital letter at its start, as a head of a literal or of a pattern needs one (§2.3).
// Each use is in a unit of its own that has no other error.

pub struct Other {
  inner: Bad_Type,
}

type Alias = Bad_Type

pub struct Bad_Type { //~ E0320
  x: F32,
}

impl Bad_Type {
  pub fn get(self) -> F32 {
    self.x
  }
}

pub fn parameter(p: Bad_Type) -> F32 {
  p.x
}

pub fn returned(x: F32) -> Bad_Type {
  Bad_Type { x: x }
}

pub fn through_alias(a: Alias) -> F32 {
  a.x
}

pub fn through_other(o: Other) -> F32 {
  o.inner.x
}

pub fn type_argument(o: Option[Bad_Type]) -> F32 {
  match o {
    Some(p) => p.x,
    None => 0.0,
  }
}

pub fn annotation(x: F32) -> F32 {
  let p: Bad_Type = Bad_Type { x: x }
  p.x
}

pub fn struct_pattern(p: Bad_Type) -> F32 {
  let Bad_Type { x: a } = p
  a
}

pub fn struct_pattern_in_match(p: Bad_Type) -> F32 {
  match p {
    Bad_Type { x: a } => a,
  }
}

pub fn array_of(xs: [Bad_Type; 2]) -> F32 {
  xs[0].x + xs[1].x
}

pub fn in_a_closure(p: Bad_Type) -> F32 {
  apply(fn(q: Bad_Type) -> F32 { q.x }, p)
}

fn apply(f: fn(Bad_Type) -> F32, p: Bad_Type) -> F32 {
  f.(p)
}
