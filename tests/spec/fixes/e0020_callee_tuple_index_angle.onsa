// onsa.toml
// [test]
// spec = ["§2.3", "§4.5", "§6.1", "§18.1"]
// fixes = 1

// E0020 for the type arguments of other languages after a tuple index that ends the callee (§4.5,
// S-606): `::[` cannot be written after a tuple index, so the one candidate drops the type arguments
// and calls the function value with `.(` (`t.0<I32>(x)` becomes `t.0.(x)`; the type of a function
// value is not generic, so dropping them changes no type). The syntax alone decides, whatever stands
// before the index, as for `(e)<I32>(x)` (e0020_type_args_callee.onsa). The forms with `::[`
// are in tests/spec/negative/callee_tuple_index_type_args.onsa. One error per function (P-01).

pub struct Pair {
  t: (fn(I32) -> I32, I32),
}

pub fn inc(x: I32) -> I32 {
  x + 1
}

pub fn mk2() -> (fn(I32) -> I32, I32) {
  (inc, 1)
}

pub fn two(a: I32, b: I32) -> I32 {
  a + b
}

pub fn angle_after_a_name(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  t.0<I32>(x)                                       //~ E0020
}

pub fn angle_after_a_field(p: Pair, x: I32) -> I32 {
  p.t.0<I32>(x)                                     //~ E0020
}

pub fn angle_after_the_result_of_a_call(x: I32) -> I32 {
  mk2().0<I32>(x)                                   //~ E0020
}

pub fn angle_after_an_element(ts: [(fn(I32) -> I32, I32); 2], x: I32) -> I32 {
  ts[0].0<I32>(x)                                   //~ E0020
}

pub fn angle_with_two_type_arguments(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  t.0<I32, U8>(x)                                   //~ E0020
}

pub fn angle_in_an_argument(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  two(t.0<I32>(x), 1)                               //~ E0020
}

pub fn turbofish_after_a_name(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  t.0::<I32>(x)                                     //~ E0020
}

pub fn turbofish_after_the_result_of_a_call(x: I32) -> I32 {
  mk2().0::<I32>(x)                                 //~ E0020
}

pub fn angle_after_a_name_that_is_not_defined(x: I32) -> I32 {
  nope.0<I32>(x)                                    //~ E0020
}

pub fn fine(t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  t.0.(x)
}
