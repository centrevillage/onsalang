// The candidate for the decimal integer `1'000'000` (the candidate is `1_000_000`) leaves nothing behind (spec §2.4, §18.1; S-476):
// the check of the file after the candidate reports nothing (`clean`, S-253). A file with one unit, so that
// `clean` looks at the whole file. The main position is the first digit of the number.

pub fn f() -> I32 {
  let n: I32 = 1'000'000                            //~ E0020
  n
}
