// E0302 for `T.MIN` under a prefix `-` where `T: Float`: the same parentheses (§6.6), `-(-T.MAX)`. No diagnostic is left
// after it.

pub fn highest[T: Float](x: T) -> T {
  -(-T.MAX)                                            //~ E0302
}
