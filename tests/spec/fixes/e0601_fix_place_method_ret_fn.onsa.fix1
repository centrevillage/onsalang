// §8.1, S-364 and R-455: a method whose result is a function type, as `e0601_fix_place_ret_fn`:
// `-> (fn(I32) -> I32) uses {Alloc}`.

pub struct S { x: I32 }

pub fn bump(y: I32) -> I32 uses {Alloc} { y }

pub fn kk(y: I32) -> I32 { y }

impl S {
  pub fn m(self) -> (fn(I32) -> I32) uses {Alloc} {
    let _ = bump(self.x)                            //~ E0601 @13
    kk
  }
}
