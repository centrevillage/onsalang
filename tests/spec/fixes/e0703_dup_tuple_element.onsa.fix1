// fixes = 1
// [[test.fix]]
// at = "14:9"
// code = "E0703"
// candidate = 1
// clean = true

// S-795 (§5.2): a `move` on a Copy value in the element of a tuple literal is an E0703 at the operand of the `move`, and the one candidate removes it.

pub fn tuple(n: U32) -> (U32, U32) {
  (n, 1) //~ E0703
}
