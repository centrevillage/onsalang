// onsa.toml
// [test]
// spec = ["§2.4", "§18.1", "§7", "§11.5"]
// fixes = 2

// E0020 for an integer that starts with 0, and for the prefix `0o` of octal numbers (spec §2.4, §18.1; S-63,
// R-124, S-62, R-73). A decimal integer does not start with 0 unless it is `0` itself: C, Go and Java read `017`
// as the octal 15 and Rust as the decimal 17, and the readings differ, so it is an error with two candidates,
// the decimal reading first (`17`) and the octal reading second (`15`). Where the readings are the same
// (`00`, `000`) there is one candidate, `0`. The prefix `0o` is no prefix of Onsa: `0o17` is an error with one
// candidate, the value in decimal (`15`). The candidate keeps the value and the kind (integer), and the `-`
// in front of a literal stays where it is. The main position is the first digit of the literal. A float with a
// zero in front of its integer part (`01.5`, `00.5`) is no error (the right forms at the end). One error per
// declaration (P-01). The places: a `let`, an argument, a return, a field, an element, an operand, a `const`, a
// pattern, a closure body, a block in a block, a generic function, a range header of `for` and of `par`.

pub struct Pair {
  a: I32,
  b: I32,
}

fn takes(x: I32) -> I32 {
  x
}

pub fn leading_zero_in_a_let() -> I32 {
  let n: I32 = 17                                   //~ E0020
  n
}

pub fn ten_or_eight() -> I32 {
  let n: I32 = 10                                   //~ E0020
  n
}

pub fn hundred_or_sixty_four() -> I32 {
  let n: I32 = 100                                  //~ E0020
  n
}

pub fn permissions_of_a_file() -> I32 {
  let n: I32 = 777                                  //~ E0020
  n
}

pub fn two_zeros_in_front() -> I32 {
  let n: I32 = 17                                   //~ E0020
  n
}

pub fn eight_digits() -> I32 {
  let n: I32 = 1234567                              //~ E0020
  n
}

pub fn two_zeros() -> I32 {
  let n: I32 = 0                                    //~ E0020
  n
}

pub fn three_zeros() -> I32 {
  let n: I32 = 0                                    //~ E0020
  n
}

pub fn octal_prefix_in_a_let() -> I32 {
  let n: I32 = 15                                   //~ E0020
  n
}

pub fn octal_prefix_with_three_digits() -> I32 {
  let n: I32 = 511                                  //~ E0020
  n
}

pub fn octal_prefix_and_zero() -> I32 {
  let n: I32 = 0                                    //~ E0020
  n
}

pub fn under_a_minus() -> I32 {
  let n: I32 = -17                                  //~ E0020
  n
}

pub fn octal_prefix_under_a_minus() -> I32 {
  let n: I32 = -15                                  //~ E0020
  n
}

pub fn leading_zero_in_an_argument() -> I32 {
  takes(17)                                         //~ E0020
}

pub fn octal_prefix_in_an_argument() -> I32 {
  takes(15)                                         //~ E0020
}

pub fn leading_zero_in_a_return() -> I32 {
  17                                                //~ E0020
}

pub fn leading_zero_in_an_early_return(flag: Bool) -> I32 {
  if flag {
    return 17                                       //~ E0020
  }
  0
}

pub fn leading_zero_in_a_field() -> Pair {
  Pair { a: 1, b: 17 }                              //~ E0020
}

pub fn leading_zero_in_an_array() -> [I32; 2] {
  [1, 17]                                           //~ E0020
}

pub fn octal_prefix_in_a_tuple() -> (I32, I32) {
  (15, 2)                                           //~ E0020
}

pub fn leading_zero_as_an_operand(x: I32) -> I32 {
  x + 17                                            //~ E0020
}

pub fn leading_zero_in_a_comparison(x: I32) -> Bool {
  x < 17                                            //~ E0020
}

pub fn leading_zero_in_a_pattern(x: I32) -> I32 {
  match x {
    17 => 1,                                        //~ E0020
    _ => 0,
  }
}

pub fn octal_prefix_in_a_pattern(x: I32) -> I32 {
  match x {
    15 => 1,                                        //~ E0020
    _ => 0,
  }
}

pub fn leading_zero_in_an_arm(x: I32) -> I32 {
  match x {
    0 => 17,                                        //~ E0020
    _ => 0,
  }
}

pub fn leading_zero_in_a_branch(flag: Bool) -> I32 {
  if flag { 1 } else { 17 }                         //~ E0020
}

pub fn leading_zero_in_a_closure_body() -> I32 {
  let f = fn(y: I32) -> I32 { 17 }                  //~ E0020
  f.(1)
}

pub fn octal_prefix_in_a_closure_body() -> I32 {
  let f = fn(y: I32) -> I32 { 15 }                  //~ E0020
  f.(1)
}

pub fn leading_zero_in_a_block_in_a_block() -> I32 {
  let r: I32 = {
    let s: I32 = {
      17                                            //~ E0020
    }
    s
  }
  r
}

pub fn leading_zero_in_a_generic_function[T](x: T) -> T {
  let n: I32 = 17                                   //~ E0020
  x
}

pub fn leading_zero_in_a_for_header() -> I32 {
  var s: I32 = 0
  for i in 0..<17 {                                 //~ E0020
    s = s + i
  }
  s
}

pub fn octal_prefix_in_a_for_header() -> I32 {
  var s: I32 = 0
  for i in 15..<20 {                                //~ E0020
    s = s + i
  }
  s
}

pub flow leading_zero_in_a_par_header(x: F32 at sample) -> [F32; 8] at sample {
  par i in 0..<10 {                                 //~ E0020
    x * i.round_f32()
  }
}

pub flow octal_prefix_in_a_par_header(x: F32 at sample) -> [F32; 8] at sample {
  par i in 0..<8 {                                  //~ E0020
    x * i.round_f32()
  }
}

const LEADING_ZERO_IN_A_CONST: I32 = 17             //~ E0020

const OCTAL_PREFIX_IN_A_CONST: I32 = 15             //~ E0020

pub fn in_a_repeated_element() -> [I32; 4] {
  let a: [I32; 4] = [17; 4]                         //~ E0020
  a
}

// The right forms: `0` itself, a float with zeros in front of its integer part, a number with a separator
// after a nonzero digit, and the numbers that look like these but start with a nonzero digit.
pub fn fine() -> F32 {
  let _: I32 = 0
  let _: I32 = 10
  let _: I32 = 17
  let d: F32 = 00.5
  let e: F32 = 01.5
  let f: F32 = 007.25
  let g: F32 = 0.0
  let _: I32 = 0x0F
  let _: I32 = 0b0101
  let _: I32 = 1_017
  d + e + f + g
}
