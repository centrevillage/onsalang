// W5-24 U3b, S-990, S-834 (spec §18.1, §6.5): an attribute after `pub` or `rt` whose contents read as they would at the head of the
// declaration, but whose value is out of the list of the attribute (`@fp(1)`, `@fp(f(1))`, `@fp(relaxed, 1 +)`, `@fp(relaxed strict)`,
// `@export(1)`, `@repr(1)`, `@repr(c, 1 +)`), is the E0002 of its place with the one candidate that moves it before the visibility and
// `rt`; the E0005 of the value is left after the move, at the attribute moved (`leaves`: the first column of the line). One error in
// each declaration unit (P-01).

pub @fp(relaxed, 1 +) fn list_and_more_fn(x: F32) -> F32 {   //~ E0002
  x
}

pub rt @fp(relaxed, 1 +) fn list_and_more_rt(x: F32) -> F32 {   //~ E0002
  x
}

pub @fp(relaxed, 1 +) flow list_and_more_flow(x: F32 at sample) -> F32 at sample {   //~ E0002
  x
}

pub @repr(c, 1 +) struct ListAndMoreStruct {   //~ E0002
  x: I32,
}

pub @fp(1) fn number(x: F32) -> F32 {   //~ E0002
  x
}

pub @fp(f(1)) fn call(x: F32) -> F32 {   //~ E0002
  x
}

pub @fp(relaxed strict) fn two_values(x: F32) -> F32 {   //~ E0002
  x
}

pub @export(1) fn exported(x: F32) -> F32 {   //~ E0002
  x
}

pub @repr(1) struct NumberRepr {   //~ E0002
  x: I32,
}
