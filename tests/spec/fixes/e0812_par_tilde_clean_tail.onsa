// onsa.toml
// [test]
// spec = ["§2.6", "§11.5", "§18.1"]
//
// [[test.fix]]
// at = "18:3"
// code = "E0812"
// candidate = 1
// clean = true

// W7-06 U0/t, S-1177: a `par~` without state as the tail of a flow (the output). The one error of the file has the one candidate, the removal of the `~` of the
// `par~` (§11.5: "含まない `par~` は E0812 で `~` を外す修正候補を示す"), and the file with it checks clean
// (`clean` is about the whole file, so the file has this one error and no other unit with a candidate; §18.1: "当てた後に
// 同じ段か前の段の誤りが残らないとき"). The main position (`at`) is the start of the `par~`, the head of the
// replication (the provisional place of the E0812 of a `par~`, S-392). One error per flow (P-01).

pub flow replicas(x: F32 at sample) -> [F32; 4] at sample {
  par~ i in 0 ..< 4 { x * F32.round_from(i) }           //~ E0812
}
