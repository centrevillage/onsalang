// onsa.toml
// [test]
// spec = ["§15.1", "§18.1"]

// E0302 for a path with no `use`, with no candidate when the candidate would close a cycle (R-39, §15.1,
// §18.1). The candidate of such an E0302 adds `use b` (the name has to be taken for the path to be
// found). Here that `use` would make this module depend on `b`, and `b` depends on this module
// (b.onsa has `use a.{f}`), so the cycle (E0310) would be left after the candidate is applied, and the
// candidate is not given (the case runner applies any candidate that is given and finds the cycle; the
// count is checked in crates/onsa_cli/tests/use_cycles.rs). The package has no cycle as written.

pub fn f() -> I32 {
  b.g()                                             //~ E0302
}
