// onsa.toml
// [test]
// spec = ["§7", "§18.1"]
// fixes = 1

// E0020 for the rest `..` in a struct pattern (§7): a pattern names the fields it reads, and the rest is ignored by
// the last `_` (S-903, control/struct_rest_forms.onsa) or each field is written as `_`. The fields left here are all
// visible, so the candidate lists the remaining fields with `_`, in the order of the declaration (a field that is
// not visible makes the candidate the last `_` in place of the `..`, packages/visibility_field_rest/).

pub struct P3 {
  x: I32,
  y: I32,
  z: I32,
}

pub fn rest_pattern(p: P3) -> I32 {
  match p {
    P3 { x: px, .. } => px,                         //~ E0020
  }
}

pub fn rest_after_two(p: P3) -> I32 {
  match p {
    P3 { x: px, y: py, .. } => px + py,             //~ E0020
  }
}

pub fn fine(p: P3) -> I32 {
  match p {
    P3 { x: px, y: _, z: _ } => px,
  }
}
