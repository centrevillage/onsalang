// E0401 for `a * b` where `T: PartialOrd` (§6.3: "既にある境界が候補の trait に含まれるときは置き換える"). `Num` satisfies
// `PartialOrd`, so the candidate replaces the bound: `T: Num` (not `T: PartialOrd + Num`). No diagnostic is left after it.

pub fn product[T: Num](a: T, b: T) -> T {
  a * b                                             //~ E0401
}
