// E0020 for the clock written on the binding side of a `let` or `var` (spec §11.3, §18.1; S-378; the row
// `clock_on_binding` of spec/foreign-forms.toml): after the name or the pattern, with or without a type
// annotation, the code and the candidate are those of `let y: F32 at sample = x`.
// A `let` of a `fn` with the annotation, and the clock after it (the form that is E0020 already, with the
// same candidate): the candidate removes the clock (`let y: I32 = x`) and leaves nothing (`clean`). This file has
// this one error.

pub fn clock_after_the_type_of_a_fn(x: I32) -> I32 {
  let y: I32 = x                          //~ E0020
  y
}
