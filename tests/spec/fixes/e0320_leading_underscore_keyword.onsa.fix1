// onsa.toml
// [test]
// spec = ["§2.3", "§2.2", "§18.1"]
// fixes = 1

// E0320 for a leading `_` where the name without the `_` is a keyword (spec 2.3): `_type` without its
// `_` is `type` (§2.2), so the candidate is the name with a `_` at its end, `type_`, as for `Match`
// (e0320_keyword). It changes the declaration and every use of the name in the package. The note says
// that a `_` at the end avoids a keyword (checked in crates/onsa_cli/tests/naming_shapes.rs).

pub fn match_() -> I32 { //~ E0320
  1
}

pub fn calls_match() -> I32 {
  _match()
}

pub fn local() -> I32 {
  let type_ = 1 //~ E0320
  _type + 1
}

pub struct Self_ { //~ E0320
  x: I32,
}

pub fn read_self(s: _Self) -> I32 {
  s.x
}

pub fn param(inout_: I32) -> I32 { //~ E0320
  _inout
}
