// onsa.toml
// [test]
// spec = ["§6.3", "§18.1"]
// fixes = 1
// [[test.fix]]
// at = "20:12"
// code = "E0401"
// candidate = 1
// clean = true

// E0401 for `self.v & m` in a method of `impl[T: Num] Wrap[T]` (§6.3): `Num` is not `Int`, so the heading of the `impl`
// becomes `impl[T: Num + Int] Wrap[T]`. No diagnostic is left after it.

pub struct Wrap[T] {
  v: T,
}

impl[T: Num] Wrap[T] {
  pub fn masked(self, m: T) -> T {
    self.v & m                                      //~ E0401
  }
}
