// onsa.toml
// [test]
// spec = ["§2.4", "§18.1", "§4.5"]

// S-471 (W5-24 U6a): the error of a number token that is not an Onsa number, and its candidates, are the same wherever a number
// can be written (§2.4: "数のトークンの形の誤り（接頭辞、接尾辞、先頭の 0、小数点）とその修正候補は字句の段で決まり、数を書ける位置
// （式、パターン、定数の型引数 `S[017]`、配列型の長さ、属性の引数）によらず同じ"). Here the const argument of a type, in the
// headings and in the list of the `::[` of an expression: a leading 0, an octal prefix, a type suffix, a point with no digit
// next to it, and an exponent after a point. The code is the E0020 of the same row as in an expression (`leading_zero`,
// `octal_prefix`, `literal_suffix`, `float_dot_exponent`), and not the E0002 "expected a type" of the position. The candidates
// are the ones of the rows: `017` is `17` or `15`, `0o17` is `15`, `1u32` is `1`. One error per unit. The digit separator is in
// tests/spec/fixes/e0020_digit_separator_const_arg.onsa.

pub struct Rg[T, const N: U32] {
  d: [T; N],
}

impl[T, const N: U32] Rg[T, N] {
  pub const CAP: U32 = 4
}

pub struct Ring[T, const N: U32] {
  d: [T; N],
}

pub struct Mat[T, const R: U32, const C: U32] {
  d: [T; R],
}

pub const TABLE: U32 = 8

pub fn a_leading_zero(r: Ring[F32, 017]) -> U32 {   //~ E0020
  1
}

pub fn a_leading_zero_of_zeros(r: Ring[F32, 00]) -> U32 { //~ E0020
  1
}

pub fn an_octal_prefix(r: Ring[F32, 0o17]) -> U32 { //~ E0020
  1
}

pub fn a_type_suffix(r: Ring[F32, 1u32]) -> U32 {   //~ E0020
  1
}

pub fn a_hexadecimal_suffix(r: Ring[F32, 0x1F_u32]) -> U32 { //~ E0020
  1
}

pub fn a_point_without_digits(r: Ring[F32, 1.]) -> U32 { //~ E0020
  1
}

pub fn a_point_before_the_exponent(r: Ring[F32, 1.e3]) -> U32 { //~ E0020
  1
}

pub fn in_parentheses(r: Ring[F32, (017)]) -> U32 { //~ E0020
  1
}

pub fn after_a_type_argument(r: Ring[Option[F32], 017]) -> U32 { //~ E0020
  1
}

pub fn as_the_second_of_two(m: Mat[F32, 2, 017]) -> U32 { //~ E0020
  1
}

pub fn in_a_field_type() -> U32 {
  let r: Ring[F32, 017] = Ring { d: [0.0; 15] }     //~ E0020
  1
}

pub fn in_a_struct_literal() -> U32 {
  let r = Ring::[F32, 017] { d: [0.0; 17] }         //~ E0020
  1
}

pub fn in_a_value() -> U32 {
  Rg::[F32, 017].CAP                                //~ E0020
}

pub fn in_a_value_with_an_octal_prefix() -> U32 {
  Rg::[F32, 0o17].CAP                               //~ E0020
}

pub fn in_a_branch(c: Bool) -> U32 {
  if c {
    Rg::[F32, 017].CAP                              //~ E0020
  } else {
    2
  }
}

pub fn in_a_closure() -> [U32; 2] {
  array.from_fn(fn(_) {
    Rg::[F32, 1u32].CAP                             //~ E0020
  })
}

pub fn fine(r: Ring[F32, 17]) -> U32 {
  1
}
