// onsa.toml
// [test]
// spec = ["§2.6", "§11.5", "§18.1"]
//
// [[test.fix]]
// at = "27:14"
// code = "E0811"
// candidate = 1
// clean = true

// W4-20 U1/t, S-745: the inner `par` of a nest of `par~` without the `~`. The one error of the file has the one candidate, the insertion of the `~`
// right after `par` (§11.5), and the file with it checks clean (`clean` is about the whole file, so
// the file has this one error and no other unit with a candidate; §18.1: "当てた後に同じ段か前の段の誤りが
// 残らないとき"). The main position (`at`) is the start of the `par`, where the `par` expression begins
// (as the range of the E0811 of a call begins at the call). One error per flow (P-01).

pub rt fn pair_sum(xs: [F32; 2]) -> F32 {
  xs[0] + xs[1]
}

pub flow lp(x: F32 at sample) -> F32 at sample {
  x * 0.5 + prev~(x) * 0.5
}

pub flow replicas(x: F32 at sample) -> [F32; 3] at sample {
  par~ i in 0 ..< 3 {
    pair_sum(par j in 0 ..< 2 { lp~(x * F32.round_from(i + j)) })  //~ E0811
  }
}
