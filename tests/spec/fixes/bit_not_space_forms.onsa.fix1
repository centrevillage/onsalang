// onsa.toml
// [test]
// spec = ["§2.5", "§2.6", "§18.1"]
// fixes = 1

// S-938 (W5-11 U10d2, §2.6, the row `faust_bit_not` of spec/foreign-forms.toml): a prefix `~` and its operand with
// a space on the same line between them (`~ a`) is the E0020 of the bit negation, as the `~a` that touches is, and the one
// candidate replaces the `~` and the space by `!` (`!a`). The main position is the `~`, the first token of the form
// (§18.1). The forms are tried in the places an operand can stand: a `let`, an argument, the operand of a binary operator,
// an element, a condition, a `return`, the last expression, an arm, a closure body, a method, a flow and the branch of
// an `if~`, with two spaces and with a tab, and with a parenthesized and a literal operand. One error per declaration
// unit (P-01). The contrast with the form that touches is in e0020_prefix_tilde_contrast.onsa.

pub fn id(m: U32) -> U32 {
  m
}

pub fn a_let(m: U32) -> U32 {
  let n = !m   //~ E0020 @11
  n
}

pub fn two_spaces(m: U32) -> U32 {
  let n = !m   //~ E0020 @11
  n
}

pub fn a_tab(m: U32) -> U32 {
  let n = !m   //~ E0020 @11
  n
}

pub fn a_parenthesized_operand(m: U32) -> U32 {
  let n = !(m)   //~ E0020 @11
  n
}

pub fn a_literal_operand() -> U32 {
  let n = !1   //~ E0020 @11
  n
}

pub fn an_argument(m: U32) -> U32 {
  id(!m)   //~ E0020 @6
}

pub fn an_operand(m: U32) -> U32 {
  m & !m   //~ E0020 @7
}

pub fn an_operand_with_a_group(m: U32) -> U32 {
  m & !(m + 1)   //~ E0020 @7
}

pub fn an_element(m: U32) -> [U32; 2] {
  [!m, m]   //~ E0020 @4
}

pub fn a_condition(c: Bool) -> U32 {
  while !c {   //~ E0020 @9
    break
  }
  1
}

pub fn a_return(m: U32) -> U32 {
  return !m   //~ E0020 @10
}

pub fn the_last_expression(m: U32) -> U32 {
  !(m)   //~ E0020 @3
}

pub fn an_arm(k: U32, m: U32) -> U32 {
  match k {
    0 => !m,   //~ E0020 @10
    _ => m,
  }
}

pub fn a_closure_body(m: U32) -> U32 {
  let f = fn(x: U32) -> U32 { !x }   //~ E0020 @31
  f.(m)
}

pub struct Gain {
  k: U32,
}

impl Gain {
  pub fn flip(self) -> U32 {
    !self.k   //~ E0020 @5
  }
}

pub flow in_a_flow(m: U32 at sample) -> U32 at sample {
  let n = !m   //~ E0020 @11
  n
}

pub flow in_a_branch(m: U32 at sample, c: Bool at sample) -> U32 at sample {
  let n = if~ c { !m } else { m }   //~ E0020 @19
  n
}

pub fn fine(m: U32) -> U32 {
  let a = !m
  let b = !(m)
  a & b
}
