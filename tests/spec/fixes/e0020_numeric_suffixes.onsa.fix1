// onsa.toml
// [test]
// spec = ["§2.4", "§18.1", "§7"]
// fixes = 1

// E0020 for the type suffix of a number (spec §2.4, §18.1; S-62, R-73). A suffix is recognised from a closed
// list: the integer and float type names of Rust (`i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize f32
// f64`) and the suffixes of C (`u l ul ll ull f` and their capitals `U L UL LL ULL F`). A number with a suffix
// of the list is an error with one candidate, which removes the suffix and the `_` in front of it and changes
// nothing else: the value, the spelling of the digits and the kind of the number (integer or float) stay. The
// one exception adds what the kind needs: a float suffix (`f32`, `f64`, `f`, `F`) on the form of an integer
// (`1f32`) adds `.0` (`1.0`), so the candidate is a float as the suffix says. A suffix that is not of the
// list is E0001 (negative/lex_numeric_e0001.onsa). The main position is the first character of the number.
// One error per declaration (P-01). The places: a `let`, an argument, a return, a field, an element, an
// operand, a `const`, a pattern, a closure body, a block in a block, a generic function, a flow.

pub struct Pair {
  a: I32,
  b: F32,
}

fn takes(x: I32) -> I32 {
  x
}

fn takes_f32(x: F32) -> F32 {
  x
}

pub fn rust_u8() -> U8 {
  let n: U8 = 1                                     //~ E0020
  n
}

pub fn rust_u16() -> U16 {
  let n: U16 = 1                                    //~ E0020
  n
}

pub fn rust_u32() -> U32 {
  let n: U32 = 1                                    //~ E0020
  n
}

pub fn rust_u64() -> U64 {
  let n: U64 = 1                                    //~ E0020
  n
}

pub fn rust_u128() -> U64 {
  let n: U64 = 1                                    //~ E0020
  n
}

pub fn rust_usize() -> U64 {
  let n: U64 = 1                                    //~ E0020
  n
}

pub fn rust_i8() -> I8 {
  let n: I8 = 1                                     //~ E0020
  n
}

pub fn rust_i16() -> I16 {
  let n: I16 = 1                                    //~ E0020
  n
}

pub fn rust_i32() -> I32 {
  let n: I32 = 1                                    //~ E0020
  n
}

pub fn rust_i64() -> I64 {
  let n: I64 = 1                                    //~ E0020
  n
}

pub fn rust_i128() -> I64 {
  let n: I64 = 1                                    //~ E0020
  n
}

pub fn rust_isize() -> I64 {
  let n: I64 = 1                                    //~ E0020
  n
}

