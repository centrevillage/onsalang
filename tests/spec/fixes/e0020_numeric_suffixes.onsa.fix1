  let a: F32 = 2.5                                  //~ E0020
  a
}

pub fn c_capital_f_on_a_fraction() -> F32 {
  let a: F32 = 2.5                                  //~ E0020
  a
}

pub fn c_f_on_the_form_of_an_integer() -> F32 {
  let a: F32 = 2.0                                  //~ E0020
  a
}

pub fn c_capital_f_on_the_form_of_an_integer() -> F32 {
  let a: F32 = 2.0                                  //~ E0020
  a
}

pub fn c_f_on_an_exponent() -> F32 {
  let a: F32 = 1e3                                  //~ E0020
  a
}

pub fn hexadecimal_and_a_separator() -> U8 {
  let n: U8 = 0x1F                                  //~ E0020
  n
}

pub fn hexadecimal() -> U8 {
  let n: U8 = 0xFF                                  //~ E0020
  n
}

pub fn hexadecimal_c_suffix() -> U64 {
  let n: U64 = 0xDEADBEEF                           //~ E0020
  n
}

