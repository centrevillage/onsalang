  let a: F32 = 1.0                                  //~ E0020
  a
}

pub fn rust_f64_on_a_float() -> F64 {
  let a: F64 = 1.0                                  //~ E0020
  a
}

pub fn rust_f32_on_an_integer_form() -> F32 {
  let a: F32 = 1.0                                  //~ E0020
  a
}

pub fn rust_f64_on_an_integer_form() -> F64 {
  let a: F64 = 1.0                                  //~ E0020
  a
}

pub fn rust_f32_on_an_exponent() -> F32 {
  let a: F32 = 1e3                                  //~ E0020
  a
}

pub fn rust_f64_on_a_signed_exponent() -> F64 {
  let a: F64 = 2.5e-3                               //~ E0020
  a
}

pub fn rust_f32_on_a_fraction() -> F32 {
  let a: F32 = 2.5                                  //~ E0020
  a
}

pub fn c_u() -> U32 {
  let n: U32 = 7                                    //~ E0020
  n
}

pub fn c_capital_u() -> U32 {
  let n: U32 = 7                                    //~ E0020
  n
}

