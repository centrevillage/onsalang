  let n: I64 = 7                                    //~ E0020
  n
}

pub fn c_capital_l() -> I64 {
  let n: I64 = 7                                    //~ E0020
  n
}

pub fn c_ul() -> U64 {
  let n: U64 = 7                                    //~ E0020
  n
}

pub fn c_capital_ul() -> U64 {
  let n: U64 = 7                                    //~ E0020
  n
}

pub fn c_ll() -> I64 {
  let n: I64 = 7                                    //~ E0020
  n
}

pub fn c_capital_ll() -> I64 {
  let n: I64 = 7                                    //~ E0020
  n
}

pub fn c_ull() -> U64 {
  let n: U64 = 7                                    //~ E0020
  n
}

pub fn c_capital_ull() -> U64 {
  let n: U64 = 7                                    //~ E0020
  n
}

