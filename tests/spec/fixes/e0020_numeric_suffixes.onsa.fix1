  let n: U32 = 1_000                                //~ E0020
  n
}

pub fn underscore_before_the_suffix() -> U8 {
  let n: U8 = 1                                     //~ E0020
  n
}

pub fn zero() -> U8 {
  let n: U8 = 0                                     //~ E0020
  n
}

pub fn separators_in_a_float() -> F32 {
  let a: F32 = 1_000.5                              //~ E0020
  a
}

pub fn under_a_minus() -> I8 {
  let n: I8 = -1                                    //~ E0020
  n
}

pub fn float_under_a_minus() -> F32 {
  let a: F32 = -2.5                                 //~ E0020
  a
}

pub fn in_an_argument() -> I32 {
  takes(1)                                          //~ E0020
}

pub fn float_in_an_argument() -> F32 {
  takes_f32(1.5)                                    //~ E0020
}

pub fn float_form_in_an_argument() -> F32 {
  takes_f32(1.0)                                    //~ E0020
}

pub fn in_a_return() -> I32 {
  1                                                 //~ E0020
}

pub fn in_an_early_return(flag: Bool) -> I32 {
  if flag {
    return 1                                        //~ E0020
  }
  0
}

pub fn in_a_field() -> Pair {
  Pair { a: 1, b: 0.0 }                             //~ E0020
}

pub fn float_form_in_a_field() -> Pair {
  Pair { a: 0, b: 1.0 }                             //~ E0020
}

pub fn in_an_array() -> [I32; 2] {
  [0, 1]                                            //~ E0020
}

pub fn in_a_tuple() -> (F32, I32) {
  (1.0, 2)                                          //~ E0020
}

pub fn as_an_operand(x: I32) -> I32 {
  x + 1                                             //~ E0020
}

pub fn float_form_as_an_operand(x: F32) -> F32 {
  x * 2.0                                           //~ E0020
}

pub fn in_a_comparison(x: I32) -> Bool {
  x < 1                                             //~ E0020
}

pub fn in_a_pattern(x: I32) -> I32 {
  match x {
    1 => 1,                                         //~ E0020
    _ => 0,
  }
}

pub fn in_an_arm(x: I32) -> I32 {
  match x {
    0 => 1,                                         //~ E0020
    _ => 0,
  }
}

pub fn in_a_branch(flag: Bool) -> I32 {
  if flag { 1 } else { 1 }                          //~ E0020
}

pub fn in_a_closure_body() -> I32 {
  let f = fn(y: I32) -> I32 { 1 }                   //~ E0020
  f.(1)
}

pub fn float_form_in_a_closure_body() -> F32 {
  let f = fn(y: I32) -> F32 { 1.0 }                 //~ E0020
  f.(1)
}

pub fn in_a_block_in_a_block() -> I32 {
  let r: I32 = {
    let s: I32 = {
      1                                             //~ E0020
    }
    s
  }
  r
}

pub fn in_a_generic_function[T](x: T) -> T {
  let n: I32 = 1                                    //~ E0020
  x
}

pub fn in_a_for_header() -> I32 {
  var s: I32 = 0
  for i in 0..<1 {                                  //~ E0020
    s = s + i
  }
  s
}

pub flow in_a_par_header(x: F32 at sample) -> [F32; 4] at sample {
  par i in 0..<4 {                                  //~ E0020
    x * i.round_f32()
  }
}

pub flow in_a_flow(x: F32 at sample) -> F32 at sample {
  x * 0.5                                           //~ E0020
}

pub flow float_form_in_a_flow(x: F32 at sample) -> F32 at sample {
  x + 1.0                                           //~ E0020
}

const IN_A_CONST: I32 = 1                           //~ E0020

const FLOAT_IN_A_CONST: F32 = 2.5                   //~ E0020

// The right forms. The hexadecimal digits that look like a suffix (`0x1f`, `0xFF`) are digits.
pub fn fine(x: I32) -> I32 {
  let a: I32 = 1
  let _: F32 = 1.0
  let _: F32 = 1e3
  let _: I32 = 0x1f
  let _: I32 = 0xFF
  let _: I32 = 0x7EAD_BEEF
  a + x
}
