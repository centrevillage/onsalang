// onsa.toml
// [test]
// spec = ["§6.5", "§15.5", "§18.1"]
// fixes = 1

// E0020 for the old attribute spelling with a fixed replacement (§6.5): `@relaxed` is
// `@fp(relaxed)` (S-57). It is on a fn or on a flow (§15.5), on a line of its own or on the line of the
// declaration. The candidate is the new attribute in the same place; no other token changes.

@fp(relaxed)                                            //~ E0020
pub fn fast(x: F32) -> F32 {
  x * 2.0
}

@fp(relaxed)                                            //~ E0020
pub fn faster(x: F32) -> F32 {
  x * 4.0
}

@fp(relaxed)                                            //~ E0020
pub flow boost(x: F32 at sample) -> F32 at sample {
  x * 8.0
}

@fp(relaxed) pub fn same_line(x: F32) -> F32 {          //~ E0020
  x * 16.0
}

@fp(relaxed) fn private_same_line(x: F32) -> F32 {      //~ E0020
  x * 32.0
}

@fp(relaxed)
pub fn fine(x: F32) -> F32 {
  x * 8.0
}
