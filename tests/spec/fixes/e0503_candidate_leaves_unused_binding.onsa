// onsa.toml
// [test]
// spec = ["§7", "§5.1", "§18.1"]
// fixes = 1

// S-292 (§7, §18.1): the candidate of the E0503 only deletes the unreachable items (S-292, (a)). A binding that only the deleted items
// used is then a binding that is never read, and the check after the candidate reports it as E0309 (the last stage, which comes
// after all the other checks; the candidate for it is `_`, or none for a `var`). The E0309 is what is left after the
// candidate, and the candidate is made: the promise of §18.1 (S-236) is about the stages before it.
// The bindings: a `let` and a `var` that only the unreachable statement uses, the binder of a `for` and of an arm that the
// unreachable item uses, and a `let` before a `let` whose value diverges as a whole. One error per function (P-01).

fn g(n: I32) {
}

pub fn let_used_only_after_the_return(x: I32) -> I32 {
  let a = x + 1
  return x
  a * 2                                             //~ E0503
}

pub fn var_used_only_after_the_return(x: I32) -> I32 {
  var n = 1
  return x
  n = n + 1                                         //~ E0503
}

pub fn for_binder_used_only_after_the_return(n: I32) -> I32 {
  for i in 0 ..< n {
    return n
    g(i)                                            //~ E0503
  }
  0
}

pub fn arm_binder_used_only_after_the_return(o: Option[I32]) -> I32 {
  match o {
    Some(v) => {
      return 0
      v + 1                                         //~ E0503
    },
    None => 0,
  }
}

pub fn let_before_a_let_with_a_diverging_value(x: I32) -> I32 {
  let a = x + 1
  let b = { return x }                              //~ E0503
  a + b
}

pub fn used_before_and_after_the_return(x: I32) -> I32 {
  let a = x + 1
  g(a)
  return x
  a * 2                                             //~ E0503
}
