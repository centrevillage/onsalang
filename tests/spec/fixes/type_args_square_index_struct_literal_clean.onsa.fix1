// onsa.toml
// [test]
// spec = ["§4.5", "§4.4", "§18.1"]
// fixes = 1
//
// [[test.fix]]
// at = "20:5"
// code = "E0020"
// candidate = 1
// clean = true

// S-333 (W5-24 U6b): the index form of a list with a struct literal in an element (`xs[P { a: 1 }.a, 1]`) is
// `xs[P { a: 1 }.a][1]`, and nothing is left after it (§4.4, S-376: a `{` in brackets is a struct literal).

pub struct P {
  a: U32,
}

pub fn f(xs: [[I32; 2]; 2]) -> I32 {
  xs[P { a: 1 }.a][1]                               //~ E0020
}
