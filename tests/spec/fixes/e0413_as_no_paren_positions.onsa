// onsa.toml
// [test]
// spec = ["§3.1", "§3.3", "§4.7", "§18.1"]
// fixes = 1

// E0413 for a conversion function of a pair that `as` can write (§3.3), in the positions that are not an operand of an
// operator: an argument, a `let`, an assignment, a return, an element, a field, an arm. `as` needs no parentheses
// there (§3.1 puts the operand positions of an operator, a prefix symbol, a postfix call, `as` and `at` apart from
// these), so the candidate is `x as F64` alone (and `x` alone for the call to the same type), and its copy (.fix1) has none. `round_from` returns the type that `as`
// gives, so each candidate is one. One error in each function (P-01).

pub struct Pair {
  a: F64,
  b: F32,
}

pub fn id64(v: F64) -> F64 {
  v
}

pub fn in_an_argument(x: F32) -> F64 {
  id64(F64.round_from(x))                           //~ E0413
}

pub fn in_an_annotated_let(x: F32) -> F64 {
  let y: F64 = F64.round_from(x)                    //~ E0413
  y
}

pub fn in_a_let_without_annotation(x: F32) -> F64 {
  let y = F64.round_from(x)                         //~ E0413
  y
}

pub fn as_the_tail(x: F32) -> F64 {
  F64.round_from(x)                                 //~ E0413
}

pub fn in_a_return(x: F32) -> F64 {
  return F64.round_from(x)                          //~ E0413
}

pub fn in_an_assignment(x: F32) -> F64 {
  var y: F64 = 0.0
  y = F64.round_from(x)                             //~ E0413
  y
}

pub fn in_a_field(x: F32) -> Pair {
  Pair { a: F64.round_from(x), b: x }               //~ E0413
}

pub fn in_an_array(x: F32) -> [F64; 2] {
  [F64.round_from(x), 1.0]                          //~ E0413
}

pub fn in_a_tuple(x: F32) -> (F64, F32) {
  (F64.round_from(x), x)                            //~ E0413
}

pub fn in_an_arm(o: Option[F32]) -> F64 {
  match o {
    Some(v) => F64.round_from(v),                   //~ E0413
    None => 0.0,
  }
}

pub fn the_same_type(x: F32) -> F32 {
  F32.round_from(x)                                 //~ E0413
}

pub fn an_integer(x: I16) -> F32 {
  F32.round_from(x)                                 //~ E0413
}
