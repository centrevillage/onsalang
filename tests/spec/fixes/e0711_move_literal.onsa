// onsa.toml
// [test]
// spec = ["§5.2", "§18.1"]
// fixes = 1
// [[test.fix]]
// at = "19:11"
// code = "E0711"
// candidate = 1
// clean = true

// R-198, S-605 (§5.2): a literal under a `move` in the argument of a `move` parameter is an E0711 at the operand of the `move`, and the one candidate removes it ("Copy のリテラルは
// `move` を書かない").

pub fn tk(move n: U32) -> U32 {
  n
}

pub fn literal() -> U32 {
  tk(move 1) //~ E0711
}
