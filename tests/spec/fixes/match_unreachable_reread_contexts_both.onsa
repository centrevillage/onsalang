// onsa.toml
// [test]
// spec = ["§7", "§11.5", "§18.1"]
// fixes = 2

// S-876, S-187 (U4a of W5-09): the E0503 of an arm in the places where a body stands has both candidates, the deletion of the unreachable arms and the move of the covering `_` or binding to the end (§7), when reading
// the body again with each of them applied has no error of the stage of the types (§18.1): a closure, a `match` in the arm of another, the body of a loop, the initializer of a `const`, a `test`, a method, a generic
// function, and the bodies of a flow (`match~` and `par~`, §11.5). The text after the candidates is not written here. One error per function (P-01).

const BASE: I32 = 2

pub const K: I32 = match BASE {
  _ => 0,
  1 => 1,                                           //~ E0503
}

pub struct P {
  x: I32,
}

pub fn in_a_closure(x: I32) -> I32 {
  let f = fn(a: I32) -> I32 {
    match a {
      _ => 0,
      1 => 1,                                       //~ E0503
    }
  }
  f.(x)
}

pub fn in_the_arm_of_another_match(n: I32, m: I32) -> I32 {
  match n {
    0 => match m {
      _ => 1,
      2 => 3,                                       //~ E0503
    },
    _ => 4,
  }
}

pub fn in_a_for_body(count: I32) -> I32 {
  var r = 0
  for i in 0 ..< count {
    match i {
      _ => { r = r + 1 },
      3 => { r = r + 2 },                           //~ E0503
    }
  }
  r
}

pub fn in_a_while_body(count: I32) -> I32 {
  var i = 0
  while i < count {
    i = match i {
      k => k + 1,
      3 => 100,                                     //~ E0503
    }
  }
  i
}

test "in a test" {
  let m: I32 = 3
  let r = match m {
    _ => 0,
    3 => 1,                                         //~ E0503
  }
  assert r == 0
}

impl P {
  pub fn sign(self) -> I32 {
    match self.x {
      _ => 0,
      1 => 1,                                       //~ E0503
    }
  }
}

fn pick[T: Num](x: T, n: I32) -> T {
  match n {
    _ => x,
    1 => x + x,                                     //~ E0503
  }
}

pub flow in_a_match_tilde(k: U32 at sample, x: F32 at sample) -> F32 at sample {
  match~ k {
    _ => x,
    0 => x * 2.0,                                   //~ E0503
  }
}

pub flow in_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0 ..< 2 {
    match~ i {
      _ => x,
      0 => x * 2.0,                                 //~ E0503
    }
  }
  ys[0]
}
