// onsa.toml
// [test]
// spec = ["§2.4", "§4.7", "§7", "§18.1"]
// fixes = 1

// E0020 for the integers of other languages inside the parentheses of a negative literal pattern (spec §2.4,
// §4.7, §7, §18.1; S-62, S-227): the octal prefix `0o17` (one candidate, the value in decimal: `15`) and the
// type suffixes `1u8`, `0x1F_u8`, `100ul` (one candidate each, the suffix and the `_` before it taken off).
// The number inside the parentheses is read as the number of any other place, and the error is the row of that
// number (`octal_prefix`, `literal_suffix` of spec/foreign-forms.toml), not a failure to read a pattern after
// the `-`. The main position is the first character of the literal, inside the parentheses. The sign and the
// parentheses stay. One error in each declaration unit (P-01).

pub fn octal(x: I32) -> I32 {
  match x {
    -(0o17) => 1,                                   //~ E0020 @7
    _ => 0,
  }
}

pub fn octal_zero(x: I32) -> I32 {
  match x {
    -(0o0) => 1,                                    //~ E0020 @7
    _ => 0,
  }
}

pub fn suffix(x: I32) -> I32 {
  match x {
    -(1u8) => 1,                                    //~ E0020 @7
    _ => 0,
  }
}

pub fn hex_with_suffix(x: I32) -> I32 {
  match x {
    -(0x1F_u8) => 1,                                //~ E0020 @7
    _ => 0,
  }
}

pub fn c_suffix(x: I64) -> I32 {
  match x {
    -(100ul) => 1,                                  //~ E0020 @7
    _ => 0,
  }
}

pub fn octal_inside_some(o: Option[I32]) -> I32 {
  match o {
    Some(-(0o17)) => 1,                             //~ E0020 @12
    _ => 0,
  }
}

pub fn suffix_in_a_choice(x: I32) -> I32 {
  match x {
    -(1u8) | 3 => 1,                                //~ E0020 @7
    _ => 0,
  }
}
