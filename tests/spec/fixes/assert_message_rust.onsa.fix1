// onsa.toml
// [test]
// spec = ["§7", "§18.1"]
// fixes = 1
// [[test.fix]]
// at = "16:3"
// code = "E0020"
// candidate = 1
// clean = true

// E0020 for the `assert!` of Rust with a message, `assert!(e, "m")` (S-879, in the syntax stage). It is the one form of a
// message of both languages: its range is `assert` to the `)` that closes `!(`, and the candidate is the same one, `assert e`
// (two candidates are only for `assert!(e)` without a message, S-964). The file has no diagnostic after it.

pub fn positive(x: I32) {
  assert x > 0                        //~ E0020
}
