// onsa.toml
// [test]
// spec = ["§4.5", "§18.1"]
// fixes = 2
//
// [[test.fix]]
// at = "18:5"
// code = "E0020"
// candidate = 2
// clean = true

// S-333 (W5-24 U6b): the candidate that is the multi-dimensional index (`xs[1][2]`) of `xs[1, 2]` for an array of arrays leaves
// nothing behind: it is the index of the array, and the type of the result is the type of the element. The other
// candidate, `xs::[1, 2]`, writes the type arguments of a value that has none, an error of a later stage (E0308), so it
// is not asked to be clean. `clean` is about the whole file, so the file has this one unit with an error.

pub fn elem(xs: [[F32; 4]; 4]) -> F32 {
  xs[1, 2]                                         //~ E0020
}
