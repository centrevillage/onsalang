// onsa.toml
// [test]
// spec = ["§6.1", "§18.1"]
// fixes = 1

// E0020 for a call whose callee is not a path of names (§6.1): the syntax alone decides, because
// an item cannot be such a callee. The one candidate calls the function value with `.(`.

pub struct Shaper {
  gain: F32,
  curve: fn(F32) -> F32,
}

pub fn call_a_parenthesized_field(s: Shaper, x: F32) -> F32 {
  s.curve.(x)                                      //~ E0020
}

pub fn call_an_element(ops: [fn(F32) -> F32; 2], i: U32, x: F32) -> F32 {
  ops[i].(x)                                         //~ E0020
}

pub fn inc(x: I32) -> I32 {
  x + 1
}

pub fn dec(x: I32) -> I32 {
  x - 1
}

pub fn pick(up: Bool) -> fn(I32) -> I32 {
  if up { inc } else { dec }
}

pub fn call_a_result() -> I32 {
  pick(true).(5)                                     //~ E0020
}

pub fn fine(s: Shaper, x: F32) -> F32 {
  s.curve.(x) * s.gain
}
