// onsa.toml
// [test]
// spec = ["§2.4", "§6.1", "§18.1"]
// fixes = 1

// E0020 for a call whose callee is neither a path of names nor a path of names with `[...]`
// (§6.1): an item cannot be such a callee, so the syntax alone decides. The one candidate calls the
// function value with `.(`: it removes the parentheses around the callee (`(s.f)(x)` becomes
// `s.f.(x)`) and inserts the `.` between a callee that is a call and its `(` (`g(x)(y)` becomes
// `g(x).(y)`). One error per function (P-01). `ops[i](x)`, a path with `[...]`, is decided by the
// names stage (e0020_call_forms_names.onsa).

pub struct Shaper {
  gain: F32,
  curve: fn(F32) -> F32,
}

pub struct Rig {
  shaper: Shaper,
  pair: (fn(I32) -> I32, I32),
}

pub struct Maker {
  step: I32,
}

impl Maker {
  pub fn make(self) -> fn(I32) -> I32 {
    inc
  }
}

pub fn inc(x: I32) -> I32 {
  x + 1
}

pub fn dec(x: I32) -> I32 {
  x - 1
}

pub fn pick(up: Bool) -> fn(I32) -> I32 {
  if up { inc } else { dec }
}

pub fn call_a_parenthesized_field(s: Shaper, x: F32) -> F32 {
  s.curve.(x)                                      //~ E0020
}

pub fn call_a_parenthesized_tuple_element(t: (fn(I32) -> I32, I32)) -> I32 {
  t.0.(t.1)                                        //~ E0020
}

pub fn call_a_parenthesized_nested_field(r: Rig, x: F32) -> F32 {
  r.shaper.curve.(x)                               //~ E0020
}

pub fn call_a_parenthesized_nested_tuple_element(r: Rig) -> I32 {
  r.pair.0.(r.pair.1)                              //~ E0020
}

pub fn call_a_result() -> I32 {
  pick(true).(5)                                     //~ E0020
}

pub fn call_the_result_of_a_value_call(h: fn(I32) -> fn(I32) -> I32) -> I32 {
  h.(1).(2)                                          //~ E0020
}

pub fn call_the_result_of_a_method(m: Maker) -> I32 {
  m.make().(3)                                       //~ E0020
}

pub fn call_the_result_in_an_operand(x: I32) -> I32 {
  pick(false).(x) + 1                                //~ E0020
}

pub fn fine(s: Shaper, t: (fn(I32) -> I32, I32), x: F32) -> F32 {
  let a = t.0.(t.1)
  let b = pick(true).(a)
  s.curve.(x) * s.gain + b.round_f32()
}
