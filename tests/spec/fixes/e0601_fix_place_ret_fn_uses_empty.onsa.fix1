// onsa.toml
// [test]
// spec = ["§8.1", "§18.1"]
// fixes = 1
// [[test.fix]]
// at = "19:11"
// code = "E0601"
// candidate = 1
// clean = true

// §8.1, S-364 and R-455: the `uses {}` is the row of the result's function type, not of `mk`, so the candidate
// puts that type in parentheses with its row and adds one after them: `-> (fn() -> I32 uses {}) uses {Alloc}`.

pub fn bump(y: I32) -> I32 uses {Alloc} { y }

pub fn kk() -> I32 { 1 }

pub fn mk() -> (fn() -> I32 uses {}) uses {Alloc} {
  let _ = bump(1)                                   //~ E0601 @11
  kk
}
