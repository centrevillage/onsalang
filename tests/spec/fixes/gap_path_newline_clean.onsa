// S-963 (W5-11 U10i/t, §2.5, §15.1, the row `path_separator` of spec/foreign-forms.toml): the one candidate of a path with a line
// break after its `::` (`F32::` and then `PI`) writes the `::` as a `.` on the line of the name after it (`F32` and then `.PI`,
// a line that begins with a `.` goes on with the line before), and nothing is left behind (`clean`, S-253). The main
// position is the `::`. A file with one unit, so that `clean` looks at the whole file.

pub fn f() -> F32 {
  F32::   //~ E0020
    PI
}
