// onsa.toml
// [test]
// spec = ["§2.1", "§2.5", "§2.6", "§18.1"]
// fixes = 1
//
// [[test.fix]]
// at = "22:5"
// code = "E0020"
// candidate = 1
// leaves = ["21:11 E0020"]

// S-957 (W5-11 U10d2/t2, §2.1, §2.5, §2.6): a block comment between a prefix `~` and its operand, on the line of the operand,
// is the E0020 of the block comment (§2.1) first (S-957: "the block comment's own E0020 is first"), and the `~` at the end
// of its line is not reported with it: one unit reports one error (P-01). Its one candidate writes a line comment (`// c`)
// and keeps the tokens and the line breaks, so the `~` still ends its line after it and is the error of the next round
// (`leaves`: the E0020 of the `~`, at the place it stood). The main position is the start of the block comment. Before
// S-957 the `~` was reported there (E0002, "found `~`"). A file with one unit, so that the candidate is the one of the
// comment.

pub fn f(m: U32) -> U32 {
  let n = ~
    // c
    m   //~ E0020 @5
  n
}
