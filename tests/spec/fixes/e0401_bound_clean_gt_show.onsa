// E0401 for `a > b` where `T: Show` (§6.3: `PartialOrd` does not contain `Show`, so it is joined). The one candidate is
// `T: Show + PartialOrd`; no diagnostic is left after it.

pub fn above[T: Show](a: T, b: T) -> Bool {
  a > b                                             //~ E0401
}
