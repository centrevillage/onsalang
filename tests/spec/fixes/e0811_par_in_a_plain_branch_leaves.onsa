// W4-20 U1/t, S-745; W7-06 U0/t, S-1177, S-1183: the second error of e0811_par_in_a_plain_branch.onsa. After the
// candidate (the `~` inserted after `par`) the `par~` holds state and is a thing with state in a branch of a
// plain `if` or `match`, which a branch cannot hold (§11.5; §18.1: flow check stage). So the candidate does not
// leave a clean file (no `clean`), and the entries of the header name the error that stays (`leaves`: the
// position in the text after the candidate, the start of the `par~`). The candidate is shown although it leaves
// the E0811 of the branch: the provisional reading (1) of S-1183 (the open detail), which this file follows
// until it is decided. The candidates of the error of the branch (`if~` / `match~`, lifting the state out into
// a `let`) are not asked for here. The branch is the E0811 of §11.5 (W7-06 U1), which the three entries of the header
// name; the first file does not name what is left.

pub flow lp(x: F32 at sample) -> F32 at sample {
  x * 0.5 + prev~(x) * 0.5
}

pub flow in_the_then_branch(x: F32 at sample, c: Bool at sample) -> [F32; 2] at sample {
  if c {
    par i in 0 ..< 2 { lp~(x * F32.round_from(i)) }     //~ E0811
  } else {
    [x, x]
  }
}

pub flow in_the_else_branch(x: F32 at sample, c: Bool at sample) -> [F32; 2] at sample {
  if c {
    [x, x]
  } else {
    par i in 0 ..< 2 { lp~(x * F32.round_from(i)) }     //~ E0811
  }
}

pub flow in_an_arm(x: F32 at sample, k: U32 at sample) -> [F32; 2] at sample {
  match k {
    0 => par i in 0 ..< 2 { lp~(x * F32.round_from(i)) },  //~ E0811
    _ => [x, x],
  }
}
