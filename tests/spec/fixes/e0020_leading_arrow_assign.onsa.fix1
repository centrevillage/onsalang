// onsa.toml
// [test]
// spec = ["§2.5", "§18.1"]
// fixes = 1

// E0020: a `->` or a `=` at the start of a line (spec §2.5, S-374, S-47, S-216, R-160). The continuing `->`
// and `=` go at the end of the line, as the binary operators do (a line that ends with them goes on:
// tests/spec/lex/continuation_top_level.onsa), and a line that starts with one is an error, in the
// brackets and outside them alike. The candidate moves the symbol to the end of the line before it (before
// that line's comment), where the head or the binding then goes on over the break. The main position
// is the symbol, so the marker is on its line. (`as` and `at` have no such rule inside brackets:
// tests/spec/lex/parens_as_at.onsa; outside the brackets they are E0002, tests/spec/negative/
// lines_as_at_outside_brackets.onsa.) One error in each declaration unit.

pub fn function_head(a: I32) ->
  I32 {                                            //~ E0020
  a
}

pub flow flow_head(x: F32 at sample) ->
  F32 at sample {                                  //~ E0020
  x
}

pub fn generic_head[T: PartialOrd](x: T, lo: T) ->
  T {                                              //~ E0020
  if x < lo { lo } else { x }
}

