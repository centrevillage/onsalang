// onsa.toml
// [test]
// spec = ["§3.1", "§3.3", "§6.3", "§18.1"]
// fixes = 1

// E0411 of an `as` whose source is a type parameter (`x: T`) and whose target is a float (§3.3): "型パラメータからの
// `as` も、境界が与える関連関数で同じに選ぶ". The bounds `Num` and `Float` both give `round_from` (its source
// bound is `AnyNum`, which `Num` and `Float` satisfy), so the one candidate replaces the whole `as` expression
// with `F32.round_from(x)` (or `F64`), as for a concrete pair. The operand stays as written (`-x as F32` is `(-x) as F32`, §3.1, so
// `F32.round_from(-x)`), and the parentheses of the place stay (`(x as F32) * y` becomes `(F32.round_from(x)) * y`). A target that is an
// alias of a float keeps its name in the candidate. The positions are the
// end of a function, a `let`, an argument, an operand, a branch, a closure and a method of an `impl` with a bounded
// parameter. One error in each function (P-01), so no error is left after the candidate. The last function is fine.

use std.array

type Sample = F32

pub struct Level[T] {
  v: T,
}

impl[T: Float] Level[T] {
  pub fn single(self) -> F32 {
    F32.round_from(self.v)                                   //~ E0411
  }
}

fn scaled(x: F32) -> F32 {
  x * 0.5
}

pub fn tail_float[T: Float](x: T) -> F32 {
  F32.round_from(x)                                          //~ E0411
}

pub fn tail_float_double[T: Float](x: T) -> F64 {
  F64.round_from(x)                                          //~ E0411
}

pub fn tail_num[T: Num](x: T) -> F32 {
  F32.round_from(x)                                          //~ E0411
}

pub fn tail_num_double[T: Num](x: T) -> F64 {
  F64.round_from(x)                                          //~ E0411
}

pub fn target_alias[T: Float](x: T) -> Sample {
  Sample.round_from(x)                                       //~ E0411
}

pub fn in_a_let[T: Float](x: T) -> F32 {
  let y = F32.round_from(x)                                  //~ E0411
  y
}

pub fn in_an_annotated_let[T: Num](x: T) -> F64 {
  let y: F64 = F64.round_from(x)                             //~ E0411
  y
}

pub fn as_an_argument[T: Float](x: T) -> F32 {
  scaled(F32.round_from(x))                                  //~ E0411
}

pub fn left_operand[T: Float](x: T, y: F32) -> F32 {
  (F32.round_from(x)) * y                                    //~ E0411
}

pub fn right_operand[T: Num](x: T, y: F32) -> F32 {
  y + (F32.round_from(x))                                    //~ E0411
}

pub fn negated_float[T: Float](x: T) -> F32 {
  F32.round_from(-x)                                         //~ E0411
}

pub fn negated_num[T: Num](x: T) -> F64 {
  F64.round_from(-x)                                         //~ E0411
}

pub fn in_a_branch[T: Float](flag: Bool, x: T, y: F32) -> F32 {
  if flag { F32.round_from(x) } else { y }                   //~ E0411
}

pub fn in_a_closure[T: Float](x: T) -> [F32; 4] {
  array.from_fn(fn(i) { F32.round_from(x) })                 //~ E0411
}

pub fn fine[T: Float](x: T, y: T) -> F32 {
  F32.round_from(x) + F32.round_from(-y)
}
