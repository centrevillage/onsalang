// at = "15:5"
// code = "E0401"
// candidate = 1
// clean = true

// E0401 for `a >> n` where `T: Num` (§6.3: the shifts are bit operators, `Int`, so `T: Num` becomes `T: Num + Int`).
// The one candidate joins `Int`; no diagnostic is left after it.

pub fn shifted[T: Num + Int](a: T, n: U32) -> T {
  a >> n                                            //~ E0401
}
