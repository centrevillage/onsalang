// onsa.toml
// [test]
// spec = ["§18.1", "§8.1"]
// fixes = 1

// A failed name in the effect row of the function type of an alias is silent. The alias is expanded where
// it is written, so `h` and its caller `m` write its type; after the candidate, what they report is of
// defs the failed name held back.
use util                                       //~ E0302

pub type A = fn() -> I32 uses {util}

pub fn h(a: A) -> I32 {
  a.()
}

pub fn p() -> I32 {
  1
}

pub fn m() -> I32 {
  h(p)
}
