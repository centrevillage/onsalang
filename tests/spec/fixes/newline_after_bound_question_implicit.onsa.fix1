// onsa.toml
// [test]
// spec = ["§2.5", "§4.5", "§18.1"]
// fixes = 1

// S-957 (W5-11 U10d2/t2, §2.5, §4.5, §18.1; the first form of R-384): `Dup` in a list is the implicit requirement
// that the types stage takes out (E0020, S-416), and a `?` with a line break before its name stands after it
// (`T: Dup + ?` and `Escape]` on the next line). The line break is the error of the syntax stage, which is first, so the
// unit reports only this E0020 on the `?`, with the one candidate that moves the `?` to the line of its name; the `Dup` is
// reported after the candidate is applied, and the `?Escape` stays a right element (the form after it is in
// newline_after_bound_question_implicit_moved.onsa). The main position is the `?`. One error per declaration unit (P-01).

pub fn a_comment_after_the_mark[T: Dup +   //~ E0020 @42
  ?Escape](x: T) -> U32 {
  0
}

pub fn a_comment_line_after_the_mark[T: Dup +   //~ E0020 @47
  // the name
  ?Escape](x: T) -> U32 {
  0
}

pub fn after_two_elements[T: Dup + Show +   //~ E0020 @43
  ?Escape](x: T) -> U32 {
  0
}

pub struct Bag[T: Dup +   //~ E0020 @25
  ?Escape] {
  n: U32,
}
