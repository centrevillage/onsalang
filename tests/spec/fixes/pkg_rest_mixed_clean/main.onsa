// S-903 (§7, §15.1, §18.1): the candidate of a `..` that leaves a field this module can see (`a`) and two it cannot
// (`b` and `c` of `Mixed`, `priv` in `shapes`) puts the last `_` in place of the `..` (`Mixed { _ }`), and the file is clean
// after it. The main position is the `..`. This file has this one error. The form that writes a field before the `..` is
// in ../pkg_rest_hidden_clean/.

use shapes.Mixed

pub fn first(m: Mixed) -> F32 {
  match m {
    Mixed { .. } => 0.0,                            //~ E0020
  }
}
