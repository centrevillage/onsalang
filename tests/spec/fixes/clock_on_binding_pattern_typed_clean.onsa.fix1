// E0020 for the clock written on the binding side of a `let` or `var` (spec §11.3, §18.1; S-378; the row
// `clock_on_binding` of spec/foreign-forms.toml): after the name or the pattern, with or without a type
// annotation, the code and the candidate are those of `let y: F32 at sample = x`.
// Here the clock stands after the type annotation of a pattern (the form that is E0020 already for a
// name). The candidate moves it after the value and leaves nothing (`clean`). This file has this one error.

pub flow clock_after_the_type_of_a_pattern(p: (F32, F32) at block) -> F32 at sample {
  let (a, b): (F32, F32) = p at sample              //~ E0020
  a + b
}
