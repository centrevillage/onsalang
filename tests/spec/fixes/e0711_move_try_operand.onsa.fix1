// onsa.toml
// [test]
// spec = ["§5.2", "§18.1"]
// fixes = 1
// [[test.fix]]
// at = "19:18"
// code = "E0711"
// candidate = 1
// clean = true

// R-198, S-605 (§5.2): the operand `r?` of the `move` in the argument of a `move` parameter is the result of a postfix `?`, not a place. The candidate removes the
// `move`; the operand of the postfix `?` is a position where an owned value is taken out without a mark (§5.2), so the file has no diagnostic after it.

pub fn len_of(move b: Buf[F32]) -> U32 uses {Alloc} {
  b.len()
}

pub fn try_result(move r: Result[Buf[F32], U32]) -> Result[U32, U32] uses {Alloc} {
  Ok(len_of(r?)) //~ E0711
}
