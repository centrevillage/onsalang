// onsa.toml
// [test]
// spec = ["§2.5", "§6.5", "§15.1", "§18.1"]
// fixes = 1

// S-957 (W5-11 U10d2/t2, §2.5, §6.5): a line break after the `@` of an attribute is E0020 in each module of a package, and the
// candidates are applied in each file. This module has the form on a function and on the input of a flow, and calls what
// util.onsa declares (which has the form on a function and on a struct). One error per declaration unit (P-01).

use util.scale

   //~ E0020 @1
  @fp(relaxed)
pub fn a_function_of_this_module(x: F32) -> F32 {
  scale(x)
}

pub flow with_an_input(
  x: F32 at sample,
   //~ E0020 @3
  @param(min: 0.0, max: 1.0, default: 0.5)
  g: F32 at block,
) -> F32 at sample {
  x * g
}
