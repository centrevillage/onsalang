// onsa.toml
// [test]
// spec = ["§3.1", "§3.3", "§6.3", "§18.1"]
// fixes = 2

// E0411 of an `as` from a type parameter with the bound `Float` (`x: T`) to an integer (§3.3). A float to an integer
// reads differently in other languages, so the candidates are listed by reading, as for a concrete float: `trunc_sat_from`
// first (the meaning of Rust's `as`, saturating, NaN is 0) and `trunc_from` second (out of range and NaN panic). The
// source bound of both is `Float`, which `T: Float` satisfies. Each candidate replaces the whole `as` expression, the
// operand stays as written (`-x as I32` is `(-x) as I32`, §3.1, so `I32.trunc_sat_from(-x)`), and the parentheses of
// the place stay. A target that is an alias of an integer keeps its name in the candidate. The positions
// are the end of a function, a `let`, an argument, an operand, a branch, a closure and a method of an `impl` with a
// bounded parameter. One error in each function (P-01), so no error is left after either candidate. The last function
// is fine.

use std.array

type Index = U32

pub struct Level[T] {
  v: T,
}

impl[T: Float] Level[T] {
  pub fn whole(self) -> I32 {
    I32.trunc_sat_from(self.v)                                   //~ E0411
  }
}

fn twice(n: I32) -> I32 {
  n * 2
}

pub fn tail_i32[T: Float](x: T) -> I32 {
  I32.trunc_sat_from(x)                                          //~ E0411
}

pub fn tail_u8[T: Float](x: T) -> U8 {
  U8.trunc_sat_from(x)                                           //~ E0411
}

pub fn tail_u32[T: Float](x: T) -> U32 {
  U32.trunc_sat_from(x)                                          //~ E0411
}

pub fn tail_i64[T: Float](x: T) -> I64 {
  I64.trunc_sat_from(x)                                          //~ E0411
}

pub fn target_alias[T: Float](x: T) -> Index {
  Index.trunc_sat_from(x)                                        //~ E0411
}

pub fn in_a_let[T: Float](x: T) -> I32 {
  let n = I32.trunc_sat_from(x)                                  //~ E0411
  n
}

pub fn in_an_annotated_let[T: Float](x: T) -> I16 {
  let n: I16 = I16.trunc_sat_from(x)                             //~ E0411
  n
}

pub fn as_an_argument[T: Float](x: T) -> I32 {
  twice(I32.trunc_sat_from(x))                                   //~ E0411
}

pub fn left_operand[T: Float](x: T, n: I32) -> I32 {
  (I32.trunc_sat_from(x)) + n                                    //~ E0411
}

pub fn right_operand[T: Float](x: T, n: I32) -> I32 {
  n - (I32.trunc_sat_from(x))                                    //~ E0411
}

pub fn negated[T: Float](x: T) -> I32 {
  I32.trunc_sat_from(-x)                                         //~ E0411
}

pub fn in_a_branch[T: Float](flag: Bool, x: T, n: I32) -> I32 {
  if flag { I32.trunc_sat_from(x) } else { n }                   //~ E0411
}

pub fn in_a_closure[T: Float](x: T) -> [I32; 4] {
  array.from_fn(fn(i) { I32.trunc_sat_from(x) })                 //~ E0411
}

pub fn fine[T: Float](x: T, y: T) -> I32 {
  I32.trunc_sat_from(x) + I32.trunc_from(-y)
}
