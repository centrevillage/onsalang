// onsa.toml
// [test]
// spec = ["§5.1", "§18.1"]
// fixes = 1

// E0020 for `++x`, `x++`, `--x` and `x--` in a statement position, with a name or a field path
// as the operand (S-250; docs/foreign-forms.toml row `increment`). A `--` or `++` with no space
// is read as an increment (a space between two `-` is two prefix operators, E0012, §3.1). The
// candidate is `x = x + 1` or `x = x - 1`.

pub struct Counter {
  n: I32,
}

pub fn post_increment(inout x: I32) {
  x = x + 1                                         //~ E0020
}

pub fn pre_increment(inout x: I32) {
  x = x + 1                                         //~ E0020
}

pub fn post_decrement(inout x: I32) {
  x = x - 1                                         //~ E0020
}

pub fn pre_decrement(inout x: I32) {
  x = x - 1                                         //~ E0020
}

pub fn field_path(inout c: Counter) {
  c.n = c.n + 1                                     //~ E0020
}

pub fn fine(inout x: I32) {
  x = x + 1
}
