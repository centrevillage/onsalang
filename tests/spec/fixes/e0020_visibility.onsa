// onsa.toml
// [test]
// spec = ["§15.1", "§18.1"]
// fixes = 1

// E0020 for a visibility of Rust and of the old version, in front of an item, an `impl` member, a `use`, and the field
// of a struct that has no visibility word or has `priv` (spec §15.1, S-35, S-36, S-412; the rows `pub_pkg` and
// `pub_crate` of spec/foreign-forms.toml). The visibility is `pub`, none (the package) or `priv` (the module); the
// forms `pub(pkg)` and `pub(crate)` do not exist, and a space between `pub` and `(` is the same single error.
// The candidate takes the whole visibility out: the item has then no visibility word (the package). The main
// position is the `pub`. The `pub struct` field with `pub(crate)` or `pub(pkg)` has no candidate and is
// E0002 (negative/visibility_restricted.onsa). One error in each declaration unit (P-01).

pub(pkg) fn pkg_fn() -> I32 {                       //~ E0020
  1
}

pub (pkg) fn pkg_fn_spaced() -> I32 {               //~ E0020
  2
}

pub(crate) fn crate_fn() -> I32 {                   //~ E0020
  3
}

pub (crate) fn crate_fn_spaced() -> I32 {           //~ E0020
  4
}

pub(crate) rt fn crate_rt_fn() -> I32 {             //~ E0020
  5
}

pub(pkg) struct PkgStruct {                         //~ E0020
  x: I32,
}

pub(crate) enum CrateEnum {                         //~ E0020
  A,
  B,
}

pub(crate) const CRATE_CONST: I32 = 4               //~ E0020

pub(pkg) type PkgSample = F32                       //~ E0020

pub(crate) flow crate_flow(x: F32 at sample) -> F32 at sample { //~ E0020
  x
}

pub(pkg) use std.math                               //~ E0020

pub struct Target {
  v: I32,
}

impl Target {
  pub(crate) fn crate_member(self) -> I32 {         //~ E0020
    self.v
  }

  pub(pkg) fn pkg_member(self) -> I32 {             //~ E0020
    self.v
  }

  pub(crate) const MEMBER_CONST: I32 = 1            //~ E0020

  pub fn fine_member(self) -> I32 {
    self.v
  }
}

struct NoVisibility {
  pub(crate) a: I32,                                //~ E0020
}

priv struct Hidden {
  pub(pkg) b: I32,                                  //~ E0020
}

pub fn fine() -> I32 {
  1
}
