// onsa.toml
// [test]
// spec = ["§2.5", "§11.4", "§18.1"]
// fixes = 1

// E0807 for `delay~(e, 1)` whose arguments end with a `,` (§2.5: a `,` may end a list in
// parentheses): one sample of delay is `prev~` (§11.4), and the candidate writes `prev~` from it,
// removing the length and keeping the rest, the `,` at the end too (§18.1: the edits replace only
// the tokens that change, S-251). One error per flow (P-01).

pub flow trailing(x: F32 at sample) -> F32 at sample {
  delay~(x, 1,)                 //~ E0807
}

pub flow trailing_with_init(x: F32 at sample) -> F32 at sample {
  delay~(x, 1, 0.5,)            //~ E0807
}
