// onsa.toml
// [test]
// spec = ["§2.5", "§3.1", "§18.1"]
// fixes = 1

// E0012 for two prefix operators written apart, `- - x` (§3.1, S-410): the candidate puts the inner
// one in parentheses, and takes the space out with it (`-(-x)`, `!(!b)`). It is one error: the E0020 of
// §2.5 for a space after a prefix is not reported on top of it, because the candidate that only removes the
// space would write `--x` (an increment) and `!!b`. Applied alone, the candidate leaves no error in the
// unit it touches (§18.1, S-236; checked by the runner, W3-17). `- -x` of
// tests/spec/negative/syntax_groups.onsa stays E0012. One error per declaration unit (P-01).

pub fn two(a: I32, b: I32) -> I32 {
  a + b
}

pub fn negate_twice(x: I32) -> I32 {
  -(-x)                                             //~ E0012
}

pub fn not_twice(b: Bool) -> Bool {
  !(!b)                                             //~ E0012
}

pub fn a_space_before_the_inner_one(x: I32) -> I32 {
  -(-x)                                             //~ E0012
}

pub fn in_an_argument(a: I32) -> I32 {
  two(-(-a), 1)                                     //~ E0012
}

pub fn in_a_let(a: I32) -> I32 {
  let b = -(-a)                                     //~ E0012
  b
}

pub fn fine(x: I32, b: Bool) -> I32 {
  let y = -(-x)
  let c = !(!b)
  if c { y } else { 0 }
}
