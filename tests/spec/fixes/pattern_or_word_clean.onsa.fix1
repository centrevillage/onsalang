// onsa.toml
// [test]
// spec = ["§7", "§18.1"]
// fixes = 1
// [[test.fix]]
// at = "16:5"
// code = "E0020"
// candidate = 1
// clean = true

// S-402 (§7): the candidate `0 | 1 =>` of `0 or 1 =>` leaves nothing (`clean`). This file has this one error; the forms are in
// pattern_or_word_forms.onsa.

pub fn only_one_form(n: I32) -> I32 {
  match n {
    0 | 1 => 1,                                    //~ E0020
    _ => 0,
  }
}
