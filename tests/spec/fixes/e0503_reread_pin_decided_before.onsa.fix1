// S-876 (U4a of W5-09; R-387): the statement after the `return` reads `n`, whose type is decided before the block as well, so the deletion of the unreachable item is the one candidate, and the file after it has no diagnostic (`clean`).
// The pin makes a lost candidate a failure.

pub fn need_u8(x: U8) {
}

pub fn decided_before_the_block(c: Bool) -> F64 {
  let n = 5
  need_u8(n)
  if c {
    return 1.0
                                          //~ E0503
  }
  n as F64
}
