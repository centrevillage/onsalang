// onsa.toml
// [test]
// spec = ["§2.2", "§2.3", "§18.1"]
// fixes = 1

// E0002 for keywords written as parameters (S-654, §2.3): the first and the second of a function, the input of a `flow`, and
// the parameter of a method after `self`. The candidate is the name with a `_` at the end. One error in each unit.

pub fn first(in: F32) -> F32 {                      //~ E0002
  0.0
}

pub fn second(a: I32, type: I32) -> I32 {           //~ E0002
  a
}

pub flow input(as: F32 at sample) -> F32 at sample {  //~ E0002
  0.0
}

pub struct P {
  x: I32,
}

impl P {
  fn scale(self, uses: I32) -> I32 {                //~ E0002
    self.x
  }
}
