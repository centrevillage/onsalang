// onsa.toml
// [test]
// spec = ["§2.5", "§6.5", "§15.5", "§18.1"]
// fixes = 1

// W5-24 U3a/t, S-484 (spec §6.5: "`@fp` に属性を付けないときと同じ意味を名指す値（`@fp(strict)`、§15.5
// の既定）と、属性で選べない浮動小数のプロファイルの名前（`@fp(strict-ftz)`）は、同じ E0005 で、修正候補は属性を除くことである"): the two names are the only ones taken out;
// "この二つのほかの名前は、綴りや意味の近さによらず一覧の値を候補にする". `fast`, `precise`, `default`, a name that differs by its case (`Relaxed`, `Strict`) or by
// a `_` (`strict_ftz`), and a string (`"strict"`) are E0005 whose one candidate is the value of the list, `@fp(relaxed)`. A fn and
// a flow, on the line of the item or on a line of its own. One error in each declaration unit (P-01).

@fp(relaxed) pub fn u0(x: F32) -> F32 {                //~ E0005
  x * 1.0
}

@fp(relaxed) pub fn u1(x: F32) -> F32 {             //~ E0005
  x * 2.0
}

@fp(relaxed) pub fn u2(x: F32) -> F32 {             //~ E0005
  x * 3.0
}

@fp(relaxed) pub fn u3(x: F32) -> F32 {             //~ E0005
  x * 4.0
}

@fp(relaxed) pub fn u4(x: F32) -> F32 {            //~ E0005
  x * 5.0
}

@fp(relaxed) pub fn u5(x: F32) -> F32 {              //~ E0005
  x * 6.0
}

@fp(relaxed) pub fn u6(x: F32) -> F32 {          //~ E0005
  x * 7.0
}

@fp(relaxed) pub flow f0(x: F32 at sample) -> F32 at sample {   //~ E0005
  x * 1.0
}

@fp(relaxed) pub flow f1(x: F32 at sample) -> F32 at sample {   //~ E0005
  x * 2.0
}

@fp(relaxed)                                        //~ E0005
pub fn u20(x: F32) -> F32 {
  x * 21.0
}

@fp(relaxed)
pub fn fine(x: F32) -> F32 {
  x * 9.0
}
