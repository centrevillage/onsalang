// onsa.toml
// [test]
// fixes = 0
// spec = ["§4.4", "§18.1"]

// The `..` of Rust in a struct literal (`Item { x: 1, .. }`, `Item { x: 1, ..v }`) is not a form of this
// language: the rest is filled with the declared defaults by `...` (spec §4.4). A form that cannot be
// turned into a candidate is E0002 (§18.1, spec/foreign-forms.toml `struct_lit_base`), so there is no
// candidate (`fixes = 0`). Each function is a unit with one error.

pub struct Item {
  x: U32,
  y: F32,
}

pub fn rest_mark() -> Item {
  Item { x: 1, .. }  //~ E0002
}

pub fn rest_mark_alone() -> Item {
  Item { .. }  //~ E0002
}

pub fn base_value(v: Item) -> Item {
  Item { x: 1, ..v }  //~ E0002
}

pub fn base_value_alone(v: Item) -> Item {
  Item { ..v }  //~ E0002
}

pub fn base_call() -> Item {
  Item { x: 1, ..Item.default() }  //~ E0002
}
