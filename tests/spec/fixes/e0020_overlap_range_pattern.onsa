// E0020 for a range pattern that starts with another form of the list (R-206; docs/foreign-forms.toml rows
// `literal_suffix`, `prefix_plus` and `range_pattern`). Two rows start at the same token, and a unit
// reports one error (§18.1): the one that sorts first by the order of `diagnostics` (start, end, code,
// message; S-281, tests/spec/negative/syntax_same_start.onsa). The range pattern is the whole range
// (`1u8..<3`) and the other form is its first token (`1u8`, `+`), so the other form ends first and is the
// error. Its candidate is the one of its own row (`1u8` is `1`; a prefix `+` is removed, §3.1), and the
// range pattern is still there after it: it is reported by the next check, as the `leaves` entries of the
// header say (S-236, S-314; the position is that of the fixed text, where the range starts at the place of
// the form that was replaced). The range pattern is outside the promise of S-236, which holds for the only
// error of a unit. The compiler used to stop with an internal error on these ("two rows match one
// failure"). A form in the end of the range (`1..<3u8`, `1..<+3`) is not here: the range starts before it,
// so the range pattern is the error, and the place of the form after its candidate (a guard that copies
// the end) depends on the name that the candidate makes (S-253).
//
// One error per function (P-01). The right forms are at the end of the file.

pub fn ticket_input(x: U8) -> I32 {
  match x { 1u8..<3 => 1, _ => 0 }                  //~ E0020 @13
}

pub fn suffix_before_half_open(x: U8) -> I32 {
  match x {
    1u8..<3 => 1,                                   //~ E0020
    _ => 0,
  }
}

pub fn suffix_before_closed(x: U8) -> I32 {
  match x {
    1u8..=3 => 1,                                   //~ E0020
    _ => 0,
  }
}

pub fn suffix_before_two_dots(x: U8) -> I32 {
  match x {
    1u8..3 => 1,                                    //~ E0020
    _ => 0,
  }
}

pub fn suffix_before_three_dots(x: U8) -> I32 {
  match x {
    1u8...3 => 1,                                   //~ E0020
    _ => 0,
  }
}

pub fn suffix_before_range_from(x: U8) -> I32 {
  match x {
    1u8.. => 1,                                     //~ E0020
    _ => 0,
  }
}

pub fn suffix_of_c_unsigned_long(x: U64) -> I32 {
  match x {
    100ul..<200 => 1,                               //~ E0020
    _ => 0,
  }
}

pub fn suffix_of_a_hex_literal(x: U8) -> I32 {
  match x {
    0x1F_u8..<0x2F => 1,                            //~ E0020
    _ => 0,
  }
}

pub fn suffix_with_digit_separators(x: U32) -> I32 {
  match x {
    1_000u32..<2_000 => 1,                          //~ E0020
    _ => 0,
  }
}

pub fn suffix_with_a_guard(x: U8, flag: Bool) -> I32 {
  match x {
    1u8..<3 if flag => 1,                           //~ E0020
    _ => 0,
  }
}

pub fn suffix_inside_some(o: Option[U8]) -> I32 {
  match o {
    Some(1u8..<3) => 1,                             //~ E0020
    _ => 0,
  }
}

pub fn suffix_in_a_tuple(t: (U8, I32)) -> I32 {
  match t {
    (1u8..<3, n) => n,                              //~ E0020
    _ => 0,
  }
}

pub fn suffix_in_the_second_place(t: (I32, U8)) -> I32 {
  match t {
    (n, 1u8..<3) => n,                              //~ E0020
    _ => 0,
  }
}

pub fn prefix_plus_before_half_open(x: I32) -> I32 {
  match x {
    +1..<3 => 1,                                    //~ E0020
    _ => 0,
  }
}

pub fn prefix_plus_before_closed(x: I32) -> I32 {
  match x {
    +1..=3 => 1,                                    //~ E0020
    _ => 0,
  }
}

pub fn prefix_plus_before_range_from(x: I32) -> I32 {
  match x {
    +1.. => 1,                                      //~ E0020
    _ => 0,
  }
}

pub fn prefix_plus_with_a_space(x: I32) -> I32 {
  match x {
    + 1..<3 => 1,                                   //~ E0020
    _ => 0,
  }
}

pub fn prefix_plus_inside_some(o: Option[I32]) -> I32 {
  match o {
    Some(+1..<3) => 1,                              //~ E0020
    _ => 0,
  }
}

pub fn prefix_plus_in_a_tuple(t: (I32, I32)) -> I32 {
  match t {
    (+1..<3, n) => 1,                               //~ E0020
    _ => 0,
  }
}

// The right forms: a guard, and the plain literals of the patterns.
pub fn fine(x: U8, y: I32) -> I32 {
  let a = match x {
    1 => 1,
    k if 1 <= k && k < 3 => 2,
    _ => 0,
  }
  let b = match y {
    -1 => 1,
    k if 1 <= k && k <= 3 => 2,
    _ => 0,
  }
  a + b
}
