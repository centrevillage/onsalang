// onsa.toml
// [test]
// spec = ["§2.5", "§4.5", "§18.1"]
// fixes = 1

// S-548 (W5-24 U6b): an empty list of type arguments after a name in an expression (`f::[](1)`, `Buf::[].zeroed(4)`,
// `v.conv::[](1)`) is an E0002 whose one candidate takes the empty list out, from the `::` to the `]` (§2.5: "式の中の
// 空の型引数 `f::[]`... も E0002 で、修正候補は同じく空の並びを除く形（`f::[](1)` は `::` ごと除いて `f(1)`）"; §4.5). The
// places are a call, a type with an associated function, a method, an associated constant, a value that is not called, a
// path of modules, a struct literal, a branch, a closure and a `par~`. A comment inside the list has no candidate
// (negative/type_args_empty_comment.onsa). The candidate leaves an error of a later stage when the function has type
// parameters (E0406 or E0412), which is the error of the program without the list.

use std.array

pub struct Rg[T, const N: U32] {
  d: [T; N],
}

impl[T, const N: U32] Rg[T, N] {
  pub const CAP: U32 = 4
}

pub struct Ring[T, const N: U32] {
  d: [T; N],
}

pub struct Mat[T, const R: U32, const C: U32] {
  d: [T; R],
}

pub const TABLE: U32 = 8

pub fn id[T](x: T) -> T {
  x
}

pub fn a_call() -> U8 {
  id::[](1)                                         //~ E0002
}

pub fn a_type_with_an_associated_function() -> U32 {
  let b = Buf::[].zeroed(4)                         //~ E0002
  b.len()
}

pub fn an_associated_constant() -> U32 {
  Rg::[].CAP                                        //~ E0002
}

pub fn a_method(v: V) -> I32 {
  v.conv::[](1)                                     //~ E0002
}

pub fn a_value_that_is_not_called() -> fn(U8) -> U8 {
  id::[]                                            //~ E0002
}

pub fn a_path_of_modules() -> U8 {
  util.id::[](1)                                    //~ E0002
}

pub fn a_struct_literal() -> U32 {
  let r = Ring::[] { d: [0.0; 4] }                  //~ E0002
  1
}

pub fn in_a_branch(c: Bool) -> U8 {
  if c {
    id::[](1)                                       //~ E0002
  } else {
    2
  }
}

pub fn in_a_closure() -> [U8; 2] {
  array.from_fn(fn(_) {
    id::[](1)                                       //~ E0002
  })
}

pub flow in_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0 ..< 2 { id::[](x) }          //~ E0002
  x
}

pub fn fine() -> U8 {
  id(1)
}
