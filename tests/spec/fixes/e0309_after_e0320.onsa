// onsa.toml
// [test]
// spec = ["§2.3", "§5.1", "§18.1"]
// fixes = 1

// The second round of the repair loop of an unused binding whose name starts with `_` (spec 2.3, 5.1,
// 18.1; S-716, S-726). negative/unused_binding_leading_underscore reports the E0320 of `_x` (candidate
// `x`); this file holds the same units with the names after that candidate. The binding is still not
// read, so now it is the E0309, and its candidate renames it to `_`; the default contract of `fixes = 1`
// checks that nothing is left in the unit after it. So the loop stops after two rounds (`_x` to `x` to
// `_`). The `var` of that file has no candidate for the E0309, so it is in
// negative/unused_binding_assigned.

fn apply(f: fn(I32) -> I32, x: I32) -> I32 {
  f.(x)
}

pub fn let_binding() -> I32 {
  let x = 1 //~ E0309 @7
  1
}

pub fn typed_binding() -> I32 {
  let x: I32 = 1 //~ E0309 @7
  1
}

pub fn arm_binding(o: Option[I32]) -> I32 {
  match o {
    Some(k) => 1, //~ E0309 @10
    None => 0,
  }
}

pub fn for_binding(n: U32) -> U32 {
  var count = 0
  for i in 0 ..< n { //~ E0309 @7
    count = count + 1
  }
  count
}

pub fn destructuring(pair: (I32, I32)) -> I32 {
  let (a, b) = pair //~ E0309 @8
  b
}

pub fn nested_pattern(o: Option[(I32, I32)]) -> I32 {
  match o {
    Some((a, b)) => b, //~ E0309 @11
    None => 0,
  }
}

pub fn closure_body() -> I32 {
  apply(fn(x: I32) -> I32 {
    let t = x //~ E0309 @9
    x
  }, 3)
}

test "a leading underscore in a test" {
  let x = 1 //~ E0309 @7
  assert true
}
