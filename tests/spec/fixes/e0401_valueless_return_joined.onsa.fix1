// onsa.toml
// [test]
// spec = ["§7", "§2.5", "§6.1", "§18.1"]
// fixes = 1

// S-886 (§7, §2.5): a `return` without a value in a function that gives a value is E0401 on the `return` (the type of the
// `return` is `()`, §6.1), and "値の無い `return` の次の行に式があるとき: 値を返す関数では `return` の E0401 に ...
// つないだ形（`return x * 2`）を候補として並べる". The `return` ends its line (§2.5), and the next line is the last item of the
// block and an expression of the type that the function gives, so the one candidate is the joined form (the E0401 stays on the
// `return`, not E0503 on the line after it, because the check of the order of the statements reaches the `return`
// first; the candidate is a single edit, and it does not remove the items that follow). The forms without the candidate are in
// negative/e0401_valueless_return_not_joined.onsa. One error per function (P-01); the marker is on the `return`.

fn double(n: I32) -> I32 {
  n * 2
}

pub fn a_product(x: I32) -> I32 {
  return x * 2                                            //~ E0401
}

pub fn a_variable(x: I32) -> I32 {
  return x                                            //~ E0401
}

pub fn a_literal() -> I32 {
  return 0                                            //~ E0401
}

pub fn a_call(x: I32) -> I32 {
  return double(x)                                            //~ E0401
}

pub fn a_float(x: F32) -> F32 {
  return x + 1.0                                            //~ E0401
}

pub fn a_bool(x: I32) -> Bool {
  return x > 0                                            //~ E0401
}

pub fn an_unsigned_in_range(x: U8) -> U8 {
  return x * 3                                            //~ E0401
}

pub fn an_option(x: I32) -> Option[I32] {
  return Some(x)                                            //~ E0401
}

pub fn an_if(c: Bool, x: I32) -> I32 {
  return if c { x } else { 0 }                                            //~ E0401
}

pub fn in_a_branch(c: Bool, x: I32) -> I32 {
  if c {
    return x * 2                                          //~ E0401
  } else {
    3
  }
}

pub fn in_a_loop_body(n: I32) -> I32 {
  for i in 0 ..< n {
    return i * 2                                          //~ E0401
  }
  0
}

pub fn in_an_anonymous_function(x: I32) -> I32 {
  let f = fn(a: I32) -> I32 {
    return a * 2                                          //~ E0401
  }
  f.(x)
}

pub rt fn in_an_rt_function(x: I32) -> I32 {
  return x * 2                                            //~ E0401
}
