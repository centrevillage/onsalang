// W5-24 U3c, S-990, S-484 (spec §18.1: "属性の中身は頭に書いたときと同じに読み（§6.5）、中身の誤りは移した後の検査で報告する"; §6.5: "`@fp` に属性を付けないときと
// 同じ意味を名指す値（`@fp(strict)`、§15.5 の既定）と、属性で選べない浮動小数のプロファイルの名前（`@fp(strict-ftz)`）は、同じ E0005 で、修正候補は属性を除くことである"):
// `@fp(strict)` and `@fp(strict-ftz)` after `pub` or `rt` read as they would at the head of the declaration, so they are the E0002 of
// their place with the one candidate that moves them before the visibility and `rt`, as every attribute that reads there is; the
// E0005 of the value is left after the move, at the attribute moved (`leaves`), and its candidate takes the attribute out
// (tests/spec/fixes/fp_default_name_forms.onsa). One error in each declaration unit (P-01).

@fp(strict) pub fn default_name_fn(x: F32) -> F32 {   //~ E0002
  x
}

@fp(strict) rt fn default_name_rt(x: F32) -> F32 {   //~ E0002
  x
}

@fp(strict) pub rt fn default_name_pub_rt(x: F32) -> F32 {   //~ E0002
  x
}

@fp(strict) pub flow default_name_flow(x: F32 at sample) -> F32 at sample {   //~ E0002
  x
}

@fp(strict-ftz) pub fn profile_name_fn(x: F32) -> F32 {   //~ E0002
  x
}

@fp(strict, relaxed) pub fn default_name_and_more(x: F32) -> F32 {   //~ E0002
  x
}

struct P {
  x: F32,
}

impl P {
  @fp(strict) pub fn member(self) -> F32 {   //~ E0002
    self.x
  }
}
