// onsa.toml
// [test]
// spec = ["§2.1", "§6.5", "§14.2", "§18.1"]
// fixes = 1

// E0004 for a `///` between two attributes of a declaration (§2.1, S-432): the doc comment is
// not attached, and the candidate moves the line to the place right before the FIRST attribute,
// after the `///` lines that already stand there. A place takes each attribute once (§6.5,
// S-490), so the two attributes are different ones: `@export` and `@fp(relaxed)` on a `pub fn`
// and a `pub flow` of the top level (§14.2), in either order. A method takes no `@export`, so
// there is no pair of attributes on a method in this version. One error per declaration (P-01).

/// Between two attributes.                              //~ E0004
@export
@fp(relaxed)
pub fn between_two(x: F32) -> F32 {
  x
}

/// Before the attributes.
/// Between the first and the second.                    //~ E0004
@fp(relaxed)
@export
pub fn between_two_with_a_doc_before(x: F32) -> F32 {
  x
}

/// Between two attributes of a flow.                    //~ E0004
@export
@fp(relaxed)
pub flow f(x: F32 at sample) -> F32 at sample {
  x
}
