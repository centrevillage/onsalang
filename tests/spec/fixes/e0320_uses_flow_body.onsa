// onsa.toml
// [test]
// spec = ["§2.3", "§11.2", "§11.3", "§18.1"]
// fixes = 1

// W4-04 U9, S-82, R-87 (5), S-542: the one candidate of an E0320 on a name in a flow renames the
// binding and every read of it in the flow, so the unit of the flow has no error of the stage after
// the candidate (`E0302` for a read of the old name, §18.1). The names are an input of the flow, a
// `let` of the body, and the name of a `let` that is read by the feedback `^name` (§11.2) and by an
// instance that is given it (`f~(name)`, §11.4). Each flow is a unit of its own with one error, and
// every binding is read (§5.1).

pub flow input_read(
  inSignal: F32 at sample, //~ E0320
  gain: F32 at block,
) -> F32 at sample {
  inSignal * gain + inSignal * 0.5
}

pub flow let_read(
  x: F32 at sample,
) -> F32 at sample {
  let someLevel = x * 0.5 //~ E0320
  someLevel + someLevel
}

pub flow feedback(
  x: F32 at sample,
) -> F32 at sample {
  let someOut = x + 0.5 * prev~(^someOut) //~ E0320
  someOut
}

pub flow given_to_an_instance(
  x: F32 at sample,
) -> F32 at sample {
  let someLevel = x * 0.5 //~ E0320
  let y         = smoothing~(someLevel)
  y + someLevel
}

flow smoothing(
  x: F32 at sample,
) -> F32 at sample {
  let y = x * 0.5 + 0.5 * prev~(^y)
  y
}

pub flow pattern_in_a_match(
  k: U32 at sample,
) -> F32 at sample {
  match k {
    0 => 0.0,
    someN => someN.round_f32(), //~ E0320
  }
}
