// at = "21:11"
// code = "E0601"
// candidate = 1
// clean = true

// §8.1, S-364 and R-455: the row after `fn(I32) -> fn(I32) -> I32` would be the innermost result's, so the
// candidate puts the whole result in parentheses: `-> (fn(I32) -> fn(I32) -> I32) uses {Alloc}`.

pub fn bump(y: I32) -> I32 uses {Alloc} { y }

pub fn inc(y: I32) -> I32 { y }

pub fn kk(y: I32) -> fn(I32) -> I32 { inc }

pub fn mk() -> (fn(I32) -> fn(I32) -> I32) uses {Alloc} {
  let _ = bump(1)                                   //~ E0601 @11
  kk
}
