// onsa.toml
// [test]
// spec = ["§11.3", "§5.2", "§18.1"]
// fixes = 1

// E0020 for the clock of a binding whose value is a `move`, outside a flow (spec §11.3, §5.2, §18.1; S-381): the candidate
// removes the clock (a `move` cannot be written in parentheses, §5.2, so there is no place to move it to), with no
// annotation. In a flow the same form is E0002 with no candidate (negative/clock_on_binding_move_flow.onsa).

pub fn move_with_no_type(x: I32) -> I32 {
  let y at sample = move x                          //~ E0020
  y
}
