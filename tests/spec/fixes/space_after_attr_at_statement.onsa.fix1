// onsa.toml
// [test]
// spec = ["§2.5", "§6.5", "§12.4", "§18.1"]
// fixes = 1

// S-489 (W5-11 U10d2, §2.5, §6.5): a space after the `@` of the attribute of a statement is E0020 too, and the
// candidate removes the space (`@mem(bulk) let y = …`). Before S-489 this position was E0002 ("expected an expression,
// found `@`") where the heading of an item and the input of a flow took the space, and now the three places are the
// same rule. The forms are tried in the places a `let` can stand: the first statement of a flow, a later one, in the
// branch of an `if~`, in a nested block, in the body of a `par~`, and the one in a function. One error per declaration
// unit (P-01). The candidate leaves what this version says of `@mem` (E0200, a later stage than the syntax one, §18.1),
// which is not checked here.

pub flow first_statement(x: F32 at sample) -> F32 at sample {
  @mem(bulk) let y = delay~(x, 4)   //~ E0020
  y
}

pub flow later_statement(x: F32 at sample) -> F32 at sample {
  let a = x * 0.5
  @mem(bulk) let y = delay~(a, 4)   //~ E0020
  y
}

pub flow in_a_branch(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  let a = if~ c {
    @mem(bulk) let y = delay~(x, 4)   //~ E0020
    y
  } else {
    x
  }
  a
}

pub flow in_a_nested_block(x: F32 at sample) -> F32 at sample {
  let a = {
    @mem(bulk) let y = delay~(x, 4)   //~ E0020
    y
  }
  a
}

pub flow in_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<2 {
    @mem(bulk) let y = delay~(x, 4)   //~ E0020
    y
  }
  ys[0]
}

pub fn in_a_function(x: F32) -> F32 {
  @mem(bulk) let y = x   //~ E0020
  y
}

pub flow two_spaces(x: F32 at sample) -> F32 at sample {
  @mem(bulk) let y = delay~(x, 4)   //~ E0020
  y
}
