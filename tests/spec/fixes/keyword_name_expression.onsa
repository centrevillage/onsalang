// onsa.toml
// [test]
// spec = ["§2.2", "§2.3", "§18.1"]
// fixes = 1

// E0002 for a keyword written where an expression is, and none can start one there (`in`, `type`, `as`, `at`, `uses`;
// S-654, §2.3): after `let a: I32 =`, after an operator, as an argument, in an array, under a prefix `-` and as a condition.
// The candidate is the same `in_` (the name with a `_` at the end); the name is not declared, so the file that has it
// applied is left with the E0302 of the names stage (the stage after). One error in each unit.

pub fn id(a: I32) -> I32 {
  a
}

pub fn after_let(x: I32) -> I32 {
  let a: I32 = in + x                               //~ E0002
  a
}

pub fn after_operator(x: I32) -> I32 {
  x + type                                          //~ E0002
}

pub fn as_an_argument(x: I32) -> I32 {
  id(uses)                                          //~ E0002
}

pub fn in_an_array() -> I32 {
  let xs: [I32; 2] = [as, 1]                        //~ E0002
  xs[0]
}

pub fn under_a_minus(x: I32) -> I32 {
  -at + x                                           //~ E0002
}

pub fn as_a_condition(x: I32) -> I32 {
  if in { x } else { 0 }                            //~ E0002
}
