// onsa.toml
// [test]
// spec = ["§2.5", "§8.1", "§18.1"]
// fixes = 1

// E0003 for the `{` of an effect row `uses {…}` that is not on the line of the `uses` (spec §2.5, §8.1, S-413, S-216): the
// `{` of the row goes on the line of the `uses` before it. In a pair of brackets (the arguments of a function
// type, a tuple type, the body of a struct or an enum, a list of type arguments) a line break is a space and
// the `{Alloc}` after it could be read as the row all the same, but the rule of where a symbol stands is the
// same inside the brackets and outside them (S-370): the `{` is the main position, and the candidate moves the `{`
// and the rest of its line, up to the comment, to the end of the line of the `uses`, before the comment of that line.
// Outside the brackets the `uses` ends the line (tests/spec/negative/s413_uses_outside_brackets.onsa). One error in each
// declaration unit (P-01). The right forms are at the end of the file.

pub fn in_a_function_type_argument(f: fn(I32) -> I32 uses {Alloc}, x: I32) -> I32 uses {Alloc} {
                                                    //~ E0003
  f.(x)
}

pub fn in_the_second_argument(x: I32, f: fn(I32) -> I32 uses {Alloc}) -> I32 uses {Alloc} {
                                                    //~ E0003
  f.(x)
}

pub fn in_a_tuple_type(t: (fn(I32) -> I32 uses {Alloc}, I32)) -> I32 uses {Alloc} {
                                                    //~ E0003
  t.0.(t.1)
}

pub fn in_type_arguments(o: Option[fn(I32) -> I32 uses {Alloc}]) -> I32 uses {Alloc} {
                                                    //~ E0003
  match o {
    Some(f) => f.(1),
    None => 0,
  }
}

pub struct Holder {
  run: fn(I32) -> I32 uses {Alloc},
                                                    //~ E0003
}

pub enum Op {
  Nop,
  Run(fn(I32) -> I32 uses {Alloc}),
                                                    //~ E0003
}

pub fn with_a_comment_on_the_line(f: fn(I32) -> I32 uses {Alloc}) -> I32 uses {Alloc} { // the row
                                                    //~ E0003
  f.(1)
}

pub fn only_the_brace_is_moved(f: fn(I32) -> I32 uses {
                                                    //~ E0003
    Alloc
  }) -> I32 uses {Alloc} {
  f.(1)
}

// The right forms: the `{` on the line of the `uses`.
pub fn fine(f: fn(I32) -> I32 uses {Alloc}, x: I32) -> I32 uses {Alloc} {
  f.(x)
}

pub fn fine_with_a_tuple(t: (fn(I32) -> I32 uses {Alloc}, I32)) -> I32 uses {Alloc} {
  t.0.(t.1)
}

pub struct FineHolder {
  run: fn(I32) -> I32 uses {Alloc},
}
