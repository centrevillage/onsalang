// onsa.toml
// [test]
// spec = ["§7", "§3.1", "§18.1"]
// fixes = 1
// [[test.fix]]
// at = "24:5"
// code = "E0020"
// candidate = 1
// leaves = ["24:24 E0002"]
//
// [[test.fix]]
// at = "31:5"
// code = "E0020"
// candidate = 1
// leaves = ["31:25 E0002"]

// E0020 for a range pattern whose end is a `--3` (S-428, spec §7): the end reads as an expression, so the error is the range's and the
// candidate copies the end. The `--3` is left in the guard, and it is the E0002 of the decrement (a decrement whose operand is not a
// name has no candidate, tests/spec/negative/overlap_increment_range_pattern.onsa), so the second step has no candidate. The columns
// of `leaves` assume a name of one letter (NEW, S-253; see range_pattern_foreign_end_forms.onsa). One error per function (P-01).

pub fn decrement_half_open(x: I32) -> I32 {
  match x {
    v if 1 <= v && v < --3 => 1,                                   //~ E0020
    _ => 0,
  }
}

pub fn decrement_closed(x: I32) -> I32 {
  match x {
    v if 1 <= v && v <= --3 => 1,                                   //~ E0020
    _ => 0,
  }
}
