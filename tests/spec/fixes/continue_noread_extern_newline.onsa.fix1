// onsa.toml
// [test]
// spec = ["§18.1", "§14.1", "§2.5"]
// fixes = 1

// An `extern` head that can be read, with the `{` on the next line (W5-11 U4 must not change
// this): `extern "C" lib "m"` at the end of its line is a head whose `{` is on a line of its own,
// the E0003 whose candidate moves the `{` to the end of the line before (§2.5), as for every
// head. It is not the error of a head that cannot be read (S-477), and the members of the block
// are names of the module. (The block with the `{` on the next line and no `lib`: one E0002 that
// reads no further, continue_noread_line_break.onsa.)

extern "C" lib "m" {
//~ E0003
  fn c_abs(x: I32) -> I32
  type Raw
}

fn calls() -> I32 {
  c_abs(1)
}

fn takes(r: Raw) -> I32 {
  c_abs(2)
}

fn own_error() -> I32 {
  c_abs(1) + zz                                     //~ E0302 @14
}
