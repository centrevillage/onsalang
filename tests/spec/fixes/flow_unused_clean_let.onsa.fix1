// onsa.toml
// [test]
// spec = ["§5.1", "§11.2", "§18.1"]
// fixes = 1
//
// [[test.fix]]
// at = "17:7"
// code = "E0309"
// candidate = 1
// clean = true

// The candidate of the E0309 of a `let` of a flow body (spec 5.1; S-129): the name becomes `_`, which
// names nothing, so the `let _ = x * 2.0` is a root that the output does not need, and the file has no
// diagnostic after it (`clean`). One candidate in the file, as `clean` asks.

pub flow one_unused_let(x: F32 at sample) -> F32 at sample {
  let _ = x * 2.0 //~ E0309 @7
  x
}
