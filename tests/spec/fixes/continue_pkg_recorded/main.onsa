// onsa.toml
// [test]
// spec = ["§18.1", "§15.1", "§10"]
// fixes = 1

// The names of the module util whose heads have the modifiers written twice or in the wrong order
// (`pub pub`, `rt pub`; every one is one error in util.onsa, with a candidate) are names for the
// module that brings them in with `use`: the `use` and the places that use the names get no
// E0302 (§18.1, S-464), and no E0303, because the `pub` that was written is recorded. The `rt`
// that was written is recorded too: an `rt` function may call `swapped` (E0901 is for a call of
// a function that is not `rt`). What was read is checked here: a call with too many arguments, a
// field that is not there. A real error of this module is still reported.

use util.{twice_pub, swapped, Pt, twice_pub_rt}

pub fn run(p: Pt) -> I32 {
  twice_pub(p.x) + swapped(1) + twice_pub_rt(2)
}

pub rt fn calls_rt(x: I32) -> I32 {
  swapped(x) + twice_pub_rt(x)
}

fn nested(c: Bool, p: Pt) -> I32 {
  let f = fn(x: I32) -> I32 { twice_pub(x) + swapped(x) }
  if c { f.(p.x) } else { twice_pub(swapped(2)) }
}

fn too_many_arguments() -> I32 {
  swapped(1, 2)                                     //~ E0412
}

fn no_such_field(p: Pt) -> I32 {
  p.zz                                              //~ E0413
}

fn own_error() -> I32 {
  twice_pub(1) + zz                                 //~ E0302 @18
}
