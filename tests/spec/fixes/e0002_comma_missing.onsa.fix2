// onsa.toml
// [test]
// spec = ["§2.5", "§2.6", "§4.4", "§6.5", "§7", "§18.1"]
// fixes = 2

// E0002 for a missing `,` between two elements of a list, with the candidate that inserts it (§2.5, S-384,
// S-387, S-89, S-373, S-399). Inside parentheses, brackets, a struct literal, the body of a struct, an enum or
// a `match`, a line break is a space and the elements are separated by `,`. When an element is complete
// and the next token can start an element of that list, the error is `expected `,` or `)`` and the
// candidate inserts the `,` right after the last token of the previous element, before the comment of that
// line. It does not matter what stands between (a line break, spaces, a tab) or what the next element starts
// with (`!b` too). A `(` or `[` after a line break does not attach to the name before it, so it is the same
// error with two candidates, the comma and the line break removed (`h(h` and `(x))`; `[arr(a)` and `[0]]`); the
// type arguments `Option` and `[I32]` have the line break removed only, because `[I32]` cannot start a parameter; likewise after a
// token that is not a name path (`[arr(a) [0]]`: the comma and the space removed; `[(1, 2) (3, 4)]`: the comma
// only, because `(1, 2)(3, 4)` is not a call). The main position is the first token of
// the element after the gap (positions of W3-06), so the marker is on that token's line.
// One error per declaration unit (P-01): a list with two missing commas is outside the promise of S-236
// (e0002_comma_two_errors.onsa).

pub struct Pair[A, B] {
  a: A,
  b: B,
}

pub struct Pt {
  x: I32,
  y: I32,
}

pub fn h(x: I32) -> I32 {
  x
}

pub fn arr(x: I32) -> [I32; 2] {
  [x, x]
}

pub fn two(a: I32, b: I32) -> I32 {
  a + b
}

pub fn three(a: I32, b: I32, c: I32) -> I32 {
  a + b + c
}

pub fn pick(c: Bool, d: Bool, n: I32) -> I32 {
  if c && d { n } else { 0 }
}

pub rt fn two_u(a: U32, b: U32) -> U32 {
  a + b
}

pub fn call_args(a: I32, b: I32) -> I32 {
  two(a
    b)                                              //~ E0002
}

pub fn the_third_argument(a: I32, b: I32, c: I32) -> I32 {
  three(a, b
    c)                                              //~ E0002
}

pub fn nested_calls(a: I32, b: I32) -> I32 {
  two(two(a
    b), 1)                                          //~ E0002
}

pub fn a_comment_on_the_line(a: I32, b: I32) -> I32 {
  two(a // the first
    b)                                              //~ E0002
}

pub fn an_array() -> U32 {
  let v = [1, 2
    3]                                              //~ E0002
  v.len()
}

pub fn a_tuple(a: I32, b: I32, c: I32) -> I32 {
  let t = (a, b
    c)                                              //~ E0002
  t.0
}

pub fn type_arguments(p: Pair[I32
    I32]) -> I32 {                                  //~ E0002
  p.a
}

pub fn declared_parameters(a: I32
    b: I32) -> I32 {                                //~ E0002
  a + b
}

pub fn type_parameters[A
    B](a: A, b: B) -> A {                           //~ E0002
  a
}

pub fn closure_parameters(a: I32, b: I32) -> I32 {
  let f = fn(p: I32
    q: I32) -> I32 { p + q }                        //~ E0002
  f.(a, b)
}

pub fn a_tuple_pattern(p: (I32, I32)) -> I32 {
  match p {
    (a
      b) => a,                                      //~ E0002
  }
}

pub flow attribute_arguments(
  x: F32 at sample,
  @param(min: 0.0
    max: 1.0, default: 0.5)                         //~ E0002
  level: F32 at block,
) -> F32 at sample {
  x * level
}

pub fn a_struct_literal() -> Pt {
  Pt { x: 1
    y: 2 }                                          //~ E0002
}

pub struct Fields {
  x: I32
  y: I32,                                           //~ E0002
}

pub enum Kind {
  Circle(F32)
  Rect(F32, F32),                                   //~ E0002
}

pub fn arms_with_a_block(o: Option[I32]) -> I32 {
  match o {
    Some(x) => { x }
    None => { 0 },                                  //~ E0002
  }
}

pub fn arms_with_a_value(o: Option[I32]) -> I32 {
  match o {
    Some(x) => x
    None => 0,                                      //~ E0002
  }
}

pub fn in_an_arm_body(o: Option[I32]) -> I32 {
  match o {
    Some(v) => two(v
      v),                                           //~ E0002
    None => 0,
  }
}

pub fn in_a_closure_body(a: I32) -> I32 {
  let f = fn(x: I32) -> I32 { two(x
    x) }                                            //~ E0002
  f.(a)
}

pub flow in_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par i in 0..<4 {
    two_u(i
      i)                                            //~ E0002
  }
  x
}

pub fn a_prefix_not_starts_the_element(a: Bool, b: Bool) -> I32 {
  pick(a
    !b, 1)                                          //~ E0002
}

pub fn a_space(a: I32, b: I32) -> I32 {
  two(a b)                                          //~ E0002
}

pub fn a_wide_space(a: I32, b: I32) -> I32 {
  two(a     b)                                      //~ E0002
}

pub fn a_tab(a: I32, b: I32) -> I32 {
  two(a	b)                                          //~ E0002
}

pub fn an_array_of_floats() -> F32 {
  let v = [0.1 0.2, 0.3]                            //~ E0002
  v[0]
}

pub fn a_struct_literal_on_a_line() -> Pt {
  Pt { x: 1 y: 2 }                                  //~ E0002
}

pub fn arms_on_a_line(o: Option[I32]) -> I32 {
  match o { Some(x) => { x } None => { 0 } }        //~ E0002
}

pub fn a_call_after_a_line_break(x: I32) -> I32 {
  h(h(x))                                           //~ E0002
}

pub fn an_index_after_a_line_break(xs: [I32; 4]) -> I32 {
  two(xs[0], 1)                                     //~ E0002
}

pub fn an_index_in_an_array(xs: [I32; 4]) -> I32 {
  let v = [xs[0]]                                   //~ E0002
  v[0]
}

pub fn an_index_after_a_call(a: I32) -> I32 {
  let v = [arr(a)[0]]                               //~ E0002
  v[0]
}

pub fn a_tuple_after_a_tuple_over_two_lines() -> I32 {
  let v = [(1, 2)
    (3, 4)]                                         //~ E0002
  v[0].0
}

pub fn type_arguments_after_a_line_break(o: Option
    [I32]) -> I32 {                                 //~ E0002
  0
}

pub fn a_tuple_after_a_tuple() -> I32 {
  let v = [(1, 2) (3, 4)]                           //~ E0002
  v[0].0
}

pub fn a_group_after_a_call(a: I32) -> I32 {
  two(arr(a)[0] (a), 1)                             //~ E0002
}

pub fn an_array_after_a_call(a: I32) -> I32 {
  let v = [arr(a)[0]]                               //~ E0002
  v[0][0]
}

pub fn an_array_after_an_array() -> I32 {
  let v = [[1, 2] [3, 4]]                           //~ E0002
  v[0][0]
}

pub fn fine(a: I32, b: I32) -> I32 {
  let v = [arr(a)[0], (a, b).0]
  two(a,
    b) + three(a, b, v[0])
}
