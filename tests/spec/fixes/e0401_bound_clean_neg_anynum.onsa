// E0401 for `-x` where `T: AnyNum` (§6.3: the negation is `Num`, so `T: AnyNum` becomes `T: Num`). The one candidate
// replaces the bound in the signature, and the file has no diagnostic after it.

pub fn negate[T: AnyNum](x: T) -> T {
  -x                                                //~ E0401
}
