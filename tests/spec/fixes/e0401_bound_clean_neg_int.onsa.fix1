// E0401 for `-x` where `T: Int` (§6.3: `Int` is not `Num`, so the bound is joined: `T: Int + Num`, the signed integers).
// The one candidate keeps `Int` and adds `Num`; no diagnostic is left after it.

pub fn negate[T: Int + Num](x: T) -> T {
  -x                                                //~ E0401
}
