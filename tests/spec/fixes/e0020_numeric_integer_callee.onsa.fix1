// onsa.toml
// [test]
// spec = ["§2.4", "§6.1", "§2.5", "§18.1"]
// fixes = 1

// E0020 for a call whose callee is an integer literal, and for the space in the `.(` of a literal that is
// called as a value (spec §2.4, §6.1, §2.5, §18.1; S-350). After the digits of an integer, a `.` followed by a
// name or `(` is the member's `.` (`1.abs()`, `1.(x)`), so `1.(x)` calls the integer 1 as a function value:
// the syntax accepts it and the type stage rejects it (the error of the type stage is not written here:
// whether it is E0420 or E0401 is for W4 / W5). The three forms of this file are the ones whose candidate the
// syntax stage can now make, and that W3-20 left without one because `1.(x)` read as the float `1.` and `(x)`:
// - the callee is the integer (`5(x)`, `0x1F(x)`, `0b11(x)`, `1_000(x)`): the candidate inserts the `.`
//   (`5.(x)`), as for the callee of every other literal (fixes/e0020_callee_literal_number.onsa);
// - a space before the `.` or around it (`1 .(x)`, `1 . (x)`, `0x1F .(x)`): the candidate removes the spaces
//   (`1.(x)`; §2.5, the row `space_around_dot`);
// - a suffix before the `.` (`1i32.(x)`, `0x1Fu8.(x)`): the candidate removes the suffix and the `_` in front
//   of it (`1.(x)`; the row `literal_suffix`).
// A hexadecimal or a binary number has no point, so `0x1F.(x)` is the member's `.` and there is no float to
// read. The candidate leaves no error of the syntax stage (the promise of §18.1); what is left after it
// is the error of the type stage. The main position is the first character of the literal. One error per
// declaration (P-01).

fn id(x: I32) -> I32 {
  x
}

pub fn integer_callee(x: I32, y: I32) -> I32 {
  let a = 5.(x)                                     //~ E0020
  a
}

pub fn integer_callee_with_two_arguments(x: I32, y: I32) -> I32 {
  let a = 5.(x, y)                                  //~ E0020
  a
}

pub fn integer_callee_with_no_arguments(x: I32, y: I32) -> I32 {
  let a = 5.()                                      //~ E0020
  a
}

pub fn zero_callee(x: I32, y: I32) -> I32 {
  let a = 0.(x)                                     //~ E0020
  a
}

pub fn hexadecimal_callee(x: I32, y: I32) -> I32 {
  let a = 0x1F.(x)                                  //~ E0020
  a
}

pub fn binary_callee(x: I32, y: I32) -> I32 {
  let a = 0b11.(x)                                  //~ E0020
  a
}

pub fn separated_callee(x: I32, y: I32) -> I32 {
  let a = 1_000.(x)                                 //~ E0020
  a
}

pub fn capital_prefix_callee(x: I32, y: I32) -> I32 {
  let a = 0XFF.(x)                                  //~ E0020
  a
}

pub fn space_before_the_dot(x: I32, y: I32) -> I32 {
  let a = 1.(x)                                     //~ E0020
  a
}

pub fn space_before_the_dot_of_zero(x: I32, y: I32) -> I32 {
  let a = 0.(x)                                     //~ E0020
  a
}

pub fn spaces_around_the_dot(x: I32, y: I32) -> I32 {
  let a = 1.(x)                                     //~ E0020
  a
}

pub fn space_before_the_dot_of_a_hexadecimal(x: I32, y: I32) -> I32 {
  let a = 0x1F.(x)                                  //~ E0020
  a
}

pub fn suffix_before_the_dot(x: I32, y: I32) -> I32 {
  let a = 1.(x)                                     //~ E0020
  a
}

pub fn suffix_with_an_underscore_before_the_dot(x: I32, y: I32) -> I32 {
  let a = 1.(x)                                     //~ E0020
  a
}

pub fn suffix_after_a_hexadecimal_before_the_dot(x: I32, y: I32) -> I32 {
  let a = 0x1F.(x)                                  //~ E0020
  a
}

pub fn c_suffix_before_the_dot(x: I32, y: I32) -> I32 {
  let a = 1.(x)                                     //~ E0020
  a
}

pub fn integer_callee_in_an_argument(x: I32) -> I32 {
  id(5.(x))                                         //~ E0020
}

pub fn integer_callee_as_an_operand(x: I32) -> I32 {
  1 + 5.(x)                                         //~ E0020
}

pub fn integer_callee_as_the_tail(x: I32) -> I32 {
  5.(x)                                             //~ E0020
}

pub fn integer_callee_in_an_arm(o: Option[I32], x: I32) -> I32 {
  match o {
    Some(_) => 5.(x),                               //~ E0020
    None => 0,
  }
}

pub fn integer_callee_in_a_branch(flag: Bool, x: I32) -> I32 {
  if flag { 1 } else { 5.(x) }                      //~ E0020
}

pub fn integer_callee_in_a_closure_body(x: I32) -> I32 {
  let f = fn(y: I32) -> I32 { 5.(x) }               //~ E0020
  f.(1)
}

pub fn integer_callee_in_a_block_in_a_block(x: I32) -> I32 {
  let r: I32 = {
    let s: I32 = {
      5.(x)                                         //~ E0020
    }
    s
  }
  r
}

pub fn integer_callee_in_a_generic_function[T](x: T) -> T {
  let a = 5.(x)                                     //~ E0020
  x
}

pub fn integer_callee_in_an_array(x: I32) -> [I32; 2] {
  [1, 5.(x)]                                        //~ E0020
}

pub fn spaced_callee_in_an_argument(x: I32) -> I32 {
  id(1.(x))                                         //~ E0020
}

pub fn spaced_callee_in_a_closure_body(x: I32) -> I32 {
  let f = fn(y: I32) -> I32 { 1.(x) }               //~ E0020
  f.(1)
}

pub fn suffixed_callee_in_an_argument(x: I32) -> I32 {
  id(1.(x))                                         //~ E0020
}

pub fn suffixed_callee_in_an_arm(o: Option[I32], x: I32) -> I32 {
  match o {
    Some(_) => 1.(x),                               //~ E0020
    None => 0,
  }
}

pub flow integer_callee_in_a_flow(x: F32 at sample) -> F32 at sample {
  let a = 5.(x)                                     //~ E0020
  x
}

// The right forms of a call through a function value, and numbers followed by a member's `.`.
pub fn fine(f: fn(I32) -> I32, t: (fn(I32) -> I32, I32), x: I32) -> I32 {
  let a = f.(x)
  let b = t.0.(t.1)
  let c = id(x)
  a + b + c
}
