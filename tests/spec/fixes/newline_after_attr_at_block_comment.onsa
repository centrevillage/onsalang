// onsa.toml
// [test]
// spec = ["§2.1", "§2.5", "§6.5", "§18.1"]
// fixes = 1
//
// [[test.fix]]
// at = "21:3"
// code = "E0020"
// candidate = 1
// leaves = ["20:1 E0020"]

// S-957 (W5-11 U10d2/t2, §2.1, §2.5, §6.5): a block comment between the `@` of an attribute and its name, on the line of the
// name, is the E0020 of the block comment (§2.1) first (S-957: "the block comment's own E0020 is first"), and the line
// break after the `@` is not reported with it: one unit reports one error (P-01). Its one candidate writes a line comment
// (`// c`) and keeps the tokens and the line breaks, so the break after the `@` is still there after it and is the error of
// the next round (`leaves`: the E0020 of the `@`, at the place it stood). The main position is the start of the block
// comment. Before S-957 the `@` was reported there (E0002, "expected attribute name, found newline"). A file with one
// unit, so that the candidate is the one of the comment.

@
  /* c */ fp(relaxed)   //~ E0020 @3
pub fn f(x: F32) -> F32 {
  x
}
