// onsa.toml
// [test]
// spec = ["§18.1", "§14.1"]
// fixes = 1

// E0020 for `#[link(name = "…")]` with other names and spellings (S-601, row `link_attribute`): the candidate carries the
// string of the attribute into `lib "…"`, whatever the spaces around the `=` are, and the next blocks are read on. One error
// in each unit.

#[link(name = "fastconv")]                          //~ E0020
extern "C" {
  fn fast_a(x: I32) -> I32
}

#[link(name="z")]                                   //~ E0020
extern {
  fn fast_b(x: I32) -> I32
}

pub struct Holder {
  x: I32,
}

#[link(name = "ssl")]                               //~ E0020
extern "C" {
  fn fast_c(x: I32) -> I32
  type RawC
}

fn calls() -> I32 {
  fast_a(1) + fast_b(2) + fast_c(3)
}

fn takes(r: RawC) -> I32 {
  fast_c(4)
}
