// onsa.toml
// [test]
// spec = ["§3.3", "§18.1"]
// fixes = 2

// E0411: `as` for a pair it cannot write. A reading with one meaning has the conversion function of the
// target type as the candidate, replacing the whole `as` expression (integer to float and `F64` to `F32`:
// `F32.round_from(i)`). Float to integer reads differently in other languages, so both are listed,
// `I32.trunc_sat_from(f)` first and `I32.trunc_from(f)` second. An integer narrowing has no candidate (§3.3).

pub fn to_float(i: I32) -> F32 {
  i as F32                                          //~ E0411
}

pub fn double_to_single(d: F64) -> F32 {
  d as F32                                          //~ E0411
}

pub fn long_to_double(n: I64) -> F64 {
  n as F64                                          //~ E0411
}

pub fn float_to_int(f: F32) -> I32 {
  I32.trunc_from(f)                                          //~ E0411
}

pub fn narrowing(n: I64) -> I32 {
  n as I32                                          //~ E0411
}

pub fn fine(i: I16, f: F32) -> F64 {
  (i as F32) as F64
}
