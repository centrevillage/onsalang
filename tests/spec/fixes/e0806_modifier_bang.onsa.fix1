// onsa.toml
// [test]
// spec = ["§2.6", "§11.2", "§11.10", "§18.1"]
// fixes = 1

// W7-09 U3a/t, S-811, S-555, S-556: a modifier of the closed list called with `!` after the call of an instance (a user flow, a
// built-in delay, a chain of modifiers) is E0806 in a flow body (§11.2: "`!` の呼び出しの E0806 は、呼び先が flow か組込みの遅延なら `!` を `~` に置き換える
// 修正候補"), and the one candidate replaces the `!` with `~`. The flow stage reads the modifier it makes
// (the E0200 of `reset_if~` until W7-10 U2 and of a built-in delay receiver until U3, the meaning of `when~`, and the chain clock for `down~` and `up~`) after the names stage, so the
// program after the candidate may have an error of a later stage (§18.1). The receivers that are values and the names that the
// list has not have no candidate (negative/e0806_modifier_bang_no_candidate.onsa). One error per flow (P-01).

pub flow lp(x: F32 at sample) -> F32 at sample {
  x * 0.5 + prev~(x) * 0.5
}

pub flow when_on_an_instance(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  lp~(x).when~(c)                                   //~ E0806
}

pub flow reset_if_on_an_instance(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  lp~(x).reset_if~(c)                               //~ E0806
}

pub flow down_on_an_instance(p: F32 at block) -> F32 at sample {
  lp~(p).down~(4) at sample                         //~ E0806
}

pub flow when_on_a_builtin_delay(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  prev~(x).when~(c)                                 //~ E0806
}

pub flow down_after_a_modifier(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  lp~(x).when~(c).down~(2) at sample                //~ E0806
}
