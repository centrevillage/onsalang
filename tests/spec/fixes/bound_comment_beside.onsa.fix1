// onsa.toml
// [test]
// spec = ["§4.5", "§18.1"]
// fixes = 1

// R-384 (W5-11 U10d2, §4.5, §18.1): a comment next to the implicit element of a list that has other elements. The candidate
// takes the element out with the `+` next to it, and the comment may go with the tokens it lies between (§18.1), so the
// list reads after it. These are the places for the comment that the pinned binary already handles (after the `:` and
// before an element that has another one beside it, after the `+`, between the element and the `+`); the list that has
// the element alone is in bound_comment_alone.onsa. The main position is the start of the element. One error per
// declaration unit (P-01).

pub fn after_the_colon_first[T: // c
  Show](x: T) -> U32 {   //~ E0020
  0
}

pub fn after_the_colon_last[T: // c
  Show](x: T) -> U32 {   //~ E0020
  0
}

pub fn after_a_plus[T: Show](x: T) -> U32 {   //~ E0020
  0
}

pub fn before_a_plus[T: Show](x: T) -> U32 {
  0
}

pub fn escape_after_a_plus[T: Show](x: T) -> U32 {   //~ E0020
  0
}

pub fn fine[T: // c
  Show](x: T) -> U32 {
  0
}
