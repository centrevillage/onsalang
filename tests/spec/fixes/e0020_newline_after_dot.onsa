// onsa.toml
// [test]
// spec = ["§2.5", "§6.1", "§18.1"]
// fixes = 1

// E0020 for a line break after the member `.` (§2.5, S-353): the `.` of a field, a method, a tuple index
// or a call of a function value (`.(`) is not the last token of a line, inside parentheses or outside them.
// A method chain continues by a `.` at the start of the next line, so the candidate moves the `.` to the
// head of the next line (before the name, the tuple index or the `(`); the comment lines and blank lines
// between stay where they are. A space before the `.` too (`s .` and a line break) is one error of the
// placement with the same one candidate. Without the candidate a `let a = s.` would join the next line's
// statement silently. The main position of the error is the `.` token (positions of W3-06), so the marker is
// on the line of the `.` the candidate moves. The tuple index in an
// argument (`two(t.` and `0, 1)`) is the S-353 case carried over from W3-20/b. One error per declaration unit
// (P-01).

pub struct Sf {
  f: I32,
}

pub struct Pt {
  x: I32,
  y: I32,
}

pub struct Line {
  a: Pt,
  b: Pt,
}

impl Pt {
  pub fn scale(self, k: I32) -> I32 {
    self.x * k
  }
}

pub fn two(a: I32, b: I32) -> I32 {
  a + b
}

pub fn in_an_argument(s: Sf) -> I32 {
  two(s.                                            //~ E0020
    f, 1)
}

pub fn a_tuple_index(t: (I32, I32)) -> I32 {
  two(t.                                            //~ E0020
    0, 1)
}

pub fn a_value_call(g: fn(I32) -> I32) -> I32 {
  two(g.                                            //~ E0020
    (1), 2)
}

pub fn a_chain(l: Line) -> I32 {
  two(l.a.                                          //~ E0020
    x, 1)
}

pub fn a_method_call(p: Pt) -> I32 {
  two(p.                                            //~ E0020
    scale(2), 1)
}

pub fn in_an_array(p: Pt) -> I32 {
  let v = [p.                                       //~ E0020
    x, 1]
  v[0]
}

pub fn in_an_arm(o: Option[Pt]) -> I32 {
  match o {
    Some(q) => q.                                   //~ E0020
      x,
    None => 0,
  }
}

pub fn in_a_closure_body(p: Pt) -> I32 {
  let f = fn(q: Pt) -> I32 { q.                     //~ E0020
    x }
  f.(p)
}

pub flow in_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par i in 0..<4 {
    [x].                                            //~ E0020
      len()
  }
  x
}

pub fn in_a_let(s: Sf) -> I32 {
  let a = s.                                        //~ E0020
    f
  a
}

pub fn at_the_start_of_a_line(s: Sf) -> I32 {
  s.                                                //~ E0020
  f
}

pub fn a_value_call_in_a_let(g: fn(I32) -> I32) -> I32 {
  let a = g.                                        //~ E0020
    (1)
  a
}

pub fn a_space_before_the_dot(s: Sf) -> I32 {
  let a = s .                                       //~ E0020
    f
  a
}

pub fn a_space_before_the_dot_in_parentheses(s: Sf) -> I32 {
  two(s .                                           //~ E0020
    f, 1)
}

pub fn a_comment_line_between(s: Sf) -> I32 {
  let a = s.                                        //~ E0020
    // the field
    f
  a
}

pub fn a_blank_line_between(s: Sf) -> I32 {
  let a = s.                                        //~ E0020

    f
  a
}

pub fn a_comment_line_between_in_parentheses(s: Sf) -> I32 {
  two(s.                                            //~ E0020
    // the field
    f, 1)
}

pub fn fine(s: Sf, l: Line, t: (I32, I32), g: fn(I32) -> I32, p: Pt) -> I32 {
  let a = s
    .f
  let b = two(l.a
    .x, t
    .0)
  two(a + b, g
    .(1)) + p
    .scale(2)
}
