// onsa.toml
// [test]
// spec = ["§2.5", "§3.1", "§7", "§11.5", "§18.1"]
// fixes = 1

// E0020: an operator that is used only as a binary operator, at the start of a line, in the heads and the
// statements that tests/spec/fixes/e0020_leading_operator.onsa does not have (spec §2.5, S-124, S-370; docs/
// foreign-forms.toml row `leading_operator`): the head of a `match`, of an `if~` and a `match~`, the heads
// of a `for` and a `par` with an operator that is no range symbol, the operand of an `assert`, a `return`
// and a `const`, an `if` that is the value of a `let`, and the argument of a handler. A line ends where it ends,
// so the line that starts with the operator is a new statement that has no reading; the writer's
// reading is the line before it going on, and the candidate moves the operator to the end of the line
// before it. The main position is the operator, so the marker is on its line. The range symbols at the start
// of a line are in tests/spec/fixes/e0020_leading_range.onsa. One error in each declaration unit.

pub fn two(x: I32, y: I32) -> I32 {
  x - y
}

pub fn match_head(a: I32, b: I32) -> I32 {
  match a
  + b {                                             //~ E0020
    _ => 1,
  }
}

pub fn match_head_with_a_comparison(a: I32, b: I32) -> I32 {
  match a
  == b {                                            //~ E0020
    true => 1,
    false => 0,
  }
}

pub fn match_head_as_a_value(a: I32, b: I32) -> I32 {
  let r = match a
    * b {                                           //~ E0020
    _ => 1,
  }
  r
}

pub fn if_as_the_value_of_a_let(a: Bool, b: Bool) -> I32 {
  let r = if a
    && b { 1 } else { 2 }                           //~ E0020
  r
}

pub fn if_with_a_comment_line(a: Bool, b: Bool) -> I32 {
  if a // the condition
  // goes on
  || b {                                            //~ E0020
    1
  } else {
    2
  }
}

pub flow if_tilde_head(c: Bool at block, x: F32 at sample) -> F32 at sample {
  if~ c
  && c {                                            //~ E0020
    x
  } else {
    x
  }
}

pub flow match_tilde_head(c: Bool at block, x: F32 at sample) -> F32 at sample {
  match~ c
  || c {                                            //~ E0020
    true => x,
    false => x,
  }
}

pub fn for_head_start(n: U32) -> U32 {
  var t: U32 = 0
  for i in 0
    + 1..<n {                                       //~ E0020
    t = t + i
  }
  t
}

pub fn for_head_end(n: U32) -> U32 {
  var t: U32 = 0
  for i in 0..<n
    + 1 {                                           //~ E0020
    t = t + i
  }
  t
}

pub flow par_head_end(x: F32 at sample) -> [F32; 4] at sample {
  par i in 0..<4
    + 0 {                                           //~ E0020
    x
  }
}

test "assert goes on" {
  assert 1 == 1
  && 2 == 2                                         //~ E0020
}

pub fn return_goes_on(a: I32, b: I32) -> I32 {
  return a
  + b                                               //~ E0020
}

const LIMIT: U32 = 1
  + 2                                               //~ E0020

pub fn handler_argument(x: I32) -> I32 {
  handle {
    x
  } with h(x
    + 1)                                            //~ E0020
}

pub fn second_condition_of_an_else_if(a: Bool, b: Bool, c: Bool) -> I32 {
  if a {
    1
  } else if b
  && c {                                            //~ E0020
    2
  } else {
    3
  }
}

// The right forms: the operator at the end of the line, and a method call that starts a line.
pub fn fine(a: I32, b: I32, xs: [U32; 4]) -> I32 {
  let r = match a +
    b {
    _ => 1,
  }
  var t: U32 = 0
  for i in 0 +
    1..<xs
    .len() {
    t = t + i
  }
  if a == b &&
    r > 0 {
    return r
  }
  two(r, 1)
}
