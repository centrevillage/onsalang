// onsa.toml
// [test]
// spec = ["§7", "§18.1"]
// fixes = 2

// S-876 (U4a of W5-09): both candidates of the E0503 of an arm are made when reading the body again with each of them applied leaves no error of the stage of the types (§7, §18.1). The deletion and the move are both made even when
// the arm that is left out decides the type of a variable or of the result of the `match` (the other arms or a later statement decide it again), and when the deletion leaves only a diagnostic of a later stage: the variable that only the unreachable
// arm read is not used any more (E0309, which comes after the types: S-292). The text after the candidates is not written here. One error per function (P-01).

pub fn id(n: I32) -> I32 {
  n
}

pub fn need_u8(x: U8) {
}

pub fn result_of_the_match_is_a_variable(n: I32) -> I32 {
  let q = match n {
    
    1 => id(3),
    _ => 0,                                     //~ E0503
  }
  q + 1
}

pub fn float_result_decided_by_a_later_statement(n: I32) -> F64 {
  let q = match n {
    
    1 => 1.5,
    _ => 0.5,                                       //~ E0503
  }
  q
}

pub fn only_the_unreachable_arm_reads_the_variable(m: I32) -> I32 {
  let n = 5
  match m {
    
    1 => {                                          //~ E0503
      need_u8(n)
    },
    _ => { },
  }
  0
}

pub fn only_the_unreachable_arm_reads_a_var(m: I32) -> I32 {
  var n = 5
  match m {
    
    1 => {                                          //~ E0503
      n = 6
      need_u8(n)
    },
    _ => { },
  }
  0
}

pub fn the_variable_is_decided_again_after_the_match(m: I32) -> F64 {
  let n = 5
  match m {
    
    1 => {                                          //~ E0503
      need_u8(n)
    },
    _ => { },
  }
  need_u8(n)
  n as F64
}

pub fn the_variable_is_decided_by_the_first_arm(m: I32) -> F64 {
  let n = 5
  match m {
    0 => { need_u8(n) },
    
    1 => {                                          //~ E0503
      need_u8(n)
    },
    _ => { },
  }
  n as F64
}

pub fn binding_as_the_covering_arm(m: I32) -> I32 {
  let q = match m {
    
    1 => id(3),
    k => id(k),                                     //~ E0503
  }
  q
}

pub fn statement_that_assigns_a_var(m: I32) -> I32 {
  var r = 0
  match m {
    
    1 => { r = id(2) },
    _ => { r = 1 },                             //~ E0503
  }
  r + 1
}
