// onsa.toml
// [test]
// spec = ["§4.5", "§18.1"]
// fixes = 2

// The number of the candidates of the E0020 of a `[…]` with a `,` after a name, in a constant
// expression of a type (§4.5, §18.1): two, as in an expression. The elements of each list read as
// types or as constant expressions (`F32`, `4`, `1`, `2`), so they can be the type arguments
// (`Rg::[F32, 4].CAP`) or the indexes of a multi-dimensional index (`Rg[F32][4].CAP`), and the
// candidate of each reading is given (§18.1). The one-candidate lists are in
// e0020_type_args_square_in_types_one_candidate.onsa.

pub struct Rg[T, const N: U32] {
  d: [T; N],
}

impl[T, const N: U32] Rg[T, N] {
  pub const CAP: U32 = 4
}

pub struct Ring[T, const N: U32] {
  d: [T; N],
}

pub const TABLE: U32 = 8

pub fn in_an_array_length(a: [F32; Rg::[F32, 4].CAP]) -> U32 { //~ E0020
  1
}

pub fn in_a_const_argument(r: Ring[F32, Rg::[F32, 4].CAP]) -> U32 { //~ E0020
  1
}

pub fn of_a_constant(a: [F32; TABLE::[1, 2]]) -> U32 { //~ E0020
  1
}

pub struct InAField {
  a: [F32; Rg::[F32, 4].CAP],                         //~ E0020
}

type InAnAlias = [F32; Rg::[F32, 4].CAP]              //~ E0020

pub fn in_an_annotation() -> U32 {
  let a: [F32; TABLE::[1, 2]] = [0.0; 4]              //~ E0020
  1
}
