// onsa.toml
// [test]
// spec = ["§2.5", "§2.6", "§11.2", "§18.1"]
// fixes = 1

// E0020 for a line break between a prefix `-` / `!` / `^` and its operand, and before a postfix `?`
// (§2.5, S-369). These marks are written on the line of what they belong to, inside parentheses and
// outside them; a prefix at the end of a line is not a continuation (a line ends in a binary operator,
// not in a prefix). The candidate moves the mark to the operand's line: the prefix to the head of the next
// line (`two(` and `-a, 1)`), the `?` to the end of the operand's line (`o?` and `, 1)`). The main position
// of the error is the token of the mark that the candidate moves (S-369, positions of W3-06), so the marker
// is on its line. The `^` of a delay (`prev~(^` and `y)`) is the carried
// over case of the decision. One error per declaration unit (P-01).

pub fn two(a: I32, b: I32) -> I32 {
  a + b
}

pub fn pick(c: Bool, n: I32) -> I32 {
  if c { n } else { 0 }
}

pub flow lp(x: F32 at sample) -> F32 at sample {
  let y = 0.5 * x + 0.5 * prev~(^y)
  y
}

pub fn a_minus_in_an_argument(a: I32) -> I32 {
  two(                                              //~ E0020
    -a, 1)
}

pub fn a_minus_before_a_group(a: I32, b: I32) -> I32 {
  two(                                              //~ E0020
    -(a + b), 1)
}

pub fn a_not_in_an_argument(c: Bool) -> I32 {
  pick(                                             //~ E0020
    !c, 1)
}

pub flow a_caret_in_a_delay(x: F32 at sample) -> F32 at sample {
  let y = x + prev~(                                //~ E0020
    ^y)
  y
}

pub flow a_caret_in_a_delay_line(x: F32 at sample) -> F32 at sample {
  let y = x + delay~(                               //~ E0020
    ^y, 4)
  y
}

pub fn a_minus_in_an_array(a: I32) -> I32 {
  let v = [                                         //~ E0020
    -a, 1]
  v[0]
}

pub fn a_minus_in_an_arm(o: Option[I32]) -> I32 {
  match o {
    Some(p) => two(                                 //~ E0020
      -p, 1),
    None => 0,
  }
}

pub fn a_minus_in_a_closure_body(a: I32) -> I32 {
  let f = fn(x: I32) -> I32 { two(                  //~ E0020
    -x, 1) }
  f.(a)
}

pub fn a_comment_line_between(a: I32) -> I32 {
  two(                                              //~ E0020
    // the operand
    -a, 1)
}

pub fn a_minus_in_a_let(a: I32) -> I32 {
  let y =                                           //~ E0020
    -a
  y
}

pub fn a_not_in_a_let(done: Bool) -> Bool {
  let y =                                           //~ E0020
    !done
  y
}

pub fn a_question_in_an_argument(o: Option[I32]) -> Option[I32] {
  Some(two(o?
    , 1))                                           //~ E0020
}

pub fn a_question_in_a_tuple(o: Option[I32]) -> Option[(I32, I32)] {
  let t = (o?
    , 1)                                            //~ E0020
  Some(t)
}

pub fn a_question_in_a_let(o: Option[I32]) -> Option[I32] {
  let v = o?
                                                    //~ E0020
  Some(v)
}

pub fn fine(a: I32, b: I32, o: Option[I32]) -> Option[I32] {
  let c = two(a,
    -b)
  let d = two(-a,
    b)
  let v = o?
  Some(c + d + v)
}
