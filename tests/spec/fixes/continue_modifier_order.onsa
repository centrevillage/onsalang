// onsa.toml
// [test]
// spec = ["§18.1", "§10", "§14.1", "§15.1"]
// fixes = 1

// The modifiers at the head of an item, `pub` or `priv` and then `rt`, written twice or in the
// wrong order (`pub pub fn`, `rt rt fn`, `rt pub fn`): one E0002 (§18.1, S-464) whose candidate
// is the right order with the repeats removed (`pub fn`, `rt fn`, `pub rt fn`). The modifiers
// that were written are recorded and the head is read on, so the item is a name of the module and
// is what was written: an `rt` stays an `rt` (an `rt` function that calls it gets no E0901, which
// is for a call of a function that is not `rt`), and the callers are checked against the head.
// The unit has a syntax error, so its body is not checked. One error in each unit.

pub pub fn twice_pub(a: I32) -> I32 {               //~ E0002
  a
}

rt rt fn twice_rt(x: I32) -> I32 {                  //~ E0002
  x
}

rt pub fn swapped(x: I32) -> I32 {                  //~ E0002
  x + 1
}

rt pub fn body_not_checked() -> I32 {               //~ E0002
  zz
}

pub struct Pt {
  x: I32,
}

impl Pt {
  pub pub fn get(self) -> I32 {                     //~ E0002
    self.x
  }

  rt pub fn get_rt(self) -> I32 {                   //~ E0002
    self.x
  }
}

// A function of the module that is `rt` may call what was written `rt`.
pub rt fn calls_rt(x: I32, p: Pt) -> I32 {
  twice_rt(x) + swapped(x) + body_not_checked() + p.get_rt()
}

rt fn calls_from_rt(x: I32) -> I32 {
  swapped(twice_rt(x))
}

fn calls(p: Pt) -> I32 {
  twice_pub(1) + twice_rt(2) + swapped(3) + p.get() + p.get_rt() + body_not_checked()
}

fn nested(c: Bool) -> I32 {
  let f = fn(x: I32) -> I32 { twice_pub(x) + swapped(x) }
  if c { f.(1) } else { twice_pub(swapped(2)) }
}

// The head is the declaration that was read: a real error of a use is reported.
fn too_many_arguments() -> I32 {
  swapped(1, 2)                                     //~ E0412
}

fn wrong_argument_type() -> I32 {
  twice_pub(true)                                   //~ E0401
}

fn own_error() -> I32 {
  swapped(1) + zz                                   //~ E0302 @16
}
