  // the block                                          //~ E0003
    1
  } else {
    2
  }
}

pub fn brace_with_a_comment_line_between(x: I32) -> I32 {  // the head
// a comment line
//~ E0003
  x
}

pub fn with_and_comments() -> I32 {
