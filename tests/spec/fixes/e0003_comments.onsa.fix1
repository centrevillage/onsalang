// onsa.toml
// [test]
// spec = ["§2.5", "§18.1"]
// fixes = 1

// What the candidate of an E0003 does with the comments (spec §2.5, S-216, R-160). The candidate moves the
// misplaced token and the rest of its line up to its comment, to the end of the line before it, and it
// puts the text before the comment that is at the end of that line; the comment of the moved line stays
// on the line where it was written, and the lines that hold a comment only and the blank lines between
// stay as they are (the marker comment of each line is such a comment too). A comment is never carried
// into the code, and the code is never carried into a comment: that is what the promise of §18.1 asks
// (the reading of the text outside the edit does not change).

pub fn comment_after_the_brace(c: Bool) -> I32 {
  if c {
    1
  } else {  // positive
  //~ E0003
    2
  }
}

pub fn comment_on_both_lines(c: Bool) -> I32 {
  if c {
    1
  } else {  // positive
  // negative                                   //~ E0003
    2
  }
}

pub fn comment_line_between(c: Bool) -> I32 {
  if c {
    1
  } else {
  // the negative case
  //~ E0003
    2
  }
}

pub fn blank_and_comment_lines_between(c: Bool) -> I32 {
  if c {
    1
  } else {  // positive

  // the negative case

  //~ E0003
    2
  }
}

pub fn the_rest_of_the_line_goes_too(c: Bool) -> I32 {
  if c {
    1
  } else { 2 }  // positive
  // negative                                //~ E0003
}

pub fn brace_with_comments(c: Bool) -> I32 {
