// E0401 for `a ^ b` where `T: Num` (§6.3: `Num` is not `Int`, so the bound is joined: `T: Num + Int`). The one
// candidate keeps `Num` and adds `Int`; no diagnostic is left after it.

pub fn toggle[T: Num](a: T, b: T) -> T {
  a ^ b                                             //~ E0401
}
