// Functions that another module (main.onsa) imports, with the errors of the conversion functions in a module file.

pub fn bias() -> F64 {
  0.5
}

pub fn widen(x: F32) -> F64 {
  F64.round_from(x)                                 //~ E0413
}

pub fn narrow(n: I32) -> Option[I64] {
  I64.narrow_from(n)                                //~ E0413
}

pub fn scaled(x: F32, k: F64) -> F64 {
  k * F64.round_from(x)                             //~ E0413
}

pub fn count(n: I32) -> I32 {
  n
}
