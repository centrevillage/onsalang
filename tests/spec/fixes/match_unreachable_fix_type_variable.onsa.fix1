// onsa.toml
// [test]
// spec = ["§7", "§18.1"]
// fixes = 1

// S-876 (U3 of W5-09): the deletion of an unreachable arm is not made when the arm is the one that decided the type of a variable before it (§7: "到達しない文を消す候補は、当てた後に
// 関数の終わりの検査が誤りを出す形では出さない（§18.1）"; S-876: the arm is not checked, so a variable whose type only that arm decides is open once the arm is deleted, and the check of the end
// of the function reports it, E0406 for `None` and E0405 for a float literal, in the same stage as the E0503). The move of the covering arm is made: the arm is read again, and it
// decides the type. So the one candidate here is the move, and the contract of §18.1 checks that the unit is left clean. The text is not written. One error per function (P-01).

pub fn arm_decides_the_type_of_none(x: I32) -> I32 {
  let o = None
  match x {
    
    1 => {                                          //~ E0503
      let z: Option[I32] = o
      match z {
        Some(k) => k,
        None => 2,
      }
    },
    _ => 0,
  }
}

pub fn arm_decides_the_type_of_a_float(x: I32) -> I32 {
  var acc = 0.0
  match x {
    
    1 => {                                          //~ E0503
      let y: F32 = acc
      acc = y + 1.0
    },
    _ => { },
  }
  0
}
