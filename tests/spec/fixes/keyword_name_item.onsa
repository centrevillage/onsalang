// onsa.toml
// [test]
// spec = ["§2.2", "§2.3", "§18.1"]
// fixes = 1

// E0002 for keywords written as the names of a function, a `flow` and the methods of an `impl` (S-654, §2.3): names that
// have the form snake_case, so the candidate is the name with a `_` at the end. Nothing here uses the name. One error in
// each unit (a member is a unit).

pub fn type() -> I32 {                              //~ E0002
  1
}

pub fn in(x: I32) -> I32 {                          //~ E0002
  x
}

pub flow as(x: F32 at sample) -> F32 at sample {    //~ E0002
  x
}

pub struct P {
  x: I32,
}

impl P {
  fn uses(self) -> I32 {                            //~ E0002
    self.x
  }

  fn at(self) -> I32 {                              //~ E0002
    self.x
  }
}
