// S-957 (W5-11 U10d2/t2, §2.5, §2.6, §18.1): the candidate of a prefix `~` at the end of a line replaces the `~` by `!` and
// moves it to the line of its operand (`!m`), and nothing is left behind (`clean`, S-253: the unit has no error after the one
// edit). The main position is the `~`. A file with one unit, so that `clean` looks at the whole file.

pub fn f(m: U32) -> U32 {
  let n =   //~ E0020 @11
    !m
  n
}
