// onsa.toml
// [test]
// spec = ["§11.3", "§3.1", "§18.1"]
// fixes = 1
//
// [[test.fix]]
// at = "20:9"
// code = "E0020"
// candidate = 1
// clean = true

// E0020 for the clock written on the binding side of a `let` or `var` (spec §11.3, §18.1; S-378; the row
// `clock_on_binding` of spec/foreign-forms.toml): after the name or the pattern, with or without a type
// annotation, the code and the candidate are those of `let y: F32 at sample = x`.
// The value is an `at` already, and moving the clock would chain two (E0011), so the candidate removes the
// clock of the binding side: `let y = p at block`. The candidate leaves nothing (`clean`). This file has this one
// error.

pub flow clock_on_a_value_with_a_clock(p: F32 at block) -> F32 at sample {
  let y at sample = p at block                      //~ E0020
  y
}
