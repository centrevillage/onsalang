// [test]
// spec = ["§2.5", "§2.6", "§3.1", "§18.1"]
// fixes = 1
//
// [[test.fix]]
// at = "18:11"
// code = "E0020"
// candidate = 1
// clean = true

// S-958 (W5-11 U10i/t, §2.5, §2.6, §3.1, §18.1): the one candidate of a prefix `~` at the end of a line whose operand begins with a
// `-` on the next line (`~` and then `-m`) writes `!(-m)` on the line of the operand (the line break moves to the operand's
// line), and nothing is left behind (`clean`, S-253). The main position is the `~`. A file with one unit, so that
// `clean` looks at the whole file.

pub fn f(m: I32) -> I32 {
  let n = ~   //~ E0020
    -m
  n
}
