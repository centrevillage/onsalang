// onsa.toml
// [test]
// spec = ["§5.2", "§18.1"]
// fixes = 1
// [[test.fix]]
// at = "18:11"
// code = "E0711"
// candidate = 1
// clean = true

// R-198, S-807 (§5.2): the argument of a borrowed parameter is a `match` that has the `move` on the whole. The candidate only removes the `move`.

pub fn rd(b: Buf[F32]) -> U32 uses {Alloc} {
  b.len()
}

pub fn borrowed_arg_match(k: U32, move x: Buf[F32], move y: Buf[F32]) -> U32 uses {Alloc} {
  rd(move match k { //~ E0711
    0 => x,
    _ => y,
  })
}
