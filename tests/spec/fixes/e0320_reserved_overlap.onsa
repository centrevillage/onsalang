// onsa.toml
// [test]
// spec = ["§2.3", "§2.2", "§5.1", "§18.1"]
// fixes = 0

// W4-04 U9, S-243, S-652: the one candidate of an E0320 whose rule-made name is a reserved word is the
// word with a `_` at the end (`Clock` is `clock_`, `_type` is `type_`, §2.3), and it is the only
// candidate. When that name is already a name of the same space, a declaration with it is E0304
// (§5.1) and the candidate would leave an error in the unit it touches, so §18.1 gives no candidate,
// and a note shows the name that the rule makes. The written `fixes = 0` checks that no diagnostic of
// the file has a candidate. This is not stated for the reserved-word candidate by S-652 itself (the
// name in S-652 is the one that the rule makes), it follows from the two rules together.

pub fn Clock() -> I32 { //~ E0320
  1
}

pub fn clock_() -> I32 {
  2
}

pub fn local_and_local() -> I32 {
  let _type = 1 //~ E0320
  let type_ = 2
  _type + type_
}

pub fn parameter_and_parameter(_match: I32, match_: I32) -> I32 { //~ E0320
  _match + match_
}

pub fn type_parameter_and_type_parameter[_Self, Self_](a: _Self, b: Self_) -> Self_ { //~ E0320
  b
}
