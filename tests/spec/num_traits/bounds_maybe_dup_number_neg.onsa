// onsa.toml
// [test]
// spec = ["§4.5", "§6.3", "§18.1"]
// fixes = 0

// W5-05 U1/t (S-747, S-711; §4.5: "`?Dup` を Dup を要する境界(`Dup`、`Copy`、`AnyNum`、`Num`、`Float`、`Int`、`Unsigned`。数の trait は全て
// `Copy` を要する、§6.3)と並べる形 ... は E0416 で、並びを前から読んで前の要素と重なるか矛盾する最初の要素に付け"; "`?` を付けられるのは
// `Dup` と `Escape` だけで、他の境界 ... に付けると E0416"): the number traits all need `Copy`, so `?Dup` beside `AnyNum`, `Int` or
// `Unsigned` (as beside `Num` and `Float`, types/bounds_contradiction.onsa) contradicts it: E0416 on the first element that
// contradicts one before it, in either order, with no candidate (`fixes = 0`: which to drop is the writer's). A `?` on a
// number trait or on an operator trait is E0416 too (the only `?` is `?Dup` and `?Escape`). In every place that has a list
// of bounds. The right forms are in bounds_maybe_dup_number_fine.onsa. One error per item (P-01).

pub fn any_num_then_maybe_dup[T: AnyNum + ?Dup](x: T) -> U32 { //~ E0416
  0
}

pub fn int_then_maybe_dup[T: Int + ?Dup](x: T) -> U32 { //~ E0416
  0
}

pub fn unsigned_then_maybe_dup[T: Unsigned + ?Dup](x: T) -> U32 { //~ E0416
  0
}

pub fn maybe_dup_then_any_num[T: ?Dup + AnyNum](x: T) -> U32 { //~ E0416
  0
}

pub fn maybe_dup_then_int[T: ?Dup + Int](x: T) -> U32 { //~ E0416
  0
}

pub fn maybe_dup_then_unsigned[T: ?Dup + Unsigned](x: T) -> U32 { //~ E0416
  0
}

pub fn a_trait_between[T: AnyNum + Show + ?Dup](x: T) -> U32 { //~ E0416
  0
}

pub fn maybe_any_num[T: ?AnyNum](x: T) -> U32 { //~ E0416
  0
}

pub fn maybe_int[T: ?Int](x: T) -> U32 { //~ E0416
  0
}

pub fn maybe_unsigned[T: ?Unsigned](x: T) -> U32 { //~ E0416
  0
}

pub fn maybe_add[T: ?Add](x: T) -> U32 { //~ E0416
  0
}

pub fn maybe_wrapping_add[T: ?WrappingAdd](x: T) -> U32 { //~ E0416
  0
}

pub fn in_the_second_parameter[T, U: Int + ?Dup](x: T, y: U) -> U32 { //~ E0416
  0
}

pub struct IntMaybeDup[T: Int + ?Dup] { //~ E0416
  a: T,
}

pub enum MaybeDupAnyNum[T: ?Dup + AnyNum] { //~ E0416
  One(T),
  Nothing,
}

pub struct Holder[T] {
  a: T,
}

impl[T: Unsigned + ?Dup] Holder[T] { //~ E0416
  pub fn tag() -> U32 {
    7
  }
}

pub struct Plain {
  n: U32,
}

impl Plain {
  pub fn method_with_two[T: AnyNum + ?Dup](self, x: T) -> U32 { //~ E0416
    self.n
  }
}
