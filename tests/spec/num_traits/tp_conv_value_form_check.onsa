// onsa.toml
// [test]
// spec = ["§3.3", "§6.1", "§6.3"]

// W5-05 U3 (spec §6.1: "関連関数と名前空間の関数は、項目の関数と同じく値として使える"; §3.3: the source of a value form comes from the expected type): the bodies of
// tp_conv_value_form.onsa, checked. That case runs them, which waits for the call of a function value in Core (W8-09).

pub fn via_binding[T: Float](k: U32) -> T {
  let g: fn(U32) -> T = T.round_from
  g.(k)
}

pub fn via_narrow[T: Int](n: I64) -> Option[T] {
  let g: fn(I64) -> Option[T] = T.narrow_from
  g.(n)
}

pub fn via_trunc[T: Int](y: F64) -> T {
  let g: fn(F64) -> T = T.trunc_from
  g.(y)
}

pub fn via_trunc_sat[T: Int](y: F32) -> T {
  let g: fn(F32) -> T = T.trunc_sat_from
  g.(y)
}

pub fn via_other_source[T: Float](k: I32) -> T {
  let g: fn(I32) -> T = T.round_from
  g.(k)
}
