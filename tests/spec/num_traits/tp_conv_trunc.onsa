// onsa.toml
// [test]
// mode = "test"
// spec = ["§3.3", "§3.4", "§6.3", "§9.2"]

// W5-05 U3/t (spec §3.3: `Int` has `trunc_from` and `trunc_sat_from`, so `T.trunc_from(y)` with `T: Int` converts a float; §3.4:
// "`trunc_from` はゼロ方向に切り捨てる。切り捨てた値が型に収まらないとき (範囲外) と NaN は panic ... `trunc_sat_from` は、範囲外を型の最小値か
// 最大値にし、NaN を 0 にする"): the target is the type parameter `T: Int` and the source is a value of the type parameter `S: Float`, at F32
// and F64. `-0.9` cut toward zero is 0 and fits an unsigned type; the largest `F32` below 2^31 is 2^31 - 128 = 2147483520.
// The functions `w_*` at the end fix the type arguments: a call does not write `name::[...]` in this version (W5-10).

fn trunc[T: Int, S: Float](y: S) -> T {
  T.trunc_from(y)
}

fn trunc_sat[T: Int, S: Float](y: S) -> T {
  T.trunc_sat_from(y)
}

test "T.trunc_from cuts toward zero" {
  assert w_trunc_i32_f32(2.75) == 2
  assert w_trunc_i32_f32(-2.75) == -2
  assert w_trunc_i32_f64(2.75) == 2
  assert w_trunc_u32_f64(-0.9) == 0
  assert w_trunc_u8_f32(255.5) == 255
  assert w_trunc_i8_f64(127.9) == 127
  assert w_trunc_i8_f64(-128.5) == -128
  assert w_trunc_i16_f32(-32768.0) == -32768
  assert w_trunc_u16_f64(65535.75) == 65535
}

test "T.trunc_from at the limits of the 32 and 64 bit types" {
  assert w_trunc_i32_f32(2147483520.0) == 2147483520
  assert w_trunc_u32_f64(4294967295.0) == 4294967295
  assert w_trunc_i32_f64(-2147483648.0) == -2147483648
  assert w_trunc_i64_f64(4611686018427387904.0) == 4611686018427387904
  assert w_trunc_u64_f64(0.0) == 0
}

test "T.trunc_from panics out of the range" {
  let n = w_trunc_u32_f64(-1.0) //~ PANIC "T.trunc_from panics out of the range"
  assert n == 0
}

test "T.trunc_from panics for an F32 that is above the type" {
  let n = w_trunc_u8_f32(256.0) //~ PANIC "T.trunc_from panics for an F32 that is above the type"
  assert n == 0
}

test "T.trunc_from panics for a NaN" {
  let n = w_trunc_i32_f32(F32.NAN) //~ PANIC "T.trunc_from panics for a NaN"
  assert n == 0
}

test "T.trunc_from panics above the largest value of a signed type" {
  let n = w_trunc_i8_f64(128.0) //~ PANIC "T.trunc_from panics above the largest value of a signed type"
  assert n == 0
}

test "T.trunc_from panics for 2^31 as I32" {
  let n = w_trunc_i32_f32(2147483648.0) //~ PANIC "T.trunc_from panics for 2^31 as I32"
  assert n == 0
}

test "T.trunc_sat_from clamps to the type" {
  assert w_trunc_sat_i8_f32(300.5) == 127
  assert w_trunc_sat_i8_f64(-300.5) == -128
  assert w_trunc_sat_u8_f64(-5.5) == 0
  assert w_trunc_sat_u8_f64(255.5) == 255
  assert w_trunc_sat_u8_f32(256.0) == 255
  assert w_trunc_sat_i16_f32(1.0e10) == 32767
  assert w_trunc_sat_u32_f32(F32.INFINITY) == 4294967295
  assert w_trunc_sat_i64_f64(-F64.INFINITY) == I64.MIN
  assert w_trunc_sat_i64_f64(F64.INFINITY) == I64.MAX
}

test "T.trunc_sat_from maps a NaN to 0 and cuts toward zero in the range" {
  assert w_trunc_sat_i8_f32(F32.NAN) == 0
  assert w_trunc_sat_u64_f64(F64.NAN) == 0
  assert w_trunc_sat_i32_f32(-2.75) == -2
  assert w_trunc_sat_u16_f64(65535.75) == 65535
}

fn w_trunc_i32_f32(y: F32) -> I32 {
  trunc(y)
}

fn w_trunc_i32_f64(y: F64) -> I32 {
  trunc(y)
}

fn w_trunc_u32_f64(y: F64) -> U32 {
  trunc(y)
}

fn w_trunc_u8_f32(y: F32) -> U8 {
  trunc(y)
}

fn w_trunc_i8_f64(y: F64) -> I8 {
  trunc(y)
}

fn w_trunc_i16_f32(y: F32) -> I16 {
  trunc(y)
}

fn w_trunc_u16_f64(y: F64) -> U16 {
  trunc(y)
}

fn w_trunc_i64_f64(y: F64) -> I64 {
  trunc(y)
}

fn w_trunc_u64_f64(y: F64) -> U64 {
  trunc(y)
}

fn w_trunc_sat_i8_f32(y: F32) -> I8 {
  trunc_sat(y)
}

fn w_trunc_sat_i8_f64(y: F64) -> I8 {
  trunc_sat(y)
}

fn w_trunc_sat_u8_f64(y: F64) -> U8 {
  trunc_sat(y)
}

fn w_trunc_sat_u8_f32(y: F32) -> U8 {
  trunc_sat(y)
}

fn w_trunc_sat_i16_f32(y: F32) -> I16 {
  trunc_sat(y)
}

fn w_trunc_sat_u32_f32(y: F32) -> U32 {
  trunc_sat(y)
}

fn w_trunc_sat_i64_f64(y: F64) -> I64 {
  trunc_sat(y)
}

fn w_trunc_sat_u64_f64(y: F64) -> U64 {
  trunc_sat(y)
}

fn w_trunc_sat_i32_f32(y: F32) -> I32 {
  trunc_sat(y)
}

fn w_trunc_sat_u16_f64(y: F64) -> U16 {
  trunc_sat(y)
}
