// onsa.toml
// [test]
// mode = "test"
// spec = ["§6.3", "§4.5"]

// W5-05 U1/t (§6.3, the table of the traits that a built-in type implements): `T: AnyNum` takes every number type, the signed
// and the unsigned integers and the floats (`AnyNum` "は、符号なしを含む全ての数を表す"). The value comes back as it went in,
// and the function reads it twice (`AnyNum` has `Copy`).

fn same[T: AnyNum](x: T) -> T {
  x
}

fn twice[T: AnyNum](x: T) -> (T, T) {
  (x, x)
}

test "AnyNum takes the signed integers" {
  let a: I8  = -128
  let b: I16 = -32768
  let c: I32 = -2147483648
  let d: I64 = I64.MIN
  assert same(a) == -128
  assert same(b) == -32768
  assert same(c) == -2147483648
  assert same(d) == I64.MIN
}

test "AnyNum takes the unsigned integers" {
  let a: U8  = 255
  let b: U16 = 65535
  let c: U32 = 4294967295
  let d: U64 = 18446744073709551615
  assert same(a) == 255
  assert same(b) == 65535
  assert same(c) == 4294967295
  assert same(d) == 18446744073709551615
}

test "AnyNum takes the floats" {
  let a: F32 = 1.5
  let b: F64 = -0.25
  assert same(a) == 1.5
  assert same(b) == -0.25
}

test "AnyNum reads a value twice for every family" {
  let a: U8    = 9
  let b: I64   = -9
  let c: F32   = 0.5
  let (a1, a2) = twice(a)
  let (b1, b2) = twice(b)
  let (c1, c2) = twice(c)
  assert a1 == 9
  assert a2 == 9
  assert b1 == -9
  assert b2 == -9
  assert c1 == 0.5
  assert c2 == 0.5
}
