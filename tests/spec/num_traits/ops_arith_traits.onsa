// onsa.toml
// [test]
// mode = "test"
// spec = ["§3.2", "§3.4", "§6.3"]

// W5-05 U1/t (§3.2: "`+` は `Add.add`"; §6.3: "各演算子は、被演算子の型がその演算子の trait を満たすことを要する"): each of `+ - * / %`
// finds its own trait, so a function with the bound `T: Add` alone uses `+`, `T: Sub` uses `-`, and so on, with no number trait
// asked. The result is a `T` (the spec gives no result type to a single operator trait, and this is the only reading that
// the bounds `Add` ... `Rem` of a program can have). The value of the instance is the value of the same operator on the
// type itself (§3.4): the integer overflow, the division toward zero, the remainder with the sign of the dividend, the float
// rounding and `fmod`.

fn add2[T: Add](a: T, b: T) -> T {
  a + b
}

fn sub2[T: Sub](a: T, b: T) -> T {
  a - b
}

fn mul2[T: Mul](a: T, b: T) -> T {
  a * b
}

fn div2[T: Div](a: T, b: T) -> T {
  a / b
}

fn rem2[T: Rem](a: T, b: T) -> T {
  a % b
}

test "Add adds integers and floats" {
  let a: I32 = 7
  let b: I32 = 5
  let c: U8 = 200
  let d: U8 = 55
  let e: F64 = 0.5
  let f: F64 = 0.25
  assert add2(a, b) == 12
  assert add2(c, d) == 255
  assert add2(e, f) == 0.75
  assert add2(a, b) == a + b
}

test "Sub subtracts integers and floats" {
  let a: I8 = -100
  let b: I8 = 28
  let c: U16 = 10
  let d: U16 = 3
  let e: F32 = 1.5
  let f: F32 = 0.25
  assert sub2(a, b) == -128
  assert sub2(c, d) == 7
  assert sub2(e, f) == 1.25
}

test "Mul multiplies integers and floats" {
  let a: I16 = -300
  let b: I16 = 100
  let c: U8 = 15
  let d: U8 = 17
  let e: F32 = 1.5
  let f: F32 = 4.0
  assert mul2(a, b) == -30000
  assert mul2(c, d) == 255
  assert mul2(e, f) == 6.0
}

test "Div divides toward zero for integers and exactly for floats" {
  let a: I32 = -7
  let b: I32 = 2
  let c: U32 = 7
  let d: U32 = 2
  let e: F64 = 1.0
  let f: F64 = 4.0
  assert div2(a, b) == -3
  assert div2(c, d) == 3
  assert div2(e, f) == 0.25
}

test "Div of a float by zero is an infinity" {
  let a: F32 = 1.0
  let z: F32 = 0.0
  assert div2(a, z) == F32.INFINITY
}

test "Rem takes the sign of the dividend and fmod for floats" {
  let a: I32 = -7
  let b: I32 = 3
  let c: U32 = 7
  let d: U32 = 3
  let e: F64 = 5.5
  let f: F64 = 2.0
  assert rem2(a, b) == -1
  assert rem2(c, d) == 1
  assert rem2(e, f) == 1.5
}

test "Rem of the least signed integer by -1 is 0" {
  let a: I8 = -128
  let b: I8 = -1
  assert rem2(a, b) == 0
}

test "Add panics where the integer overflows" {
  let a: U8 = 255
  let b: U8 = 1
  let r = add2(a, b) //~ PANIC "Add panics where the integer overflows"
  assert r == 0
}

test "Sub panics where an unsigned integer falls below 0" {
  let a: U32 = 0
  let b: U32 = 1
  let r = sub2(a, b) //~ PANIC "Sub panics where an unsigned integer falls below 0"
  assert r == 0
}

test "Mul panics where the integer overflows" {
  let a: I16 = 256
  let b: I16 = 128
  let r = mul2(a, b) //~ PANIC "Mul panics where the integer overflows"
  assert r == 0
}

test "Div panics where the divisor is 0" {
  let a: U8 = 5
  let z: U8 = 0
  let r = div2(a, z) //~ PANIC "Div panics where the divisor is 0"
  assert r == 0
}

test "Div panics where the least signed integer is divided by -1" {
  let a: I32 = I32.MIN
  let b: I32 = -1
  let r = div2(a, b) //~ PANIC "Div panics where the least signed integer is divided by -1"
  assert r == 0
}

test "Rem panics where the divisor is 0" {
  let a: I64 = 5
  let z: I64 = 0
  let r = rem2(a, z) //~ PANIC "Rem panics where the divisor is 0"
  assert r == 0
}
