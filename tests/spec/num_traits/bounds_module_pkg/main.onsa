// onsa.toml
// [test]
// mode = "test"
// spec = ["§6.3", "§4.5", "§15.1"]

// W5-05 U1/t (§6.3; §15.1): the number traits are in the prelude, so the bounds of the functions and the type of `lib` are met
// by the instances of this module without a `use` of any trait. A call by the path (`lib.double`), a call by an imported
// name, a type of the other module with its bound (`lib.Gain[T]` for `T: Num`) and a generic function of this module that
// passes its own parameter on (an `AnyNum` to `lib.double`, an `Unsigned` to `lib.halve_bits`) are all right.

use lib
use lib.{flip, gain_of, halve_bits, low_bits, lower, make_gain, Gain}

fn quad[T: AnyNum](x: T) -> T {
  lib.double(lib.double(x))
}

fn shifted_twice[T: Unsigned](x: T) -> T {
  halve_bits(halve_bits(x))
}

fn flip_gain[T: Num](g: Gain[T]) -> T {
  flip(gain_of(g))
}

test "a function of the other module takes an unsigned, a signed and a float instance" {
  let a: U8 = 100
  let b: I16 = -30
  let c: F32 = 0.25
  assert lib.double(a) == 200
  assert lib.double(b) == -60
  assert lib.double(c) == 0.5
}

test "a bound Unsigned, Num and Int of the other module" {
  let a: U32 = 64
  let b: F64 = 1.5
  let c: U16 = 255
  assert halve_bits(a) == 32
  assert flip(b) == -1.5
  assert low_bits(c, 15) == 15
}

test "a type with a bound of the other module" {
  let f: F32 = 0.5
  let g = make_gain(f)
  assert gain_of(g) == 0.5
  let h: I32 = 7
  assert flip_gain(make_gain(h)) == -7
}

test "a function of this module passes its parameter on" {
  let a: U8 = 20
  let b: I64 = -5
  assert quad(a) == 80
  assert quad(b) == -20
  assert shifted_twice(a) == 5
  let x: U32 = 3
  let y: U32 = 2
  assert lower(x, y) == 2
}
