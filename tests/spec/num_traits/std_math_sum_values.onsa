// onsa.toml
// [test]
// mode = "test"
// spec = ["§13.4", "§3.4", "§6.3"]

// W5-07 U1/t (§13.4: "`std.math.sum[T: AnyNum, const N: U32](xs: [T; N]) -> T` は Onsa で書いた関数で、... `xs[0]` から順に左へ畳む"; R-23): `sum` is
// a function of `std.math`, for the floats and for every integer width, signed and unsigned. Each value is worked out by hand
// from the rules of §3.4: a float sum is rounded once for each addition (the F32 sum of 2^24, 1.0 and 1.0 is 2^24, because
// each `2^24 + 1.0` is a tie that goes to the even value), and an integer sum is the exact sum when every step fits. The empty
// array, the zero signs and the order of the fold are in the files that name them (std_math_sum_empty.onsa,
// std_math_sum_zero_sign.onsa, std_math_sum_order.onsa).

use std.math.{is_nan, sum}

test "sum of F32 values" {
  let xs: [F32; 4] = [1.5, 2.25, -0.75, 4.0]
  assert sum(xs) == 7.0
}

test "sum of F64 values" {
  let xs: [F64; 3] = [0.5, 0.25, 0.125]
  assert sum(xs) == 0.875
}

test "sum of a single element is that element" {
  let a: [F32; 1] = [3.5]
  let b: [F64; 1] = [-0.125]
  let c: [I8; 1] = [-128]
  let d: [U64; 1] = [18446744073709551615]
  assert sum(a) == 3.5
  assert sum(b) == -0.125
  assert sum(c) == -128
  assert sum(d) == 18446744073709551615
}

test "sum of the signed integers" {
  let a: [I8; 4] = [-100, 50, 20, -3]
  let b: [I16; 3] = [30000, -30000, 7]
  let c: [I32; 3] = [2147483647, -2147483647, 5]
  let d: [I64; 3] = [9223372036854775807, -9223372036854775807, 5]
  assert sum(a) == -33
  assert sum(b) == 7
  assert sum(c) == 5
  assert sum(d) == 5
}

test "sum of the unsigned integers" {
  let a: [U8; 3] = [100, 100, 55]
  let b: [U16; 2] = [65000, 535]
  let c: [U32; 2] = [4294967290, 5]
  let d: [U64; 2] = [18446744073709551615, 0]
  assert sum(a) == 255
  assert sum(b) == 65535
  assert sum(c) == 4294967295
  assert sum(d) == 18446744073709551615
}

test "each float addition is rounded to the type of the array" {
  let a: [F32; 3] = [16777216.0, 1.0, 1.0]
  let b: [F32; 3] = [1.0, 1.0, 16777216.0]
  assert sum(a) == 16777216.0
  assert sum(b) == 16777218.0
}

test "sum with an infinity and a NaN" {
  let a: [F32; 2] = [F32.INFINITY, 1.0]
  let b: [F64; 3] = [1.0, F64.INFINITY, -F64.INFINITY]
  let c: [F32; 2] = [1.0, F32.NAN]
  assert sum(a) == F32.INFINITY
  assert is_nan(sum(b))
  assert is_nan(sum(c))
}
