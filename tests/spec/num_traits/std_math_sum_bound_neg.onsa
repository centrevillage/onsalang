// onsa.toml
// [test]
// spec = ["§13.4", "§6.3", "§4.5"]

// W5-07 U1/t (§13.4: the bound of `sum` is `T: AnyNum`; §6.3: `Num`, `Float`, `Int` and `Unsigned` have `AnyNum` above them;
// §4.5: a bound that the caller does not give is E0416): a generic function that passes its own parameter `T` to `sum` needs
// a bound of its own that implies `AnyNum`. `Copy`, `PartialOrd`, `PartialEq`, `Default` and `Ord` do not (a type with only
// these bounds is not known to have a `ZERO` or an addition), so each call is E0416. The calls from bounds that do imply
// `AnyNum` are in std_math_sum_generic.onsa. One error per function (P-01).

use std.math.{sum}

pub fn only_copy[T: Copy](a: T, b: T) -> T {
  sum([a, b]) //~ E0416
}

pub fn only_ordered[T: Copy + PartialOrd](a: T, b: T) -> T {
  sum([a, b]) //~ E0416
}

pub fn only_equal[T: Copy + PartialEq](a: T, b: T) -> T {
  sum([a, b]) //~ E0416
}

pub fn only_default[T: Copy + Default](a: T, b: T) -> T {
  sum([a, b]) //~ E0416
}

pub fn only_total_order[T: Copy + Ord](a: T, b: T) -> T {
  sum([a, b]) //~ E0416
}

pub fn array_only_copy[T: Copy, const N: U32](xs: [T; N]) -> T {
  sum(xs) //~ E0416
}

pub fn empty_only_copy[T: Copy](like: T) -> T {
  let e: [T; 0] = []
  sum(e) //~ E0416
}
