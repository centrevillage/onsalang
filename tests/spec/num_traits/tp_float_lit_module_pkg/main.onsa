// onsa.toml
// [test]
// mode = "test"
// spec = ["§6.6", "§15.1", "§2.4"]

// W5-05 U4/t (§6.6: a float literal is a value of `T: Float`; §15.1: the items of a module are used by their path or an imported name, and an instance is made where the item is used): a
// generic function and a generic type of another module that have float literals, used from this module at `F32` and `F64`: a call by the path (`lib.halve`), by an imported name
// (`tenth`), a function of the other module that calls another one of it (`quarter_of_half`), a method of an `impl` of the other module, a function of this module that passes its
// own `T: Float` on to the other module's function, and the associated constant read by a type of the other module through an alias. The values: 3.0 * 0.5 = 1.5, 3.0 * 0.5 * 0.5 = 0.75,
// (4.0 * 0.5) * 0.25 = 0.5; the bits of 0.1 are those of `tp_float_lit_round_bits.onsa`.

use lib
use lib.{make_mix, Mix, quarter_of_half, tenth}

type MixF32 = Mix[F32]
type MixF64 = Mix[F64]

fn through[T: Float](x: T) -> T {
  lib.halve(x) + 0.125
}

test "a call by the path of the module" {
  let a: F32 = 3.0
  let b: F64 = 5.0
  assert lib.halve(a) == 1.5
  assert lib.halve(b) == 2.5
}

test "the literal of the other module is rounded for each type" {
  let a: F32 = 0.0
  let b: F64 = 0.0
  assert tenth(a).to_bits() == 0x3DCCCCCD
  assert tenth(b).to_bits() == 0x3FB999999999999A
}

test "a function of the other module that calls another function of it" {
  let a: F32 = 3.0
  let b: F64 = 3.0
  assert quarter_of_half(a) == 0.75
  assert quarter_of_half(b) == 0.75
}

test "a method of a type of the other module" {
  let a: F32 = 4.0
  let b: F64 = 4.0
  let ma = make_mix(a)
  let mb = make_mix(b)
  assert ma.wet() == 0.5
  assert mb.wet() == 0.5
}

test "the associated constant of a type of the other module through an alias" {
  assert MixF32.HALF == 0.5
  assert MixF64.HALF.to_bits() == 0x3FE0000000000000
}

test "a function of this module that passes its type parameter on" {
  let a: F32 = 3.0
  let b: F64 = 1.0
  assert through(a) == 1.625
  assert through(b) == 0.625
}
