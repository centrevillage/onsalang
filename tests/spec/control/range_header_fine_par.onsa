// onsa.toml
// [test]
// spec = ["§7", "§11.5", "§18.1"]

// The flow with both ends next to the cases of negative/range_header_one_sided_par.onsa (§7, §11.5,
// S-278; moved from it, the expectations unchanged): a range with both ends in the header of a `par`
// has no error.

pub flow fine_par(x: F32 at sample) -> [F32; 4] at sample {
  par i in 0..<4 {
    x * i.round_f32()
  }
}
