// The items of another module that main.onsa takes apart with the pattern `()`: a function that returns a `()` and counts its calls, a variant with a `()`
// payload, a struct with a `()` field, and a function that returns an `Option[()]`.

pub fn touch(inout n: I32) {
  n = n + 1
}

pub fn probe(c: Bool) -> Option[()] {
  if c {
    Some(())
  } else {
    None
  }
}

pub enum Ev {
  Tick(()),
  Note(I32),
}

pub struct Msg {
  done: (),
  n: I32,
}
