// onsa.toml
// [test]
// spec = ["§7", "§3.1", "§18.1"]

// The correct forms of fixes/e0020_patterns_range.onsa (§7): a range in the header of a `for`, and the
// guard form of a range pattern. Moved out of that file so that its E0200 (the value of a `match`
// with a guard, W8-06) does not hide the range patterns there.

pub fn fine(n: I32, flag: Bool) -> I32 {
  var t = 0
  for i in 0..<n {
    t = t + i
  }
  for j in 1..=3 {
    t = t + j
  }
  let a = match n {
    k if 1 <= k && k < 3 => 1,
    k if 5 <= k && k <= 7 && flag => 2,
    -1 => 3,
    _ => 0,
  }
  t + a
}
