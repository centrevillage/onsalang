// onsa.toml
// [test]
// mode = "parse"
// spec = ["§4.4", "§11.5"]

// The `par~` header of header_brace_inside_index.onsa and its neighbours (§4.4, S-376): a `{` inside
// the `[` of an index, inside the arms of a `match`, and inside parentheses is not the start of
// the body of `par~ i in a ..< b {`. The end of a `par~` range is a constant (§11.5), so the cases
// would be errors of a later stage (E0417); the file reads the syntax only (`mode = "parse"`), and
// checks that the header is read as one and the body starts at the `{` of depth 0. The depth 0 `{`
// of the header (`par~ i in 0 ..< { 4 } {`) is E0002, in negative/header_block_expression_par.onsa.

pub flow par_index(x: F32 at sample, xs: [U32; 3]) -> [F32; 4] at sample {
  par~ i in 0 ..< xs[{ 1 }] {
    x
  }
}

pub flow par_match_arm(x: F32 at sample, n: U32) -> [F32; 4] at sample {
  par~ i in 0 ..< match n { _ => { 4 } } {
    x
  }
}

pub flow par_struct_in_index(x: F32 at sample, xs: [U32; 3]) -> [F32; 4] at sample {
  par~ i in 0 ..< xs[S { a: 1 }.a] {
    x
  }
}

pub flow par_nested_index(x: F32 at sample, xs: [U32; 3], ys: [U32; 3]) -> [F32; 4] at sample {
  par~ i in 0 ..< xs[{ ys[{ 0 }] }] {
    x
  }
}

pub flow par_index_in_the_start(x: F32 at sample, xs: [U32; 3]) -> [F32; 4] at sample {
  par~ i in xs[{ 0 }] ..< 4 {
    x
  }
}
