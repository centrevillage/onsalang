// onsa.toml
// [test]
// spec = ["§7", "§11.5", "§18.1"]

// The correct heads of negative/range_header_one_sided.onsa (§7): a range with both ends, the half-open
// `..<` and the closed `..=`. Apart from that file, which has only the errors.

pub fn fine(n: U32) -> U32 {
  var t: U32 = 0
  for i in 0 ..< n {
    t = t + i
  }
  for j in 1 ..= n {
    t = t + j
  }
  t
}
