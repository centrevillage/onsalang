// onsa.toml
// [test]
// mode = "test"
// spec = ["§3.5", "§7", "§3.1"]

// W8-03 U4/t, spec §3.5 ("範囲 `a ..< b` と `a ..= b` は、`a`、`b` の順に、最初の反復の前に一度だけ評価する。本体で端の変数を変えても、反復の回数は
// 変わらない") and §7, S-188, S-219: the order and the number of the evaluations of the ends of a closed range in the head of a `for`. The cases
// of `a ..< b` are in range_half_open.onsa. A closed range may be lowered so that the end is compared first and the variable is stepped
// afterwards (§7), but the ends are the same values: they are taken once, before the first iteration, in the order `a`, `b`.
//
// `tick(inout log, d)` appends the digit `d` to the log (`log * 10 + d`) and returns `d`, so the log tells the calls and their order.
// Every value below is worked out by hand from the spec text.

fn tick(inout log: U32, d: U32) -> U32 {
  let shifted = log * 10
  log = shifted + d
  d
}

fn next(inout k: U32) -> U32 {
  k = k + 1
  k
}

test "an end changed by the body does not change the number of iterations" {
  var hi: U32 = 3
  var n: U32 = 0
  // 0 ..= 3 is four values, although hi is 4, 5, 6, 7 after the iterations.
  for _ in 0 ..= hi {
    hi = hi + 1
    n = n + 1
  }
  assert n == 4
  assert hi == 7
  var lo: U32 = 0
  var sum: U32 = 0
  // 0 ..= 3 again: the start was taken before lo was set to 2.
  for i in lo ..= 3 {
    lo = 2
    sum = sum + i
  }
  assert sum == 6
  assert lo == 2
}

test "an end that is a sum is evaluated once" {
  var k: U32 = 0
  var n: U32 = 0
  // next gives 1, so the end is 1 + 1 = 2 and the range is 0 ..= 2; had the end run again, k would not stay 1.
  for _ in 0 ..= next(inout k) + 1 {
    n = n + 1
  }
  assert n == 3
  assert k == 1
}

test "the operands of the ends run in the order of the expression: the start, then the end left to right" {
  var log: U32 = 0
  var n: U32 = 0
  // start 1; end 2 + 3 = 5; the range is 1 ..= 5.
  for _ in tick(inout log, 1) ..= tick(inout log, 2) + tick(inout log, 3) {
    n = n + 1
  }
  assert log == 123
  assert n == 5
}

test "the start is read before the end changes what it reads" {
  var c: U32 = 1
  var n: U32 = 0
  // start 1 (c before the end runs); the end sets c to 14 and is 4 + 1; the range is 1 ..= 5.
  for _ in c ..= tick(inout c, 4) + 1 {
    n = n + 1
  }
  assert n == 5
  assert c == 14
}

test "each execution of an inner header evaluates its own ends once" {
  var log: U32 = 0
  var n: U32 = 0
  for _ in 0 ..< 2 {
    // 1 ..= 2 + 1 is 1 ..= 3: three iterations; the header runs once for each outer iteration.
    for _ in tick(inout log, 1) ..= tick(inout log, 2) + 1 {
      n = n + 1
    }
  }
  assert log == 1212
  assert n == 6
}

test "the inner end that is the outer variable follows the outer iteration" {
  var n: U32 = 0
  // i = 0: 0 ..= 0 is 1 value; i = 1: 2; i = 2: 3.
  for i in 0 ..= 2 {
    for _ in 0 ..= i {
      n = n + 1
    }
  }
  assert n == 6
}

test "both ends are evaluated when the range is empty, the start first" {
  var log: U32 = 0
  var n: U32 = 0
  // 5 ..= 2 is empty (S-219); the ends run in the order of §3.5: the log is 52.
  for _ in tick(inout log, 5) ..= tick(inout log, 2) {
    n = n + 1
  }
  assert n == 0
  assert log == 52
}

test "the end reads what the start changed" {
  var k: U32 = 10
  var n: U32 = 0
  // The start is evaluated first: next gives 11 and k is 11; the end reads k, 11, and the range is 11 ..= 11. The start runs once: k stays 11.
  for _ in next(inout k) ..= k {
    n = n + 1
  }
  assert n == 1
  assert k == 11
}

test "the ends of a loop in a branch that is not taken are not evaluated" {
  var log: U32 = 0
  let go = false
  if go {
    for _ in tick(inout log, 1) ..= tick(inout log, 2) {
      log = log + 100
    }
  }
  assert log == 0
}

test "the ends of a loop that is left at once are evaluated before the first iteration" {
  var log: U32 = 0
  var n: U32 = 0
  // The body breaks in its first iteration; the ends were evaluated before it: the log is 12 and the body ran once.
  for _ in tick(inout log, 1) ..= tick(inout log, 2) {
    n = n + 1
    break
  }
  assert log == 12
  assert n == 1
}
