// onsa.toml
// [test]
// mode = "parse"
// spec = ["§2.1", "§18.2"]

// A doc comment before an element of a list whose first element follows its opener on the same line
// documents that element (§2.1), and `onsa fmt` keeps it on its own line before the element: it does
// not move it to the end of a line, where it would document nothing (E0004) or another declaration
// (§18.2: fmt does not change the program). W3-04/b 2.

pub struct S { a: I32,
               /// The second field.
               b: I32 }

pub enum E { A,
             /// The second variant.
             B }

pub flow f(x: F32 at sample,
           /// The second input.
           y: F32 at sample) -> F32 at sample { x + y }
