// onsa.toml
// [test]
// spec = ["§2.4", "§2.5"]

// The holes of an interpolation whose tuple index is written right keep their reading (spec §2.4; R-290, S-508): the
// index of `0` (`{t.0}`), an index with no leading `0` (`{t.1}`, `{t.10}`), an index after an index (`{t.0.1}`) or a field
// (`{p.pair.1}`), and a field (`{p.x}`). They are the part of the rule of a hole that already works, which a change of
// how the index of a hole is read (the leading `0`, the size) must keep. No error is expected.

pub struct P {
  x: I32,
  pair: (I32, I32),
}

pub fn index_zero(t: (I32, I32)) -> Str uses {Alloc} {
  "{t.0}"
}

pub fn index_one(t: (I32, I32)) -> Str uses {Alloc} {
  "{t.1}"
}

pub fn both(t: (I32, I32)) -> Str uses {Alloc} {
  "{t.0}/{t.1}"
}

pub fn index_ten(t: (I32, I32, I32, I32, I32, I32, I32, I32, I32, I32, I32)) -> Str uses {Alloc} {
  "{t.10}"
}

pub fn after_an_index(t: ((I32, I32), I32)) -> Str uses {Alloc} {
  "{t.0.1}"
}

pub fn through_a_field(p: P) -> Str uses {Alloc} {
  "{p.pair.1} {p.x}"
}

pub fn a_field(p: P) -> Str uses {Alloc} {
  "{p.x}"
}
