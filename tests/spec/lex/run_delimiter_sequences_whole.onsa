// onsa.toml
// [test]
// fixes = 0
// spec = ["§2.4", "§18.1"]

// E0002 in the lexical stage for a run of names, literals and delimiters of other languages that follow one
// another with no space between them and hold at least one delimiter (spec §2.4; S-856, S-458, S-468, S-858;
// the row `string_delimiter` of spec/foreign-forms.toml). The run is one form: `r"""x"""` is one error that
// starts at `r` (not a name and then a delimiter), `"""x"""u8` and `x#"a"#y` are one error with the name
// after the delimiter, and `br#"x"#` starts at `br`. The main position is where the run starts (the marker
// gives its column) and the range is the whole run (not written here: a marker holds the line and the column
// of the main position only). The error has no candidate (fixes = 0). The opening delimiter is read as long
// as it can be: a run of `$` and `@` followed by a `"` or by three or more `"` (`$$"x"`, `$"""x"""`,
// `$$"""{{x}}"""`), a run of three or more `"` (`""""x""""`), and one or more `#` followed by a `"`
// (`##"x"##`, `r#"x"#`). The content is not read: a bad escape, a hole that cannot be written or a hole never
// closed in it is no E0001. A `$` that does not start a delimiter (`$x`, a `$` before a backtick) is E0001 as
// before (S-468). One error per declaration (P-01).
// The rest of the forms of this file are in run_delimiter_sequences.onsa.

// The right forms.
pub fn fine() -> Str {
  let a = "r#\"x\"#"
  a
}

pub fn name_triple_quotes() -> Str {
  r"""x"""                                              //~ E0002 @3
}

pub fn name_triple_quotes_f() -> Str {
  f"""x"""                                              //~ E0002 @3
}

pub fn name_triple_quotes_b() -> Str {
  b"""x"""                                              //~ E0002 @3
}

pub fn two_names_hash_quote() -> Str {
  br#"x"#                                               //~ E0002 @3
}

pub fn name_backticks() -> Str {
  f`x`                                                  //~ E0002 @3
}

pub fn name_dollar_quote() -> Str {
  x$"a"                                                 //~ E0002 @3
}

pub fn name_hash_quote_name() -> Str {
  x#"a"#y                                               //~ E0002 @3
}

pub fn name_triple_quotes_name() -> Str {
  x"""a"""y                                             //~ E0002 @3
}

pub fn name_backticks_name() -> Str {
  x`a`y                                                 //~ E0002 @3
}

pub fn two_delimiters_with_a_name() -> Str {
  r"""a"""x"""b"""                                      //~ E0002 @3
}

pub fn two_dollars_quote() -> Str {
  $$"x"                                                 //~ E0002 @3
}

pub fn two_dollars_triple_quotes() -> Str {
  $$"""{{x}}"""                                         //~ E0002 @3
}

pub fn three_dollars_quote() -> Str {
  $$$"x"                                                //~ E0002 @3
}

pub fn dollar_at_dollar_quote() -> Str {
  $@$"x"                                                //~ E0002 @3
}

pub fn two_dollars_quote_with_holes() -> Str {
  $$"a{{x}}b{y}"                                        //~ E0002 @3
}

pub fn bad_escape_and_hole_in_triple_quotes() -> Str {
  r"""\q {f(x)} {"""                                    //~ E0002 @3
}

pub fn bad_hole_after_a_name_and_a_dollar() -> Str {
  x$"{1+2}"y                                            //~ E0002 @3
}

pub fn bad_unicode_escape_in_two_dollars() -> Str {
  $$"\u{110000}"                                        //~ E0002 @3
}

pub fn character_that_cannot_be_written_in_a_delimiter() -> Str {
  r"""a b"""                                            //~ E0002 @3
}
