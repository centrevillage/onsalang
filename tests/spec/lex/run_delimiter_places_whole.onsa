// onsa.toml
// [test]
// fixes = 0
// spec = ["§2.4", "§18.1"]

// E0002 in the lexical stage for a run that holds a delimiter of another language (spec §2.4; S-856, S-458,
// S-468) in the places where a literal stands: an argument, an element, a field, the value of an arm, a
// closure body, a block in a block, an attribute, a return, a flow, a `par` body, a constant, a generic
// function and a method. The run is one form wherever it stands: `r"""x"""` starts at `r` and `$$"x"` at the
// first `$`, the marker gives that column, and there is no candidate. One error per declaration (P-01).
// The rest of the forms of this file are in run_delimiter_places.onsa.

pub struct Label {
  text: Str,
}

fn show(s: Str) -> U32 {
  s.len()
}

fn pair(a: Str, b: Str) -> U32 {
  1
}

pub struct Gain {
  g: F32,
}

// The right forms.
pub fn fine(x: I32) -> U32 uses {Alloc} {
  let a = "{x}"
  show(a)
}

pub fn in_an_argument() -> U32 {
  show(r"""x""")                                        //~ E0002 @8
}

pub fn in_the_first_of_two_arguments() -> U32 {
  pair(r"""x""", "b")                                   //~ E0002 @8
}

pub fn in_the_second_of_two_arguments() -> U32 {
  pair("a", r"""x""")                                   //~ E0002 @13
}

pub fn in_an_array() -> U32 {
  let xs = ["a", br#"x"#]                               //~ E0002 @18
  xs.len()
}

pub fn in_a_tuple() -> U32 {
  let t = (1, r"""x""")                                 //~ E0002 @15
  1
}

pub fn in_a_field() -> Label {
  Label { text: r"""x""" }                              //~ E0002 @17
}

pub fn in_an_arm(o: Option[I32]) -> U32 {
  match o {
    Some(_) => show(r"""x"""),                          //~ E0002 @21
    None => 0,
  }
}

pub fn as_the_value_of_an_arm(o: Option[I32]) -> Str {
  match o {
    Some(_) => r"""x""",                                //~ E0002 @16
    None => "b",
  }
}

pub fn in_a_closure_body() -> U32 {
  let f = fn(y: I32) -> U32 { show(r"""x""") }          //~ E0002 @36
  f.(1)
}

pub fn in_a_block_in_a_block() -> U32 {
  let r: U32 = {
    let s: U32 = {
      show(r"""x""")                                    //~ E0002 @12
    }
    s
  }
  r
}

pub fn in_a_branch(c: Bool) -> Str {
  if c { r"""x""" } else { "b" }                        //~ E0002 @10
}

pub fn after_a_return() -> Str {
  return r"""x"""                                       //~ E0002 @10
}

pub fn as_a_receiver() -> U32 {
  r"""x""".len()                                        //~ E0002 @3
}

pub fn in_a_generic_function[T](x: T) -> T {
  let s = r"""x"""                                      //~ E0002 @11
  x
}

impl Gain {
  pub fn label(self) -> Str {
    r"""x"""                                            //~ E0002 @5
  }
}

pub flow in_a_flow(x: F32 at sample) -> F32 at sample {
  let s = r"""x"""                                      //~ E0002 @11
  x
}

pub flow in_a_par(x: F32 at sample) -> [F32; 2] at sample {
  par~ i in 0..<2 {
    let s = r"""x"""                                    //~ E0002 @13
    x
  }
}

const IN_A_CONST: Str = r"""x"""                        //~ E0002 @25

pub fn two_dollars_in_an_argument() -> U32 {
  show($$"x")                                           //~ E0002 @8
}

pub fn two_dollars_in_an_array() -> U32 {
  let xs = ["a", $$"""{{x}}"""]                         //~ E0002 @18
  xs.len()
}

pub fn four_quotes_in_a_closure_body() -> U32 {
  let f = fn(y: I32) -> U32 { show(""""x"""") }         //~ E0002 @36
  f.(1)
}

pub fn hash_quote_names_in_an_array() -> U32 {
  let xs = ["a", x#"b"#y]                               //~ E0002 @18
  xs.len()
}

@fp(r"""x""")                                           //~ E0002 @5
pub fn in_an_attribute() -> U32 {
  1
}

@derive($$"x")                                          //~ E0002 @9
pub struct InADerive {
  a: I32,
}
