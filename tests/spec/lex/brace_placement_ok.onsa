// onsa.toml
// [test]
// spec = ["§2.5", "§4.4", "§7", "§8.1"]

// The right forms of the placement of the `{` and of `else if` (spec §2.5, S-413, S-414, S-415): the counterparts of
// tests/spec/fixes/e0003_struct_literal_brace.onsa, e0003_struct_pattern_brace.onsa, e0003_uses_brace.onsa,
// e0003_else_if_line.onsa and e0003_decl_body_brace.onsa. The `{` of a struct literal, of a struct pattern, of an
// effect row `uses {…}` and of the body of a `struct` and an `enum` is on the line of the name (or of the `]` of its type
// parameters, or of the `uses`), and `else if` is on one line; what is inside the braces may take as many lines as it
// likes, in a pair of brackets and in a list of arms too.

pub struct Pt {
  x: I32,
  y: I32,
}

pub struct Pair[A, B] {
  a: A,
  b: B,
}

pub struct Wrap {
  inner: Pt,
  k: I32,
}

pub enum Shape {
  Dot,
  Line(I32),
  Rect(I32, I32),
}

pub struct Holder {
  run: fn(I32) -> I32 uses {Alloc},
}

pub fn px(p: Pt, k: I32) -> I32 {
  p.x + k
}

pub fn literals(a: I32) -> I32 {
  let one = Pt { x: a, y: 2 }

  let two = Wrap {
    inner: Pt {
      x: 1,
      y: 2,
    },
    k: 3,
  }

  let three = Pair {
    a: 1,
    b: 2,
  }
  px(Pt { x: a, y: 2 }, 3) + px(Pt {
    x: 10,
    y: 20,
  }, 4) + one.y + two.inner.x + two.k + three.b
}

pub fn patterns(p: Pt, w: Wrap, o: Option[Pt]) -> I32 {
  let Pt { x: a, y: b } = p

  let Wrap { inner: Pt { x: c, y: _ }, k: d } = w

  let e = match o {
    Some(Pt { x: m, y: _ }) => m,
    None => 0,
  }
  let f = match p {
    Pt { x: 0, y: _ } => 100,
    Pt { x: _, y: 0 } | Pt { x: 1, y: _ } => 200,
    Pt { x: _, y: _ } => 300,
  }
  a + b + c + d + e + f
}

pub fn chain(c: Bool, d: Bool, e: Bool) -> I32 {
  let a = if c { 1 } else if d { 2 } else { 3 }
  let b = if c {
    10
  } else if d {
    20
  } else if e {
    30
  } else {
    40
  }
  a + b
}

pub fn rows(f: fn(I32) -> I32 uses {Alloc}, x: I32) -> I32 uses {Alloc} {
  f.(x)
}

pub fn shapes(s: Shape) -> I32 {
  match s {
    Shape.Dot => 0,
    Shape.Line(n) => n,
    Shape.Rect(w, h) => w * h,
  }
}
