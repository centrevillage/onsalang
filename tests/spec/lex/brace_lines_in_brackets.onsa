// onsa.toml
// [test]
// spec = ["§2.5", "§4.4", "§7", "§8.1"]
// canonical = false

// What may stand on the lines after the `{` (spec §2.5, S-413): the `{` of a struct literal, of a struct pattern and
// of an effect row is on the line of the name (or of the `uses`), and the fields, the sub-patterns and the effects may be on
// lines of their own, with comments between, a blank line, and a `,` after the last one, in a pair of brackets, in a
// list of arms and outside them. (`onsa fmt` joins what fits on a line, docs/onsa-tools.md §3.2, so the case says
// `canonical = false`.)

pub struct Pt {
  x: I32,
  y: I32,
}

pub struct Wrap {
  inner: Pt,
  k: I32,
}

pub fn px(p: Pt, k: I32) -> I32 {
  p.x + k
}

pub fn literal_in_a_call(a: I32) -> I32 {
  px(Pt {
    // the fields
    x: a,

    y: 2,
  }, 3)
}

pub fn literal_in_an_array(a: I32) -> U32 {
  let v = [Pt {
    x: a,
    y: 2,
  }, Pt {
    x: 3,
    y: 4,
  }]
  v.len()
}

pub fn literal_in_a_tuple(a: I32) -> I32 {
  let t = (Pt {
    x: a,
    y: 2,
  }, 3)
  t.1
}

pub fn literal_in_a_field(a: I32) -> I32 {
  let w = Wrap {
    inner: Pt {
      x: a,
      y: 2,
    },
    k: 3,
  }
  w.k
}

pub fn pattern_in_a_let(p: Pt) -> I32 {
  let Pt {
    x: a,
    y: b,
  } = p
  a + b
}

pub fn pattern_in_an_arm(p: Pt) -> I32 {
  match p {
    Pt {
      x: 0,
      y: _,
    } => 1,
    Pt {
      // the second field is not looked at
      x: a,
      y: _,
    } => a,
  }
}

pub fn pattern_in_a_variant(o: Option[Pt]) -> I32 {
  match o {
    Some(Pt {
      x: a,
      y: _,
    }) => a,
    None => 0,
  }
}

pub fn row_in_a_function_type(f: fn(I32) -> I32 uses {
  Alloc
}, x: I32) -> I32 uses {
  Alloc
} {
  f.(x)
}

pub struct Holder {
  run: fn(I32) -> I32 uses {
    Alloc
  },
}
