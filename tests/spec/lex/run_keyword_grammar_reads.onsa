// onsa.toml
// [test]
// canonical = false
// fixes = 0
// spec = ["§2.4", "§18.2"]

// A literal that touches a keyword is read where the grammar reads it, with no error (spec §2.4; S-856,
// S-474): the keywords, `_`, `true`, `false` and the numbers are not names, so they make no run with the
// literal. `return"a"`, `if"a" == s`, `else if"a" == s`, `assert"a" == s`, `test"a" {`, and a literal that is
// a pattern followed by the `if` of a guard (`"a"if g =>`, `'a'if g =>`) are read as if the space were
// there, and `onsa fmt` puts it. The file is not canonical on purpose (`canonical = false`); that fmt puts
// the space is in the CLI tests. A place where the grammar cannot read the keyword and the literal together
// is in run_keyword_comma.onsa (the general rule of §2.5) and run_keyword_types.onsa (a place that reads and
// then a type error).

pub fn returns_a_literal() -> Str {
  return"a"
}

pub fn compares_in_an_if(s: Str) -> I32 {
  if"a" == s { 1 } else { 2 }
}

pub fn compares_in_an_else_if(s: Str) -> I32 {
  if s == "b" { 1 } else if"a" == s { 2 } else { 3 }
}

pub fn asserts_a_comparison(s: Str) {
  assert"a" == s
}

pub fn guards_a_string(s: Str, g: Bool) -> I32 {
  match s {
    "a"if g => 1,
    _ => 0,
  }
}

pub fn guards_a_character(c: Char, g: Bool) -> I32 {
  match c {
    'a'if g => 1,
    _ => 0,
  }
}

test"a literal after the keyword" {
  assert true
}
