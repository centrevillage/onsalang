// onsa.toml
// [test]
// spec = ["§2.2", "§2.3", "§2.1", "§2.4"]

// (S-615.) `static` is a reserved word (§2.2), but a name that only starts with, ends with or contains it is an
// ordinary name: the lexer reads the longest run of name characters and then decides if it is a keyword.
// The word inside a string and inside a comment is text. The names in the places a declaration has
// (a field, a parameter, a binding, a constant, a function, a type) are all fine. The case is the same
// as lex/ident_ascii_ok.onsa for `clock` and `ser`.

pub struct StaticNames {
  static_rate: F32,
  statics: I32,
  is_static: I32,
  my_static_x: I32,
  staticx: I32,
}

pub struct StaticRate {
  v: I32,
}

pub const STATIC_LEN: U32 = 4

pub fn static_rate(x: I32) -> I32 {
  x
}

pub fn statics_of(is_static: I32, statics: I32) -> I32 {
  let my_static_x = statics
  let staticx     = is_static
  let _           = (my_static_x, staticx)
  static_rate(is_static)
}

pub fn the_word_in_a_string() -> Str {
  // static is text in a comment
  "static"
}
