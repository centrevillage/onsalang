// onsa.toml
// [test]
// spec = ["§2.5", "§2.6", "§11.5"]

// The right form of tests/spec/fixes/e0020_newline_if_tilde.onsa (moved from that file, W3-06): the `~` of
// `if~` is written right after the keyword inside parentheses too (§2.5, §2.6, S-385), and the
// syntax stage reports nothing. The `if~` holds a thing with state in a branch, so it is no E0812 either (§11.5, W7-06 U2); the
// `match~` of the same form is in lex/match_tilde_newline_ok.onsa (W7-06 U3a).

pub rt fn two(a: F32, b: F32) -> F32 {
  a + b
}

pub flow acc(x: F32 at sample) -> F32 at sample {
  let y = x + prev~(^y)
  y
}

pub flow fine(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  two(if~ c { acc~(x) } else { 2.0 }, 1.0)
}
