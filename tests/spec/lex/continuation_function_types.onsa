// onsa.toml
// [test]
// spec = ["§2.5", "§4.1"]
// canonical = false

// `canonical = false`: `onsa fmt` is free to join or move the breaks of this file (docs/onsa-tools.md §3.2,
// decided in W3-11); the case is about what the parser accepts.

// A line that ends with `->` goes on, in a function head, in a function type, in a type alias and in the
// annotation of a `let` (R-58, S-47, S-374): the case of tests/review-phase1/syntax/arrow.onsa, which was
// an E0002 at the end of the line in the head, in the alias and in the annotation, because the rule
// held in a block and not at the top level. A `type` goes on after its `=` too. The case is checked and not
// run: a function value is not lowered in this version (E0200 of `onsa test`, not of `onsa check`).

pub fn f(x: I32) ->
  I32 {
  x
}

type Alias =
  I32

type Op =
  fn(I32) ->
    I32

pub fn g() -> I32 {
  let h: fn(I32) ->
    I32 = f
  h.(1)
}

// In the brackets of a head, where a line break is a blank, the `->` of a function type is at the end
// of the line too (the start of a line is E0020, tests/spec/fixes/e0020_leading_arrow_assign.onsa).
pub fn take(h: fn(I32) ->
    I32, x: I32) -> I32 {
  x
}

pub fn take_alias(h: Op, x: Alias) ->
  Alias {
  x
}

pub fn return_type_of_a_closure() -> I32 {
  let h = fn(x: I32) ->
    I32 { x }
  1
}

pub flow flow_head(x: F32 at sample) ->
  F32 at sample {
  x
}

pub struct Pt {
  x: I32,
  y: I32,
}

impl Pt {
  pub fn norm1(self) ->
    I32 {
    self.x + self.y
  }
}

// A generic head goes on in the same way.
pub fn clamp[T: PartialOrd](x: T, lo: T, hi: T) ->
  T {
  if x <
    lo {
    lo
  } else if x >
    hi {
    hi
  } else {
    x
  }
}
