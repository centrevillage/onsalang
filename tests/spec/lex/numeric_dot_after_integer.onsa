// onsa.toml
// [test]
// mode = "parse"
// spec = ["§2.4", "§6.1", "§7", "§18.1"]

// What the syntax accepts after the digits of an integer when a `.` follows (spec §2.4, §6.1; S-350): after
// the digits of an integer a `.` is a point when digits follow it (`1.5`), the member's `.` when a name or `(`
// follows (`1.abs()`, `1.(x)`), the form `1.e3` (E0020, fixes/e0020_numeric_float_forms.onsa) when `e` or `E`
// and digits follow, and the `1.` of E0020 in every other case. The file is read as syntax only
// (`mode = "parse"`): the type stage rejects a method or a call on a literal whose type is open (`1.abs()` is
// E0420 by §4.7; `1.(x)` calls an integer, which the type stage rejects, with a code that W4 / W5 fix), so
// the lines below have no meaning to run; they say only that the syntax reads them and gives no error of E00xx
// or E0020. A `.` after a hexadecimal or binary number is always the member's (those numbers have no point).
// `..<` and `..=` after the digits are the range, not a point. A tuple index chain (`t.0.1`) reads `0` and
// `1` as indexes, as before.

pub fn member_names(x: I32, f: fn(I32) -> I32, t: ((I32, I32), I32)) -> I32 {
  let a = 1.abs()
  let b = 1.max(2)
  let c = 1.exp()
  let d = 1.e()
  let e = 1_000.abs()
  let g = 1.5.abs()
  let h = 1.5e3.abs()
  let i = 48e3.abs()
  let j = t.0.1
  let k = t.0.0
  let l = 0.abs()
  a
}

pub fn member_calls(x: I32, f: fn(I32) -> I32) -> I32 {
  let a = 1.(x)
  let b = 0.(x)
  let c = 1_000.(x)
  let d = 1.(x, x)
  let e = 1.()
  a
}

pub fn hexadecimal_and_binary(x: I32) -> I32 {
  let a = 0x1F.abs()
  let b = 0x1F.(x)
  let c = 0b11.abs()
  let d = 0b11.(x)
  let e = 0xFF.abs()
  a
}

pub fn ranges(n: I32) -> I32 {
  var s: I32 = 0
  for i in 1..<3 {
    s = s + i
  }
  for i in 0..=n {
    s = s + i
  }
  for i in 1..<n {
    s = s + i
  }
  for i in 0x1..<0x3 {
    s = s + i
  }
  for i in 1_0..<1_2 {
    s = s + i
  }
  s
}

pub fn floats(x: F32) -> F32 {
  let a = 1.0
  let b = 0.5
  let c = 1.5e3
  let d = 48e3
  let e = 1e-6
  let f = 1.0 + x
  x * 2.5
}
