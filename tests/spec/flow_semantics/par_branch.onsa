// onsa.toml
// [test]
// mode = "test"
// spec = ["§11.5", "§11.4"]

// `par i in a..b { e }` (spec §11.5): `e` is replicated N = b - a times; the index `i` is the value
// a, a+1, ..., b-1 of the init clock; the result has type [T; N]; every flow call and every delay
// in `e` is a separate instance in each replica. `par` is a replication of structure, not a loop:
// a delay's `^name` inside the body still means the later `let` of the same sample.
//
// A branch that runs every replica's instance.

pub flow acc(x: F32 at sample) -> F32 at sample {
  let y = x + prev~(^y)
  y
}

// A branch that runs every replica's instance.
pub flow counted_above(x: F32 at sample) -> [F32; 2] at sample {
  par i in 0..2 { if~ x > i.round_f32() { acc~(1.0) } else { 0.0 } }
}

test "if~ inside a par runs every replica's instance" {
  // x = 0.5 1.5 2.5.  Replica 0 chooses when x > 0: T T T.  Replica 1 when x > 1: F T T.
  // Each counter runs every sample: 1 2 3.  Chosen: replica 0: 1 2 3.  replica 1: 0 2 3.
  let xs: [F32; 3] = [0.5, 1.5, 2.5]
  let o = counted_above.render(counted_above.Config {}, counted_above.Params {}, xs, 8.0)
  assert o.out[0][0] == 1.0
  assert o.out[0][1] == 2.0
  assert o.out[0][2] == 3.0
  assert o.out[1][0] == 0.0
  assert o.out[1][1] == 2.0
  assert o.out[1][2] == 3.0
}
