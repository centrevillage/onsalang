// onsa.toml
// [package]
// name = "poison_boundary"
// edition = "2026"
//
// [export]
// prefix = "pb_"
// flows = ["poison_boundary.boom", "poison_boundary.init_boom"]
//
// [targets.poison]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "poison"
// provides = []
//
// [test]
// mode = "test"
// spec = ["§9.2", "§14.2", "§11.6", "§15.3"]
//
// # Host script 1 (target `poison`), steps 1-3 and 7-9: the panic at sample 1 aborts the call, the
// # whole output of the call is zero-filled (also sample 0, computed before the panic), and the
// # instance is poisoned; reset recovers it, and the counter starts again from 1.
// [[test.host]]
// name = "boom panics, is zero-filled and recovers by reset"
// target = "poison"
// flow = "poison_boundary.boom"
// steps = [
//   { call = "init", config = {}, sample_rate = 8.0, status = 0 },
//   { call = "process", params = {}, frames = 3, input = [1.5, 2.5, 3.5], status = 0, output = [2.0, 4.0, 6.0] },
//   { call = "process", params = {}, frames = 3, input = [1.0, nan, 3.0], status = 1, output = [0.0, 0.0, 0.0] },
//   { call = "reset" },
//   { call = "process", params = {}, frames = 3, input = [1.5, 2.5, 3.5], status = 0, output = [2.0, 4.0, 6.0] },
//   { call = "process", params = {}, frames = 3, input = [1.0, nan, 3.0], status = 1, output = [0.0, 0.0, 0.0] },
//   { call = "reset" },
//   { call = "process", params = {}, frames = 3, input = [1.5, 2.5, 3.5], status = 0, output = [2.0, 4.0, 6.0] },
// ]
//
// # Host script 1, steps 1-6: a poisoned instance outputs silence whatever the input and whatever
// # the buffer holds: a buffer the step does not fill, the in-place buffer holding the input, old
// # contents (R-12: the input used to pass through, old contents used to remain).
// [[test.host]]
// name = "boom poisoned outputs silence"
// target = "poison"
// flow = "poison_boundary.boom"
// steps = [
//   { call = "init", config = {}, sample_rate = 8.0, status = 0 },
//   { call = "process", params = {}, frames = 3, input = [1.5, 2.5, 3.5], status = 0, output = [2.0, 4.0, 6.0] },
//   { call = "process", params = {}, frames = 3, input = [1.0, nan, 3.0], status = 1, output = [0.0, 0.0, 0.0] },
//   { call = "process", params = {}, frames = 3, input = [1.0, 2.0, 3.0], status = 1, output = [0.0, 0.0, 0.0] },
//   { call = "process", params = {}, frames = 3, input = [5.0, 6.0, 7.0], inplace = true, status = 1, output = [0.0, 0.0, 0.0] },
//   { call = "process", params = {}, frames = 3, input = [1.0, 2.0, 3.0], fill = [9.0, 9.0, 9.0], status = 1, output = [0.0, 0.0, 0.0] },
// ]
//
// # Host script 2, steps 1, 5 and 6: the panic in init aborts it, and only init recovers the
// # instance (100 / 4 = 25 is added to x).
// [[test.host]]
// name = "init_boom recovers by init"
// target = "poison"
// flow = "poison_boundary.init_boom"
// steps = [
//   { call = "init", config = { n = 0 }, sample_rate = 8.0, status = 1 },
//   { call = "init", config = { n = 4 }, sample_rate = 8.0, status = 0 },
//   { call = "process", params = {}, frames = 3, input = [1.0, 2.0, 3.0], status = 0, output = [26.0, 27.0, 28.0] },
// ]
//
// # Host script 2, steps 1-4: an uninitialized instance zero-fills its output and returns 1, and
// # reset does nothing for it (R-12).
// [[test.host]]
// name = "init_boom uninitialized outputs silence"
// target = "poison"
// flow = "poison_boundary.init_boom"
// steps = [
//   { call = "init", config = { n = 0 }, sample_rate = 8.0, status = 1 },
//   { call = "process", params = {}, frames = 3, input = [1.0, 2.0, 3.0], status = 1, output = [0.0, 0.0, 0.0] },
//   { call = "reset" },
//   { call = "process", params = {}, frames = 3, input = [1.0, 2.0, 3.0], status = 1, output = [0.0, 0.0, 0.0] },
// ]

// A flow that panics at an export boundary (spec §9.2, §14.2). Two things are tested here.
//
// 1. In Onsa (the `test` blocks below, run by the interpreter): a panic in `process` or `init`
//    propagates to the nearest boundary, which for a `test` is the test itself, so the test fails
//    (`TESTFAIL`, §9.2 "Onsa の中から呼ばれた関数" and "テスト").
//
// 2. At the exported C boundary of the target `poison` (`panic = "poison"`): the host sequences of
//    the fragment ([[test.host]]). The expectations come from §9.2 ("その呼び出しを中断し、その呼び出し
//    の出力を全て…ゼロで埋め、インスタンスを poisoned にする。以後の process は無音を出力し、reset まで
//    復帰しない。C API は戻り値で通知する") and §14.2 (the status `int`: 0 ok, 1 panic; an
//    uninitialized instance zero-fills and returns 1, `reset` does nothing for it, and only `init`
//    recovers it).

/// A counter plus the truncated input. `trunc_i32` panics for NaN and for values outside I32.
pub flow boom(x: F32 at sample) -> F32 at sample {
  let n = x.trunc_i32()
  let c = acc~(1.0)
  c + n.round_f32()
}

pub flow acc(x: F32 at sample) -> F32 at sample {
  let y = x + prev~(^y)
  y
}

/// `100 / n` is computed once at init: n = 0 panics inside `init`.
/// (Not `boom_init`: `pb_boom_init` is a name the flow `boom` generates, spec §14.2, E1011.)
pub flow init_boom(x: F32 at sample, n: I32 at init) -> F32 at sample {
  let k = 100 / n
  x + k.round_f32()
}

test "boom adds a counter to the truncated input" {
  // counter 1 2 3; trunc_i32 of 1.5 2.5 3.5 is 1 2 3.
  let xs: [F32; 3] = [1.5, 2.5, 3.5]
  let o = boom.render(boom.Config {}, boom.Params {}, xs, 8.0)
  assert o.out[0] == 2.0
  assert o.out[1] == 4.0
  assert o.out[2] == 6.0
}

test "a NaN input panics in process and fails the test" {   //~ TESTFAIL "a NaN input panics in process and fails the test"
  let xs: [F32; 3] = [1.0, F32.NAN, 3.0]
  let o = boom.render(boom.Config {}, boom.Params {}, xs, 8.0)
  assert o.out[0] == 2.0
}

test "an input outside I32 panics in process and fails the test" {   //~ TESTFAIL "an input outside I32 panics in process and fails the test"
  let xs: [F32; 2] = [1.0, 3.0e9]
  let o = boom.render(boom.Config {}, boom.Params {}, xs, 8.0)
  assert o.out[0] == 2.0
}

test "init_boom adds 100 / n to the input" {
  // 100 / 4 = 25.
  let xs: [F32; 3] = [1.0, 2.0, 3.0]
  let o = init_boom.render(init_boom.Config { n: 4 }, init_boom.Params {}, xs, 8.0)
  assert o.out[0] == 26.0
  assert o.out[1] == 27.0
  assert o.out[2] == 28.0
}

test "a panic in init fails the test" {   //~ TESTFAIL "a panic in init fails the test"
  var st = init_boom.init(init_boom.Config { n: 0 }, 8.0)
  init_boom.reset(inout st)
}

test "a panic in process through an explicit state fails the test" {   //~ TESTFAIL "a panic in process through an explicit state fails the test"
  let xs: [F32; 3] = [1.0, F32.NAN, 3.0]
  var out: [F32; 3] = [0.0; 3]
  var st = boom.init(boom.Config {}, 8.0)
  boom.process(inout st, boom.Params {}, xs, inout out)
  assert out[0] == 2.0
}
