// onsa.toml
// [test]
// mode = "test"
// spec = ["§11.5", "§11.4", "§13.4"]

// `par i in a..b { e }` (spec §11.5): `e` is replicated N = b - a times; the index `i` is the value
// a, a+1, ..., b-1 of the init clock; the result has type [T; N]; every flow call and every delay
// in `e` is a separate instance in each replica. `par` is a replication of structure, not a loop:
// a delay's `^name` inside the body still means the later `let` of the same sample.
//
// Needs `std.math.sum` (§13.4).

use std.math.{sum}

// Three replicas, each with its own delay: (1 + 2 + 3) * x[n-1].
pub flow three_delays(x: F32 at sample) -> F32 at sample {
  let a = par i in 0..3 { prev~(x * (i + 1).round_f32()) }
  sum(a)
}

// par inside par: the multipliers are 1, 2 (i = 0) and 3, 4 (i = 1); the sum is 10.
pub flow nested(x: F32 at sample) -> F32 at sample {
  let rows = par i in 0..2 {
    sum(par j in 0..2 { prev~(x * (2 * i + j + 1).round_f32()) })
  }
  sum(rows)
}

test "each replica has its own delay" {
  // multipliers 1 + 2 + 3 = 6; out = 6 * x[n-1].
  let xs: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  let o = three_delays.render(three_delays.Config {}, three_delays.Params {}, xs, 8.0)
  assert o.out[0] == 0.0
  assert o.out[1] == 6.0
  assert o.out[2] == 12.0
  assert o.out[3] == 18.0
}

test "par inside par" {
  // 10 * x[n-1].
  let xs: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  let o = nested.render(nested.Config {}, nested.Params {}, xs, 8.0)
  assert o.out[0] == 0.0
  assert o.out[1] == 10.0
  assert o.out[2] == 20.0
  assert o.out[3] == 30.0
}
