// onsa.toml
// [test]
// mode = "test"
// spec = ["§11.3", "§11.5", "§11.6", "§9.2"]

// W7-05 U3/t, S-1157, S-1140 (spec §11.3, §11.6): what holds with the parts of the body of a `par~` hoisted or not (the panics where the part is reached, and the values), the companion of hoist_par_panic_stage.onsa
// (the panics of the stage of a part of `block` or `init`, which the hoisting of the body moves before the frames). A condition of `sample` leaves the part where it is reached ("条件のどれかが `init`・`block` より後の段（イベント、`sample / N`、`sample`）で決まるなら巻き上げず、
// 評価が届いたときに評価する"): a call of 0 frames and a frame that does not take the branch do not panic, the frame that takes it does. The argument of an instance in the body is evaluated at the `block` stage of the instance
// (it is an input of `block` of the child), so a part of it panics in a call of 0 frames; the whole `par~` that is a part of `block` is made at `block` as a whole (the hoisting of W7-05 U1). A condition that does not hold
// makes nothing. `x` is the `sample` input, `d` and `n` of `block`; the values are `U32` and worked out by hand (d = 3: `100 / 3` is 33, 100 / 2 is 50, 100 / 1 is 100). These tests pass before and after the hoisting of the body.

pub rt fn pair_sum(xs: [F32; 2]) -> F32 {
  xs[0] + xs[1]
}

pub flow gain(x: F32 at sample, g: F32 at block) -> F32 at sample {
  x * g
}

pub flow block_reads_i(x: F32 at sample, d: U32 at block) -> F32 at sample {
  let ys = par i in 0 ..< 2 { x * F32.round_from(100 / (d - i)) }
  ys[0] + ys[1]
}

pub flow instance_argument(x: F32 at sample, d: U32 at block) -> F32 at sample {
  let ys = par~ i in 0 ..< 2 { gain~(x, F32.round_from(100 / (d - i))) }
  ys[0] + ys[1]
}

pub flow block_guard(x: F32 at sample, n: U32 at block) -> F32 at sample {
  let ys = par i in 0 ..< 2 { if n != 0 { x * F32.round_from(100 / (n - i)) } else { x } }
  ys[0] + ys[1]
}

pub flow sample_guard(x: F32 at sample, d: U32 at block) -> F32 at sample {
  let ys = par i in 0 ..< 2 { if x > 0.0 { x * F32.round_from(100 / (d - i)) } else { x } }
  ys[0] + ys[1]
}

pub flow whole_par_of_block(x: F32 at sample, d: U32 at block) -> F32 at sample {
  x * pair_sum(par i in 0 ..< 2 { F32.round_from(100 / (d - i)) })
}

test "the same part with d = 3: 33 + 50, and with d = 2: 50 + 100" {
  let xs: [F32; 2] = [1.0, 2.0]
  let a = block_reads_i.render(block_reads_i.Params { d: 3 }, xs, 8.0)
  assert a.out[0] == 83.0
  assert a.out[1] == 166.0
  let b = block_reads_i.render(block_reads_i.Params { d: 2 }, xs, 8.0)
  assert b.out[0] == 150.0
  assert b.out[1] == 300.0
}

test "a call of 1 frame panics at the block stage as well" {
  let xs: [F32; 1] = [1.0]
  var out: [F32; 1] = [7.0]
  var st = block_reads_i.init(8.0)
  block_reads_i.process(inout st, block_reads_i.Params { d: 1 }, xs, inout out) //~ PANIC "a call of 1 frame panics at the block stage as well"
  assert out[0] == 7.0
}

test "the argument of an instance in the body panics at the block stage, in a call of 0 frames" {
  let xs: [F32; 1] = [1.0]
  var out: [F32; 1] = [7.0]
  var st = instance_argument.init(8.0)
  instance_argument.process(inout st, instance_argument.Params { d: 3 }, xs.slice(0, 0), inout out.slice(0, 0))
  instance_argument.process(inout st, instance_argument.Params { d: 1 }, xs.slice(0, 0), inout out.slice(0, 0)) //~ PANIC "the argument of an instance in the body panics at the block stage, in a call of 0 frames"
  assert out[0] == 7.0
}

test "a condition of block that does not hold makes nothing in any replica" {
  // n = 0: x in each replica. The division by `n - i` is not made, so it does not panic for i = 1 and underflow for i = 0 and 1.
  let xs: [F32; 2] = [1.0, 2.0]
  let o = block_guard.render(block_guard.Params { n: 0 }, xs, 8.0)
  assert o.out[0] == 2.0
  assert o.out[1] == 4.0
}

test "a condition of sample: a call of 0 frames and a frame that does not take the branch do not panic" {
  // d = 1 divides by zero for i = 1, but only where x > 0.0 takes the branch. x = -1.0 gives -1 in each replica.
  let xs: [F32; 1] = [-1.0]
  var out: [F32; 1] = [7.0]
  var st = sample_guard.init(8.0)
  sample_guard.process(inout st, sample_guard.Params { d: 1 }, xs.slice(0, 0), inout out.slice(0, 0))
  assert out[0] == 7.0
  sample_guard.process(inout st, sample_guard.Params { d: 1 }, xs, inout out)
  assert out[0] == -2.0
}

test "a condition of sample: the frame that takes the branch panics, at that frame" {
  let xs: [F32; 1] = [1.0]
  var out: [F32; 1] = [7.0]
  var st = sample_guard.init(8.0)
  sample_guard.process(inout st, sample_guard.Params { d: 1 }, xs, inout out) //~ PANIC "a condition of sample: the frame that takes the branch panics, at that frame"
  assert out[0] == 7.0
}

test "the whole par~ is a part of block: it panics in a call of 0 frames in the replica that divides by zero" {
  // d = 2: (50 + 100) * x = 150 * x, no panic in a call of 0 frames; d = 1 divides by zero for i = 1.
  let xs: [F32; 1] = [2.0]
  var out: [F32; 1] = [7.0]
  var st = whole_par_of_block.init(8.0)
  whole_par_of_block.process(inout st, whole_par_of_block.Params { d: 2 }, xs.slice(0, 0), inout out.slice(0, 0))
  whole_par_of_block.process(inout st, whole_par_of_block.Params { d: 2 }, xs, inout out)
  assert out[0] == 300.0
  whole_par_of_block.process(inout st, whole_par_of_block.Params { d: 1 }, xs.slice(0, 0), inout out.slice(0, 0)) //~ PANIC "the whole par~ is a part of block: it panics in a call of 0 frames in the replica that divides by zero"
  assert out[0] == 300.0
}
