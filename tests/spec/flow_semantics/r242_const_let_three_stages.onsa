// onsa.toml
// [test]
// mode = "test"
// spec = ["§11.3", "§11.6"]

// R-242: a chain of constant `let`s (`let c = 2.0; let d = c * 3.0`) read by the three stages, an
// `init` let, a `block` let and the output of the sample clock (spec §11.3: the constant clock is
// promoted to every clock). The expected values are worked out by hand.

pub flow f(x: F32 at sample, p: F32 at block, k: F32 at init) -> F32 at sample {
  let c = 2.0
  let d = c * 3.0
  let i = k * d
  let b = p * d
  x * b * i * d
}

test "a chain of constant lets read by the init, block and sample stages" {
  // d = 6; i = 1 * 6 = 6; b = 2 * 6 = 12; x * 12 * 6 * 6 = x * 432.
  let xs: [F32; 2] = [1.0, 0.5]
  let o = f.render(f.Config { k: 1.0 }, f.Params { p: 2.0 }, xs, 8.0)
  assert o.out[0] == 432.0
  assert o.out[1] == 216.0
}
