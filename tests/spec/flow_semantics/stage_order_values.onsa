// onsa.toml
// [test]
// mode = "test"
// spec = ["§11.3", "§11.4", "§11.5", "§11.9", "§9.2"]

// W7-11 U2b/t, S-1233, S-1206, S-1159, S-1126, S-1128 (spec §11.3: the table of the order in one stage: "本体の `let` と出力の式 | 上から、最後に出力の式"; "インスタンスの呼び出し（利用者の flow。修飾子の連鎖を含み、組込みの遅延の第 1 引数の中のものとその引数も）がその段に持つ仕事 | 出力をその段で読むかによらず、
// 呼び出しを書いた位置（式の評価の順の中の位置）"; "順が見えるのは、二つの式が panic するときの報告 … だけで、イベントの無い flow の値は
// 順によらない"): the values of a flow with no event do not depend on the order inside a stage, so these cases hold before and after the lowering of the stage is written in the order of the text. They are the
// forms where a call is not at the top of a `let`: in the arm of a `match~` and in a `par~` inside the first argument of a delay, a call with an output at `sample / 4` there, children of the `init`
// and `block` stages beside a hoisted part, and children that nothing reads (their state moves all the same, seen by the panic of the division that their delay makes). Every value is worked out by hand.
// Which of two panics comes first is not here: it is in the CLI test `stage_order_commands.rs`.

// ---- a call in the arm of a `match~` in the first argument of a delay, outside and inside a `par~`

enum V {
  A(U32),
  B,
}

// n = x * p + the sum before: a counter that adds `x * p` on every sample.
flow gp(x: U32 at sample, p: U32 at block) -> U32 at sample {
  let n = x * p + prev~(^n)
  n
}

pub flow enum_arm_in_delay(k: U32 at sample, p: U32 at block) -> U32 at sample {
  let v = if k > 2 { V.A(k) } else { V.B }
  prev~(match~ v { V.A(b) => gp~(b, p), V.B => 0 })
}

pub flow enum_arm_in_delay_par(k: U32 at sample, p: U32 at block) -> U32 at sample {
  let v = if k > 2 { V.A(k) } else { V.B }
  let ys = par~ i in 0 ..< 2 { prev~(match~ v { V.A(b) => gp~(b * (i + 1), p), V.B => 0 }) }
  ys[0] + ys[1]
}

test "the arm of a match~ that calls an instance in the first argument of a delay counts on every sample, the binding of an arm not taken is 0" {
  // k = 1 3 2 5 4, p = 2: v = B, A(3), B, A(5), A(4).  The arm adds b * p with b = 0, 3, 0, 5, 4: 0 6 0 10 8, the sums 0 6 6 16 24.  The arm gives its sum where it is taken:
  // 0 6 0 16 24.  The delay gives the one before (its first value is 0): 0 0 6 0 16.
  let ks: [U32; 5] = [1, 3, 2, 5, 4]
  let o = enum_arm_in_delay.render(enum_arm_in_delay.Params { p: 2 }, ks, 8.0)
  assert o.out[0] == 0
  assert o.out[1] == 0
  assert o.out[2] == 6
  assert o.out[3] == 0
  assert o.out[4] == 16
}

test "the same in a par~: each replica has the state of its own" {
  // The replica 0 is the flow above (0 0 6 0 16).  The replica 1 adds (b * 2) * p: 0 12 0 20 16, the sums 0 12 12 32 48, the arm gives 0 12 0 32 48, delayed 0 0 12 0 32.
  // The sum of the two: 0 0 18 0 48.
  let ks: [U32; 5] = [1, 3, 2, 5, 4]
  let o = enum_arm_in_delay_par.render(enum_arm_in_delay_par.Params { p: 2 }, ks, 8.0)
  assert o.out[0] == 0
  assert o.out[1] == 0
  assert o.out[2] == 18
  assert o.out[3] == 0
  assert o.out[4] == 48
}

// ---- a `par~` and a call with an output at `sample / 4` in the first argument of a delay

flow acc(x: U32 at sample) -> U32 at sample {
  let n = x + prev~(^n)
  n
}

pub flow par_in_delay(k: U32 at sample) -> U32 at sample {
  let v = prev~(par~ i in 0 ..< 2 { acc~(k + i) })
  v[0] + v[1] * 10
}

test "a par~ in the first argument of a delay keeps a state for each replica and the delay gives the array of the sample before" {
  // k = 1 2 3 4.  The replica 0 sums k: 1 3 6 10.  The replica 1 sums k + 1: 2 5 9 14.  The delay gives [0, 0] and then the sums of the sample before.
  // The output v[0] + v[1] * 10: 0, 1 + 20, 3 + 50, 6 + 90.
  let ks: [U32; 4] = [1, 2, 3, 4]
  let o = par_in_delay.render(ks, 8.0)
  assert o.out[0] == 0
  assert o.out[1] == 21
  assert o.out[2] == 53
  assert o.out[3] == 96
}

// A counter of the ticks of `sample / 4`: `lf` is `one` of the tick before (1 at the first), the count adds it at each tick.
flow count4(one: I32 at block) -> I32 at (sample / 4) {
  let lf = prev~(one at (sample / 4), 1)
  let cnt = prev~(^cnt) + lf
  cnt
}

pub flow delayed_slow_call(one: I32 at block) -> I32 at sample {
  let d = prev~(count4~(one))
  d at sample
}

test "a call with an output at sample / 4 in the first argument of a delay is delayed by a tick of sample / 4 and read held" {
  // one = 1: the counts of the ticks (the frames 0, 4, 8) are 1 2 3.  The delay of the tick gives 0 (its first value), 1, 2, held for 4 frames each.
  let o = delayed_slow_call.render(delayed_slow_call.Params { one: 1 }, 12, 8.0)
  assert o.out[0] == 0
  assert o.out[3] == 0
  assert o.out[4] == 1
  assert o.out[7] == 1
  assert o.out[8] == 2
  assert o.out[11] == 2
}

// ---- children of the `init` and `block` stages beside a hoisted part

flow gain_i(c: I32 at init) -> I32 at sample {
  (c * 10) at sample
}

flow acc_b(p: I32 at block) -> I32 at sample {
  let n = p + prev~(^n)
  n
}

pub flow init_and_block_children(c: I32 at init, p: I32 at block) -> I32 at sample {
  let a = gain_i~(c)
  let k = acc_b~(p)
  let m = k * (300 / p)
  a + m
}

test "a child of the init stage and a child of the block stage with a hoisted block part below them" {
  // c = 3, p = 4: the first child is 30 on every frame.  The second sums p: 4 8 12.  The part `300 / p` is 75 (once for the block): m = 300 600 900.  Output 330 630 930.
  let o = init_and_block_children.render(init_and_block_children.Config { c: 3 }, init_and_block_children.Params { p: 4 }, 3, 8.0)
  assert o.out[0] == 330
  assert o.out[1] == 630
  assert o.out[2] == 930
}

// ---- a child and a `let` that nothing reads: their state moves, seen by the delay that their division makes

flow div_prev(p: I32 at block) -> I32 at sample {
  let d = prev~(p at sample, 1)
  let q = 100 / d
  q
}

flow div_prev4(p: I32 at block) -> I32 at sample {
  let d = prev~(p at (sample / 4), 1)
  let q = 100 / d
  q at sample
}

// `d` is the `p` of the sample before (1 at the first): the child divides by it, unread, and the output is 7.
pub flow unread_child(p: I32 at block) -> I32 at sample {
  let _ = div_prev~(p)
  7
}

pub flow unread_let(p: I32 at block) -> I32 at sample {
  let d = prev~(p at sample, 1)
  let _ = 100 / d
  7
}

pub flow unread_slow_child(p: I32 at block) -> I32 at sample {
  let _ = div_prev4~(p)
  7
}

test "a child that nothing reads does not stop the first sample: its delay holds the 1 of its first value" {
  let o = unread_child.render(unread_child.Params { p: 0 }, 1, 8.0)
  assert o.out[0] == 7
}

test "a child that nothing reads runs on every sample: it divides by the 0 of its delay at the frame 1" {
  let o = unread_child.render(unread_child.Params { p: 0 }, 2, 8.0) //~ PANIC "a child that nothing reads runs on every sample: it divides by the 0 of its delay at the frame 1"
  assert o.out[1] == 7
}

test "a let that nothing reads is evaluated: the same division at the frame 1" {
  let o = unread_let.render(unread_let.Params { p: 0 }, 1, 8.0)
  assert o.out[0] == 7
  let o2 = unread_let.render(unread_let.Params { p: 0 }, 2, 8.0) //~ PANIC "a let that nothing reads is evaluated: the same division at the frame 1"
  assert o2.out[1] == 7
}

test "a child of sample / 4 that nothing reads runs at its ticks: 4 frames pass, the tick at the frame 4 divides by 0" {
  let o = unread_slow_child.render(unread_slow_child.Params { p: 0 }, 4, 8.0)
  assert o.out[3] == 7
  let o2 = unread_slow_child.render(unread_slow_child.Params { p: 0 }, 5, 8.0) //~ PANIC "a child of sample / 4 that nothing reads runs at its ticks: 4 frames pass, the tick at the frame 4 divides by 0"
  assert o2.out[4] == 7
}
