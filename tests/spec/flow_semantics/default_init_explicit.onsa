// onsa.toml
// [test]
// mode = "test"
// spec = ["§11.4", "§6.3"]

// A written `init` needs no `Default` of the value type: E0816 is only for the omitted `init` (§11.4:
// "省略すると値型の既定値 `T.default()` で始まる。… `T` が `Default` を満たさなければ E0816"). These are
// the ways to write the delay of a type with no `Default` (the fix of S-1104: "書き手は、遅延なら `init`
// を書き（`prev~(z, [])`）"). They pass today, and the negative forms (omitted `init`) are in
// negative/flow_default_init_e0816.onsa.

pub flow option_with_none(x: F32 at sample) -> F32 at sample {
  let o: Option[F32] = if x > 1.0 { Some(x) } else { None }
  let p = prev~(o, None)
  match p {
    Some(v) => v,
    None => -1.0,
  }
}

pub flow char_with_a_char(x: F32 at sample) -> F32 at sample {
  let c: Char = if x > 0.0 { 'a' } else { 'b' }
  let p = prev~(c, 'z')
  if p == 'z' { 1.0 } else { 0.0 }
}

pub flow empty_char_array(x: F32 at sample) -> F32 at sample {
  let c: Char = if x > 0.0 { 'a' } else { 'b' }
  let p = prev~([c; 0], [])
  x + F32.round_from(p.len())
}

pub struct Plain {
  a: F32,
}

pub flow plain_with_a_value(x: F32 at sample) -> F32 at sample {
  let p = prev~(Plain { a: x }, Plain { a: 7.0 })
  p.a
}

pub flow tuple_with_a_value(x: F32 at sample) -> F32 at sample {
  let c: Char = if x > 2.0 { 'a' } else { 'b' }
  let (a, ch) = delay~((x, c), 2, (9.0, 'z'))
  if ch == 'z' { a } else { -a }
}

test "an Option starts from the written None" {
  // x = 3 0 5: n0 None -> -1.  n1 from Some(3) -> 3.  n2 from None -> -1.
  let xs: [F32; 3] = [3.0, 0.0, 5.0]
  let o = option_with_none.render(xs, 8.0)
  assert o.out[0] == -1.0
  assert o.out[1] == 3.0
  assert o.out[2] == -1.0
}

test "a Char starts from the written Char" {
  // n0: 'z' -> 1.  n1 from x = 1: 'a' -> 0.  n2 from x = -1: 'b' -> 0.
  let xs: [F32; 3] = [1.0, -1.0, -1.0]
  let o = char_with_a_char.render(xs, 8.0)
  assert o.out[0] == 1.0
  assert o.out[1] == 0.0
  assert o.out[2] == 0.0
}

test "an array of no Char starts from the written empty array" {
  let xs: [F32; 2] = [3.0, 4.0]
  let o = empty_char_array.render(xs, 8.0)
  assert o.out[0] == 3.0
  assert o.out[1] == 4.0
}

test "a struct with no Default starts from the written value" {
  // n0: 7.  n1 from x = 1: 1.
  let xs: [F32; 2] = [1.0, 2.0]
  let o = plain_with_a_value.render(xs, 8.0)
  assert o.out[0] == 7.0
  assert o.out[1] == 1.0
}

test "a tuple with a Char starts from the written tuple for N samples" {
  // x = 1 2 3 4, c = b b a a: n0, n1: (9, 'z') -> 9.  n2 from x = 1, 'b': -1.  n3 from x = 2, 'b': -2.
  let xs: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  let o = tuple_with_a_value.render(xs, 8.0)
  assert o.out[0] == 9.0
  assert o.out[1] == 9.0
  assert o.out[2] == -1.0
  assert o.out[3] == -2.0
}
