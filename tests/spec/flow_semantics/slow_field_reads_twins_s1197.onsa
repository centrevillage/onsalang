  let k = prev~(^k at (sample / 8)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  (sum4~(if h { s.vel at sample } else { x }).down~(4)) at sample
}

flow gathered_under_a_fast_tick_let(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 8)) + 1.0
