}

flow in_a_gathered_argument_of_its_tick(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  let y = sum4~(if h { s.vel at sample } else { x }).down~(4)
  y at sample
}

flow in_a_gathered_argument_of_its_tick_let(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  let l0 = s.vel
  let y = sum4~(if h { l0 at sample } else { x }).down~(4)
  y at sample
}

pub flow in_a_gathered_argument_of_its_tick_read(x: F32 at sample, p: I32 at block) -> F32 at sample {
  in_a_gathered_argument_of_its_tick~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
}

pub flow in_a_gathered_argument_of_its_tick_diff(x: F32 at sample, p: I32 at block) -> F32 at sample {
  let d = in_a_gathered_argument_of_its_tick_read~(x, p) - in_a_gathered_argument_of_its_tick_let~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
  let e = prev~(^e) + d * d
