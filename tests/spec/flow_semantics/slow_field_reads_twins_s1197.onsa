// onsa.toml
// [test]
// mode = "test"
// spec = ["§11.3", "§11.5", "§11.9", "§11.10"]

// W7-11 U2c/i, S-1197 (spec §11.3: "フィールド・組の要素の読みは、条件によらず、守りを付けずに刻みごとに読む"、"`x + m.vel` は `let v = m.vel` の `x + v` と同じ値"): a field or an element of a name of `sample / 4` in each kind of conditional position
// (the branches of `if`, the later conditions of `if~`, the guards of `match~`, the right of `&&` and `||`, in a `par` in a branch, under a condition of constants, `init` and `block`, in the first argument of a delay with a `^name`, in an argument that a chain
// gathers) gives the values of its twin, where a `let` before holds the read. Each is restarted at the frames 6 and 10 (`reset_if~`), where what is not read at the tick shows. The flow `_diff` sums the squares of the differences.

pub struct D: Default {
  vel: F32 = 1.0,
  q: F32,
  on: Bool = true,
}

pub struct N: Default {
  a: D,
  t: (F32, D),
}

pub enum V {
  A,
  B(D),
}

impl Default for V {
  rt fn default() -> V {
    V.A
  }
}

flow lp(x: F32 at sample) -> F32 at sample {
  x * 0.5 + prev~(x)
}

flow sum4(x: F32 at (sample * 4)) -> F32 at sample {
  x[0] + x[1] * 2.0 + x[2] * 3.0 + x[3] * 4.0
}

flow cnt(x: F32 at sample) -> D at sample {
  let k = prev~(^k) + x
  D { vel: k + 10.0, q: k, on: k > 2.0 }
}

flow else_if(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let n = N { a: D { vel: k + 10.0, q: k, on: k > 1.5 }, t: (k * 3.0, D { vel: k, q: 0.0, on: k > 0.5 }) }
  if g { n.a.vel at sample } else if h { (n.t).0 at sample } else if x > 3.0 || (n.t.1.on at sample) { n.t.1.vel at sample } else { x }
}

flow else_if_let(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let n = N { a: D { vel: k + 10.0, q: k, on: k > 1.5 }, t: (k * 3.0, D { vel: k, q: 0.0, on: k > 0.5 }) }
  let l0 = n.a.vel
  let l1 = (n.t).0
  let l2 = n.t.1.on
  let l3 = n.t.1.vel
  if g { l0 at sample } else if h { l1 at sample } else if x > 3.0 || (l2 at sample) { l3 at sample } else { x }
}

pub flow else_if_read(x: F32 at sample, p: I32 at block) -> F32 at sample {
  else_if~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
}

pub flow else_if_diff(x: F32 at sample, p: I32 at block) -> F32 at sample {
  let d = else_if_read~(x, p) - else_if_let~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
  let e = prev~(^e) + d * d
  e
}

flow later_condition(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  if~ g { lp~(x) } else if (s.on at sample) { lp~(x + 1.0) } else { lp~(x + 2.0) }
}

flow later_condition_let(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  let l0 = s.on
  if~ g { lp~(x) } else if (l0 at sample) { lp~(x + 1.0) } else { lp~(x + 2.0) }
}

pub flow later_condition_read(x: F32 at sample, p: I32 at block) -> F32 at sample {
  later_condition~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
}

pub flow later_condition_diff(x: F32 at sample, p: I32 at block) -> F32 at sample {
  let d = later_condition_read~(x, p) - later_condition_let~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
  let e = prev~(^e) + d * d
  e
}

flow condition_chain(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  if~ g { lp~(x) } else if h && (s.on at sample) { lp~(x + 1.0) } else { lp~(if h { s.vel at sample } else { x }) }
}

flow condition_chain_let(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  let l0 = s.on
  let l1 = s.vel
  if~ g { lp~(x) } else if h && (l0 at sample) { lp~(x + 1.0) } else { lp~(if h { l1 at sample } else { x }) }
}

pub flow condition_chain_read(x: F32 at sample, p: I32 at block) -> F32 at sample {
  condition_chain~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
}

pub flow condition_chain_diff(x: F32 at sample, p: I32 at block) -> F32 at sample {
  let d = condition_chain_read~(x, p) - condition_chain_let~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
  let e = prev~(^e) + d * d
  e
}

flow guards(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  match~ g { true if (s.on at sample) => lp~(x), _ if h && (s.vel at sample) > 12.5 => lp~(x + 1.0), _ => lp~(if h { s.q at sample } else { x }) }
}

flow guards_let(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  let l0 = s.on
  let l1 = s.vel
  let l2 = s.q
  match~ g { true if (l0 at sample) => lp~(x), _ if h && (l1 at sample) > 12.5 => lp~(x + 1.0), _ => lp~(if h { l2 at sample } else { x }) }
}

pub flow guards_read(x: F32 at sample, p: I32 at block) -> F32 at sample {
  guards~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
}

pub flow guards_diff(x: F32 at sample, p: I32 at block) -> F32 at sample {
  let d = guards_read~(x, p) - guards_let~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
  let e = prev~(^e) + d * d
  e
}

flow in_par(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  let y = if g { par i in 0 ..< 3 { if h { (s.vel at sample) * F32.round_from(i) } else { x } } } else { par i in 0 ..< 3 { s.q at sample } }
  y[0] + y[1] * 3.0 + y[2] * 7.0
}

flow in_par_let(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  let l0 = s.vel
  let l1 = s.q
  let y = if g { par i in 0 ..< 3 { if h { (l0 at sample) * F32.round_from(i) } else { x } } } else { par i in 0 ..< 3 { l1 at sample } }
  y[0] + y[1] * 3.0 + y[2] * 7.0
}

pub flow in_par_read(x: F32 at sample, p: I32 at block) -> F32 at sample {
  in_par~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
}

pub flow in_par_diff(x: F32 at sample, p: I32 at block) -> F32 at sample {
  let d = in_par_read~(x, p) - in_par_let~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
  let e = prev~(^e) + d * d
  e
}

flow in_par_state(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  let z = par~ j in 0 ..< 2 { lp~(if h { (s.vel at sample) + F32.round_from(j) } else { x }) }
  z[0] + z[1] * 100.0
}

flow in_par_state_let(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  let l0 = s.vel
  let z = par~ j in 0 ..< 2 { lp~(if h { (l0 at sample) + F32.round_from(j) } else { x }) }
  z[0] + z[1] * 100.0
}

pub flow in_par_state_read(x: F32 at sample, p: I32 at block) -> F32 at sample {
  in_par_state~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
}

pub flow in_par_state_diff(x: F32 at sample, p: I32 at block) -> F32 at sample {
  let d = in_par_state_read~(x, p) - in_par_state_let~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
  let e = prev~(^e) + d * d
  e
}

flow parameters(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  let sr = sample_rate()
  let a = if sr > 10.0 { if g { s.vel at sample } else { x } } else { s.q at sample }
  let b = if true { s.q at sample } else { s.vel at sample }
  a + b * 0.25 + (if h { (s.vel at sample) + (s.vel at sample) } else { 0.0 })
}

flow parameters_let(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  let l0 = s.vel
  let l1 = s.q
  let sr = sample_rate()
  let a = if sr > 10.0 { if g { l0 at sample } else { x } } else { l1 at sample }
  let b = if true { l1 at sample } else { l0 at sample }
  a + b * 0.25 + (if h { (l0 at sample) + (l0 at sample) } else { 0.0 })
}

pub flow parameters_read(x: F32 at sample, p: I32 at block) -> F32 at sample {
  parameters~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
}

pub flow parameters_diff(x: F32 at sample, p: I32 at block) -> F32 at sample {
  let d = parameters_read~(x, p) - parameters_let~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
  let e = prev~(^e) + d * d
  e
}

flow block_condition(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  if p > 2 { if h { s.vel at sample } else { x } } else { if p > 1 { s.q at sample } else { x + 0.5 } }
}

flow block_condition_let(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  let l0 = s.vel
  let l1 = s.q
  if p > 2 { if h { l0 at sample } else { x } } else { if p > 1 { l1 at sample } else { x + 0.5 } }
}

pub flow block_condition_read(x: F32 at sample, p: I32 at block) -> F32 at sample {
  block_condition~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
}

pub flow block_condition_diff(x: F32 at sample, p: I32 at block) -> F32 at sample {
  let d = block_condition_read~(x, p) - block_condition_let~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
  let e = prev~(^e) + d * d
  e
}

flow guarded_part_beside(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  let sr = sample_rate()
  if sr > 10.0 { (if h { s.vel at sample } else { x }) + ((s.q * 3.0) at sample) } else { x }
}

flow guarded_part_beside_let(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  let l0 = s.vel
  let sr = sample_rate()
  if sr > 10.0 { (if h { l0 at sample } else { x }) + ((s.q * 3.0) at sample) } else { x }
}

pub flow guarded_part_beside_read(x: F32 at sample, p: I32 at block) -> F32 at sample {
  guarded_part_beside~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
}

pub flow guarded_part_beside_diff(x: F32 at sample, p: I32 at block) -> F32 at sample {
  let d = guarded_part_beside_read~(x, p) - guarded_part_beside_let~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
  let e = prev~(^e) + d * d
  e
}

flow delay_with_feedback(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  let d = prev~(if h { (s.vel at sample) + ^w } else { x })
  let w = d * 0.5 + x
  w
}

flow delay_with_feedback_let(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  let l0 = s.vel
  let d = prev~(if h { (l0 at sample) + ^w } else { x })
  let w = d * 0.5 + x
  w
}

pub flow delay_with_feedback_read(x: F32 at sample, p: I32 at block) -> F32 at sample {
  delay_with_feedback~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
}

pub flow delay_with_feedback_diff(x: F32 at sample, p: I32 at block) -> F32 at sample {
  let d = delay_with_feedback_read~(x, p) - delay_with_feedback_let~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
  let e = prev~(^e) + d * d
  e
}

flow in_a_gathered_argument(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  (sum4~(if h { s.vel at sample } else { x }).down~(4)) at sample
}

flow in_a_gathered_argument_let(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  let l0 = s.vel
  (sum4~(if h { l0 at sample } else { x }).down~(4)) at sample
}

pub flow in_a_gathered_argument_read(x: F32 at sample, p: I32 at block) -> F32 at sample {
  in_a_gathered_argument~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
}

pub flow in_a_gathered_argument_diff(x: F32 at sample, p: I32 at block) -> F32 at sample {
  let d = in_a_gathered_argument_read~(x, p) - in_a_gathered_argument_let~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
  let e = prev~(^e) + d * d
