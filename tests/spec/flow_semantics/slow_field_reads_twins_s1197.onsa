flow of_a_binding_of_match_tilde(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  let o = if k > 1.5 { V.B(s) } else { V.A }
  let y = match~ o { V.B(n) => sum4~(if h { n.vel at sample } else { x }).down~(4), V.A => sum4~(x).down~(4) }
  y at sample
}

flow of_a_binding_of_match_tilde_let(x: F32 at sample, g: Bool at sample, h: Bool at sample, p: I32 at block) -> F32 at sample {
  let k = prev~(^k at (sample / 4)) + 1.0
  let s = D { vel: k + 10.0, q: k, on: k > 1.5 }
  let o = if k > 1.5 { V.B(s) } else { V.A }
  let l0 = match o { V.B(n) => n.vel, V.A => 1.0 }
  let y = match~ o { V.B(_) => sum4~(if h { l0 at sample } else { x }).down~(4), V.A => sum4~(x).down~(4) }
  y at sample
}

pub flow of_a_binding_of_match_tilde_read(x: F32 at sample, p: I32 at block) -> F32 at sample {
  of_a_binding_of_match_tilde~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
}

pub flow of_a_binding_of_match_tilde_diff(x: F32 at sample, p: I32 at block) -> F32 at sample {
  let d = of_a_binding_of_match_tilde_read~(x, p) - of_a_binding_of_match_tilde_let~(x, x % 2.0 > 0.75, x % 3.0 > 1.25, p).reset_if~(x == 6.0 || x == 10.0)
  let e = prev~(^e) + d * d
  e
}

