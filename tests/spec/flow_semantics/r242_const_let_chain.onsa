// onsa.toml
// [test]
// mode = "test"
// spec = ["§11.3", "§11.6"]

// R-242 (`issues/R/R-242/cc.onsa`): a chain of constant `let`s (`let a = K; let b = a`) read by the
// output of the sample clock. Each `let` is of the constant clock, read where the sample stage reads
// `b` (spec §11.3). The expected values are worked out by hand.

const K: F32 = 0.5

pub flow f(x: F32 at sample) -> F32 at sample {
  let a = K
  let b = a
  x * b
}

test "a chain of constant lets read by the sample stage" {
  let xs: [F32; 2] = [2.0, 6.0]
  let o = f.render(xs, 8.0)
  assert o.out[0] == 1.0
  assert o.out[1] == 3.0
}
