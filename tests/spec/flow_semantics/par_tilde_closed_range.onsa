// onsa.toml
// [test]
// mode = "test"
// spec = ["§11.5", "§2.6"]

// W4-20 U1/t, S-745: the closed range of the replication, `par~ i in a ..= b { e }` (§11.5: "`par~ i in
// a ..= b { e }` は `N = b - a + 1` 個並べる"). The index goes from `a` to `b` itself, `a ..= a` is one
// replica (the range is empty only when `a > b`, E0808), `0 ..= N - 1` and `0 ..< N` give the same
// replication, every replica has its own instance, and the `~` is written as for the half-open range.
// Not made in this version (the closed range in the header of a `par` is E0200, W7-04), so this file is
// on the list of what is waited for (until W7-04); the half-open range is in par_tilde_forms.onsa.

pub flow acc(x: F32 at sample) -> F32 at sample {
  let y = x + prev~(^y)
  y
}

pub rt fn total(xs: [F32; 4]) -> F32 {
  xs[0] + xs[1] + xs[2] + xs[3]
}

pub rt fn pair_sum(xs: [F32; 2]) -> F32 {
  xs[0] + xs[1]
}

// Three replicas: the index is 1, 2, 3.
pub flow scaled_by_index(x: F32 at sample) -> [F32; 3] at sample {
  par~ i in 1 ..= 3 { x * F32.round_from(i) }
}

// The last value of the index is `b`, not `b - 1`: 0, 1, 2, 3.
pub flow the_index_itself(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0 ..= 3 { F32.round_from(i) }
  total(ys)
}

// `a ..= a` is one replica.
pub flow one_replica(x: F32 at sample) -> [F32; 1] at sample {
  par~ i in 4 ..= 4 { x + F32.round_from(i) }
}

// Three replicas, each with its own accumulator of x + i.
pub flow own_instances(x: F32 at sample) -> [F32; 3] at sample {
  par~ i in 0 ..= 2 { acc~(x + F32.round_from(i)) }
}

// Nested: the outer index is 0, 1 and the inner 1, 2; the multipliers 1, 2 and 2, 4.
pub flow nested(x: F32 at sample) -> F32 at sample {
  let rows = par~ i in 0 ..= 1 {
    pair_sum(par~ j in 1 ..= 2 { x * F32.round_from((i + 1) * j) })
  }
  rows[0] + rows[1]
}

test "the index of a closed range goes to its upper bound" {
  // x * 1, x * 2, x * 3 with x = 1.0, 2.0.
  let xs: [F32; 2] = [1.0, 2.0]
  let o            = scaled_by_index.render(scaled_by_index.Config {}, scaled_by_index.Params {}, xs, 8.0)
  assert o.out[0][0] == 1.0
  assert o.out[0][1] == 2.0
  assert o.out[1][0] == 2.0
  assert o.out[1][1] == 4.0
  assert o.out[2][0] == 3.0
  assert o.out[2][1] == 6.0
}

test "the last value of the index is the upper bound" {
  // 0 + 1 + 2 + 3 = 6, whatever x is.
  let xs: [F32; 2] = [1.0, 2.0]
  let o            = the_index_itself.render(the_index_itself.Config {}, the_index_itself.Params {}, xs, 8.0)
  assert o.out[0] == 6.0
  assert o.out[1] == 6.0
}

test "a ..= a is one replica" {
  // x + 4 with x = 1.0, 2.0.
  let xs: [F32; 2] = [1.0, 2.0]
  let o            = one_replica.render(one_replica.Config {}, one_replica.Params {}, xs, 8.0)
  assert o.out[0][0] == 5.0
  assert o.out[0][1] == 6.0
}

test "each replica of a closed range has its own instance" {
  // x = 1.0 each sample. Replica i: the running sum of 1 + i: 1 2 3, 2 4 6 and 3 6 9.
  let xs: [F32; 3] = [1.0, 1.0, 1.0]
  let o            = own_instances.render(own_instances.Config {}, own_instances.Params {}, xs, 8.0)
  assert o.out[0][0] == 1.0
  assert o.out[0][1] == 2.0
  assert o.out[0][2] == 3.0
  assert o.out[1][0] == 2.0
  assert o.out[1][1] == 4.0
  assert o.out[1][2] == 6.0
  assert o.out[2][0] == 3.0
  assert o.out[2][1] == 6.0
  assert o.out[2][2] == 9.0
}

test "a closed range inside a closed range" {
  // i = 0: 1 + 2 = 3 times x; i = 1: 2 + 4 = 6 times x; 9 * x.
  let xs: [F32; 2] = [1.0, 2.0]
  let o            = nested.render(nested.Config {}, nested.Params {}, xs, 8.0)
  assert o.out[0] == 9.0
  assert o.out[1] == 18.0
}
