// onsa.toml
// [test]
// mode = "test"
// spec = ["§11.4", "§6.4", "§15.1"]

// The omitted `init` of a delay whose value type is declared in another module (W7-07, §11.4, §6.4):
// the derived `Default` with private fields and a declared default of a field, and a hand-written
// `Default` of that module. The values of the fields are read by `rt fn`s of the module that owns
// them. Worked out by hand.

use meter.{make, level, peak, hide, gain}

pub flow derived_other_module(x: F32 at sample) -> F32 at sample {
  let m = prev~(make(x))
  level(m) * 10.0 + peak(m)
}

pub flow hand_other_module(x: F32 at sample) -> F32 at sample {
  let h = delay~(hide(x), 2)
  gain(h)
}

test "a derived Default with private fields starts a delay of another module" {
  // Default: level 0.5, peak 0 -> 5.  n1 from x = 3: level 3, peak 6 -> 36.
  let xs: [F32; 2] = [3.0, 4.0]
  let o = derived_other_module.render(xs, 8.0)
  assert o.out[0] == 5.0
  assert o.out[1] == 36.0
}

test "a hand-written Default of another module starts a delay for N samples" {
  // 8, 8, then x[0] = 2, x[1] = 3.
  let xs: [F32; 4] = [2.0, 3.0, 4.0, 5.0]
  let o = hand_other_module.render(xs, 8.0)
  assert o.out[0] == 8.0
  assert o.out[1] == 8.0
  assert o.out[2] == 2.0
  assert o.out[3] == 3.0
}
