// onsa.toml
// [test]
// mode = "test"
// spec = ["§7", "§11.5"]

// S-903 (§7) in the arms of a `match~` (§11.5): the last `_` of a struct pattern. A field that `_` leaves out is not read. An arm that
// is not chosen binds the default value of the type (§11.5), so the instance `acc~(a)` in the first arm goes on with
// `a = 0.0` on the samples where `open` is false. `match~` runs after W7-06 (branches_tilde.onsa waits for the same
// work), so this file is on the list until then. The values are worked out by hand.

pub struct Gate: Default {
  open: Bool,
  level: F32,
  tag: U32,
}

pub flow acc(x: F32 at sample) -> F32 at sample {
  let y = x + prev~(^y)
  y
}

// The first arm runs `acc~` on every sample; where `open` is false it gets `a = 0.0`.
pub flow gated(x: F32 at sample) -> F32 at sample {
  let g = Gate { open: x != 2.0, level: x, tag: 0 }
  match~ g {
    Gate { open: true, level: a, _ } => acc~(a),
    Gate { open: false, _ } => 0.0,
  }
}

test "match~ with a last _ in its arms" {
  // open = T F T.  The counter of the first arm adds a = 1, 0 (the arm is not chosen), 3: 1 1 4.
  // out = the counter, 0, the counter = 1 0 4.
  let xs: [F32; 3] = [1.0, 2.0, 3.0]
  let o            = gated.render(gated.Config {}, gated.Params {}, xs, 8.0)
  assert o.out[0] == 1.0
  assert o.out[1] == 0.0
  assert o.out[2] == 4.0
}
