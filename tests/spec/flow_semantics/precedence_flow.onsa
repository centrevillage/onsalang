// onsa.toml
// [test]
// mode = "test"
// spec = ["§3.1", "§11.2", "§11.3", "§11.4", "§11.5"]

// The groups of §3.1 in the body of a `flow` and in a `par` (W3-07): the tree of a chain of binary
// operators is read once, and the flow checks (clocks, `^y`, `prev~`), the lowering and the value
// all follow it. A multiplicative expression is an operand of a sum, a sum is an operand of a
// comparison, a comparison is an operand of `&&`, written without redundant parentheses (the form
// `onsa fmt` writes). The expected values follow from the formulas in the comments by hand.
//
// Needs the flow syntax of W3-10 (`at sample`); the same expressions in functions are in
// semantics/precedence_contexts.onsa.

// y[n] = x[n] * g + 0.5 * x[n-1]  (a flat fold would give (x * g + prev~(x)) * 0.5)
pub flow mix(x: F32 at sample, g: F32 at block) -> F32 at sample {
  let y = x * g + prev~(x) * 0.5
  y
}

// y[n] = x[n] * g + 0.5 * y[n-1]
pub flow feedback(x: F32 at sample, g: F32 at block) -> F32 at sample {
  let y = x * g + 0.5 * prev~(^y)
  y
}

// The comparison binds tighter than `&&`, and the product tighter than the comparison.
pub flow window(x: F32 at sample, g: F32 at block) -> F32 at sample {
  if x * g > 2.0 && x < 10.0 {
    1.0
  } else {
    0.0
  }
}

// k is a block-rate sum of a product; the sample-rate sum uses it.
pub flow gain_offset(x: F32 at sample, g: F32 at block) -> F32 at sample {
  let k = g * 2.0 + 1.0
  let y = x * k + g * g
  y
}

// The input of a delay is a sum of a product: d[n] = x[n-1] * g + 1.0 for n >= 1, 0.0 at n = 0.
pub flow delayed(x: F32 at sample, g: F32 at block) -> F32 at sample {
  prev~(x * g + 1.0)
}

// Three replicas i = 0, 1, 2 of x * i + 1.0: the sum is 3 x + 3.
pub flow layers(x: F32 at sample) -> F32 at sample {
  let a = par i in 0..<3 { x * i.round_f32() + 1.0 }
  a[0] + a[1] + a[2]
}

// A delay inside each replica, with the index in a sum of a product: the multiplier of the replica
// i is 2 * i + 1, so the replicas multiply by 1 and 3: y[n] = 4 * x[n-1].
pub flow delayed_layers(x: F32 at sample) -> F32 at sample {
  let a = par i in 0..<2 { prev~(x * (2 * i + 1).round_f32()) }
  a[0] + a[1]
}

test "a product under a sum in a flow body" {
  // g = 2: y = 2 x[n] + 0.5 x[n-1].
  let xs: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  let o = mix.render(mix.Config {}, mix.Params { g: 2.0 }, xs, 8.0)
  assert o.out[0] == 2.0
  assert o.out[1] == 4.5
  assert o.out[2] == 7.0
  assert o.out[3] == 9.5
}

test "a product under a sum, with a feedback" {
  // g = 1, an impulse: y = 1, 0.5, 0.25, 0.125.
  let xs: [F32; 4] = [1.0, 0.0, 0.0, 0.0]
  let o = feedback.render(feedback.Config {}, feedback.Params { g: 1.0 }, xs, 8.0)
  assert o.out[0] == 1.0
  assert o.out[1] == 0.5
  assert o.out[2] == 0.25
  assert o.out[3] == 0.125
  // g = 2: y = 2 x[n] + 0.5 y[n-1] with x = 1, 1, 0: 2, 3, 1.5.
  let ys: [F32; 3] = [1.0, 1.0, 0.0]
  let p = feedback.render(feedback.Config {}, feedback.Params { g: 2.0 }, ys, 8.0)
  assert p.out[0] == 2.0
  assert p.out[1] == 3.0
  assert p.out[2] == 1.5
}

test "a comparison of a product and a comparison under && in a condition" {
  // g = 1: 1 for x > 2 and x < 10, else 0.
  let xs: [F32; 4] = [1.0, 3.0, 12.0, 2.5]
  let o = window.render(window.Config {}, window.Params { g: 1.0 }, xs, 8.0)
  assert o.out[0] == 0.0
  assert o.out[1] == 1.0
  assert o.out[2] == 0.0
  assert o.out[3] == 1.0
  // g = 0.5: x * 0.5 > 2.0 needs x > 4, and x < 10 cuts the 12.
  let zs: [F32; 4] = [1.0, 5.0, 12.0, 9.0]
  let p = window.render(window.Config {}, window.Params { g: 0.5 }, zs, 8.0)
  assert p.out[0] == 0.0
  assert p.out[1] == 1.0
  assert p.out[2] == 0.0
  assert p.out[3] == 1.0
}

test "a block-rate sum of a product feeds a sample-rate sum" {
  // g = 0.5: k = 2.0, y = 2 x + 0.25.
  let xs: [F32; 3] = [1.0, 2.0, 3.0]
  let o = gain_offset.render(gain_offset.Config {}, gain_offset.Params { g: 0.5 }, xs, 8.0)
  assert o.out[0] == 2.25
  assert o.out[1] == 4.25
  assert o.out[2] == 6.25
}

test "the input of a delay is a sum of a product" {
  // g = 2: 0.0, then x[n-1] * 2 + 1: 3.0, 5.0.
  let xs: [F32; 3] = [1.0, 2.0, 3.0]
  let o = delayed.render(delayed.Config {}, delayed.Params { g: 2.0 }, xs, 8.0)
  assert o.out[0] == 0.0
  assert o.out[1] == 3.0
  assert o.out[2] == 5.0
}

test "a par body with a sum of a product" {
  // 3 x + 3.
  let xs: [F32; 2] = [1.0, 2.0]
  let o = layers.render(layers.Config {}, layers.Params {}, xs, 8.0)
  assert o.out[0] == 6.0
  assert o.out[1] == 9.0
}

test "the index of a par in a sum of a product, with a delay in each replica" {
  // y[n] = (1 + 3) x[n-1].
  let xs: [F32; 3] = [1.0, 2.0, 3.0]
  let o = delayed_layers.render(delayed_layers.Config {}, delayed_layers.Params {}, xs, 8.0)
  assert o.out[0] == 0.0
  assert o.out[1] == 4.0
  assert o.out[2] == 8.0
}
