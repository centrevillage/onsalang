// onsa.toml
// [test]
// mode = "test"
// spec = ["§11.5", "§11.11", "§11.3", "§11.10", "§11.4"]

// The events in the arms, the conditions and the targets of `if~` and `match~` (W7-17 U6a/t; A1; S-1239, S-1233, S-1240, S-1249, S-1250; spec §11.5: "`if~ c { a } else { b }` と `match~ x { ... }` は、全ての枝を評価してから一つを選ぶ（…）。…評価の順は、
// 選ぶ側を先に、次に全ての枝と腕の本体を書いた順"; "全ての枝の状態を持つものが進み、状態を持たない部分も全て評価される"; "`match~` の取られない腕の束縛は、値型の既定値 `T.default()` になり、`T` が `Default` を満たさなければ E0816"; "腕の本体で読む束縛のクロックは、対象のクロックと、最初の腕からその腕までのガードのクロックのうち最も速いもの"; §11.11: "別の呼び出しを配列の要素か `if~`・`match~` の腕に並べた形は、
// 条件・対象・ガードか要素・腕のどれかが周期の刻みのクロックの値（`at` で付けたクロックを含む）なら、§11.3 のとおり周期のクロックの式で、要素と腕はその位置までの最後の値であり、どれも違えば（…）E0815 である").
// Every arm runs at each event whether it is chosen or not (the receiver of an unchosen arm counts, sums and resets); the value of the `if~` is the value of the chosen arm, read at the frame. The input is `XS` (12 frames); the events are
//   XS      = 2 3 4 6 5 8 10 7 9 12 14 11
//   hit 2   = 2@0 4@2 6@3 8@5 10@6 12@9 14@10         hit 3 = 3@1 6@3 9@8 12@9         ev (the odd ones) = 3@1 5@4 7@7 9@8 11@11
// `A` is the sum of the events of hit 2 (2 2 6 12 12 20 30 30 30 42 56 56) and `B` that of hit 3 (0 3 3 9 9 9 9 9 18 30 30 30). `acc` sums, `cnt` counts, `run` sums x of the frames it runs. Every value is worked out by hand.

const XS: [U32; 12] = [2, 3, 4, 6, 5, 8, 10, 7, 9, 12, 14, 11]

flow hit(x: U32 at sample, k: U32 at block) -> U32 at event {
  if x % k == 0 {
    Some(x)
  } else {
    None
  }
}

flow ev(x: U32 at sample) -> U32 at event {
  if x % 2 == 1 {
    Some(x)
  } else {
    None
  }
}

rt fn bit(m: U32) -> U32 {
  1
}

rt fn big(m: U32) -> Bool {
  m > 6
}

flow acc(e: U32 at event) -> U32 at sample {
  let n = prev~(^n) + e
  n
}

flow cnt(e: U32 at event) -> U32 at sample {
  let n = prev~(^n) + bit(e)
  n
}

flow run(x: U32 at sample) -> U32 at sample {
  let n = prev~(^n) + x
  n
}

// ---- the arms with a maker and a receiver: both arms run, an arm that is not chosen counts too

pub flow both_arms(x: U32 at sample) -> U32 at sample {
  if~ x % 2 == 1 {
    acc~(hit~(x, 2))
  } else {
    acc~(hit~(x, 3))
  }
}

pub flow one_arm(x: U32 at sample) -> U32 at sample {
  if~ x > 6 {
    acc~(hit~(x, 2))
  } else {
    prev~(x)
  }
}

test "both arms of an if~ run: each receiver has all the events of its own maker, and the value is the one of the arm chosen by x % 2" {
  // Odd x gives A, even x gives B (the sums of all the events, also those of the frames the arm was not chosen).
  let o = both_arms.render(XS, 8.0)
  let w: [U32; 12] = [0, 2, 3, 9, 12, 9, 9, 30, 30, 30, 30, 56]
  for t in 0 ..< 12 {
    assert o.out[t] == w[t]
  }
}

test "an arm with a receiver that is not chosen until the frame 5 has the sum of the events from the frame 0" {
  // x > 6 chooses A at the frames 5 .. 11 (x = 8 10 7 9 12 14 11), and prev~(x) before: 0 2 3 4 6, then A = 20 30 30 30 42 56 56.
  let o = one_arm.render(XS, 8.0)
  let w: [U32; 12] = [0, 2, 3, 4, 6, 20, 30, 30, 30, 42, 56, 56]
  for t in 0 ..< 12 {
    assert o.out[t] == w[t]
  }
}

// ---- a maker in an arm, its event received outside the arm: the clock of the `if~` is the clock of the maker, and the constant of the other arm is given at its events

pub flow arm_maker(x: U32 at sample, k: U32 at block) -> U32 at sample {
  let e = if~ k > 0 {
    hit~(x, 3)
  } else {
    5
  }
  acc~(e)
}

pub flow arm_maker_in_a_flow(x: U32 at sample, k: U32 at block) -> U32 at sample {
  acc~(pick~(k, x))
}

pub flow arm_maker_split(x: U32 at sample, k: U32 at block) -> U32 at sample {
  let d = hit~(x, 3)
  let e = if k > 0 {
    d
  } else {
    5
  }
  acc~(e)
}

// The twin in a flow of its own: its event is the one of the `if~` with `Some`.
flow pick(k: U32 at block, x: U32 at sample) -> U32 at event {
  let e = if~ k > 0 {
    hit~(x, 3)
  } else {
    5
  }
  Some(e)
}

test "an if~ of an event of a maker in an arm and a constant: the receiver outside has the events of the maker (k = 1) or a 5 at each of them (k = 0), and the same in a flow of its own or in an if of a let" {
  // hit 3 is 3@1 6@3 9@8 12@9: k = 1 gives the sums 3 9 18 30, k = 0 gives 5 at those frames, the sums 5 10 15 20.
  let a1 = arm_maker.render(arm_maker.Params { k: 1 }, XS, 8.0)
  let a0 = arm_maker.render(arm_maker.Params { k: 0 }, XS, 8.0)
  let b1 = arm_maker_in_a_flow.render(arm_maker_in_a_flow.Params { k: 1 }, XS, 8.0)
  let b0 = arm_maker_in_a_flow.render(arm_maker_in_a_flow.Params { k: 0 }, XS, 8.0)
  let c1 = arm_maker_split.render(arm_maker_split.Params { k: 1 }, XS, 8.0)
  let c0 = arm_maker_split.render(arm_maker_split.Params { k: 0 }, XS, 8.0)
  let w1: [U32; 12] = [0, 3, 3, 9, 9, 9, 9, 9, 18, 30, 30, 30]
  let w0: [U32; 12] = [0, 5, 5, 10, 10, 10, 10, 10, 15, 20, 20, 20]
  for t in 0 ..< 12 {
    assert a1.out[t] == w1[t] && b1.out[t] == w1[t] && c1.out[t] == w1[t]
    assert a0.out[t] == w0[t] && b0.out[t] == w0[t] && c0.out[t] == w0[t]
  }
}

// ---- the condition or the target is an event, a period, a block value, an init value

pub flow cond_event(x: U32 at sample) -> U32 at sample {
  let m = ev~(x)
  if~ big(m) {
    acc~(hit~(x, 2))
  } else {
    acc~(hit~(x, 3))
  }
}

pub flow target_event(x: U32 at sample) -> U32 at sample {
  let m = ev~(x)
  match~ m {
    3 => prev~(x),
    7 => acc~(hit~(x, 2)),
    _ => acc~(hit~(x, 3)),
  }
}

pub flow cond_init(x: U32 at sample, n: U32 at init) -> U32 at sample {
  if~ n > 1 {
    acc~(hit~(x, 2))
  } else {
    acc~(hit~(x, 3))
  }
}

pub flow target_block(x: U32 at sample, k: U32 at block) -> U32 at sample {
  match~ k {
    0 => acc~(hit~(x, 2)),
    _ => acc~(hit~(x, 3)),
  }
}

test "the condition and the target of an if~ and a match~ that are an event are read at the frame as the last event: the default before the first one" {
  // The last m is 0 (the frames 0), 3 (1 .. 3), 5 (4 .. 6), 7 (7), 9 (8 .. 10), 11 (11). big(m) is true from the frame 7: B before, A after. The match: `_` (B) at the frame 0, the arm 3 gives the x one before at 1 .. 3 (2 3 4),
  // B at 4 .. 6, the arm 7 (A = 30) at 7, B at 8 .. 11 (18 30 30 30).
  let a = cond_event.render(XS, 8.0)
  let b = target_event.render(XS, 8.0)
  let wa: [U32; 12] = [0, 3, 3, 9, 9, 9, 9, 30, 30, 42, 56, 56]
  let wb: [U32; 12] = [0, 2, 3, 4, 9, 9, 9, 30, 18, 30, 30, 30]
  for t in 0 ..< 12 {
    assert a.out[t] == wa[t] && b.out[t] == wb[t]
  }
}

test "an if~ on an init value and a match~ on a block value take the arm of the value and run the other one too" {
  // n = 2 is > 1: A. n = 0: B. k = 0 matches the arm 0: A; k = 5 the arm _: B.
  let a = cond_init.render(cond_init.Config { n: 2 }, XS, 8.0)
  let b = cond_init.render(cond_init.Config { n: 0 }, XS, 8.0)
  let c = target_block.render(target_block.Params { k: 0 }, XS, 8.0)
  let d = target_block.render(target_block.Params { k: 5 }, XS, 8.0)
  let wa: [U32; 12] = [2, 2, 6, 12, 12, 20, 30, 30, 30, 42, 56, 56]
  let wb: [U32; 12] = [0, 3, 3, 9, 9, 9, 9, 9, 18, 30, 30, 30]
  for t in 0 ..< 12 {
    assert a.out[t] == wa[t] && c.out[t] == wa[t]
    assert b.out[t] == wb[t] && d.out[t] == wb[t]
  }
}

// ---- S-1239: the condition is a periodic value, the arms are events of makers of their own: an expression of sample, the arms are the last events

pub flow arms_are_events(x: U32 at sample) -> U32 at sample {
  if~ x % 2 == 1 {
    hit~(x, 2)
  } else {
    hit~(x, 3)
  }
}

pub flow match_arms_are_events(x: U32 at sample) -> U32 at sample {
  match~ x % 3 {
    0 => hit~(x, 2),
    1 => hit~(x, 3),
    _ => hit~(x, 4),
  }
}

test "the arms of an if~ and a match~ with a periodic condition are the last events of the makers, 0 before the first event of the maker of the arm" {
  // The last events: hit 2 = 2 2 4 6 6 8 10 10 10 12 14 14, hit 3 = 0 3 3 6 6 6 6 6 9 12 12 12, hit 4 = 0 0 4 4 4 8 8 8 8 12 12 12.
  // The if~: x odd takes hit 2, else hit 3. The match~ on x % 3: 0 takes hit 2, 1 takes hit 3, 2 takes hit 4.
  let a = arms_are_events.render(XS, 8.0)
  let b = match_arms_are_events.render(XS, 8.0)
  let wa: [U32; 12] = [0, 2, 3, 6, 6, 6, 6, 10, 10, 12, 12, 14]
  let wb: [U32; 12] = [0, 2, 3, 6, 4, 8, 6, 6, 10, 12, 12, 12]
  for t in 0 ..< 12 {
    assert a.out[t] == wa[t] && b.out[t] == wb[t]
  }
}

// ---- the binding of a match~ with an event target: an arm that is not chosen has T.default() (0), read by a receiver, a delay and a reset_if~

pub flow binding_to_a_receiver(x: U32 at sample) -> U32 at sample {
  let m = ev~(x)
  match~ m {
    v if v > 6 => cnt~(v),
    w => acc~(w),
  }
}

pub flow binding_in_a_delay(x: U32 at sample) -> U32 at sample {
  let m = ev~(x)
  match~ m {
    v if v > 6 => prev~(v),
    w => prev~(w * 2),
  }
}

pub flow binding_in_a_reset(x: U32 at sample) -> U32 at sample {
  let m = ev~(x)
  let a = hit~(x, 2)
  match~ m {
    v if v > 6 => acc~(a).reset_if~(v == 0),
    w => acc~(a).reset_if~(w == 99),
  }
}

test "a receiver in an arm of a match~ ticks at every event of the target, with the binding of its arm (0 where the arm is not chosen)" {
  // m = 3@1 5@4 7@7 9@8 11@11. The arm `v > 6` counts the events (it ticks also at 3 and 5, where its v is 0); the arm w sums w: 3 and 5 are chosen (the sums 3 8), at the events 7 9 11 its w is 0. The arm is the one of the last m:
  // the arm w up to the frame 6 (0 at the frame 0, 3 at 1 .. 3, 8 at 4 .. 6), the counter from the frame 7 (3 4 4 4 5).
  let o = binding_to_a_receiver.render(XS, 8.0)
  let w: [U32; 12] = [0, 3, 3, 3, 8, 8, 8, 3, 4, 4, 4, 5]
  for t in 0 ..< 12 {
    assert o.out[t] == w[t]
  }
}

test "a delay of an arm that is not chosen stores 0 for the binding, and a delay of the chosen arm gives what its arm stored at the event before" {
  // The arm v stores v (0, 0, 7, 9, 11 at the five events), the arm w stores 2 w (6, 10, 0, 0, 0). The value at an event is the output of the chosen arm: the events 3 and 5 take the arm w (0, 6), 7 takes the arm v
  // that stored 0 at 5 (not 5), 9 takes 7, 11 takes 9.
  let o = binding_in_a_delay.render(XS, 8.0)
  let w: [U32; 12] = [0, 0, 0, 0, 6, 6, 6, 0, 7, 7, 7, 9]
  for t in 0 ..< 12 {
    assert o.out[t] == w[t]
  }
}

test "a reset_if~ of an arm of a match~ that reads the binding resets the arm at the events where the binding is 0, also where the arm is not chosen" {
  // The arm w sums the even x (A) and is never reset: it is chosen up to the frame 6 (the last m is below 7). The arm v is reset at the events 3 and 5 (its v is 0 there, the last at the frame 4), so it sums the even x from the frame 5
  // (8 10 12 14: 8 18 18 30 44 44 from the frame 5) and is chosen from the frame 7: 18 18 30 44 44. A reset at its v would not happen if the unchosen binding were the value of the target.
  let o = binding_in_a_reset.render(XS, 8.0)
  let w: [U32; 12] = [2, 2, 6, 12, 12, 20, 30, 18, 18, 30, 44, 44]
  for t in 0 ..< 12 {
    assert o.out[t] == w[t]
  }
}

// ---- the computed expressions of an event in an arm (m * 2, m + sample_tick()), a reset_if~ and a when~ in an arm

pub flow part_in_arms(x: U32 at sample) -> U32 at sample {
  let m = ev~(x)
  if~ x % 2 == 1 {
    prev~(x) + m * 2
  } else {
    x + m * 3
  }
}

pub flow tick_in_an_arm(x: U32 at sample) -> U32 at sample {
  let m = ev~(x)
  if~ x > 5 {
    prev~(x) + (m + sample_tick())
  } else {
    x
  }
}

pub flow reset_in_arms(x: U32 at sample) -> U32 at sample {
  let d = hit~(x, 3)
  if~ x % 2 == 0 {
    acc~(hit~(x, 2)).reset_if~(d == 6)
  } else {
    acc~(hit~(x, 3)).reset_if~(d == 9)
  }
}

pub flow when_in_an_arm(x: U32 at sample) -> U32 at sample {
  let d = hit~(x, 3)
  if~ x > 5 {
    run~(x).when~(d % 2 == 1)
  } else {
    x
  }
}

test "a computed expression of an event in an arm is computed at the events of both arms, and read at the frame as the last value (0 before the first event)" {
  // m * 2 = 0 6 6 6 10 10 10 14 18 18 18 22 and m * 3 = 0 9 9 9 15 15 15 21 27 27 27 33 as last values: the odd x take prev~(x) + m * 2, the even x take x + m * 3.
  // The second flow has m + sample_tick() (the event of the frame t gives m + t: 4@1 9@4 14@7 17@8 22@11) in the arm x > 5, and x elsewhere.
  let a = part_in_arms.render(XS, 8.0)
  let b = tick_in_an_arm.render(XS, 8.0)
  let wa: [U32; 12] = [2, 8, 13, 15, 16, 23, 25, 24, 25, 39, 41, 36]
  let wb: [U32; 12] = [2, 3, 4, 8, 5, 14, 17, 24, 24, 26, 29, 36]
  for t in 0 ..< 12 {
    assert a.out[t] == wa[t] && b.out[t] == wb[t]
  }
}

test "reset_if~ of an event in an arm resets its receiver at the event, chosen or not; when~ of an event in an arm reads the last value as a level" {
  // reset_in_arms: the even arm sums hit 2 and is reset at d = 6 (the frame 3, before the 6 of that frame is added), the odd arm sums hit 3 and is reset at d = 9 (the frame 8). when_in_an_arm: run is active where the last d is odd (the frames 1 2 8),
  // so it is 3 7 at 1 2 and 16 from 8; the arm is chosen where x > 5 (the frames 3 5 6 7 8 9 10 11) and gives the held run: 7 7 7 7 16 16 16 16.
  let a = reset_in_arms.render(XS, 8.0)
  let b = when_in_an_arm.render(XS, 8.0)
  let wa: [U32; 12] = [2, 3, 6, 6, 9, 14, 24, 9, 9, 36, 50, 21]
  let wb: [U32; 12] = [2, 3, 4, 7, 5, 7, 7, 7, 16, 16, 16, 16]
  for t in 0 ..< 12 {
    assert a.out[t] == wa[t] && b.out[t] == wb[t]
  }
}

// ---- an if~ in an if~, a par~ in an if~, an if~ in a par~

pub flow nested_if(x: U32 at sample) -> U32 at sample {
  let m = ev~(x)
  if~ x % 2 == 0 {
    if~ big(m) {
      acc~(hit~(x, 2))
    } else {
      acc~(hit~(x, 3))
    }
  } else {
    cnt~(hit~(x, 2))
  }
}

pub flow par_in_arms(x: U32 at sample) -> [U32; 2] at sample {
  if~ x % 2 == 1 {
    par~ i in 0 ..< 2 { acc~(hit~(x, i + 2)) }
  } else {
    par~ i in 0 ..< 2 { acc~(hit~(x, i + 3)) }
  }
}

pub flow if_in_a_par(x: U32 at sample) -> [U32; 2] at sample {
  par~ i in 0 ..< 2 {
    if~ x % 2 == i {
      acc~(hit~(x, 2))
    } else {
      acc~(hit~(x, 3))
    }
  }
}

test "an if~ in an if~ runs the inner arms too: the outer chooses the inner if~ for even x, a counter of hit 2 for odd x" {
  // The counts of hit 2 are 1 1 2 3 3 4 5 5 5 6 7 7. Even x chooses the inner if~, A where big(m) (from the frame 7) else B.
  let o = nested_if.render(XS, 8.0)
  let w: [U32; 12] = [0, 1, 3, 9, 3, 9, 9, 5, 5, 42, 56, 7]
  for t in 0 ..< 12 {
    assert o.out[t] == w[t]
  }
}

test "a par~ with events in the arms of an if~, and an if~ with events in a par~: the divisors and the choice of each replica" {
  // par_in_arms: odd x takes the sums of hit 2 and hit 3, even x those of hit 3 and hit 4. if_in_a_par: the replica i takes A where x % 2 == i, else B.
  let a = par_in_arms.render(XS, 8.0)
  let b = if_in_a_par.render(XS, 8.0)
  let a0: [U32; 12] = [0, 2, 3, 9, 12, 9, 9, 30, 30, 30, 30, 56]
  let a1: [U32; 12] = [0, 3, 4, 4, 9, 12, 12, 9, 18, 24, 24, 30]
  let b0: [U32; 12] = [2, 3, 6, 12, 9, 20, 30, 9, 18, 42, 56, 30]
  let b1: [U32; 12] = [0, 2, 3, 9, 12, 9, 9, 30, 30, 30, 30, 56]
  for t in 0 ..< 12 {
    assert a.out[0][t] == a0[t] && a.out[1][t] == a1[t]
    assert b.out[0][t] == b0[t] && b.out[1][t] == b1[t]
  }
}

// ---- an if~ and a match~ in the first argument of a delay: the event clock is the clock of the delay

pub flow if_in_a_delay(x: U32 at sample) -> U32 at sample {
  let m = ev~(x)
  prev~(if~ m > 4 {
    prev~(m)
  } else {
    m
  })
}

pub flow match_in_a_delay(x: U32 at sample) -> U32 at sample {
  let m = ev~(x)
  prev~(match~ m {
    3 => prev~(m),
    v => v + 100,
  })
}

test "an if~ and a match~ with a delay of an event in the first argument of a delay: the inner delay runs in both arms at each event" {
  // m = 3 5 7 9 11. prev~(m) gives 0 3 5 7 9. The if~ takes m where m <= 4 and prev~(m) else: 3 3 5 7 9, the outer delay gives 0 3 3 5 7 (at the events 1 4 7 8 11). The match~ takes prev~(m) at 3 and v + 100 else: 0 105 107 109 111,
  // the outer delay gives 0 0 105 107 109.
  let a = if_in_a_delay.render(XS, 8.0)
  let b = match_in_a_delay.render(XS, 8.0)
  let wa: [U32; 12] = [0, 0, 0, 0, 3, 3, 3, 3, 5, 5, 5, 7]
  let wb: [U32; 12] = [0, 0, 0, 0, 0, 0, 0, 105, 107, 107, 107, 109]
  for t in 0 ..< 12 {
    assert a.out[t] == wa[t] && b.out[t] == wb[t]
  }
}
