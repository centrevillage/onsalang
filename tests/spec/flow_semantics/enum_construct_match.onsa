// onsa.toml
// [test]
// mode = "test"
// spec = ["§11.2", "§11.5", "§4.4", "§7"]

// Enums built in a flow body and taken apart by a `match` with a nested pattern and with a guard
// (S-195, §11.2, §7). Kept apart from enum_construct.onsa: the rules of the flow body are the
// same, but a `match` over these patterns takes the general path of the value `match` of the
// interpreter (R-06), which fails today with "local read before initialization" for the same
// patterns in a plain function (match_general.onsa).

pub enum Mode {
  Off,
  Gain(F32),
  Mix(F32, F32),
}

// An enum inside an enum, matched with a nested pattern.
pub flow nested(x: F32 at sample, g: F32 at block) -> F32 at sample {
  let o = Some(Mode.Gain(g))
  match o {
    Some(Mode.Gain(k)) => x * k,
    Some(_) => 0.0,
    None => 0.0,
  }
}

// A guard on a built value.
pub flow guarded(x: F32 at sample, g: F32 at block) -> F32 at sample {
  let m = Mode.Gain(g)
  match m {
    Mode.Gain(k) if k > 1.0 => x * k,
    Mode.Gain(_) => x,
    _ => 0.0,
  }
}

test "Some(Mode.Gain(g)) is matched with a nested pattern" {
  let xs: [F32; 2] = [1.0, 4.0]
  let o = nested.render(nested.Config {}, nested.Params { g: 0.5 }, xs, 8.0)
  assert o.out[0] == 0.5
  assert o.out[1] == 2.0
}

test "a guard on the payload of a built value" {
  let xs: [F32; 2] = [2.0, 3.0]
  let big = guarded.render(guarded.Config {}, guarded.Params { g: 2.0 }, xs, 8.0)
  assert big.out[0] == 4.0
  assert big.out[1] == 6.0
  let small = guarded.render(guarded.Config {}, guarded.Params { g: 0.5 }, xs, 8.0)
  assert small.out[0] == 2.0
  assert small.out[1] == 3.0
}
