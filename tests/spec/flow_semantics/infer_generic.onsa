// onsa.toml
// [test]
// mode = "test"
// spec = ["§4.5", "§4.7", "§11.5", "§10"]

// The inference of the type parameters of a generic call works in a flow body as in a fn body:
// a parameter that only an argument of the flow decides, a float literal that follows it, and
// the same inside `par` (spec §4.5, §4.7, §11.5; S-174, R-148). The clock inference is laid
// over it and does not change the types (§4.7 "flow の本体では、同じ推論にクロックの推論を重ねる").
//
// Every value below is worked out by hand from the spec text.

rt fn second[T: Copy](a: T, b: T) -> T {
  b
}

rt fn first[T: Copy](a: T, b: T) -> T {
  a
}

// The float literal 0.5 takes the type of the sample x (F32).
pub flow shifted(x: F32 at sample) -> F32 at sample {
  x + second(x, 0.5)
}

// The call is inside each replica; the literal is typed by x in every replica.
pub flow replicated(x: F32 at sample) -> F32 at sample {
  let rows = par i in 0..<2 { x + second(x, 0.25) }
  rows[0] + rows[1]
}

// A parameter decided by the later `+ x`: the result of `first` is F32.
pub flow chained(x: F32 at sample) -> F32 at sample {
  let a = first(0.5, 0.25)
  a + x
}

test "a literal takes the type of the sample that decides T" {
  // x + 0.5 for x = 1, 2.
  let xs: [F32; 2] = [1.0, 2.0]
  let o = shifted.render(shifted.Config {}, shifted.Params {}, xs, 8.0)
  assert o.out[0] == 1.5
  assert o.out[1] == 2.5
}

test "the same inside par" {
  // (x + 0.25) twice: 2x + 0.5 for x = 1, 2.
  let xs: [F32; 2] = [1.0, 2.0]
  let o = replicated.render(replicated.Config {}, replicated.Params {}, xs, 8.0)
  assert o.out[0] == 2.5
  assert o.out[1] == 4.5
}

test "a parameter decided by a later statement" {
  // first(0.5, 0.25) is 0.5; the sum with x decides the literals as F32: 0.5 + x.
  let xs: [F32; 2] = [1.0, 2.0]
  let o = chained.render(chained.Config {}, chained.Params {}, xs, 8.0)
  assert o.out[0] == 1.5
  assert o.out[1] == 2.5
}
