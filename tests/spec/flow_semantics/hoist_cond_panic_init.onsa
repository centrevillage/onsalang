// onsa.toml
// [test]
// mode = "test"
// spec = ["§11.3", "§11.6", "§9.2"]

// W7-05 U2/t, S-1157 (D'), S-1093 (spec §11.3): a part of `init` whose conditions are all decided at `init` is evaluated at `init`, once, when the conditions hold
// ("式のクロックと条件の段のうち最も速い段で、条件が成り立つときだけ評価する"; "`init` の段の式の panic は `init` で起きる"). So its division by zero is a panic of `init`,
// before any call of `process`, and where the conditions do not hold `init` does not panic and the value is the other branch's. `a` and `b` are the `init` inputs, `x` the `sample` input.
// The divisor `a - 1` is 0 for a = 1. The guard of `block` over a part of `init` is in hoist_cond_panic_block.onsa.

pub flow guard_true(x: F32 at sample, a: I32 at init) -> F32 at sample {
  if a != 0 { x * F32.round_from(100 / (a - 1)) } else { x }
}

pub flow else_branch(x: F32 at sample, a: I32 at init) -> F32 at sample {
  if a == 0 { x } else { x * F32.round_from(100 / (a - 1)) }
}

pub flow two_conditions(x: F32 at sample, a: I32 at init, b: I32 at init) -> F32 at sample {
  if a != 0 && b > 2 { x * F32.round_from(100 / (b - 3)) } else { x }
}

pub flow nested_conditions(x: F32 at sample, a: I32 at init, b: I32 at init) -> F32 at sample {
  if a != 0 {
    if b != 0 { x * F32.round_from(100 / (a - b)) } else { x }
  } else {
    x
  }
}

pub flow and_right(x: F32 at sample, a: I32 at init) -> F32 at sample {
  if a != 0 && F32.round_from(100 / (a - 1)) > x { 1.0 } else { 0.0 }
}

pub flow match_arm(x: F32 at sample, o: Option[I32] at init) -> F32 at sample {
  match o {
    Some(v) => x * F32.round_from(100 / (v - 1)),
    None => x,
  }
}

test "a part of init in a branch whose condition holds panics at init" {
  let _ = guard_true.init(guard_true.Config { a: 1 }, 8.0) //~ PANIC "a part of init in a branch whose condition holds panics at init"
}

test "the else branch that is taken panics at init" {
  let _ = else_branch.init(else_branch.Config { a: 0 }, 8.0)
  let _ = else_branch.init(else_branch.Config { a: 1 }, 8.0) //~ PANIC "the else branch that is taken panics at init"
}

test "two conditions of init: the part is evaluated at init when both hold" {
  // (a, b) = (0, 3): the first does not hold; (1, 2): the second does not hold; (1, 3): both hold and 100 / (3 - 3) divides by zero.
  let _ = two_conditions.init(two_conditions.Config { a: 0, b: 3 }, 8.0)
  let _ = two_conditions.init(two_conditions.Config { a: 1, b: 2 }, 8.0)
  let _ = two_conditions.init(two_conditions.Config { a: 1, b: 3 }, 8.0) //~ PANIC "two conditions of init: the part is evaluated at init when both hold"
}

test "nested conditions of init: the innermost part is evaluated at init when all hold" {
  // (a, b) = (0, 1): the outer does not hold; (2, 0): the inner does not hold; (3, 3): both hold and 100 / (3 - 3) divides by zero.
  let _ = nested_conditions.init(nested_conditions.Config { a: 0, b: 1 }, 8.0)
  let _ = nested_conditions.init(nested_conditions.Config { a: 2, b: 0 }, 8.0)
  let _ = nested_conditions.init(nested_conditions.Config { a: 3, b: 3 }, 8.0) //~ PANIC "nested conditions of init: the innermost part is evaluated at init when all hold"
}

test "the right side of && is evaluated at init where the left side holds" {
  let _ = and_right.init(and_right.Config { a: 0 }, 8.0)
  let _ = and_right.init(and_right.Config { a: 1 }, 8.0) //~ PANIC "the right side of && is evaluated at init where the left side holds"
}

test "an arm reads what its pattern binds at init: Some(1) divides by zero, None does not" {
  let _ = match_arm.init(match_arm.Config { o: None }, 8.0)
  let _ = match_arm.init(match_arm.Config { o: Some(3) }, 8.0)
  let _ = match_arm.init(match_arm.Config { o: Some(1) }, 8.0) //~ PANIC "an arm reads what its pattern binds at init: Some(1) divides by zero, None does not"
}
