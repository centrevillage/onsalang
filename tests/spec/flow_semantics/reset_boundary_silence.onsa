// onsa.toml
// [package]
// name = "reset_boundary_silence"
// edition = "2026"
//
// [export]
// prefix = "rs_"
// flows = ["reset_boundary_silence.fragile", "reset_boundary_silence.guarded"]
//
// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "poison"
// provides = []
//
// [test]
// spec = ["§9.2", "§14.2", "§11.6"]
//
// # The silence of an instance that `reset` has not recovered (S-198, S-199, R-12), kept apart
// # from reset_boundary.onsa (the behaviour of `reset` itself): a poisoned or uninitialized
// # instance returns 1 from every `process`, and the output is zero whatever the buffer held
// # (the driver fills the buffer with a pattern, so an unwritten buffer differs from zeros).
// # The groups hold only the steps that make the state and the step that shows the silence.
//
// # The poisoned instance stays poisoned for the calls after the panicking one, whatever the
// # input, until `reset` (§9.2): the call returns 1 and its output is silence.
// [[test.host]]
// name = "a poisoned instance stays silent until reset"
// target = "host"
// flow = "reset_boundary_silence.fragile"
// steps = [
//   { call = "init", config = {}, sample_rate = 8.0, status = 0 },
//   { call = "process", params = {}, frames = 3, input = [1.0, nan, 3.0], status = 1, output = [0.0, 0.0, 0.0] },
//   { call = "process", params = {}, frames = 3, input = [1.5, 2.5, 3.5], status = 1, output = [0.0, 0.0, 0.0] },
//   { call = "reset" },
//   { call = "process", params = {}, frames = 3, input = [1.5, 2.5, 3.5], status = 0, output = [2.0, 4.0, 6.0] },
// ]
//
// # The uninitialized instance after `reset`: `process` returns 1 and the output is silence
// # (§14.2).
// [[test.host]]
// name = "an uninitialized instance stays silent after reset"
// target = "host"
// flow = "reset_boundary_silence.guarded"
// steps = [
//   { call = "init", config = { n = 0 }, sample_rate = 48000.0, status = 1 },
//   { call = "reset" },
//   { call = "process", params = {}, frames = 2, input = [1.0, 1.0], status = 1, output = [0.0, 0.0] },
// ]
//
// # A failed `init` after a good one leaves the instance uninitialized: `reset` does nothing and
// # `process` is silent.
// [[test.host]]
// name = "a failed init after a good one is silent after reset"
// target = "host"
// flow = "reset_boundary_silence.guarded"
// steps = [
//   { call = "init", config = { n = 4 }, sample_rate = 48000.0, status = 0 },
//   { call = "process", params = {}, frames = 2, input = [1.0, 1.0], status = 0, output = [26.0, 27.0] },
//   { call = "init", config = { n = 0 }, sample_rate = 48000.0, status = 1 },
//   { call = "reset" },
//   { call = "process", params = {}, frames = 2, input = [1.0, 1.0], status = 1, output = [0.0, 0.0] },
// ]

// A running sum from `start`: the state is the previous sum.
pub flow counter(x: F32 at sample, start: F32 at init) -> F32 at sample {
  let y = x + prev~(^y, start)
  y
}

// Panics for a NaN input or one outside I32 (`trunc_i32`): the instance is poisoned.
pub flow fragile(x: F32 at sample) -> F32 at sample {
  let n = x.trunc_i32()
  let c = counter~(1.0, 0.0)
  c + n.round_f32()
}

// `100 / n` is computed once at init: n = 0 panics inside `init`. The sum is the state.
pub flow guarded(x: F32 at sample, n: I32 at init) -> F32 at sample {
  let k = 100 / n
  let y = x + prev~(^y)
  y + k.round_f32()
}
