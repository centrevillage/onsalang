// onsa.toml
// [test]
// mode = "test"
// spec = ["§11.5", "§3.5", "§11.4"]

// W7-06 U2/t, S-110, R-14 (spec §11.5: "`if~ c { a } else { b }` は、全ての枝を評価してから一つを選ぶ。全ての枝の状態を持つものが進み、
// 状態を持たない部分も全て評価される"): an `if~` advances the state of every branch on every sample, whether the branch is chosen or not,
// and `~` covers the whole `else if` chain. A plain `if` that is written inside a branch takes only one of its own branches (the example of
// §11.5: `if~ c { lp~(x) } else { if d != 0 { 100 / d } else { 0 } }`). Every value is worked out by hand. The `match~` forms are in
// branches_tilde.onsa; the panic of a branch that is not taken is in if_tilde_select_order.onsa.
//
// `acc~(1.0)` counts the samples since the start: 1, 2, 3, ... (`acc` is a running sum).

pub flow acc(x: F32 at sample) -> F32 at sample {
  let y = x + prev~(^y)
  y
}

pub flow twice(x: F32 at sample) -> F32 at sample {
  x * 2.0
}

// The state is in the branch that is chosen when `x > 2`.
pub flow state_in_the_then_branch(x: F32 at sample) -> F32 at sample {
  if~ x > 2.0 { acc~(1.0) } else { 0.0 }
}

// The state is in the `else`, which is not chosen while `x > 2`.
pub flow state_in_the_else_branch(x: F32 at sample) -> F32 at sample {
  if~ x > 2.0 { 0.0 } else { acc~(1.0) }
}

// Both branches hold a counter.
pub flow a_counter_in_each_branch(x: F32 at sample) -> F32 at sample {
  if~ x > 2.0 { acc~(1.0) } else { acc~(10.0) }
}

// The `~` of the chain covers every branch: three counters run on every sample.
pub flow a_chain_of_three(x: F32 at sample) -> F32 at sample {
  if~ x >= 3.0 { acc~(1.0) } else if x >= 2.0 { acc~(100.0) } else { acc~(1000.0) }
}

// A counter in the branch of the second condition and in the last `else` only.
pub flow state_in_the_later_branches(x: F32 at sample) -> F32 at sample {
  if~ x >= 3.0 { 0.0 } else if x >= 2.0 { acc~(1.0) } else { acc~(10.0) }
}

// An `if~` written as the `else` of another one is a branch of it: all three counters run.
pub flow an_if_tilde_in_the_else(x: I32 at sample) -> F32 at sample {
  let a = x >= 2
  let b = x >= 3
  if~ a { acc~(1.0) } else { if~ b { acc~(10.0) } else { acc~(100.0) } }
}

// A delay in a branch that is not chosen still moves.
pub flow a_delay_in_the_untaken_branch(x: F32 at sample) -> F32 at sample {
  let late = x > 2.0
  if~ late { prev~(x) } else { x }
}

// An `if~` as the value of a `let`.
pub flow the_value_of_a_let(x: F32 at sample) -> F32 at sample {
  let v = if~ x > 2.0 { acc~(1.0) } else { 0.0 }
  v * 2.0
}

// The instance of a flow is a thing with state by the kind of its callee, so it is a branch with state although `twice` holds none.
pub flow an_instance_of_a_flow_without_state(x: F32 at sample) -> F32 at sample {
  if~ x > 0.0 { twice~(x) } else { 0.0 }
}

// A plain `if` in a branch takes one of its branches: `100 / d` is not evaluated when `d` is 0, although the branch is.
pub flow a_plain_if_in_a_branch(d: I32 at sample) -> F32 at sample {
  let positive = d > 0
  if~ positive { acc~(1.0) } else { if d != 0 { F32.round_from(100 / d) } else { 0.0 } }
}

test "the counter of the then branch runs on the samples where it is not chosen" {
  // x > 2 is F T F T T; the counter runs 1 2 3 4 5.
  let xs: [F32; 5] = [1.0, 3.0, 1.0, 3.0, 3.0]
  let o = state_in_the_then_branch.render(xs, 8.0)
  assert o.out[0] == 0.0
  assert o.out[1] == 2.0
  assert o.out[2] == 0.0
  assert o.out[3] == 4.0
  assert o.out[4] == 5.0
}

test "the counter of the else branch runs on the samples where it is not chosen" {
  // x > 2 is T F T F F; the counter runs 1 2 3 4 5, chosen on the samples 1, 3, 4.
  let xs: [F32; 5] = [3.0, 1.0, 3.0, 1.0, 1.0]
  let o = state_in_the_else_branch.render(xs, 8.0)
  assert o.out[0] == 0.0
  assert o.out[1] == 2.0
  assert o.out[2] == 0.0
  assert o.out[3] == 4.0
  assert o.out[4] == 5.0
}

test "a counter in each branch runs both" {
  // 1s: 1 2 3 4 5.  10s: 10 20 30 40 50.  x > 2 is F T F T T: else, then, else, then, then.
  let xs: [F32; 5] = [1.0, 3.0, 1.0, 3.0, 3.0]
  let o = a_counter_in_each_branch.render(xs, 8.0)
  assert o.out[0] == 10.0
  assert o.out[1] == 2.0
  assert o.out[2] == 30.0
  assert o.out[3] == 4.0
  assert o.out[4] == 5.0
}

test "the tilde of an else if chain covers every branch" {
  // 1s: 1 2 3 4.  100s: 100 200 300 400.  1000s: 1000 2000 3000 4000.  x = 1 2 3 2 takes the 1000s, the 100s, the 1s, the 100s.
  let xs: [F32; 4] = [1.0, 2.0, 3.0, 2.0]
  let o = a_chain_of_three.render(xs, 8.0)
  assert o.out[0] == 1000.0
  assert o.out[1] == 200.0
  assert o.out[2] == 3.0
  assert o.out[3] == 400.0
}

test "the counters of the later branches of a chain run on the samples where they are not chosen" {
  // 1s (second branch): 1 2 3 4.  10s (else): 10 20 30 40.  x = 3 2 1 2: 0.0, the 1s, the 10s, the 1s.
  let xs: [F32; 4] = [3.0, 2.0, 1.0, 2.0]
  let o = state_in_the_later_branches.render(xs, 8.0)
  assert o.out[0] == 0.0
  assert o.out[1] == 2.0
  assert o.out[2] == 30.0
  assert o.out[3] == 4.0
}

test "an if tilde in the else of an if tilde runs all three counters" {
  // a = F F T T, b = F F F T.  1s: 1 2 3 4.  10s: 10 20 30 40.  100s: 100 200 300 400.
  // x = 0 1 2 3 takes the 100s, the 100s, the 1s, the 1s.
  let xs: [I32; 4] = [0, 1, 2, 3]
  let o = an_if_tilde_in_the_else.render(xs, 8.0)
  assert o.out[0] == 100.0
  assert o.out[1] == 200.0
  assert o.out[2] == 3.0
  assert o.out[3] == 4.0
}

test "the else of an if tilde that is an if tilde is chosen by its own condition" {
  // The same flow with x = 3 3 0: the outer `a` is true on the first two (the 1s: 1, 2), and the third takes the else of the inner
  // `if~` (the 100s: 300).
  let xs: [I32; 3] = [3, 3, 0]
  let o = an_if_tilde_in_the_else.render(xs, 8.0)
  assert o.out[0] == 1.0
  assert o.out[1] == 2.0
  assert o.out[2] == 300.0
}

test "a delay in a branch that is not chosen still moves" {
  // late = F F T T.  The delay stores x on every sample, its outputs are 0 1 2 3, so the output is x, x, prev(x), prev(x) = 1, 2, 2, 3.
  let xs: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  let o = a_delay_in_the_untaken_branch.render(xs, 8.0)
  assert o.out[0] == 1.0
  assert o.out[1] == 2.0
  assert o.out[2] == 2.0
  assert o.out[3] == 3.0
}

test "an if tilde as the value of a let" {
  // x > 2 is F T T; the counter runs 1 2 3; v = 0 2 3; v * 2 = 0 4 6.
  let xs: [F32; 3] = [1.0, 3.0, 3.0]
  let o = the_value_of_a_let.render(xs, 8.0)
  assert o.out[0] == 0.0
  assert o.out[1] == 4.0
  assert o.out[2] == 6.0
}

test "an instance of a flow without state is a branch with state" {
  let xs: [F32; 2] = [1.5, -1.0]
  let o = an_instance_of_a_flow_without_state.render(xs, 8.0)
  assert o.out[0] == 3.0
  assert o.out[1] == 0.0
}

test "a plain if in a branch evaluates only the branch it takes" {
  // d = 0 5 -4 20: positive is F T F T.  The counter runs 1 2 3 4.  On the samples that are not positive the plain `if` takes
  // `0.0` for d = 0 (no division) and 100 / -4 = -25 for d = -4.
  let ds: [I32; 4] = [0, 5, -4, 20]
  let o = a_plain_if_in_a_branch.render(ds, 8.0)
  assert o.out[0] == 0.0
  assert o.out[1] == 2.0
  assert o.out[2] == -25.0
  assert o.out[3] == 4.0
}
