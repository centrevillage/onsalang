// onsa.toml
// [test]
// mode = "test"
// spec = ["§11.3", "§11.6", "§6.6"]

// A `let` that names a compile-time constant (`let l0 = K`) is a value of the constant clock
// (spec §11.3: "const とリテラル。クロックを持たず、どのクロックにも昇格する"), and a later `let` of
// a faster clock reads it like any other name: "同じ式を const に分けても分けなくても、同じビットになる"
// and "let に分けても分けなくても、評価の段と結果は同じ". So `let l0 = K` followed by `x + l0` is
// `x + K`, whatever the form of the constant. The expected values are worked out by hand.
//
// The alias here is read by a faster `let` or by the output expression (these pass now). A `let` of
// the constant clock that reads another `let` of the constant clock (`let b = l0 * l0`) is in
// flow_const_alias_derived_kinds.onsa (R-488). This file takes the kinds of the constant: a scalar
// `const`, a `const` array and tuple (whole or by index and field), the associated constants (§6.6),
// a constant expression (`K * 2`, `-K`, a call of a function on constants, which is of the constant
// clock whether it is `rt` or not), a Bool constant, a literal. The stages that read the alias are in
// flow_const_alias_stages.onsa, the order of the `let`s and repeated calls of `process` are in
// flow_const_alias_order.onsa, and a constant of another module is in flow_const_alias_module.

const K: I32 = 2
const K2: I32 = K * 2
const FK: F32 = 0.5
const TBL: [I32; 3] = [10, 20, 30]
const PAIR: (I32, I32) = (3, 4)
const ON: Bool = true
const OFF: Bool = false

rt fn twice(a: I32) -> I32 {
  a * 2
}

fn twice_init(a: I32) -> I32 {
  a * 2
}

// An alias of a literal is read in the same way.
pub flow literal_alias(p: I32 at block) -> I32 at sample {
  let l0 = 2
  p * l0
}

pub flow scalar_float(p: F32 at block) -> F32 at sample {
  let l0 = FK
  p * l0
}

pub flow array_elem(p: I32 at block) -> I32 at sample {
  let l0 = TBL[1]
  p + l0
}

pub flow array_whole(p: I32 at block) -> I32 at sample {
  let l0 = TBL
  l0[2] + p
}

pub flow tuple_field(p: I32 at block) -> I32 at sample {
  let l0 = PAIR.1
  p * l0
}

pub flow tuple_whole(p: I32 at block) -> I32 at sample {
  let l0 = PAIR
  l0.0 + l0.1 + p
}

pub flow assoc_float(p: F32 at block) -> F32 at sample {
  let l0 = F32.PI
  p * l0
}

pub flow assoc_int(p: I32 at block) -> I32 at sample {
  let l0 = I32.MAX
  l0 - p
}

pub flow assoc_bits(p: U32 at block) -> U32 at sample {
  let l0 = I32.BITS
  l0 + p
}

pub flow assoc_one(p: I32 at block) -> I32 at sample {
  let l0 = I32.ONE
  p + l0
}

pub flow const_of_const(p: I32 at block) -> I32 at sample {
  let l0 = K2
  p + l0
}

pub flow arith(p: I32 at block) -> I32 at sample {
  let l0 = K * 3 + 1
  p + l0
}

pub flow negated(p: I32 at block) -> I32 at sample {
  let l0 = -K
  p + l0
}

pub flow call_rt(p: I32 at block) -> I32 at sample {
  let l0 = twice(K)
  p + l0
}

pub flow call_init_fn(p: I32 at block) -> I32 at sample {
  let l0 = twice_init(K)
  p + l0
}

pub flow bool_true(p: I32 at block) -> I32 at sample {
  let l0 = ON
  if l0 { p } else { 0 }
}

pub flow bool_false(p: I32 at block) -> I32 at sample {
  let l0 = OFF
  if l0 { p } else { 0 }
}

// The same constant read through an alias and by its name give the same value.
pub flow alias_and_name(p: I32 at block) -> I32 at sample {
  let l0 = K
  let a = p * l0
  a + K
}

test "an alias of a literal read by a block let" {
  // 5 * 2.
  let o = literal_alias.render(literal_alias.Params { p: 5 }, 2, 8.0)
  assert o.out[0] == 10
  assert o.out[1] == 10
}

test "a floating-point constant alias" {
  // 3.0 * 0.5
  let o = scalar_float.render(scalar_float.Params { p: 3.0 }, 2, 8.0)
  assert o.out[0] == 1.5
  assert o.out[1] == 1.5
}

test "an element of a constant array" {
  // TBL[1] = 20; 1 + 20.
  let o = array_elem.render(array_elem.Params { p: 1 }, 1, 8.0)
  assert o.out[0] == 21
}

test "a whole constant array" {
  // TBL[2] = 30; 30 + 1.
  let o = array_whole.render(array_whole.Params { p: 1 }, 1, 8.0)
  assert o.out[0] == 31
}

test "a field of a constant tuple" {
  // PAIR.1 = 4; 3 * 4.
  let o = tuple_field.render(tuple_field.Params { p: 3 }, 1, 8.0)
  assert o.out[0] == 12
}

test "a whole constant tuple" {
  // 3 + 4 + 1.
  let o = tuple_whole.render(tuple_whole.Params { p: 1 }, 1, 8.0)
  assert o.out[0] == 8
}

test "the associated constant PI of F32" {
  // 2.0 * PI is the exact scaling by a power of two.
  let o = assoc_float.render(assoc_float.Params { p: 2.0 }, 1, 8.0)
  assert o.out[0] == F32.PI * 2.0
}

test "the associated constant MAX of I32" {
  // 2147483647 - 5.
  let o = assoc_int.render(assoc_int.Params { p: 5 }, 1, 8.0)
  assert o.out[0] == 2147483642
}

test "the associated constant BITS of I32 is a U32" {
  // 32 + 1.
  let o = assoc_bits.render(assoc_bits.Params { p: 1 }, 1, 8.0)
  assert o.out[0] == 33
}

test "the associated constant ONE of I32" {
  let o = assoc_one.render(assoc_one.Params { p: 41 }, 1, 8.0)
  assert o.out[0] == 42
}

test "a constant defined by another constant" {
  // K2 = 4; 1 + 4.
  let o = const_of_const.render(const_of_const.Params { p: 1 }, 1, 8.0)
  assert o.out[0] == 5
}

test "an arithmetic expression of constants" {
  // 2 * 3 + 1 = 7; 1 + 7.
  let o = arith.render(arith.Params { p: 1 }, 1, 8.0)
  assert o.out[0] == 8
}

test "a negated constant" {
  // 1 + (-2).
  let o = negated.render(negated.Params { p: 1 }, 1, 8.0)
  assert o.out[0] == -1
}

test "a call of an rt fn on a constant" {
  // twice(2) = 4; 1 + 4.
  let o = call_rt.render(call_rt.Params { p: 1 }, 1, 8.0)
  assert o.out[0] == 5
}

test "a call of a non-rt fn on a constant" {
  // twice_init(2) = 4; 1 + 4.
  let o = call_init_fn.render(call_init_fn.Params { p: 1 }, 1, 8.0)
  assert o.out[0] == 5
}

test "a true constant Bool picks the first branch" {
  let o = bool_true.render(bool_true.Params { p: 7 }, 1, 8.0)
  assert o.out[0] == 7
}

test "a false constant Bool picks the second branch" {
  let o = bool_false.render(bool_false.Params { p: 7 }, 1, 8.0)
  assert o.out[0] == 0
}

test "the alias and the name of the constant have the same value" {
  // 3 * 2 + 2.
  let o = alias_and_name.render(alias_and_name.Params { p: 3 }, 1, 8.0)
  assert o.out[0] == 8
}
