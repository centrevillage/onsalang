// onsa.toml
// [test]
// mode = "test"
// spec = ["§11.3", "§9.2"]

// W7-09 U2s/t, S-1166, S-1196 (spec §11.3): the guard of an arm of a `match` is a condition the arm after it is under ("`match` の対象とその腕までのパターンとガード"), and "条件が決まる段は、
// その条件を評価する段と、条件の式のクロック（`at` で付けたクロックを含む）の段のうち速い方である". So the arm of `Some(v) if (v != 0) at sample` is under a condition that `sample` decides: its `block` part
// `100 / (v - 1)` is not made at `block` and is evaluated by the frame that takes the arm (a call of 0 frames does not panic). This is the guard of hoist_cond_match_forms.onsa with `at sample`; the value of a `match` with
// a guard is E0200 until W8-06 (R-06), so this case waits for it. `x` is the `sample` input, `o` of `block`; `v - 1` is 0 for v = 1.

pub flow guard_at_sample(x: F32 at sample, o: Option[I32] at block) -> F32 at sample {
  match o {
    Some(v) if (v != 0) at sample => x * F32.round_from(100 / (v - 1)),
    Some(_) => x,
    None => 0.0,
  }
}

test "a guard with at sample: Some(1) does not divide in a call of 0 frames; Some(0) gives x, Some(6) gives x * 20, None gives 0.0" {
  let xs: [F32; 1] = [2.0]
  var out: [F32; 1] = [7.0]
  var st = guard_at_sample.init(8.0)
  guard_at_sample.process(inout st, guard_at_sample.Params { o: Some(1) }, xs.slice(0, 0), inout out.slice(0, 0))
  assert out[0] == 7.0
  guard_at_sample.process(inout st, guard_at_sample.Params { o: Some(0) }, xs, inout out)
  assert out[0] == 2.0
  guard_at_sample.process(inout st, guard_at_sample.Params { o: Some(6) }, xs, inout out)
  assert out[0] == 40.0
  guard_at_sample.process(inout st, guard_at_sample.Params { o: None }, xs, inout out)
  assert out[0] == 0.0
}

test "a guard with at sample: Some(1) panics in the frame that takes the arm" {
  let xs: [F32; 1] = [2.0]
  let o = guard_at_sample.render(guard_at_sample.Params { o: Some(1) }, xs, 8.0) //~ PANIC "a guard with at sample: Some(1) panics in the frame that takes the arm"
  assert o.out[0] == 0.0
}
