// onsa.toml
// [test]
// mode = "test"
// spec = ["§11.3", "§11.6", "§9.2"]

// W7-16 U5a/t, S-565, S-1196 (spec §11.3: "段が刻みの計算した部分式は、より速い式の中でもその刻みで評価し"、"panic は、評価する段が動けば起きる"; §11.6: "長さが 0 の呼び出し … `sample` の段は評価しない"):
// the division of a tick of `sample / 4` panics when the tick reads the 0, at the frame of that tick and not at the frames between the ticks, and not in a call that holds no frame of a tick. Worked
// out by hand: `d` is the delay of p at `sample / 4` with the init 1; the part `(100 / d) at sample` is computed at the ticks 0, 4, 8, …

pub flow inv(p: I32 at block) -> I32 at sample {
  let d = prev~(p at (sample / 4), 1)
  (100 / d) at sample
}

test "the division of a tick does not panic between the ticks, whatever the 0 that is stored" {
  // Frame 0 (tick 0) gives d = 1 and stores 0; the frames 1 to 3 hold no tick: 100 is read from the field.
  var out: [I32; 4] = [-1; 4]
  var st = inv.init(8.0)
  inv.process(inout st, inv.Params { p: 0 }, inout out.slice(0, 1))
  inv.process(inout st, inv.Params { p: 0 }, inout out.slice(1, 4))
  assert out[0] == 100
  assert out[1] == 100
  assert out[2] == 100
  assert out[3] == 100
}

test "the division of a tick panics at the tick that reads the 0, in the call that holds it" {
  // The frame 4 is the first frame of the second call: tick 4 gives d = 0 (stored at the tick 0 from p = 0).
  var out: [I32; 5] = [-1; 5]
  var st = inv.init(8.0)
  inv.process(inout st, inv.Params { p: 0 }, inout out.slice(0, 4))
  assert out[3] == 100
  inv.process(inout st, inv.Params { p: 0 }, inout out.slice(4, 5)) //~ PANIC "the division of a tick panics at the tick that reads the 0, in the call that holds it"
  assert out[4] == 100
}

test "a call of 0 frames at the position of a tick does not evaluate the tick" {
  var out: [I32; 5] = [-1; 5]
  var st = inv.init(8.0)
  inv.process(inout st, inv.Params { p: 0 }, inout out.slice(0, 4))
  inv.process(inout st, inv.Params { p: 0 }, inout out.slice(4, 4))
  assert out[3] == 100
  assert out[4] == -1
}

test "a call of 5 frames that holds the tick 4 panics at it" {
  let o = inv.render(inv.Params { p: 0 }, 5, 8.0) //~ PANIC "a call of 5 frames that holds the tick 4 panics at it"
  assert o.out[0] == 100
}

test "the same call does not panic with 4 frames: the tick 4 is not in it" {
  let o = inv.render(inv.Params { p: 0 }, 4, 8.0)
  assert o.out[0] == 100
  assert o.out[3] == 100
}

test "a value that is not 0 is divided at each tick" {
  // p = 4 stored at tick 0 and read at tick 4: 100 / 4 = 25.
  let o = inv.render(inv.Params { p: 4 }, 8, 8.0)
  assert o.out[0] == 100
  assert o.out[3] == 100
  assert o.out[4] == 25
  assert o.out[7] == 25
}
