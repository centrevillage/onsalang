// onsa.toml
// [test]
// spec = ["§4.5", "§15.1", "§18.1", "§11.4", "§11.5"]

// W5-13 U2b, S-989 (3), R-436: the names stage reads a constant expression only inside the grammar of a constant expression (§4.5: "名前の段は、
// 定数式の文法の中（名前の鎖とその `::[…]` の並び、括弧、前置の `-`、算術の演算子の被演算子）だけを読み、文法の外の形（呼び出しと上の形）の中と
// 文字列リテラルの穴は読まない"). A form outside the grammar (a tuple, an `if`, a block, a `match`, a comparison, an array repeat, a call,
// a cast, an index, a `!`) is E0417 whatever the names in it are, so a name that is not found in it (`zz`) and a name that is no value in it
// (`P`) are not read: the E0417 of the form is first, before the E0302 and the E0308 that the same names have in an ordinary expression
// (§4.5: "中の名前の誤り（E0302・E0308）… より、形の E0417 が先である"; §18.1). A name that the names stage has rejected for E0304 (`D`, defined
// twice) is used with no diagnostic where it is the whole expression (§18.1) and the form around it is E0417 (S-968). The forms that the walk of
// a flow body does not read into (a block with a statement, a function value) are only in the heading and the body of a function.
// The places are those of a flow: the length of `delay~`, the maximum of `vdelay~`, the ends of a `par~`, the repeat and the annotation of
// a flow body, and the type of an input.
// These units were in const_grammar_names.onsa before W5-16 U1b1 and passed before it with E0302 and E0308: they are in their own file so that
// a regression of them is not silenced with the units that change.

pub struct Ring[T, const N: U32] {
  data: [T; N],
  head: U32,
}

pub struct P {
  x: U32,
}

const K: U32 = 4
const XS: [U32; 2] = [1, 2]

fn g(a: U32) -> U32 {
  a
}

const D: U32 = 1
const D: U32 = 2   //~ E0304

pub flow unknown_in_a_tuple_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, (zz, 1))   //~ E0417
}

pub flow unknown_in_an_if_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, if true { zz } else { 2 })   //~ E0417
}

pub flow unknown_in_an_if_as_the_end_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<(if true { zz } else { 2 }) { x * F32.round_from(i) }   //~ E0417
  ys[0]
}

pub flow unknown_in_a_block_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, { zz })   //~ E0417
}

pub flow unknown_in_a_block_in_a_flow_repeat(x: F32 at sample) -> F32 at sample {
  let a = [x; { zz }]   //~ E0417
  a[0]
}

pub flow unknown_in_a_match_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, match zz { _ => 1 })   //~ E0417
}

pub flow unknown_in_a_match_in_a_vdelay(x: F32 at sample, d: F32 at sample) -> F32 at sample {
  vdelay~(x, d, match zz { _ => 1 })   //~ E0417
}

pub flow unknown_in_a_match_in_a_flow_annotation(x: F32 at sample) -> F32 at sample {
  let a: [F32; match zz { _ => 1 }] = [x; 4]   //~ E0417
  a[0]
}

pub flow unknown_in_a_comparison_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, zz < 2)   //~ E0417
}

pub flow unknown_in_a_comparison_as_the_start_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in (zz < 2)..<8 { x * F32.round_from(i) }   //~ E0417
  ys[0]
}

pub flow unknown_in_an_array_repeat_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, [zz; 2])   //~ E0417
}

pub flow unknown_in_an_array_repeat_in_a_flow_input(a: [F32; [zz; 2]] at sample) -> F32 at sample {   //~ E0417
  0.0
}

pub flow unknown_in_a_call_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, g(zz))   //~ E0417
}

pub flow unknown_in_a_cast_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, zz as U32)   //~ E0417
}

pub flow unknown_in_a_cast_in_a_vdelay(x: F32 at sample, d: F32 at sample) -> F32 at sample {
  vdelay~(x, d, zz as U32)   //~ E0417
}

pub flow unknown_in_an_index_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, XS[zz])   //~ E0417
}

pub flow unknown_in_an_index_as_the_start_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in XS[zz]..<8 { x * F32.round_from(i) }   //~ E0417
  ys[0]
}

pub flow unknown_in_a_not_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, !zz)   //~ E0417
}

pub flow unknown_in_a_not_as_the_start_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in !zz..<8 { x * F32.round_from(i) }   //~ E0417
  ys[0]
}

pub flow type_in_a_tuple_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, (P, 1))   //~ E0417
}

pub flow type_in_a_tuple_in_a_vdelay(x: F32 at sample, d: F32 at sample) -> F32 at sample {
  vdelay~(x, d, (P, 1))   //~ E0417
}

pub flow type_in_a_comparison_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, P < 2)   //~ E0417
}

pub flow type_in_a_comparison_as_the_start_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in (P < 2)..<8 { x * F32.round_from(i) }   //~ E0417
  ys[0]
}

pub flow type_as_the_condition_of_an_if_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, if P { 1 } else { 2 })   //~ E0417
}

pub flow type_as_the_condition_of_an_if_as_the_end_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<(if P { 1 } else { 2 }) { x * F32.round_from(i) }   //~ E0417
  ys[0]
}

pub flow duplicate_in_an_if_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, if true { D } else { 2 })   //~ E0417
}

pub flow duplicate_in_an_if_in_a_vdelay(x: F32 at sample, d: F32 at sample) -> F32 at sample {
  vdelay~(x, d, if true { D } else { 2 })   //~ E0417
}

pub flow duplicate_in_a_block_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, { D })   //~ E0417
}

pub flow duplicate_in_a_call_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, g(D))   //~ E0417
}

pub flow duplicate_in_a_match_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, match D { _ => 1 })   //~ E0417
}

pub flow duplicate_in_a_match_as_the_end_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<(match D { _ => 1 }) { x * F32.round_from(i) }   //~ E0417
  ys[0]
}

pub flow duplicate_alone_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, D)
}

pub flow duplicate_alone_in_a_flow_repeat(x: F32 at sample) -> F32 at sample {
  let a = [x; D]
  a[0]
}
