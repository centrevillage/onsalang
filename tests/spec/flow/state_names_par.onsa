// onsa.toml
// [test]
// spec = ["§11.6", "§12.4", "§11.5"]
// golden = ["interface"]
// golden_graph = ["whole_value", "inside_value", "two_kinds", "nested", "in_output", "with_a_let"]

// W7-03 U1c/t, S-148, S-86, R-98 (§11.6, spec/tools.md §1.3): the nodes of a `par~`. A `par~` that is the whole value of a `let` is the node called by the name of
// the `let` (`let saws = par~ ...`), and the nodes of its body are qualified by that name (`saws.lp_0`; the body is one structure with N replicas, so
// the fields of the replica are named inside the field `saws`). A `par~` inside a larger value is a node without a name, of kind `par` (`a.par_0`), and
// the body of a nested `par~` is qualified by the name of the `par~` that holds it (`m.par_0.lp_0`). A `par~` in the output is `_out.par_0`. The number
// inside a body counts from 0 for each `par~` (S-1141 is the case where this matters: state_names_provisional_par_numbers.onsa); here the nodes of
// a body are of kinds that the outside does not have. The names are shown by `onsa interface` (the field of the state) and by `onsa graph` (the vertices
// of the body, `tools.md` §1.3: `saws.lp_0`, with the label `lp_0 = lp~: …`). The field of the state of each flow (the names of the body
// are in the graph; the graph of the flow has them and the vertex of the `par~` itself, `saws`, `a.par_0`, `m`, `m.par_0`, `_out.par_0`, `ps`):
//
//   whole_value:   saws; the graph has saws.lp_0
//   inside_value:  a.par_0; the graph has a.par_0.lp_0
//   two_kinds:     vs; the graph has vs.lp_0 (the outer `lp~(prev~(x))`), vs.prev_0, vs.lp_1 (the numbers count by kind, the outer `lp~` first)
//   nested:        m; the graph has m.par_0 (the inner `par~`) and m.par_0.lp_0 (the spec: "入れ子の `par~` は `m.par_0.acc_0`")
//   in_output:     _out.par_0; the graph has _out.par_0.lp_0
//   with_a_let:    ps and q.prev_0 (the fields; the body of `ps` is qualified by `ps`, the graph has ps.prev_0)

pub flow lp(x: F32 at sample) -> F32 at sample {
  let y = 0.5 * x + 0.5 * prev~(^y)
  y
}

pub rt fn pair_sum(xs: [F32; 2]) -> F32 {
  xs[0] + xs[1]
}

pub flow whole_value(x: F32 at sample) -> F32 at sample {
  let saws = par~ i in 0 ..< 2 {
    lp~(x * F32.round_from(i + 1))
  }
  pair_sum(saws)
}

pub flow inside_value(x: F32 at sample) -> F32 at sample {
  let a = 0.5 * pair_sum(par~ i in 0 ..< 2 { lp~(x * F32.round_from(i + 1)) })
  a
}

pub flow two_kinds(x: F32 at sample) -> F32 at sample {
  let vs = par~ i in 0 ..< 2 {
    lp~(prev~(x)) + lp~(x * F32.round_from(i))
  }
  pair_sum(vs)
}

pub flow nested(x: F32 at sample) -> F32 at sample {
  let m = par~ i in 0 ..< 2 {
    pair_sum(par~ j in 0 ..< 2 { lp~(x * F32.round_from(i + j)) })
  }
  pair_sum(m)
}

pub flow in_output(x: F32 at sample) -> F32 at sample {
  pair_sum(par~ i in 0 ..< 2 { lp~(x * F32.round_from(i + 1)) })
}

pub flow with_a_let(x: F32 at sample) -> F32 at sample {
  let ps = par~ i in 0 ..< 2 { prev~(x * F32.round_from(i + 1)) }
  let q = 1.0 + prev~(x)
  pair_sum(ps) + q
}
