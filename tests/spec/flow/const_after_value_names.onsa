// onsa.toml
// [test]
// spec = ["§4.5", "§15.1", "§18.1", "§11.4", "§11.5"]

// A name after a value item (a constant, a function, a variant, an associated constant of a user type or of a builtin type) in a constant
// expression is the field of a value: it is outside the grammar of a constant expression and is E0417 wherever the expression is written
// (§4.5: "値のフィールド（`K.x`、`P.N.x`、`(K).x`。値の後の `.` は型の段が読む、§15.1）… E0417"; S-967), with a parenthesis (`(K).x`) and a call
// (`K.x()`, `K.x.()`) alike, and whether the field exists (`K.zz`). A method named through its type is no value, so a name after it and the method
// itself are E0308 as before (§15.1; S-205).
// The places are those of a flow: the length of `delay~`, the maximum of `vdelay~`, the ends of a `par~`, the repeat and the annotation of
// a flow body, and the type of an input.
// The units whose result does not change are in const_after_value_names_unchanged.onsa. One error per unit (§18.1).

pub struct Ring[T, const N: U32] {
  data: [T; N],
  head: U32,
}

pub struct S {
  x: U32,
}

pub struct P {
  x: I32,
}

impl P {
  pub const N: U32 = 3

  pub fn get(self) -> I32 {
    self.x
  }
}

pub enum E {
  A,
  B(I32),
}

const K: S = S { x: 3 }
const U: U32 = 4

fn g(a: U32) -> U32 {
  a
}

pub flow field_of_a_constant_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, K.x)   //~ E0417
}

pub flow field_of_a_constant_called_as_a_value_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, K.x.())   //~ E0417
}

pub flow field_of_a_constant_called_as_a_value_in_a_vdelay(x: F32 at sample, d: F32 at sample) -> F32 at sample {
  vdelay~(x, d, K.x.())   //~ E0417
}

pub flow field_of_a_constant_called_as_a_value_in_a_flow_annotation(x: F32 at sample) -> F32 at sample {
  let a: [F32; K.x.()] = [x; 4]   //~ E0417
  a[0]
}

pub flow unknown_field_of_a_constant_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, K.zz)   //~ E0417
}

pub flow unknown_field_of_a_constant_as_the_start_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in K.zz..<8 { x * F32.round_from(i) }   //~ E0417
  ys[0]
}

pub flow field_of_a_chain_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, K.x.y)   //~ E0417
}

pub flow field_of_a_chain_in_a_flow_input(a: [F32; K.x.y] at sample) -> F32 at sample {   //~ E0417
  0.0
}

pub flow member_of_an_integer_constant_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, U.x)   //~ E0417
}

pub flow member_of_an_integer_constant_in_a_sum_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, U + U.x)   //~ E0417
}

pub flow member_of_an_integer_constant_in_a_sum_as_the_end_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<(U + U.x) { x * F32.round_from(i) }   //~ E0417
  ys[0]
}

pub flow member_of_an_associated_constant_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, P.N.x)   //~ E0417
}

pub flow member_of_an_associated_constant_in_a_flow_repeat(x: F32 at sample) -> F32 at sample {
  let a = [x; P.N.x]   //~ E0417
  a[0]
}

pub flow member_of_a_builtin_constant_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, F32.PI.x)   //~ E0417
}

pub flow member_of_a_builtin_constant_in_a_vdelay(x: F32 at sample, d: F32 at sample) -> F32 at sample {
  vdelay~(x, d, F32.PI.x)   //~ E0417
}

pub flow member_of_a_builtin_constant_in_a_flow_annotation(x: F32 at sample) -> F32 at sample {
  let a: [F32; F32.PI.x] = [x; 4]   //~ E0417
  a[0]
}

pub flow member_of_a_builtin_integer_constant_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, I32.BITS.x)   //~ E0417
}

pub flow member_of_a_builtin_integer_constant_as_the_start_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in I32.BITS.x..<8 { x * F32.round_from(i) }   //~ E0417
  ys[0]
}

pub flow member_of_a_function_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, g.y)   //~ E0417
}

pub flow member_of_a_function_in_a_flow_input(a: [F32; g.y] at sample) -> F32 at sample {   //~ E0417
  0.0
}

pub flow member_of_a_variant_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, E.A.x)   //~ E0417
}

pub flow member_of_a_constant_as_an_argument_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, g(U.x))   //~ E0417
}

pub flow member_of_a_constant_as_an_argument_as_the_end_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<g(U.x) { x * F32.round_from(i) }   //~ E0417
  ys[0]
}
