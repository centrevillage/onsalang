// onsa.toml
// [test]
// spec = ["§4.5", "§11.4", "§11.5"]

// A block (with a value or with a statement), an `if`, a `match`, a function value and `unsafe` are outside the grammar of a constant
// expression (§4.5) and are E0417 wherever a constant expression is written, whatever is in them (S-966). Where the form would take the
// braces of the `par~` for its own, it is in parentheses, which do not change the code (§2.4).
// The places are those of a flow: the length of `delay~`, the maximum of `vdelay~`, the ends of a `par~`, the repeat and the annotation of
// a flow body, and the type of an input.
// The units whose result does not change are in const_grammar_blocks_unchanged.onsa. One error per unit (§18.1).

pub struct Ring[T, const N: U32] {
  data: [T; N],
  head: U32,
}

pub struct P {
  x: U32,
}

const K: U32 = 4
const XS: [U32; 2] = [1, 2]

fn g(a: U32) -> U32 {
  a
}

pub flow if_in_a_flow_repeat(x: F32 at sample) -> F32 at sample {
  let a = [x; if true { 1 } else { 2 }]   //~ E0417
  a[0]
}

pub flow if_of_constants_in_a_flow_annotation(x: F32 at sample) -> F32 at sample {
  let a: [F32; if K > 1 { K } else { 2 }] = [x; 4]   //~ E0417
  a[0]
}

pub flow closure_in_a_flow_input(a: [F32; fn(x: U32) -> U32 { x }] at sample) -> F32 at sample {   //~ E0417
  0.0
}
