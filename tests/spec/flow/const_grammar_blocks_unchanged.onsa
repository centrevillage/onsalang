// onsa.toml
// [test]
// spec = ["§4.5", "§11.4", "§11.5"]

// A block (with a value or with a statement), an `if`, a `match`, a function value and `unsafe` are outside the grammar of a constant
// expression (§4.5) and are E0417 wherever a constant expression is written, whatever is in them (S-966). Where the form would take the
// braces of the `par~` for its own, it is in parentheses, which do not change the code (§2.4).
// The places are those of a flow: the length of `delay~`, the maximum of `vdelay~`, the ends of a `par~`, the repeat and the annotation of
// a flow body, and the type of an input.
// These are the units of const_grammar_blocks.onsa whose result the reader of W5-16 U1b1 does not change (they pass before it): they are in
// their own file so that a regression of them is not silenced with the units that change.

pub struct Ring[T, const N: U32] {
  data: [T; N],
  head: U32,
}

pub struct P {
  x: U32,
}

const K: U32 = 4
const XS: [U32; 2] = [1, 2]

fn g(a: U32) -> U32 {
  a
}

pub flow block_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, { 1 })   //~ E0417
}

pub flow block_of_float_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, { 1.5 })   //~ E0417
}

pub flow block_of_float_as_the_end_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<({ 1.5 }) { x * F32.round_from(i) }   //~ E0417
  ys[0]
}

pub flow if_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, if true { 1 } else { 2 })   //~ E0417
}

pub flow if_of_constants_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, if K > 1 { K } else { 2 })   //~ E0417
}

pub flow if_of_constants_in_a_vdelay(x: F32 at sample, d: F32 at sample) -> F32 at sample {
  vdelay~(x, d, if K > 1 { K } else { 2 })   //~ E0417
}

pub flow match_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, match 1 { _ => 1 })   //~ E0417
}

pub flow match_as_the_start_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in (match 1 { _ => 1 })..<8 { x * F32.round_from(i) }   //~ E0417
  ys[0]
}

pub flow closure_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, fn(x: U32) -> U32 { x })   //~ E0417
}

pub flow unsafe_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, unsafe { 1 })   //~ E0417
}

pub flow block_in_a_sum_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, K + (if true { 1 } else { 2 }))   //~ E0417
}

pub flow block_in_a_sum_as_the_end_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<(K + (if true { 1 } else { 2 })) { x * F32.round_from(i) }   //~ E0417
  ys[0]
}
