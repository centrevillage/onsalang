// onsa.toml
// [test]
// spec = ["§4.5", "§4.1", "§11.4", "§11.5"]

// A constant whose type is not `U32` is E0401 wherever it is written as a length or a const argument, unqualified or through a type
// (`Dev.WIDE`): the leaf is judged by its type (§4.5: "期待型でない定数は E0401"; R-61: `[F32; N]` and `Ring[F32, N]` are the same). The constants
// of the type `U32` (`K`, `Dev.CAP`, `I32.BITS`) are fine in the same places. The qualified name of a constant of a module is in
// packages/const_grammar_qualified_names.
// The places are those of a flow: the length of `delay~`, the maximum of `vdelay~`, the ends of a `par~`, the repeat and the annotation of
// a flow body, and the type of an input.
// One error per unit (§18.1).

pub struct Ring[T, const N: U32] {
  data: [T; N],
  head: U32,
}

pub struct P {
  x: U32,
}

const K: U32 = 4
const XS: [U32; 2] = [1, 2]

fn g(a: U32) -> U32 {
  a
}

const B: I64 = 4
const B8: U8 = 4
const H: F32 = 1.5
const FLAG: Bool = true

pub struct Dev {
  x: I32,
}

impl Dev {
  pub const CAP: U32 = 3
  pub const WIDE: I64 = 3
}

pub flow i64_constant_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, B)   //~ E0401
}

pub flow u8_constant_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, B8)   //~ E0401
}

pub flow u8_constant_as_the_end_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<B8 { x * F32.round_from(i) }   //~ E0401
  ys[0]
}

pub flow f32_constant_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, H)   //~ E0401
}

pub flow f32_constant_in_a_flow_repeat(x: F32 at sample) -> F32 at sample {
  let a = [x; H]   //~ E0401
  a[0]
}

pub flow bool_constant_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, FLAG)   //~ E0401
}

pub flow bool_constant_in_a_vdelay(x: F32 at sample, d: F32 at sample) -> F32 at sample {
  vdelay~(x, d, FLAG)   //~ E0401
}

pub flow bool_constant_in_a_flow_annotation(x: F32 at sample) -> F32 at sample {
  let a: [F32; FLAG] = [x; 4]   //~ E0401
  a[0]
}

pub flow i64_in_parentheses_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, (B))   //~ E0401
}

pub flow i64_in_parentheses_as_the_start_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in (B)..<8 { x * F32.round_from(i) }   //~ E0401
  ys[0]
}

pub flow i64_associated_constant_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, Dev.WIDE)   //~ E0401
}

pub flow i64_associated_constant_in_a_flow_input(a: [F32; Dev.WIDE] at sample) -> F32 at sample {   //~ E0401
  0.0
}

pub flow u32_constant_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, K)
}

pub flow u32_associated_constant_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, Dev.CAP)
}

pub flow u32_associated_constant_in_a_flow_repeat(x: F32 at sample) -> F32 at sample {
  let a = [x; Dev.CAP]
  a[0]
}

pub flow u32_associated_constant_in_a_vdelay(x: F32 at sample, d: F32 at sample) -> F32 at sample {
  vdelay~(x, d, Dev.CAP)
}

pub flow u32_builtin_constant_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, I32.BITS)
}
