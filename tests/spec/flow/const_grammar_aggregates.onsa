// onsa.toml
// [test]
// spec = ["§4.5", "§11.4", "§11.5"]

// An index, a tuple, an array, a repeat `[e; n]`, a struct literal and the field `.0` of a tuple are outside the grammar of a constant
// expression (§4.5) and are E0417 whatever is in them (S-966): the same form has the same code with a float (`(1.5, 2)`) or a call
// (`(g(1), 2)`) inside, because the judgement does not look at the children of such a node. The index is not written as a const argument
// (`Ring[F32, XS[0]]` can be read as a type, so a place that reads it is not fixed here).
// The places are those of a flow: the length of `delay~`, the maximum of `vdelay~`, the ends of a `par~`, the repeat and the annotation of
// a flow body, and the type of an input.
// The units whose result does not change are in const_grammar_aggregates_unchanged.onsa. One error per unit (§18.1).

pub struct Ring[T, const N: U32] {
  data: [T; N],
  head: U32,
}

pub struct P {
  x: U32,
}

const K: U32 = 4
const XS: [U32; 2] = [1, 2]

fn g(a: U32) -> U32 {
  a
}

pub flow tuple_of_literals_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, (1, 2))   //~ E0417
}

pub flow tuple_of_literals_in_a_flow_repeat(x: F32 at sample) -> F32 at sample {
  let a = [x; (1, 2)]   //~ E0417
  a[0]
}

pub flow tuple_of_constants_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, (K, K))   //~ E0417
}

pub flow tuple_of_constants_as_the_end_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<(K, K) { x * F32.round_from(i) }   //~ E0417
  ys[0]
}

pub flow tuple_index_in_a_flow_repeat(x: F32 at sample) -> F32 at sample {
  let a = [x; (K, 1).0]   //~ E0417
  a[0]
}

pub flow array_of_one_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, [1])   //~ E0417
}

pub flow array_of_one_in_a_flow_input(a: [F32; [1]] at sample) -> F32 at sample {   //~ E0417
  0.0
}

pub flow array_repeat_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, [1; 2])   //~ E0417
}

pub flow array_repeat_of_constant_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, [K; 2])   //~ E0417
}

pub flow array_repeat_of_constant_in_a_flow_repeat(x: F32 at sample) -> F32 at sample {
  let a = [x; [K; 2]]   //~ E0417
  a[0]
}

pub flow struct_literal_in_a_flow_annotation(x: F32 at sample) -> F32 at sample {
  let a: [F32; P { x: 1 }] = [x; 4]   //~ E0417
  a[0]
}

pub flow tuple_with_a_float_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, (1.5, 2))   //~ E0417
}

pub flow tuple_with_a_float_in_a_vdelay(x: F32 at sample, d: F32 at sample) -> F32 at sample {
  vdelay~(x, d, (1.5, 2))   //~ E0417
}

pub flow tuple_with_a_float_in_a_flow_annotation(x: F32 at sample) -> F32 at sample {
  let a: [F32; (1.5, 2)] = [x; 4]   //~ E0417
  a[0]
}

pub flow array_with_a_float_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, [1.5])   //~ E0417
}

pub flow array_with_a_float_as_the_start_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in [1.5]..<8 { x * F32.round_from(i) }   //~ E0417
  ys[0]
}

pub flow tuple_with_a_call_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, (g(1), 2))   //~ E0417
}

pub flow tuple_with_a_call_in_a_flow_input(a: [F32; (g(1), 2)] at sample) -> F32 at sample {   //~ E0417
  0.0
}
