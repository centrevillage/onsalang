// onsa.toml
// [test]
// spec = ["§4.4", "§4.5", "§11.4", "§11.5"]

// S-304 (W5-16 U1c): the constant of a generic `impl` read by an alias that fixes the arguments, whose value is the
// const parameter alone (`CAP = N`), is a constant expression with the value of the argument in the places of a flow
// (§4.5: "`I32.BITS` のような型引数の決まった型（別名を含む）の関連定数"): `R4.CAP` is 4 as the length of `delay~`, the
// maximum of `vdelay~`, an end of a `par~`, the repeat and the annotation of a flow body, and the type of an input. The
// array in the annotation has 4 elements, which the repeat with the literal 4 meets (the same type). No diagnostic. Today these are E0200 (a computed constant).

pub struct Rg[T, const N: U32] {
  a: [T; N],
}

impl[T, const N: U32] Rg[T, N] {
  pub const CAP: U32 = N
}

type R4 = Rg[F32, 4]

pub flow in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, R4.CAP)
}

pub flow in_a_vdelay(x: F32 at sample, d: F32 at sample) -> F32 at sample {
  vdelay~(x, d, R4.CAP)
}

pub flow as_the_end_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0 ..< R4.CAP { x * F32.round_from(i) }
  ys[0] + ys[3]
}

pub flow as_the_start_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in R4.CAP ..< 8 { x * F32.round_from(i) }
  ys[0]
}

pub flow in_a_flow_repeat(x: F32 at sample) -> F32 at sample {
  let a = [x; R4.CAP]
  a[0] + a[3]
}

pub flow in_a_flow_annotation(x: F32 at sample) -> F32 at sample {
  let a: [F32; R4.CAP] = [x; 4]
  a[0]
}

pub flow in_a_flow_input(a: [F32; R4.CAP] at sample) -> F32 at sample {
  a[0] + a[3]
}
