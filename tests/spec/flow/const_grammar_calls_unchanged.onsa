// onsa.toml
// [test]
// spec = ["§4.5", "§4.7", "§11.4", "§11.5"]

// A call (`g(1)`, `K.min(2)`) is outside the grammar of a constant expression (§4.5: "関数の呼び出しは書けない") and is E0417 wherever a constant
// expression is written. A part outside the grammar inside an operation is the error of the operation: `K + (1, 2)` and `(K < 2) + 1` are
// E0417 (the operand is read first, and the operation over it adds no error, §18.1), `-g(1)` is E0417 and not the E0401 of the prefix `-`.
// The places are those of a flow: the length of `delay~`, the maximum of `vdelay~`, the ends of a `par~`, the repeat and the annotation of
// a flow body, and the type of an input.
// These are the units of const_grammar_calls.onsa whose result the reader of W5-16 U1b1 does not change (they pass before it): they are in
// their own file so that a regression of them is not silenced with the units that change.

pub struct Ring[T, const N: U32] {
  data: [T; N],
  head: U32,
}

pub struct P {
  x: U32,
}

const K: U32 = 4
const XS: [U32; 2] = [1, 2]

fn g(a: U32) -> U32 {
  a
}

pub flow call_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, g(1))   //~ E0417
}

pub flow call_of_constant_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, g(K))   //~ E0417
}

pub flow call_of_constant_as_the_end_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<g(K) { x * F32.round_from(i) }   //~ E0417
  ys[0]
}

pub flow call_in_a_sum_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, K + g(1))   //~ E0417
}

pub flow call_in_a_sum_in_a_flow_repeat(x: F32 at sample) -> F32 at sample {
  let a = [x; K + g(1)]   //~ E0417
  a[0]
}

pub flow method_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, K.min(2))   //~ E0417
}

pub flow method_in_a_vdelay(x: F32 at sample, d: F32 at sample) -> F32 at sample {
  vdelay~(x, d, K.min(2))   //~ E0417
}

pub flow method_in_a_flow_annotation(x: F32 at sample) -> F32 at sample {
  let a: [F32; K.min(2)] = [x; 4]   //~ E0417
  a[0]
}

pub flow comparison_in_a_sum_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, (K < 2) + 1)   //~ E0417
}
