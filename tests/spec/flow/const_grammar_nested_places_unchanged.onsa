// onsa.toml
// [test]
// spec = ["§4.5", "§11.4", "§11.5", "§18.1"]

// W5-16 U1b/t, S-966, S-968, S-228: the code of a constant expression of a flow does not depend on where it is written inside the flow: the
// length of a delay line and the ends of a `par~` inside the body of a `par~`, inside a nested `par~`, in a branch of `if~`
// are E0417 for a form outside the grammar, E0401 for a float and a prefix `-`, E0302 for a name that is not found (§4.5, §18.1). A constant in the same places
// is fine. One error per unit (§18.1).
// These are the units of const_grammar_nested_places.onsa whose result W5-16 U1b1 does not change (they pass before it): they are in their own file
// so that a regression of them is not silenced with the units that change.

const K: U32 = 4

pub flow comparison_in_the_body_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<2 {
    delay~(x * F32.round_from(i), K < 2)   //~ E0417
  }
  ys[0] + ys[1]
}

pub flow float_in_the_body_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<2 {
    delay~(x, 1.5)   //~ E0401
  }
  ys[0] + ys[1]
}

pub flow minus_in_the_body_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<2 {
    vdelay~(x, x, -K)   //~ E0401
  }
  ys[0] + ys[1]
}

pub flow unknown_in_the_body_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<2 {
    delay~(x, (zz, 1))   //~ E0302
  }
  ys[0] + ys[1]
}

pub flow comparison_as_the_end_of_a_nested_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<2 { par~ j in 0..<(K < 2) { x } }   //~ E0417
  ys[0][0]
}

pub flow cast_as_the_start_of_a_nested_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<2 { par~ j in (K as U32)..<4 { x } }   //~ E0417
  ys[0][0]
}

pub flow float_as_the_end_of_a_nested_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<2 { par~ j in 0..<1.5 { x } }   //~ E0401
  ys[0][0]
}

pub flow comparison_in_a_branch_of_an_if(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  if~ c {
    delay~(x, K == 4)   //~ E0417
  } else {
    x
  }
}

pub flow float_in_a_branch_of_an_if(x: F32 at sample, c: Bool at sample) -> F32 at sample {
  if~ c {
    delay~(x, true)   //~ E0401
  } else {
    x
  }
}

pub flow comparison_in_an_if_of_the_length(x: F32 at sample) -> F32 at sample {
  delay~(x, if K > 1 { 1 } else { 2 })   //~ E0417
}

pub flow unknown_in_an_if_of_the_length(x: F32 at sample) -> F32 at sample {
  delay~(x, if true { zz } else { 2 })   //~ E0302
}

pub flow constant_in_the_body_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<2 {
    delay~(x, K)
  }
  ys[0] + ys[1]
}

pub flow constant_in_a_nested_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<2 { par~ j in 0..<K { x } }
  ys[0][0]
}
