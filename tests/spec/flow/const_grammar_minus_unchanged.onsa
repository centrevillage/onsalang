// onsa.toml
// [test]
// spec = ["§4.5", "§3.4", "§11.4", "§11.5"]

// `U32` has no prefix `-`, so `-1`, `-0`, `-(1)`, `-K` and a prefix `-` in an operation or before a sum are E0401 wherever a constant
// expression is written (§4.5, §3.4; S-228), never E0408 or E0808. negative/const_expr_neg.onsa and negative/flow_const_neg.onsa have some
// of the places; this file has the others, and the flow places that are fine before W5-16 U1b1 are in the _unchanged file.
// The places are those of a flow: the length of `delay~`, the maximum of `vdelay~`, the ends of a `par~`, the repeat and the annotation of
// a flow body, and the type of an input.
// These are the units of const_grammar_minus.onsa whose result the reader of W5-16 U1b1 does not change (they pass before it): they are in
// their own file so that a regression of them is not silenced with the units that change.

pub struct Ring[T, const N: U32] {
  data: [T; N],
  head: U32,
}

pub struct P {
  x: U32,
}

const K: U32 = 4
const XS: [U32; 2] = [1, 2]

fn g(a: U32) -> U32 {
  a
}

pub flow one_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, -1)   //~ E0401
}

pub flow zero_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, -0)   //~ E0401
}

pub flow zero_as_the_end_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<-0 { x * F32.round_from(i) }   //~ E0401
  ys[0]
}

pub flow parenthesised_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, -(1))   //~ E0401
}

pub flow parenthesised_in_a_flow_repeat(x: F32 at sample) -> F32 at sample {
  let a = [x; -(1)]   //~ E0401
  a[0]
}

pub flow constant_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, -K)   //~ E0401
}

pub flow constant_in_a_vdelay(x: F32 at sample, d: F32 at sample) -> F32 at sample {
  vdelay~(x, d, -K)   //~ E0401
}

pub flow sum_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, -(K + 1))   //~ E0401
}

pub flow sum_as_the_start_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in (-(K + 1))..<8 { x * F32.round_from(i) }   //~ E0401
  ys[0]
}

pub flow after_operator_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, 2 * -K)   //~ E0401
}

pub flow float_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, -1.5)   //~ E0401
}
