// onsa.toml
// [test]
// spec = ["§11.5", "§11.6", "§18.2"]

// W7-06 U0/t, S-1175, S-1177 (spec/tools.md §1.1, §1.3; §11.5, §11.6): the flow that the test `a_par_with_no_state_that_is_the_value_of_a_let_is_a_node_named_after_the_let`
// of `crates/onsa_cli/tests/cli/graph_par_frames.rs` gives to `onsa graph`: a `par` with no state that is the value of a `let` (a `par~` before
// S-1177). It is a file of its own, as it reads only after W7-06 U0 (a `par` of a body with no state is an E0811 of the names stage until then), and
// the other flows of the tests of the graph (graph_labels.onsa) read now.

pub flow stateless(x: F32 at sample) -> F32 at sample {
  let ys = par i in 0 ..< 2 { x * F32.round_from(i) }
  ys[0] + ys[1]
}
