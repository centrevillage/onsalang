// onsa.toml
// [test]
// spec = ["§11.6", "§11.5"]
// golden = ["interface"]
// golden_graph = ["second_par_is_counted"]

// W7-03 U1c/t, S-1142 (OPEN, to be confirmed); W7-06 U0/t, S-1177: a `par` whose body has no state makes no field (it is no
// node with state, §11.5), but does it count in the number of the kind `par`? §11.6 now says the kind `par` is "`par` と
// `par~` の複製。番号は二つの綴りで一つの列", so every replication counts, a `par` as well as a `par~`, and the
// second replication below is `a.par_1`. The `par` has no field of its own (the graph has a.par_1.prev_0). The fields of the flows:
//   second_par_is_counted:  a.par_1 (the graph has a.par_1.prev_0)
//   stateless_alone:        none of `par` (a `par` with no state makes no field)
// The file keeps its name until S-1142 is confirmed.

pub rt fn pair_pick(xs: [F32; 2]) -> F32 {
  xs[0]
}

pub flow second_par_is_counted(x: F32 at sample) -> F32 at sample {
  let a = pair_pick(par i in 0 ..< 2 { x * 2.0 }) + pair_pick(par~ j in 0 ..< 2 { prev~(x) })
  a
}

pub flow stateless_alone(x: F32 at sample) -> F32 at sample {
  pair_pick(par i in 0 ..< 2 { x * 2.0 })
}
