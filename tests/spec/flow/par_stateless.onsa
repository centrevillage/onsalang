// onsa.toml
// [test]
// spec = ["§2.6", "§11.5", "§18.1"]

// W4-20 U1/t, S-745; W7-06 U0/t, S-1177: a replication whose body holds nothing with state (no instance, no
// built-in delay, no `par~` that has one) is written `par` without the `~`, as `if` is for a branch with no
// state (§11.5: "状態を持つものがあるかは、書いた `~` でなく中身（呼び先の種類と入れ子）で決める"), and is no
// error. The `par~` with the same body is the E0812 of negative/e0812_par_tilde_without_state.onsa, and the
// `par` with state in its body is the E0811 of negative/e0811_par_without_tilde.onsa. The same holds for each
// place of the replication and for nesting. A `par~` with state in its body is in par_tilde_forms.onsa; the
// `par` in the branches, the guards and the right sides of `&&` / `||` is in par_in_plain_branches.onsa.

pub rt fn scale(x: F32, i: U32) -> F32 {
  x * F32.round_from(i)
}

pub rt fn total(xs: [F32; 4]) -> F32 {
  xs[0] + xs[1] + xs[2] + xs[3]
}

pub rt fn pair_sum(xs: [F32; 2]) -> F32 {
  xs[0] + xs[1]
}

pub flow lp(x: F32 at sample) -> F32 at sample {
  x * 0.5 + prev~(x) * 0.5
}

pub flow as_the_tail(x: F32 at sample) -> [F32; 4] at sample {
  par i in 0 ..< 4 { x * F32.round_from(i) }
}

pub flow as_a_let(x: F32 at sample) -> [F32; 4] at sample {
  let ys = par i in 0 ..< 4 { x * F32.round_from(i) }
  ys
}

pub flow as_an_argument(x: F32 at sample) -> F32 at sample {
  total(par i in 0 ..< 4 { x * F32.round_from(i) })
}

pub flow with_a_function_call(x: F32 at sample) -> [F32; 4] at sample {
  par i in 0 ..< 4 { scale(x, i) }
}

pub flow with_an_if(x: F32 at sample) -> [F32; 4] at sample {
  par i in 0 ..< 4 { if x > F32.round_from(i) { 1.0 } else { 0.0 } }
}

pub flow with_a_constant_body_that_reads_the_index(x: F32 at sample) -> [F32; 4] at sample {
  par i in 1 ..< 5 { F32.round_from(i) }
}

pub flow with_a_stateless_inner(x: F32 at sample) -> [F32; 3] at sample {
  par i in 0 ..< 3 {
    pair_sum(par j in 0 ..< 2 { x * F32.round_from(i + j) })
  }
}

pub flow beside_a_flow_with_state(x: F32 at sample) -> F32 at sample {
  let ys = par i in 0 ..< 4 { x * F32.round_from(i) }
  lp~(total(ys))
}

pub flow stateless_beside_stateful(x: F32 at sample) -> F32 at sample {
  let ys = par i in 0 ..< 4 { x * F32.round_from(i) }
  let zs = par~ i in 0 ..< 4 { lp~(x) * F32.round_from(i) }
  total(ys) + total(zs)
}

pub flow a_stateless_inner_in_a_replication_with_state(x: F32 at sample) -> [F32; 3] at sample {
  par~ i in 0 ..< 3 {
    lp~(x) * pair_sum(par j in 0 ..< 2 { x * F32.round_from(i + j) })
  }
}

pub flow a_stateless_let_of_a_stateless_inner(x: F32 at sample) -> [F32; 2] at sample {
  let rows = par i in 0 ..< 2 {
    pair_sum(par j in 0 ..< 2 { x * F32.round_from(i + j) })
  }
  rows
}

pub flow with_a_closed_range(x: F32 at sample) -> [F32; 4] at sample {
  par i in 1 ..= 4 { x * F32.round_from(i) }
}
