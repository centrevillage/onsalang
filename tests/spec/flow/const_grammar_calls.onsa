// onsa.toml
// [test]
// spec = ["§4.5", "§4.7", "§11.4", "§11.5"]

// A call (`g(1)`, `K.min(2)`) is outside the grammar of a constant expression (§4.5: "関数の呼び出しは書けない") and is E0417 wherever a constant
// expression is written. A part outside the grammar inside an operation is the error of the operation: `K + (1, 2)` and `(K < 2) + 1` are
// E0417 (the operand is read first, and the operation over it adds no error, §18.1), `-g(1)` is E0417 and not the E0401 of the prefix `-`.
// The places are those of a flow: the length of `delay~`, the maximum of `vdelay~`, the ends of a `par~`, the repeat and the annotation of
// a flow body, and the type of an input.
// The units whose result does not change are in const_grammar_calls_unchanged.onsa. One error per unit (§18.1).

pub struct Ring[T, const N: U32] {
  data: [T; N],
  head: U32,
}

pub struct P {
  x: U32,
}

const K: U32 = 4
const XS: [U32; 2] = [1, 2]

fn g(a: U32) -> U32 {
  a
}

pub flow tuple_in_a_sum_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, K + (1, 2))   //~ E0417
}

pub flow tuple_in_a_sum_as_the_start_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in (K + (1, 2))..<8 { x * F32.round_from(i) }   //~ E0417
  ys[0]
}

pub flow comparison_in_a_sum_in_a_flow_input(a: [F32; (K < 2) + 1] at sample) -> F32 at sample {   //~ E0417
  0.0
}

pub flow call_negated_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, -g(1))   //~ E0417
}
