// onsa.toml
// [test]
// mode = "check"
// spec = ["§2.5", "§4.5", "§5.2", "§6.1", "§10"]

// A call through a function value is written `v.(x)` (spec §6.1): the callee is a binding, an
// argument, a field, an element, a tuple element or the result of a call, and the `.(` follows it
// with no space (§2.5). A function that is an item, an associated function, a namespace function, an
// effect operation or a variant is called `f(x)` (those calls are in the other cases). Here every
// form is accepted by the syntax and by the checker; the names stage (W4-12) and the types stage
// keep their own rules, which the negative cases cover. The values these calls return are in
// tests/spec/semantics/fn_values.onsa.

use std.array

pub struct Shaper {
  gain: F32,
  curve: fn(F32) -> F32,
}

pub struct Rack {
  shapers: [Shaper; 2],
  ops: [fn(I32) -> I32; 2],
  pair: (fn(I32) -> I32, I32),
  main: Shaper,
}

fn soft_clip(x: F32) -> F32 {
  x / (1.0 + x)
}

fn inc(x: I32) -> I32 {
  x + 1
}

fn dec(x: I32) -> I32 {
  x - 1
}

fn pick(up: Bool) -> fn(I32) -> I32 {
  if up { inc } else { dec }
}

fn choose(n: I32) -> fn(I32) -> I32 {
  if n > 0 { inc } else { dec }
}

// ------------------------------------------------ the callee is an argument or a binding

fn on_argument(f: fn(I32) -> I32, x: I32) -> I32 {
  f.(x)
}

fn on_argument_twice(f: fn(I32) -> I32, x: I32) -> I32 {
  f.(f.(x))
}

fn on_binding(x: I32) -> I32 {
  let g = fn(y: I32) -> I32 { y * 2 }
  g.(x)
}

fn on_typed_binding(x: I32) -> I32 {
  let g: fn(I32) -> I32 = inc
  var h = dec
  h = inc
  g.(x) + h.(x)
}

fn on_loop_binding(ops: [fn(I32) -> I32; 3], x: I32) -> I32 {
  var acc = x
  for g in ops {
    acc = g.(acc)
  }
  acc
}

fn on_match_binding(o: Option[fn(I32) -> I32], x: I32) -> I32 {
  match o {
    Some(g) => g.(x),
    None => x,
  }
}

fn no_arguments(f: fn() -> I32) -> I32 {
  f.()
}

fn two_arguments(f: fn(I32, I32) -> I32, a: I32, b: I32) -> I32 {
  f.(a, b)
}

fn arguments_on_several_lines(f: fn(I32, I32) -> I32) -> I32 {
  f.(
    1,
    2,
  )
}

fn the_argument_is_a_call_through_a_value(f: fn(I32) -> I32, g: fn(I32) -> I32, x: I32) -> I32 {
  f.(g.(x + 1))
}

// ------------------------------------------------ the callee is a field, an element, a tuple element

fn on_field(s: Shaper, x: F32) -> F32 {
  s.curve.(x) * s.gain
}

fn on_field_twice(s: Shaper, x: F32) -> F32 {
  s.curve.(s.curve.(x))
}

fn on_nested_field(r: Rack, x: F32) -> F32 {
  r.main.curve.(x)
}

fn on_element(ops: [fn(I32) -> I32; 2], i: U32, x: I32) -> I32 {
  ops[i].(x)
}

fn on_element_of_a_field(r: Rack, i: U32, x: I32) -> I32 {
  r.ops[i].(x) + r.ops[0].(x)
}

fn on_field_of_an_element(r: Rack, i: U32, x: F32) -> F32 {
  r.shapers[i].curve.(x)
}

fn on_tuple_element(t: (fn(I32) -> I32, I32)) -> I32 {
  t.0.(t.1)
}

fn on_nested_tuple_element(r: Rack) -> I32 {
  r.pair.0.(r.pair.1)
}

fn on_tuple_of_tuples(t: ((fn(I32) -> I32, I32), I32)) -> I32 {
  t.0.0.(t.0.1) + t.1
}

impl Shaper {
  pub fn run(self, x: F32) -> F32 {
    self.curve.(x) * self.gain
  }

  pub fn run_twice(self, x: F32) -> F32 {
    self.curve.(self.curve.(x))
  }

  pub fn bend(inout self, f: fn(F32) -> F32, x: F32) -> F32 {
    self.gain = f.(self.gain)
    f.(x)
  }
}

// ------------------------------------------------ the callee is the result of a call

fn on_call_result() -> I32 {
  pick(true).(5)
}

fn on_call_result_with_arguments(up: Bool, x: I32) -> I32 {
  pick(up).(choose(x).(x))
}

fn on_value_call_result(h: fn(I32) -> fn(I32) -> I32, x: I32) -> I32 {
  h.(x).(x + 1)
}

fn on_value_call_result_of_three(h: fn(I32) -> fn(I32) -> fn(I32) -> I32) -> I32 {
  h.(1).(2).(3)
}

fn on_method_result(s: Shaper, x: F32) -> F32 {
  s.picker().(x)
}

impl Shaper {
  pub fn picker(self) -> fn(F32) -> F32 {
    soft_clip
  }
}

fn on_a_function_item_used_as_a_value(x: I32) -> I32 {
  let make = choose
  make.(x).(x)
}

// ------------------------------------------------ operands, conditions, results of other forms

fn as_an_operand(f: fn(I32) -> I32, g: fn(I32) -> I32, x: I32) -> I32 {
  f.(x) + g.(x) - f.(g.(x))
}

fn as_a_comparison(f: fn(I32) -> I32, x: I32) -> Bool {
  f.(x) < f.(x + 1)
}

fn as_a_conjunction(p: fn(I32) -> Bool, q: fn(I32) -> Bool, x: I32) -> Bool {
  p.(x) && q.(x)
}

fn in_a_condition(f: fn(I32) -> Bool, x: I32) -> I32 {
  if f.(x) {
    1
  } else if f.(x + 1) {
    2
  } else {
    3
  }
}

fn in_a_loop(f: fn(I32) -> I32) -> I32 {
  var i = 0
  while f.(i) < 10 {
    i = i + 1
  }
  i
}

fn in_a_match(f: fn(I32) -> I32, x: I32) -> I32 {
  match f.(x) {
    0 => 1,
    n if n < 0 => 2,
    _ => 3,
  }
}

fn in_a_literal(f: fn(I32) -> I32, x: I32) -> (I32, [I32; 2]) {
  (f.(x), [f.(x), f.(x + 1)])
}

fn in_a_struct_literal(f: fn(F32) -> F32, x: F32) -> Shaper {
  Shaper { gain: f.(x), curve: f }
}

fn passed_to_an_item(f: fn(I32) -> I32, x: I32) -> I32 {
  on_argument(inc, f.(x))
}

fn followed_by_a_field(f: fn(I32) -> (I32, I32), x: I32) -> I32 {
  f.(x).0 + f.(x).1
}

fn followed_by_an_index(f: fn(I32) -> [I32; 2], x: I32) -> I32 {
  f.(x)[0] + f.(x)[1]
}

fn followed_by_a_method(f: fn(F32) -> F32, x: F32) -> F32 {
  f.(x).abs()
}

fn followed_by_a_conversion(f: fn(I32) -> I32, x: I32) -> I64 {
  f.(x) as I64
}

fn after_a_prefix(f: fn(I32) -> I32, p: fn(I32) -> Bool, x: I32) -> I32 {
  let a = -f.(x)
  let b = !p.(x)
  if b { a } else { -a }
}

fn followed_by_try(f: fn(I32) -> Result[I32, Str], x: I32) -> Result[I32, Str] {
  let y = f.(x)?
  Ok(y + 1)
}

fn followed_by_try_on_option(f: fn(I32) -> Option[I32], x: I32) -> Option[I32] {
  let y = f.(x)?
  Some(y + 1)
}

fn returned(f: fn(I32) -> I32, x: I32) -> I32 {
  if x < 0 {
    return f.(x)
  }
  f.(0)
}

// ------------------------------------------------ argument modes at the call

fn call_with_inout(f: fn(inout F32), inout v: F32) {
  f.(inout v)
}

fn call_with_inout_field(f: fn(inout F32), inout s: Shaper) {
  f.(inout s.gain)
}

fn call_with_move(f: fn(move I32) -> I32, move a: I32) -> I32 {
  f.(move a)
}

fn call_with_borrow_and_inout(f: fn(I32, inout I32), a: I32, inout b: I32) {
  f.(a, inout b)
}

// ------------------------------------------------ in other kinds of functions

fn generic_twice[T](f: fn(T) -> T, x: T) -> T {
  f.(f.(x))
}

fn generic_call_of_the_generic() -> I32 {
  generic_twice(inc, 1) + generic_twice(dec, 5)
}

fn generic_with_a_bound[T: Num](f: fn(T) -> T, x: T) -> T {
  f.(x) + f.(x)
}

pub rt fn in_rt(f: rt fn(F32) -> F32, x: F32) -> F32 {
  f.(x)
}

fn in_a_closure(f: fn(I32) -> I32, x: I32) -> I32 {
  let h = fn(g: fn(I32) -> I32, y: I32) -> I32 { g.(y) + g.(y) }
  h.(f, x)
}

fn in_a_closure_of_a_closure(x: I32) -> I32 {
  let outer = fn(a: I32) -> I32 {
    let inner = fn(b: I32) -> I32 { b + 1 }
    inner.(a) * 2
  }
  outer.(x)
}

fn continued_on_the_next_line(up: Bool) -> I32 {
  let r = pick(up)
    .(5)
  r
}

fn inside_an_array_filler() -> [F32; 4] {
  let step = fn(i: U32) -> F32 { i.round_f32() }
  array.from_fn(fn(i) { step.(i) })
}

// ------------------------------------------------ the items of the same spelling are not value calls

fn item_calls_keep_their_form(x: I32, s: Shaper) -> I32 {
  let a = inc(x)
  let b = on_argument(inc, a)
  let c = on_argument_twice(dec, b)
  let d = s.run(1.0).trunc_i32()
  a + b + c + d
}
