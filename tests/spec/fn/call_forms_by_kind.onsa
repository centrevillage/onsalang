// onsa.toml
// [test]
// spec = ["§4.4", "§6.1", "§15.1"]

// The form of a call is decided by what the callee is (§6.1, S-191): an item (a function, an associated
// function, a function of a namespace, a variant with elements) is called `f(x)`, a function value (an
// argument, a binding, an element of a constant or of an array, a field) is called `f.(x)`. Here every
// callee is called in its own form and the unit has no error; the other forms are the errors of
// tests/spec/fixes/e0020_call_forms_names.onsa. An associated function or a function item that is put
// in a binding first is a function value from then on, so `mk.(1.0, 2.0)` is the form of that binding.
// A unit variant is a value that is not called (`E.A`, `None`).

use std.math

pub fn inc(x: I32) -> I32 {
  x + 1
}

pub fn dec(x: I32) -> I32 {
  x - 1
}

pub const OPS: [fn(I32) -> I32; 2] = [inc, dec]

pub struct Point {
  x: F32,
  y: F32,
}

impl Point {
  pub fn new(x: F32, y: F32) -> Point {
    Point { x: x, y: y }
  }

  pub fn splat(a: F32) -> Point {
    Self.new(a, a)
  }

  pub fn splat_by_a_binding(a: F32) -> Point {
    let mk = Self.new
    mk.(a, a)
  }
}

pub struct Rack {
  ops: [fn(I32) -> I32; 2],
  gain: fn(F32) -> F32,
}

pub enum E {
  A,
  B(I32),
}

// ------------------------------------------------ the items

pub fn an_item() -> I32 {
  inc(1)
}

pub fn an_associated_function() -> Point {
  Point.new(1.0, 2.0)
}

pub fn a_function_of_a_namespace() -> F32 {
  math.sin(1.0)
}

pub fn a_function_of_a_built_in_type() -> F32 {
  F32.from_bits(1)
}

pub fn a_prelude_variant_with_an_element(x: I32) -> Option[I32] {
  Some(x)
}

pub fn a_variant_with_an_element() -> E {
  E.B(1)
}

pub fn unit_variants_are_values(c: Bool) -> (E, Option[I32]) {
  if c {
    (E.A, None)
  } else {
    (E.B(2), Some(3))
  }
}

// ------------------------------------------------ the function values

pub fn a_parameter(f: fn(I32) -> I32, x: I32) -> I32 {
  f.(x)
}

pub fn a_bound_associated_function() -> Point {
  let mk = Point.new
  mk.(1.0, 2.0)
}

pub fn a_bound_item(x: I32) -> I32 {
  let g = inc
  g.(x)
}

pub fn an_element_of_a_constant() -> I32 {
  OPS[0].(1)
}

pub fn an_element_of_a_parameter(ops: [fn(I32) -> I32; 2], i: U32, x: I32) -> I32 {
  ops[i].(x)
}

pub fn a_field_and_an_element_of_a_field(r: Rack, x: I32) -> I32 {
  r.ops[1].(x)
}

pub fn a_field(r: Rack, x: F32) -> F32 {
  r.gain.(x)
}

// ------------------------------------------------ both forms together

pub fn an_item_in_the_argument_of_a_value(f: fn(I32) -> I32, x: I32) -> I32 {
  f.(inc(x))
}

pub fn a_value_in_the_argument_of_an_item(f: fn(I32) -> I32, x: I32) -> I32 {
  inc(f.(x))
}

pub fn a_constant_in_a_constant() -> I32 {
  OPS[1].(OPS[0].(5))
}

pub fn in_a_branch(f: fn(I32) -> I32, c: Bool, x: I32) -> I32 {
  if c {
    f.(x)
  } else {
    inc(x)
  }
}

pub fn in_an_arm(o: Option[fn(I32) -> I32], x: I32) -> I32 {
  match o {
    Some(g) => g.(x),
    None => inc(x),
  }
}

pub fn in_a_closure(f: fn(I32) -> I32, x: I32) -> I32 {
  let g = fn(h: fn(I32) -> I32, y: I32) -> I32 { h.(inc(y)) }
  g.(f, x)
}

pub fn in_a_loop(ops: [fn(I32) -> I32; 2], x: I32) -> I32 {
  var acc = x
  for g in ops {
    acc = g.(inc(acc))
  }
  acc
}

pub fn in_a_generic_function[T](f: fn(T) -> T, x: T) -> T {
  f.(x)
}

pub fn the_generic_function_is_an_item() -> I32 {
  in_a_generic_function(inc, 1) + in_a_generic_function(dec, 5)
}
