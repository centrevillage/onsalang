// Types and functions whose function values another module calls with `.(` (spec §6.1, §15.1).

pub struct Shaper {
  gain: F32,
  curve: fn(F32) -> F32,
}

pub fn soft_clip(x: F32) -> F32 {
  x / (1.0 + x)
}

pub fn inc(x: I32) -> I32 {
  x + 1
}

pub fn dec(x: I32) -> I32 {
  x - 1
}

pub fn pick(up: Bool) -> fn(I32) -> I32 {
  if up { inc } else { dec }
}

impl Shaper {
  pub fn new(gain: F32) -> Shaper {
    Shaper { gain: gain, curve: soft_clip }
  }

  pub fn run(self, x: F32) -> F32 {
    self.curve.(x) * self.gain
  }
}
