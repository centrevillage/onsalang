//! mode: test
// Panics (spec §9.2) fail the test that reaches them; `TESTFAIL` marks the
// expected failures so the runner can check the interpreter's checks.

pub fn add(a: I32, b: I32) -> I32 {
  a + b
}

test "overflow panics" {                       //~ TESTFAIL "overflow panics"
  let y = add(2147483647, 1)
  assert y == 0
}

test "wrapping does not panic" {
  let x: I32 = 2147483647
  assert (x +% 1) == -2147483648
  assert (x +| 1) == 2147483647
  let u: U8 = 250
  assert (u +% 10) == 4
  assert (u +| 10) == 255
  assert (u -| 251) == 0
}

test "division by zero panics" {               //~ TESTFAIL "division by zero panics"
  let z: I32 = 0
  assert (1 / z) == 0
}

test "index out of range panics" {             //~ TESTFAIL "index out of range panics"
  let xs: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  let i: U32 = 4
  assert xs[i] == 0.0
}

test "assert failure is reported" {            //~ TESTFAIL "assert failure is reported"
  assert add(1, 1) == 3
}

test "trunc panics out of range" {             //~ TESTFAIL "trunc panics out of range"
  let x: F32 = 1.0e10
  assert x.trunc_i32() == 0
}

test "saturating trunc" {
  let x: F32 = 1.0e10
  assert x.trunc_i32_sat() == 2147483647
  let nan: F32 = 0.0 / 0.0
  assert nan.trunc_i32_sat() == 0
}
