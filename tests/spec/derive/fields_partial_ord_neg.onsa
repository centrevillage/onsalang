// onsa.toml
// [test]
// spec = ["§6.3", "§6.4", "§18.1"]
// fixes = 0

// W5-06 U1/t, R-35 (spec §6.3, the table of the built-in types: `Bool` has `PartialEq` `Eq` `Hash` `Show` `Default` and no order; `()` has `PartialEq` `Eq`
// `Default`; `Option[T]` and `Result[T, E]` have `PartialEq` `Eq` `Hash` `Show` and no `PartialOrd` or `Ord`; `Array[T]` has `PartialEq` and `Eq` only; a tuple
// and `[T; N]` have the order when all the elements have it. §6.4: a field whose type does not meet a trait that the list generates is E0416). A field of a type
// with no order in a declaration that lists `PartialOrd` or `Ord`, in a struct and in the payload of an enum, on the line of the type of the field. One error in
// each declaration (§18.1). The last declarations are fine.

pub struct OfBool: PartialOrd {
  on: Bool,                                         //~ E0416
}

pub struct OfBoolUnderOrd: Ord {
  on: Bool,                                         //~ E0416
}

pub struct OfUnit: PartialOrd {
  nothing: (),                                      //~ E0416
}

pub struct OfOption: PartialOrd {
  o: Option[U32],                                   //~ E0416
}

pub struct OfResult: Ord {
  r: Result[U32, Bool],                             //~ E0416
}

pub struct OfArray: PartialOrd {
  a: Array[U32],                                    //~ E0416
}

pub struct InATuple: PartialOrd {
  pair: (U32, Bool),                                //~ E0416
}

pub struct InAnArray: Ord {
  flags: [Bool; 4],                                 //~ E0416
}

pub struct NestedOption: PartialOrd {
  pair: (U32, Option[U32]),                         //~ E0416
}

pub enum PayloadBool: PartialOrd {
  Off,
  Flag(Bool),                                       //~ E0416
}

pub enum PayloadOption: Ord {
  Off,
  Maybe(Option[U32]),                               //~ E0416
}

// ---------------------------------------------------------------- fine: the traits that these types have

pub struct BoolUnderEqAndHash: Eq + Hash {
  on: Bool,
}

pub struct UnitUnderEq: Eq {
  nothing: (),
}

pub struct OptionUnderEqAndHash: Eq + Hash {
  o: Option[U32],
  r: Result[Bool, U8],
}

pub struct OrderedTypes: Ord {
  n: U32,
  c: Char,
  s: Str,
  b: Bytes,
  t: (I8, Char),
  a: [U16; 3],
}

pub struct OrderOfFloats: PartialOrd {
  t: (F32, F64),
}
