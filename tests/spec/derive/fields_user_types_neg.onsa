// onsa.toml
// [test]
// spec = ["§6.3", "§6.4", "§18.1"]
// fixes = 0

// W5-06 U1/t, R-35, S-900 (spec §6.4: "各フィールド（列挙子の中身）の型が生成する trait を満たさなければ E0416"; a user type meets a trait when its own
// list generates it, with the traits above the ones that it lists). A field of a user type, on the line of the type of the field: a struct with no derive,
// a type whose list is too short (`PartialEq` only in the field of an `Eq` list), a type that meets only a part of what the list generates (`Ord` needs
// `Eq` and `PartialOrd`, and the type has one of them: the list does not write the missing trait, and the error is still one), a type that is nested in a
// tuple, an array, an `Option`, and an enum whose list is short. The declarations are in any order (a field type that is declared later is the same).
// Two wrong fields are one error, at the first field in the order of the declaration (§18.1), and one field that misses two traits is one error. One error
// in each declaration.

pub struct EqOfPlain: Eq {
  p: Plain,                                         //~ E0416
}

pub struct PartialEqOfPlain: PartialEq {
  p: Plain,                                         //~ E0416
}

pub struct PartialOrdOfPlain: PartialOrd {
  p: Plain,                                         //~ E0416
}

pub struct OrdOfPlain: Ord {
  p: Plain,                                         //~ E0416
}

pub struct HashOfPlain: Hash {
  p: Plain,                                         //~ E0416
}

pub struct DefaultOfPlain: Default {
  p: Plain,                                         //~ E0416
}

pub struct Plain {
  n: U32,
}

// ---------------------------------------------------------------- a derive that is too short

pub struct OnlyPartialEq: PartialEq {
  n: U32,
}

pub struct OnlyEq: Eq {
  n: U32,
}

pub struct OnlyPartialOrd: PartialOrd {
  n: U32,
}

pub struct OnlyHash: Hash {
  n: U32,
}

pub struct EqOfPartialEq: Eq {
  p: OnlyPartialEq,                                 //~ E0416
}

pub struct PartialOrdOfPartialEq: PartialOrd {
  p: OnlyPartialEq,                                 //~ E0416
}

pub struct HashOfPartialEq: Hash {
  p: OnlyPartialEq,                                 //~ E0416
}

pub struct OrdOfPartialEq: Ord {
  p: OnlyPartialEq,                                 //~ E0416
}

// ---------------------------------------------------------------- the traits above are not the whole list (S-900)

pub struct OrdOfPartialOrd: Ord {
  p: OnlyPartialOrd,                                //~ E0416
}

pub struct OrdOfEq: Ord {
  p: OnlyEq,                                        //~ E0416
}

pub struct OrdOfHash: Ord {
  p: OnlyHash,                                      //~ E0416
}

pub struct OrdOfEqAndHash: Ord {
  p: EqAndHash,                                     //~ E0416
}

pub struct EqAndHash: Eq + Hash {
  n: U32,
}

pub struct EqOfHash: Eq {
  p: OnlyHash,                                      //~ E0416
}

// ---------------------------------------------------------------- nested in the types that hold it

pub struct InATuple: Eq {
  t: (U32, OnlyPartialEq),                          //~ E0416
}

pub struct InAnArray: PartialEq {
  xs: [Plain; 2],                                   //~ E0416
}

pub struct InAnOption: Eq {
  o: Option[OnlyPartialEq],                         //~ E0416
}

pub struct InAResult: Hash {
  r: Result[U32, OnlyPartialEq],                    //~ E0416
}

pub struct InAnArrayType: PartialEq {
  a: Array[Plain],                                  //~ E0416
}

pub struct HolderOfPartialEq: PartialEq {
  p: OnlyPartialEq,
}

pub struct ThroughAnotherStruct: Eq {
  inner: HolderOfPartialEq,                         //~ E0416
}

pub struct ThroughAnOption: Hash {
  inner: Option[HolderOfPartialEq],                 //~ E0416
}

// ---------------------------------------------------------------- the payload of an enum

pub enum PayloadOfPlain: PartialEq {
  Off,
  Data(Plain),                                      //~ E0416
}

pub enum PayloadOfShort: Eq {
  Data(OnlyPartialEq),                              //~ E0416
  Off,
}

pub enum PayloadOfEnumShort: Ord {
  Inner(EqOfEnum),                                  //~ E0416
}

pub enum EqOfEnum: Eq {
  A,
  B,
}

pub enum PayloadTwoFields: PartialEq {
  Pair(U32, Plain),                                 //~ E0416
}

// ---------------------------------------------------------------- more than one wrong field is one error

pub struct TwoWrongFields: Eq {
  id: U32,
  first: F32,                                       //~ E0416
  second: Plain,
  third: F64,
}

pub struct WrongInTheOrderOfTheDeclaration: Eq {
  first: Plain,                                     //~ E0416
  second: F32,
}

pub enum TwoWrongPayloads: Eq {
  Fine(U32),
  First(F32),                                       //~ E0416
  Second(Plain),
}

pub struct OneFieldTwoTraits: Eq + Hash {
  both: F32,                                        //~ E0416
}

// ---------------------------------------------------------------- fine: the types meet what the list generates

pub struct OrdOfOrd: Ord {
  p: OrdOfOrdInner,
}

pub struct OrdOfOrdInner: Ord {
  n: U32,
}

pub struct EqOfWholeList: Eq {
  a: EqAndHash,
  b: OrdOfOrdInner,
  c: EqOfEnum,
}
