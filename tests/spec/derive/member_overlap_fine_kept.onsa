// onsa.toml
// [test]
// spec = ["§6.2", "§6.4", "§6.3"]
// fixes = 0

// W5-06 U2/t, S-851 (spec §6.2: the names after a type name are one space, and "derive が作るメンバ（`default`、`ordinal`、`from_ordinal`）" are in it; §6.4: the list makes the members of the traits that
// it names, and the traits above them are generated too (`Ord` gives `Eq`, but `Default` has no trait above it and none of these members belongs to a trait above another). The forms that are not an overlap:
// a field named `default` (a field is not in the space of the members), a free function and a local named like a member, a type that does not list the trait that makes the name (`Eq`, `Ord`, `Hash`,
// no list; an enum that lists `Ordinal` has no `default`, a struct that lists `Default` has no `ordinal`), a member of another name (`defaults`, `new_default`, `ordinals`), the same name in the `impl` of another
// type, and the derive still works next to them (`P.default()`, `m.ordinal()`). The traits above a trait do not make a member: `Ord` gives `Eq`, `PartialOrd`, `PartialEq`, none of which makes one.

// This file is the part of member_overlap_fine.onsa that already passes before W5-06 (the names that are not an overlap, whatever the derive makes); the uses of the derive next to them wait for W5-06 and are in member_overlap_fine.onsa (8.5).

pub struct HasFieldDefault: Default {
  default: I32,
}

pub struct HasFieldOrdinal: Default {
  ordinal: U32,
  from_ordinal: U32,
}

pub struct EqOnly: Eq {
  n: I32,
}

impl EqOnly {
  pub fn default() -> EqOnly {
    EqOnly { n: 1 }
  }
}

pub struct OrdOnly: Ord {
  n: I32,
}

impl OrdOnly {
  pub fn default() -> OrdOnly {
    OrdOnly { n: 1 }
  }
}

pub struct HashOnly: Hash {
  n: I32,
}

impl HashOnly {
  pub fn default() -> HashOnly {
    HashOnly { n: 1 }
  }
}

pub struct NoList {
  n: I32,
}

impl NoList {
  pub fn default() -> NoList {
    NoList { n: 1 }
  }

  pub fn ordinal(self) -> U32 {
    1
  }

  pub fn from_ordinal(n: U32) -> NoList {
    NoList { n: 1 }
  }
}

pub enum PlainEnum {
  A,
  B,
}

impl PlainEnum {
  pub fn ordinal(self) -> U32 {
    match self {
      PlainEnum.A => 0,
      PlainEnum.B => 1,
    }
  }

  pub fn from_ordinal(n: U32) -> Option[PlainEnum] {
    match n {
      0 => Some(PlainEnum.A),
      1 => Some(PlainEnum.B),
      _ => None,
    }
  }

  pub fn default() -> PlainEnum {
    PlainEnum.A
  }
}

pub enum EqEnum: Eq {
  A,
  B,
}

impl EqEnum {
  pub fn ordinal(self) -> U32 {
    0
  }
}

// `Ordinal` makes `ordinal` and `from_ordinal` only; `default` is free.
pub enum OrdinalEnum: Ordinal {
  A,
  B,
}

impl OrdinalEnum {
  pub fn default() -> OrdinalEnum {
    OrdinalEnum.B
  }

  pub fn to_ordinal(self) -> U32 {
    0
  }
}

// `Default` makes `default` only; `ordinal` and `from_ordinal` are free.
pub struct DefaultStruct: Default {
  n: I32,
}

impl DefaultStruct {
  pub fn ordinal(self) -> U32 {
    1
  }

  pub fn from_ordinal(n: U32) -> DefaultStruct {
    DefaultStruct { n: 1 }
  }
}

// Other names that look like the members.
pub struct Names: Default {
  n: I32,
}

impl Names {
  pub fn defaults() -> I32 {
    0
  }

  pub fn new_default() -> Names {
    Names { n: 1 }
  }

  pub fn default_value(self) -> I32 {
    self.n
  }

  pub fn is_default(self) -> Bool {
    self.n == 0
  }
}

pub enum Names2: Ordinal {
  A,
  B,
}

impl Names2 {
  pub fn ordinals() -> U32 {
    2
  }

  pub fn from_ordinals(n: U32) -> U32 {
    n
  }

  pub fn ordinal_of(self) -> U32 {
    0
  }
}

// The same name in the `impl` of another type than the one that lists the trait.
pub struct Maker: Default {
  n: I32,
}

pub struct Other {
  n: I32,
}

impl Other {
  pub fn default() -> Other {
    Other { n: 2 }
  }
}

pub enum OtherEnum {
  A,
}

impl OtherEnum {
  pub fn ordinal(self) -> U32 {
    5
  }
}

// A generic type that does not list the trait, and one that lists it.
pub struct Plain[T] {
  a: T,
}

impl[T] Plain[T] {
  pub fn default() -> I32 {
    0
  }
}

pub struct Listed[T]: Eq {
  a: T,
}

impl[T] Listed[T] {
  pub fn default() -> I32 {
    0
  }
}

// A free function (`ordinal`, `from_ordinal`), a local and a parameter (`default`) with the name of a member are not members.
pub fn ordinal(n: U32) -> U32 {
  n
}

pub fn from_ordinal(n: U32) -> U32 {
  n
}

pub fn locals_named_like_members() -> U32 {
  let default = 1
  default + 2
}

pub fn parameter_named_like_a_member(default: U32) -> U32 {
  default + 1
}

pub fn the_field_is_a_field(h: HasFieldDefault) -> I32 {
  h.default
}

pub fn the_default_of_the_enum_with_ordinal() -> OrdinalEnum {
  OrdinalEnum.default()
}

pub fn the_hand_written_ordinal_of_the_struct(d: DefaultStruct) -> U32 {
  d.ordinal()
}

pub fn the_hand_written_members(p: PlainEnum, n: U32) -> Option[PlainEnum] {
  PlainEnum.from_ordinal(p.ordinal() + n)
}
