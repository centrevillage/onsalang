// The module `util` of the case in main.onsa: the types whose members the other module uses.

pub struct Hidden: Default {
  priv gain: F32,
  priv steps: U32,
  name: Str,
}

impl Hidden {
  pub fn gain(self) -> F32 {
    self.gain
  }

  pub fn steps(self) -> U32 {
    self.steps
  }
}

pub struct Wrap[T]: Default {
  priv inner: T,
  extra: U8,
}

pub struct Plain {
  n: I32,
}

pub enum Mode: Ordinal {
  Off,
  On,
  Auto,
}

// no `pub`: the type is visible in the package, and so are the members that the derive makes
struct Internal: Default {
  n: I32,
}

enum Phase: Ordinal {
  Attack,
  Release,
}
