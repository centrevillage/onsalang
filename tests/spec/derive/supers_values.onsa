// onsa.toml
// [test]
// mode = "test"
// spec = ["§6.3", "§6.4"]

// W5-06 U1/t, S-900 (spec §6.4: "`struct P: Ord` は `PartialEq` `Eq` `PartialOrd` `Ord` を実装する"; "`PartialEq` / `Eq` は、全てのフィールド
// （enum は列挙子と中身）が等しいとき等しい"). The `==` that a list gives only by the traits above it: a struct and an enum that list `Ord`,
// a struct that lists `Eq`, a struct that lists `PartialOrd`, and the same values through a type parameter with each bound. The
// values are worked out by hand. `<` is not run: the Core of the comparison is W8-10 (S-135).

pub struct Ranked: Ord {
  rank: U32,
  tag: U8,
}

pub struct Keyed: Eq {
  id: U32,
}

pub struct Sizing: PartialOrd {
  size: U32,
}

pub enum Slot: Ord {
  Empty,
  Full(U32),
  Pair(U32, U8),
}

fn same_partial_eq[T: PartialEq](a: T, b: T) -> Bool {
  a == b
}

fn same_eq[T: Eq](a: T, b: T) -> Bool {
  a == b
}

fn same_partial_ord[T: PartialOrd](a: T, b: T) -> Bool {
  a == b
}

fn same_ord[T: Ord](a: T, b: T) -> Bool {
  a == b
}

test "== of a struct that lists Ord" {
  let a = Ranked { rank: 1, tag: 2 }
  let b = Ranked { rank: 1, tag: 2 }
  let c = Ranked { rank: 1, tag: 3 }
  let d = Ranked { rank: 2, tag: 2 }
  assert a == b
  assert a != c
  assert a != d
  assert !(a == c)
}

test "== of a struct that lists Eq" {
  assert Keyed { id: 7 } == Keyed { id: 7 }
  assert Keyed { id: 7 } != Keyed { id: 8 }
}

test "== of a struct that lists PartialOrd" {
  assert Sizing { size: 4 } == Sizing { size: 4 }
  assert Sizing { size: 4 } != Sizing { size: 5 }
}

test "== of an enum that lists Ord" {
  assert Slot.Empty == Slot.Empty
  assert Slot.Full(3) == Slot.Full(3)
  assert Slot.Pair(1, 2) == Slot.Pair(1, 2)
  assert Slot.Empty != Slot.Full(3)
  assert Slot.Full(3) != Slot.Full(4)
  assert Slot.Pair(1, 2) != Slot.Pair(1, 3)
  assert Slot.Full(1) != Slot.Pair(1, 2)
}

test "== through each bound that a list gives" {
  let a = Ranked { rank: 1, tag: 2 }
  let b = Ranked { rank: 1, tag: 3 }
  assert same_partial_eq(a, a)
  assert same_eq(a, a)
  assert same_partial_ord(a, a)
  assert same_ord(a, a)
  assert !same_partial_eq(a, b)
  assert !same_eq(a, b)
  assert !same_partial_ord(a, b)
  assert !same_ord(a, b)
  assert same_partial_eq(Keyed { id: 1 }, Keyed { id: 1 })
  assert same_eq(Keyed { id: 1 }, Keyed { id: 1 })
  assert same_partial_eq(Sizing { size: 1 }, Sizing { size: 1 })
  assert same_partial_ord(Sizing { size: 1 }, Sizing { size: 1 })
  assert !same_partial_ord(Sizing { size: 1 }, Sizing { size: 2 })
  assert same_ord(Slot.Full(2), Slot.Full(2))
  assert !same_ord(Slot.Full(2), Slot.Empty)
}
