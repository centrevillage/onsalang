// onsa.toml
// [test]
// spec = ["§6.3", "§6.4"]

// W5-06 U1/t, R-35 (spec §6.4: "各フィールド（列挙子の中身）の型が生成する trait を満たさなければ E0416"; §6.3, the table of the built-in types and "タプルと `[T; N]` の実装は、処理系が構造から
// 与える"). The forms that meet what the list generates, so nothing is reported: the integers, `Char`, `Str`, `Bytes` and `Bool` under the lists that have them, a tuple and an array
// of such types, `Option` and `Result` of them, `Array[T]` under `PartialEq` and `Eq`, and a user type that is declared later in the file, in a struct and in the
// payload of an enum, nested in several steps. An empty struct meets every list. A float meets `PartialEq`, `PartialOrd` and `Default`. The list that generates the
// traits above (S-900) gives the same check: `Ord` over a type that lists `Ord`.

pub struct Outer: Eq {
  inner: Inner,
  pair: (U32, Bool),
  flags: [Bool; 3],
  maybe: Option[Inner],
  result: Result[U8, Inner],
}

pub struct Inner: Eq {
  id: U32,
  tag: Char,
  deeper: Deepest,
}

pub struct Deepest: Eq {
  b: Bool,
}

pub struct Unit: Ord {}

pub struct HoldsUnit: Eq {
  u: Unit,
  nothing: (),
}

pub struct HashedKey: Hash {
  name: Str,
  data: Bytes,
  c: Char,
  b: Bool,
  n: I64,
  t: (U8, Char),
  xs: [U16; 4],
  o: Option[Str],
  r: Result[Char, Bytes],
}

pub struct HashedNested: Hash {
  key: HashedKey,
  more: (HashedKey, Option[HashedKey]),
}

pub struct Ordered: Ord {
  n: U32,
  c: Char,
  s: Str,
  b: Bytes,
  t: (I8, Char),
  a: [U16; 3],
  inner: OrderedInner,
}

pub struct OrderedInner: Ord {
  n: U8,
}

pub struct Floats: PartialOrd {
  a: F32,
  b: F64,
  t: (F32, U8),
  xs: [F64; 2],
}

pub struct Sequences: Eq {
  a: Array[U32],
  b: Array[Char],
  c: Array[(U32, Bool)],
  d: Array[Inner],
  e: Array[Array[U8]],
}

pub struct PartialSequences: PartialEq {
  floats: Array[F32],
  nested: (Array[F64], U8),
}

pub struct Defaults: Default {
  n: U32,
  f: F32,
  b: Bool,
  s: Str,
  y: Bytes,
  u: (),
  t: (I8, Bool),
  xs: [F64; 2],
  nested: Defaults2,
}

pub struct Defaults2: Default {
  n: U8,
}

pub enum Event: Eq {
  Off,
  Note(U8, Bool),
  Named(Inner),
  Keys(Option[Inner]),
  Unit(Unit),
  Pair((U8, U8), [Bool; 2]),
}

pub enum HashedEvent: Hash {
  Off,
  Key(HashedKey),
  Name(Str),
}

pub enum OrderedEvent: Ord {
  Low,
  High(Ordered),
  Mid(Unit, U32),
}

pub enum NoPayload: Eq + Hash + Ord {
  A,
  B,
  C,
}
