// onsa.toml
// [test]
// mode = "check"
// spec = ["§2.5", "§3.1", "§18.1"]

// Boundary of the nesting depth, expression forms: parentheses, prefix operators, calls and a
// postfix chain.
//
// Levels are counted per declaration unit from 0 (spec 2.5): a function body is level 1, and each
// form (parenthesis, operator, postfix, keyword, block, type with arguments, pattern) is one level;
// names, literals, `_`, sequences and statements are not counted. These cases are the largest that
// the limit accepts: every case unit is exactly 256 levels deep (the helper declarations are
// shallower).
//
// paren: the body block is level 1, so 255 parentheses reach 256. prefix: each `-(` is two levels
// (`-` and `(`), the innermost `-x` one. call: `id(...)` is one level per call, the name is not
// counted. tuple_index: a chain `t.0.0...` is one level per `.0`, the operand `t` is a name.

pub fn id[T](x: T) -> T {
  x
}

