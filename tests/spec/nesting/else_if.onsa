// onsa.toml
// [test]
// mode = "test"
// spec = ["§2.5", "§7"]

// An `else if` chain is nested in the tree: each `else if` is an `if` inside the previous `else`.
// A chain of 100 links (the first `if` and 99 `else if`), written on separate lines and on one line.

pub fn classify(x: I32) -> I32 {
  if x == 0 {
    0
  } else if x == 1 {
    2
  } else if x == 2 {
    4
  } else if x == 3 {
    6
  } else if x == 4 {
    8
  } else if x == 5 {
    10
  } else if x == 6 {
    12
  } else if x == 7 {
    14
  } else if x == 8 {
    16
  } else if x == 9 {
    18
  } else if x == 10 {
    20
  } else if x == 11 {
    22
  } else if x == 12 {
    24
  } else if x == 13 {
    26
  } else if x == 14 {
    28
  } else if x == 15 {
    30
  } else if x == 16 {
    32
  } else if x == 17 {
    34
  } else if x == 18 {
    36
  } else if x == 19 {
    38
  } else if x == 20 {
    40
  } else if x == 21 {
    42
  } else if x == 22 {
    44
  } else if x == 23 {
    46
  } else if x == 24 {
    48
  } else if x == 25 {
    50
  } else if x == 26 {
    52
  } else if x == 27 {
    54
  } else if x == 28 {
    56
  } else if x == 29 {
    58
  } else if x == 30 {
    60
  } else if x == 31 {
    62
  } else if x == 32 {
    64
  } else if x == 33 {
    66
  } else if x == 34 {
    68
  } else if x == 35 {
    70
  } else if x == 36 {
    72
  } else if x == 37 {
    74
  } else if x == 38 {
    76
  } else if x == 39 {
    78
  } else if x == 40 {
    80
  } else if x == 41 {
    82
  } else if x == 42 {
    84
  } else if x == 43 {
    86
  } else if x == 44 {
    88
  } else if x == 45 {
    90
  } else if x == 46 {
    92
  } else if x == 47 {
    94
  } else if x == 48 {
    96
  } else if x == 49 {
    98
  } else if x == 50 {
    100
  } else if x == 51 {
    102
  } else if x == 52 {
    104
  } else if x == 53 {
    106
  } else if x == 54 {
    108
  } else if x == 55 {
    110
  } else if x == 56 {
    112
  } else if x == 57 {
    114
  } else if x == 58 {
    116
  } else if x == 59 {
    118
  } else if x == 60 {
    120
  } else if x == 61 {
    122
  } else if x == 62 {
    124
  } else if x == 63 {
    126
  } else if x == 64 {
    128
  } else if x == 65 {
    130
  } else if x == 66 {
    132
  } else if x == 67 {
    134
  } else if x == 68 {
    136
  } else if x == 69 {
    138
  } else if x == 70 {
    140
  } else if x == 71 {
    142
  } else if x == 72 {
    144
  } else if x == 73 {
    146
  } else if x == 74 {
    148
  } else if x == 75 {
    150
  } else if x == 76 {
    152
  } else if x == 77 {
    154
  } else if x == 78 {
    156
  } else if x == 79 {
    158
  } else if x == 80 {
    160
  } else if x == 81 {
    162
  } else if x == 82 {
    164
  } else if x == 83 {
    166
  } else if x == 84 {
    168
  } else if x == 85 {
    170
  } else if x == 86 {
    172
  } else if x == 87 {
    174
  } else if x == 88 {
    176
  } else if x == 89 {
    178
  } else if x == 90 {
    180
  } else if x == 91 {
    182
  } else if x == 92 {
    184
  } else if x == 93 {
    186
  } else if x == 94 {
    188
  } else if x == 95 {
    190
  } else if x == 96 {
    192
  } else if x == 97 {
    194
  } else if x == 98 {
    196
  } else if x == 99 {
    198
  } else {
    -1
  }
}

pub fn classify_one_line(x: I32) -> I32 {
  if x == 0 { 0 } else if x == 1 { 2 } else if x == 2 { 4 } else if x == 3 { 6 } else if x == 4 { 8 } else if x == 5 { 10 } else if x == 6 { 12 } else if x == 7 { 14 } else if x == 8 { 16 } else if x == 9 { 18 } else if x == 10 { 20 } else if x == 11 { 22 } else if x == 12 { 24 } else if x == 13 { 26 } else if x == 14 { 28 } else if x == 15 { 30 } else if x == 16 { 32 } else if x == 17 { 34 } else if x == 18 { 36 } else if x == 19 { 38 } else if x == 20 { 40 } else if x == 21 { 42 } else if x == 22 { 44 } else if x == 23 { 46 } else if x == 24 { 48 } else if x == 25 { 50 } else if x == 26 { 52 } else if x == 27 { 54 } else if x == 28 { 56 } else if x == 29 { 58 } else if x == 30 { 60 } else if x == 31 { 62 } else if x == 32 { 64 } else if x == 33 { 66 } else if x == 34 { 68 } else if x == 35 { 70 } else if x == 36 { 72 } else if x == 37 { 74 } else if x == 38 { 76 } else if x == 39 { 78 } else if x == 40 { 80 } else if x == 41 { 82 } else if x == 42 { 84 } else if x == 43 { 86 } else if x == 44 { 88 } else if x == 45 { 90 } else if x == 46 { 92 } else if x == 47 { 94 } else if x == 48 { 96 } else if x == 49 { 98 } else if x == 50 { 100 } else if x == 51 { 102 } else if x == 52 { 104 } else if x == 53 { 106 } else if x == 54 { 108 } else if x == 55 { 110 } else if x == 56 { 112 } else if x == 57 { 114 } else if x == 58 { 116 } else if x == 59 { 118 } else if x == 60 { 120 } else if x == 61 { 122 } else if x == 62 { 124 } else if x == 63 { 126 } else if x == 64 { 128 } else if x == 65 { 130 } else if x == 66 { 132 } else if x == 67 { 134 } else if x == 68 { 136 } else if x == 69 { 138 } else if x == 70 { 140 } else if x == 71 { 142 } else if x == 72 { 144 } else if x == 73 { 146 } else if x == 74 { 148 } else if x == 75 { 150 } else if x == 76 { 152 } else if x == 77 { 154 } else if x == 78 { 156 } else if x == 79 { 158 } else if x == 80 { 160 } else if x == 81 { 162 } else if x == 82 { 164 } else if x == 83 { 166 } else if x == 84 { 168 } else if x == 85 { 170 } else if x == 86 { 172 } else if x == 87 { 174 } else if x == 88 { 176 } else if x == 89 { 178 } else if x == 90 { 180 } else if x == 91 { 182 } else if x == 92 { 184 } else if x == 93 { 186 } else if x == 94 { 188 } else if x == 95 { 190 } else if x == 96 { 192 } else if x == 97 { 194 } else if x == 98 { 196 } else if x == 99 { 198 } else { -1 }
}

test "long else if chain" {
  assert classify(0) == 0
  assert classify(1) == 2
  assert classify(50) == 100
  assert classify(99) == 198
  assert classify(100) == -1
  assert classify(-5) == -1
  assert classify_one_line(0) == 0
  assert classify_one_line(99) == 198
  assert classify_one_line(107) == -1
}
