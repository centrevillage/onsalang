// onsa.toml
// [test]
// mode = "test"
// spec = ["§2.5", "§11.5"]

// Nesting in a flow body: a `par` whose body is an expression 40 `if`s deep, and an output
// expression that is a chain of 100 terms. A flow body is `let`s and one final expression (§11.2); the
// nested `if`s are expressions, not statements.

pub flow deep_if(x: F32 at sample) -> [F32; 2] at sample {
  par i in 0..<2 { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { if x > i.round_f32() { x } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } } else { 0.0 } }
}

pub flow wide_sum(x: F32 at sample) -> F32 at sample {
  x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x
}

test "deep if in par" {
  // Replica i yields x when x > i, else 0 (all the nested conditions are the same).
  let xs: [F32; 3] = [0.5, 1.5, 2.5]
  let o = deep_if.render(deep_if.Config {}, deep_if.Params {}, xs, 8.0)
  assert o.out[0][0] == 0.5
  assert o.out[0][1] == 1.5
  assert o.out[0][2] == 2.5
  assert o.out[1][0] == 0.0
  assert o.out[1][1] == 1.5
  assert o.out[1][2] == 2.5
}

test "long sum in a flow" {
  let xs: [F32; 2] = [1.0, 2.0]
  let o = wide_sum.render(wide_sum.Config {}, wide_sum.Params {}, xs, 8.0)
  assert o.out[0] == 100.0
  assert o.out[1] == 200.0
}
