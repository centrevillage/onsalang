// onsa.toml
// [test]
// mode = "check"
// spec = ["§2.5", "§6.6", "§18.1"]

// Where counting starts, per declaration unit (18.1): a function body is level 1 (a `fn`, a method
// of an `impl` and a `test` body have the same boundary), the first form of a `const` initializer is
// level 1 (so the `const` takes one more parenthesis than the function body: D parentheses against D
// - 1). The depth does not add up over a file: every unit below, the helper `id` and all, is
// separate.
//
// Levels are counted per declaration unit from 0 (spec 2.5): a function body is level 1, and each
// form (parenthesis, operator, postfix, keyword, block, type with arguments, pattern) is one level;
// names, literals, `_`, sequences and statements are not counted. These cases are the largest that
// the limit accepts: every case unit is exactly 256 levels deep (the helper declarations are
// shallower).

pub fn id[T](x: T) -> T {
  x
}

pub struct Counter {
  n: I32,
}

pub fn paren_256() -> I32 {
  (((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((1)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
}

