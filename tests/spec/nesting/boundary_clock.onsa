// onsa.toml
// [test]
// mode = "parse"
// spec = ["§2.5", "§11.3", "§18.1"]

// Boundary of the nesting depth, the clock `at` (§2.5): `at` is one level, as `as` is (the form
// list of §2.5 names both). Levels are counted per declaration unit from 0: a flow body is
// level 1, and each form is one level; names, literals, statements and the head of the
// declaration are not counted. These units are exactly 256 levels deep, the most the limit
// accepts, with the `at` as the deepest form: after 254 parentheses (levels 2 to 255), after 254
// calls, and inside 127 `if~` (an `if~` and its block are two levels each). The file is read by
// the syntax stage only (mode = "parse"): nothing in it is a flow that checks.
// negative/nesting_boundary_clock.onsa has the same units one level deeper.

pub flow paren_256(x: F32 at block) -> F32 at sample {
  ((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((x at sample))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
}

