pub fn nest_for() -> I32 {
  var n = 0
  for _ in 0 ..< 1 {
    for _ in 0 ..< 1 {
      for _ in 0 ..< 1 {
        for _ in 0 ..< 1 {
          for _ in 0 ..< 1 {
            for _ in 0 ..< 1 {
              for _ in 0 ..< 1 {
                for _ in 0 ..< 1 {
                  for _ in 0 ..< 1 {
                    for _ in 0 ..< 1 {
                      for _ in 0 ..< 1 {
                        for _ in 0 ..< 1 {
                          for _ in 0 ..< 1 {
                            for _ in 0 ..< 1 {
                              for _ in 0 ..< 1 {
                                for _ in 0 ..< 1 {
                                  for _ in 0 ..< 1 {
                                    for _ in 0 ..< 1 {
                                      for _ in 0 ..< 1 {
                                        for _ in 0 ..< 1 {
                                          for _ in 0 ..< 1 {
                                            for _ in 0 ..< 1 {
                                              for _ in 0 ..< 1 {
                                                for _ in 0 ..< 1 {
                                                  for _ in 0 ..< 1 {
                                                    for _ in 0 ..< 1 {
                                                      for _ in 0 ..< 1 {
                                                        for _ in 0 ..< 1 {
                                                          for _ in 0 ..< 1 {
                                                            for _ in 0 ..< 1 {
                                                              for _ in 0 ..< 1 {
                                                                for _ in 0 ..< 1 {
                                                                  for _ in 0 ..< 1 {
                                                                    for _ in 0 ..< 1 {
                                                                      for _ in 0 ..< 1 {
                                                                        for _ in 0 ..< 1 {
                                                                          for _ in 0 ..< 1 {
                                                                            for _ in 0 ..< 1 {
                                                                              for _ in 0 ..< 1 {
                                                                                for _ in 0 ..< 1 {
                                                                                  n = n + 1
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  n
}

test "nested blocks" {
  assert nest_if(true) == 1
  assert nest_if(false) == 0
  assert nest_if_one_line(true) == 1
  assert nest_if_one_line(false) == 0
  assert nest_match(Some(5)) == 1
  assert nest_match(None) == 0
  assert nest_for() == 1
}
