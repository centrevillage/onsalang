// onsa.toml
// [test]
// mode = "parse"
// spec = ["§2.5", "§4.5"]

// The functions of negative/nesting_type_args_expr_three_levels_over.onsa one level shallower (S-332,
// §2.5, §4.5): `x.f::[U8](y)` is three levels, so 85 segments `.f::[U8](a)` after `s` are 255 high,
// and a receiver of 252 fields, parentheses or indexes with `.m::[U8](y)` is 255 high. A `let g = …`
// of that height is level 256, the deepest the limit accepts, and nothing is reported. The file
// reads the syntax only (`mode = "parse"`).

pub fn chain_85_fits(s: S, xs: [S; 1], y: U8, a: U8, c: Bool) -> I32 {
  let g = s.f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a).f::[U8](a)
