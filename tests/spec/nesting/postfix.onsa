// onsa.toml
// [test]
// mode = "test"
// spec = ["§2.5", "§6.2", "§9.1", "§4.4", "§4.5"]

// Postfix chains (§2.5, §3.1: calls, fields, indexes, `?` bind tighter than everything). The tree
// of `a.b().c().d()` is as deep as the chain, and a type or a literal of the same depth makes the
// operand deep too. Method chain: 80 calls. Index and tuple field chains: 100; struct field chain: 70 (the struct values are built by nested calls of a generic `wrap`). `?`
// chain: 60.

pub struct Counter {
  n: I32,
}

impl Counter {
  pub fn inc(self) -> Counter {
    Counter { n: self.n + 1 }
  }
}

pub struct Wrap[T] {
  v: T,
}

pub fn wrap[T](x: T) -> Wrap[T] {
  Wrap { v: x }
}

