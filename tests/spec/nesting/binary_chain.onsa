test "long chains of one group" {
  assert sum_chain() == 180
  assert add_sub_chain() == 2
  assert product_chain() == 2
  assert float_chain() == 90.0
  assert wrap_chain(250) == 174
  assert sat_chain(250) == 255
  assert and_chain(true)
  assert !and_chain(false)
  assert or_chain(true)
  assert !or_chain(false)
}
