// onsa.toml
// [test]
// mode = "test"
// spec = ["§2.5", "§3.1", "§3.4"]

// Chains of one binary operator group are left-nested in the tree, so a chain of N terms has depth
// about N (§2.5 counts "二項演算子の連鎖"). Every chain below has 180 terms and is accepted: it is
// valid under the group rules of §3.1 (a chain of one group).

