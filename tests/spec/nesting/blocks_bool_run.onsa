// onsa.toml
// [test]
// mode = "test"
// spec = ["§2.5", "§7"]

// A `match` on a Bool whose `true` arm is a block holding the next `match`: 40 levels.
// The `_run` twin of the same function runs it.

pub fn nest_bool(c: Bool) -> I32 {
