// onsa.toml
// [test]
// spec = ["§15.1", "§11.2", "§18.1"]

// S-676, S-675: an item and a `use` of one name: the E0304 is on the `use` whichever is written first,
// the body of the item is checked (the `true` in `quad` is E0401: the item is a unit of its own), and
// the name is drawn from neither: the uses are `Bool` for what `util` returns (`I32`) and for what the
// item returns, and none is reported.
use util.{quad}                                     //~ E0304

pub fn quad() -> I32 {
  true                                              //~ E0401
}

pub fn sixth() -> F32 {
  6.0
}

use util.{sixth}                                    //~ E0304

pub fn uses_quad() -> I32 {
  let _: Bool = quad()
  0
}

pub fn uses_sixth() -> I32 {
  let _: Bool = sixth()
  0
}
