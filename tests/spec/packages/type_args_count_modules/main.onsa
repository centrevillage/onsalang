// onsa.toml
// [test]
// spec = ["§4.5", "§4.4", "§15.1", "§18.1"]

// S-103, R-258, R-197 (W4-05 U4c): the number of the type arguments is counted from the declaration wherever
// the declaration is: a type of another module that a `use` took, the same type written by its path
// (`shapes.Pair`), an alias of another module (`Alias` is `Plain`, which takes none; `PairOfInt` has its
// argument decided, so a second one is too many: §4.4). Each is the E0412 of §4.5 and not the E0302 of the old
// reading. The declaring module counts its own types the same way (shapes.onsa). One error per unit (§18.1),
// so each form is in its own unit; the fine uses are the last units (generic_struct_import_counts has the
// forms with `use` only).
use shapes
use shapes.{Pair, Ring, Plain, Alias, PairOfInt}

pub fn plain_with_an_argument(x: Plain[I32]) -> I32 {   //~ E0412
  1
}

pub fn alias_with_an_argument(x: Alias[I32]) -> I32 {   //~ E0412
  1
}

pub fn alias_of_a_pair_with_an_argument(x: PairOfInt[I32]) -> I32 {   //~ E0412
  1
}

pub fn pair_with_two_arguments(x: Pair[I32, I32]) -> I32 {   //~ E0412
  1
}

pub fn pair_with_no_arguments(x: Pair) -> I32 {   //~ E0412
  1
}

pub fn ring_without_the_length(x: Ring[F32]) -> I32 {   //~ E0412
  1
}

pub fn path_plain_with_an_argument(x: shapes.Plain[I32]) -> I32 {   //~ E0412
  1
}

pub fn path_pair_with_no_arguments(x: shapes.Pair) -> I32 {   //~ E0412
  1
}

pub fn path_pair_with_two_arguments(x: shapes.Pair[I32, I32]) -> I32 {   //~ E0412
  1
}

pub fn path_ring_with_three_arguments(x: shapes.Ring[F32, 4, 5]) -> I32 {   //~ E0412
  1
}

pub fn path_alias_with_an_argument(x: shapes.Alias[I32]) -> I32 {   //~ E0412
  1
}

pub fn path_alias_of_a_pair_with_an_argument(x: shapes.PairOfInt[I32]) -> I32 {   //~ E0412
  1
}

pub struct InAField {
  p: Pair[I32, I32],                                //~ E0412
}

pub enum InAVariant {
  A(Plain[I32]),                                    //~ E0412
}

type InAnAlias = shapes.Ring[F32]                   //~ E0412

pub fn in_an_annotation() -> I32 {
  let _: Pair = shapes.Pair { first: 1, second: 2 }   //~ E0412
  1
}

pub fn in_a_result() -> Option[Plain[I32]] {   //~ E0412
  None
}

pub fn fine_by_use(a: Pair[I32], b: Ring[F32, 4], c: Plain, d: Alias, e: PairOfInt) -> I32 {
  1
}

pub fn fine_by_path(a: shapes.Pair[I32], b: shapes.Ring[F32, 4], c: shapes.Plain, d: shapes.Alias, e: shapes.PairOfInt) -> I32 {
  1
}

pub fn fine_in_an_annotation() -> I32 {
  let _: Pair[I32] = shapes.Pair { first: 1, second: 2 }
  let _: shapes.Alias = shapes.Plain { x: 1 }
  1
}
