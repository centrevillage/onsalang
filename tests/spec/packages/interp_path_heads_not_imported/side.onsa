// What `main` takes with `use` is no name of this module (§15.1: a `use` binding is a name of the
// module that writes it only), so the holes that name it are not found.
use cfg

pub fn takes_cfg_here() -> U32 {
  cfg.N + 1
}

pub fn inner_is_taken_in_main_only() -> Str uses {Alloc} {
  "{inner.K}"   //~ E0302
}

pub fn the_constant_is_not_taken_by_the_module() -> Str uses {Alloc} {
  "{N}"   //~ E0302
}
