// onsa.toml
// [test]
// spec = ["§18.1", "§15.1"]

// §18.1: the members of an item a syntax error cut (`E` of `util.onsa`, whose `(` is never closed,
// E0002) are not known, and a name after it is an error with no diagnostic where it is used. Here
// the path goes through a module first (`util.E.Zed`): the only diagnostic is the E0002, whatever
// the place of the path in the body.
use util

fn g(x: I32) -> I32 {
  x
}

pub fn a_value() -> I32 {
  let y = util.E.Zed
  0
}

pub fn a_method() -> I32 {
  util.E.m()
}

const BEFORE_A_METHOD: I32 = -(util.E.Zed.x())

test "the operand of a match" {
  let r = match util.E.Zed.x() {
    _ => 1,
  }
  assert true
}

test "an argument" {
  let r = g(util.E.Zed)
  assert true
}

test "in an anonymous function" {
  let r = fn(a: I32) -> I32 { util.E.Zed(1) }
  assert true
}
