// onsa.toml
// [test]
// spec = ["§11.7", "§15.1", "§2.4", "§18.1"]

// W7-13 U4b/t, S-87 (2), R-291 (spec §11.7: a value of `@param` is written "`const` の初期化式と同じ規則で", so the names in it are the ones of the scope of the
// module: those that it has taken with `use` and its own). A name of another module that the module has taken with `use` is found: a value that is that name,
// or a hole of a string with it, is E0200 until W9-03 (the evaluation is not done yet); a name of another module that it has not taken is not in the scope:
// E0302, in a value and in the hole of a string. The same holds in the other file (consts.onsa), whose scope is its own names: a name of main.onsa is E0302
// there. The caller of a flow whose `@param` failed is a unit of its own and the failure of the callee is not a diagnostic in it (§18.1).

use consts.{K, LIMIT, wrong_default, not_in_scope}

pub const MAIN_ONLY: F32 = 2.0

pub flow taken_name(
  x: F32 at sample,
  @param(min: 0.0, max: 1.0, default: K)               //~ E0200
  p: F32 at block,
) -> F32 at sample {
  x * p
}

pub flow taken_name_in_a_hole(
  x: F32 at sample,
  @param(min: 0.0, max: 1.0, default: 0.5, label: "Gain {LIMIT}") //~ E0200
  p: F32 at block,
) -> F32 at sample {
  x * p
}

pub flow name_not_taken(
  x: F32 at sample,
  @param(min: 0.0, max: BIG, default: 0.5)             //~ E0302
  p: F32 at block,
) -> F32 at sample {
  x * p
}

pub flow name_not_taken_in_a_hole(
  x: F32 at sample,
  @param(min: 0.0, max: 1.0, default: 0.5, unit: "{BIG}") //~ E0302
  p: F32 at block,
) -> F32 at sample {
  x * p
}

pub flow own_name(
  x: F32 at sample,
  @param(min: 0.0, max: MAIN_ONLY, default: 1.0)       //~ E0200
  p: F32 at block,
) -> F32 at sample {
  x * p
}

// The callers of the flows that failed, here and in the other module: no diagnostic in them.
pub flow uses_the_failed(x: F32 at sample) -> F32 at sample {
  taken_name~(x, 0.5) + wrong_default~(x, 0.5) + not_in_scope~(x, 0.5)
}

pub flow chain(x: F32 at sample) -> F32 at sample {
  name_not_taken~(own_name~(x, 0.5), 0.25)
}

pub flow own_error(x: F32 at sample) -> F32 at sample {
  taken_name~(x, 0.5) + zz                            //~ E0302
}
