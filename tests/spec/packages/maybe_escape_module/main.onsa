// onsa.toml
// [test]
// mode = "test"
// spec = ["§4.5", "§5.3", "§15.1"]

// S-862 K (W5-17, §4.5, §15.1): the functions and the type with `?Escape` are in another module (`counting.onsa`), and the module that uses
// them passes a `Span` to the imported function: the type parameter is decided at the call, in this module, and the bound is read from the
// declaration of the other. The `T` of the imported function is a `Span[F32]` (a channel of a planar argument), a scalar and a `Buf[F32]`
// (`?Dup + ?Escape`), and the `Rack` of the module is used with a scalar `T` and called with a method that takes `x: T`. The same functions in
// one file are in types/maybe_escape_instances_run.onsa.

use counting.{n_of, touched, touched_any, Rack}

fn planar_n(xs: [Span[F32]; 2]) -> U32 {
  n_of(xs)
}

fn planar_touched(xs: [Span[F32]; 3]) -> U32 {
  touched(xs)
}

fn planar_touched_any(xs: [Span[F32]; 2]) -> U32 {
  touched_any(xs)
}

fn buffers_touched(xs: [Buf[F32]; 2]) -> U32 {
  touched_any(xs)
}

fn rack_tag(r: Rack[F32], x: F32) -> U32 {
  r.tag(x) + r.count()
}

test "the imported functions take a planar array of channels" {
  let a: [F32; 4] = [1.0, 2.0, 3.0, 4.0]
  let b: [F32; 2] = [0.5; 2]
  let c: [F32; 7] = [0.0; 7]
  assert planar_n([a, b]) == 2
  assert planar_touched([a, b, c]) == 3
  assert planar_touched_any([c, a]) == 2
}

test "the imported function with ?Dup + ?Escape takes Affine elements" {
  var bufs: [Buf[F32]; 2] = [Buf.zeroed(2), Buf.zeroed(5)]
  assert buffers_touched(bufs) == 2
}

test "the type of the other module with a ?Escape parameter" {
  let r: Rack[F32] = Rack { n: 4 }
  assert rack_tag(r, 1.0) == 5
}
