pub enum Mode {
  Off,
  Gain(F32),
}

pub struct P {
  n: F32,
}

impl P {
  pub rt fn new(v: F32) -> P {
    P { n: v }
  }

  pub rt fn get(self) -> F32 {
    self.n
  }
}

pub rt fn gain(v: F32) -> F32 {
  v
}

pub rt fn id[T](v: T) -> T {
  v
}

pub flow lp(x: F32 at sample) -> F32 at sample {
  x * 0.5 + prev~(x) * 0.5
}

pub flow item_of_the_module_with_a_bang(x: F32 at sample) -> F32 at sample {
  let a = gain(x)                                  //~ E0806
  a
}

pub flow flow_of_the_module_with_a_bang(x: F32 at sample) -> F32 at sample {
  let a = lp~(x)                                    //~ E0806
  a
}

pub flow item_of_the_module_with_a_dot(x: F32 at sample) -> F32 at sample {
  let a = gain(x)                                  //~ E0806
  a
}

pub flow variant_of_the_module_with_a_bang(x: F32 at sample) -> F32 at sample {
  let m = Mode.Gain(x)                             //~ E0806
  match m {
    Mode.Off => 0.0,
    Mode.Gain(k) => k,
  }
}

pub flow assign_in_the_module(x: F32 at sample) -> F32 at sample {
  let y = x * 2.0                                       //~ E0806
  y
}
