// A struct and an enum of one name are E0304 on the later one: as a bound the name is a bound that
// is not known.
pub struct Tr {
  a: I32,
}

pub enum Tr {                                       //~ E0304
  A,
}

// The operators and the methods that need a bound of `T` have no diagnostic.
pub fn cmp[T: Tr](x: T) -> Bool {
  x < x
}

pub fn eq[T: Tr](x: T) -> Bool {
  x == x
}

pub fn add[T: Tr](x: T) -> T {
  x + x
}

pub fn method[T: Tr](x: T) -> I32 {
  x.foo()
}

pub fn with_copy[T: Copy + Tr](x: T) -> Bool {
  x < x
}

pub fn copy_first[T: Tr + Copy](x: T) -> I32 {
  x.foo()
}

// The unit goes on: the real error after them is reported.
pub fn real_error[T: Tr](x: T) -> I32 {
  let b = x < x
  let m = x.foo()
  let a: I32 = true                                 //~ E0401
  a
}

pub fn closure_over[T: Tr](x: T) -> I32 {
  let g = fn(y: T) -> Bool { y < y }
  let a: I32 = true                                 //~ E0401
  a
}

// Only the type parameter with the bound that is not known is silent.
pub fn other_param[T: Tr, U](x: T, y: U) -> Bool {
  let b = x < x
  y < y                                             //~ E0401
}

pub struct W[T: Tr] {
  a: T,
}

pub enum V[T: Tr] {
  A(T),
}

// The members of an `impl` whose bound is not known are checked; the operator and the method on the
// type parameter are not judged, a real error is reported.
impl[T: Tr] W[T] {
  pub fn lt(self) -> Bool {
    self.a < self.a
  }

  pub fn foo(self) -> I32 {
    self.a.foo()
  }

  pub fn bad(self) -> I32 {
    let b = self.a < self.a
    let a: I32 = true                                   //~ E0401
    a
  }
}
