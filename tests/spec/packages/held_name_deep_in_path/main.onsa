// onsa.toml
// [test]
// spec = ["§18.1", "§15.1"]

// §18.1: a name whose declaration failed (`dup` is declared twice in `util.sub`, E0304) is an error
// with no diagnostic where it is used. Here it is the third name of a path, after two modules
// (`util.sub.dup`): the only diagnostic is the E0304 of `util/sub.onsa`, whatever the place of the
// path in the body (a value, a call, a field, an argument, `?`, `as`).
use util

fn g(x: I32) -> I32 {
  x
}

pub fn a_value() -> I32 {
  util.sub.dup
}

pub fn a_call() -> I32 {
  util.sub.dup()
}

pub fn a_field() -> I32 {
  let r = util.sub.dup.x
  0
}

pub fn an_argument() -> I32 {
  g(util.sub.dup)
}

pub flow in_a_flow(x: F32 at sample) -> F32 at sample {
  let r = util.sub.dup
  x
}

const IN_A_CONST: I32 = util.sub.dup()

test "after the question mark" {
  let r = util.sub.dup.x?
  assert true
}

test "before as" {
  let r = util.sub.dup as I32
  assert true
}
