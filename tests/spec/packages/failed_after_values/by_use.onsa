// A failed `use`: `gone` is a function and `Gone` a type that no `use` took.
use std.math.{Gone, gone, LEN}                      //~ E0302

pub fn value_call() -> I32 {
  let o = gone(1)
  let b = o + 1
  let c = o.f
  let r: Bool = o
  let a: I32 = true
  a
}

pub fn value_assoc() -> I32 {
  let o = Gone.make()
  let b = o + 1
  let c = o.f
  let r: Bool = o
  let a: I32 = true
  a
}

pub fn value_path() -> I32 {
  let o = Gone.A
  let b = o + 1
  let c = o.f
  let r: Bool = o
  let a: I32 = true
  a
}

pub fn value_path_call() -> I32 {
  let o = Gone.A(1)
  let b = o + 1
  let c = o.f
  let r: Bool = o
  let a: I32 = true
  a
}

pub fn value_literal() -> I32 {
  let o = Gone { a: 1 }
  let b = o + 1
  let c = o.f
  let r: Bool = o
  let a: I32 = true
  a
}

pub fn branch() -> I32 {
  let flag = true
  let o = if flag { gone(1) } else { 2 }
  let b = o + 1
  let a: I32 = true
  a
}

pub fn closure() -> I32 {
  let f = fn(x: I32) -> I32 { gone(1) }
  let o = f.(1)
  let a: I32 = true
  a
}

pub fn pattern_of_value(x: Gone) -> I32 {
  let r = match x {
    Gone.A(v) => v,
    Gone.B => 0,
  }
  let a: I32 = true
  a
}

pub fn pattern_of_call() -> I32 {
  let o = gone(1)
  let r = match o {
    Gone.A(v) => v,
    Gone.B => 0,
  }
  let a: I32 = true
  a
}

pub fn pattern_of_int(x: I32) -> I32 {
  let r = match x {
    Gone.A(v) => v,
    Gone.B => 0,
  }
  let a: I32 = true
  a
}

pub flow flow_tilde(x: F32 at sample) -> F32 at sample {
  let y = gone~(x)
  let a: I32 = true
  y
}

pub flow flow_plain(x: F32 at sample) -> F32 at sample {
  let y = gone(x)
  let a: I32 = true
  y
}

pub flow flow_par(x: F32 at sample) -> F32 at sample {
  let ys = par i in 0 ..< 4 {
    gone~(x)
  }
  let a: I32 = true
  ys[0]
}

pub flow flow_delay(x: F32 at sample) -> F32 at sample {
  let y = delay~(x, LEN)
  let a: I32 = true
  y
}

pub flow flow_par_range(x: F32 at sample) -> F32 at sample {
  let ys = par i in 0 ..< LEN {
    x
  }
  let a: I32 = true
  ys[0]
}

// A real error before the failed name is the first error of its unit: it is reported.
pub fn error_before() -> I32 {
  let a: I32 = true                                 //~ E0401
  let o = gone(1)
  a
}
