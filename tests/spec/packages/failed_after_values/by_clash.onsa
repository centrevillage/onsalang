// Two functions `gone` and a struct and an enum `D` are E0304 on the later declaration; the names are
// errors where they are used.
pub fn gone(x: I32) -> I32 {
  x
}

pub fn gone(x: I32) -> F32 {                        //~ E0304
  2.0
}

pub struct D {
  a: I32,
}

pub enum D {                                        //~ E0304
  A(I32),
  B,
}

pub const N: U32 = 4
pub const N: U32 = 8                                //~ E0304

pub fn value_call() -> I32 {
  let o = gone(1)
  let b = o + 1
  let c = o.f
  let r: Bool = o
  let a: I32 = true
  a
}

pub fn value_assoc() -> I32 {
  let o = D.make()
  let b = o + 1
  let c = o.f
  let r: Bool = o
  let a: I32 = true
  a
}

pub fn value_path() -> I32 {
  let o = D.A
  let b = o + 1
  let c = o.f
  let r: Bool = o
  let a: I32 = true
  a
}

pub fn value_path_call() -> I32 {
  let o = D.A(1)
  let b = o + 1
  let c = o.f
  let r: Bool = o
  let a: I32 = true
  a
}

pub fn value_literal() -> I32 {
  let o = D { a: 1 }
  let b = o + 1
  let c = o.f
  let r: Bool = o
  let a: I32 = true
  a
}

pub fn branch() -> I32 {
  let flag = true
  let o = if flag { gone(1) } else { 2 }
  let b = o + 1
  let a: I32 = true
  a
}

pub fn closure() -> I32 {
  let f = fn(x: I32) -> I32 { gone(1) }
  let o = f.(1)
  let a: I32 = true
  a
}

pub fn pattern_of_value(x: D) -> I32 {
  let r = match x {
    D.A(v) => v,
    D.B => 0,
  }
  let a: I32 = true
  a
}

pub fn pattern_of_call() -> I32 {
  let o = gone(1)
  let r = match o {
    D.A(v) => v,
    D.B => 0,
  }
  let a: I32 = true
  a
}

pub fn pattern_of_int(x: I32) -> I32 {
  let r = match x {
    D.A(v) => v,
    D.B => 0,
  }
  let a: I32 = true
  a
}

pub flow flow_tilde(x: F32 at sample) -> F32 at sample {
  let y = gone~(x)
  let a: I32 = true
  y
}

pub flow flow_plain(x: F32 at sample) -> F32 at sample {
  let y = gone(x)
  let a: I32 = true
  y
}

pub flow flow_par(x: F32 at sample) -> F32 at sample {
  let ys = par i in 0 ..< 4 {
    gone~(x)
  }
  let a: I32 = true
  ys[0]
}

pub flow flow_delay(x: F32 at sample) -> F32 at sample {
  let y = delay~(x, N)
  let a: I32 = true
  y
}

pub flow flow_par_range(x: F32 at sample) -> F32 at sample {
  let ys = par i in 0 ..< N {
    x
  }
  let a: I32 = true
  ys[0]
}

// A real error before the failed name is the first error of its unit: it is reported.
pub fn error_before() -> I32 {
  let a: I32 = true                                 //~ E0401
  let o = gone(1)
  a
}
