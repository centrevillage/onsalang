// An enum cut in the middle of a member: `E.Zed` is a name that was not read.
pub enum E {
  A,
  B(                                                //~ E0002


pub fn value_path() -> I32 {
  let o = E.Zed
  let b = o + 1
  let c = o.f
  let r: Bool = o
  let a: I32 = true
  a
}

pub fn value_path_call() -> I32 {
  let o = E.Zed(1)
  let b = o + 1
  let c = o.f
  let r: Bool = o
  let a: I32 = true
  a
}

pub fn pattern_of_value(x: E.Zed) -> I32 {
  let r = match x {
    E.Zed(v) => v,
    E.Other => 0,
  }
  let a: I32 = true
  a
}

pub fn pattern_of_call() -> I32 {
  let o = E.Zed
  let r = match o {
    E.Zed(v) => v,
    E.Other => 0,
  }
  let a: I32 = true
  a
}

pub fn pattern_of_int(x: I32) -> I32 {
  let r = match x {
    E.Zed(v) => v,
    E.Other => 0,
  }
  let a: I32 = true
  a
}

// A real error before the failed name is the first error of its unit: it is reported.
pub fn error_before() -> I32 {
  let a: I32 = true                                 //~ E0401
  let o = E.Zed
  a
}
