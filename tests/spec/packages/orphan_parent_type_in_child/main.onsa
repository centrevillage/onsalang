// onsa.toml
// [test]
// spec = ["§6.3", "§15.1", "§18.1"]
// fixes = 0

// S-70 (W5-04 U1; §6.3: "固有の `impl Ty` は `Ty` を定義したモジュールにしか書けず"): a module and its child module are two
// modules (§15.1: "1 ファイル = 1 モジュール"), so the type of the parent (`shapes.onsa`) has an `impl` in the child
// (`shapes/inner.onsa`) that is E0307, in the child (the marker is in `shapes/inner.onsa`). The `impl` of the type in its
// own module is right (`shapes.onsa` and `shapes/inner.onsa` each have one). The other direction (the type of the child
// in the parent) is in packages/orphan_child_type_in_parent (the two cannot be in one package: a module that takes
// the other in a cycle is E0310, §15.1). One error per unit (P-01).
pub fn run() -> I32 {
  1
}
