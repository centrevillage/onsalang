// A module below another one is another module: it takes what the package shows, from the parent and from util.
use dsp.{parent_item}
use util.{double, Pair, Mode}

fn osc_step(x: I32) -> I32 {
  parent_item(double(x))
}

fn osc_mode(m: Mode) -> I32 {
  match m {
    Mode.Fast => 1,
    Mode.Slow(n) => n,
  }
}

fn osc_pair(p: Pair) -> I32 {
  p.a - p.b
}
