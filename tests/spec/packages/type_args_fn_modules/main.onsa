// onsa.toml
// [test]
// mode = "test"
// spec = ["§4.5", "§15.1"]

// S-239 (W5-10 U2a): the generic functions are declared in another module (`util.onsa`) and in `std.math`, and the type arguments are written after the
// name of the function as it is written here: the name taken by a `use` (`id::[U8]`), the path through the module name (`util.id::[U8]`, §4.5: "名前の
// 経路の直後"), and a function of the standard library (`math.max::[I32]`). The type parameters are decided by that statement in all of them, and the
// requirements are the ones of the declaration. The associated function of a type of the module takes the list of the type and the list of
// the function. The values are worked out by hand.
use std.math
use util
use util.{id, zero, Wrap}

test "a function taken by a use" {
  let k = id::[U8](200)
  assert k.checked_add(100) == None
}

test "a function through the module name" {
  let k = util.id::[U8](200)
  assert k.checked_add(100) == None
  let a = util.first::[U8, F32](200, 2.5)
  assert a.checked_add(100) == None
}

test "a type parameter that only the result has" {
  let z = zero::[U8]()
  assert z.checked_sub(1) == None
  let y = util.zero::[I32]()
  assert y.checked_sub(1) == Some(-1)
}

test "a const parameter" {
  assert util.count::[4]() == 4
}

test "an associated function of a type of the module" {
  let r = Wrap::[F32].mk2::[U8](1.5, 200)
  let u = r.1
  assert u.checked_add(100) == None
  let s = util.Wrap::[U8].mk2::[I32](200, 200)
  let w = s.0
  let t = s.1
  assert w.v.checked_add(100) == None
  assert t.checked_add(100) == Some(300)
}

test "a function of std" {
  assert math.max::[I32](3, 9) == 9
  assert math.min::[F32](1.0, 2.0) == 1.0
  assert math.abs::[I32](-5) == 5
  assert math.sqrt::[F32](4.0) == 2.0
}

test "a function of std with a type parameter and a const parameter" {
  assert math.sum::[I32, 3]([1, 2, 3]) == 6
}
