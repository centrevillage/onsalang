// onsa.toml
// [test]
// spec = ["§11.6", "§15.1", "§18.1"]
// fixes = 0

// S-694, §11.6: whether the namespace of a flow has `process_inplace` is decided by the types of the flow,
// after the names stage. `one` has no sample input, so the `use` of its `process_inplace` is E0302 after the
// signatures, and the places that use the name in a body are silent (§18.1). In the place of a type,
// `process_inplace` is the name of a function whatever the flow has, so it is the error of a name that is no
// type, the same E0302 as `reset` (a function of every namespace) in the same place. `nosuch`, a name of a
// plain failed `use`, is silent in all of them: it is the control of the failed name.
use dsp.synth.one.{process_inplace}                 //~ E0302
use dsp.synth.one.{reset}
use dsp.synth.{nosuch}                              //~ E0302

pub fn in_a_signature(x: process_inplace) -> I32 {  //~ E0302
  1
}

pub fn in_a_signature_reset(x: reset) -> I32 {      //~ E0302
  1
}

pub fn in_a_signature_control(x: nosuch) -> I32 {
  1
}

pub fn in_a_result() -> process_inplace {           //~ E0302
  1
}

pub fn in_a_result_reset() -> reset {               //~ E0302
  1
}

pub fn in_a_result_control() -> nosuch {
  1
}

pub struct InAField {
  a: process_inplace,                               //~ E0302
}

pub struct InAFieldReset {
  a: reset,                                         //~ E0302
}

pub struct InAFieldControl {
  a: nosuch,
}

type InAnAlias = process_inplace                    //~ E0302

type InAnAliasReset = reset                         //~ E0302

type InAnAliasControl = nosuch

const IN_A_LENGTH: [I32; process_inplace] = [1]     //~ E0302

const IN_A_LENGTH_RESET: [I32; reset] = [1]         //~ E0302

const IN_A_LENGTH_CONTROL: [I32; nosuch] = [1]

pub fn in_a_body() -> I32 {
  process_inplace(1) + nosuch(1)
}
