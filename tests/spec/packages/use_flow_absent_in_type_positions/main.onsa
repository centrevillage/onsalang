// onsa.toml
// [test]
// spec = ["§11.6", "§15.1", "§18.1"]
// fixes = 0

// S-694, §11.6: whether the namespace of a flow has `process_inplace` is decided by the types of the flow,
// after the names stage. `one` has no sample input, so the `use` of its `process_inplace` is E0302 after the
// signatures, and the places that use the name in a body are silent (§18.1). `nosuch`, a name of a plain
// failed `use`, is silent in the places of a type and of a length: it is the control of the failed name.
// (The code of `process_inplace` written in the place of a type is in `use_flow_absent_type_position_kinds`; the
// code of a function name in the place of an array length is not fixed by the spec.)
use dsp.synth.one.{process_inplace}                 //~ E0302
use dsp.synth.one.{reset}
use dsp.synth.{nosuch}                              //~ E0302

pub fn in_a_signature_control(x: nosuch) -> I32 {
  1
}

pub fn in_a_result_control() -> nosuch {
  1
}

pub struct InAFieldControl {
  a: nosuch,
}

type InAnAliasControl = nosuch

const IN_A_LENGTH_CONTROL: [I32; nosuch] = [1]

pub fn in_a_body() -> I32 {
  process_inplace(1) + nosuch(1)
}
