// onsa.toml
// [test]
// spec = ["§11.7", "§15.1", "§18.1"]

// The flows of util.onsa whose `@param` is wrong (W7-13 U4a/t, S-87; each is one E0809 in util.onsa). The names are taken with `use`
// and called here with the arguments of their signatures, in a flow, in a flow that is called by another, and as the argument of
// a function: the caller is a unit of its own and the failure of the callee is not a diagnostic in it (§18.1). What was read is
// checked here: an error of this module is its own.

use util.{Pair, wrong_type, key_twice, no_default, right}

pub flow uses_the_wrong_type(x: F32 at sample) -> F32 at sample {
  wrong_type~(x, Pair { a: 1.0, b: 2.0 })
}

pub flow uses_the_key_twice(x: F32 at sample) -> F32 at sample {
  key_twice~(x, 0.5)
}

pub flow uses_the_one_with_no_default(x: F32 at sample) -> F32 at sample {
  no_default~(x, 0.5)
}

pub flow chain(x: F32 at sample) -> F32 at sample {
  right~(key_twice~(no_default~(x, 0.5), 0.25), 0.75)
}

pub flow own_error(x: F32 at sample) -> F32 at sample {
  right~(x, 0.5) + zz                               //~ E0302
}
