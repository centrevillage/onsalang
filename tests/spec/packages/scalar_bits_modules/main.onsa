// onsa.toml
// [test]
// mode = "test"
// spec = ["§6.6", "§15.1"]

// W5-02 U4a (R-136): a module reads `BITS` through the constants, the functions and the `impl` member of
// another module (spec §6.6, §15.1). The width of a U64 is 64 and of a U8 is 8, so 3 bytes are 24 bits and
// 3 registers of the width of a U16 are 48 bits. Today `BITS` is 32 for every type (R-136).

use widths.{BYTE, Register, WORD, width_of_bytes}

const LOCAL_WORDS: U32 = WORD * 2

const LOCAL_SUM: U32 = WORD + BYTE

test "a constant of another module reads BITS" {
  assert WORD == 64
  assert BYTE == 8
  assert LOCAL_WORDS == 128
  assert LOCAL_SUM == 72
}

test "a function of another module reads BITS in its body" {
  assert width_of_bytes(3) == 24
  assert width_of_bytes(0) == 0
}

test "an impl member of another module reads BITS" {
  let r = Register { count: 3 }
  assert Register.WIDE == 16
  assert r.bits() == 48
}
