// onsa.toml
// [test]
// spec = ["§15.1"]

// E0310: `a` and `b` take items of each other (§15.1). One E0310 per cycle, on the first `use` of the
// cycle in the order of the diagnostics, the other `use` (`use a.{f}` of `b`) in a note (§18.1, S-734).
use b.{g}                        //~ E0310

pub fn f() -> I32 { g() }
