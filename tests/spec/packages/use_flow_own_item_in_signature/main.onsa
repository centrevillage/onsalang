// onsa.toml
// [test]
// spec = ["§11.6", "§15.1", "§18.1"]
// fixes = 0

// S-694, §11.6: a flow whose signature has an error does not decide whether its namespace has
// `process_inplace`, so a `use` of that name from the flow (here the flow takes the item of its own namespace) is
// silent (§18.1). The error of the signature here is a type name that is not there (`Nope`, E0302), at the place
// of the type, in each of the modules (`main.onsa`: the type of a sample input; `in_output.onsa`: the type of
// the output; `in_block.onsa`: the type of a block input; `via_alias.onsa`: the type through a type alias, whose
// error is the one of the alias). `process_inplace` itself written in those places is a function in the place
// of a type, in `use_flow_own_item_signature_kind`.
use main.f.{process_inplace}
pub flow f(x: Nope at sample) -> F32 at sample {  //~ E0302
  1.0
}
