pub rt fn dbl(x: F32) -> F32 {
  x * 2.0
}

pub const F: rt fn(F32) -> F32 = dbl

pub struct Pt {
  cb: rt fn(F32) -> F32,
  k: F32,
}

pub struct Sealed {
  priv cb: rt fn(F32) -> F32,
  k: F32,
}

pub rt fn sealed() -> Sealed {
  Sealed { cb: dbl, k: 1.0 }
}

pub rt fn pick(c: Bool) -> rt fn(F32) -> F32 {
  dbl
}

pub rt fn mk() -> Pt {
  Pt { cb: dbl, k: 1.0 }
}

pub rt fn apply(f: rt fn(F32) -> F32, x: F32) -> F32 {
  f.(x)
}

pub rt fn through(x: F32) -> F32 {
  apply(dbl, x)
}

pub flow in_the_module_of_the_constant(x: F32 at sample) -> F32 at sample {
  apply(F, x)                                       //~ E0810
}

pub flow in_the_module_of_the_call(x: F32 at sample, c: Bool at init) -> F32 at sample {
  apply(pick(c), x)                                 //~ E0810 @9
}

pub flow in_the_module_a_call_that_is_fine(x: F32 at sample) -> F32 at sample {
  through(x)
}
