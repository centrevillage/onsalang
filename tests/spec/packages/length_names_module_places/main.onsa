// onsa.toml
// [test]
// spec = ["§4.5", "§15.1", "§18.1", "§11.4", "§11.5"]

// W5-16 U1a/t: the name of a module written in a constant expression is E0308 (a module is a namespace and no value, §4.5:
// "値でない名前（型、モジュール、flow、trait、効果など）は E0308"; §15.1), a function of a module is E0417 (a value that is no
// constant), a name that the module does not have is E0302, and a constant of a module is fine: the same code in every place
// where a constant expression is written. packages/kind_signature_places_modules has the heading of an item; this package
// has the repeat and the annotation of a body, the places of a flow body (the length of `delay~` and `vdelay~`, the ends of a
// `par~`, the repeat) and the input of a flow, and the qualified constants (`util.K`, `util.Cfg.SIZE`) that are fine in all of them.
// One error per unit (§18.1), so each form is in its own unit.
use util

pub fn module_in_a_repeat() -> F32 {
  let a = [0.0; util]                               //~ E0308
  a[0]
}

pub fn module_in_an_annotation() -> F32 {
  let _: [F32; util] = [0.0; 4]                     //~ E0308
  1.0
}

pub fn type_of_a_module_in_a_repeat() -> F32 {
  let a = [0.0; util.Q]                             //~ E0308
  a[0]
}

pub fn function_of_a_module_in_a_repeat() -> F32 {
  let a = [0.0; util.g]                             //~ E0417
  a[0]
}

pub fn missing_name_in_a_repeat() -> F32 {
  let a = [0.0; util.Nope]                          //~ E0302
  a[0]
}

pub fn constant_called_in_a_repeat() -> F32 {
  let a = [0.0; util.K()]                           //~ E0020
  a[0]
}

pub flow module_in_a_flow_input(a: [F32; util] at sample) -> F32 at sample {   //~ E0308
  0.0
}

pub flow module_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, util)                                   //~ E0308
}

pub flow module_in_a_vdelay(x: F32 at sample, d: F32 at sample) -> F32 at sample {
  vdelay~(x, d, util)                               //~ E0308
}

pub flow module_as_the_end_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<util { x * F32.round_from(i) }     //~ E0308
  ys[0]
}

pub flow module_in_a_flow_repeat(x: F32 at sample) -> F32 at sample {
  let a = [x; util]                                 //~ E0308
  a[0]
}

pub flow type_of_a_module_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, util.Q)                                 //~ E0308
}

pub flow function_of_a_module_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, util.g)                                 //~ E0417
}

pub flow function_of_a_module_as_the_end_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<util.g { x * F32.round_from(i) }   //~ E0417
  ys[0]
}

pub flow missing_name_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, util.Nope)                              //~ E0302
}

pub flow missing_name_as_the_end_of_a_par(x: F32 at sample) -> F32 at sample {
  let ys = par~ i in 0..<util.Nope { x * F32.round_from(i) }    //~ E0302
  ys[0]
}

pub flow constant_called_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, util.K())                               //~ E0020
}

pub flow member_of_a_constant_in_a_delay(x: F32 at sample) -> F32 at sample {
  delay~(x, util.K.x)                               //~ E0308
}

// ---- Fine: the constants of the module in every place ----

pub fn constants_in_a_heading_and_a_body(a: [F32; util.K], b: [F32; util.Cfg.SIZE]) -> F32 {
  let c: [F32; util.K] = [0.0; util.K]
  let d = [0.0; util.Cfg.SIZE]
  a[0] + b[0] + c[0] + d[0]
}

pub flow constants_in_the_places_of_a_flow(a: [F32; util.K] at sample, x: F32 at sample) -> F32 at sample {
  let p = delay~(x, util.K)
  let q = vdelay~(x, p, util.Cfg.SIZE)
  let ys = par~ i in 0..<util.K { x * F32.round_from(i) }
  let zs = [x; util.Cfg.SIZE]
  p + q + ys[0] + zs[0]
}
