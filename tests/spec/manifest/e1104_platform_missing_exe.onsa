// E1104 beside E0200: an `exe` target needs `platform`. The build of `t` reports the missing `platform` at the
// heading and the unsupported `kind` at its value, each at its own line; neither hides the other (§15.3, §18.1
// "互いに独立に全て報告し"; R-47, S-824, S-827).

pub fn f() -> I32 { 1 }
