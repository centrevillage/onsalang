// E0200: the values of one target are independent: `kind`, `main_frame` and the two elements of `provides` are four
// reports, and the first does not hide the others (§18.1 "互いに独立に全て報告し"; S-827; §15.3, §18.1; S-154, S-827)

pub fn f() -> I32 { 1 }
