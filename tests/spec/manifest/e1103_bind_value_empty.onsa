// E1103: the value is empty, which is not a module path. A value is the path of the implementation module: module names joined with `.` (§2.3),
// so a value that is not one is reported at the value, in every command (§15.2, §15.3 `bind` row, §18.1;
// S-827).

pub fn f() -> I32 { 1 }
