// E1104 in the `onsa.toml` of a package with a module and no `[export]` table: the only `@export` items are in
// `util` (a generic function, a branch and a `par` flow are around them), the root module has none, and the
// manifest has no `[export]`, so the report is at the top of the manifest (line 1). The candidate inserts a
// `[export]` table with `prefix = "e1104_prefix_missing_no_table_"`, and the build is clean after it
// (§14.2 "`@export` の項目を出すターゲットのビルドで必須", §15.3, §18.1 "必須のキーが無い…表ごと無ければ本文の先頭";
// S-639, S-832, S-597).

use util.{twice, pick}

pub fn doubled(x: I32) -> I32 { twice(pick(x, 3)) }
