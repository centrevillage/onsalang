// No diagnostic: the package has no `@export` item (a `pub` fn and a `pub` flow are not exported without the
// attribute), so `prefix` is not needed and the build of `t` has nothing to report (§14.2 "`@export` の項目が
// 無いパッケージでは要らず"; S-639, S-832).

pub fn f() -> I32 { 1 }

pub flow gain(x: F32 at sample) -> F32 at sample { x * 0.5 }
