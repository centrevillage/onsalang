// E1103: `category` is `instrument`, `effect` or `note-effect`; `note_effect` is not spelt with a hyphen, so it is reported at the value
// (§15.3 `category` row, §14.3, §18.1; S-580, S-597).

@export
pub flow voice(x: F32 at sample) -> F32 at sample { x }
