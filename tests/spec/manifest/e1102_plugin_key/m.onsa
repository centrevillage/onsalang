// onsa.toml
// [test]
// spec = ["§15.3"]
// fixes = 0

// E1102: a key that `[[plugin]]` does not list is reported at its line, inside an array of tables
// (§15.3, §18.1; S-99). The keys `flow`, `id`, `name`, `vendor`, `version` and `category` are the table's
// own; their values are checked in W4-02 U4. `flow` names an `@export` flow of this package, so no value is
// an error (§15.3).

@export
pub flow voice(x: F32 at sample) -> F32 at sample {
  x
}
