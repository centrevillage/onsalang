// onsa.toml
// [test]
// spec = ["§2.3", "§15.3", "§18.1"]
// fixes = 0

// E0320: the named flow `Match` would be `match` in `snake_case`, a reserved word, for which the spelling with a
// `_` at the end (`match_`) is the candidate of an ordinary flow. For a name the manifest names, there is no candidate
// (`fixes = 0`) (§2.3 "下の予約語の候補も出さない", §15.3 `flow` row; S-718).

@export
pub flow Match(x: F32 at sample) -> F32 at sample { x } //~ E0320
