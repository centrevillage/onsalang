// onsa.toml
// [package]
// name = "e1102_inline_table"
// edition = "2026"
//
// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// fp = "strict"
// provides = []
// panic = "trap"
// panic_messages = true
// main_frame = "stack"
// memory = { bulk = false, size = 1 }          #~ E1102
//
// [test]
// spec = ["§15.3"]
// fixes = 0

// E1102: a table written inline is read like a table with a heading: the unknown key `size` in the
// inline table `memory` is reported at its line (§15.3, §18.1; S-99). `bulk` next to it is known.
