// onsa.toml
// [package]
// name = "e0200_target_test_not_stopped"
// edition = "2026"
//
// [targets.t]
// kind = "source"
// lang = "c"
// platform = "host"
// main_frame = "static"                          #~ E0200 [t]
//
// [test]
// spec = ["§15.3"]
// mode = "test"
// fixes = 0

// `test` is not stopped by the E0200 of a target value: the test runs and passes (§15.3; S-154; §15.3, §18.1; S-154,
// S-827)

pub fn f() -> I32 { 1 }

test "f is one" {
  assert f() == 1
}
