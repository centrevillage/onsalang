// onsa.toml
// [package]
// name = "c_trunc"
// edition = "2026"
//
// [export]
// prefix = "ctr_"
// fns = [
//   "c_trunc.trunc_i64_f64",
//   "c_trunc.trunc_sat_i64_f64",
//   "c_trunc.trunc_u64_f64",
//   "c_trunc.trunc_sat_u64_f64",
//   "c_trunc.trunc_sat_u64_f32",
//   "c_trunc.trunc_u8_f64",
//   "c_trunc.trunc_sat_u32_f32",
//   "c_trunc.trunc_neg09_u32_f64",
//   "c_trunc.trunc_neg09_u64_f64",
//   "c_trunc.trunc_neg09_u64_f32",
//   "c_trunc.trunc_sum_loop_i64",
//   "c_trunc.trunc_sat_sum_loop_u64",
//   "c_trunc.parts_u_f64",
//   "c_trunc.trunc_in_some_arm",
//   "c_trunc.trunc_in_none_arm",
//   "c_trunc.trunc_in_closure_i64",
// ]
//
// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "poison"
// provides = []
//
// [targets.fw]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "reset"
// provides = []
//
// [targets.dbg]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [test]
// mode = "test"
// spec = ["§3.3", "§3.4", "§9.2", "§14.2", "§13.4"]
//
// [[test.host]]
// name = "trunc_i64_f64"
// target = "host"
// fn = "c_trunc.trunc_i64_f64"
// steps = [
//   { call = "fn", args = { n = 0.0, d = 0.0 }, status = 1 },
//   { call = "fn", args = { n = -0.0, d = 1.0 }, status = 0, result = 0 },
//   { call = "fn", args = { n = -0.5, d = 1.0 }, status = 0, result = 0 },
//   { call = "fn", args = { n = 9223372036854774784.0, d = 1.0 }, status = 0, result = 9223372036854774784 },
//   { call = "fn", args = { n = 9223372036854775808.0, d = 1.0 }, status = 1 },
// ]
//
// [[test.host]]
// name = "trunc_sat_i64_f64"
// target = "host"
// fn = "c_trunc.trunc_sat_i64_f64"
// steps = [
//   { call = "fn", args = { n = 0.0, d = 0.0 }, status = 0, result = 0 },
//   { call = "fn", args = { n = 1.0, d = 0.0 }, status = 0, result = 9223372036854775807 },
//   { call = "fn", args = { n = -1.0, d = 0.0 }, status = 0, result = -9223372036854775808 },
//   { call = "fn", args = { n = -0.0, d = 1.0 }, status = 0, result = 0 },
//   { call = "fn", args = { n = -0.5, d = 1.0 }, status = 0, result = 0 },
//   { call = "fn", args = { n = 9223372036854774784.0, d = 1.0 }, status = 0, result = 9223372036854774784 },
//   { call = "fn", args = { n = 9223372036854775808.0, d = 1.0 }, status = 0, result = 9223372036854775807 },
