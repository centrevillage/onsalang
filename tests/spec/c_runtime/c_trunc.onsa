test "trunc_sum_loop_i64: the values" {
  assert trunc_sum_loop_i64(0) == 0
  assert trunc_sum_loop_i64(3) == 6917529027641081856
}

test "trunc_sum_loop_i64(4) panics" {   //~ TESTFAIL "trunc_sum_loop_i64(4) panics"
  let _ = trunc_sum_loop_i64(4)
}

test "trunc_sat_sum_loop_u64: the values" {
  assert trunc_sat_sum_loop_u64(0, 0) == 0
  assert trunc_sat_sum_loop_u64(0, 1) == 0
  assert trunc_sat_sum_loop_u64(2, 0) == 4294967295
  assert trunc_sat_sum_loop_u64(2, 1) == 4294967295
  assert trunc_sat_sum_loop_u64(3, 0) == 4294967295
  assert trunc_sat_sum_loop_u64(3, 1) == 4294967295
}

test "parts_u_f64: the values" {
  assert parts_u_f64(-0.5) == 0
  assert parts_u_f64(4294967295.0) == 4294967295
}

test "parts_u_f64(4294967296.0) panics" {   //~ TESTFAIL "parts_u_f64(4294967296.0) panics"
  let _ = parts_u_f64(4294967296.0)
}

test "trunc_in_some_arm: the values" {
  assert trunc_in_some_arm(9223372036854774784.0, 0.0) == 9223372036854774784
  assert trunc_in_some_arm(-9223372036854775808.0, 7.0) == I64.MIN
}

test "trunc_in_some_arm(9223372036854775808.0, 7.0) panics" {   //~ TESTFAIL "trunc_in_some_arm(9223372036854775808.0, 7.0) panics"
  let _ = trunc_in_some_arm(9223372036854775808.0, 7.0)
}

test "trunc_in_none_arm: the values" {
  assert trunc_in_none_arm(9223372036854775808.0, 9223372036854775808.0) == 9223372036854775807
  assert trunc_in_none_arm(0.0, -9223372036854775808.0) == I64.MIN
  assert trunc_in_none_arm(9223372036854775808.0, -2.0) == -2
}

test "trunc_in_closure_i64: the values" {
  assert trunc_in_closure_i64(9223372036854774784.0) == -9223372036854774784
  assert trunc_in_closure_i64(0.5) == 0
}

test "trunc_in_closure_i64(9223372036854775808.0) panics" {   //~ TESTFAIL "trunc_in_closure_i64(9223372036854775808.0) panics"
  let _ = trunc_in_closure_i64(9223372036854775808.0)
}
