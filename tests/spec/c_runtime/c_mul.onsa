// [[test.host]]
// name = "wmul_i16"
// target = "host"
// fn = "c_mul.wmul_i16"
// steps = [
//   { call = "fn", args = { a = 32767, b = 32767 }, status = 0, result = 1 },
//   { call = "fn", args = { a = 32767, b = 2 }, status = 0, result = -2 },
//   { call = "fn", args = { a = 182, b = 182 }, status = 0, result = -32412 },
