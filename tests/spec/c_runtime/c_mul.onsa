//   { call = "fn", args = { op = 0, part = 1, ah = 4294967295, al = 4294967295, bh = 4294967295, bl = 4294967295 }, status = 1 },
//   { call = "fn", args = { op = 1, part = 0, ah = 4294967295, al = 4294967295, bh = 4294967295, bl = 4294967295 }, status = 0, result = 0 },
//   { call = "fn", args = { op = 1, part = 1, ah = 4294967295, al = 4294967295, bh = 4294967295, bl = 4294967295 }, status = 0, result = 1 },
//   { call = "fn", args = { op = 2, part = 0, ah = 4294967295, al = 4294967295, bh = 4294967295, bl = 4294967295 }, status = 0, result = 4294967295 },
//   { call = "fn", args = { op = 2, part = 1, ah = 4294967295, al = 4294967295, bh = 4294967295, bl = 4294967295 }, status = 0, result = 4294967295 },
//   { call = "fn", args = { op = 3, part = 0, ah = 4294967295, al = 4294967295, bh = 4294967295, bl = 4294967295 }, status = 0, result = 0 },
//   { call = "fn", args = { op = 3, part = 1, ah = 4294967295, al = 4294967295, bh = 4294967295, bl = 4294967295 }, status = 0, result = 0 },
//   { call = "fn", args = { op = 0, part = 0, ah = 0, al = 4294967295, bh = 1, bl = 1 }, status = 0, result = 4294967295 },
//   { call = "fn", args = { op = 0, part = 1, ah = 0, al = 4294967295, bh = 1, bl = 1 }, status = 0, result = 4294967295 },
//   { call = "fn", args = { op = 1, part = 0, ah = 0, al = 4294967295, bh = 1, bl = 1 }, status = 0, result = 4294967295 },
//   { call = "fn", args = { op = 1, part = 1, ah = 0, al = 4294967295, bh = 1, bl = 1 }, status = 0, result = 4294967295 },
//   { call = "fn", args = { op = 2, part = 0, ah = 0, al = 4294967295, bh = 1, bl = 1 }, status = 0, result = 4294967295 },
//   { call = "fn", args = { op = 2, part = 1, ah = 0, al = 4294967295, bh = 1, bl = 1 }, status = 0, result = 4294967295 },
//   { call = "fn", args = { op = 3, part = 0, ah = 0, al = 4294967295, bh = 1, bl = 1 }, status = 0, result = 0 },
//   { call = "fn", args = { op = 3, part = 1, ah = 0, al = 4294967295, bh = 1, bl = 1 }, status = 0, result = 1 },
//   { call = "fn", args = { op = 0, part = 0, ah = 2147483648, al = 0, bh = 0, bl = 2 }, status = 1 },
//   { call = "fn", args = { op = 0, part = 1, ah = 2147483648, al = 0, bh = 0, bl = 2 }, status = 1 },
//   { call = "fn", args = { op = 1, part = 0, ah = 2147483648, al = 0, bh = 0, bl = 2 }, status = 0, result = 0 },
//   { call = "fn", args = { op = 1, part = 1, ah = 2147483648, al = 0, bh = 0, bl = 2 }, status = 0, result = 0 },
//   { call = "fn", args = { op = 2, part = 0, ah = 2147483648, al = 0, bh = 0, bl = 2 }, status = 0, result = 4294967295 },
//   { call = "fn", args = { op = 2, part = 1, ah = 2147483648, al = 0, bh = 0, bl = 2 }, status = 0, result = 4294967295 },
//   { call = "fn", args = { op = 3, part = 0, ah = 2147483648, al = 0, bh = 0, bl = 2 }, status = 0, result = 0 },
//   { call = "fn", args = { op = 3, part = 1, ah = 2147483648, al = 0, bh = 0, bl = 2 }, status = 0, result = 0 },
// ]
//
