// onsa.toml
// [package]
// name = "c_mul"
// edition = "2026"
//
// [export]
// prefix = "cmu_"
// fns = [
//   "c_mul.mul_u32",
//   "c_mul.wmul_u32",
//   "c_mul.smul_u32",
//   "c_mul.checked_mul_u32",
//   "c_mul.mul_i16",
//   "c_mul.wmul_i16",
//   "c_mul.u64_op",
//   "c_mul.mul_then_div_u32",
//   "c_mul.wmul_then_wsub_i16",
//   "c_mul.wmul_loop_u32",
//   "c_mul.wmul_loop_u64",
//   "c_mul.mul_loop_u64",
//   "c_mul.pair_hi_u32",
//   "c_mul.mul_in_arm_u32",
//   "c_mul.mul_in_closure_u32",
//   "c_mul.wmul_in_closure_u64",
// ]
//
// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "poison"
// provides = []
//
// [targets.fw]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "reset"
// provides = []
//
// [targets.dbg]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [test]
// mode = "test"
// spec = ["§3.4", "§3.5", "§9.2", "§14.2"]
//
// [[test.host]]
// name = "mul_u32"
// target = "host"
// fn = "c_mul.mul_u32"
// steps = [
//   { call = "fn", args = { a = 4294967295, b = 4294967295 }, status = 1 },
//   { call = "fn", args = { a = 65535, b = 65537 }, status = 0, result = 4294967295 },
// ]
//
// [[test.host]]
// name = "mul_u32 on a reset target"
// target = "fw"
// fn = "c_mul.mul_u32"
// steps = [
//   { call = "fn", args = { a = 65535, b = 65537 }, status = 0, result = 4294967295 },
// ]
//
// [[test.host]]
// name = "wmul_u32"
// target = "host"
// fn = "c_mul.wmul_u32"
// steps = [
//   { call = "fn", args = { a = 4294967295, b = 4294967295 }, status = 0, result = 1 },
//   { call = "fn", args = { a = 4294967295, b = 2 }, status = 0, result = 4294967294 },
//   { call = "fn", args = { a = 65536, b = 65536 }, status = 0, result = 0 },
//   { call = "fn", args = { a = 65535, b = 65537 }, status = 0, result = 4294967295 },
// ]
//
// [[test.host]]
// name = "wmul_u32 on a reset target"
// target = "fw"
// fn = "c_mul.wmul_u32"
// steps = [
//   { call = "fn", args = { a = 4294967295, b = 4294967295 }, status = 0, result = 1 },
//   { call = "fn", args = { a = 4294967295, b = 2 }, status = 0, result = 4294967294 },
//   { call = "fn", args = { a = 65536, b = 65536 }, status = 0, result = 0 },
//   { call = "fn", args = { a = 65535, b = 65537 }, status = 0, result = 4294967295 },
// ]
//
// [[test.host]]
// name = "smul_u32"
// target = "host"
// fn = "c_mul.smul_u32"
// steps = [
//   { call = "fn", args = { a = 4294967295, b = 4294967295 }, status = 0, result = 4294967295 },
//   { call = "fn", args = { a = 4294967295, b = 2 }, status = 0, result = 4294967295 },
//   { call = "fn", args = { a = 65536, b = 65536 }, status = 0, result = 4294967295 },
//   { call = "fn", args = { a = 65535, b = 65537 }, status = 0, result = 4294967295 },
// ]
//
// [[test.host]]
// name = "checked_mul_u32"
// target = "host"
// fn = "c_mul.checked_mul_u32"
// steps = [
//   { call = "fn", args = { a = 4294967295, b = 4294967295 }, status = 0, result = -9223372036854775808 },
//   { call = "fn", args = { a = 4294967295, b = 2 }, status = 0, result = -9223372036854775808 },
//   { call = "fn", args = { a = 65536, b = 65536 }, status = 0, result = -9223372036854775808 },
//   { call = "fn", args = { a = 65535, b = 65537 }, status = 0, result = 4294967295 },
// ]
//
// [[test.host]]
// name = "mul_i16"
// target = "host"
// fn = "c_mul.mul_i16"
// steps = [
//   { call = "fn", args = { a = 32767, b = 32767 }, status = 1 },
