// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "poison"
// provides = []
//
// [targets.fw]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "reset"
// provides = []
//
// [targets.dbg]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [test]
// mode = "test"
// spec = ["§3.3", "§3.4", "§9.2", "§14.2"]
//
// [[test.host]]
// name = "narrow_i8_to_u8"
// target = "host"
// fn = "c_narrow_s2u.narrow_i8_to_u8"
// steps = [
//   { call = "fn", args = { x = -1 }, status = 0, result = -9223372036854775808 },
//   { call = "fn", args = { x = 0 }, status = 0, result = 0 },
//   { call = "fn", args = { x = 1 }, status = 0, result = 1 },
//   { call = "fn", args = { x = -128 }, status = 0, result = -9223372036854775808 },
//   { call = "fn", args = { x = 127 }, status = 0, result = 127 },
// ]
//
// [[test.host]]
// name = "narrow_i32_to_u32"
// target = "host"
// fn = "c_narrow_s2u.narrow_i32_to_u32"
// steps = [
//   { call = "fn", args = { x = -1 }, status = 0, result = -9223372036854775808 },
//   { call = "fn", args = { x = 0 }, status = 0, result = 0 },
//   { call = "fn", args = { x = 1 }, status = 0, result = 1 },
//   { call = "fn", args = { x = -2147483648 }, status = 0, result = -9223372036854775808 },
//   { call = "fn", args = { x = 2147483647 }, status = 0, result = 2147483647 },
// ]
//
// [[test.host]]
// name = "narrow_i32_to_u32 on a reset target"
// target = "fw"
// fn = "c_narrow_s2u.narrow_i32_to_u32"
// steps = [
//   { call = "fn", args = { x = -1 }, status = 0, result = -9223372036854775808 },
//   { call = "fn", args = { x = 0 }, status = 0, result = 0 },
//   { call = "fn", args = { x = 1 }, status = 0, result = 1 },
//   { call = "fn", args = { x = -2147483648 }, status = 0, result = -9223372036854775808 },
//   { call = "fn", args = { x = 2147483647 }, status = 0, result = 2147483647 },
// ]
//
// [[test.host]]
// name = "narrow_i64_to_u64"
// target = "host"
// fn = "c_narrow_s2u.narrow_i64_to_u64"
// steps = [
//   { call = "fn", args = { x = -1, part = 0 }, status = 0, result = 0 },
//   { call = "fn", args = { x = -1, part = 1 }, status = 0, result = 0 },
//   { call = "fn", args = { x = -1, part = 2 }, status = 0, result = 0 },
//   { call = "fn", args = { x = 0, part = 0 }, status = 0, result = 0 },
//   { call = "fn", args = { x = 0, part = 1 }, status = 0, result = 0 },
//   { call = "fn", args = { x = 0, part = 2 }, status = 0, result = 1 },
//   { call = "fn", args = { x = 1, part = 0 }, status = 0, result = 0 },
//   { call = "fn", args = { x = 1, part = 1 }, status = 0, result = 1 },
// ]
//
// [[test.host]]
// name = "narrow_i64_to_u64 on a reset target"
// target = "fw"
// fn = "c_narrow_s2u.narrow_i64_to_u64"
// steps = [
//   { call = "fn", args = { x = -1, part = 0 }, status = 0, result = 0 },
//   { call = "fn", args = { x = -1, part = 1 }, status = 0, result = 0 },
//   { call = "fn", args = { x = -1, part = 2 }, status = 0, result = 0 },
//   { call = "fn", args = { x = 0, part = 0 }, status = 0, result = 0 },
//   { call = "fn", args = { x = 0, part = 1 }, status = 0, result = 0 },
//   { call = "fn", args = { x = 0, part = 2 }, status = 0, result = 1 },
//   { call = "fn", args = { x = 1, part = 0 }, status = 0, result = 0 },
//   { call = "fn", args = { x = 1, part = 1 }, status = 0, result = 1 },
// ]
//
// [[test.host]]
// name = "count_fits_i32_u32"
// target = "host"
// fn = "c_narrow_s2u.count_fits_i32_u32"
// steps = [
//   { call = "fn", args = { base = -2, n = 4 }, status = 0, result = 2 },
//   { call = "fn", args = { base = -5, n = 3 }, status = 0, result = 0 },
//   { call = "fn", args = { base = 0, n = 3 }, status = 0, result = 3 },
//   { call = "fn", args = { base = 2147483646, n = 2 }, status = 1 },
// ]
//
// [[test.host]]
// name = "narrow_in_closure_i64_u8"
// target = "host"
// fn = "c_narrow_s2u.narrow_in_closure_i64_u8"
// steps = [
//   { call = "fn", args = { base = 253 }, status = 0, result = 255 },
//   { call = "fn", args = { base = 254 }, status = 0, result = -9223372036854775808 },
//   { call = "fn", args = { base = 255 }, status = 0, result = -9223372036854775808 },
//   { call = "fn", args = { base = -2 }, status = 0, result = 0 },
//   { call = "fn", args = { base = 9223372036854775806 }, status = 1 },
// ]

// `narrow_<type>()` from signed to unsigned integers, on a target that is built to C (spec §3.3): `Some(v)` when the
// value fits the destination type, `None` when it does not. The pairs that need the method are the ones `as`
// cannot write: a narrower destination, the same width with the other sign, and a signed source to a
// wider unsigned one.
// The signed-to-unsigned pairs: a value fits when it is not negative and at most the unsigned MAX of the
// destination; for a destination that is at least as wide as the source only the sign matters
// (`(-1i32).narrow_u32()` is `None`, `0i32.narrow_u32()` is `Some(0)`).
// The vectors call each pair once on literals; this file adds the exported boundary with host-chosen
// values, loops and an anonymous function. The same functions and expectations run on the interpreter
// (the test blocks) and on the C target (the host scripts).
//
// Each function returns the destination value widened to `I64` (`I64.MIN` for `None`, which no
// destination value equals); the functions to `U64` return the high word (`part` 0), the low word
// (`part` 1) or 1/0 for Some/None (`part` 2) as a `U32`, and the ones from `U64` take the source as
// two `U32` words (a TOML integer stops at 2^63 - 1). The inputs are the destination's edges and the
// source's edges: dlo - 1, dlo, dlo + 1, dhi - 1, dhi, dhi + 1, 0, 1, -1, slo, shi where they are in the
// source range; the expected value is `Some(v)` exactly when dlo <= v <= dhi.

use std.array

fn join(h: U32, l: U32) -> U64 {
  let hh = (h as U64) << 32
  hh | (l as U64)
}

// The high word (part 0) or the low word (part 1) of a 64-bit value.
fn part_of(x: U64, part: U32) -> U32 {
  let y = if part < 1 {
    x >> 32
  } else {
    x & 4294967295
  }
  var r: U32 = 0
  match y.narrow_u32() {
    Some(v) => {
      r = v
    },
    None => {
      r = 0
    },
  }
  r
}

pub fn narrow_i8_to_u8(x: I8) -> I64 {
  var r: I64 = I64.MIN
  match x.narrow_u8() {
    Some(v) => {
      r = v as I64
    },
    None => {
      r = I64.MIN
    },
  }
  r
}

pub fn narrow_i32_to_u32(x: I32) -> I64 {
  var r: I64 = I64.MIN
  match x.narrow_u32() {
    Some(v) => {
      r = v as I64
    },
    None => {
      r = I64.MIN
    },
  }
  r
}

pub fn narrow_i64_to_u64(x: I64, part: U32) -> U32 {
  var r: U64 = 0
  var some: U32 = 0
  match x.narrow_u64() {
    Some(v) => {
      r = v
      some = 1
    },
    None => {
      r = 0
      some = 0
    },
  }
  if part < 2 {
    some = part_of(r, part)
  }
  some
}

pub fn count_fits_i32_u32(base: I32, n: U32) -> U32 {
  var x: I32 = base
  var c: U32 = 0
  var i: U32 = 0
  while i < n {
    match x.narrow_u32() {
      Some(_) => {
        c = c + 1
      },
      None => {
        c = c + 0
      },
    }
    x = x + 1
    i = i + 1
  }
  c
}

pub fn narrow_in_closure_i64_u8(base: I64) -> I64 {
  let ys: [I64; 3] = array.from_fn(fn(i) {
    let x = base + (i as I64)
    var r: I64 = I64.MIN
    match x.narrow_u8() {
      Some(v) => {
        r = v as I64
      },
      None => {
        r = I64.MIN
      },
    }
    r
  })
  ys[2]
}

test "narrow_i8_to_u8: the values" {
  assert narrow_i8_to_u8(-1) == I64.MIN
  assert narrow_i8_to_u8(0) == 0
  assert narrow_i8_to_u8(1) == 1
  assert narrow_i8_to_u8(I8.MIN) == I64.MIN
  assert narrow_i8_to_u8(127) == 127
}

test "narrow_i32_to_u32: the values" {
  assert narrow_i32_to_u32(-1) == I64.MIN
  assert narrow_i32_to_u32(0) == 0
  assert narrow_i32_to_u32(1) == 1
  assert narrow_i32_to_u32(I32.MIN) == I64.MIN
  assert narrow_i32_to_u32(2147483647) == 2147483647
}

test "narrow_i64_to_u64: the values" {
  assert narrow_i64_to_u64(-1, 0) == 0
  assert narrow_i64_to_u64(-1, 1) == 0
  assert narrow_i64_to_u64(-1, 2) == 0
  assert narrow_i64_to_u64(0, 0) == 0
  assert narrow_i64_to_u64(0, 1) == 0
  assert narrow_i64_to_u64(0, 2) == 1
  assert narrow_i64_to_u64(1, 0) == 0
  assert narrow_i64_to_u64(1, 1) == 1
}

test "count_fits_i32_u32: the values" {
  assert count_fits_i32_u32(-2, 4) == 2
  assert count_fits_i32_u32(-5, 3) == 0
  assert count_fits_i32_u32(0, 3) == 3
}

test "count_fits_i32_u32(2147483646, 2) panics" {   //~ TESTFAIL "count_fits_i32_u32(2147483646, 2) panics"
  let _ = count_fits_i32_u32(2147483646, 2)
}

test "narrow_in_closure_i64_u8: the values" {
  assert narrow_in_closure_i64_u8(253) == 255
  assert narrow_in_closure_i64_u8(254) == I64.MIN
  assert narrow_in_closure_i64_u8(255) == I64.MIN
  assert narrow_in_closure_i64_u8(-2) == 0
}

test "narrow_in_closure_i64_u8(9223372036854775806) panics" {   //~ TESTFAIL "narrow_in_closure_i64_u8(9223372036854775806) panics"
  let _ = narrow_in_closure_i64_u8(9223372036854775806)
}
