// onsa.toml
// [package]
// name = "c_narrow_s2u"
// edition = "2026"
//
// [export]
// prefix = "cns_"
// fns = [
//   "c_narrow_s2u.narrow_i8_to_u8",
//   "c_narrow_s2u.narrow_i32_to_u32",
//   "c_narrow_s2u.narrow_i64_to_u64",
//   "c_narrow_s2u.count_fits_i32_u32",
//   "c_narrow_s2u.narrow_in_closure_i64_u8",
// ]
