// [[test.host]]
// name = "a wrapping product with a constant of another module"
// target = "host"
// fn = "calc.wmul_scaled_u32"
// steps = [
//   { call = "fn", args = { a = 1 }, status = 0, result = 4294967295 },
//   { call = "fn", args = { a = 2 }, status = 0, result = 4294967294 },
//   { call = "fn", args = { a = 4294967295 }, status = 0, result = 1 },
//   { call = "fn", args = { a = 0 }, status = 0, result = 0 },
// ]
//
// [[test.host]]
// name = "a wrapping product with a constant of another module on a reset target"
// target = "fw"
// fn = "calc.wmul_scaled_u32"
// steps = [
//   { call = "fn", args = { a = 1 }, status = 0, result = 4294967295 },
//   { call = "fn", args = { a = 2 }, status = 0, result = 4294967294 },
//   { call = "fn", args = { a = 4294967295 }, status = 0, result = 1 },
//   { call = "fn", args = { a = 0 }, status = 0, result = 0 },
// ]
//
// [[test.host]]
// name = "the bits of a NaN made from a constant"
// target = "host"
// fn = "calc.bits_of_nan_f32"
// steps = [
//   { call = "fn", args = { z = 0.0 }, status = 0, result = 2143289344 },
//   { call = "fn", args = { z = -0.0 }, status = 0, result = 2143289344 },
// ]
//
// [[test.host]]
// name = "the bits of a NaN made from a constant on a reset target"
// target = "fw"
// fn = "calc.bits_of_nan_f32"
// steps = [
//   { call = "fn", args = { z = 0.0 }, status = 0, result = 2143289344 },
//   { call = "fn", args = { z = -0.0 }, status = 0, result = 2143289344 },
// ]
//
// [[test.host]]
// name = "a remainder of two constants"
// target = "host"
// fn = "calc.rem_const_operands_i16"
// steps = [
//   { call = "fn", args = { k = 0 }, status = 0, result = 0 },
// ]
//
// [[test.host]]
// name = "a remainder of two constants on a reset target"
// target = "fw"
// fn = "calc.rem_const_operands_i16"
// steps = [
//   { call = "fn", args = { k = 0 }, status = 0, result = 0 },
// ]
//
// [[test.host]]
// name = "a division of two constants"
// target = "host"
// fn = "calc.div_const_operands_i16"
// steps = [
//   { call = "fn", args = { k = 0 }, status = 1 },
// ]

// The same integer rules as c_div_rem.onsa, c_mul.onsa, c_trunc.onsa, c_shift.onsa and c_nan_bits.onsa,
// reached through a second module (spec §15.1): the operands are constants and functions of the module
// `edge`, the operators are used in `calc`, and both modules export functions (§14.2). The values are
// worked out by hand from the rules of §3.3 and §3.4, as in those files:
//   MIN % -1 is 0 (it fits, no panic), MIN / -1 panics, 2^32 - 1 squared does not fit U32,
//   U64 trunc_sat of 2^63 is 2^63 (high word 0x80000000), of 2^64 and above is 2^64 - 1.

use edge.{BIG, MIN16, MIN32, NEG1_16, NEG1_32, TWO63, part_of, rem_i8}

pub fn rem_min_neg1_i32(k: U32) -> I32 {
  MIN32 % NEG1_32
}

pub fn div_min_neg1_i32(k: U32) -> I32 {
  MIN32 / NEG1_32
}

pub fn rem_chain_i8(a: I8, b: I8) -> I8 {
  let r = rem_i8(a, b)
  rem_i8(r, 127)
}

pub fn sat_u64_hi(k: F64) -> U32 {
  let x = TWO63 * k
  part_of(x.trunc_u64_sat(), 0)
}

pub fn sat_u64_lo(k: F64) -> U32 {
  let x = TWO63 * k
  part_of(x.trunc_u64_sat(), 1)
}

pub fn mul_scaled_u32(a: U32) -> U32 {
  BIG * a
}

pub fn wmul_scaled_u32(a: U32) -> U32 {
  BIG *% a
}

pub fn bits_of_nan_f32(z: F32) -> U32 {
  let n = z / z
  n.to_bits()
}

pub fn rem_const_operands_i16(k: U32) -> I16 {
  MIN16 % NEG1_16
}

pub fn div_const_operands_i16(k: U32) -> I16 {
  MIN16 / NEG1_16
}

test "constants of another module are operands of the checked operators" {
  assert rem_min_neg1_i32(0) == 0
  assert rem_const_operands_i16(0) == 0
  assert rem_chain_i8(-128, -1) == 0
  assert rem_chain_i8(-128, 3) == -2
  assert wmul_scaled_u32(2) == 4294967294
  assert wmul_scaled_u32(4294967295) == 1
  assert mul_scaled_u32(1) == 4294967295
  assert sat_u64_hi(1.0) == 2147483648
  assert sat_u64_lo(1.0) == 0
  assert sat_u64_hi(2.0) == 4294967295
  assert sat_u64_lo(4.0) == 4294967295
  assert bits_of_nan_f32(0.0) == 2143289344
}

test "MIN / -1 from constants of another module panics" {   //~ TESTFAIL "MIN / -1 from constants of another module panics"
  let _ = div_min_neg1_i32(0)
}

test "MIN / -1 of two constants panics" {   //~ TESTFAIL "MIN / -1 of two constants panics"
  let _ = div_const_operands_i16(0)
}

test "BIG * 2 from a constant of another module panics" {   //~ TESTFAIL "BIG * 2 from a constant of another module panics"
  let _ = mul_scaled_u32(2)
}

test "a remainder by zero in a chain across modules panics" {   //~ TESTFAIL "a remainder by zero in a chain across modules panics"
  let _ = rem_chain_i8(-128, 0)
}
