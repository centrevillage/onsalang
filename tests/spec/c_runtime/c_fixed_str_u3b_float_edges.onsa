// S-614 (W5-12 U3b, spec §4.2, S-1007, §13.4): `put_float` of `F64` in the C of the host, the edges of S-1007: the width of the digits up to `d = 22`, `d` over 22 (`*`), NaN and the infinities (the characters do not
// depend on `d`), the neighbours of 2^64 and 2^63, the values whose product is over 2^64 or infinite, and the smallest double. In the C the product is a `double` multiplication and the check of 2^64 is by the rounded
// value, so the same bytes are written as in the interpreter (fixed_str_put_float_edges.onsa).
// `case(i)` picks the i-th case by a `match` that is a statement and returns whether the case holds (false for an `i` that is not a case); the sequence of the `[[test.host]]` runs every `i`. A `mode = "test"`
// case runs the interpreter only, and the C is made from the sequence above, so the interpreter and the C give the same bytes for every case here (the C rounds by `onsa_round_f64`).

use std.text.FixedStr

fn f64s(v: F64, d: U32) -> FixedStr[32] {
  var t: FixedStr[32] = ""
  t.put_float!(v, d)
  t
}

fn f32s(v: F32, d: U32) -> FixedStr[32] {
  var t: FixedStr[32] = ""
  t.put_float!(v, d)
  t
}

// F64 5.0, d = 0: 5.0 -> 5
fn c0() -> Bool {
  f64s(5.0, 0) == "5"
}

// F64 5.0, d = 1: 50.0 -> 50
fn c1() -> Bool {
  f64s(5.0, 1) == "5.0"
}

// F64 5.0, d = 5: 500000.0 -> 500000
fn c2() -> Bool {
  f64s(5.0, 5) == "5.00000"
}

