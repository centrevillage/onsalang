// onsa.toml
// [package]
// name = "c_fp_contract"
// edition = "2026"
//
// [export]
// prefix = "cfc_"
// fns = [
//   "c_fp_contract.muladd_f32",
//   "c_fp_contract.mulsub_f32",
//   "c_fp_contract.nmuladd_f32",
//   "c_fp_contract.negmul_add_f32",
//   "c_fp_contract.dot2_f32",
//   "c_fp_contract.mac_loop_f32",
//   "c_fp_contract.via_helper_f32",
//   "c_fp_contract.zero_sign_bits_f32",
//   "c_fp_contract.muladd_f64",
//   "c_fp_contract.mulsub_f64",
//   "c_fp_contract.mac_loop_f64",
// ]
//
// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "poison"
// provides = []
//
// [targets.fw]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "reset"
// provides = []
//
// [targets.dbg]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [test]
// mode = "test"
// spec = ["§13.4", "§3.4", "§15.5"]
//
// [[test.host]]
// name = "muladd_f32"
// target = "host"
// fn = "c_fp_contract.muladd_f32"
// steps = [
//   { call = "fn", args = { a = 1.0001220703125, b = 1.0001220703125, c = -1.000244140625 }, status = 0, result = 0.0 },
//   { call = "fn", args = { a = 1.0001220703125, b = 1.0001220703125, c = -1.0 }, status = 0, result = 0.000244140625 },
//   { call = "fn", args = { a = 2.0, b = 3.0, c = 1.0 }, status = 0, result = 7.0 },
//   { call = "fn", args = { a = 0.5, b = 0.5, c = 0.25 }, status = 0, result = 0.5 },
// ]
//
// [[test.host]]
// name = "mulsub_f32"
// target = "host"
// fn = "c_fp_contract.mulsub_f32"
// steps = [
//   { call = "fn", args = { a = 1.0001220703125, b = 1.0001220703125, c = 1.000244140625 }, status = 0, result = 0.0 },
//   { call = "fn", args = { a = 1.0001220703125, b = 1.0001220703125, c = 1.0 }, status = 0, result = 0.000244140625 },
//   { call = "fn", args = { a = 2.0, b = 3.0, c = 1.0 }, status = 0, result = 5.0 },
// ]
//
// [[test.host]]
// name = "nmuladd_f32"
// target = "host"
// fn = "c_fp_contract.nmuladd_f32"
// steps = [
//   { call = "fn", args = { a = 1.0001220703125, b = 1.0001220703125, c = 1.000244140625 }, status = 0, result = 0.0 },
//   { call = "fn", args = { a = 1.0001220703125, b = 1.0001220703125, c = 1.0 }, status = 0, result = -0.000244140625 },
//   { call = "fn", args = { a = 2.0, b = 3.0, c = 10.0 }, status = 0, result = 4.0 },
// ]
//
// [[test.host]]
// name = "negmul_add_f32"
// target = "host"
// fn = "c_fp_contract.negmul_add_f32"
// steps = [
//   { call = "fn", args = { a = 1.0001220703125, b = 1.0001220703125, c = 1.000244140625 }, status = 0, result = 0.0 },
//   { call = "fn", args = { a = 2.0, b = 3.0, c = 10.0 }, status = 0, result = 4.0 },
