// onsa.toml
// [package]
// name = "c_narrow_same"
// edition = "2026"
//
// [export]
// prefix = "cnm_"
// fns = [
//   "c_narrow_same.narrow_i32_to_i8",
//   "c_narrow_same.narrow_i64_to_i32",
//   "c_narrow_same.narrow_u64_to_u16",
//   "c_narrow_same.count_fits_i64_i32",
//   "c_narrow_same.flags_in_closure_u64_u16",
// ]
//
// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "poison"
// provides = []
//
// [targets.fw]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "reset"
// provides = []
//
// [targets.dbg]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "trap"
// provides = []
//
// [test]
// mode = "test"
// spec = ["§3.3", "§3.4", "§9.2", "§14.2"]
//
// [[test.host]]
// name = "narrow_i32_to_i8"
// target = "host"
// fn = "c_narrow_same.narrow_i32_to_i8"
// steps = [
//   { call = "fn", args = { x = -129 }, status = 0, result = -9223372036854775808 },
//   { call = "fn", args = { x = -128 }, status = 0, result = -128 },
//   { call = "fn", args = { x = -127 }, status = 0, result = -127 },
//   { call = "fn", args = { x = 126 }, status = 0, result = 126 },
//   { call = "fn", args = { x = 127 }, status = 0, result = 127 },
// ]
//
// [[test.host]]
// name = "narrow_i32_to_i8 on a reset target"
// target = "fw"
// fn = "c_narrow_same.narrow_i32_to_i8"
// steps = [
//   { call = "fn", args = { x = -129 }, status = 0, result = -9223372036854775808 },
//   { call = "fn", args = { x = -128 }, status = 0, result = -128 },
//   { call = "fn", args = { x = -127 }, status = 0, result = -127 },
//   { call = "fn", args = { x = 126 }, status = 0, result = 126 },
//   { call = "fn", args = { x = 127 }, status = 0, result = 127 },
// ]
//
// [[test.host]]
// name = "narrow_i64_to_i32"
// target = "host"
// fn = "c_narrow_same.narrow_i64_to_i32"
// steps = [
//   { call = "fn", args = { x = -2147483649 }, status = 0, result = -9223372036854775808 },
//   { call = "fn", args = { x = -2147483648 }, status = 0, result = -2147483648 },
//   { call = "fn", args = { x = -2147483647 }, status = 0, result = -2147483647 },
//   { call = "fn", args = { x = 2147483646 }, status = 0, result = 2147483646 },
//   { call = "fn", args = { x = 2147483647 }, status = 0, result = 2147483647 },
// ]
//
// [[test.host]]
// name = "narrow_u64_to_u16"
// target = "host"
// fn = "c_narrow_same.narrow_u64_to_u16"
// steps = [
//   { call = "fn", args = { xh = 0, xl = 0 }, status = 0, result = 0 },
//   { call = "fn", args = { xh = 0, xl = 1 }, status = 0, result = 1 },
//   { call = "fn", args = { xh = 0, xl = 65534 }, status = 0, result = 65534 },
//   { call = "fn", args = { xh = 0, xl = 65535 }, status = 0, result = 65535 },
//   { call = "fn", args = { xh = 0, xl = 65536 }, status = 0, result = -9223372036854775808 },
// ]
//
// [[test.host]]
// name = "count_fits_i64_i32"
// target = "host"
// fn = "c_narrow_same.count_fits_i64_i32"
// steps = [
//   { call = "fn", args = { base = 2147483646, n = 4 }, status = 0, result = 2 },
//   { call = "fn", args = { base = -2147483649, n = 3 }, status = 0, result = 2 },
//   { call = "fn", args = { base = -2147483648, n = 2 }, status = 0, result = 2 },
//   { call = "fn", args = { base = 0, n = 5 }, status = 0, result = 5 },
//   { call = "fn", args = { base = 9223372036854775806, n = 4 }, status = 0, result = 0 },
// ]
//
// [[test.host]]
// name = "count_fits_i64_i32 on a reset target"
// target = "fw"
// fn = "c_narrow_same.count_fits_i64_i32"
// steps = [
//   { call = "fn", args = { base = 2147483646, n = 4 }, status = 0, result = 2 },
//   { call = "fn", args = { base = -2147483649, n = 3 }, status = 0, result = 2 },
//   { call = "fn", args = { base = -2147483648, n = 2 }, status = 0, result = 2 },
//   { call = "fn", args = { base = 0, n = 5 }, status = 0, result = 5 },
//   { call = "fn", args = { base = 9223372036854775806, n = 4 }, status = 0, result = 0 },
// ]
//
// [[test.host]]
// name = "flags_in_closure_u64_u16"
// target = "host"
// fn = "c_narrow_same.flags_in_closure_u64_u16"
// steps = [
//   { call = "fn", args = { bh = 0, bl = 0 }, status = 0, result = 7 },
//   { call = "fn", args = { bh = 0, bl = 65534 }, status = 0, result = 6 },
//   { call = "fn", args = { bh = 0, bl = 65535 }, status = 0, result = 4 },
//   { call = "fn", args = { bh = 0, bl = 65536 }, status = 0, result = 0 },
//   { call = "fn", args = { bh = 4294967295, bl = 4294967295 }, status = 0, result = 3 },
// ]

// `narrow_<type>()` from the same sign integers, on a target that is built to C (spec §3.3): `Some(v)` when the
// value fits the destination type, `None` when it does not. The pairs that need the method are the ones `as`
// cannot write: a narrower destination, the same width with the other sign, and a signed source to a
// wider unsigned one.
// The pairs of the same sign: a narrower destination of the same signedness. A value fits when it is inside
// [MIN, MAX] of the destination (`300i32.narrow_i8()` is `None`, `-128i32.narrow_i8()` is `Some(-128)`).
// The vectors call each pair once on literals; this file adds the exported boundary with host-chosen
// values, loops and an anonymous function. The same functions and expectations run on the interpreter
// (the test blocks) and on the C target (the host scripts).
//
// Each function returns the destination value widened to `I64` (`I64.MIN` for `None`, which no
// destination value equals); the functions to `U64` return the high word (`part` 0), the low word
// (`part` 1) or 1/0 for Some/None (`part` 2) as a `U32`, and the ones from `U64` take the source as
// two `U32` words (a TOML integer stops at 2^63 - 1). The inputs are the destination's edges and the
// source's edges: dlo - 1, dlo, dlo + 1, dhi - 1, dhi, dhi + 1, 0, 1, -1, slo, shi where they are in the
// source range; the expected value is `Some(v)` exactly when dlo <= v <= dhi.

use std.array

fn join(h: U32, l: U32) -> U64 {
  let hh = (h as U64) << 32
  hh | (l as U64)
}

// The high word (part 0) or the low word (part 1) of a 64-bit value.
fn part_of(x: U64, part: U32) -> U32 {
  let y = if part < 1 {
    x >> 32
  } else {
    x & 4294967295
  }
  var r: U32 = 0
  match y.narrow_u32() {
    Some(v) => {
      r = v
    },
    None => {
      r = 0
    },
  }
  r
}

pub fn narrow_i32_to_i8(x: I32) -> I64 {
  var r: I64 = I64.MIN
  match x.narrow_i8() {
    Some(v) => {
      r = v as I64
    },
    None => {
      r = I64.MIN
    },
  }
  r
}

pub fn narrow_i64_to_i32(x: I64) -> I64 {
  var r: I64 = I64.MIN
  match x.narrow_i32() {
    Some(v) => {
      r = v as I64
    },
    None => {
      r = I64.MIN
    },
  }
  r
}

pub fn narrow_u64_to_u16(xh: U32, xl: U32) -> I64 {
  let x = join(xh, xl)
  var r: I64 = I64.MIN
  match x.narrow_u16() {
    Some(v) => {
      r = v as I64
    },
    None => {
      r = I64.MIN
    },
  }
  r
}

pub fn count_fits_i64_i32(base: I64, n: U32) -> U32 {
  var x: I64 = base
  var c: U32 = 0
  for _ in 0..<n {
    match x.narrow_i32() {
      Some(_) => {
        c = c + 1
      },
      None => {
        c = c + 0
      },
    }
    x = x +% 1
  }
  c
}

pub fn flags_in_closure_u64_u16(bh: U32, bl: U32) -> U32 {
  let b = join(bh, bl)
  let ys: [U32; 3] = array.from_fn(fn(i) {
    let x = b +% (i as U64)
    var r: U32 = 0
    match x.narrow_u16() {
      Some(_) => {
        r = 1
      },
      None => {
        r = 0
      },
    }
    r
  })
  let a = ys[0] * 4
  let c = ys[1] * 2
  a + c + ys[2]
}

test "narrow_i32_to_i8: the values" {
  assert narrow_i32_to_i8(-129) == I64.MIN
  assert narrow_i32_to_i8(-128) == -128
  assert narrow_i32_to_i8(-127) == -127
  assert narrow_i32_to_i8(126) == 126
  assert narrow_i32_to_i8(127) == 127
}

test "narrow_i64_to_i32: the values" {
  assert narrow_i64_to_i32(-2147483649) == I64.MIN
  assert narrow_i64_to_i32(-2147483648) == -2147483648
  assert narrow_i64_to_i32(-2147483647) == -2147483647
  assert narrow_i64_to_i32(2147483646) == 2147483646
  assert narrow_i64_to_i32(2147483647) == 2147483647
}

test "narrow_u64_to_u16: the values" {
  assert narrow_u64_to_u16(0, 0) == 0
  assert narrow_u64_to_u16(0, 1) == 1
  assert narrow_u64_to_u16(0, 65534) == 65534
  assert narrow_u64_to_u16(0, 65535) == 65535
  assert narrow_u64_to_u16(0, 65536) == I64.MIN
}

test "count_fits_i64_i32: the values" {
  assert count_fits_i64_i32(2147483646, 4) == 2
  assert count_fits_i64_i32(-2147483649, 3) == 2
  assert count_fits_i64_i32(-2147483648, 2) == 2
  assert count_fits_i64_i32(0, 5) == 5
  assert count_fits_i64_i32(9223372036854775806, 4) == 0
}

test "flags_in_closure_u64_u16: the values" {
  assert flags_in_closure_u64_u16(0, 0) == 7
  assert flags_in_closure_u64_u16(0, 65534) == 6
  assert flags_in_closure_u64_u16(0, 65535) == 4
  assert flags_in_closure_u64_u16(0, 65536) == 0
  assert flags_in_closure_u64_u16(4294967295, 4294967295) == 3
}
