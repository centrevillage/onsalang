// onsa.toml
// [package]
// name = "c_type_limits"
// edition = "2026"
//
// [export]
// prefix = "ctl_"
// fns = [
//   "c_type_limits.lim_u8",
//   "c_type_limits.lim_u16",
//   "c_type_limits.lim_u32",
//   "c_type_limits.lim_u64",
//   "c_type_limits.lim_i8",
//   "c_type_limits.lim_i16",
//   "c_type_limits.lim_i32",
//   "c_type_limits.lim_i64",
