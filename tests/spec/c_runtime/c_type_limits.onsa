pub fn lim_wide_u8(x: U8) -> U32 {
  let w = x as I32
  var m: U32 = 0
  if w >= 0 {
    m = m + 1
  }
  if w < 0 {
    m = m + 2
  }
  if w <= 255 {
    m = m + 4
  }
  if w > 255 {
    m = m + 8
  }
  m
}

pub fn lim_wide_u16(x: U16) -> U32 {
  let w = x as I32
  var m: U32 = 0
  if w >= 0 {
    m = m + 1
  }
  if w < 0 {
    m = m + 2
  }
  if w <= 65535 {
    m = m + 4
  }
  if w > 65535 {
    m = m + 8
  }
  m
}

pub fn lim_wide_u32(x: U32) -> U32 {
  let w = x as I64
  var m: U32 = 0
  if w >= 0 {
    m = m + 1
  }
  if w < 0 {
    m = m + 2
  }
  if w <= 4294967295 {
    m = m + 4
  }
