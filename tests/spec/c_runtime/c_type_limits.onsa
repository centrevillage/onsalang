pub fn lim_i32(x: I32) -> U32 {
  var m: U32 = 0
  if x >= I32.MIN {
    m = m + 1
  }
  if x < I32.MIN {
    m = m + 2
  }
  if x <= I32.MAX {
    m = m + 4
  }
  if x > I32.MAX {
    m = m + 8
