pub fn lim_wide_i8(x: I8) -> U32 {
  let w = x as I32
  var m: U32 = 0
  if w >= -128 {
    m = m + 1
  }
  if w < -128 {
    m = m + 2
  }
  if w <= 127 {
    m = m + 4
  }
  if w > 127 {
    m = m + 8
  }
  m
}

pub fn lim_wide_i16(x: I16) -> U32 {
  let w = x as I32
  var m: U32 = 0
  if w >= -32768 {
    m = m + 1
  }
  if w < -32768 {
    m = m + 2
  }
  if w <= 32767 {
    m = m + 4
  }
