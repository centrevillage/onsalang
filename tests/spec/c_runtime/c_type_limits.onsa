//
// [[test.host]]
// name = "lim_u8 on a reset target"
// target = "fw"
// fn = "c_type_limits.lim_u8"
// steps = [
//   { call = "fn", args = { x = 0 }, status = 0, result = 21 },
//   { call = "fn", args = { x = 255 }, status = 0, result = 149 },
// ]
//
// [[test.host]]
// name = "lim_i16 on a reset target"
// target = "fw"
// fn = "c_type_limits.lim_i16"
// steps = [
//   { call = "fn", args = { x = -32768 }, status = 0, result = 213 },
//   { call = "fn", args = { x = 5 }, status = 0, result = 21 },
// ]

// Comparisons that the type of an operand already decides, written in the Onsa source, on a target that is
// built to C (spec §13.4: the generated C compiles without a warning under `-Wall -Wextra -pedantic`, so a
// host that builds with `-Werror` accepts it). A C compiler warns about such a comparison when it is written
// as it is: gcc `-Wtype-limits` ("comparison of unsigned expression in '< 0' is always false", "always
// true due to limited range of data type"), clang `-Wtautological-constant-out-of-range-compare`,
// `-Wtautological-unsigned-zero-compare`. The Onsa program is
// valid and means exactly what it says (§3.4 gives `x >= 0` on an unsigned value its plain value), so the
// C the compiler writes must not contain the warned form, in the helpers of the runtime (`-Wtype-limits`
// in `onsa.h`, R-67, S-54) as well as in the code of the program (R-145 (3)).
//
// `lim_<t>(x)` adds up one bit for each of these that is true:
//   1  x >= MIN                       (always true)         16  MIN <= x           (always true)
//   2  x < MIN                        (always false)        32  MAX < x            (always false)
//   4  x <= MAX                       (always true)         64  x < 0   (signed: depends; unsigned: false)
//   8  x > MAX                        (always false)       128  x >= MAX (unsigned) / x <= MIN (signed)
// where MIN is 0 for an unsigned type. So an unsigned x gives 21, plus 128 when x is MAX; a signed x gives
// 21, plus 64 when x is negative, plus 128 when x is MIN. `lim_wide_<t>` makes the same decisions after
// widening with `as` (`(x as I32) >= 0` for a U8 is always true as well).

pub fn lim_u8(x: U8) -> U32 {
  var m: U32 = 0
  if x >= 0 {
    m = m + 1
  }
  if x < 0 {
    m = m + 2
  }
  if x <= U8.MAX {
    m = m + 4
  }
  if x > U8.MAX {
    m = m + 8
  }
  if 0 <= x {
    m = m + 16
  }
  if U8.MAX < x {
    m = m + 32
  }
  if x < 0 {
    m = m + 64
  }
  if x >= U8.MAX {
    m = m + 128
  }
  m
}

pub fn lim_u16(x: U16) -> U32 {
  var m: U32 = 0
  if x >= 0 {
    m = m + 1
  }
  if x < 0 {
    m = m + 2
  }
  if x <= U16.MAX {
    m = m + 4
  }
  if x > U16.MAX {
    m = m + 8
  }
  if 0 <= x {
    m = m + 16
  }
  if U16.MAX < x {
    m = m + 32
  }
  if x < 0 {
    m = m + 64
  }
  if x >= U16.MAX {
    m = m + 128
  }
  m
}

