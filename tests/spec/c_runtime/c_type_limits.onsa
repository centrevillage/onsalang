pub fn lim_wide_i32(x: I32) -> U32 {
  let w = x as I64
  var m: U32 = 0
  if w >= -2147483648 {
    m = m + 1
  }
  if w < -2147483648 {
    m = m + 2
  }
  if w <= 2147483647 {
    m = m + 4
  }
  if w > 2147483647 {
    m = m + 8
  }
  m
}

test "lim_u8: the values" {
  assert lim_u8(0) == 21
  assert lim_u8(1) == 21
  assert lim_u8(127) == 21
  assert lim_u8(254) == 21
  assert lim_u8(255) == 149
}

test "lim_u16: the values" {
  assert lim_u16(0) == 21
  assert lim_u16(1) == 21
  assert lim_u16(32767) == 21
  assert lim_u16(65534) == 21
  assert lim_u16(65535) == 149
}

test "lim_u32: the values" {
  assert lim_u32(0) == 21
  assert lim_u32(1) == 21
  assert lim_u32(2147483647) == 21
  assert lim_u32(4294967294) == 21
  assert lim_u32(4294967295) == 149
}

test "lim_u64: the values" {
  assert lim_u64(0) == 21
  assert lim_u64(1) == 21
  assert lim_u64(9223372036854775807) == 21
}

test "lim_i8: the values" {
  assert lim_i8(I8.MIN) == 213
  assert lim_i8(-1) == 85
  assert lim_i8(0) == 21
  assert lim_i8(1) == 21
  assert lim_i8(127) == 21
}

test "lim_i16: the values" {
  assert lim_i16(I16.MIN) == 213
  assert lim_i16(-1) == 85
  assert lim_i16(0) == 21
  assert lim_i16(1) == 21
  assert lim_i16(32767) == 21
}

test "lim_i32: the values" {
  assert lim_i32(I32.MIN) == 213
  assert lim_i32(-1) == 85
  assert lim_i32(0) == 21
  assert lim_i32(1) == 21
  assert lim_i32(2147483647) == 21
}

test "lim_i64: the values" {
  assert lim_i64(I64.MIN) == 213
  assert lim_i64(-1) == 85
  assert lim_i64(0) == 21
  assert lim_i64(1) == 21
  assert lim_i64(9223372036854775807) == 21
}

test "lim_wide_u8: the values" {
  assert lim_wide_u8(0) == 5
  assert lim_wide_u8(1) == 5
  assert lim_wide_u8(255) == 5
}

test "lim_wide_u16: the values" {
  assert lim_wide_u16(0) == 5
  assert lim_wide_u16(1) == 5
  assert lim_wide_u16(65535) == 5
}

test "lim_wide_u32: the values" {
  assert lim_wide_u32(0) == 5
  assert lim_wide_u32(1) == 5
  assert lim_wide_u32(4294967295) == 5
}

test "lim_wide_i8: the values" {
  assert lim_wide_i8(I8.MIN) == 5
  assert lim_wide_i8(0) == 5
  assert lim_wide_i8(1) == 5
  assert lim_wide_i8(127) == 5
}

test "lim_wide_i16: the values" {
  assert lim_wide_i16(I16.MIN) == 5
  assert lim_wide_i16(0) == 5
  assert lim_wide_i16(1) == 5
  assert lim_wide_i16(32767) == 5
}

test "lim_wide_i32: the values" {
  assert lim_wide_i32(I32.MIN) == 5
  assert lim_wide_i32(0) == 5
  assert lim_wide_i32(1) == 5
  assert lim_wide_i32(2147483647) == 5
}
