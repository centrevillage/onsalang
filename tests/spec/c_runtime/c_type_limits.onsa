pub fn lim_i8(x: I8) -> U32 {
  var m: U32 = 0
  if x >= I8.MIN {
    m = m + 1
  }
  if x < I8.MIN {
    m = m + 2
  }
  if x <= I8.MAX {
    m = m + 4
  }
  if x > I8.MAX {
    m = m + 8
  }
  if I8.MIN <= x {
    m = m + 16
  }
  if I8.MAX < x {
    m = m + 32
  }
  if x < 0 {
    m = m + 64
  }
  if x <= I8.MIN {
    m = m + 128
  }
  m
}

