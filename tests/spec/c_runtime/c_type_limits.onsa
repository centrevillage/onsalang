  var m: U32 = 0
  if x >= I16.MIN {
    m = m + 1
  }
  if x < I16.MIN {
    m = m + 2
  }
  if x <= I16.MAX {
    m = m + 4
  }
  if x > I16.MAX {
    m = m + 8
  }
  if I16.MIN <= x {
