// name = "narrow_i32_from_param"
// target = "host"
// fn = "c_generic_param_path.narrow_i32_from_param"
// steps = [
//   { call = "fn", args = { n = 2147483647 }, status = 0, result = 2147483647 },
//   { call = "fn", args = { n = 2147483648 }, status = 0, result = -1 },
