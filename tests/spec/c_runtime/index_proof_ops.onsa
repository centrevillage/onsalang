test "wrap: the forms that fit give the element that the arithmetic names" {
  assert wrap(0, 1) == 1
  assert wrap(0, 3) == 3
  assert wrap(1, 1) == 1
  assert wrap(2, 4294967295) == 1
  assert wrap(2, 0) == 2
  assert wrap(2, 1) == 3
  assert wrap(3, 3) == 1
  assert wrap(3, 2) == 4
  assert wrap(4, 4294967295) == 1
  assert wrap(4, 2) == 4
}

test "wrap: form 0 panics for 4" {
  let r = wrap(0, 4) //~ PANIC "wrap: form 0 panics for 4"
  assert r == 0
}

test "wrap: form 0 panics for 0" {
  let r = wrap(0, 0) //~ PANIC "wrap: form 0 panics for 0"
  assert r == 0
}

test "wrap: form 1 panics for 0" {
  let r = wrap(1, 0) //~ PANIC "wrap: form 1 panics for 0"
  assert r == 0
}

test "wrap: form 2 panics for 2" {
  let r = wrap(2, 2) //~ PANIC "wrap: form 2 panics for 2"
  assert r == 0
}

test "wrap: form 2 panics for 4294967294" {
  let r = wrap(2, 4294967294) //~ PANIC "wrap: form 2 panics for 4294967294"
  assert r == 0
}

test "wrap: form 3 panics for 4294967295" {
  let r = wrap(3, 4294967295) //~ PANIC "wrap: form 3 panics for 4294967295"
  assert r == 0
}

test "narrow: the forms that fit give the element that the arithmetic names" {
  assert narrow(0, 0) == 256
  assert narrow(0, 1) == 1
  assert narrow(0, 255) == 255
  assert narrow(1, 1) == 1
  assert narrow(1, 255) == 255
  assert narrow(2, 255) == 1
  assert narrow(2, 0) == 2
  assert narrow(2, 254) == 256
  assert narrow(3, 255) == 1
  assert narrow(3, 253) == 255
  assert narrow(4, 0) == 1
  assert narrow(4, 1) == 17
  assert narrow(4, 17) == 17
  assert narrow(4, 16) == 1
  assert narrow(4, 33) == 17
  assert narrow(5, 255) == 256
  assert narrow(5, 0) == 1
  assert narrow(5, 100) == 101
  assert narrow(6, 254) == 255
  assert narrow(7, 254) == 256
  assert narrow(8, 255) == 257
  assert narrow(8, 0) == 2
}

test "narrow: form 1 panics for 0" {
  let r = narrow(1, 0) //~ PANIC "narrow: form 1 panics for 0"
  assert r == 0
}

test "narrow: form 3 panics for 254" {
  let r = narrow(3, 254) //~ PANIC "narrow: form 3 panics for 254"
  assert r == 0
}

test "narrow: form 4 panics for 2" {
  let r = narrow(4, 2) //~ PANIC "narrow: form 4 panics for 2"
  assert r == 0
}

