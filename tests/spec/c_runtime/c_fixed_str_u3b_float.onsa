// S-614 (W5-12 U3b, spec §4.2, S-1007, §13.4): `put_float` of `F64` in the C of the host, the rounding: the typical values, the midpoints (the tie goes to the even integer by `onsa_round_f64`), the values whose decimal is
// not the double (`1.005` and `1.075`), the zero, the negative zero and the small values (no sign when the rounded integer is 0, `0.05` with the zeros padded). The expected texts are those of the interpreter file
// fixed_str_put_float_round.onsa (the formula of §4.2 in the IEEE double, made by a script).
// `case(i)` picks the i-th case by a `match` that is a statement and returns whether the case holds (false for an `i` that is not a case); the sequence of the `[[test.host]]` runs every `i`. A `mode = "test"`
// case runs the interpreter only, and the C is made from the sequence above, so the interpreter and the C give the same bytes for every case here (the C rounds by `onsa_round_f64`).

use std.text.FixedStr

fn f64s(v: F64, d: U32) -> FixedStr[32] {
  var t: FixedStr[32] = ""
  t.put_float!(v, d)
  t
}

fn f32s(v: F32, d: U32) -> FixedStr[32] {
  var t: FixedStr[32] = ""
  t.put_float!(v, d)
  t
}

// F64 12.345, d = 2: 1234.5 -> 1234
fn c0() -> Bool {
  f64s(12.345, 2) == "12.34"
}

// F64 3.14159, d = 2: 314.159 -> 314
fn c1() -> Bool {
  f64s(3.14159, 2) == "3.14"
}

// F64 3.14159, d = 4: 31415.899999999998 -> 31416
fn c2() -> Bool {
  f64s(3.14159, 4) == "3.1416"
}

// F64 3.14159, d = 0: 3.14159 -> 3
fn c3() -> Bool {
  f64s(3.14159, 0) == "3"
}

// F64 440.0, d = 1: 4400.0 -> 4400
fn c4() -> Bool {
  f64s(440.0, 1) == "440.0"
}

