// onsa.toml
// [package]
// name = "c_default_init_host"
// edition = "2026"
//
// [export]
// prefix = "ch_"
//
// [targets.host]
// kind = "source"
// lang = "c"
// platform = "host"
// panic = "poison"
// provides = []
//
// [test]
// mode = "test"
// spec = ["§11.4"]
//
// [[test.host]]
// name = "hand default struct"
// target = "host"
// flow = "c_default_init_host.hand"
// steps = [
//   { call = "init", config = {}, sample_rate = 48000.0, status = 0 },
//   { call = "process", params = {}, frames = 3, input = [5.0, 6.0, 7.0], status = 0, output = [9.0, 55.0, 66.0] },
//   { call = "reset" },
//   { call = "process", params = {}, frames = 3, input = [5.0, 6.0, 7.0], status = 0, output = [9.0, 55.0, 66.0] },
// ]
//
// [[test.host]]
// name = "panicking default"
// target = "host"
// flow = "c_default_init_host.bad"
// steps = [
//   { call = "init", config = {}, sample_rate = 48000.0, status = 1 },
//   { call = "reset" },
//   { call = "init", config = {}, sample_rate = 48000.0, status = 1 },
// ]
//
// [[test.host]]
// name = "arr default"
// target = "host"
// flow = "c_default_init_host.arr"
// steps = [
//   { call = "init", config = {}, sample_rate = 48000.0, status = 0 },
//   { call = "process", params = {}, frames = 3, input = [5.0, 6.0, 7.0], status = 0, output = [0.0, 0.0, 5.0] },
// ]

pub struct Pt { x: F32, y: F32 }
impl Default for Pt {
  rt fn default() -> Pt { Pt { x: 1.0, y: -1.0 } }
}

@export
pub flow hand(x: F32 at sample) -> F32 at sample {
  let p = prev~(Pt { x: x, y: x })
  p.x * 10.0 + p.y
}

pub struct Bad { x: I32 }
impl Default for Bad {
  rt fn default() -> Bad {
    let z: I32 = 0
    Bad { x: 5 / z }
  }
}

@export
pub flow bad(x: F32 at sample) -> F32 at sample {
  let p = prev~(Bad { x: I32.trunc_from(x) })
  F32.round_from(p.x)
}

@export
pub flow arr(x: F32 at sample) -> F32 at sample {
  let p = delay~([x, x], 2)
  p[0]
}

test "t" {
  assert true
}
