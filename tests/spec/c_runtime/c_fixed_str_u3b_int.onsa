// a text after a text, a type that is cast
fn c98() -> Bool {
  var t: FixedStr[24] = "n="
  let s: U8 = 7
  t.put_int!(-42)
  t.put_int!(s)
  t.put_int!(I8.MIN)
  t == "n=-427-128" && t.len() == 10
}

