    },
    16 => {
      r = c16()
    },
    17 => {
      r = c17()
    },
    18 => {
      r = c18()
    },
    19 => {
      r = c19()
    },
    20 => {
      r = c20()
    },
    21 => {
      r = c21()
    },
    22 => {
      r = c22()
    },
    23 => {
      r = c23()
    },
    24 => {
      r = c24()
    },
    25 => {
      r = c25()
    },
    26 => {
      r = c26()
    },
    27 => {
      r = c27()
    },
    28 => {
      r = c28()
    },
    29 => {
      r = c29()
    },
    30 => {
      r = c30()
    },
    31 => {
      r = c31()
    },
    32 => {
      r = c32()
    },
    33 => {
      r = c33()
    },
    34 => {
      r = c34()
    },
    35 => {
      r = c35()
    },
    36 => {
      r = c36()
    },
    37 => {
      r = c37()
    },
    38 => {
      r = c38()
    },
    39 => {
      r = c39()
    },
    40 => {
      r = c40()
    },
    41 => {
      r = c41()
    },
    42 => {
      r = c42()
    },
    43 => {
      r = c43()
    },
    44 => {
      r = c44()
    },
    45 => {
      r = c45()
    },
    46 => {
      r = c46()
    },
    47 => {
      r = c47()
    },
    48 => {
      r = c48()
    },
    49 => {
      r = c49()
    },
    50 => {
      r = c50()
    },
    51 => {
      r = c51()
    },
    52 => {
      r = c52()
    },
    53 => {
      r = c53()
    },
    54 => {
      r = c54()
    },
    _ => {
      r = false
    },
  }
  r
}

test "every case holds in the interpreter" {
  for i in 0 ..< 55 {
    assert case(i)
  }
}

test "a case that does not exist is false" {
  assert !case(55)
  assert !case(4294967295)
}
